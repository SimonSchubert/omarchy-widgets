widget "duolingo" {
  size: 3x3
  minSize: 3x2
  meta {
    description: "La llama de Duolingo se enciende cuando cumples la tarea del día, con la semana marcada: días hechos, congelados y perdidos. Toca para configurar tu usuario y ver el detalle; «abrir duo» abre la app."
    version: "1.3.2"
    author: "Madmasx"
    license: "MIT"
    category: "fun"
    owl: 9
  }

  source now = clock every 1m
  source sys = android.system every 5m

  // Detección del idioma del sistema
  let rawLocale = sys == null ? "" : (sys.locale ?? "")
  let locLang = lower(first(split(replace(rawLocale, "_", "-"), "-")))
  let isEs = locLang == "" || locLang == "es"

  // Cada persona escribe su propio usuario: se guarda en el launcher, nunca en el archivo.
  state username = "" persist

  // Último día con lección visto, y días que se salvaron con un congelador
  // (la racha siguió viva aunque ese día no hubiera lección).
  state lastEnd = "" persist
  state frozenDays = [] persist

  // La API pública del perfil: los mismos datos que ve la app. Sin usuario aún,
  // se consulta un nombre que no existe (la API rechaza un username vacío).
  let query = username == "" ? "owl-unset" : username
  source duo = http("https://www.duolingo.com/2017-06-30/users?username=${enc(query)}") every 10m timeout 15s json
  let u = duo.users[0]
  let cs = u.streakData.currentStreak
  let streak = cs == null ? num(u.streak) : num(cs.length)
  let totalXp = num(u.totalXp)
  let totalShort = totalXp >= 1000 ? fixed(totalXp / 1000, 1) + "k" : str(totalXp)

  // La racha tal como la cuenta Duolingo: startDate..endDate son días seguidos,
  // y endDate es el último día en que se hizo una lección. Si es hoy, la tarea está hecha.
  let today = fmtTime(now, "yyyy-MM-dd")
  let startDate = cs == null ? "" : (cs.startDate ?? "")
  let endDate = cs == null ? "" : (cs.endDate ?? "")
  let doneToday = endDate != "" && endDate == today

  let courses = (u.courses ?? []).sortBy(c => -num(c.xp))
  // El ajedrez no aparece en `courses`: su XP es lo que sobra del total.
  let chessXp = totalXp - sum(courses.map(c => num(c.xp)))
  let hasChess = chessXp > 0 && contains(u.currentCourseId ?? "", "CHESS")
  let all = flatten([courses, hasChess ? [{ learningLanguage: "chess", title: isEs ? "Ajedrez" : "Chess", xp: chessXp }] : []]).sortBy(c => -num(c.xp))
  let topXp = max(flatten([all.map(c => num(c.xp)), [1]]))

  let langsEs = {
    ru: "Ruso", en: "Inglés", it: "Italiano", ja: "Japonés", zh: "Chino", ko: "Coreano",
    de: "Alemán", fr: "Francés", es: "Español", pt: "Portugués", nl: "Neerlandés",
    sv: "Sueco", no: "Noruego", da: "Danés", pl: "Polaco", tr: "Turco", hi: "Hindi",
    ar: "Árabe", he: "Hebreo", el: "Griego", uk: "Ucraniano", vi: "Vietnamita", eo: "Esperanto",
    chess: "Ajedrez"
  }
  let langsEn = {
    ru: "Russian", en: "English", it: "Italian", ja: "Japanese", zh: "Chinese", ko: "Korean",
    de: "German", fr: "French", es: "Spanish", pt: "Portuguese", nl: "Dutch",
    sv: "Swedish", no: "Norwegian", da: "Danish", pl: "Polish", tr: "Turkish", hi: "Hindi",
    ar: "Arabic", he: "Hebrew", el: "Greek", uk: "Ukrainian", vi: "Vietnamese", eo: "Esperanto",
    chess: "Chess"
  }
  let langs = isEs ? langsEs : langsEn

  let activeCourseList = all.filter(c => contains(u.currentCourseId ?? "", upper(c.learningLanguage)))
  let activeCourse = len(activeCourseList) > 0 ? activeCourseList[0] : (len(all) > 0 ? all[0] : null)
  let activeCourseName = activeCourse == null ? "" : get(langs, activeCourse.learningLanguage, activeCourse.title)

  // Un tile estrecho (la pantalla de inicio en horizontal) encoge la llama y los textos grandes.
  let narrow = tileWidth != null && tileWidth < 170

  // Si la racha sigue viva pero su último día con lección salta más de un día,
  // los días de en medio se salvaron con un congelador: se apuntan.
  on duo {
    let c1 = value.users[0].streakData.currentStreak
    let e = c1 == null ? "" : (c1.endDate ?? "")
    let s1 = c1 == null ? "" : (c1.startDate ?? "")
    let prev = lastEnd
    if prev != "" && e != "" && e > prev {
      let gap = int(round((parseTime(e) - parseTime(prev)) / 86400, 0)) - 1
      if gap > 0 && s1 != "" && s1 <= prev {
        let add = range(gap).map(i => fmtTime(parseTime(prev) + (i + 1) * 86400, "yyyy-MM-dd"))
        frozenDays = unique(flatten([frozenDays, add]))
      }
    }
    if e != "" { lastEnd = e }
    let cutoff = fmtTime(now - 35 * 86400, "yyyy-MM-dd")
    frozenDays = frozenDays.filter(x => x >= cutoff)
  }

  // Tocar el tile abre el detalle y la configuración; para la app, el enlace de arriba.
  onTap: screen()

  // ---- La llama de Duolingo: encendida si hoy está hecha la tarea ----
  component Flame(sz = 44, lit = true) {
    Canvas {
      width: sz
      height: sz * 1.15
      let fw = sz
      let fh = sz * 1.15

      // Halo: solo cuando está encendida
      circle(fw * 0.5, fh * 0.58, fw * 0.66, fill: radial(fw * 0.5, fh * 0.58, fw * 0.66, [alpha("#FF9600", lit ? 0.30 : 0), alpha("#FF9600", 0)]))

      // Silueta exterior
      let O = [
        [0.520, 0.030], [0.549, 0.064], [0.584, 0.105], [0.624, 0.153], [0.666, 0.207],
        [0.707, 0.267], [0.746, 0.331], [0.780, 0.400], [0.807, 0.473], [0.825, 0.549],
        [0.831, 0.627], [0.824, 0.708], [0.800, 0.790], [0.784, 0.821], [0.767, 0.850],
        [0.747, 0.876], [0.727, 0.900], [0.704, 0.921], [0.680, 0.939], [0.654, 0.954],
        [0.627, 0.967], [0.598, 0.977], [0.567, 0.984], [0.534, 0.989], [0.500, 0.990],
        [0.451, 0.988], [0.403, 0.982], [0.358, 0.971], [0.316, 0.957], [0.277, 0.939],
        [0.242, 0.916], [0.212, 0.890], [0.187, 0.860], [0.168, 0.825], [0.155, 0.787],
        [0.149, 0.746], [0.150, 0.700], [0.158, 0.652], [0.172, 0.608], [0.190, 0.566],
        [0.211, 0.527], [0.234, 0.490], [0.256, 0.454], [0.277, 0.418], [0.295, 0.383],
        [0.309, 0.347], [0.317, 0.310], [0.318, 0.271], [0.310, 0.230], [0.308, 0.208],
        [0.313, 0.187], [0.323, 0.168], [0.338, 0.149], [0.356, 0.132], [0.378, 0.115],
        [0.401, 0.099], [0.426, 0.084], [0.451, 0.070], [0.475, 0.056], [0.499, 0.043],
        [0.520, 0.030]
      ]
      path(O.map(p => [p[0] * fw, p[1] * fh]), closed: true,
        fill: lit
          ? linear(0, 0, 0, fh, ["#FFC800", "#FF9600", "#FF4B00"])
          : linear(0, 0, 0, fh, [alpha(muted, 0.70), alpha(muted, 0.44)]))

      // Llama interior
      let I = [
        [0.512, 0.500], [0.536, 0.521], [0.566, 0.548], [0.600, 0.579], [0.632, 0.615],
        [0.662, 0.655], [0.684, 0.698], [0.697, 0.744], [0.697, 0.792], [0.680, 0.840],
        [0.667, 0.859], [0.652, 0.875], [0.636, 0.890], [0.618, 0.902], [0.598, 0.912],
        [0.576, 0.920], [0.552, 0.925], [0.527, 0.929], [0.500, 0.930], [0.461, 0.928],
        [0.424, 0.923], [0.390, 0.915], [0.359, 0.904], [0.333, 0.889], [0.312, 0.872],
        [0.298, 0.851], [0.290, 0.827], [0.290, 0.800], [0.297, 0.772], [0.310, 0.746],
        [0.327, 0.723], [0.345, 0.701], [0.362, 0.679], [0.377, 0.658], [0.387, 0.637],
        [0.391, 0.614], [0.386, 0.590], [0.386, 0.577], [0.392, 0.565], [0.403, 0.553],
        [0.418, 0.543], [0.436, 0.533], [0.455, 0.524], [0.475, 0.516], [0.495, 0.508],
        [0.512, 0.500]
      ]
      path(I.map(p => [p[0] * fw, p[1] * fh]), closed: true,
        fill: lit
          ? linear(0, fh * 0.50, 0, fh, ["#FFF7B0", "#FFC800"])
          : linear(0, fh * 0.50, 0, fh, [alpha(muted, 0.62), alpha(muted, 0.50)]))

      // Ojos
      let ey = fh * 0.41
      let er = fw * 0.085
      circle(fw * 0.375, ey, er, fill: lit ? "#FFFFFF" : alpha(foreground, 0.24))
      circle(fw * 0.625, ey, er, fill: lit ? "#FFFFFF" : alpha(foreground, 0.24))
      circle(fw * 0.375, ey + fh * 0.012, er * 0.44, fill: lit ? "#3A1D00" : alpha(foreground, 0.42))
      circle(fw * 0.625, ey + fh * 0.012, er * 0.44, fill: lit ? "#3A1D00" : alpha(foreground, 0.42))
    }
  }

  // ---- La semana en curso, de lunes a domingo: hecho, congelado, perdido o pendiente ----
  component Week(h = 28, fs = 9) {
    Canvas {
      fill: width
      height: h
      let n = 7
      let cw = width / n
      let r = h * 0.29
      let cy = h * 0.33
      // Día de la semana de hoy, 0 = lunes, sin depender del idioma del teléfono.
      let dow = max(0, indexOf(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], fmtTime(now, "EEEE", null, "en")))
      let wdNames = isEs ? ["L", "M", "X", "J", "V", "S", "D"] : ["M", "T", "W", "T", "F", "S", "S"]
      for i in range(n) {
        let tt = now - dow * 86400 + i * 86400
        let d = fmtTime(tt, "yyyy-MM-dd")
        let wd = wdNames[i]
        let inStreak = d >= startDate && d <= endDate
        let isToday = d == today
        let future = d > today
        // Congelado: apuntado antes, o un día pasado tras el último día con lección
        // con la racha todavía viva (si se hubiera roto, no habría racha).
        let frozen = any(frozenDays, x => x == d) || (startDate != "" && d > endDate && d < today)
        let st = isToday ? (doneToday ? "done" : "pending") : future ? "pending" : frozen ? "frozen" : inStreak ? "done" : "missed"
        let cx = cw * (i + 0.5)
        let bg = st == "done" ? "#FF9600" : st == "frozen" ? "#4FB3FF" : st == "pending" ? alpha(muted, 0.10) : alpha(muted, 0.16)
        circle(cx, cy, r, fill: bg, stroke: st == "pending" ? alpha(muted, 0.80) : bg, width: 1.3)
        // check
        line(cx - r * 0.42, cy, cx - r * 0.10, cy + r * 0.34, stroke: st == "done" ? "#FFFFFF" : alpha("#FFFFFF", 0), width: max(1.2, r * 0.18), cap: round)
        line(cx - r * 0.10, cy + r * 0.34, cx + r * 0.46, cy - r * 0.40, stroke: st == "done" ? "#FFFFFF" : alpha("#FFFFFF", 0), width: max(1.2, r * 0.18), cap: round)
        // copo de nieve
        for a in [0, 60, 120] {
          line(cx - cos(a) * r * 0.52, cy - sin(a) * r * 0.52, cx + cos(a) * r * 0.52, cy + sin(a) * r * 0.52,
            stroke: st == "frozen" ? "#FFFFFF" : alpha("#FFFFFF", 0), width: max(0.9, r * 0.11), cap: round)
        }
        // perdido
        line(cx - r * 0.30, cy - r * 0.30, cx + r * 0.30, cy + r * 0.30, stroke: st == "missed" ? alpha(foreground, 0.50) : alpha("#FFFFFF", 0), width: max(1, r * 0.16), cap: round)
        line(cx + r * 0.30, cy - r * 0.30, cx - r * 0.30, cy + r * 0.30, stroke: st == "missed" ? alpha(foreground, 0.50) : alpha("#FFFFFF", 0), width: max(1, r * 0.16), cap: round)
        text(wd, cx, cy + r + fs * 1.05, size: fs, align: center, color: isToday ? foreground : muted, bold: isToday)
      }
    }
  }

  Column {
    gap: 4
    fill: height
    Row {
      align: center
      Text { text: "DUOLINGO"; style: label; bold: true; color: "#58CC02"; weight: 1; maxLines: 1 }
      Text { text: isEs ? "abrir ›" : "open ›"; style: label; color: accent; align: end; width: 64; maxLines: 1; onTap: androidApp("com.duolingo") }
    }
    Row {
      gap: narrow ? 6 : 10
      align: center
      weight: 1
      Flame { sz: narrow ? 34 : 44; lit: doneToday }
      Column {
        gap: 1
        weight: 1
        if username == "" {
          Text { text: isEs ? "Configura" : "Set up"; style: narrow ? "body" : "title"; color: muted; maxLines: 1 }
          Text { text: isEs ? "tu usuario" : "username"; style: small; color: muted; maxLines: 1 }
        } else {
          Text { text: u == null ? "…" : "${streak}"; fontSize: narrow ? 28 : 38; bold: true; color: doneToday ? "#FF9600" : muted; maxLines: 1 }
          Text { text: isEs ? (streak == 1 ? "DÍA DE RACHA" : "DÍAS DE RACHA") : (streak == 1 ? "DAY STREAK" : "DAYS STREAK"); style: small; bold: true; color: alpha(foreground, 0.78); maxLines: 1 }
          Text { text: doneToday ? (isEs ? "hoy hecha" : "done today") : (isEs ? "hoy pendiente" : "not done today"); style: label; color: doneToday ? "#58CC02" : muted; maxLines: 1 }
        }
      }
    }
    if startDate != "" && (tileHeight ?? 999) >= 170 { Week { h: 28; fs: 8 } }
    Text {
      text: username == ""
        ? (isEs ? "toca para configurar" : "tap to configure")
        : (u == null ? "duolingo…" : "${activeCourseName != "" ? activeCourseName + " · " : ""}${totalShort} XP")
      style: small
      color: muted
      maxLines: 1
    }
  }

  screen {
    title: "duolingo"
    Column {
      scroll: true
      gap: 14
      Input { placeholder: isEs ? "tu usuario de Duolingo" : "your Duolingo username"; clear: true; onSubmit: { username = trim(value); lastEnd = ""; frozenDays = []; refresh() } }
      if username == "" {
        Text { text: isEs ? "Escribe arriba tu nombre de usuario de Duolingo y pulsa enviar para ver tu racha y tus cursos." : "Type your Duolingo username above and press enter to view your streak and courses."; style: body; color: muted }
      } else {
        if duo != null && u == null {
          Text { text: isEs ? "usuario \"${username}\" no encontrado" : "user \"${username}\" not found"; style: body; color: muted }
        } else {
          Column {
            gap: 14
            Row {
              gap: 16
              align: center
              Flame { sz: 64; lit: doneToday }
              Column {
                gap: 2
                weight: 1
                Text { text: duo == null ? "…" : "${streak}"; fontSize: 48; bold: true; color: doneToday ? "#FF9600" : muted; maxLines: 1 }
                Text { text: isEs ? (streak == 1 ? "Día de racha" : "Días de racha") : (streak == 1 ? "Day streak" : "Days streak"); style: body; bold: true; color: foreground }
                Text { text: doneToday ? (isEs ? "tarea de hoy hecha" : "today's task done") : (isEs ? "aún no haces la tarea de hoy" : "today's task still pending"); style: small; bold: true; color: doneToday ? "#58CC02" : muted }
                Text { text: isEs ? "${totalShort} XP acumulados" : "${totalShort} total XP"; style: small; color: muted }
              }
            }
            Week { h: 40; fs: 11 }
            Text { text: isEs ? "✓ hecho   ❄ congelado   ✕ perdido" : "✓ done   ❄ frozen   ✕ missed"; style: label; color: muted }
            Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
            Text { text: isEs ? "cursos" : "courses"; style: label; color: accent }
            for c, i in all key c.learningLanguage {
              Row {
                gap: 10
                align: center
                let cx = num(c.xp)
                let cxs = cx >= 1000 ? fixed(cx / 1000, 1) + "k" : str(cx)
                let isCurrent = contains(u.currentCourseId ?? "", upper(c.learningLanguage))
                Text { text: get(langs, c.learningLanguage, c.title); style: body; width: 96; maxLines: 1 }
                Canvas {
                  height: 8
                  weight: 1
                  rect(0, 1, width, 6, radius: 3, fill: alpha(muted, 0.2))
                  rect(0, 1, max(width * num(c.xp) / max(topXp, 1), 6), 6, radius: 3, fill: isCurrent ? "#58CC02" : "#FF9600")
                }
                Text { text: cxs; style: small; color: muted; width: 56; align: end; maxLines: 1 }
              }
            }
            Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
            Row {
              justify: end
              Button { text: isEs ? "abrir duolingo ↗" : "open duolingo ↗"; color: "#58CC02"; onTap: androidApp("com.duolingo") }
            }
          }
        }
      }

      Spacer { size: 6 }
      Text {
        text: isEs ? "Creado por Madmasx" : "Created by Madmasx"
        style: label
        color: foreground
      }
      Row {
        gap: 8
        Button {
          text: "X: @Madmasx"
          weight: 1
          onTap: url("https://x.com/Madmasx")
        }
        Button {
          text: "Git: Madmasx"
          weight: 1
          onTap: url("https://github.com/Madmasx")
        }
      }
      Spacer { size: 4 }
      Button {
        text: isEs ? "Cerrar" : "Close"
        color: muted
        onTap: close()
      }
    }
  }
}
