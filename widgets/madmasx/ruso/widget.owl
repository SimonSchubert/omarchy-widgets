widget "ruso" {
  size: 4x3
  minSize: 3x2
  meta { description: "215 frases en ruso con pronunciación para hispanohablantes y su traducción al español, rotando cada 15 minutos. Toca para ver todas y escucharlas con espeak-ng"; version: "1.0"; license: "MIT"; category: "fun"; owl: 6 }
  requires { pacman: ["espeak-ng"] }

  source now = clock every 1s

  // Frases adaptadas de github.com/Madmasx/russian-phrases-omarchy (MIT).
  let phrases = [
    { ru: "Здравствуйте", pron: "zdrástvuite", es: "Hola (formal)" },
    { ru: "Привет", pron: "privét", es: "Hola (informal)" },
    { ru: "Доброе утро", pron: "dóbraye útro", es: "Buenos días" },
    { ru: "Добрый день", pron: "dóbryi den", es: "Buenas tardes" },
    { ru: "Добрый вечер", pron: "dóbryi vécher", es: "Buenas noches (al llegar)" },
    { ru: "Спокойной ночи", pron: "spakóinoi nóchi", es: "Buenas noches (al irse)" },
    { ru: "Как дела?", pron: "kak dilá?", es: "¿Cómo estás?" },
    { ru: "Как у тебя дела?", pron: "kak u tibyá dilá?", es: "¿Cómo te va?" },
    { ru: "Хорошо", pron: "jarashó", es: "Bien" },
    { ru: "Нормально", pron: "narmálna", es: "Más o menos" },
    { ru: "Отлично", pron: "atlíchna", es: "Genial" },
    { ru: "Плохо", pron: "plója", es: "Mal" },
    { ru: "Спасибо", pron: "spasíba", es: "Gracias" },
    { ru: "Большое спасибо", pron: "bal-shóye spasíba", es: "Muchas gracias" },
    { ru: "Пожалуйста", pron: "pazháluista", es: "Por favor / De nada" },
    { ru: "Не за что", pron: "ne za shta", es: "De nada" },
    { ru: "Извините", pron: "izviníte", es: "Disculpe (formal)" },
    { ru: "Прости", pron: "prastí", es: "Perdón (informal)" },
    { ru: "Ничего", pron: "nichivó", es: "No pasa nada" },
    { ru: "Да", pron: "da", es: "Sí" },
    { ru: "Нет", pron: "nyet", es: "No" },
    { ru: "Может быть", pron: "mózhet byt", es: "Quizás / Puede ser" },
    { ru: "Конечно", pron: "kanéshna", es: "Por supuesto / Claro" },
    { ru: "Точно", pron: "tóchna", es: "Exacto" },
    { ru: "Ладно", pron: "ládna", es: "Vale / Bueno" },
    { ru: "Я не знаю", pron: "ya ne znáyu", es: "No sé" },
    { ru: "Я понимаю", pron: "ya panimáyu", es: "Entiendo" },
    { ru: "Я не понимаю", pron: "ya ne panimáyu", es: "No entiendo" },
    { ru: "Ты понимаешь?", pron: "ty panimáyesh?", es: "¿Entiendes?" },
    { ru: "Повторите, пожалуйста", pron: "pavtaríte, pazháluista", es: "Repita, por favor" },
    { ru: "Говорите медленнее", pron: "gavaríte médlenie", es: "Hable más despacio" },
    { ru: "Как это называется?", pron: "kak éta nazyváetsa?", es: "¿Cómo se llama esto?" },
    { ru: "Что это значит?", pron: "shto éta znáchit?", es: "¿Qué significa esto?" },
    { ru: "Как сказать по-русски ...?", pron: "kak skazat pa-rúski ...?", es: "¿Cómo se dice en ruso ...?" },
    { ru: "Вы говорите по-английски?", pron: "vy gavaríte pa-anglíiski?", es: "¿Habla inglés?" },
    { ru: "Я учу русский", pron: "ya uchú rúski", es: "Estoy aprendiendo ruso" },
    { ru: "Я немного говорю по-русски", pron: "ya nimnóga gavariú pa-rúski", es: "Hablo un poco de ruso" },
    { ru: "Я не говорю по-русски", pron: "ya ne gavariú pa-rúski", es: "No hablo ruso" },
    { ru: "Мне трудно говорить", pron: "mne trúdna gavarít", es: "Me cuesta hablar" },
    { ru: "Как тебя зовут?", pron: "kak tibyá zavút?", es: "¿Cómo te llamas?" },
    { ru: "Меня зовут ...", pron: "minyá zavút ...", es: "Me llamo ..." },
    { ru: "Откуда ты?", pron: "atkúda ty?", es: "¿De dónde eres?" },
    { ru: "Я из Испании", pron: "ya iz Ispánii", es: "Soy de España" },
    { ru: "Я из Латинской Америки", pron: "ya iz Latínskoi Amériki", es: "Soy de Latinoamérica" },
    { ru: "Сколько тебе лет?", pron: "skólka tibé let?", es: "¿Cuántos años tienes?" },
    { ru: "Мне двадцать пять лет", pron: "mne dvátsat piat let", es: "Tengo 25 años" },
    { ru: "Где ты живёшь?", pron: "gdie ti zhiviósh?", es: "¿Dónde vives?" },
    { ru: "Я живу в ...", pron: "ya zhivú v ...", es: "Vivo en ..." },
    { ru: "Чем ты занимаешься?", pron: "chem ty zanimáieshia?", es: "¿A qué te dedicas?" },
    { ru: "Я работаю", pron: "ya rabótaiu", es: "Trabajo" },
    { ru: "Я учусь", pron: "ya uchús", es: "Estudio" },
    { ru: "Приятно познакомиться", pron: "priyátna paznakómitsa", es: "Encantado de conocerte" },
    { ru: "Очень приятно", pron: "óchen priyátna", es: "Mucho gusto" },
    { ru: "Рад тебя видеть", pron: "rat tibyá vídet", es: "Me alegro de verte" },
    { ru: "Как погода?", pron: "kak pagóda?", es: "¿Qué tiempo hace?" },
    { ru: "Сегодня хорошая погода", pron: "sivódnia jaróshaya pagóda", es: "Hoy hace buen tiempo" },
    { ru: "Идёт дождь", pron: "idiót dozhd", es: "Está lloviendo" },
    { ru: "Тепло", pron: "tepló", es: "Hace calor agradable" },
    { ru: "Жарко", pron: "zhárka", es: "Hace mucho calor" },
    { ru: "Холодно", pron: "jóladna", es: "Hace frío" },
    { ru: "Мне холодно", pron: "mne jóladna", es: "Tengo frío" },
    { ru: "Мне жарко", pron: "mne zhárka", es: "Tengo calor" },
    { ru: "Где находится ...?", pron: "gdie najóditsa ...?", es: "¿Dónde está ...?" },
    { ru: "Где туалет?", pron: "gdie tualét?", es: "¿Dónde está el baño?" },
    { ru: "Как пройти?", pron: "kak praití?", es: "¿Cómo se llega?" },
    { ru: "Куда идти?", pron: "kudá ití?", es: "¿Hacia dónde voy?" },
    { ru: "Прямо", pron: "pryáma", es: "Recto" },
    { ru: "Налево", pron: "naléva", es: "A la izquierda" },
    { ru: "Направо", pron: "napráva", es: "A la derecha" },
    { ru: "Далеко", pron: "dalekó", es: "Lejos" },
    { ru: "Близко", pron: "blíska", es: "Cerca" },
    { ru: "Где остановка?", pron: "gdie astanóvka?", es: "¿Dónde está la parada?" },
    { ru: "Где автобус?", pron: "gdie ávtobus?", es: "¿Dónde está el autobús?" },
    { ru: "Какой номер автобуса?", pron: "kakói nómer ávtobusa?", es: "¿Qué número de autobús?" },
    { ru: "Сколько стоит билет?", pron: "skólka stóit bilét?", es: "¿Cuánto cuesta el billete?" },
    { ru: "Я потерялся", pron: "ya pateriálsia", es: "Me he perdido" },
    { ru: "Я потерялась", pron: "ya pateriálas", es: "Me he perdido (ella)" },
    { ru: "Помогите, пожалуйста", pron: "pamagíte, pazháluista", es: "Ayúdeme, por favor" },
    { ru: "Вы можете помочь?", pron: "vy mózhete pamóch?", es: "¿Puede ayudarme?" },
    { ru: "Сколько это стоит?", pron: "skólka éta stóit?", es: "¿Cuánto cuesta esto?" },
    { ru: "Дорого", pron: "dóraga", es: "Es caro" },
    { ru: "Дёшево", pron: "dióshiva", es: "Es barato" },
    { ru: "Можно посмотреть?", pron: "mózna pasmatrét?", es: "¿Puedo verlo?" },
    { ru: "Я хочу купить ...", pron: "ya jachú kupít ...", es: "Quiero comprar ..." },
    { ru: "Мне нужен ...", pron: "mne núzhen ...", es: "Necesito ..." },
    { ru: "Есть другой размер?", pron: "yest drugói razmér?", es: "¿Hay otra talla?" },
    { ru: "Можно наличными?", pron: "mózna nalíchnymi?", es: "¿Se puede pagar en efectivo?" },
    { ru: "Счёт, пожалуйста", pron: "schiot, pazháluista", es: "La cuenta, por favor" },
    { ru: "Вкусно!", pron: "fkúsna", es: "¡Está rico!" },
    { ru: "Очень вкусно!", pron: "óchen fkúsna", es: "¡Delicioso!" },
    { ru: "Я голоден", pron: "ya góladen", es: "Tengo hambre" },
    { ru: "Я хочу есть", pron: "ya jachú yest", es: "Tengo ganas de comer" },
    { ru: "Я хочу пить", pron: "ya jachú pit", es: "Tengo sed" },
    { ru: "Чай", pron: "chai", es: "Té" },
    { ru: "Кофе", pron: "kófe", es: "Café" },
    { ru: "Хлеб", pron: "jleb", es: "Pan" },
    { ru: "Вода", pron: "vadá", es: "Agua" },
    { ru: "Мясо", pron: "miása", es: "Carne" },
    { ru: "Рыба", pron: "rýba", es: "Pescado" },
    { ru: "Овощи", pron: "óvashi", es: "Verduras" },
    { ru: "Фрукты", pron: "frúkti", es: "Frutas" },
    { ru: "Яблоко", pron: "yáblaka", es: "Manzana" },
    { ru: "Молоко", pron: "malakó", es: "Leche" },
    { ru: "Сыр", pron: "sir", es: "Queso" },
    { ru: "Который час?", pron: "katóri chas?", es: "¿Qué hora es?" },
    { ru: "Сегодня", pron: "sivódnia", es: "Hoy" },
    { ru: "Завтра", pron: "závtra", es: "Mañana" },
    { ru: "Вчера", pron: "vcherá", es: "Ayer" },
    { ru: "Сейчас", pron: "seichás", es: "Ahora" },
    { ru: "Потом", pron: "patóm", es: "Después / Luego" },
    { ru: "Утром", pron: "útram", es: "Por la mañana" },
    { ru: "Днём", pron: "dniom", es: "Por el día" },
    { ru: "Вечером", pron: "vécheram", es: "Por la noche" },
    { ru: "Давай встретимся завтра", pron: "davái fstrétimsia závtra", es: "Quedemos mañana" },
    { ru: "Во сколько?", pron: "va skólka?", es: "¿A qué hora?" },
    { ru: "Я опаздываю", pron: "ya apázdivaiu", es: "Llego tarde" },
    { ru: "Я счастлив", pron: "ya schástliv", es: "Soy feliz / Estoy feliz" },
    { ru: "Я устал", pron: "ya ustál", es: "Estoy cansado" },
    { ru: "Я занят", pron: "ya zániat", es: "Estoy ocupado" },
    { ru: "Я спешу", pron: "ya spishú", es: "Tengo prisa" },
    { ru: "Мне нравится", pron: "mne nrávitsa", es: "Me gusta" },
    { ru: "Я люблю тебя", pron: "ya liubliú tibyá", es: "Te quiero" },
    { ru: "Я тоже", pron: "ya tózhe", es: "Yo también" },
    { ru: "Не переживай", pron: "ne perezhivái", es: "No te preocupes" },
    { ru: "Всё будет хорошо", pron: "fsio búdet jarashó", es: "Todo saldrá bien" },
    { ru: "Удачи!", pron: "udáchi!", es: "¡Buena suerte!" },
    { ru: "Поздравляю!", pron: "pazdravliáiu!", es: "¡Felicitaciones!" },
    { ru: "Будьте здоровы", pron: "búdte zdoróvy", es: "¡A tus salud!" },
    { ru: "Осторожно!", pron: "astarózhna!", es: "¡Cuidado!" },
    { ru: "Правда?", pron: "právda?", es: "¿De verdad?" },
    { ru: "Круто!", pron: "krúta", es: "¡Genial! (coloquial)" },
    { ru: "До свидания", pron: "da svidánia", es: "Hasta luego (formal)" },
    { ru: "Пока", pron: "paká", es: "Adiós / Chao" },
    { ru: "Увидимся", pron: "uvídimsia", es: "Nos vemos" },
    { ru: "До встречи!", pron: "da fstréchi", es: "¡Hasta la próxima!" },
    { ru: "Добро пожаловать!", pron: "dabró pazhálavat", es: "¡Bienvenido/a!" },
    { ru: "Помогите!", pron: "pamagíte!", es: "¡Ayuda!" },
    { ru: "Вызовите скорую!", pron: "vízavite skóruiu!", es: "¡Llame una ambulancia!" },
    { ru: "Вызовите полицию!", pron: "vízavite palítsiiu!", es: "¡Llame a la policía!" },
    { ru: "Вызовите пожарных!", pron: "vízavite pazhárnyj!", es: "¡Llame a los bomberos!" },
    { ru: "Где больница?", pron: "gde bálnitsa?", es: "¿Dónde está el hospital?" },
    { ru: "Я потерялся", pron: "ya pateriálsia", es: "Me he perdido" },
    { ru: "Я потерялась", pron: "ya pateriálas", es: "Me he perdido (femenino)" },
    { ru: "Мне плохо", pron: "mne plója", es: "Me siento mal" },
    { ru: "У меня болит голова", pron: "u minia balít galavá", es: "Me duele la cabeza" },
    { ru: "У меня болит живот", pron: "u minia balít zhivót", es: "Me duele la barriga" },
    { ru: "У меня болит горло", pron: "u minia balít górla", es: "Me duele la garganta" },
    { ru: "Мне нужен врач", pron: "mne núzhen vrach", es: "Necesito un médico" },
    { ru: "Автобус", pron: "áftobus", es: "Autobús" },
    { ru: "Метро", pron: "mitró", es: "Metro" },
    { ru: "Трамвай", pron: "tramvái", es: "Tranvía" },
    { ru: "Троллейбус", pron: "traleibus", es: "Trolebús" },
    { ru: "Такси", pron: "taksí", es: "Taxi" },
    { ru: "Поезд", pron: "póizd", es: "Tren" },
    { ru: "Самолёт", pron: "samaliót", es: "Avión" },
    { ru: "Вокзал", pron: "vagzal", es: "Estación de tren" },
    { ru: "Аэропорт", pron: "aerapórt", es: "Aeropuerto" },
    { ru: "Остановка", pron: "astanófka", es: "Parada" },
    { ru: "Билет", pron: "bilét", es: "Billete" },
    { ru: "Сколько стоит билет?", pron: "skólka stóit bilét?", es: "¿Cuánto cuesta el billete?" },
    { ru: "Один билет, пожалуйста", pron: "adín bilét, pazháluista", es: "Un billete, por favor" },
    { ru: "Когда отправляется поезд?", pron: "kagdá atprávliaetsa póizd?", es: "¿Cuándo sale el tren?" },
    { ru: "Как доехать до центра?", pron: "kak dayéjat da tséntra?", es: "¿Cómo llego al centro?" },
    { ru: "Отель", pron: "atél", es: "Hotel" },
    { ru: "Гостиница", pron: "gastínitsa", es: "Hotel / Hostal" },
    { ru: "Номер", pron: "nómer", es: "Habitación" },
    { ru: "У меня забронирован номер", pron: "u minia zabraníravan nómer", es: "Tengo una habitación reservada" },
    { ru: "Свободный номер есть?", pron: "svabódnyi nómer yest?", es: "¿Hay habitación libre?" },
    { ru: "Где мой номер?", pron: "gde moi nómer?", es: "¿Dónde está mi habitación?" },
    { ru: "Включён ли завтрак?", pron: "fklichón li závtrak?", es: "¿El desayuno está incluido?" },
    { ru: "Wi-Fi", pron: "váifai", es: "Wi-Fi" },
    { ru: "Есть интернет?", pron: "yest internet?", es: "¿Hay internet?" },
    { ru: "Выход", pron: "výjod", es: "Salida" },
    { ru: "Вход", pron: "fhot", es: "Entrada" },
    { ru: "Город", pron: "górat", es: "Ciudad" },
    { ru: "Улица", pron: "úlitsa", es: "Calle" },
    { ru: "Площадь", pron: "plóshchat", es: "Plaza" },
    { ru: "Мост", pron: "most", es: "Puente" },
    { ru: "Магазин", pron: "magazín", es: "Tienda" },
    { ru: "Аптека", pron: "aptéka", es: "Farmacia" },
    { ru: "Банк", pron: "bank", es: "Banco" },
    { ru: "Почта", pron: "póchta", es: "Correos" },
    { ru: "Музей", pron: "muzéi", es: "Museo" },
    { ru: "Парк", pron: "park", es: "Parque" },
    { ru: "Театр", pron: "teátr", es: "Teatro" },
    { ru: "Кинотеатр", pron: "kinateátr", es: "Cine" },
    { ru: "Церковь", pron: "tsérkaf", es: "Iglesia" },
    { ru: "Где находится …?", pron: "gde najóditsa …?", es: "¿Dónde está …?" },
    { ru: "Как пройти к центру?", pron: "kak praití k tséntru?", es: "¿Cómo se va al centro?" },
    { ru: "Я думаю", pron: "ya dúnaiu", es: "Creo / Pienso" },
    { ru: "Я считаю", pron: "ya schitáiu", es: "Opino que" },
    { ru: "Мне кажется", pron: "mne kázhetsa", es: "Me parece que" },
    { ru: "По-моему", pron: "pa-móiemu", es: "En mi opinión" },
    { ru: "Ты прав", pron: "ti prav", es: "Tienes razón" },
    { ru: "Ты права", pron: "ti prav`", es: "Tienes razón (a ella)" },
    { ru: "Я согласен", pron: "ya saglásen", es: "Estoy de acuerdo" },
    { ru: "Я не согласен", pron: "ya ne saglásen", es: "No estoy de acuerdo" },
    { ru: "Может быть", pron: "mózhet bit", es: "Puede ser" },
    { ru: "Наверное", pron: "navérnaie", es: "Probablemente" },
    { ru: "Конечно!", pron: "kanéshna!", es: "¡Claro / Por supuesto!" },
    { ru: "Нет проблем!", pron: "net prabliem!", es: "¡No hay problema!" },
    { ru: "Мне всё равно", pron: "mne fsio ravnó", es: "Me da igual" },
    { ru: "Я рад", pron: "ya rat", es: "Me alegro" },
    { ru: "Я рада", pron: "ya ráda", es: "Me alegro (femenino)" },
    { ru: "Очень хорошо!", pron: "óchen jarashó!", es: "¡Muy bien!" },
    { ru: "Плохо", pron: "plója", es: "Mal" },
    { ru: "Скучно", pron: "skúchna", es: "Aburrido" },
    { ru: "Весело!", pron: "vésela!", es: "¡Divertido!" },
    { ru: "Смешно!", pron: "smishnó!", es: "¡Qué gracia!" },
    { ru: "Печально", pron: "pechálna", es: "Triste" },
    { ru: "Странно", pron: "stránna", es: "Extraño" },
    { ru: "Интересно!", pron: "interésna!", es: "¡Interesante!" },
    { ru: "Я не знаю", pron: "ya ne znáiu", es: "No lo sé" },
    { ru: "Я забыл", pron: "ya zabíl", es: "Lo olvidé" },
    { ru: "Я не помню", pron: "ya ne pómn`u", es: "No lo recuerdo" },
  ]
  let total = len(phrases)

  state idx = 0 persist
  state nextAt = 0 persist
  let p = phrases[idx % total] ?? phrases[0]
  let left = nextAt > now ? nextAt - now : 0

  // Rota sola cada 15 min, incluso con la página fuera de pantalla. El reloj (`now`)
  // se pausa cuando la página no está viva, así que para reprogramar nos apoyamos en el
  // propio `nextAt` (max con `now`) y nunca lo dejamos caer al pasado.
  at nextAt {
    idx = now == null ? idx : (idx + 1) % total
    nextAt = now == null ? 0 : max(now, nextAt) + 15 * 60
  }
  when nextAt == 0 && now != null { nextAt = now + 15 * 60 }

  onTap: screen()

  Column {
    gap: 4
    Row {
      Text { text: "РУССКИЙ"; style: label; color: muted }
      Spacer { weight: 1 }
    }
    Spacer { weight: 1 }
    Text { text: p.ru; fontSize: 24; bold: true; maxLines: 3 }
    Text { text: p.pron; fontSize: 14; italic: true; color: muted; maxLines: 2 }
    Text { text: p.es; fontSize: 15; color: accent; maxLines: 2 }
    Spacer { weight: 1 }
    Row {
      gap: 8
      align: center
      Progress { value: left; max: 15 * 60; weight: 1; color: accent; track: alpha(muted, 0.2) }
      Text { text: fmtDuration(left); style: small; color: muted; width: 56; align: end }
      Button { text: "♪"; color: accent; onTap: run("espeak-ng -v ru ${sh(p.ru)}") }
    }
  }

  screen {
    title: "ruso · frases"
    Column {
      scroll: true
      gap: 10
      Row {
        gap: 8
        align: center
        Text { text: "${total} frases · español → ruso"; style: small; color: muted; weight: 1 }
        Button { text: "oir"; color: accent; onTap: run("espeak-ng -v ru ${sh(p.ru)}") }
        Button { text: "cerrar"; color: muted; onTap: close() }
      }
      Text { text: "toca una frase para mostrarla en el widget"; style: label; color: muted }
      for ph, i in phrases key i {
        Row {
          gap: 8
          padding: [0, 6]
          onTap: { idx = i; nextAt = now + 15 * 60; close() }
          Text { text: "${i + 1}"; font: mono; fontSize: 13; color: muted; width: 34; align: end }
          Column {
            gap: 0
            weight: 1
            Text { text: ph.ru; fontSize: 18; bold: true; color: i == idx % total ? accent : foreground }
            Text { text: ph.pron; fontSize: 13; italic: true; color: muted }
            Text { text: ph.es; fontSize: 13; color: i == idx % total ? accent : muted }
          }
        }
      }
    }
  }
}
