widget "on this day" {
  size: 6x4
  minSize: 3x3
  meta { description: "Moments from history on today's date, from Wikipedia, as a grid of pictures of what happened. Tap for all of them"; version: "1.1"; license: "MIT"; category: "world"; owl: 8 }
  // Only an http source: no shell commands, so no packages.
  requires { pacman: [] }

  source now = clock every 1m
  let mm = fmtTime(now, "MM")
  let dd = fmtTime(now, "dd")
  // Wikipedia's editor-selected events for today; refetched when the date changes.
  source feed = http("https://en.wikipedia.org/api/rest_v1/feed/onthisday/selected/${enc(mm)}/${enc(dd)}") every 6h timeout 20s json
  // Each event with the first linked page that has a picture; events without one are left out.
  let events = (feed.selected ?? [])
    .map(e => {year: e.year, text: e.text, page: first(e.pages.filter(p => p.thumbnail != null))})
    .filter(e => e.page != null)
    .map(e => {
      year: e.year,
      text: e.text,
      title: e.page.titles.normalized,
      art: replace(e.page.thumbnail.source, "/330px-", "/960px-"),
      link: e.page.content_urls.mobile.page
    })
    .sortBy(e => -e.year)

  // As many cards as fit the tile: 3 across from 5 columns, 2 rows from 4.
  let across = (cols ?? 6) >= 5 ? 3 : 2
  let down = (rows ?? 4) >= 4 ? 2 : 1
  let cardHeight = ((tileHeight ?? 400) - 24 - 22 - 8 * down) / down

  onTap: screen()

  // A picture with its year, and the article's title faded in along the bottom.
  component Card(e, h, compact = false) {
    Box {
      fill: width
      height: h
      radius: 6 * corners
      clip: true
      Image { src: e.art; fit: cover; fill: true }
      // Fade the picture into the theme's background so the text reads in any theme.
      Canvas {
        fill: true
        rect(0, 0, width, height, fill: linear(0, height * 0.4, 0, height, [alpha(background, 0), alpha(background, 0.9)]))
      }
      Column {
        fill: true
        gap: 0
        padding: [8, 6]
        Spacer { weight: 1 }
        Text { text: "${e.year}"; fontSize: compact ? 16 : 22; bold: true; color: accent }
        Text { text: e.title; style: small; color: foreground; maxLines: compact ? 1 : 2 }
      }
    }
  }

  if feed == null {
    Column { align: center; justify: center; fill: true
      Text { text: "on this day"; style: label; color: muted; align: center }
      Text { text: "…"; style: title; align: center }
    }
  } else if len(events) == 0 {
    Column { align: center; justify: center; fill: true
      Text { text: "nothing found for today"; style: muted; align: center }
    }
  } else {
    Column {
      gap: 8
      Row {
        align: center
        Text { text: "on this day"; style: label; color: accent; weight: 1 }
        Text { text: "${lower(fmtTime(now, "d MMM"))} · ${len(events)}"; style: label; color: muted; width: 120; align: end }
      }
      Grid {
        columns: across
        gap: 8
        for e in events.take(across * down) key e.text {
          Card { e: e; h: cardHeight; compact: true }
        }
      }
    }
  }

  screen {
    title: "on this day · ${fmtTime(now, "d MMMM")}"
    // Two columns of cards; three on a wide screen.
    let columns = (screenWidth ?? 360) > 600 ? 3 : 2
    let cell = ((screenWidth ?? 360) - 12 * (columns - 1)) / columns
    Column {
      scroll: true
      gap: 12
      Grid {
        columns: columns
        gap: 12
        for e in events key e.text {
          Column {
            gap: 4
            onTap: url(e.link)
            Card { e: e; h: cell }
            Text { text: e.text; style: small; maxLines: 4 }
          }
        }
      }
      Text { text: "from Wikipedia · tap an event to read more"; style: small; color: muted; align: center }
    }
  }
}
