widget "brave" {
  size: 6x1
  minSize: 6x1
  padding: 10
  background: background

  meta { owl: 4; description: "Brave search bar on the home screen: type, hit enter, results open in your browser, plus a Leo AI button."; version: "1.1"; license: "MIT"; category: "productivity" }

  asset lion = base64""
  asset leo = base64""

  state q = ""

  // url() takes the query as typed, so encode what a query string can't carry.
  let enc = replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(q, "%", "%25"), "&", "%26"), "#", "%23"), "?", "%3F"), "+", "%2B"), " ", "+"), "\"", "%22"), "<", "%3C"), ">", "%3E"), "^", "%5E"), "|", "%7C")

  // A tile taller than wide (the landscape home screen) has no room for the Input,
  // so it stacks the lion, a magnifier that opens Brave Search, and Leo.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3

  if tall {
    Column {
      gap: 16
      fill: true
      align: center
      justify: center

      Box {
        size: 44
        align: center
        onTap: androidApp("com.brave.browser")
        Image { src: lion; size: 28 }
      }

      Box {
        size: 44
        align: center
        onTap: url("https://search.brave.com/")
        Canvas {
          width: 22
          height: 22
          circle(9, 9, 7, stroke: foreground, width: 2)
          line(14, 14, 21, 21, stroke: foreground, width: 2)
        }
      }

      Box {
        size: 44
        align: center
        onTap: url("https://search.brave.com/ask")
        Image { src: leo; size: 30 }
      }
    }
  } else {
    Row {
      gap: 10
      align: center
      fill: true

      Box {
        size: 54
        align: center
        onTap: androidApp("com.brave.browser")
        Image { src: lion; size: 28 }
      }

      Box {
        weight: 1
        height: 54
        align: bottomStart
        Input {
          text: q
          placeholder: "search brave…"
          color: foreground
          fill: width
          height: 54
          fontSize: 16
          offset: [0, 5]
          onChange: q = value
          onSubmit: { url(trim(q) == "" ? "https://search.brave.com/" : "https://search.brave.com/search?q=" + enc); q = "" }
        }
        // Input draws a hairline under itself and won't take a border of 0, so the
        // strip below covers it in the tile's own color.
        Box { height: 6; fill: width; offset: [0, 7]; background: background }
      }

      Box {
        size: 54
        align: center
        onTap: url(trim(q) == "" ? "https://search.brave.com/ask" : "https://search.brave.com/ask?q=" + enc)
        Image { src: leo; size: 30 }
      }
    }
  }
}
