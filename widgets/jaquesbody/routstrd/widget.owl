// routstrd — the routstr daemon at a glance: the mark in green while it runs,
// amber when this phone can't reach it, red when it is down; a tap opens the

// wallet, a switch for the daemon, the last 30 days, the monitor's breakdowns,
// the logs and a Lightning top-up. Data and control go through one command,
// routstr-ctl: reads over the SSH tunnel this phone keeps to the desktop,
// start/stop/restart and the journal over SSH, where routstrd listens on its
// own loopback only. The file carries no address, user or token, so the same
// file runs on both devices.
widget "routstrd" {
  meta {
    owl: 16
    description: "Control, monitor and top up your routstr usage. The tile is red, amber or green with your connection status, with every routstrd monitor metric, detailed logs and Lightning payment by QR or invoice."
    version: "1.3"
    license: "MIT"
    category: "dev"
  }

  page: 1
  order: 5
  size: 1x1
  minSize: 1x1
  padding: 8

  // the wrapper reads the daemon through the tunnel with curl + jq, and falls
  // back to ssh; the desktop script uses the same curl + jq there
  requires { pacman: ["openssh", "coreutils", "curl", "jq", "qrencode"] }

  strings {
    en {
      title: "routstrd"
      builtBy: "built by jaquesbody"
      requestsLower: "requests"
      sat: "sat"
      reqs: "reqs"
      tok: "tok"
      satPerReq: "sat/req"
      running: "Running"
      starting: "Starting…"
      stopping: "Stopping…"
      failed: "Failed"
      stopped: "Stopped"
      offline: "Offline"
      unknown: "Unknown"
      unlinked: "Set up"
      host: "Host"
      hostHint: "SSH host of the machine that runs routstrd. Leave it blank to run it on this device."
      save: "Save"
      balance: "Balance"
      spend: "30d spend"
      spent: "Spent"
      requests: "Requests"
      avg: "Avg / request"
      monitor: "Monitor"
      restart: "Restart"
      logs: "Logs"
      topup: "Top up"
      sats: "sats"
      copy: "Copy"
      scan: "Scan with a Lightning wallet"
      cancel: "Cancel"
      awaiting: "Awaiting payment…"
      paid: "Paid — balance will refresh"
      all: "All"
      h24: "24h"
      d7: "7d"
      d30: "30d"
      overview: "Overview"
      history: "History"
      models: "Models"
      providers: "Providers"
      clients: "Clients"
      recent: "Recent"
      tokens: "Tokens"
      avgTokens: "Avg tokens / req"
      promptComp: "Prompt / completion"
      noData: "Nothing in this window"
      unavailable: "—"
    }
  }

  // the routstr mark, from routstr.com/icon.svg, with the stylesheet removed so
  // Image's tint is the only colour it has
  asset logo = base64""

  // ---- state ------------------------------------------------------------
  state view = ""          // "", "monitor" or "logs"
  state win = "today"      // all, today (24h), 7d, 30d
  // blank = run the commands on this device; otherwise an SSH host alias
  state link = "" persist
  state editLink = false
  state linkDraft = ""
  state amount = "2100" persist
  state invRaw = ""
  state quoteId = ""
  state paid = false
  state qrPath = ""
  state quoteRaw = ""
  state topupRaw = ""

  // The helper, written out rather than kept in a script on disk. One shell
  // program covers every verb; ssh runs it on the other machine when a host
  // is set, bash runs the same text here when it isn't. __H__, __V__ and
  // __A__ are filled in per command. No address, user or token is in here.
  let agent = """
H=__H__
verb=__V__
arg=__A__
api=http://127.0.0.1:8008
off() { jq -nc --arg e "$1" --arg s "$2" '{error:$e,service:$s,balance:-1,spent:-1,requests:-1,avg:-1,at:now}'; }
z=$(date +%z)
tz=$((10#$(printf %s "$z" | cut -c2-3) * 60 + 10#$(printf %s "$z" | cut -c4-5)))
case "$z" in -*) tz=$((0 - tz));; esac
trim() {
  jq -c '{w:(.output.window.window // "all"),t:{r:(.output.window.totals.requests // 0),s:(.output.window.totals.satsCost // 0),tok:(.output.window.totals.totalTokens // 0),pt:(.output.window.totals.promptTokens // 0),ct:(.output.window.totals.completionTokens // 0)},m:[.output.window.models[]?|{i:.modelId,r:.requests,s:.satsCost,t:.totalTokens}],p:[.output.window.providers[]?|{u:((.baseUrl // "")|sub("^https?://";"")),r:.requests,s:.satsCost,t:.totalTokens}],c:[.output.window.clients[]?|{c:(.client // "unknown"),r:.requests,s:.satsCost,t:.totalTokens,m:[.topModels[]?|{i:.modelId,r:.requests,s:.satsCost}]}],tl:{p:[.output.window.timeline.points[]?|{t:.timestamp,s:.satsCost}]},rec:[.output.recent[0:20][]?|{t:.timestamp,m:.modelId,c:(.client // ""),s:((.totalMsats // 0)/1000),tok:.totalTokens}]}'
}
case "$verb" in
status)
  svc=$(systemctl --user is-active routstrd.service 2>/dev/null)
  [ -n "$svc" ] || svc=unknown
  stj=$(curl -fsS --max-time 5 "$api/status" 2>/dev/null)
  bj=$(curl -fsS --max-time 5 "$api/keys/balance" 2>/dev/null)
  ua=$(curl -fsS --max-time 6 "$api/usage/summary?tz=$tz&window=30d" 2>/dev/null)
  if [ -z "$stj" ] || [ -z "$bj" ]; then
    if [ -z "$H" ]; then if [ "$svc" = inactive ] || [ "$svc" = failed ]; then off 'routstrd is down' "$svc"; else off 'set the SSH host' unlinked; fi; else off 'no answer from routstrd' "$svc"; fi
    exit 0
  fi
  bal=$(printf '%s' "$bj" | jq -r '.output.total // -1' 2>/dev/null)
  sp=$(printf '%s' "$ua" | jq -r '.output.window.totals.satsCost // -1' 2>/dev/null)
  rq=$(printf '%s' "$ua" | jq -r '.output.window.totals.requests // -1' 2>/dev/null)
  [ -n "$bal" ] || bal=-1
  [ -n "$sp" ] || sp=-1
  [ -n "$rq" ] || rq=-1
  av=$(jq -nc --argjson s "$sp" --argjson r "$rq" 'if ($r > 0 and $s >= 0) then $s/$r else 0 end' 2>/dev/null)
  [ -n "$av" ] || av=0
  jq -nc --arg service "$svc" --argjson balance "$bal" --argjson spent "$sp" --argjson requests "$rq" --argjson avg "$av" '{service:$service,balance:$balance,spent:$spent,requests:$requests,avg:$avg,at:now}'
  ;;
usage)
  case "$arg" in all|today|7d|30d) ;; *) arg=today ;; esac
  r=$(curl -fsS --max-time 12 "$api/usage/summary?tz=$tz&window=$arg" 2>/dev/null)
  if [ -z "$r" ]; then off 'no usage from routstrd' unknown; exit 0; fi
  printf '%s' "$r" | trim
  ;;
logs)
  journalctl --user -u routstrd -n "$arg" --no-pager 2>/dev/null | tail -n "$arg"
  ;;
topup)
  case "$arg" in ''|*[!0-9]*) off 'amount must be whole sats' unknown; exit 0;; esac
  r=$(curl -sS --max-time 20 -H 'Content-Type: application/json' -d "$(jq -nc --argjson a "$arg" '{amount:$a}')" "$api/wallet/receive/bolt11" 2>/dev/null)
  if [ -z "$r" ]; then off 'no invoice from routstrd' unknown; exit 0; fi
  printf '%s' "$r" | jq -c '{invoice:(.output.invoice // ""),operationId:(.output.operationId // ""),error:(.error // "")}'
  ;;
quote)
  case "$arg" in ''|*[!a-zA-Z0-9._=-]*) off 'bad operation id' unknown; exit 0;; esac
  r=$(curl -sS --max-time 8 "$api/wallet/receive/bolt11/$arg" 2>/dev/null)
  if [ -z "$r" ]; then off 'no quote from routstrd' unknown; exit 0; fi
  printf '%s' "$r" | jq -c '{state:(.output.state // ""),error:(.output.error // .error // "")}'
  ;;
start) systemctl --user start routstrd.service ;;
stop) systemctl --user stop routstrd.service ;;
restart) systemctl --user restart routstrd.service ;;
esac
"""

  // only digits reach the invoice command, and only an operation id the
  // daemon could have made reaches the quote command
  let safeAmount = match(amount, "^[1-9][0-9]*$") == null ? "" : amount
  let safeQuote = match(quoteId, "^[A-Za-z0-9._=-]+$") == null ? "" : quoteId

  // one program per command, filled in from the state above
  let scStatus = replace(replace(replace(agent, "__H__", link), "__V__", "status"), "__A__", "")
  let scUsage = replace(replace(replace(agent, "__H__", link), "__V__", "usage"), "__A__", win)
  let scLogs = replace(replace(replace(agent, "__H__", link), "__V__", "logs"), "__A__", "120")
  let scTopup = replace(replace(replace(agent, "__H__", link), "__V__", "topup"), "__A__", safeAmount)
  let scQuote = replace(replace(replace(agent, "__H__", link), "__V__", "quote"), "__A__", safeQuote)
  let scStart = replace(replace(replace(agent, "__H__", link), "__V__", "start"), "__A__", "")
  let scStop = replace(replace(replace(agent, "__H__", link), "__V__", "stop"), "__A__", "")
  let scRestart = replace(replace(replace(agent, "__H__", link), "__V__", "restart"), "__A__", "")

  // ---- sources ----------------------------------------------------------
  source st = cmd("if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(scStatus)} 2>/dev/null || bash -c ${sh(scStatus)}; else bash -c ${sh(scStatus)}; fi") every 20s json timeout 20s

  let loading = st == null
  let svc = loading ? "" : (st.service ?? "unknown")
  let bal = loading ? null : (st.balance ?? -1)
  let spent = loading ? null : (st.spent ?? -1)
  let reqs = loading ? null : (st.requests ?? -1)
  let avg = loading ? null : (st.avg ?? 0)

  // the status colours are fixed, not the theme's: hackerman names its red green,
  // so a theme red would paint Failed the same as Running. Green means the daemon
  // answers, red that it is down, amber that this phone can't reach it at all.
  let up = svc == "active" || svc == "activating" || svc == "reloading"
  let reach = svc == "unreachable" || svc == "unlinked" || svc == "unknown" || svc == ""
  let dotColor = loading || reach ? "#fbbf24" : up ? "#4ade80" : "#f87171"
  let stateText = loading ? "…" : svc == "active" ? str.running : (svc == "activating" || svc == "reloading") ? str.starting : svc == "deactivating" ? str.stopping : svc == "failed" ? str.failed : svc == "inactive" ? str.stopped : svc == "unreachable" ? str.offline : svc == "unlinked" ? str.unlinked : str.unknown

  // null is still loading, a negative number is the other side saying "no answer"
  let balFull = bal == null ? "…" : bal < 0 ? str.unavailable : fmtNum(bal)
  let spentText = spent == null ? "…" : spent < 0 ? str.unavailable : fmtNum(round(spent))
  let reqsText = reqs == null ? "…" : reqs < 0 ? str.unavailable : fmtNum(reqs)
  let avgText = avg == null ? "…" : avg < 0 ? str.unavailable : fmtNum(avg, 2)

  // the host card opens on a fresh install, or whenever a tap asks for it
  let showLink = editLink || (link == "" && (loading || svc == "unlinked"))

  // the monitor's summary and the journal: only while their views are open;
  // "echo '{}'" and "true" are empty answers that cost no work
  source u = cmd(view == "monitor" ? "if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(scUsage)} 2>/dev/null || bash -c ${sh(scUsage)}; else bash -c ${sh(scUsage)}; fi" : "echo '{}'") every 30s json timeout 25s
  source lg = cmd(view == "logs" ? "if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(scLogs)} 2>/dev/null || bash -c ${sh(scLogs)}; else bash -c ${sh(scLogs)}; fi" : "true") every 30s timeout 25s

  let loaded = u != null && u.w != null
  let uErr = u == null ? "" : (u.error ?? "")
  let mReqs = u == null ? 0 : (u.t.r ?? 0)
  let mSpent = u == null ? 0 : (u.t.s ?? 0)
  let mTok = u == null ? 0 : (u.t.tok ?? 0)
  let mAvg = mReqs > 0 ? mSpent / mReqs : 0
  let mAvgTok = mReqs > 0 ? mTok / mReqs : 0
  let mPC = (u == null ? 0 : (u.t.ct ?? 0)) > 0 ? (u.t.pt ?? 0) / (u.t.ct ?? 0) : 0
  let models = u == null ? [] : (u.m ?? [])
  let provs = u == null ? [] : (u.p ?? [])
  let clients = u == null ? [] : (u.c ?? [])
  let recent = u == null ? [] : (u.rec ?? [])
  let pts = u == null ? [] : (u.tl.p ?? [])
  let sparks = pts.map(p => p.s)
  let yMax = len(sparks) == 0 ? 0 : last(sort(sparks))
  // the axis labels follow the window the daemon actually answered for, so
  // a stale reply can never be labelled as the window just tapped
  let nPts = len(pts)
  // a whole-history reply comes in weeks, so months would repeat: name the
  // days unless the span really crosses into another month
  let sameMonth = nPts == 0 || fmtTime(pts[0].t / 1000, "M") == fmtTime(pts[nPts - 1].t / 1000, "M")
  let xpat = u == null ? "d/M" : u.w == "today" ? "HH" : u.w == "all" && !sameMonth ? "MMM" : "d/M"
  let x1 = nPts == 0 ? "" : fmtTime(pts[0].t / 1000, xpat)
  let x2 = nPts == 0 ? "" : fmtTime(pts[floor((nPts - 1) / 2)].t / 1000, xpat)
  let x3 = nPts == 0 ? "" : fmtTime(pts[nPts - 1].t / 1000, xpat)

  // the screen's three columns of buttons, so the amount box is exactly as
  // wide as Monitor and Restart side by side, and Top up as wide as Logs
  let colW = ((screenWidth ?? 400) - 40) / 3

  // ---- top-up ----------------------------------------------------------
  let inv = invRaw == "" ? null : parseJson(invRaw)
  let invoice = inv == null ? "" : (inv.invoice ?? "")
  let qr = qrPath
  let invErr = inv == null ? "" : (inv.error ?? "")
  let shortInvoice = len(invoice) > 96 ? sub(invoice, 0, 96) + "…" : invoice

  let qs = quoteRaw == "" ? null : parseJson(quoteRaw)
  let qState = qs == null ? "" : (qs.state ?? "")
  let qErr = qs == null ? "" : (qs.error ?? "")

  on invRaw first {
    let q = parseJson(value)
    quoteId = q == null ? "" : (q.operationId ?? "")
    quoteRaw = ""
  }

  // no invoice, no command: this block starts nothing while the wallet is idle
  every 5s {
    if quoteId != "" {
      quoteRaw = run("if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(scQuote)} 2>/dev/null || bash -c ${sh(scQuote)}; else bash -c ${sh(scQuote)}; fi")
    }
  }

  on quoteRaw {
    if quoteId != "" && value != "" {
      let q = parseJson(value)
      if q != null && (q.state ?? "") == "finalized" {
        paid = true
        quoteId = ""
        invRaw = ""
        quoteRaw = ""
        qrPath = ""
      }
    }
  }

  onTap: screen()

  component Line(cap, val) {
    Row {
      gap: 8
      Text { text: cap; style: body; color: foreground; weight: 1; maxLines: 1 }
      Text { text: val; style: body; maxLines: 1 }
    }
  }

  // ---- the tile: at 1x1, just the mark, coloured by whether routstrd answers ----
  Column {
    Image { src: logo; tint: dotColor; fit: contain; fill: true; label: stateText }
  }

  // ---- the screen's parts ----------------------------------------------

  // an on/off switch for routstrd: the track takes the state's colour and
  // the knob slides over; a tap starts it or stops it
  component Toggle(lit) {
    Box {
      width: 46
      height: 26
      radius: 13 * corners
      background: lit ? alpha(green, 0.3) : alpha(green, 0.12)
      border: 1
      borderColor: lit ? alpha(green, 0.6) : alpha(green, 0.28)
      padding: 3
      align: lit ? "end" : "start"
      Box {
        width: 18
        height: 18
        radius: 9 * corners
        background: lit ? green : alpha(green, 0.45)
      }
    }
  }

  // one figure of the window, a label over its value, on the soft green
  component Stat(name, val) {
    Column {
      gap: 4
      fill: width
      padding: [10, 6]
      background: alpha(accent, 0.1)
      radius: 12 * corners
      Text { text: name; style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }
      Text { text: val; style: body; maxLines: 1 }
    }
  }

  component Head(t) {
    Text { text: t; style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }
  }

  // one line of the monitor: a name with its cost at the far end, the rest
  // of its figures under it, and an optional second line of detail
  component MonRow(name, sub, val, extra = "") {
    Column {
      gap: 1
      Row {
        gap: 8
        Text { text: name; style: body; weight: 1; maxLines: 1 }
        Text { text: val; style: body; align: end; maxLines: 1 }
      }
      Text { text: sub; style: small; color: muted; maxLines: 1 }
      if extra != "" {
        Text { text: extra; style: small; color: muted; maxLines: 1 }
      }
    }
  }

  // the amount and Top up share a row in the fixed card: the field spans the
  // first two button slots, so the button sits directly under Logs. The invoice
  // appears under them while one is open.
  component TopUp() {
    Column {
      gap: 8

      Row {
        gap: 6
        align: center
        Box {
          width: 2 * colW + 6
          align: center
          border: 1
          borderColor: alpha(accent, 0.3)
          background: alpha(background, 0.35)
          radius: 8 * corners
          padding: [12, 0]
          // Input draws its text from its own left edge and has no alignment,
          // so it is as wide as what it holds and the row is centred in the
          // frame. One 13sp mono character advances 7.8 dp, and the empty field
          // holds the four-letter placeholder
          Row {
            align: center
            Input {
              width: max(len(amount), 4) * 7.8 + 2
              text: amount
              placeholder: str.sats
              underline: false
              onChange: amount = value
              onSubmit: { topupRaw = run("if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(scTopup)} 2>/dev/null || bash -c ${sh(scTopup)}; else bash -c ${sh(scTopup)}; fi"); invRaw = topupRaw; paid = false; qrPath = ""; let parsed = parseJson(topupRaw); let b = parsed == null ? "" : (parsed.invoice ?? ""); if b != "" { run("mkdir -p ~/.cache && printf %s ${sh(b)} | qrencode -o ~/.cache/routstr-qr.png -s 6 -m 2 -l M"); qrPath = "~/.cache/routstr-qr.png" } }
            }
            if amount != "" {
              Text { text: " " + str.sats; style: body; color: muted; maxLines: 1 }
            }
          }
        }
        Button {
          text: str.topup
          width: colW
          radius: 8 * corners
          border: 1
          borderColor: alpha(accent, 0.3)
          background: alpha(background, 0.35)
          onTap: { haptic(); topupRaw = run("if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(scTopup)} 2>/dev/null || bash -c ${sh(scTopup)}; else bash -c ${sh(scTopup)}; fi"); invRaw = topupRaw; paid = false; qrPath = ""; let parsed = parseJson(topupRaw); let b = parsed == null ? "" : (parsed.invoice ?? ""); if b != "" { run("mkdir -p ~/.cache && printf %s ${sh(b)} | qrencode -o ~/.cache/routstr-qr.png -s 6 -m 2 -l M"); qrPath = "~/.cache/routstr-qr.png" } }
        }
      }

      if invRaw != "" && invErr != "" {
        Text { text: invErr; style: small; color: red; maxLines: 2 }
      }

      if invRaw != "" && invErr == "" {
        if qr != "" {
          Column {
            gap: 4
            Box {
              align: center
              fill: width
              padding: 10
              background: "#ffffff"
              radius: 8 * corners
              Image { src: qr; width: 220; height: 220; fit: contain; label: str.topup }
            }
            Text { text: str.scan; style: small; color: muted; align: center; fill: width; maxLines: 1 }
          }
        }
        Row {
          gap: 8
          align: top
          Text { text: shortInvoice; style: small; font: mono; weight: 1; maxLines: 3 }
          Button {
            radius: 8 * corners
            border: 1
            borderColor: alpha(accent, 0.3)
            background: alpha(background, 0.35)
            text: str.copy
            onTap: { haptic(); copy(invoice) }
          }
        }
        if quoteId != "" {
          Text {
            text: qErr != "" ? qErr : (qState == "finalized" ? str.paid : str.awaiting)
            style: small
            color: qErr != "" ? red : qState == "finalized" ? accent : muted
          }
        }
        // cancel sits under copy, at the same end
        Row {
          fill: width
          justify: end
          Button {
            radius: 8 * corners
            border: 1
            borderColor: alpha(accent, 0.3)
            background: alpha(background, 0.35)
            text: str.cancel
            onTap: { haptic(); invRaw = ""; quoteId = ""; quoteRaw = ""; qrPath = ""; paid = false }
          }
        }
      }

      if paid {
        Text { text: str.paid; style: small; color: accent }
      }
    }
  }

  // ---- the screen ------------------------------------------------------
  screen {
    title: str.title

    // the window draws its own ✕ over this frame, so this only supplies the
    // outline and a tap target behind the glyph
    Row {
      fill: width
      height: 26
      align: center
      justify: end
      offset: [0, -38]
      Box {
        width: 26
        height: 26
        radius: 8 * corners
        border: 1
        borderColor: alpha(accent, 0.3)
        background: alpha(background, 0.35)
        onTap: close()
      }
    }


    // the state, figures and controls stay fixed above the scrolling detail
    Column {
      fill: width
      gap: 8
      offset: [0, -26]
      padding: [10, 10]
      background: alpha(accent, 0.1)
      radius: 12 * corners

      // the daemon's state with a switch for it, then this window's figures
      Row {
        fill: width
        gap: 10
        align: center
        Text { text: "●"; style: title; color: dotColor }
        Text { text: stateText; style: body; color: #ffffff; weight: 1; maxLines: 1 }
        Box { onTap: { haptic(); run("if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(up ? scStop : scStart)} || bash -c ${sh(up ? scStop : scStart)}; else bash -c ${sh(up ? scStop : scStart)}; fi"); refresh() }; Toggle { lit: up } }
        Button { text: str.host; onTap: { haptic(); linkDraft = link; editLink = !editLink } }
      }

      if showLink {
        Column {
          gap: 6
          padding: [12, 10]
          background: alpha(accent, 0.1)
          border: 1
          borderColor: alpha(accent, 0.3)
          radius: 8 * corners
          Head { t: upper(str.host) }
          Text { text: str.hostHint; style: small; color: muted; maxLines: 2 }
          Row {
            gap: 6
            Box {
              weight: 2
              align: center
              padding: [10, 8]
              border: 1
              borderColor: alpha(accent, 0.3)
              background: alpha(background, 0.35)
              radius: 8 * corners
              Input {
                text: linkDraft
                placeholder: "user@host"
                underline: false
                onChange: linkDraft = value
                onSubmit: {
                  let h = trim(linkDraft)
                  if h == "" || match(h, "^[A-Za-z0-9._@-]+$") != null { link = h; editLink = false; refresh(); haptic() }
                }
              }
            }
            Button {
              radius: 8 * corners
              border: 1
              borderColor: alpha(accent, 0.3)
              background: alpha(background, 0.35)
              text: str.save
              onTap: {
                let h = trim(linkDraft)
                if h == "" || match(h, "^[A-Za-z0-9._@-]+$") != null { link = h; editLink = false; refresh(); haptic() }
              }
            }
          }
        }
      }

      if !loading && (st.error ?? "") != "" {
        Text { text: st.error; style: small; color: red; maxLines: 2 }
      }

      Grid {
        columns: 2
        gap: 8
        Stat { name: upper(str.balance); val: balFull + " " + str.sat }
        Stat { name: upper(str.spend); val: spentText + " " + str.sat }
        Stat { name: upper(str.requests); val: reqsText }
        Stat { name: upper(str.avg); val: avgText + " " + str.sat }
      }

      Row {
        gap: 6
        Button {
          text: str.monitor
          weight: 1
          radius: 8 * corners
          border: 1
          borderColor: alpha(accent, 0.3)
          background: view == "monitor" ? alpha(accent, 0.15) : alpha(background, 0.35)
          onTap: { haptic(); view = view == "monitor" ? "" : "monitor" }
        }
        Button {
          radius: 8 * corners
          border: 1
          borderColor: alpha(accent, 0.3)
          background: alpha(background, 0.35)
          text: str.restart
          weight: 1
          onTap: { haptic(); run("if [ -n ${sh(link)} ]; then ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR ${sh(link)} ${sh(scRestart)} || bash -c ${sh(scRestart)}; else bash -c ${sh(scRestart)}; fi"); refresh() }
        }
        Button {
          text: str.logs
          weight: 1
          radius: 8 * corners
          border: 1
          borderColor: alpha(accent, 0.3)
          background: view == "logs" ? alpha(accent, 0.15) : alpha(background, 0.35)
          onTap: { haptic(); view = view == "logs" ? "" : "logs" }
        }
      }

      TopUp { }
    }

    // the window's [W] buttons in their own card, fixed below the edit box
    // and Top up so any window can be picked without scrolling back up
    if view == "monitor" {
      Column {
        gap: 8
        fill: width
        offset: [0, -21]
        padding: [10, 10]
        background: alpha(accent, 0.1)
        radius: 12 * corners
        Row {
          gap: 6
          fill: width
          Button { text: str.all; weight: 1; radius: 8 * corners; border: 1; borderColor: alpha(accent, 0.3); background: win == "all" ? alpha(accent, 0.15) : alpha(background, 0.35); onTap: { haptic(); win = "all" } }
          Button { text: str.h24; weight: 1; radius: 8 * corners; border: 1; borderColor: alpha(accent, 0.3); background: win == "today" ? alpha(accent, 0.15) : alpha(background, 0.35); onTap: { haptic(); win = "today" } }
          Button { text: str.d7; weight: 1; radius: 8 * corners; border: 1; borderColor: alpha(accent, 0.3); background: win == "7d" ? alpha(accent, 0.15) : alpha(background, 0.35); onTap: { haptic(); win = "7d" } }
          Button { text: str.d30; weight: 1; radius: 8 * corners; border: 1; borderColor: alpha(accent, 0.3); background: win == "30d" ? alpha(accent, 0.15) : alpha(background, 0.35); onTap: { haptic(); win = "30d" } }
        }
      }
    }

    Column {
      scroll: true
      fill: true
      gap: 10
      offset: [0, -16]
      padding: [0, 0, 0, 0]

      if view == "monitor" {
        Column {
          gap: 10

          if uErr != "" {
            Text { text: uErr; style: small; color: red; maxLines: 2 }
          } else if !loaded {
            Text { text: "…"; style: small; color: muted }
          } else {
            Column {
              gap: 12

              Column {
                gap: 8
                fill: width
                padding: [10, 10]
                background: alpha(accent, 0.1)
                radius: 12 * corners
                Head { t: upper(str.overview) }
                Line { cap: str.balance; val: balFull + " " + str.sat }
                Line { cap: str.spent; val: fmtNum(round(mSpent)) + " " + str.sat }
                Line { cap: str.requests; val: fmtNum(mReqs) }
                Line { cap: str.tokens; val: fmtNum(mTok, {compact: true}) }
                Line { cap: str.avg; val: fmtNum(mAvg, 2) + " " + str.sat }
                Line { cap: str.avgTokens; val: fmtNum(round(mAvgTok)) }
                Line { cap: str.promptComp; val: "${fmtNum(mPC, 2)} : 1" }
              }

              Column {
                gap: 8
                fill: width
                padding: [10, 10]
                background: alpha(accent, 0.1)
                radius: 12 * corners
                Head { t: upper(str.history) }
                Text { text: fmtNum(round(mSpent)) + " " + str.sats + " · " + fmtNum(mReqs) + " " + str.requestsLower; style: small; color: muted }
                if len(sparks) == 0 {
                  Text { text: str.noData; style: small; color: muted }
                } else {
                  Column {
                    gap: 2
                    // the plot runs the card's full width and the scale sits
                    // inside it, at the card's own left edge, where the title
                    // starts; the figures get their room above and below
                    Canvas {
                      height: 110
                      fill: width
                      let n = len(sparks)
                      let top = 15
                      let base = height - 11
                      let plotH = base - top
                      let xy = range(n).map(i => [n <= 1 ? 0 : i * width / (n - 1), base - (yMax > 0 ? sparks[i] / yMax * plotH : 0)])
                      line(0, base, width, base, stroke: alpha(muted, 0.25), width: 1)
                      if n > 1 {
                        path([[0, base]] + xy + [[width, base]], closed: true, fill: alpha(accent, 0.16))
                        path(xy, stroke: accent, width: 1.6, cap: round)
                      }
                      text(fmtNum(round(yMax)), 0, top - 7, size: 9, align: start, color: muted)
                      text(fmtNum(round(yMax / 2)), 0, top + plotH / 2, size: 9, align: start, color: muted)
                      text("0", 0, base + 6, size: 9, align: start, color: muted)
                    }
                    Row {
                      fill: width
                      justify: spaceBetween
                      Text { text: x1; style: label; color: muted; maxLines: 1 }
                      Text { text: x2; style: label; color: muted; maxLines: 1 }
                      Text { text: x3; style: label; color: muted; maxLines: 1 }
                    }
                  }
                }
              }

              Column {
                gap: 8
                fill: width
                padding: [10, 10]
                background: alpha(accent, 0.1)
                radius: 12 * corners
                Head { t: upper(str.models) }
                if len(models) == 0 {
                  Text { text: str.noData; style: small; color: muted }
                } else {
                  for m, i in models.take(5) key i {
                    MonRow {
                      name: m.i
                      sub: fmtNum(m.r) + " " + str.reqs + " · " + fmtNum(m.t, {compact: true}) + " " + str.tok + " · " + fmtNum(m.s / max(m.r, 1), 2) + " " + str.satPerReq
                      val: fmtNum(round(m.s)) + " " + str.sat
                    }
                  }
                }
              }

              Column {
                gap: 8
                fill: width
                padding: [10, 10]
                background: alpha(accent, 0.1)
                radius: 12 * corners
                Head { t: upper(str.providers) }
                if len(provs) == 0 {
                  Text { text: str.noData; style: small; color: muted }
                } else {
                  for p, i in provs.take(5) key i {
                    MonRow {
                      name: p.u
                      sub: fmtNum(p.r) + " " + str.reqs + " · " + fmtNum(p.t, {compact: true}) + " " + str.tok + " · " + fmtNum(p.s / max(p.r, 1), 2) + " " + str.satPerReq
                      val: fmtNum(round(p.s)) + " " + str.sat
                    }
                  }
                }
              }

              Column {
                gap: 8
                fill: width
                padding: [10, 10]
                background: alpha(accent, 0.1)
                radius: 12 * corners
                Head { t: upper(str.clients) }
                if len(clients) == 0 {
                  Text { text: str.noData; style: small; color: muted }
                } else {
                  for c, i in clients.take(5) key i {
                    MonRow {
                      name: c.c
                      sub: fmtNum(c.r) + " " + str.reqs + " · " + fmtNum(c.t, {compact: true}) + " " + str.tok + " · " + fmtNum(c.s / max(c.r, 1), 2) + " " + str.satPerReq
                      val: fmtNum(round(c.s)) + " " + str.sat
                      extra: join((c.m ?? []).take(3).map(x => x.i), " · ")
                    }
                  }
                }
              }

              Column {
                gap: 8
                fill: width
                padding: [10, 10]
                background: alpha(accent, 0.1)
                radius: 12 * corners
                Head { t: upper(str.recent) }
                if len(recent) == 0 {
                  Text { text: str.noData; style: small; color: muted }
                } else {
                  for r, i in recent.take(5) key i {
                    Row {
                      gap: 8
                      align: top
                      Column {
                        gap: 1
                        weight: 1
                        Text { text: r.m; style: body; maxLines: 1 }
                        Text { text: fmtTime(r.t / 1000, "HH:mm") + " · " + r.c + " · " + fmtNum(r.tok, {compact: true}) + " " + str.tok; style: small; color: muted; maxLines: 1 }
                      }
                      Text { text: fmtNum(r.s, 2) + " " + str.sats; style: body; align: end; maxLines: 1 }
                    }
                  }
                }
              }
            }
          }
        }
      } else if view == "logs" {
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners
          Head { t: upper(str.logs) }
          if lg == "" {
            Text { text: "…"; style: small; color: muted }
          } else {
            Column {
              gap: 2
              for l, i in lines(lg) key i {
                Text { text: l; style: small; font: mono; maxLines: 4 }
              }
            }
          }
        }
      }

      // who made it, at the foot of this screen and out of the way
      Text {
        text: str.builtBy
        style: small
        color: #ffffff
        align: center
        maxLines: 1
        onTap: url("https://jaquesbody.github.io/")
      }
    }

  }
}
