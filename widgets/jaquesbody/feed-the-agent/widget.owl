// Feed the Agent — one thought, one line, one note.
//
// The tile captures; the agent sorts. The agent is a small HTTP contract
// (GET /status, POST /drain), on another device or on this phone, called
// from Android with post() and http(). No model runs in the widget itself.
//
// Two questions:
//   where is the agent  — on this phone, on your desktop, on a server of
//                         your own, or at a cloud address
//   file to write to    — this phone's Documents/feed.md, or a note in a
//                         folder you granted to Omalauncher (your vault)
widget "feed the agent" {
  page: 1
  order: 1
  size: 6x1
  minSize: 4x1
  padding: 0
  background: background
  // The invitation's teeth chomp on it, so the tile (and its screen) asks
  // for a frame about that often and no more.
  fps: 12

  meta {
    owl: 19
    description: "Type or say a thought on the tile and it lands in a note on this phone or in your Obsidian vault. Optionally ask a computer on your network to sort it. No model runs on the phone."
    version: "2.6"
    license: "MIT"
    category: "productivity"
  }

  // The picker and the phone-path lookup are tiny Python programs: python3
  // with no extra module, and the tile says so if it's missing.
  requires { pacman: ["python", "gawk", "coreutils"] }

  // every line a person reads lives here; str.x is the phone's language's
  strings {
    en {
      title: "feed the agent"
      builtBy: "built by jaquesbody"
      desktop: "desktop"
      phone: "phone"
      server: "server"
      cloud: "cloud"
      noteDesktop: "enter the LAN or Tailscale address your agent answers at"
      notePhone: "this phone's address is fixed, and it calls ~/.config/feed-agent/sorter when you sort"
      noteServer: "your own server's address, on the LAN or Tailscale"
      noteCloud: "an https address your phone can reach from anywhere, such as a cloud provider"
      agentPlaceholderCloud: "https://agents.example.com"
      agentPlaceholderLocal: "http://192.168.1.10:8787"
      intro1: "simply feed me a note, an idea, a todo item,"
      intro2: "a bug fix, anything and I'll organize,"
      intro3: "prioritize and remind you of it"
      close: "×"
      important: "IMPORTANT: you must set up your agent to recognize, read and write to your folder and named files, they must be correctly synced for Feed the Agent to work"
      whereAgent: "where is your agent?"
      selectInbox: "select \"inbox\" file to write to"
      selectFolder: "select folder with your agent files"
      sortHelp: "Click 'sort' for your agent to actively clear your inbox and run the rules you've set it. It sorts when you tap, or whenever your agent next checks in"
      bumpTitle: "bump notes up your list"
      bumpHelp: "Click 'now' to bump this note to a priority"
      bumpNote: "Your agent writes this to your \"inbox\" and reads it to prioritize the note"
      tagPlaceholder: "e.g. go, now:, or >>>"
      formatTitle: "format what the widget writes to file"
      formatHelp: "Paste the exact line in your \"inbox\" file that precedes where you want each note to land. Press Enter in the field to add a blank line under it"
      sectionPlaceholder: "e.g. Captures or To Do List"
      prefixQuestion: "What should prefix each note?"
      prefixPlaceholder: "e.g. {date} or {date:time}"
      posQuestion: "Do you want new notes to land at the top or bottom of your inbox list?"
      top: "top"
      bottom: "bottom"
      preview: "preview"
      noAnchor: "(no anchor: the note joins the list)"
      newTop: "new notes land at the top, just under that line"
      newBottom: "new notes land at the bottom of that list"
      sampleNote: "your most recent note goes here"
      priorityNote: "this is a priority note"
      notifications: "notifications"
      notifyFailLabel: "A note could not be written to your file"
      notifySortedLabel: "Your agent sorted your inbox"
      notifyFailText: "not saved — the thought is back in the field"
      inbox: "Inbox"
      now: "Now"
      feedIt: "feed it"
      offline: "offline"
      notReachable: "not reachable"
      notSaved: "not saved"
      notSavedTap: "not saved — tap"
      setUp: "set up"
      setUpWhere: "set up where it lands"
      sorting: "Sorting…"
      listening: "listening"
      listeningMore: "listening…"
      sorted: "sorted"
      nothingNew: "nothing new"
      couldNotFind: "couldn't find"
      inReachableFolder: "in a folder the launcher can reach"
    }
  }

  // ---- the file --------------------------------------------------------
  // An empty folder is this phone's Documents: no permission, no setup.
  state folder = "" persist
  state noteRel = "_inbox.md" persist
  state agentFolder = "" persist          // the folder the agent keeps its files in: "" is the note's own
  state section = "**Captures**" persist  // the line the note lands under; a \n adds a blank line
  state prefix = "{date}: " persist       // in front of every note; {date} and {date:time}
  state pos = "top" persist               // "top" | "bottom" of the list
  state tag = "" persist

  // ---- the agent -------------------------------------------------------
  // Each answer is a URL: a desktop or a server of your own on the LAN or
  // Tailscale, a cloud relay over https, or this phone, which is a small
  // server that answers the same two routes. No token, because a secret may
  // only go to a fixed https host, and these are your own; put the LAN ones
  // on Tailscale or the LAN, never the open internet.
  state base = "" persist                     // your desktop's address
  // Where the agent is. "" keeps the older on/off answer (localAgent) for a
  // widget that had one, so nobody's working setup changes under them.
  state agentMode = "" persist                // "" | "desktop" | "phone" | "server" | "cloud"
  state serverBase = "" persist               // your own server, on the LAN or Tailscale
  state cloudBase = "" persist                // an https address reachable anywhere
  state localAgent = false persist            // the old answer, read only as agentMode's default
  state working = false
  state pressAt = 0
  state pressDeadline = 0
  state beforeLast = ""
  state pressed = 0
  state deferredAt = 0
  state lastLine = ""

  // ---- capturing ------------------------------------------------------
  state draft = ""
  state active = false
  state last = 0
  state blur = 2
  state pendingText = ""
  state pendingLine = ""
  state result = ""
  state saveError = ""
  state saveErrorAt = 0
  state bite = 0
  state biteUntil = 0
  state goSeq = 0
  state goText = ""
  state sortedAt = 0
  state sortedText = ""
  state orgTapAt = 0
  state goTapAt = 0
  state micTapAt = 0

  // ---- what the phone is told -----------------------------------------
  // The two things the widget can announce, each switchable on its own.
  state notifyFail = true persist          // a note could not be written
  state notifySorted = true persist        // the agent finished sorting

  // ---- the save buttons and the phone's file picker -------------------
  state saveOut = ""
  state savedAt = 0
  state checkSeq = 0                          // bumped by a pick, to check the file once
  state folderCheckSeq = 0                    // the same for the agent's folder
  state folderSaveOut = ""
  state folderSavedAt = 0
  state pickFileOut = ""
  state pickFolderOut = ""
  state pickNote = ""
  state pickFolderNote = ""

  // ---- derived --------------------------------------------------------
  let localBase = "http://127.0.0.1:8787"
  let mode = agentMode == "" ? (localAgent ? "phone" : "desktop") : agentMode
  let agentBase =
    mode == "phone" ? localBase :
    mode == "server" ? serverBase :
    mode == "cloud" ? cloudBase :
    base
  // The four answers, each a key and the word on its tile.
  let modes = [
    {key: "desktop", label: str.desktop},
    {key: "phone", label: str.phone},
    {key: "server", label: str.server},
    {key: "cloud", label: str.cloud}
  ]
  let agentText = mode == "desktop" ? base : (mode == "server" ? serverBase : cloudBase)
  let agentNote =
    mode == "phone" ? str.notePhone :
    mode == "server" ? str.noteServer :
    mode == "cloud" ? str.noteCloud :
    str.noteDesktop
  let where = folder == "" ? "quick" : "note"
  let dateShort = fmtTime(now, "dd-MM-yyyy")
  let dateTime = fmtTime(now, "dd-MM-yyyy HH:mm")
  let prefixText = replace(replace(prefix, "{date:time}", dateTime), "{date}", dateShort)
  // The anchor is one line; a \n in it is one blank line under it, before the note.
  let anchorKey = first(split(section, "\\n")) ?? ""
  let anchorGaps = len(split(section, "\\n")) - 1
  let secLine = trim(anchorKey)
  let relToday = replace(noteRel, "{date}", dateShort)
  let destPath =
    where == "quick" ? "/sdcard/Documents/feed.md" :
    (relToday == "" ? "" : folder + "/" + relToday)
  // The note may sit in a subfolder of the granted one, so the folder shown is
  // the whole way there, and only the file's own name is the name.
  let noteParts = split(relToday, "/")
  let destName = where == "quick" ? "feed.md" : (last(noteParts) ?? relToday)
  let noteDir = join(take(noteParts, max(len(noteParts) - 1, 0)), "/")
  let destDir =
    where == "quick" ? "Documents" :
    (noteDir == "" ? folder : folder + "/" + noteDir)
  let ready = destPath != ""
  let agentFolderShown = agentFolder == "" ? (where == "quick" ? destDir : folder) : agentFolder
  let agentParts = split(agentFolderShown, "/")
  let agentGrant = first(agentParts) ?? ""
  let agentRest = join(drop(agentParts, 1), "/")
  // Where a granted folder is on the phone itself: /sdcard is the same
  // storage, so its name finds it there, and the path shown is the one
  // Android's own Files shows. Name only when it isn't there (a card, a cloud).
  let pathRows = lines(phonePathsText ?? "")
  let notePhoneRow = first(pathRows.filter(l => startsWith(l, folder + "|"))) ?? ""
  let notePhone = notePhoneRow == "" ? "" : sub(notePhoneRow, len(folder) + 1, len(notePhoneRow) - 1)
  let agentPhoneRow = first(pathRows.filter(l => startsWith(l, agentGrant + "|"))) ?? ""
  let agentPhone = agentPhoneRow == "" ? "" : sub(agentPhoneRow, len(agentGrant) + 1, len(agentPhoneRow) - 1)
  let phoneNames = unique([folder, agentGrant]).filter(n => n != "")
  // The whole way there, on the phone: "Obsidian/vault/_agent".
  let dirSpace =
    where == "quick" ? destDir :
    notePhone == "" ? destDir :
    (noteDir == "" ? notePhone : notePhone + "/" + noteDir)
  let agentSpace =
    agentPhone == "" ? agentFolderShown :
    (agentRest == "" ? agentPhone : agentPhone + "/" + agentRest)
  // A path is cut from its own left when it would not leave room for the
  // file name: the deepest part, beside the name, is kept, so the directory
  // chosen is always the part that shows. The room is the card's own row: the
  // screen, less its insets and the card's padding, the icon and its gaps.
  // Mono 14 is about 7.4dp a character, 13 about 6.95, and a path that only
  // fits smaller is shown smaller, whole, before any of it is cut.
  let rowWidth = (screenWidth ?? 360) - 95
  let rowChars = floor(rowWidth / 7.4)
  let rowCharsSmall = floor(rowWidth / 6.95)
  let pathLen = len(dirSpace) + 1 + len(destName)
  let pathSmall = pathLen > rowChars
  let pathSize = pathSmall ? 13 : 14
  let dirChars = max(8, (pathSmall ? rowCharsSmall : rowChars) - len(destName))
  let dirFull = dirSpace + "/"
  // When the whole path fits, it is the path. When it doesn't, the deepest
  // components are kept, with "…/" for what was left out, so the folder
  // chosen is the part that stays.
  let dirBudget = max(6, dirChars - 2)
  let dirTail = reduce(
    reverse(split(dirSpace, "/")),
    (st, p) =>
      !st.ok ? st :
      (st.s == "" || len(st.s) + len(p) + 1 <= dirBudget
        ? {s: p + "/" + st.s, ok: true}
        : {s: st.s, ok: false}),
    {s: "", ok: true}
  ).s
  let dirLabel = len(dirFull) <= dirChars ? dirFull : "…/" + dirTail
  let dirLabelCut = len(dirLabel) <= dirChars
    ? dirLabel
    : "…" + sub(dirLabel, len(dirLabel) - dirChars + 1, len(dirLabel))
  // The folder alone: the same rule, keeping its own end (the chosen folder).
  let agentLen = len(agentSpace) + 1
  let agentSmall = agentLen > rowChars
  let agentSize = agentSmall ? 13 : 14
  let agentChars = max(10, agentSmall ? rowCharsSmall : rowChars)
  let agentFull = agentSpace + "/"
  let agentBudget = max(6, agentChars - 2)
  let agentTail = reduce(
    reverse(split(agentSpace, "/")),
    (st, p) =>
      !st.ok ? st :
      (st.s == "" || len(st.s) + len(p) + 1 <= agentBudget
        ? {s: p + "/" + st.s, ok: true}
        : {s: st.s, ok: false}),
    {s: "", ok: true}
  ).s
  let agentLabel = len(agentFull) <= agentChars ? agentFull : "…/" + agentTail
  let agentLabelCut = len(agentLabel) <= agentChars
    ? agentLabel
    : "…" + sub(agentLabel, len(agentLabel) - agentChars + 1, len(agentLabel))
  let sampleNote = prefixText + str.sampleNote
  let sampleNow = prefixText + (tag == "" ? str.now + ":" : tag) + " " + str.priorityNote

  // ---- reading the note ----------------------------------------------
  // Both counts come from the real file every poll: captures under the chosen
  // heading, and how many of them carry the quick tag.
  let countBody =
    """
    # A directory of this run alone, so a preview and the tile never collide.
    d="$HOME/.cache/feed-count.$$"
    mkdir -p "$d" || exit 0
    trap 'rm -rf "$d"' EXIT
    if [ "$where" = "quick" ]; then
      f="$dest"
    else
      [ -n "$dest" ] || exit 0
      omalauncher get "$dest" "$d" >/dev/null 2>&1 || { echo "? 0"; exit 0; }
      f="$d/$(basename "$rel")"
    fi
    [ -f "$f" ] || exit 0
    section="$section" tag="$tag" awk '
      function head(l) { return l ~ /^#+[ \t]/ || l ~ /^\*\*[^*]+\*\*$/ }
      function name(l) { sub(/^#+[ \t]+/, "", l); gsub(/\*\*/, "", l); gsub(/^[ \t]+|[ \t]+$/, "", l); return tolower(l) }
      function blank(l) { return l ~ /^[ \t]*$/ }
      BEGIN { sec=name(ENVIRON["section"]); tag=ENVIRON["tag"]; inf=(sec=="") }
      {
        if (sec != "") {
          if (head($0)) inf = (name($0) == sec)
          else if (inf && !blank($0)) {
            total++
            if (tag != "" && index(" " $0, " " tag) > 0) nowc++
          }
        } else if (!head($0) && !blank($0)) {
          total++
          if (tag != "" && index(" " $0, " " tag) > 0) nowc++
        }
      }
      END { print total+0, nowc+0 }
    ' "$f"
    """

  // One capture, as one line under the line you pasted: at the top of that
  // list, or at its end, as you chose. No anchor adds to the end; an anchor
  // that is not in the note yet is added at the end, so a first capture works.
  let writeBody =
    """
    d="$HOME/.cache/feed-edit.$$"
    mkdir -p "$d" || { echo "no cache"; exit 0; }
    trap 'rm -rf "$d"' EXIT
    if [ "$where" = "quick" ]; then
      mkdir -p "$(dirname "$dest")" 2>/dev/null || true
      if [ -f "$dest" ]; then cp "$dest" "$d/doc.md" || { echo "read failed"; exit 0; }
      else : > "$d/doc.md"; fi
      f="$d/doc.md"
    else
      [ -n "$dest" ] || { echo "no note picked"; exit 0; }
      omalauncher get "$dest" "$d" >/dev/null 2>"$d/err" || {
        echo "read: $(head -c 120 "$d/err")"; exit 0; }
      f="$d/$(basename "$dest")"
    fi
    note="$note" section="$section" awk -v pos="$pos" -v gaps="$gaps" '
      function trim(l) { gsub(/^[ \t]+|[ \t]+$/, "", l); return l }
      function blank(l) { return l ~ /^[ \t]*$/ }
      function head(l) { return l ~ /^#+[ \t]/ || l ~ /^\*\*[^*]+\*\*$/ }
      # As the count reads a heading: markdown and case do not decide which line
      # the notes land under, so "captures", "## Captures" and "**Captures**"
      # are the same anchor.
      function name(l) { sub(/^#+[ \t]+/, "", l); gsub(/\*\*/, "", l); gsub(/^[ \t]+|[ \t]+$/, "", l); return tolower(l) }
      { a[NR] = $0 }
      END {
        # From the environment, not -v: awk would read a \t or \n typed in a
        # thought as an escape and change the line.
        note = ENVIRON["note"]
        section = ENVIRON["section"]
        s = trim(section)
        if (s == "") {
          if (pos == "top") {
            t = 0
            while (t < NR && blank(a[t + 1])) t++
            if (t < NR && head(a[t + 1])) {
              t++
              while (t < NR && blank(a[t + 1])) t++
            }
            for (i = 1; i <= t; i++) print a[i]
            print note
            for (i = t + 1; i <= NR; i++) print a[i]
            exit
          }
          e = NR
          while (e > 0 && blank(a[e])) e--
          for (i = 1; i <= e; i++) print a[i]
          for (j = 1; j <= gaps; j++) print ""
          print note
          for (i = e + 1; i <= NR; i++) print a[i]
          exit
        }
        h = 0
        want = name(s)
        for (i = 1; i <= NR; i++) if (head(a[i]) && name(a[i]) == want) { h = i; break }
        if (h == 0) {
          for (i = 1; i <= NR; i++) print a[i]
          if (NR > 0 && !blank(a[NR])) print ""
          print section
          for (j = 1; j <= gaps; j++) print ""
          print note
          exit
        }
        if (pos == "top") {
          for (i = 1; i <= NR; i++) {
            print a[i]
            if (i == h) {
              for (j = 1; j <= gaps; j++) print ""
              print note
            }
          }
          exit
        }
        e = h
        for (i = h + 1; i <= NR; i++) {
          if (head(a[i])) break
          if (!blank(a[i])) e = i
        }
        for (i = 1; i <= NR; i++) {
          print a[i]
          if (i == e) print note
        }
      }
    ' "$f" > "$d/new" || { echo "edit failed"; exit 0; }
    cat "$d/new" > "$f" || { echo "write failed"; exit 0; }
    if [ "$where" = "quick" ]; then
      cat "$f" > "$dest" || { echo "write failed"; exit 0; }
    else
      omalauncher put "$f" "$(dirname "$dest")" >/dev/null 2>"$d/err" || {
        echo "write: $(head -c 120 "$d/err")"; exit 0; }
    fi
    echo "ok"
    """

  // The save button does one useful thing: it proves the file can be written
  // before you trust it with a thought, and names what is wrong if it cannot.
  let saveBody =
    """
    d="$HOME/.cache/feed-save.$$"
    mkdir -p "$d" || { echo "no cache"; exit 0; }
    trap 'rm -rf "$d"' EXIT
    if [ "$where" = "quick" ]; then
      [ -n "$dest" ] || { echo "no file"; exit 0; }
      mkdir -p "$(dirname "$dest")" 2>/dev/null || true
      if [ -f "$dest" ]; then echo "ok"
      elif : > "$dest" 2>/dev/null; then echo "ok"
      else echo "cannot write $dest"; fi
    else
      [ -n "$dest" ] || { echo "no note picked"; exit 0; }
      if omalauncher get "$dest" "$d" >/dev/null 2>"$d/err"; then
        # A folder grant is read and write; writing the note back unchanged
        # proves the second half too, before a thought is trusted to it.
        if omalauncher put "$d/$(basename "$dest")" "$(dirname "$dest")" >/dev/null 2>"$d/err"; then echo "ok"
        else echo "write: $(head -c 120 "$d/err")"; fi
      elif omalauncher ls "$(dirname "$dest")" >/dev/null 2>"$d/err"; then echo "ok"
      else echo "read: $(head -c 120 "$d/err")"; fi
    fi
    """

  // ---- the picker ------------------------------------------------------
  // The folder icon: Android's own file picker, then a search of the folders
  // this launcher may reach for the file it copied back, at any depth, so a
  // note in a subfolder of the vault is found too (and a copy Android renamed
  // to "name (2).md" still matches). Prints "folder|relative/path", "?|name"
  // when no granted folder holds it, or "!|why" when the picker itself failed.
  let pickBody =
    """
    d="$HOME/.cache/feed-pick.$$"
    mkdir -p "$d" || exit 0
    trap 'rm -rf "$d"' EXIT
    raw=$(omalauncher pick "$HOME/Downloads" 2>"$d/err")
    if [ -z "$raw" ]; then
      e=$(head -n 1 "$d/err" 2>/dev/null | cut -c1-200)
      case "$e" in
        ""|*"nothing picked"*) exit 0 ;;
      esac
      printf '!|%s\n' "$e"
      exit 0
    fi
    python3 -c '
import atexit, json, os, re, shutil, subprocess, sys, tempfile
raw = sys.argv[1]
try:
    v = json.loads(raw)
except Exception:
    v = [ln for ln in raw.splitlines() if ln.strip()]
p = v[0] if isinstance(v, list) and v else (v if isinstance(v, str) else "")
if not isinstance(p, str) or not p or not os.path.isfile(p):
    sys.exit(0)
name = os.path.basename(p)
try:
    size = os.path.getsize(p)
except OSError:
    sys.exit(0)
# The picker only copies the file here to hand it over; the file itself stays
# where it is, so the copy goes when this is done, whatever the answer.
def drop_copy():
    try:
        os.remove(p)
    except OSError:
        pass
atexit.register(drop_copy)
stem, ext = os.path.splitext(name)
base = re.sub(r" \(\d+\)$", "", stem) + ext
def run(*a):
    try:
        return subprocess.run(("omalauncher",) + a, capture_output=True, text=True, timeout=25).stdout
    except Exception:
        return ""
def entries(path):
    try:
        return json.loads(run("ls", path) or "[]")
    except Exception:
        return []
try:
    folders = [x.get("name") for x in json.loads(run("folders")) if x.get("name")]
except Exception:
    folders = []
# The picker copies the file into ~/Downloads first, byte for byte, so the
# copy itself says which phone file it came from, whatever Android named it.
def alike(f, rel):
    d = tempfile.mkdtemp(prefix="feed-pick.")
    try:
        run("get", f + "/" + rel, d)
        g = os.path.join(d, os.path.basename(rel))
        if not os.path.isfile(g) or os.path.getsize(g) != size:
            return False
        with open(g, "rb") as a, open(p, "rb") as b:
            while True:
                x = a.read(65536)
                y = b.read(65536)
                if x != y:
                    return False
                if not x:
                    return True
    except Exception:
        return False
    finally:
        shutil.rmtree(d, ignore_errors=True)
def say(f, rel):
    print(f + "|" + rel)
    sys.exit(0)
found = []
budget = 300
for f in folders:
    if budget <= 0:
        break
    q = [(f, "", 0)]
    while q and budget > 0:
        path, rel, depth = q.pop(0)
        budget -= 1
        for e in entries(path):
            nm = e.get("name") or ""
            sub = (rel + "/" if rel else "") + nm
            if e.get("dir"):
                if not nm.startswith(".") and depth < 6:
                    q.append((path + "/" + nm, sub, depth + 1))
                continue
            nmatch = nm in (name, base)
            smatch = size >= 0 and e.get("size") == size
            # A name and a size that both match are checked as they come, so
            # the usual pick answers in a moment, not after the whole walk.
            if nmatch and smatch and (size > 2000000 or alike(f, sub)):
                say(f, sub)
            if nmatch or smatch:
                found.append((1 if nmatch else 2, sub.count("/"), f, sub))
found.sort()
for c in found[:8]:
    if alike(c[2], c[3]):
        say(c[2], c[3])
print("?|" + name)
' "$raw"
    """

  // Where each granted folder is on the phone: /sdcard is the same storage, so
  // the folder's name finds it there and the path shown is the one Android's
  // Files shows ("Obsidian/jaquesbody-vault/"). Nothing when it's elsewhere.
  let phoneBody =
    """
    python3 -c '
import json, os, subprocess, sys
names = [x for x in sys.argv[1].split("\n") if x]
if not names:
    sys.exit(0)
try:
    tops = [os.path.join("/sdcard", d) for d in os.listdir("/sdcard")]
except Exception:
    tops = []
for name in names:
    cands = []
    p = "/sdcard/" + name
    if os.path.isdir(p):
        cands = [p]
    if not cands:
        cands = [q for q in (os.path.join(t, name) for t in tops) if os.path.isdir(q)]
    if not cands:
        for t in tops:
            try:
                subs = os.listdir(t)
            except Exception:
                continue
            c = [q for q in (os.path.join(t, s, name) for s in subs) if os.path.isdir(q)]
            if c:
                cands = c
                break
    if not cands:
        continue
    try:
        listed = {x["name"] for x in json.loads(subprocess.run(
            ["omalauncher", "ls", name], capture_output=True, text=True, timeout=20).stdout)}
    except Exception:
        listed = set()
    def fits(q):
        try:
            return not listed or set(os.listdir(q)) <= listed
        except Exception:
            return False
    p = next((c for c in cands if fits(c)), cands[0])
    if p.startswith("/sdcard/"):
        print(name + "|" + p[len("/sdcard/"):] + "/")
' "$n"
    """

  // The folder's own save button: can the launcher read it at all?
  let folderBody =
    """
    [ -n "$f" ] || { echo "no folder picked"; exit 0; }
    if omalauncher ls "$f" >/dev/null 2>&1; then echo "ok"
    else echo "cannot read $f"; fi
    """

  // ---- sources --------------------------------------------------------
  source now = clock every 1s
  source countsText = cmd(
    "where=" + sh(where) + ";dest=" + sh(destPath) + ";rel=" + sh(relToday) +
    ";section=" + sh(where == "quick" ? "" : secLine) + ";tag=" + sh(tag) + ";" +
    countBody) every 60s optional
  // Where the folders are on the phone, for the paths the cards show.
  source phonePathsText = cmd(
    "n=" + sh(join(phoneNames, "\n")) + ";" + phoneBody) every 5m optional
  // One status read while a press is in flight. Null when idle, so nothing
  // polls between presses.
  source agent = http(working && agentBase != "" ? agentBase + "/status" : null) every 5s json status
  // Dictation: what the phone hears after a tap on the sound mark. Read only
  // while a dictation runs, and nothing leaves the phone: the recognizer is
  // Android's own.
  source said = android.speech

  // ---- the press ------------------------------------------------------
  on pressed first {
    // post() fills the state when the answer arrives; the first value is 0.
    if pressed != null && pressed != 0 && !pressed.ok {
      working = false
      pressDeadline = 0
      deferredAt = now
      lastLine = str.notReachable
    }
  }

  // The tile's own deadline, so a run that never answers cannot sit there.
  at pressDeadline {
    if working {
      working = false
      deferredAt = now
      lastLine = str.notReachable
    }
    pressDeadline = 0
  }

  on goText {
    if value != "" {
      draft = tag + " "
      active = true
      last = now
    }
  }

  on result first {
    // Empty it again before acting: a second save prints the same "ok", and
    // an unchanged state would not run this a second time.
    let save = value
    result = ""
    if startsWith(save, "ok") {
      bite = 1
      biteUntil = now + 2
      haptic()
      pendingText = ""
      saveError = ""
      draft = ""
      refresh()
    } else if save != "" {
      saveError = save
      saveErrorAt = now
      draft = pendingText
      active = true
      last = now
      haptic()
      if notifyFail { notify(str.title, str.notifyFailText) }
    }
  }

  // The picker came back: write to the file it named, in the folder it is in,
  // keeping any subfolders between them.
  on pickFileOut {
    if value != "" {
      let parts = split(value, "|")
      let f = parts[0] ?? ""
      let n = join(drop(parts, 1), "|")
      if f == "!" {
        pickNote = n
      } else if f == "?" {
        pickNote = str.couldNotFind + " " + n + " " + str.inReachableFolder
      } else if n != "" {
        pickNote = ""
        folder = f
        noteRel = n
        saveOut = ""
        savedAt = 0
        checkSeq = checkSeq + 1
      }
    }
  }

  // No save button: picking the file is the save, and this proves it can be
  // read before you trust it with a thought. A trigger, so the check sees the
  // folder and name the picker just set.
  on checkSeq {
    savedAt = now
    saveOut = run("where=" + sh(where) + ";dest=" + sh(destPath) + ";" + saveBody)
  }

  // The same for the folder the agent keeps its files in.
  on pickFolderOut {
    if value != "" {
      let parts = split(value, "|")
      let f = parts[0] ?? ""
      let n = parts[1] ?? ""
      if f == "!" {
        pickFolderNote = n
      } else if f == "?" {
        pickFolderNote = str.couldNotFind + " " + n + " " + str.inReachableFolder
      } else if f != "" {
        // The folder the picked file is in, down to its own folder when it
        // sits in one: that is the one the row then shows.
        let rel = split(n, "/")
        let sub = join(take(rel, max(len(rel) - 1, 0)), "/")
        pickFolderNote = ""
        agentFolder = sub == "" ? f : f + "/" + sub
        folderSaveOut = ""
        folderSavedAt = 0
        folderCheckSeq = folderCheckSeq + 1
      }
    }
  }

  // Picking the folder is the save here too: check that the launcher can read
  // it, and say so if it cannot.
  on folderCheckSeq {
    folderSavedAt = now
    folderSaveOut = run("f=" + sh(agentFolderShown) + ";" + folderBody)
  }

  on saveOut {
    if startsWith(value, "ok") { haptic() }
  }

  on folderSaveOut {
    if startsWith(value, "ok") { haptic() }
  }

  // The phone stopped listening: its words go into the field, ready to read
  // over, edit, and send with Enter like a typed thought. Nothing is sent by
  // itself, so a word it misheard never becomes a note on its own.
  on said.final {
    if value != "" {
      let t = trim(draft)
      draft = t == "" ? value : t + " " + value
      active = true
      last = now
      blur = 0
      haptic()
    }
  }

  every 1s {
    if bite > 0 && now >= biteUntil { bite = 0 }
    if blur > 0 { blur = blur - 1 }
    if active && now - last >= 6 {
      active = false
      last = 0
      blur = 2
    }
    // A press is done when the computer is idle again. The status read is a
    // poll, not an event, so the result is checked here rather than on agent.
    if working && now - pressAt >= 6 && agent != null && agent.ok && agent.out != null {
      let a = agent.out
      if a.state == "idle" {
        let am = match(a.last ?? "", "^([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9:.+-]+) ([a-z]+) (.*)$")
        let al = am == null ? (a.last ?? "") : (am[3] ?? (a.last ?? ""))
        working = false
        pressDeadline = 0
        deferredAt = 0
        lastLine = a.last ?? ""
        let moved = al != "" && al != beforeLast
        let clause = first(split(al, " · ")) ?? al
        let shortClause = len(clause) > 16 ? sub(clause, 0, 16) + "…" : clause
        sortedText = moved ? (narrow ? str.sorted : str.sorted + " · " + shortClause) : str.nothingNew
        sortedAt = now
        if moved && notifySorted { notify(str.inbox, al) }
      }
    }
    // A status read that failed twice running means the computer is away.
    if working && agent != null && !agent.ok && now - pressAt >= 12 {
      working = false
      pressDeadline = 0
      deferredAt = now
      lastLine = str.notReachable
    }
    // A hung press must not sit on the tile looking like progress.
    if working && now - pressAt > 120 {
      working = false
      pressDeadline = 0
      deferredAt = now
      lastLine = str.notReachable
    }
    // A deferral is a moment, not a condition: ten minutes later, the tile
    // goes back to its usual count and prompt.
    if deferredAt > 0 && now - deferredAt > 600 {
      deferredAt = 0
      lastLine = ""
    }
    // A save error clears itself; the thought is already back in the field.
    if saveError != "" && now - saveErrorAt > 30 {
      saveError = ""
    }
    // The press confirmation is a moment too.
    if sortedAt > 0 && now - sortedAt > 20 {
      sortedAt = 0
      sortedText = ""
    }
  }

  // ---- the tile -------------------------------------------------------
  // Narrow tiles drop the second count and shorten the words, so 4x1 and
  // 3x1 never cut a sentence in half.
  let narrow = (tileWidth ?? 999) < 300
  let counts = words(countsText ?? "")
  let unknown = first(counts) == "?"
  let pending = unknown ? 0 : (num(counts[0] ?? 0) ?? 0)
  let nowPending = unknown ? 0 : (num(counts[1] ?? 0) ?? 0)
  let countText = unknown ? str.inbox + ": ?" : narrow ? str.inbox + ": " + pending : (tag == "" ? str.inbox + ": " + pending : str.inbox + ": " + pending + " • " + str.now + ": " + nowPending)
  let promptText = narrow ? str.feedIt : str.title
  let offlineText = narrow ? str.offline : str.notReachable
  let failedText = narrow ? str.notSaved : str.notSavedTap
  let statusSize = narrow ? 14 : 16
  let deferred = deferredAt > 0 && now - deferredAt < 600
  let failed = saveError != ""
  // What the phone heard so far, and why it couldn't listen: both shown where
  // the prompt goes, so a dictation never fails silently.
  let heard = said.text
  let micError = said.error ?? ""
  // Idle text alternates with the prompt every 5s, no focus needed. A deferral
  // alternates with the count instead, because both facts matter then.
  let showUpdate = (int(now / 5) % 2) == 0
  let sorted = sortedAt > 0 && now - sortedAt < 20
  let idleText =
    !ready ? (narrow ? str.setUp : str.setUpWhere) :
    failed ? failedText :
    said.listening ? (heard == "" ? (narrow ? str.listening : str.listeningMore) : heard) :
    micError != "" ? (showUpdate ? countText : micError) :
    deferred ? (showUpdate ? offlineText : countText) :
    working ? str.sorting :
    (!showUpdate ? (sorted ? sortedText : promptText) : countText)
  let countCol = unknown ? yellow : green
  let idleCol =
    !ready ? yellow :
    failed ? red :
    said.listening ? accent :
    micError != "" ? (showUpdate ? countCol : yellow) :
    deferred ? (showUpdate ? yellow : countCol) :
    working ? accent :
    (!showUpdate ? (sorted ? accent : muted) : countCol)
  let tooth = foreground
  // A tap dims its button for one clock tick.
  let orgFade = now - orgTapAt < 1 ? 0.14 : 1
  let goFade = now - goTapAt < 1 ? 0.14 : 1
  let micFade = now - micTapAt < 1 ? 0.14 : 1

  Box {
    fill: true

    Row {
      fill: true
      align: center
      gap: 6
      padding: [10, 0, 8, 0]

      Row {
        weight: 1
        height: 48
        align: center
        padding: [2, 0, 2, 0]

        // Read-only unless the field actually has the keys. The text stays
        // mounted otherwise, cycling with the prompt every five seconds.
        if active {
          Input {
            weight: 1
            height: 32
            text: draft
            placeholder: promptText
            fontSize: statusSize
            color: foreground
            underline: false
            clear: true
            onPress: {
              active = true
              last = now
            }
            onChange: {
              draft = value
              active = true
              last = now
            }
            onSubmit: {
              let text = trim(value)
              active = false
              last = 0
              blur = 2
              draft = ""
              if text != "" {
                pendingText = text
                pendingLine = prefixText + text
                result = run(
                  "where=" + sh(where) + ";dest=" + sh(destPath) +
                  ";section=" + sh(where == "quick" ? "" : secLine) + ";note=" + sh(pendingLine) +
                  ";pos=" + sh(pos) + ";gaps=" + sh(anchorGaps) + ";" + writeBody)
              }
            }
          }
        } else {
          Text {
            weight: 1
            text: idleText
            fontSize: statusSize
            color: idleCol
            maxLines: 1
            onTap: {
              if !ready {
                screen()
              } else {
                blur = 0
                active = true
                last = now
              }
            }
          }
        }
      }

      // Only while the field actually has the keys (the tap/typing timer is
      // running): a small × drops focus on demand, as the timer and Enter do.
      if blur == 0 && active {
        Box {
          width: 22
          height: 48
          align: center
          onTap: {
            active = false
            last = 0
            blur = 2
          }
          Text { text: str.close; fontSize: 20; color: muted }
        }
      }

      // Green list: one-shot "sort my inbox". It only exists when a computer
      // is set, so there is never a dead button.
      if agentBase != "" {
        Box {
          width: 24
          height: 48
          align: center
          onTap: {
            orgTapAt = now
            if !working {
              beforeLast = lastShown
              working = true
              pressAt = now
              pressDeadline = now + 120
              deferredAt = 0
              lastLine = ""
              pressed = post(agentBase + "/drain", null)
            }
          }
          Canvas {
            width: 24
            height: 24
            let cx = width / 2
            let cy = height / 2
            let col = working ? accent : green
            let ink = alpha(col, orgFade)
            // An Obsidian bullet list: three dots, three rules.
            circle(cx - 6, cy - 6, 1.5, fill: ink)
            circle(cx - 6, cy, 1.5, fill: ink)
            circle(cx - 6, cy + 6, 1.5, fill: ink)
            rect(cx - 1, cy - 7, 9, 1.5, radius: 0.7, fill: ink)
            rect(cx - 1, cy - 1, 9, 1.5, radius: 0.7, fill: ink)
            rect(cx - 1, cy + 5, 9, 1.5, radius: 0.7, fill: ink)
          }
        }
      }

      // Green ring with a dot: fills the field with the quick tag and leaves
      // the cursor at the end, ready to type. Hidden when the tag is off.
      if tag != "" {
        Box {
          width: 24
          height: 48
          align: center
          onTap: {
            goTapAt = now
            blur = 0
            active = true
            last = now
            draft = ""
            goSeq = goSeq + 1
            goText = run("echo go" + sh(goSeq))
          }
          Canvas {
            width: 24
            height: 24
            let cx = width / 2
            let cy = height / 2
            circle(cx, cy, 8.1, fill: alpha(background, goFade), stroke: alpha(green, goFade), width: 1.8)
            circle(cx, cy, 3.15, fill: alpha(green, goFade))
          }
        }
      }

      // The voice mark, Simon's five sound bars with the longest in the
      // middle: a tap dictates through the phone's own recognizer. The words
      // land in the field when it stops, so they can be read over and typed
      // over, and Enter sends them like a typed thought.
      if said.available && ready {
        Box {
          width: 24
          height: 48
          align: center
          onTap: {
            micTapAt = now
            active = false
            blur = 2
            last = 0
            speech("toggle")
          }
          Canvas {
            width: 24
            height: 24
            let cx = width / 2
            let cy = height / 2
            let ink = alpha(said.listening ? accent : green, micFade * (said.listening ? 0.55 + 0.45 * abs(sin(time * 3)) : 1))
            line(cx - 7.55, cy - 2.05, cx - 7.55, cy + 2.05, stroke: ink, width: 2.2, cap: round)
            line(cx - 3.8, cy - 4.6, cx - 3.8, cy + 4.6, stroke: ink, width: 2.2, cap: round)
            line(cx, cy - 7.4, cx, cy + 7.4, stroke: ink, width: 2.2, cap: round)
            line(cx + 3.8, cy - 4.6, cx + 3.8, cy + 4.6, stroke: ink, width: 2.2, cap: round)
            line(cx + 7.55, cy - 2.05, cx + 7.55, cy + 2.05, stroke: ink, width: 2.2, cap: round)
          }
        }
      }

      Box {
        width: 24
        height: 48
        align: end
        onTap: screen()
        Canvas {
          width: 24
          height: 24
          let cx = width / 2
          let cy = height / 2
          for i in range(8) {
            rotate(i * 45, cx, cy) {
              rect(cx - 1.35, cy - 10, 2.7, 4.5, radius: 0.9, fill: accent)
            }
          }
          circle(cx, cy, 5.4, fill: background, stroke: accent, width: 1.8)
          circle(cx, cy, 2.25, fill: accent)
        }
      }
    }

    // Upper teeth: rounded rectangles, every one a different width and height.
    Canvas {
      fill: true
      offset: [0, bite ? 7 : 0]
      animate offset: spring()
      let count = 14
      let raw = range(count).map(i => 0.55 + hash(i, 5) * 1.0)
      let tot = sum(raw)
      let ws = raw.map(r => r * width / tot)
      for i in range(count) {
        let x = i == 0 ? 0 : sum(ws.take(i))
        let h = 10 + hash(i, 7) * 9
        // Run the block far past the edge, so the base stays flush however far it chomps.
        rect(x + 1, -24, ws[i] - 2, h + 24, radius: 4, fill: tooth)
      }
    }

    // Lower teeth: the same idea, pointing up.
    Canvas {
      fill: true
      offset: [0, bite ? -7 : 0]
      animate offset: spring()
      let count = 14
      let raw = range(count).map(i => 0.55 + hash(i, 13) * 1.0)
      let tot = sum(raw)
      let ws = raw.map(r => r * width / tot)
      for i in range(count) {
        let x = i == 0 ? 0 : sum(ws.take(i))
        let h = 10 + hash(i, 11) * 9
        rect(x + 1, height - h, ws[i] - 2, h + 24, radius: 4, fill: tooth)
      }
    }
  }

  // ---- the settings screen -------------------------------------------
  // The laptop's `last` starts with its own log timestamp and the word ok;
  // show the sentence after them. A server that sends plain text is unchanged.
  let lastMatch = match(lastLine, "^([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9:.+-]+) ([a-z]+) (.*)$")
  let lastShown = lastMatch == null ? lastLine : (lastMatch[3] ?? lastLine)
  let savedFlash = savedAt > 0 && now - savedAt < 3 && (saveOut == "" || startsWith(saveOut, "ok"))
  let saveFailed = saveOut != "" && !startsWith(saveOut, "ok") && now - savedAt < 30
  let folderFlash = folderSavedAt > 0 && now - folderSavedAt < 3 && (folderSaveOut == "" || startsWith(folderSaveOut, "ok"))
  let folderFailed = folderSaveOut != "" && !startsWith(folderSaveOut, "ok") && now - folderSavedAt < 30
  let teeth = 14

  // The invitation, cut into three whole lines already: no word left alone on
  // the last one. Each line is one Text, and the size comes from the screen,
  // so the three fill the width at any size instead of running off it.
  let introLines = [str.intro1, str.intro2, str.intro3]
  let introChars = max(len(introLines[0]), max(len(introLines[1]), len(introLines[2])))
  // The screen's own inset, then the card's 12dp each side, are what is left
  // for the line; 0.57 is one mono character at a given size, a shade over.
  let introSize = clamp(((screenWidth ?? 360) - 54) / (0.57 * introChars), 8, 20)

  // One on/off switch for settings: the track takes the state's colour and
  // the knob slides over. The handler stays at the use, as handlers do.
  component Toggle(on) {
    Box {
      width: 46
      height: 26
      radius: 13 * corners
      background: on ? alpha(green, 0.3) : alpha(green, 0.12)
      border: 1
      borderColor: on ? alpha(green, 0.6) : alpha(green, 0.28)
      padding: 3
      align: on ? "end" : "start"
      Box {
        width: 18
        height: 18
        radius: 9 * corners
        background: on ? green : alpha(green, 0.45)
      }
    }
  }

  screen {
    title: str.title

    // the window draws its own ✕ over this frame, so this only supplies the
    // outline and a tap target behind the glyph
    Row {
      fill: width
      height: 26
      align: center
      justify: end
      offset: [0, -38]
      Box {
        width: 26
        height: 26
        radius: 8 * corners
        border: 1
        borderColor: alpha(accent, 0.3)
        background: alpha(background, 0.35)
        onTap: close()
      }
    }

    Box {
      fill: true
      Column {
        scroll: true
        fill: true
        gap: 10

        // ---- the invitation, between the tile's own teeth -----------
        // The teeth chomp: they reach for each other on `time` and let go, so
        // the box is alive without the text ever being covered.
        Column {
          fill: width
          gap: 8
          background: alpha(accent, 0.1)
          radius: 12 * corners
          clip: true

          // upper teeth: every one a different length, reaching down
          Canvas {
            fill: width
            height: 22
            let chomp = pow(max(0, sin(time * 2.2)), 2)
            let raw = range(teeth).map(i => 0.55 + hash(i, 5) * 1.0)
            let tot = sum(raw)
            let ws = raw.map(r => r * width / tot)
            for i in range(teeth) {
              let x = i == 0 ? 0 : sum(ws.take(i))
              let h = 8 + hash(i, 7) * 8 + chomp * 5
              rect(x + 1, -8, ws[i] - 2, h + 8, radius: 4, fill: tooth)
            }
          }

          Column {
            padding: [10, 10]
            gap: 8
            for line in introLines {
              Text {
                text: line
                style: body
                font: mono
                fontSize: introSize
                color: foreground
                align: center
                maxLines: 1
              }
            }
          }

          // lower teeth: the same idea, pointing up
          Canvas {
            fill: width
            height: 22
            let chomp = pow(max(0, sin(time * 2.2)), 2)
            let raw = range(teeth).map(i => 0.55 + hash(i, 13) * 1.0)
            let tot = sum(raw)
            let ws = raw.map(r => r * width / tot)
            for i in range(teeth) {
              let x = i == 0 ? 0 : sum(ws.take(i))
              let h = 8 + hash(i, 11) * 8 + chomp * 5
              rect(x + 1, height - h, ws[i] - 2, h + 8, radius: 4, fill: tooth)
            }
          }
        }

        // ---- 0: read this before picking anything -------------------
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text {
            text: str.important
            style: small
            color: foreground
          }
        }

        // ---- 1: where the agent is ----------------------------------
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text { text: upper(str.whereAgent); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }

          // Four answers on one row, each the same box, so the card keeps one
          // size whichever is picked.
          Row {
            fill: width
            gap: 8
            for m in modes {
              Box {
                height: 62
                weight: 1
                align: center
                radius: 8 * corners
                background: mode == m.key ? alpha(accent, 0.15) : alpha(background, 0.35)
                border: 1
                borderColor: alpha(accent, 0.3)
                onTap: {
                  haptic()
                  agentMode = m.key
                }
                Column {
                  align: center
                  gap: 3
                  if m.key == "desktop" {
                    Canvas {
                      width: 32
                      height: 26
                      let ink = mode == m.key ? accent : foreground
                      rect(1, 1, 30, 18, radius: 2, fill: alpha(ink, 0.14), stroke: ink, width: 1.5)
                      rect(13, 21, 6, 2, radius: 1, fill: ink)
                      rect(7, 24, 18, 2, radius: 1, fill: ink)
                    }
                  } else if m.key == "phone" {
                    Canvas {
                      width: 18
                      height: 26
                      let ink = mode == m.key ? accent : foreground
                      rect(0.8, 0.8, 16.4, 24.4, radius: 3, fill: alpha(ink, 0.14), stroke: ink, width: 1.5)
                      rect(6, 3, 6, 1.5, radius: 0.75, fill: ink)
                      circle(9, 22, 1.2, fill: ink)
                    }
                  } else if m.key == "server" {
                    Canvas {
                      width: 26
                      height: 26
                      let ink = mode == m.key ? accent : foreground
                      rect(0.8, 0.8, 24.4, 7, radius: 1.5, fill: alpha(ink, 0.14), stroke: ink, width: 1.4)
                      rect(0.8, 9.5, 24.4, 7, radius: 1.5, fill: alpha(ink, 0.14), stroke: ink, width: 1.4)
                      rect(0.8, 18.2, 24.4, 7, radius: 1.5, fill: alpha(ink, 0.14), stroke: ink, width: 1.4)
                      circle(4, 4.3, 1, fill: ink)
                      circle(4, 13, 1, fill: ink)
                      circle(4, 21.7, 1, fill: ink)
                    }
                  } else {
                    Canvas {
                      width: 32
                      height: 24
                      let ink = mode == m.key ? accent : foreground
                      path([[4, 20], [2.6, 16], [4, 11.5], [7, 8.6], [8.4, 5.6], [11.5, 4], [15.6, 4.2], [18.4, 6.4], [21, 5.4], [24.4, 7.4], [26, 11], [28.6, 13.4], [27.8, 17.4], [24.4, 20]], closed: true, fill: alpha(ink, 0.14), stroke: ink, width: 1.4)
                    }
                  }
                  Text {
                    text: m.label
                    style: small
                    fontSize: 9
                    color: mode == m.key ? accent : muted
                    align: center
                    maxLines: 1
                  }
                }
              }
            }
          }

          // Every mode has one field of the same height and one note under it,
          // so the card never moves when the choice changes. The phone's
          // address is fixed, so it is shown, not typed.
          Box {
            fill: width
            align: topStart
            Column {
              gap: 4
              fill: width
              // The frame is the field, at one height whatever is inside it:
              // the phone's fixed address as text, or an Input. Its height is
              // set, not left to the Input, so the note under it (and the rest
              // of the card) sits at the same place in every mode.
              Box {
                fill: width
                height: 34
                align: center
                background: alpha(background, 0.45)
                border: 1
                borderColor: alpha(accent, 0.55)
                radius: 6 * corners
                if mode == "phone" {
                  Row {
                    fill: width
                    padding: [14, 0]
                    align: center
                    Text { text: localBase; style: small; font: mono; fontSize: 13; color: muted; maxLines: 1 }
                  }
                } else {
                  Input {
                    fill: width
                    text: agentText
                    fontSize: 13
                    color: foreground
                    placeholder: mode == "cloud" ? str.agentPlaceholderCloud : str.agentPlaceholderLocal
                    underline: false
                    padding: [14, 0]
                    onChange: {
                      if mode == "desktop" { base = value }
                      else if mode == "server" { serverBase = value }
                      else { cloudBase = value }
                    }
                  }
                }
              }
              Text {
                text: agentNote
                style: small
                color: muted
                minLines: 2
              }
            }
          }
        }

        // ---- 2: the file it writes to -------------------------------
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text { text: upper(str.selectInbox); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }

          // One row, left-aligned: the path starts where the title does, and
          // when it is too long its front is cut, so the file name always
          // stays on screen. Picking a file checks it; there is nothing to
          // press to save.
          Row {
            fill: width
            align: center
            gap: 8
            Box {
              width: 34
              height: 30
              align: center
              background: alpha(background, 0.35)
              border: 1
              borderColor: savedFlash ? green : alpha(accent, 0.3)
              radius: 8 * corners
              onTap: {
                pickNote = ""
                pickFileOut = ""
                pickFileOut = run(pickBody)
              }
              Canvas {
                width: 20
                height: 20
                if savedFlash {
                  line(4, 11, 8, 15, stroke: green, width: 2)
                  line(8, 15, 16, 5, stroke: green, width: 2)
                } else {
                  path([[2, 6], [2, 17], [18, 17], [18, 8], [9, 8], [7, 5], [2, 5]], closed: true, fill: alpha(accent, 0.16), stroke: accent, width: 1.2)
                }
              }
            }
            Row {
              weight: 1
              align: center
              gap: 0
              Text {
                text: dirLabelCut
                style: small
                font: mono
                fontSize: pathSize
                color: green
                maxLines: 1
              }
              Text {
                text: destName
                style: small
                font: mono
                fontSize: pathSize
                color: foreground
                maxLines: 1
              }
            }
          }
          if pickNote != "" {
            Text { text: pickNote; style: small; color: yellow; maxLines: 2 }
          }
          if saveFailed {
            Text { text: saveOut; style: small; color: red; maxLines: 2 }
          }
        }

        // ---- 3: where the notes are sorted --------------------------
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text { text: upper(str.selectFolder); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }

          Row {
            fill: width
            align: center
            gap: 8
            Box {
              width: 34
              height: 30
              align: center
              background: alpha(background, 0.35)
              border: 1
              borderColor: folderFlash ? green : alpha(accent, 0.3)
              radius: 8 * corners
              onTap: {
                pickFolderNote = ""
                pickFolderOut = ""
                pickFolderOut = run(pickBody)
              }
              Canvas {
                width: 20
                height: 20
                if folderFlash {
                  line(4, 11, 8, 15, stroke: green, width: 2)
                  line(8, 15, 16, 5, stroke: green, width: 2)
                } else {
                  path([[2, 6], [2, 17], [18, 17], [18, 8], [9, 8], [7, 5], [2, 5]], closed: true, fill: alpha(accent, 0.16), stroke: accent, width: 1.2)
                }
              }
            }
            Text {
              text: agentLabelCut
              style: small
              font: mono
              fontSize: agentSize
              color: green
              weight: 1
              maxLines: 1
            }
          }
          if pickFolderNote != "" {
            Text { text: pickFolderNote; style: small; color: yellow; maxLines: 2 }
          }
          if folderFailed {
            Text { text: folderSaveOut; style: small; color: red; maxLines: 2 }
          }

          // The paragraph starts at the icon's own top, beside it, and wraps
          // under it when it runs longer than the icon is tall.
          Row {
            fill: width
            gap: 10
            align: top
            Box {
              width: 34
              height: 30
              align: center
              background: alpha(background, 0.35)
              border: 1
              borderColor: alpha(accent, 0.3)
              radius: 8 * corners
              Canvas {
                width: 24
                height: 24
                let cx = width / 2
                let cy = height / 2
                circle(cx - 6, cy - 6, 1.5, fill: green)
                circle(cx - 6, cy, 1.5, fill: green)
                circle(cx - 6, cy + 6, 1.5, fill: green)
                rect(cx - 1, cy - 7, 9, 1.5, radius: 0.7, fill: green)
                rect(cx - 1, cy - 1, 9, 1.5, radius: 0.7, fill: green)
                rect(cx - 1, cy + 5, 9, 1.5, radius: 0.7, fill: green)
              }
            }
            Text {
              text: str.sortHelp
              style: small
              color: muted
              weight: 1
            }
          }
        }

        // ---- 4: the prefix that bumps a note ------------------------
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text { text: upper(str.bumpTitle); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }

          Row {
            gap: 10
            align: center
            Box {
              width: 34
              height: 30
              align: center
              background: alpha(background, 0.35)
              border: 1
              borderColor: alpha(accent, 0.3)
              radius: 8 * corners
              Canvas {
                width: 24
                height: 24
                let cx = width / 2
                let cy = height / 2
                circle(cx, cy, 9, fill: alpha(background, 0.5), stroke: green, width: 2)
                circle(cx, cy, 3.5, fill: green)
              }
            }
            Text {
              text: str.bumpHelp
              style: small
              color: muted
              weight: 1
            }
          }

          Text { text: str.bumpNote; style: small; color: muted }
          Box {
            fill: width
            align: center
            Box {
              fill: width
              height: 34
              background: alpha(background, 0.45)
              border: 1
              borderColor: alpha(accent, 0.55)
              radius: 6 * corners
            }
            Input {
              fill: width
              text: tag
              fontSize: 13
              color: foreground
              placeholder: str.tagPlaceholder
              underline: false
              padding: [14, 0]
              onChange: tag = value
            }
          }
        }

        // ---- 5: the format of the line ------------------------------
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text { text: upper(str.formatTitle); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }
          Text {
            text: str.formatHelp
            style: small
            color: muted
          }
          Box {
            fill: width
            align: center
            Box {
              fill: width
              height: 34
              background: alpha(background, 0.45)
              border: 1
              borderColor: alpha(accent, 0.55)
              radius: 6 * corners
            }
            Input {
              fill: width
              text: section
              fontSize: 13
              color: foreground
              placeholder: str.sectionPlaceholder
              underline: false
              padding: [14, 0]
              onChange: section = value
            }
          }

          Text { text: str.prefixQuestion; style: small; color: muted }
          Box {
            fill: width
            align: center
            Box {
              fill: width
              height: 34
              background: alpha(background, 0.45)
              border: 1
              borderColor: alpha(accent, 0.55)
              radius: 6 * corners
            }
            Input {
              fill: width
              text: prefix
              fontSize: 13
              color: foreground
              placeholder: str.prefixPlaceholder
              underline: false
              padding: [14, 0]
              onChange: prefix = value
            }
          }

          Text { text: str.posQuestion; style: small; color: muted }
          Row {
            gap: 8
            Box {
              width: 68
              height: 30
              align: center
              background: pos == "top" ? alpha(accent, 0.15) : alpha(background, 0.35)
              radius: 8 * corners
              border: 1
              borderColor: alpha(accent, 0.3)
              onTap: { haptic(); pos = "top" }
              Text { text: str.top; style: body; color: pos == "top" ? #ffffff : muted; align: center; maxLines: 1 }
            }
            Box {
              width: 68
              height: 30
              align: center
              background: pos == "bottom" ? alpha(accent, 0.15) : alpha(background, 0.35)
              radius: 8 * corners
              border: 1
              borderColor: alpha(accent, 0.3)
              onTap: { haptic(); pos = "bottom" }
              Text { text: str.bottom; style: body; color: pos == "bottom" ? #ffffff : muted; align: center; maxLines: 1 }
            }
          }
        }

        // ---- the preview --------------------------------------------
        // In the order the note actually lands: at the top, the new note sits
        // above the older priority one; at the bottom, the other way round.
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text { text: upper(str.preview); style: label; color: #ffffff; letterSpacing: 1.2 }
          Column {
            gap: 0
            Text {
              text: anchorKey == "" ? str.noAnchor : anchorKey
              style: small
              font: mono
              fontSize: 12
              color: foreground
              maxLines: 2
            }
            for i in range(anchorGaps) {
              Spacer { height: 8 }
            }
            if pos == "top" {
              Text { text: sampleNote; style: small; font: mono; fontSize: 12; color: foreground; maxLines: 3 }
              if tag != "" {
                Text { text: sampleNow; style: small; font: mono; fontSize: 12; color: foreground; maxLines: 3 }
              }
            } else {
              if tag != "" {
                Text { text: sampleNow; style: small; font: mono; fontSize: 12; color: foreground; maxLines: 3 }
              }
              Text { text: sampleNote; style: small; font: mono; fontSize: 12; color: foreground; maxLines: 3 }
            }
          }
          Text {
            text: pos == "top" ? str.newTop : str.newBottom
            style: small
            color: muted
          }
        }

        // ---- 6: what the phone is told ------------------------------
        Column {
          gap: 8
          fill: width
          padding: [10, 10]
          background: alpha(accent, 0.1)
          radius: 12 * corners

          Text { text: upper(str.notifications); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }

          Row {
            fill: width
            align: center
            gap: 10
            Text {
              text: str.notifyFailLabel
              style: body
              color: #ffffff
              weight: 1
              maxLines: 1
            }
            Box { onTap: { haptic(); notifyFail = !notifyFail }; Toggle { on: notifyFail } }
          }

          Row {
            fill: width
            align: center
            gap: 10
            Text {
              text: str.notifySortedLabel
              style: body
              color: #ffffff
              weight: 1
              maxLines: 1
            }
            Box { onTap: { haptic(); notifySorted = !notifySorted }; Toggle { on: notifySorted } }
          }
        }

        // who made it, at the foot of this screen and out of the way
        Text {
          text: str.builtBy
          style: small
          color: #ffffff
          align: center
          maxLines: 1
          onTap: url("https://jaquesbody.github.io/")
        }
      }
    }
  }
}
