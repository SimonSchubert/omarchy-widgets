// opencode-burn: OpenCode free-model request quota, paced. It started as a
// Burn Bar — a plain gauge of what today has cost — and grew a pacer, the
// 5-hour window, and a way to browse the whole Zen lineup.
//
// Reads opencode's own session database for what was actually spent today, then
// shows the free tier's shared daily allowance: one total ring and a total-first
// chart, with the current model's rolling five-hour window inside it. OpenCode
// publishes 200 requests/day for the free tier (Big Pickle plus the promotional
// models), but it does throttle as and when, and exposes no live quota API — so
// treat the cap as the number you want to be measured against. It is a slider on
// the screen behind the dial, and it sticks.
//
// The free lineup rotates (cat-jam-free and step-5-preview-free are already
// gone), so what counts as free, and what it costs, is fetched live. It only
// ever reads: a usage tracker that also moved your sessions would be a fault,
// not a feature, so the meter's side pill just picks which meter it shows.
widget "opencode-burn" {
  meta {
    owl: 16
    description: "Tracks OpenCode's shared daily free-model quota and each model's 5-hour window, with a per-machine chart and a paid key's balance in sats or your currency."
    version: "2.0.0"
    license: "MIT"
    category: "dev"
  }

  size: 2x2

  // the dial, its verdict and the two corner tags want a 2x2: squeezed into one
  // cell the rings close in, and the words land on them
  minSize: 2x2
  // a single number: the launcher ignores a [l, t, r, b] list on the widget
  // itself, so the four-value padding this once had never applied. Kept small:
  // the dial and the verdict want the room
  padding: 3

  requires { pacman: ["sqlite", "curl", "jq", "openssh", "coreutils", "gawk", "sed", "gzip", "procps-ng"] }

  strings {
    en {
      title: "opencode burn"
      builtBy: "built by jaquesbody"
      inspiredBy: "inspired by nixfred / burnbar"
      free: "free"
      paid: "paid"
      freeCaps: "FREE"
      req: "req"
      requests: "requests"
      left: "left"
      aDay: "a day"
      notifications: "notifications"
      freeDaily: "Free (daily total)"
      freeWindow: "Free (5-hour window)"
      paidLowLabel: "Paid (low balance)"
      paidModels: "paid models"
      models: "models"
      connectHelp: "Your provider should connect automatically. If not, paste the API key below and press connect."
      apiKey: "API key"
      connect: "connect"
      currency: "currency"
      providerUrl: "node url"
      sshHost: "ssh host"
      low: "set low warning"
      save: "save"
      linkDevice: "link a device"
      linkHelp: "Add other devices to see what you use and where you use it"
      step1: "step 1:"
      step2: "step 2:"
      step3: "step 3:"
      step4: "step 4:"
      runTerminal: "run it in a terminal on your other device"
      pasteOutput: "paste the output below"
      deviceHint: "your device opencode-burn-query"
      connectedDevices: "connected devices"
      omarchyBar: "omarchy bar"
      refresh: "refresh"
      nothingSpent: "nothing spent in this window"
      nothingToday: "nothing today"
      all: "all"
      allModels: "all models"
      sharedFree: "shared by every free model"
      sharedAllFree: "shared by all free models"
      new: "NEW"
      totalDailyCap: "total daily cap"
      basedOn: "based on"
      tweakBelow: "tweak below"
      connected: "connected"
      notConnected: "not connected"
      advanced: "advanced"
      copied: "copied"
      copyInstaller: "copy installer"
      connecting: "connecting"
      approveMachine: "tap to approve this machine"
      answering: "answering"
      notAnswering: "not answering"
      thisDevice: "this device"
      remove: "remove"
      pushing: "pushing…"
      addBarWidget: "add widget to Omarchy device"
      waybarDone: "successfully added to waybar"
      omarchyBarDone: "successfully added to Omarchy bar"
      providerUrlHint: "https://…/v1"
      sshHostHint: "empty: this device"
    }
  }

  // ---- the numbers you may want to change ------------------------------
  // the cap is a state, so the slider in the screen can change it and it
  // sticks; the other two are `let`s, so they are edited here in the file
  state dailyCap = 460 persist  // the quota to be measured against, requests per day
  let margin = 5        // % of the cap that still counts as "on pace"

  // sats are the number that is stored and tracked; the currency is a skin on
  // top of them, at the last rate the rates source fetched
  state currency = "sat" persist    // sat | gbp | usd | eur
  state spendRange = "24h" persist  // 24h | 7d | 30d | all
  // the pill in the header reads which meter is on show. Empty follows the
  // model in use; a tap picks a side and it stays picked until the other tap
  state side = "" persist           // "" | free | paid
  state paidLow = 500 persist       // sats: the balance that turns the number red
  state paidPeak = 0 persist        // sats: the fullest this key has been, the ring's full mark
  // what the settings form holds while you type, cleared when it is saved
  state fHost = ""
  state fUrl = ""
  state fKey = ""
  state fKeyfile = ""
  state fModels = ""
  state fProvider = ""
  state advPaid = false persist      // shows the provider url, host and model rows
  state showCur = false

  // Limits are not the same for every model. OpenCode's Go page (the paid tier)
  // lists a 5-hour window per model and marks some as unlimited — Beam Free and
  // LongCat 2.5 Preview Free are both ∞, while Kimi K3 is 110 per 5 hours and
  // Muse Spark is 45,300. Check it against the free tier's own 200/day before
  // trusting a number here: https://opencode.ai/go
  // A model named in `unlimited` is never paced; the maps beat the numbers above.
  //
  // The optional limits.json is shared with the Omarchy bar helper, so both
  // sides apply the same per-model caps. Missing or malformed means defaults.
  // A file source is watched rather than polled: editing it shows at once, and
  // it costs a shell not even once.
  source limits = file("~/.config/opencode-burn/limits.json") json

  let unlimited = limits != null && limits.unlimited != null
    ? limits.unlimited : ["beam-free", "longcat-2.5-preview-free"]
  let capOverrides = limits != null && limits.capOverrides != null ? limits.capOverrides : {}
  let winOverrides = limits != null && limits.winOverrides != null ? limits.winOverrides : {}

  // the free tier is quoted at 200 requests/day, but the quota that actually
  // gets enforced has been known to land anywhere in this band, so the graph
  // draws both bounds. Set either to 0 to drop that line.
  let capLow = 200
  let capHigh = 750
  let capMid = 450      // the figure the band is centred on, for the caption
  let capMin = 50       // the ends of the daily rate limit control below
  let capMax = 1000

  // and a rolling window on top of the day, which is what actually throttles
  let winCap = 200       // requests per rolling window

  // the screen has the detail: today, every model, and the cap to change
  onTap: screen()

  // ---- today's usage, per model, straight out of opencode's database ----
  state seenLineup = [] persist  // free model ids this widget has already met
  state showAll = false persist  // the whole catalogue, or just what is free
  state deskSeen = 0 persist  // when the remote last answered
  state chartFocus = "" persist  // which model the chart is showing; "" means all models
  state pane = "" persist    // "setup" is the linking view; it reopens as you left it
  state flash = false        // a button was pressed: colour it, then put it back
  state flashAt = 0
  state pending = false      // asked to connect, waiting for an answer
  state pendingAt = 0        // and gives up waiting after a while
  state pendingAddr = ""     // the one address we asked about, so the wait is about something
  state pasted = "" persist  // what the setup field holds, kept across visits
  state saidDay = 0 persist  // the day the threshold notices below were said on
  state said = [] persist    // which of them have already been said, so once each
  state notifyTotal = true persist // free: the shared daily cap is nearly gone
  state notifyWin = true persist   // free: this model's five hours are up
  state notifyPaid = true persist  // paid: the key has fallen under the warn level
  state paidSaid = false persist   // that paid notice has been said for this drain
  state poke = 0            // bumped by the wake button to poll the other machines now
  state wakeAt = 0           // and when it was bumped, so the button can show it spinning
  state barPush = false      // the bar module is being pushed to a device
  state barPushAt = 0        // and gives up waiting after a while
  state lineupBoot = false persist  // the first lineup we see is the baseline, not news
  // Every five minutes, not every one: each poll is a shell, a `date` and a
  // sqlite query over a database that can hold hundreds of megabytes, and a
  // phone pays for each of them. The screen's `refresh` asks at once when you
  // want it now. The busy timeout rides out opencode writing while we read.
  source db = cmd("""
    db=$HOME/.local/share/opencode/opencode.db
    if [ ! -r "$db" ]; then echo '{"day":0,"end":0,"now":0,"current":null,"models":[]}'; exit 0; fi
    now=$(date +%s); day=$(date -d 'today 00:00' +%s); end=$(date -d 'tomorrow 00:00' +%s)
    # opencode changed its schema partway through: current builds keep sessions
    # in session_message (type / model.id / tokens.input+output+reasoning),
    # older ones in message (role / modelID / tokens.total). Ask the file which
    # one it fills, so this survives opencode being upgraded too.
    filled=$(sqlite3 -readonly -cmd ".timeout 8000" "$db" "SELECT count(*) FROM session_message WHERE type='assistant';" 2>/dev/null || echo 0)
    if [ "${filled:-0}" -gt 0 ]; then
      tbl=session_message; where="type='assistant'"
      mid="json_extract(data,'\$.model.id')"
      tok="coalesce(json_extract(data,'\$.tokens.input'),0)+coalesce(json_extract(data,'\$.tokens.output'),0)+coalesce(json_extract(data,'\$.tokens.reasoning'),0)"
    else
      tbl=message; where="json_extract(data,'\$.role')='assistant'"
      mid="json_extract(data,'\$.modelID')"
      tok="coalesce(json_extract(data,'\$.tokens.total'),0)"
    fi
    sqlite3 -readonly -cmd ".timeout 8000" -cmd ".param init" -cmd ".param set :day $day" -cmd ".param set :now $now" -cmd ".param set :end $end" "$db" "
    WITH RECURSIVE
      slot(s) AS (SELECT 0 UNION ALL SELECT s+1 FROM slot WHERE s < 23),
      agg AS (
        SELECT $mid AS mid, count(*) AS n,
               sum($tok) AS t,
               sum(time_created/1000 >= :now-3600) AS r,
               sum(time_created/1000 >= :now-18000) AS w,
               min(23, CAST((time_created/1000 - :day)/3600 AS INTEGER)) AS b
        FROM $tbl
        WHERE $where
          AND $mid IS NOT NULL
          AND time_created/1000 >= :day
        GROUP BY mid, b),
      per AS (
        SELECT a.mid AS mid, sum(a.n) AS u, sum(a.t) AS t, sum(a.r) AS r, sum(a.w) AS w,
          json((SELECT json_group_array(coalesce(x.n, 0))
                FROM slot s LEFT JOIN agg x ON x.mid = a.mid AND x.b = s.s)) AS sl
        FROM agg a GROUP BY a.mid)
    SELECT json_object(
      'day', :day, 'end', :end, 'now', :now,
      'current', (SELECT $mid FROM $tbl
                  WHERE $where
                    AND $mid IS NOT NULL
                  ORDER BY time_created DESC LIMIT 1),
      'currentAt', (SELECT max(time_created) FROM $tbl
                  WHERE $where
                    AND $mid IS NOT NULL),
      -- json() around it: without it sqlite hands the array back as a quoted
      -- string, and the widget reads one nameless row instead of every model
      'models', json((SELECT json_group_array(json_object(
                   'm', mid, 'used', u, 'tok', t, 'r1h', r, 'r5h', w, 'slots', json(sl))) FROM per)));"
  """) every 5m json timeout 45s

  // ---- usage from other machines, if you ask for it --------------------
  // Polled every ten minutes: each poll is an ssh round trip per machine, the
  // most expensive thing this widget does, and what another machine spent
  // moves in minutes anyway. The wake button beside a machine (and `refresh`
  // on the screen) asks at once.
  // OpenCode's free quota is per account, not per machine, so whatever
  // another machine spends is spent out of the same allowance. List them in
  // ~/.config/opencode-burn/remote, one per line, each an address and the
  // command to run there:
  //
  //     you@desktop opencode-burn-query
  //     you@laptop ~/.local/bin/opencode-burn-query
  //
  // Keep the user in the address: ssh otherwise logs in as this phone's
  // user, which the other machine usually refuses.
  //
  // That file is yours and is not part of the widget, so nothing about your
  // network is published with it. Without it this stays off: nothing is
  // contacted and the widget reports only what it can see locally. Every
  // entry is asked for the same JSON this widget reads locally, each says
  // its own name, and all of them are summed. One that is asleep is left out
  // of the day's numbers and reported as not answering, never as zero. The
  // first machine also gets this phone's snapshot in the same pass, so the
  // bar there can fold it in; that is why no background reporter is needed.
  source remote = cmd("""
    mkdir -p $HOME/.config/opencode-burn
    poke="${sh(poke)}"    # quoted: the wake button bumps this, and the
                          # changed text is what re-runs the poll at once
    cfg=$HOME/.config/opencode-burn/remote
    errf=$HOME/.config/opencode-burn/.ssherr
    # older releases left a reporter process behind. It is no longer needed:
    # stop it and remove its copy so an upgrade cannot keep it alive.
    old=$HOME/.local/bin/opencode-burn-report
    if [ -f "$old" ]; then
      pids=$(pgrep -f "^bash $old$" 2>/dev/null || true)
      [ -z "$pids" ] || kill $pids 2>/dev/null || true
      rm -f "$old"
    fi
    pushed=0
    devs='[]'
    auth=''
    if [ -r "$cfg" ]; then
      # the phone's own snapshot, made only while this source is being polled
      # and a remote is configured. The query helper is installed by the same
      # button that installs the bar.
      snap=''
      q=$HOME/.local/bin/opencode-burn-query
      if [ -x "$q" ]; then
        snap=$("$q" 2>/dev/null)
        printf '%s' "$snap" | jq -e '.ok == 1 and (.models | type == "array")' >/dev/null 2>&1 || snap=''
      fi
      while IFS= read -r line || [ -n "$line" ]; do
        # strip a comment, trim whitespace, then split at the first space so a
        # command with arguments survives as one quoted ssh argument
        line=${line%%#*}; line=${line%$'\r'}
        line=$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -n "$line" ] || continue
        addr=${line%%[[:space:]]*}
        [ "$addr" != "$line" ] || continue
        cmd=${line#"$addr"}
        cmd=${cmd#"${cmd%%[![:space:]]*}"}
        [ -n "$cmd" ] || continue
        # an address is a host/user, never an ssh option
        case "$addr" in
          -*) continue ;;
        esac
        out=$(timeout 6 ssh -o BatchMode=yes -o ConnectTimeout=4 -o LogLevel=ERROR \
            -o StrictHostKeyChecking=accept-new -o ControlPath=none \
            "$addr" "$cmd" 2>"$errf") || out='{"ok":0}'
        [ -n "$auth" ] || auth=$(grep -o 'https://login.tailscale.com/a/[0-9a-z]*' "$errf" 2>/dev/null | head -1)
        devs=$(jq -c -n --argjson p "$devs" --argjson c "$out" --arg a "$addr" \
          '$p + [{addr:$a, ok:($c.ok==1), name:($c.name//""),
                  current:($c.current//""), currentAt:($c.currentAt//0),
                  models:($c.models//[])}]')
        # push this phone to the first machine only, and read its cap back in
        # the same round trip. The newer stamp wins; when the desktop slider
        # moved, this updates the widget's own slider to match.
        if [ "$pushed" -eq 0 ] && [ -n "$snap" ]; then
          pushed=1
          pout=$(printf '%s' "$snap" | timeout 8 ssh -o BatchMode=yes -o ConnectTimeout=4 \
            -o LogLevel=ERROR -o StrictHostKeyChecking=accept-new -o ControlPath=none \
            "$addr" 'f=$HOME/.cache/opencode-burn-phone.json; mkdir -p "$HOME/.cache" && cat > "$f.new" && if jq -e ".ok == 1 and (.models | type == \"array\")" "$f.new" >/dev/null 2>&1; then mv "$f.new" "$f"; else rm -f "$f.new"; fi; printf "%s %s\n" "$(tr -dc 0-9 < ~/.config/opencode-burn/cap 2>/dev/null | head -c 4)" "$(tr -dc 0-9 < ~/.config/opencode-burn/cap.at 2>/dev/null | head -c 12)"' 2>/dev/null)
          case "$pout" in
            *' '*) hc=${pout%% *}; ha=${pout##* } ;;
            *) hc=''; ha='' ;;
          esac
          lc=$(cat "$HOME/.config/opencode-burn/cap" 2>/dev/null || echo 460)
          la=$(cat "$HOME/.config/opencode-burn/cap.at" 2>/dev/null || echo 0)
          if [ -n "$hc" ] && [ -n "$ha" ] && [ "$ha" -gt "${la:-0}" ] 2>/dev/null; then
            printf '%s' "$hc" > "$HOME/.config/opencode-burn/cap"
            printf '%s' "$ha" > "$HOME/.config/opencode-burn/cap.at"
            if [ "$hc" != "$lc" ] && [ -x /usr/local/bin/owl-send ]; then
              /usr/local/bin/owl-send 12-opencode-burn.owl set dailyCap "$hc" >/dev/null 2>&1 || true
            fi
          fi
        fi
      done < "$cfg"
    fi
    jq -c -n --argjson d "$devs" --arg a "$auth" '
      [$d[].models[]] as $all
      | {ok: ([$d[] | select(.ok)] | length) > 0,
         auth: $a,
         devices: $d,
         models: ($all | group_by(.m) | map({
                   m: .[0].m, used:(map(.used)|add), tok:(map(.tok)|add),
                   r1h:(map(.r1h)|add), r5h:(map(.r5h)|add),
                   slots: [range(0;24) as $i | ([.[] | .slots[$i]] | add // 0)]})),
         current: (($d | map(select(.ok)) | sort_by(.currentAt // 0) | last) // {} | .current),
         currentAt: ([$d[].currentAt // 0] | max)}'
  """) every 10m json timeout 40s

  // the phone's own model: the sandbox hostname is a container name, not the
  // handset, and this is the one thing only Android can answer
  source dev = android.device

  // what the bar push said back. ssh runs it and writes here rather than to
  // /dev/null, so a refusal is shown instead of quietly doing nothing
  source barOut = file("~/.config/opencode-burn/.barout")

  // what this machine calls itself, so it can be named in the same list as the
  // others rather than called "this device"
  source host = cmd("""
    (uname -n 2>/dev/null || cat /etc/hostname 2>/dev/null) | jq -R '{name: .}'
  """) every 6h json

  // ---- the free lineup, live: it rotates, so don't hard-code it --------
// Zen's own catalogue says which models are free; models.dev says what each one
// can do (vision, video, reasoning, tools, context). That second file is 5 MB,
// so it is cached here and only refetched once a day. If either fetch fails the
// widget carries on with the last good lineup.
  source zen = cmd("""
    cache=$HOME/.cache/owl-zen-models.json
    mkdir -p "$HOME/.cache"
    now=$(date +%s)
    fetched=$(stat -c %Y "$cache" 2>/dev/null || echo 0)
    if [ "$fetched" -eq 0 ] || [ $(( now - fetched )) -gt 86400 ]; then
      curl -sf --max-time 60 https://models.dev/api.json -o "$cache.new" && mv "$cache.new" "$cache"
    fi
    [ -s "$cache" ] || echo '{}' > "$cache"
    # Replace the lineup only after a successful fetch; on failure keep the last
    # good one and exit nonzero so the widget can show it as stale.
    lineup=$HOME/.cache/.owl-zen-lineup.json
    lineup_new=$HOME/.cache/.owl-zen-lineup.json.new
    lineup_ok=1
    if ! curl -sf --max-time 15 https://opencode.ai/zen/v1/models -o "$lineup_new"; then
      lineup_ok=0
      rm -f "$lineup_new"
    else
      mv "$lineup_new" "$lineup"
    fi
    [ -s "$lineup" ] || echo '{"data":[]}' > "$lineup"
    jq -cn --slurpfile m "$cache" '
      ($m[0].opencode.models // {}) as $mm
      | [ inputs.data[]?.id
          | . as $id
          | ($mm[$id] // {}) as $x
          | { id: $id,
              # a model only belongs in the free list while the catalogue says
              # it costs nothing. a model dropped from the free tier keeps its
              # id and often stays in a stale lineup for a while, so the price
              # is what catches it: it would otherwise sit in the free list
              # showing a $/tkn number
              free: (($id | endswith("-free")) or $id == "big-pickle")
                    and (($x.cost.input // 0) == 0) and (($x.cost.output // 0) == 0),
              costIn: ($x.cost.input // null),
              costOut: ($x.cost.output // null),
              tags: ([ if (($x.modalities.input // []) | index("video")) then "video" else empty end,
                       if (($x.modalities.input // []) | index("image")) then "image" else empty end,
                       if $x.reasoning then "thinking" else empty end,
                       if $x.tool_call then "tools" else empty end,
                       if (($x.modalities.input // []) | index("audio")) then "audio" else empty end,
                       if (($x.limit.context // 0) >= 1000000) then "1M ctx" else empty end ] | .[:3]) } ]' "$lineup" || exit 1
    [ "$lineup_ok" -eq 1 ] || exit 1
""") every 2h json timeout 120s status

  // ---- paid spend: the provider key, wherever its node is --------------
  // The free quota above is requests. Paid is money, so it needs its own meter:
  // the node knows the key's balance and what it has spent in total, and the
  // widget samples that every five minutes. total_spent is lifetime only, so
  // the samples in spend.tsv are what makes "today" and "last 7 days" possible.
  //
  // Nothing here is tied to one vendor: the provider is whichever one opencode
  // has that is not its own free tier, and the node is reached the way the
  // desktop's bar reaches its usage, over ssh on the tailnet, so one bound to
  // loopback still answers. ~/.config/opencode-burn/paid.json holds {host, url,
  // key, keyfile, unit, provider, model, topup}; the settings card writes it.
  // No key means no header, which is what a local node wants.
  source paid = cmd("""
#!/bin/sh
# opencode-burn: what the paid key has spent, from the node it points at.
# Reads ~/.config/opencode-burn/paid.json, asks for the key's balance and its
# lifetime spend, samples that into spend.tsv, and answers with the windows the
# widget asks for. Prints one JSON object, always.
cfg=$HOME/.config/opencode-burn/paid.json
hist=$HOME/.config/opencode-burn/spend.tsv
ocfg=$HOME/.config/opencode/opencode.json
js() { jq -r "$1 // empty" "$cfg" 2>/dev/null; }

# opencode holds a provider in one of two shapes: {provider:{id:{options:…}}}
# in the older config, {providers:{id:{settings:…}}} in the newer one. Both
# answer the same four fields, so everything below asks this instead of either.
prov_jq='
  ([(.providers // {}) | to_entries[]
      | {id:.key, o:(.value.settings // {}), m:(.value.models // {})}]
   + [(.provider // {}) | to_entries[]
      | {id:.key, o:(.value.options // {}), m:(.value.models // {})}])
  as $ps
  | . as $root
  | $ps[]
  | select((.id != "opencode")
      and ((((.o.baseURL // "") | ascii_downcase) | test("opencode\\.ai")) | not))
  # the model to switch to: the one this config runs, or the small one, when
  # either belongs to this provider; the first model it lists otherwise
  | .id as $i
  | [.id, (.o.baseURL // ""),
     ((.o.apiKey // "") | if type == "string" then . else "" end),
     (if (($root.model // "") | startswith($i + "/")) then ($root.model | ltrimstr($i + "/"))
      elif (($root.small_model // "") | startswith($i + "/")) then ($root.small_model | ltrimstr($i + "/"))
      else ((.m // {}) | keys[0] // "") end)] | @tsv'

host=$(js .host); url=$(js .url); key=$(js .key); keyfile=$(js .keyfile)
unit=$(js .unit); provider=$(js .provider); pmodel=$(js .model); topup=$(js .topup)
[ -n "$unit" ] || unit=msat

# A node whose books are a wallet on its own disk: the balance is the sum of
# the proofs that are still unspent, and every period's cost is a row in its
# usage table. Printed as the object the widget wants, or nothing at all when
# that machine has no wallet, which is how "not this one" is said.
wallet_json() {
  w=$(ssh -o BatchMode=yes -o ConnectTimeout=8 -o LogLevel=ERROR \
          -o ControlPath=none -o StrictHostKeyChecking=accept-new \
          "$1" 'sh -s' 2>/dev/null <<'WALLET'
D=''
D=$HOME/.routstrd
[ -d "$D" ] || exit 3
[ -n "$D" ] || exit 3
W=$D/wallet/coco.db
R=$D/routstr.db
[ -r "$W" ] || exit 3
b=$(sqlite3 -readonly "$W" "select coalesce(sum(amount),0) from coco_cashu_proofs where state='ready'" 2>/dev/null)
case "$b" in ''|*[!0-9]*) exit 3 ;; esac
n=$(date +%s)
d0=$(date -d 'today 00:00' +%s)
a=''
if [ -r "$R" ]; then
  a=$(sqlite3 -readonly "$R" -separator ' ' "select coalesce(round(sum(sats_cost)),0), count(*),
        coalesce(round(sum(case when timestamp >= ($n-86400)*1000 then sats_cost end)),0),
        coalesce(round(sum(case when timestamp >= ($n-604800)*1000 then sats_cost end)),0),
        coalesce(round(sum(case when timestamp >= ($n-2592000)*1000 then sats_cost end)),0),
        coalesce(round(sum(case when timestamp >= $d0*1000 then sats_cost end)),0)
        from usage_tracking" 2>/dev/null)
fi
set -- $a
printf '{"balance":%s,"req":%s,"dall":%s,"d24":%s,"d7":%s,"d30":%s,"dday":%s}\n' \
  "$b" "${2:-0}" "${1:-0}" "${3:-0}" "${4:-0}" "${5:-0}" "${6:-0}"
WALLET
)
  [ -n "$w" ] || return 0
  printf '%s' "$w" | jq -c --arg host "$1" --arg url "$url" --arg provider "$provider" \
      --arg model "$pmodel" --arg topup "$topup" \
      'select(.ok != 0) | . + {ok:1, why:"", code:200, where:"wallet", reserved:0,
         first:0, n:0, daybase:1, host:$host, url:$url, provider:$provider,
         model:$model, topup:$topup}' 2>/dev/null
}

# paid.json is only a note of where the node is: opencode's own provider holds
# the same key, so a working opencode setup counts as a working setup here and
# the card only has to be filled in when opencode has nothing either.
#
# Asked first of opencode itself: a provider added in its own UI, or one whose
# key lives in a stored credential, never reaches opencode.json, so the file
# alone is not the truth about what opencode is using. Only while its server is
# up: `opencode api` waits for one that is not, so a closed opencode would cost
# the whole timeout on every poll.
#
# Which provider is the paid one: any provider opencode has that is not its own
# free tier. Nothing here looks for a name or a vendor, so any node that speaks
# the same balance API counts.
#
# A node that keeps its own wallet has no balance endpoint at all; its books are
# sqlite files on its machine, so those are read over the same ssh. That path is
# the better one where it exists, since a wallet knows what each period cost
# instead of leaving the windows to samples taken here.
oclive=0
if command -v opencode >/dev/null 2>&1 && pgrep -f 'opencode.*serve' >/dev/null 2>&1; then
  oclive=1
fi
cands=$HOME/.cache/opencode-burn/paid-cands
mkdir -p "$(dirname "$cands")"
: > "$cands"

if [ -z "$url" ] && [ "$oclive" -eq 1 ]; then
  sess=$(timeout 6 opencode api GET '/api/session?order=desc&limit=30' 2>/dev/null)
  printf '%s' "${sess:-}" | jq -e '.data' >/dev/null 2>&1 || sess=''
  timeout 8 opencode api GET /api/provider 2>/dev/null \
    | jq -r '.data[]?
        | select(((.id // "") != "opencode")
            and ((((.settings.baseURL // "") | ascii_downcase) | test("opencode\\.ai")) | not))
        | [(.id // ""), (.settings.baseURL // ""),
           ((.settings.apiKey // "") | if type == "string" then . else "" end)] | @tsv' 2>/dev/null \
    | while IFS="$(printf '\t')" read -r pid purl pkey; do
        [ -n "$purl" ] || continue
        pm=''
        if [ -n "$sess" ]; then
          pm=$(printf '%s' "$sess" | jq -r --arg p "$pid" \
            '[.data[]? | .model | select((.providerID // "") == $p) | .id][0] // empty' 2>/dev/null)
        fi
        printf '%s\t%s\t%s\t%s\n' "$pid" "$purl" "$pkey" "$pm" >> "$cands"
      done
fi

# then its config file, for when its own API is not answering
if [ -z "$url" ] && [ -r "$ocfg" ]; then
  jq -r "$prov_jq" "$ocfg" 2>/dev/null >> "$cands"
fi

# then a device on the tailnet, read over the same ssh the usage side uses.
# Cached for ten minutes, so an offline machine costs one attempt, not one a
# minute. One call per device asks for both things: the ssh user's own opencode
# config, so no other account's settings are read, and whether that user keeps
# a wallet, which is the answer when the config names no node at all.
rcache=$HOME/.cache/opencode-burn/paid-scan.json
whost=''
if [ -z "$url" ] && [ ! -s "$cands" ] && [ -r "$HOME/.config/opencode-burn/remote" ]; then
  if [ ! -r "$rcache" ] || [ $(( $(date +%s) - $(stat -c %Y "$rcache" 2>/dev/null || echo 0) )) -gt 600 ]; then
    mkdir -p "$(dirname "$rcache")"
    : > "$rcache"
    while read -r rh rest; do
      case "$rh" in ''|'#'*) continue ;; esac
      rout=$(timeout 12 ssh -n -o BatchMode=yes -o ConnectTimeout=4 -o LogLevel=ERROR \
               -o ControlPath=none "$rh" 'f="$HOME/.config/opencode/opencode.json"
                 [ -r "$f" ] && cat "$f" 2>/dev/null
                 [ -d "$HOME/.routstrd" ] && echo "@@wallet@@"
                 exit 0' </dev/null 2>/dev/null)
      [ -n "$rout" ] || continue
      rwallet=0
      case "$rout" in *@@wallet@@*) rwallet=1 ;; esac
      rj=$(printf '%s\n' "$rout" | sed '/^@@wallet@@$/d')
      pv=$(printf '%s' "$rj" | jq -r "$prov_jq" 2>/dev/null | head -1)
      [ -n "$pv" ] || [ "$rwallet" -eq 1 ] || continue
      # one line per device: host, then the provider's four fields, then
      # whether that device keeps a wallet
      printf '%s\t%s\t%s\n' "$rh" "$pv" "$rwallet" > "$rcache"
      break
    done < "$HOME/.config/opencode-burn/remote"
  fi
  if [ -s "$rcache" ]; then
    rline=$(cat "$rcache")
    rh=$(printf '%s' "$rline" | cut -f1)
    rp=$(printf '%s' "$rline" | cut -f2); ru=$(printf '%s' "$rline" | cut -f3)
    rk=$(printf '%s' "$rline" | cut -f4); rmo=$(printf '%s' "$rline" | cut -f5)
    rw=$(printf '%s' "$rline" | cut -f6)
    if [ -n "$rp" ] && [ -n "$ru" ]; then
      # a node on that machine's own loopback has to be asked there
      case "$ru" in *127.0.0.1*|*localhost*) [ -n "$host" ] || host=$rh ;; esac
      printf '%s\t%s\t%s\t%s\n' "$rp" "$ru" "$rk" "$rmo" >> "$cands"
    fi
    [ "$rw" = 1 ] && whost=$rh
  fi
fi

# the first provider whose own balance endpoint answers is the paid one: that
# is what this meter needs, and it needs no name to find it. Failing all of
# them, the first stays, so the switch and the error both have a subject.
if [ -z "$url" ] && [ -s "$cands" ]; then
  pick=''
  while IFS="$(printf '\t')" read -r cpid cu ckey cmdl; do
    [ -n "$cu" ] || continue
    [ -n "$pick" ] || pick=$(printf '%s\t%s\t%s\t%s' "$cpid" "$cu" "$ckey" "$cmdl")
    # a loopback address on the machine this widget runs on is right here; one
    # on another machine is asked over ssh, which the pick cannot do
    case "$cu" in *127.0.0.1*|*localhost*) [ -n "$host" ] && continue ;; esac
    probeu=$(printf %s "$cu" | sed 's:/$::')
    case "$probeu" in */v1) ;; *) probeu=$probeu/v1 ;; esac
    pcfg=''
    if [ -n "$ckey" ]; then
      pcfg=$(mktemp); chmod 600 "$pcfg"
      printf 'header = "Authorization: Bearer %s"\n' "$ckey" > "$pcfg"
      pcode=$(curl -sS -m 6 -o /dev/null -w '%{http_code}' -K "$pcfg" \
                "$probeu/balance/info" </dev/null 2>/dev/null)
    else
      pcode=$(curl -sS -m 6 -o /dev/null -w '%{http_code}' "$probeu/balance/info" </dev/null 2>/dev/null)
    fi
    # routstrd 0.5 dropped /v1/balance/info and answers /balance under its
    # root instead, so a node of either age counts as the paid one
    if [ "$pcode" != 200 ]; then
      pbase=$(printf %s "$probeu" | sed 's:/v1$::')
      if [ -n "$ckey" ]; then
        pcode=$(curl -sS -m 6 -o /dev/null -w '%{http_code}' -K "$pcfg" \
                  "$pbase/balance" </dev/null 2>/dev/null)
      else
        pcode=$(curl -sS -m 6 -o /dev/null -w '%{http_code}' "$pbase/balance" </dev/null 2>/dev/null)
      fi
    fi
    [ -n "$pcfg" ] && rm -f "$pcfg"
    if [ "$pcode" = 200 ]; then
      pick=$(printf '%s\t%s\t%s\t%s' "$cpid" "$cu" "$ckey" "$cmdl")
      break
    fi
  done < "$cands"
  [ -n "$provider" ] || provider=$(printf '%s' "$pick" | cut -f1)
  [ -n "$url" ] || url=$(printf '%s' "$pick" | cut -f2)
  [ -n "$key" ] || key=$(printf '%s' "$pick" | cut -f3)
  [ -n "$pmodel" ] || pmodel=$(printf '%s' "$pick" | cut -f4)
fi

# a device that keeps its own wallet needs no endpoint at all, and its periods
# are what was really spent rather than what was sampled here
if [ -n "$whost" ]; then
  w=$(wallet_json "$whost")
  [ -z "$w" ] || { printf '%s\n' "$w"; exit 0; }
fi

# a key with no address anywhere still has somewhere to go
if [ -z "$url" ] && [ -n "$key" ]; then url=https://api.routstr.com/v1; fi
# forgive a URL typed without the OpenAI path
url=$(printf %s "$url" | sed 's:/$::')
[ -n "$url" ] || { echo '{"ok":0,"why":"setup"}'; exit 0; }
case "$url" in */v1) ;; *) url=$url/v1 ;; esac
# routstrd 0.5 moved its books from the OpenAI path to the node's root
base=$(printf %s "$url" | sed 's:/v1$::')

say() {
  c=$2; [ -n "$c" ] || c=0
  jq -nc --arg why "$1" --argjson code "$c" --arg host "$host" --arg url "$url" \
     --arg provider "$provider" --arg model "$pmodel" --arg topup "$topup" \
     '{ok:0, why:$why, code:$code, host:$host, url:$url, provider:$provider,
       model:$model, topup:$topup}'
}

if [ -z "$key" ] && [ -n "$keyfile" ]; then
  key=$(cat "$keyfile" 2>/dev/null | tr -d '\r\n')
fi
# opencode names a key by file rather than holding it: {file:/path}. A path
# written with ~ is this home, since cat would take the tilde literally.
case "$key" in
  '{file:'*)
    kf=$(printf '%s' "$key" | sed 's/^{file://; s/}$//')
    case "$kf" in '~/'*) kf="$HOME/$(printf '%s' "$kf" | cut -c3-)" ;; esac
    key=$(cat "$kf" 2>/dev/null | tr -d '\r\n') ;;
esac

# the conversation with the node is one script, so a node reached over ssh is
# asked in the same words as one on this machine's own loopback
node=$(mktemp)
cat > "$node" <<'NODE'
base=$1; url=$2; unit=$3; kf=$4
# the key arrives in a 0600 file and reaches curl through a 0600 config, so no
# command line ever carries it and ps shows it to nobody
key=$(cat "$kf" 2>/dev/null | tr -d '\r\n')
hdr=$(mktemp); chmod 600 "$hdr"
trap 'rm -f "$hdr"' EXIT
[ -n "$key" ] && printf 'header = "Authorization: Bearer %s"\n' "$key" > "$hdr"
now=$(date +%s); d0=$(date -d 'today 00:00' +%s)
get() { curl -sS -m 20 -K "$hdr" "$1" 2>/dev/null; }
getc() { curl -sS -m 30 -w '\n%{http_code}' -K "$hdr" "$1" 2>/dev/null; }

# routstrd 0.5 and later: /balance holds one balance per mint, in sats, and
# /usage is one row per request with the timestamp and what it cost. That is
# better than sampling here, since the node counts every client using the key.
b=$(get "$base/balance")
if printf '%s' "$b" | jq -e '(.output.balances | type) == "object"' >/dev/null 2>&1; then
  bal=$(printf '%s' "$b" | jq -r '[.output.balances[]?] | add // 0')
  bu=$(printf '%s' "$b" | jq -r '.output.unit // "sat"')
  case "$bu" in
    msat*) bal=$(awk -v x="$bal" 'BEGIN{printf "%d", (x+500)/1000}') ;;
    *)     bal=$(awk -v x="$bal" 'BEGIN{printf "%d", x+0.5}') ;;
  esac
  # the rows go through a file, not an argument: a month of requests is more
  # than one argument may carry, and the kernel refuses past 128 KB
  rf=$(mktemp)
  uc=$(getc "$base/usage?limit=10000")
  ucode=$(printf '%s' "$uc" | tail -1 | tr -dc '0-9')
  ubody=$(printf '%s' "$uc" | sed '$d')
  case "$ucode" in
    200) ;;
    401|403) rm -f "$rf"; printf '{"ok":0,"why":"auth","code":%s}\n' "$ucode"; exit 0 ;;
    *) rm -f "$rf"; printf '{"ok":0,"why":"unreachable","code":0}\n'; exit 0 ;;
  esac
  # a balance with no readable books is not a node this screen can draw: say
  # so, rather than showing a quiet day made of zeros
  printf '%s' "$ubody" | jq -e '(.output | type) == "array"' >/dev/null 2>&1 \
    || { rm -f "$rf"; printf '{"ok":0,"why":"bad","code":200}\n'; exit 0; }
  printf '%s' "$ubody" | jq -c '
    [.output[]? | {t: ((.timestamp / 1000) | floor),
                   s: (.satsCost // ((.totalMsats // 0) / 1000)),
                   m: (.modelId // ""), k: (.totalTokens // 0),
                   p: (.provider // "")}]' > "$rf" 2>/dev/null \
    || { rm -f "$rf"; printf '{"ok":0,"why":"bad","code":200}\n'; exit 0; }
  jq -cn --argjson now "$now" --argjson d0 "$d0" --argjson bal "$bal" \
        --slurpfile rr "$rf" '
    # one window of the books: its requests, sats and tokens
    def win($rs; $f):
      {req: ([$rs[] | select(.t >= $f)] | length),
       s: (([$rs[] | select(.t >= $f) | .s] | add // 0) | round),
       tok: ([$rs[] | select(.t >= $f) | .k] | add // 0)};
    # and the same window drawn: $n bars of $step seconds from $f
    def buckets($rs; $f; $n; $step):
      [range(0; $n) as $i
       | (([$rs[] | select((((.t - $f) / $step) | floor) == $i) | .s]
           | add // 0) | round)];

    ($now - 86400) as $f24
    | ($now - 604800) as $f7
    | ($now - 2592000) as $f30
    | ($d0 - 518400) as $d7f
    | ($d0 - 2505600) as $d30f
    # all time, day by day from the first request to today, so the chart has a
    # bar for every day the key has ever spent on
    | (([$rr[0][].t] | min) // $d0) as $ft
    | (($d0 - $ft) / 86400 | ceil) as $nk
    | ($d0 - ($nk * 86400)) as $dallf
    | ($nk + 1) as $ndall
    | ($rr[0] // []) as $r
    | ($r | map(select(.t >= $d0))) as $td
    | {ok:1, why:"", code:200, sampled:1, balance:$bal, reserved:0,
       req: ($r | length), n: ($r | length),
       d24: ((win($r; $f24)).s), d7: ((win($r; $f7)).s),
       d30: ((win($r; $f30)).s), dday: ((win($td; 0)).s),
       dall: (([$r[].s] | add // 0) | round),
       r24: ((win($r; $f24)).req), r7: ((win($r; $f7)).req),
       r30: ((win($r; $f30)).req),
       first: ($ft | floor), daybase: 1,
       d7f: $d7f, d30f: $d30f, dallf: $dallf,
       todayReq: ($td | length),
       series: {h24: buckets($r; $f24; 24; 3600),
                d7: buckets($r; $d7f; 7; 86400),
                d30: buckets($r; $d30f; 30; 86400),
                dall: buckets($r; $dallf; $ndall; 86400)},
       # every model the key has used, with each window and its share of the
       # upstreams that served it, so the list is the same list at every range
       models: ($r | group_by(.m) | map(
         . as $rs
         | win($rs; $f24) as $w24
         | win($rs; $f7) as $w7
         | win($rs; $f30) as $w30
         | win($rs; 0) as $wa
         | ($rs | map(select(.t >= $d0))) as $md
         | ($rs | group_by(.p) | map({p: (.[0].p // ""), n: length})
            | sort_by(-.n)) as $pp
         | {m: $rs[0].m, p: ($pp[0].p // ""), pn: ($pp | length),
            req: ($md | length), s: (([$md[].s] | add // 0) | round),
            tok: ([$md[].k] | add // 0),
            slots: [range(0; 24) as $h
                    | (([$md[] | select((((.t / 3600) | floor)
                                        - (($d0 / 3600) | floor)) == $h) | .s]
                        | add // 0) | round)],
            b24: buckets($rs; $f24; 24; 3600),
            b7: buckets($rs; $d7f; 7; 86400),
            b30: buckets($rs; $d30f; 30; 86400),
            ball: buckets($rs; $dallf; $ndall; 86400),
            s24: $w24.s, r24: $w24.req, k24: $w24.tok,
            s7: $w7.s, r7: $w7.req, k7: $w7.tok,
            s30: $w30.s, r30: $w30.req, k30: $w30.tok,
            sall: $wa.s, rall: $wa.req, kall: $wa.tok})
         | sort_by(-.rall))}'
  rm -f "$rf"
  exit 0
fi

# an older node answers its whole book at /v1/balance/info, in msats
res=$(getc "$url/balance/info")
code=$(printf '%s' "$res" | tail -1 | tr -dc '0-9')
body=$(printf '%s' "$res" | sed '$d')
case "$code" in
  200) ;;
  401|403) printf '{"ok":0,"why":"auth","code":%s}\n' "$code"; exit 0 ;;
  000|'') printf '{"ok":0,"why":"unreachable","code":0}\n'; exit 0 ;;
  *) printf '{"ok":0,"why":"http","code":%s}\n' "$code"; exit 0 ;;
esac
printf '%s' "$body" | jq -e 'has("balance")' >/dev/null 2>&1 \
  || { printf '{"ok":0,"why":"bad","code":200}\n'; exit 0; }
b2=$(printf '%s' "$body" | jq -r '.balance // 0')
rsv=$(printf '%s' "$body" | jq -r '.reserved // 0')
sp=$(printf '%s' "$body" | jq -r '.total_spent // 0')
rq=$(printf '%s' "$body" | jq -r '.total_requests // 0')
case "$unit" in
  msat*) b2=$(awk -v x="$b2" 'BEGIN{printf "%d", (x+500)/1000}')
         rsv=$(awk -v x="$rsv" 'BEGIN{printf "%d", (x+500)/1000}')
         sp=$(awk -v x="$sp" 'BEGIN{printf "%d", (x+500)/1000}') ;;
esac
jq -nc --argjson bal "$b2" --argjson rsv "$rsv" --argjson rq "$rq" --argjson sp "$sp" \
  '{ok:1, why:"", code:200, sampled:0, balance:$bal, reserved:$rsv, req:$rq,
    d24:0, d7:0, d30:0, dday:0, dall:$sp, first:0, n:0, daybase:0}'
NODE

res=''; rc=0; where=local
if [ -n "$host" ]; then
  where=ssh
  # the key is the first line of stdin, ahead of the script, and the far side
  # writes it to a 0600 file: neither machine's command line carries it
  res=$( { printf '%s\n%s\n%s\n%s\n' "$key" "$base" "$url" "$unit"; cat "$node"; } \
    | ssh -o BatchMode=yes -o ConnectTimeout=8 -o LogLevel=ERROR \
        -o ControlPath=none -o StrictHostKeyChecking=accept-new \
        "$host" 'umask 077; kf=$(mktemp); read -r k; read -r b; read -r u; read -r n; printf %s "$k" > "$kf"; f=$(mktemp); cat > "$f"; sh "$f" "$b" "$u" "$n" "$kf"; rc=$?; rm -f "$f" "$kf"; exit $rc' 2>&1 ); rc=$?
else
  kf=$(mktemp); chmod 600 "$kf"; printf '%s' "$key" > "$kf"
  res=$(sh "$node" "$base" "$url" "$unit" "$kf" 2>&1); rc=$?
  rm -f "$kf"
fi
rm -f "$node"

[ "$rc" -eq 255 ] && { say ssh 0; exit 0; }
printf '%s' "$res" | jq -e 'type == "object"' >/dev/null 2>&1 || { say bad 0; exit 0; }

# a node that would not answer: the why it gave is kept, and the address it was
# asked at is added, so the card can say which machine went quiet
if [ "$(printf '%s' "$res" | jq -r '.ok // 0')" != 1 ]; then
  # an address that answers without a balance API may still be a node whose
  # books sit on the machine itself, so ask that before giving up on it
  if [ -n "$host" ] && [ "$(printf '%s' "$res" | jq -r '.why // ""')" = http ]; then
    w=$(wallet_json "$host")
    [ -z "$w" ] || { printf '%s\n' "$w"; exit 0; }
  fi
  printf '%s' "$res" | jq -c --arg host "$host" --arg url "$url" \
    --arg provider "$provider" --arg model "$pmodel" --arg topup "$topup" \
    --arg where "$where" \
    '. + {host:$host, url:$url, provider:$provider, model:$model, topup:$topup,
          where:$where}'
  exit 0
fi

if [ "$(printf '%s' "$res" | jq -r '.sampled // 0')" = 1 ]; then
  printf '%s' "$res" | jq -c --arg host "$host" --arg url "$url" \
    --arg provider "$provider" --arg model "$pmodel" --arg topup "$topup" \
    --arg where "$where" \
    'del(.sampled) + {host:$host, url:$url, provider:$provider, model:$model,
      topup:$topup, where:$where}'
  exit 0
fi

# an older node knows its lifetime spend but not each window, so the samples
# taken here are what make today, 24h, 7d and 30d: the spend between the last
# sample at or before the window's start and now.
now=$(date +%s); day=$(date -d 'today 00:00' +%s)
sp=$(printf '%s' "$res" | jq -r '.dall // 0')
mkdir -p "$(dirname "$hist")"
printf '%s\t%s\t%s\n' "$now" "$sp" "$(printf '%s' "$res" | jq -r '.balance // 0')" >> "$hist"
awk -v cut=$((now-3456000)) -F'\t' '$1>=cut' "$hist" > "$hist.n" 2>/dev/null \
  && mv "$hist.n" "$hist"

agg=$(awk -F'\t' -v now="$now" -v day="$day" -v cur="$sp" '
  function idx(T,   i,r){ r=0; for(i=1;i<=n;i++) if(ts[i]<=T) r=i; return r }
  function dl(T,   i,v){ i=idx(T); v=(i==0)?cur-sp[1]:cur-sp[i]; return v>0?v:0 }
  { ts[NR]=$1; sp[NR]=$2 }
  END {
    n=NR
    printf "{\"d24\":%d,\"d7\":%d,\"d30\":%d,\"dday\":%d,\"first\":%d,\"n\":%d,\"daybase\":%d}", dl(now-86400), dl(now-604800), dl(now-2592000), dl(day), ts[1], n, (idx(day)>0)
  }' "$hist" 2>/dev/null)
[ -n "$agg" ] || agg='{"d24":0,"d7":0,"d30":0,"dday":0,"first":0,"n":0,"daybase":0}'

printf '%s' "$res" | jq -c --argjson agg "$agg" --arg host "$host" --arg url "$url" \
  --arg provider "$provider" --arg model "$pmodel" --arg topup "$topup" \
  --arg where "$where" \
  'del(.sampled) + $agg + {host:$host, url:$url, provider:$provider, model:$model,
    topup:$topup, where:$where}'
""") every 5m json timeout 120s

  // ---- what sats are worth, in the currency picked in settings ---------
  source rates = cmd("""
#!/bin/sh
# opencode-burn: BTC in the currencies the widget can show. Cached for 15
# minutes; if the call fails the last good rates are still used, so a tile that
# was showing pounds keeps showing pounds when the network is down.
cache=$HOME/.cache/opencode-burn-rates.json
now=$(date +%s)
fresh=0
if [ -r "$cache" ]; then
  ts=$(jq -r '.ts // 0' "$cache" 2>/dev/null)
  case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
  [ $((now-ts)) -lt 900 ] && fresh=1
fi
if [ $fresh -eq 0 ]; then
  got=$(curl -sf --max-time 12 'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=gbp,usd,eur' 2>/dev/null)
  if [ -n "$got" ]; then
    gbp=$(printf %s "$got" | jq -r '.bitcoin.gbp // 0' 2>/dev/null)
    usd=$(printf %s "$got" | jq -r '.bitcoin.usd // 0' 2>/dev/null)
    eur=$(printf %s "$got" | jq -r '.bitcoin.eur // 0' 2>/dev/null)
    if [ "$gbp" != 0 ] && [ "$gbp" != null ]; then
      jq -nc --argjson g "$gbp" --argjson u "$usd" --argjson e "$eur" --argjson ts "$now" \
        '{ok:1, ts:$ts, btc:{gbp:$g, usd:$u, eur:$e}}' > "$cache" 2>/dev/null
      fresh=1
    fi
  fi
fi
if [ -r "$cache" ]; then cat "$cache"; else echo '{"ok":0,"ts":0,"btc":{}}'; fi
""") every 15m json timeout 30s

  // the clock only drives countdowns and the pace, which move in minutes, so
  // five seconds does what one did at a fifth of the wakeups
  source now = clock every 5s


  // ---- pace -----------------------------------------------------------
  let dayFrac = (now - db.day) / max(1, db.end - db.day)
  // what the other machine reported, if it answered
  // the remote source is plain json, so it is already the parsed object;
  // it reads as null until its first run, hence the empty stand-in
  let rdb = remote == null ? {ok: false, devices: []} : remote
  let rrows = rdb != null && rdb.ok ? rdb.models ?? [] : []
  let rLive = rdb != null && rdb.ok

  // the two sides added together per model: the quota is per account, so the
  // day is only the day once both machines are in it. Both are assumed to share
  // a timezone, or the midnight boundary would differ by an hour.
  let lrows = db.models ?? []
  let rows = unique(lrows.map(r => r.m) + rrows.map(r => r.m)).map(m => ({
    m: m,
    used: (lrows.find(r => r.m == m).used ?? 0) + (rrows.find(r => r.m == m).used ?? 0),
    tok: (lrows.find(r => r.m == m).tok ?? 0) + (rrows.find(r => r.m == m).tok ?? 0),
    r1h: (lrows.find(r => r.m == m).r1h ?? 0) + (rrows.find(r => r.m == m).r1h ?? 0),
    r5h: (lrows.find(r => r.m == m).r5h ?? 0) + (rrows.find(r => r.m == m).r5h ?? 0),
    slots: range(24).map(i => ((lrows.find(r => r.m == m).slots ?? [])[i] ?? 0)
                            + ((rrows.find(r => r.m == m).slots ?? [])[i] ?? 0))
  }))
  let phoneUsed = sum(lrows.map(r => r.used))
  let deskUsed = sum(rrows.map(r => r.used))
  // "in use" means the newest request seen anywhere, so what is running here
  // is not used on its own any more
  // whichever asked last is the one in use, rather than simply preferring the
  // remote, which would win all day for having done anything at all
  let curModel = (rdb.currentAt ?? 0) > (db.currentAt ?? 0) ? rdb.current ?? db.current : db.current

  // the remote's silence, aged: it is either answering, or it is not, and the
  // tile should keep saying so rather than quietly showing half the picture
  every 60s { deskSeen = rLive ? now : deskSeen }
  let deskAge = deskSeen > 0 ? now - deskSeen : null
  let deskStale = deskAge == null || deskAge > 300
  let deskFlag = deskSeen == 0 ? "remote never seen"
    : deskStale ? "remote ${fmtDuration(deskAge)} ago"
    : "remote live"
  // the last lineup that worked, so a failed fetch or an offline machine still
  // shows what is free instead of an empty list
  // the free lineup is what the pacing is measured against; the whole
  // catalogue is what you can browse
  let freeIds = zen.ok ? zen.out.filter(z => z.free).map(z => z.id) : seenLineup
  let allIds = zen.ok ? zen.out.map(z => z.id) : seenLineup
  let live = freeIds

  // ---- paid: the node's own numbers ------------------------------------
  // The node is the truth for money. It knows the key's balance and its
  // lifetime spend, and it counts every client using that key, so this is
  // wider than opencode without reading anyone else's logs.
  let pr = paid == null ? {ok: false, why: "setup"} : paid
  let paidOn = pr.ok == 1
  let paidWhy = paidOn ? "" : (pr.why ?? "setup")
  let bal = pr.balance ?? 0
  let reserved = pr.reserved ?? 0
  let spendToday = pr.dday ?? 0
  let spend24 = pr.d24 ?? 0
  let spend7 = pr.d7 ?? 0
  let spend30 = pr.d30 ?? 0
  let spendAll = pr.dall ?? 0
  let paidHost = pr.host ?? ""
  let paidUrl = pr.url ?? ""
  let paidProvider = pr.provider ?? ""
  let paidUrlClean = replace(replace(paidUrl, "https://", ""), "http://", "")
  let paidWhereTxt = paidHost != "" ? paidHost : split(paidUrlClean, "/")[0]
  let paidErrTxt = paidWhy == "setup" ? "not set up"
    : paidWhy == "auth" ? "That key was refused."
    : paidWhy == "ssh" ? "Can't reach ${paidHost}. Check that the machine is on and the name is right."
    : paidWhy == "nohostkey" ? "There is no key at that path on ${paidHost}."
    : paidWhy == "unreachable" ? "The provider is offline, or the address does not answer."
    : paidWhy == "http" ? (pr.code == 404 || pr.code == 405
        ? "That address answers, but has no balance API."
      : "The provider answered with error ${pr.code}.")
    : "The provider answered, but not with a balance."
  let paidLowHit = paidOn && bal < paidLow
  // the share of the money that is still in the key, against the fullest the
  // key has been since it was linked: a top-up fills the rim, spending drains
  // it, and a reload does not invent a new level
  let paidFrac = paidOn ? clamp(bal / max(1, paidPeak), 0, 1) : 0

  // a model that is neither free now nor in the remembered lineup is one that
  // costs money. The free quota ring never counts these, which is why a day of
  // paid work does not eat the free allowance.
  let paidIds = unique(rows.map(r => r.m)).filter(id => freeIds.indexOf(id) < 0
    && seenLineup.indexOf(id) < 0)
  let paidTok = sum(rows.filter(r => paidIds.indexOf(r.m) >= 0).map(r => r.tok))
  // the model in use decides which side the dial reads, and it counts even
  // before it has spent anything today: a model the free lineup does not know
  // is one you pay for, and the number should say so the moment you switch
  let paidNow = paidOn && curModel != ""
    && (paidIds.indexOf(curModel) >= 0
        || (freeIds.indexOf(curModel) < 0 && seenLineup.indexOf(curModel) < 0))

  // sats are the truth; the currency only changes the skin, at the rate the
  // last rates call returned. 1 BTC is 100,000,000 sats.
  let rr = rates == null ? {ok: false, ts: 0, btc: {}} : rates
  let ratesOk = rr.ok == 1
  let ratesAge = (rr.ts ?? 0) > 0 ? now - rr.ts : null
  let fx = currency == "sat" ? 0 : get(rr.btc ?? {}, currency, 0) / 100000000
  let satCur = currency == "sat"
  let curSym = satCur ? "" : currency == "gbp" ? "£" : currency == "usd" ? "$" : "€"
  let curCode = satCur ? "sats" : upper(currency)
  let noRate = !satCur && (!ratesOk || fx <= 0)
  let balShow = bal * fx
  let todayShow = spendToday * fx
  let winSats = spendRange == "24h" ? spend24
    : spendRange == "7d" ? spend7
    : spendRange == "30d" ? spend30 : spendAll
  let winShow = winSats * fx
  let balTxt = satCur ? fmtNum(bal) : "${curSym}${fmtNum(balShow, 2)}"
  let todayTxt = satCur ? "${fmtNum(spendToday)}" : "${curSym}${fmtNum(todayShow, 2)}"
  let winTxt = satCur ? "${fmtNum(winSats)}" : "${curSym}${fmtNum(winShow, 2)}"

  // the paid day, as the node's own books have it: what today cost and which
  // models it went to. The node keeps a row per request, so this is the same
  // picture the free side draws from opencode's database, and the two days read
  // alike when you switch between them
  // the paid chart stacks the same model slices the list below names, so its
  // legend is the paid answer to the free screen's machine legend
  let paidPalette = ["#7aa2f7", "#e0af68", "#80f872", "#bb9af7", "#7dcfff"]
  let paidModels = (pr.models ?? [])
    .map((m, i) => ({m: m.m, p: m.p, pn: m.pn,
      short: split(m.m, "-")[0], ink: paidPalette[i % len(paidPalette)],
      sats: spendRange == "24h" ? (m.s24 ?? 0)
        : spendRange == "7d" ? (m.s7 ?? 0)
        : spendRange == "30d" ? (m.s30 ?? 0) : (m.sall ?? 0),
      req: spendRange == "24h" ? (m.r24 ?? 0)
        : spendRange == "7d" ? (m.r7 ?? 0)
        : spendRange == "30d" ? (m.r30 ?? 0) : (m.rall ?? 0),
      tok: spendRange == "24h" ? (m.k24 ?? 0)
        : spendRange == "7d" ? (m.k7 ?? 0)
        : spendRange == "30d" ? (m.k30 ?? 0) : (m.kall ?? 0),
      slots: spendRange == "24h" ? (m.b24 ?? [])
        : spendRange == "7d" ? (m.b7 ?? [])
        : spendRange == "30d" ? (m.b30 ?? []) : (m.ball ?? [])}))
    .filter(m => (m.req ?? 0) > 0 || (m.sats ?? 0) > 0)
    .sortBy(m => -m.sats)
  let paidWinTotal = max(1, sum(paidModels.map(m => m.sats ?? 0)))
  let winReq = spendRange == "24h" ? (pr.r24 ?? 0)
    : spendRange == "7d" ? (pr.r7 ?? 0)
    : spendRange == "30d" ? (pr.r30 ?? 0) : (pr.req ?? 0)
  // the chart is the same window as the pills: hours for a day, days for the
  // rest, so switching the range redraws the picture, not just the total
  let paidSeries = spendRange == "24h" ? ((pr.series ?? {}).h24 ?? [])
    : spendRange == "7d" ? ((pr.series ?? {}).d7 ?? [])
    : spendRange == "30d" ? ((pr.series ?? {}).d30 ?? [])
    : ((pr.series ?? {}).dall ?? [])
  let paidSeriesMax = max(1, paidSeries.sortBy(v => -v).first() ?? 1)
  let paidProvTxt = paidProvider != "" ? paidProvider : paidWhereTxt

  // NEW means it turned up in the lineup since the last time the widget looked,
// and you have never run it. The first lineup after installing the widget is
// the baseline, so nothing is flagged new on day one, and the lineup is folded
// in on the same clock it refreshes on
  let fresh = lineupBoot ? live.filter(id => seenLineup.indexOf(id) < 0) : []
  every 30m {
    // a remembered lineup only keeps models that are still free or that you
    // have actually run today. without the prune a model dropped from the
    // free tier would sit in the remembered list for good, and reappear
    // whenever the catalogue could not be fetched
    seenLineup = lineupBoot
      ? unique(seenLineup + live).filter(id => live.indexOf(id) >= 0
                                              || (rows.find(r => r.m == id).used ?? 0) > 0)
      : live
    lineupBoot = true
  }

  // every model worth listing: the free lineup or the whole catalogue.
  // the free view lists only what is free right now, so a model dropped from
  // the free tier leaves it even if you have run it today; it is still under
  // "all", where its usage and its price belong
  let ids = unique(showAll ? (allIds + rows.map(r => r.m)) : freeIds)
  let models = ids.map(id => ({
    id: id,
    name: replace(id, "-free", ""),
    rank: ids.indexOf(id),
    used: rows.find(r => r.m == id).used ?? 0,
    tok: rows.find(r => r.m == id).tok ?? 0,
    r1h: rows.find(r => r.m == id).r1h ?? 0,
    r5h: rows.find(r => r.m == id).r5h ?? 0,
    slots: rows.find(r => r.m == id).slots ?? [],
    // the same hours, kept apart so the chart can show where they were spent
    pSlots: lrows.find(r => r.m == id).slots ?? [],
    dSlots: rrows.find(r => r.m == id).slots ?? [],
    cap: get(capOverrides, id, dailyCap),
    win: get(winOverrides, id, winCap),
    isLive: live.indexOf(id) >= 0,
    // free models are paced against the daily cap; paid ones have a price.
    // the price check is repeated here because the fallback lineup (when the
    // catalogue cannot be fetched) is a remembered list that may still hold a
    // model the free tier has since dropped
    isFree: freeIds.indexOf(id) >= 0 && (!zen.ok
            || ((zen.out.find(z => z.id == id).costIn ?? 0) == 0
             && (zen.out.find(z => z.id == id).costOut ?? 0) == 0)),
    isUnlimited: unlimited.indexOf(id) >= 0,
    price: zen.ok ? join([zen.out.find(z => z.id == id).costIn, zen.out.find(z => z.id == id).costOut]
                        .filter(c => c != null).map(c => fixed(c, 2)), " / ") : "",
    isNew: live.indexOf(id) >= 0 && fresh.indexOf(id) >= 0 && (rows.find(r => r.m == id).used ?? 0) == 0,
    // what it can do: vision, video, reasoning, tools. kept as a list as
    // well as the display string, so the tip can compare two models'
    // capabilities rather than only their remaining budget
    tags: zen.ok ? (zen.out.find(z => z.id == id).tags ?? []) : [],
    feats: zen.ok ? join(zen.out.find(z => z.id == id).tags ?? [], " · ") : ""
  }))
  let scored = models.map(m => ({
    id: m.id, name: m.name, rank: m.rank, used: m.used, tok: m.tok, r1h: m.r1h, r5h: m.r5h, slots: m.slots, pSlots: m.pSlots, dSlots: m.dSlots, cap: m.cap,
    isLive: m.isLive, isNew: m.isNew, isCur: m.id == curModel, feats: m.feats,
    isFree: m.isFree, price: m.price, win: m.win, isUnlimited: m.isUnlimited, tags: m.tags,
    even: m.cap * dayFrac,
    left: m.cap - m.used,
    banked: m.cap * dayFrac - m.used,
    pct: m.used / max(1, m.cap) * 100,
    bankedPct: (m.cap * dayFrac - m.used) / max(1, m.cap) * 100
  }))

  // The free daily allowance is shared by every model, so the tile and the
  // chart default to this row rather than the model that asked last. Unlimited
  // models and paid models do not draw from it.
  let quotaSet = unique(rows.map(r => r.m)).filter(id => unlimited.indexOf(id) < 0
    && (freeIds.indexOf(id) >= 0 || seenLineup.indexOf(id) >= 0))
  let quotaRows = rows.filter(r => quotaSet.indexOf(r.m) >= 0)
  let totalUsed = sum(quotaRows.map(r => r.used))
  let totalTok = sum(quotaRows.map(r => r.tok))
  let totalR1h = sum(quotaRows.map(r => r.r1h))
  let totalR5h = sum(quotaRows.map(r => r.r5h))
  let totalSlots = range(24).map(i => sum(quotaRows.map(r => (r.slots ?? [])[i] ?? 0)))
  let totalPSlots = range(24).map(i => sum(lrows.filter(r => quotaSet.indexOf(r.m) >= 0).map(r => (r.slots ?? [])[i] ?? 0)))
  let totalDSlots = range(24).map(i => sum(rrows.filter(r => quotaSet.indexOf(r.m) >= 0).map(r => (r.slots ?? [])[i] ?? 0)))
  let totalCap = dailyCap
  let total = {
    id: "__all", name: "all models", used: totalUsed, tok: totalTok,
    r1h: totalR1h, r5h: totalR5h, slots: totalSlots,
    pSlots: totalPSlots, dSlots: totalDSlots, cap: totalCap, win: winCap,
    isLive: true, isNew: false, isCur: false, isFree: true, isUnlimited: false,
    isTotal: true, feats: "", price: "", tags: [],
    even: totalCap * dayFrac, left: totalCap - totalUsed,
    banked: totalCap * dayFrac - totalUsed,
    pct: totalUsed / max(1, totalCap) * 100,
    bankedPct: (totalCap * dayFrac - totalUsed) / max(1, totalCap) * 100
  }

  let cur = scored.find(m => m.id == curModel) ?? scored.find(m => m.used > 0)
  // the full mark follows the balance up and never down, so the rim drains
  // like a fuel gauge rather than snapping back on every fetch
  on paid first {
    if (value != null && (value.ok ?? 0) == 1 && (value.balance ?? 0) > paidPeak) {
      paidPeak = value.balance
    }
  }

  // total is the default; tapping a model row drills into that model
  let shown = chartFocus == "" ? total : (scored.find(m => m.id == chartFocus) ?? total)
  let shownNoLimit = shown ? shown.isUnlimited : false
  let shownRate = max(shown ? shown.r1h : 1, 1) / 3600
  let main = "#82fb9c"
  let freeInk = "#00d63c"
  let paidInk = "#f7931a"
  let warnInk = "#ff3b30"
  let fiveHour = "#ff8c42"
  let paidTone = main
  let shownTone = main
  let chartTitle = shown == null ? "no usage yet"
    : shown.isTotal ? "all models · shared daily cap" : shown.name
  // one entry per machine: this one, then every device that was asked
  let localName = dev != null && dev.model != null && dev.model != ""
    ? dev.model
    : host != null && host.name != null && host.name != "" ? host.name : "this device"
  let phoneInk = "#ff6188"
  let inks = ["#7aa2f7", "#e0af68", "#80f872", "#bb9af7", "#7dcfff"]
  let devList = rdb.devices ?? []
  // the machine the bar module is pushed to. the list at the top of this
  // screen always starts with this device, so the one after it is the first
  // entry here: whatever was pasted in first, whether or not it is answering
  let barAddr = (devList[0] ?? { addr: "" }).addr
  // one stack per machine: the whole shared quota by default, or the one model
  // the list was aimed at. The totals row counts only models that draw from it
  let series = shown == null ? [] : [{ name: localName, ink: phoneInk, ok: true,
                  used: sum(shown.pSlots ?? []), slots: shown.pSlots ?? [] }]
    + range(len(devList)).map(i => ({
        name: (devList[i].name != "" ? devList[i].name : devList[i].addr),
        ink: inks[i < len(inks) ? i : len(inks) - 1],
        ok: devList[i].ok == true,
        used: shown.isTotal
          ? sum((devList[i].models ?? []).filter(x => quotaSet.indexOf(x.m) >= 0).map(x => x.used ?? 0))
          : (((devList[i].models ?? []).find(x => x.m == shown.id) ?? {}).used ?? 0),
        slots: shown.isTotal
          ? range(24).map(j => sum((devList[i].models ?? []).filter(x => quotaSet.indexOf(x.m) >= 0).map(x => (x.slots ?? [])[j] ?? 0)))
          : (((devList[i].models ?? []).find(x => x.m == shown.id) ?? {}).slots ?? []) }))
  // the rings only ever speak for the one in use, so the rest of today needs
  // saying too: how many other models have spent something, and their share
  let otherCount = len(rows.filter(r => r.used > 0 && r.m != curModel))
  // what the little gauge is about: the model most likely to bite next, being
  // the one that has done the most today besides the one in use. Unlimited
  // models are skipped, having nothing to fill a gauge with
  // the list can be empty whenever the remote stops answering, so it is
  // indexed rather than taking the head of nothing
  let ranked_others = scored.filter(m => m.used > 0 && m.id != curModel && !m.isUnlimited)
                            .sortBy(m => -m.used)
  let runnerUp = len(ranked_others) > 0 ? ranked_others[0] : null
  let runnerPct = runnerUp ? clamp(runnerUp.pct / 100, 0, 1) : 0
  // where things stand, said the way a person would say it
  // a press wears off by itself; a link arriving clears the waiting
  at flashAt { flash = false }
  // a new day gets a clean slate, or the 90% notice would never come again
  every 60s { if db.day != saidDay { saidDay = db.day; said = [] } }
  // a machine that is asleep, or an address that does not resolve, would
  // otherwise leave the wait on screen for good
  at pendingAt { pending = false; pendingAddr = "" }
  at barPushAt { barPush = false }
  // only that one address answering ends the wait. any device answering is
  // not enough: the machines already listed keep answering while a new one
  // is still being set up, which would cut the wait short every time
  when len(rdb.devices.filter(d => d.ok && d.addr == pendingAddr)) > 0 {
    pending = false
    pendingAddr = ""
  }

  // the per-device rows above carry whether each machine answered, so there
  // is no single "connected" line under the button any more: one machine can
  // be up while another is asleep, and one line cannot say both
  // when Tailscale wants a human to approve this machine, it prints a link
  // and then waits. catch it and put it where a tap can reach it, rather than
  // leaving you to find it in a terminal
  let authUrl = rdb.auth ?? ""
  // every machine the widget knows about: this one first, then each on the
  // list, with whether it answered and how to reach it
  let machines = [{ name: localName, local: true, ok: true, addr: "" }]
    + devList.map(d => ({ name: (d.name != "" ? d.name : d.addr),
                          local: false, ok: d.ok == true, addr: d.addr }))

  let busy = totalUsed > 0 ? totalR1h > 0 : false
  let rate = max(totalR1h, 1) / 3600

  // the list to read: what you're on now, then what you've actually used today,
  // most used first, then the rest of the lineup in the order OpenCode lists it
  let ranked = scored.sortBy(m => (m.isCur ? -1000000 : 0) + (m.used > 0 ? -m.used * 1000 + m.rank : 1000 + m.rank / 1000))

// the current model's own ceiling only affects its 5-hour ring; the shared
// daily quota is never unlimited
  let curNoLimit = cur ? cur.isUnlimited : false

// how much of the shared daily cap you have burned, and what that is called
  let pctNow = total.pct
  let verdict = pctNow >= 100 ? "ON FUMES"
    : pctNow >= 75 ? "SLOW DOWN"
    : pctNow >= 50 ? "WATCH IT"
    : pctNow >= 25 ? "GO FOR IT"
    : "LET IT RIP"
  let tone = main

  // where you stand against an even spend of the day: the white mark on the bar
  let spent = total.left <= 0
  let over = !spent && total.bankedPct <= -margin ? true : false
  let ahead = !spent && !over && total.bankedPct >= margin ? true : false

  // how long until this model is back on pace if it stops now: an even day
  // hands out cap/dayLen requests a second, so the excess ahead of that line
  // drains at that rate. It reads the clock, so it ticks down every second
  // instead of stepping once a source reloads.
  let shownDrain = !shown || shown.isUnlimited ? 0
    : max(0, shown.used - shown.cap * dayFrac) * max(1, db.end - db.day) / max(1, shown.cap)

  // the hour the oldest bucket leaves the rolling five-hour window: each one
  // goes five hours after the hour it started in, so nothing sooner than that
  // boundary can clear, and never past the end of the day
  let hIdx = clamp(floor((db.now - db.day) / 3600), 0, 23)
  let winRoll = min(db.day + (max(0, hIdx - 4) + 1) * 3600 + 18000, db.end)

  // each hour boundary from here carrying that model's own five-hour sum,
  // counted from the hours it actually spent
  let shownCands = shown == null ? [] : range(24).map(k => ({ at: db.day + (hIdx + k + 1) * 3600,
      got: (sum(range(max(0, hIdx + k - 4), min(23, hIdx + k) + 1).map(i => shown.slots[i] ?? 0)) ?? 0) }))
  // the first of those reading back under its limit: one that has spent
  // nothing clears at the next boundary, one deep in its window waits for the
  // hour that put it there to drop out of the count
  let shownFree = shownCands.length == 0 ? db.end
    : (shownCands.filter(e => e.got < shown.win && e.at > db.now).map(e => e.at).first() ?? db.end)

  // when to come back to whichever model the chart is aimed at, in the order
  // of what is biting for it: its own window, a day already spent, the drain
  // back onto an even day, and the next roll of the window while it is simply
  // fine. Nothing to say about a model with no ceiling
  let shownBackAt = !shown || shown.isUnlimited ? null
    : shown.isTotal ? (shown.left <= 0 ? db.end : null)
    : shown.r5h >= shown.win ? shownFree
    : shown.left <= 0 ? db.end
    : shownDrain > 0 ? db.now + shownDrain
    : winRoll
  let shownBack = shownBackAt == null ? null
    : shown.isTotal ? "cap reached"
    : "come back at ${fmtTime(shownBackAt, 'HH:mm')}"

  // on the screen the bank rides along with the verdict, same size, and the
  // line under it is left out rather than repeated
  let bankText = ahead ? "${round(total.bankedPct)}% bank" : null

  // tallest hourly bucket today, so the day-shape bars use the full height
  let peakSlot = max(1, shown ? (shown.slots.length ? shown.slots.sortBy(v => -v).first() : 1) : 1)

  // OpenCode also enforces rolling windows, so the last five hours can run out
  // long before the day does: the count right now, and the busiest five-hour
  // stretch the day has already had, which is the one a rolling limiter trips on
  let winPeak = cur ? range(20).map(i => sum(cur.slots.take(i + 5)) - sum(cur.slots.take(i))).sort().last() ?? 0 : 0
  let overWin = cur && !curNoLimit ? max(cur.r5h, winPeak) >= cur.win : false

  // one notice when the shared daily total crosses 90%, and one at 100%.
  // "said" persists across reloads, so a threshold is not repeated just because
  // the widget was recreated. It is cleared after midnight.
  let step = totalUsed <= 0 ? 0
    : pctNow >= 100 ? 100
    : pctNow >= 90 ? 90
    : 0
  let markKey = "${db.day}|all|${step}"
  let winKey = "${db.day}|${cur != null ? cur.id : ""}|win"
  when step > 0 && said.indexOf(markKey) < 0 {
    said = unique(said + [markKey])
    // noted either way, so turning notices back on cannot repeat one already
    // passed; only the saying of it is switched off
    if notifyTotal {
      notify("opencode", "All models: ${round(pctNow)}% of today's shared cap used")
      haptic()
    }
  }
  // the rolling window bites on its own clock, so it still gets one notice
  // per model per day rather than one every time the count ticks over
  when cur != null && !curNoLimit && cur.r5h >= cur.win && said.indexOf(winKey) < 0 {
    said = unique(said + [winKey])
    if notifyWin {
      notify("opencode", "${cur.name}: ${cur.r5h} requests in the last 5 hours, limit ${cur.win}")
      haptic()
    }
  }

  // the key running low is its own notice, said once each time it crosses the
  // mark: topping it up puts the balance back over, which arms it again
  when paidLowHit && !paidSaid {
    paidSaid = true
    if notifyPaid {
      notify("opencode", "sats: ${balTxt} ${curCode} left, under the low mark")
      haptic()
    }
  }
  when !paidLowHit && paidSaid {
    paidSaid = false
  }

  // which free model to use next. budget alone is not enough: a tip that
  // sends you to a model without vision, or without video, is worse than no
  // tip at all if that is what you were using. so a candidate first has to
  // cover what the model you are on can do, and among those that do, the
  // most budget left wins. a model with nothing to compare against (the one
  // in use has no listed features) is ranked on budget as before
  // an arrow function cannot be called here, so the count is written out in
  // the sort itself
  let featWant = cur ? cur.tags : []
  let pick = cur && !curNoLimit && cur.r5h >= cur.win
    ? scored.filter(m => m.isFree && !m.isUnlimited && m.id != cur.id && m.r5h < m.win)
            .sortBy(m => m.id)
            .sortBy(m => -featWant.filter(t => m.tags.indexOf(t) >= 0).length * 10000 - (m.win - m.r5h))
            .first()
    : null
  // "" until there is something to say, so the line stays quiet while the
  // shared cap is simply being spent
  let advice = cur == null ? "nothing used today"
    : curNoLimit ? "no limit on ${cur.name}"
    : cur.r5h >= cur.win
      ? pick == null ? "5h window full; no free model has room" : "switch to ${pick.name}"
    : ""
  let adviceTone = curNoLimit ? cyan : cur.r5h >= cur.win ? (pick == null ? red : accent) : muted
  // ---- tile -----------------------------------------------------------
  // The tile reflows rather than picking one shape and cramping into it. A
  // tile much wider than it is tall is a strip: one line, the same grammar as
  // the Omarchy bar, so the desktop and the phone read alike. Squarish is the
  // dial card that was here before. Decide by dp, not by cells: a grid row is
  // a different number of dp on every phone.
  let tw = tileWidth ?? 76
  let th = tileHeight ?? 76
  let ratio = tw / max(1, th)
  // 2 cells wide is a mini, not a strip: the two halves only get ~60dp each,
  // so the type has to step down rather than clip
  let layout = ratio >= 1.9 ? (tw >= 300 ? "strip" : "mini") : "card"

  // the verdict and the two corner tags live inside the dial's square, so the
  // gauge can take the whole tile: the rim is only a couple of dp in
  let dial = clamp(min(tw, th) - 14, 38, 240)
  // "68%" fits the middle of the rings, "121%" does not, so the type gives way
  let pctText = cur == null && totalUsed <= 0 ? "…" : "${round(total.pct)}%"
  // the dial measures the side you are on: free counts what today has burned
  // out of the shared cap, paid counts how much of the key's fullest balance is
  // still there. The other side keeps its ring but steps back, so one number
  // and one ring are clearly the one you are spending
  // the pill is a choice, not a timer: an empty side follows the model in use,
  // a picked side stays put until the other is tapped. A 30-second pin used to
  // lapse on a stale clock after the screen had been asleep, which made the
  // tap look as though it had not registered
  let onPaid = side != "" ? side == "paid" : paidNow
  // the paid screen needs a working node; without one it falls back to the
  // free view, which is always readable. The warning lives in settings.
  let onPaidView = onPaid && paidOn
  // the paid side with no node to read: the tile says so instead of drawing a
  // gauge of zeros
  let paidDead = onPaid && !paidOn
  let paidShort = paidWhy == "setup" ? "not set up"
    : paidWhy == "auth" ? "key rejected"
    : paidWhy == "ssh" ? "no ssh to node"
    : paidWhy == "nohostkey" ? "no key on host"
    : paidWhy == "unreachable" ? "node offline"
    : "node error"
  let idle = 0.28
  let shownPct = cur == null && totalUsed <= 0
    ? "…"
    : paidDead ? "—"
    : onPaid ? "${round(paidFrac * 100)}%" : "${round(total.pct)}%"
  let shownVerdict = paidDead
    ? paidShort
    : onPaid
    ? (paidLowHit ? "TOP UP" : paidFrac <= 0.2 ? "LOW" : "GO FOR IT")
    : (totalUsed > 0 ? verdict : "quiet")
  let shownTone = paidDead
    ? muted
    : onPaid
    ? (paidLowHit ? warnInk : paidInk)
    : (totalUsed > 0 ? tone : muted)
  let pctSize = dial * (len(shownPct) >= 4 ? 0.19 : len(shownPct) >= 3 ? 0.22 : 0.25)

  // what the money half says when there is no node to read
  let paidTxt = paidOn ? balTxt : "—"
  let paidUnit = paidOn && satCur ? "sats" : ""
  let paidCardTxt = satCur ? "${fmtNum(bal, {compact: true})} sats left" : "${balTxt} left"
  let rangeLabel = spendRange == "24h" ? "last 24h"
    : spendRange == "7d" ? "last 7 days"
    : spendRange == "30d" ? "last 30 days" : "all time"

  if (layout == "card") {
    // the corner tags sit in the empty corners the round dial leaves, so they
    // cost the gauge no height at all
    Box {
      fill: true
      Column {
        fill: true
        align: center
        justify: center
        gap: 0

        Box {
          width: dial
          height: dial
          align: center

          // the main gauge: three sectioned rings. Rim: paid money in bitcoin
          // orange, as much of it as the key still holds against its fullest,
          // verdict sit in the middle, clear of all three
          Box {
          width: dial
          height: dial
          align: center
          Canvas {
            width: dial
            height: dial
            let cx = dial / 2
            let cy = dial / 2

            let pw = max(3, dial * 0.04)
            let pr = dial / 2 - pw / 2 - max(1, dial * 0.01)
            let psegs = 30
            let pspan = 270 / psegs
            let pgap = 0.16
            let plit = round(paidFrac * psegs)
            for i in range(psegs) {
              let a = 225 + i * pspan + pspan * pgap / 2
              let pcol = paidLowHit ? warnInk : paidInk
              arc(cx, cy, pr, a, pspan * (1 - pgap),
                  stroke: paidOn && i < plit
                    ? (onPaid ? pcol : alpha(pcol, idle))
                    : paidLowHit ? alpha(warnInk, onPaid ? 0.3 : 0.14)
                    : alpha(border, 0.45),
                  width: pw, cap: butt)
            }

            let w = max(5, dial * 0.075)
            let r = pr - pw / 2 - max(4, dial * 0.045)
            let segs = 26
            let span = 270 / segs
            let gap = 0.16
            let lit = round(clamp(total.pct, 0, 100) / 100 * segs)
            for i in range(segs) {
              let a = 225 + i * span + span * gap / 2
              arc(cx, cy, r - w / 2, a, span * (1 - gap),
                  stroke: i < lit ? (onPaid ? alpha(freeInk, idle) : freeInk)
                    : alpha(border, 0.4), width: w, cap: butt)
            }
            if (lit > 0) {
              let a = 225 + (lit - 1) * span + span * gap / 2
              arc(cx, cy, r - w / 2, a, span * (1 - gap),
                  stroke: onPaid ? alpha(foreground, idle) : foreground,
                  width: w, cap: butt)
            }
            // inside it, the rolling five-hour window, in the same house style
            if (cur && !curNoLimit) {
              let w2 = max(3, dial * 0.04)
              let r2 = r - w / 2 - max(2, dial * 0.02) - w2 / 2
              let n2 = 16
              let s2 = 270 / n2
              let lit2 = round(clamp(cur.r5h / max(1, cur.win), 0, 1) * n2)
              for i in range(n2) {
                let a = 225 + i * s2 + s2 * gap / 2
                arc(cx, cy, r2 - w2 / 2, a, s2 * (1 - gap),
                    stroke: i < lit2 ? (onPaid ? alpha(main, idle) : main)
                      : alpha(border, 0.25), width: w2, cap: butt)
              }
            }
          }
          // the share of the cap, and the verdict, in the middle of the dial
          Column {
            align: center
            gap: 0
            offset: [0, -dial * 0.035]
            Text {
              text: shownPct
              fontSize: pctSize
              color: shownTone
              align: center
              width: dial
            }
            Text {
              text: shownVerdict
              fontSize: clamp(dial * 0.075, 6, 11)
              color: shownTone
              align: center
              width: dial * 0.84
              maxLines: 1
              // the number's line box carries a deep descent; pulling the words
              // up into it closes the gap without moving the dial's centre
              offset: [0, -pctSize * 0.16]
            }
          }
          }

          // the same gauge again, in miniature, dropped into the gap where the
          // rings part: the count of the models you are not on, filled with how
          // much of its own cap the biggest of them has spent
          Canvas {
            width: dial
            height: dial
            let mr = dial * 0.145
            let mw = max(2, dial * 0.035)
            let mx = width / 2
            let my = height / 2 + dial * 0.335
            let segs = 8
            let span = 270 / segs
            let gap = 0.16
            let lit = max(0, round(runnerPct * segs))
            for i in range(segs) {
              let a = 225 + i * span + span * gap / 2
              arc(mx, my, mr - mw / 2, a, span * (1 - gap),
                  stroke: i < lit ? (otherCount > 0 ? tone : muted) : alpha(border, 0.4), width: mw, cap: butt)
            }
            if (lit > 0) {
              let a = 225 + (lit - 1) * span + span * gap / 2
              arc(mx, my, mr - mw / 2, a, span * (1 - gap), stroke: foreground, width: mw, cap: butt)
            }
            let miniInk = otherCount > 0 ? foreground : deskStale ? yellow : muted
            text("+${otherCount}", mx, my, size: dial * 0.11, bold: true,
                 align: center, color: onPaid ? alpha(miniInk, 0.45) : miniInk)
          }
        }
      }

      // what the rings mean, in the corners the circle leaves empty. The row
      // is stacked over the dial, not laid out under it, so it takes no height
      // from the gauge: it just drops into the two lower corners. On a tile too
      // small to leave corners, they would sit on the ring, so they step aside
      if (dial >= 96) {
      Box {
        fill: true
        align: bottomStart
        Row {
          fill: true
          align: bottom
          justify: spaceBetween
          padding: [0, 0, 2, 4]
          Text { text: str.freeCaps; fontSize: 9; color: onPaid ? alpha(freeInk, 0.45) : freeInk; bold: true; letterSpacing: 1; maxLines: 1 }
          Text { text: "$"; fontSize: 11; color: paidLowHit ? warnInk : paidOn && !onPaid ? alpha(paidInk, 0.45) : paidOn ? paidInk : alpha(paidInk, 0.4); bold: true; maxLines: 1 }
        }
      }
      }
    }
  } else {
    // strip and mini: both meters on the tile, side by side, neither one
    // hidden behind a tap. Each half is a small group with its own label
    // above the number, the way the page titles its groups, so the pair reads
    // as one line of the widget and not as a block bolted beside it
    Row {
      fill: true
      align: center
      gap: 10
      padding: [0, 2]

      Column {
        weight: 1
        gap: 2
        Text { text: str.free; fontSize: 9; color: main; bold: true; letterSpacing: 1; maxLines: 1 }
        Row {
          fill: width
          align: bottom
          gap: 5
          Text {
            text: "${fmtNum(totalUsed)}/${fmtNum(totalCap)}"
            fontSize: layout == "mini" ? 11 : clamp(th * 0.32, 14, 20)
            bold: true
            color: main
            maxLines: 1
          }
          if (layout == "strip") {
            Text { text: str.req; fontSize: 9; color: muted; maxLines: 1 }
          }
        }
        Canvas {
          fill: width
          height: 8
          let p = clamp(total.pct, 0, 100) / 100
          rect(0, 2.5, width, 3, radius: 2, fill: alpha(border, 0.55))
          if (p > 0) {
            rect(0, 2.5, max(2, width * p), 3, radius: 2, fill: main)
          }
          // where you should be by now, so the fill reads as behind or ahead
          rect(clamp(width * dayFrac, 1, width - 1) - 1, 0.5, 2, 7, radius: 1,
               fill: alpha(foreground, 0.6))
        }
      }

      Box { width: 1; height: 40; background: alpha(border, 0.85) }

      Column {
        weight: 1
        gap: 2
        Text { text: str.paid; fontSize: 9; color: paidTone; bold: true; letterSpacing: 1; maxLines: 1 }
        Row {
          fill: width
          align: bottom
          gap: 5
          Text {
            text: paidTxt
            fontSize: layout == "mini" ? 11 : clamp(th * 0.32, 14, 20)
            bold: true
            color: paidLowHit ? warnInk : paidOn ? foreground : muted
            maxLines: 1
          }
          if (layout == "strip" && paidUnit != "") {
            Text { text: paidUnit; fontSize: 9; color: muted; maxLines: 1 }
          }
        }
        if (paidOn) {
          Text {
            text: layout == "mini" ? "${todayTxt} today" : "${winTxt} spent · ${rangeLabel}"
            fontSize: 8
            color: muted
            maxLines: 1
          }
        } else {
          Text {
            text: layout == "mini" ? "—" : paidShort
            fontSize: 8
            color: muted
            maxLines: 1
          }
        }
      }
    }
  }

  // ---- screen ---------------------------------------------------------
  screen {
    title: str.title

    // the controls, up by the close button where a thumb goes looking for it:
    // the side you are on, a cog while the screen shows the day (the way back
    // while settings are open), and a frame of our own drawn under the window's
    // close glyph so the three read as one row of buttons
    Row {
      fill: width
      height: 26
      align: center
      justify: end
      gap: 8
      offset: [0, -38]
      // which meter is on show, as a two-cell pill: the side in use is filled
      // and the other is just a word, so the state needs no label. A tap only
      // changes the view, never opencode's model; the cog beside it is where
      // the key is set up, and `$` goes there if there is none
      Row {
        align: center
        padding: [1, 1]
        radius: 8 * corners
        border: 1
        borderColor: alpha(accent, 0.3)
        background: alpha(background, 0.35)
        Box {
          width: 40
          height: 24
          align: center
          radius: 6 * corners
          background: onPaidView ? alpha(accent, 0) : alpha(accent, 0.18)
          onTap: { haptic(); side = "free" }
          Text {
            text: str.freeCaps
            fontSize: 11
            bold: true
            letterSpacing: 1
            color: onPaidView ? muted : accent
            align: center
            maxLines: 1
          }
        }
        Box {
          width: 24
          height: 24
          align: center
          radius: 6 * corners
          background: onPaidView ? alpha(paidInk, 0.2) : alpha(paidInk, 0)
          onTap: {
            haptic()
            side = "paid"
            // only a key that has never been set up needs the form; while a
            // source is still loading the tap still lands on the paid view
            if (!paidOn) { pane = "setup" }
          }
          Text {
            text: "$"
            fontSize: 15
            bold: true
            color: onPaidView ? paidInk : paidOn ? alpha(paidInk, 0.55) : muted
            align: center
            maxLines: 1
          }
        }
      }
      Box {
        width: 26
        height: 26
        align: center
        radius: 8 * corners
        border: 1
        borderColor: alpha(accent, 0.3)
        background: alpha(background, 0.35)
        onTap: pane = pane == "setup" ? "" : "setup"
        Text {
          text: pane == "setup" ? "<" : "⚙"
          font: sans
          fontSize: 18
          color: accent
          align: center
          maxLines: 1
        }
      }
      // the window draws its own ✕ over this: the frame turns that bare glyph
      // into the third button of the row. Taps land on the window's, so this
      // only has to be the outline
      Box {
        width: 26
        height: 26
        radius: 8 * corners
        border: 1
        borderColor: alpha(accent, 0.3)
        background: alpha(background, 0.35)
        // the window's ✕ sits above this and keeps its own tap; this only
        // closes too, in case a tap lands inside the frame but off the glyph
        onTap: close()
      }
    }
    if (pane == "setup") {
      Box {
        fill: true
        clip: true
        Column {
          scroll: true
          gap: 10
          fill: true

        // accent cards, as in feed and timesheet: no hairlines
        Box {
          fill: width
          background: alpha(accent, 0.1)
          radius: 12 * corners
          padding: [10, 10]
          Column {
            gap: 8
            Text { text: upper(str.notifications); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }
                    // three switches, not one: a shared quota you cannot buy
                    // and a balance you can are different things to be woken
                    // about, and the two free ones trip at different moments
                    Row {
                      align: center
                      fill: width
                      gap: 10
                      Text { text: str.freeDaily; style: body; color: #ffffff; weight: 1; maxLines: 1 }
                      Box {
                        width: 46
                        height: 26
                        radius: 13 * corners
                        background: notifyTotal ? alpha(green, 0.3) : alpha(green, 0.12)
                        border: 1
                        borderColor: notifyTotal ? alpha(green, 0.6) : alpha(green, 0.28)
                        padding: 3
                        align: notifyTotal ? "end" : "start"
                        Box {
                          width: 18
                          height: 18
                          radius: 9 * corners
                          background: notifyTotal ? green : alpha(green, 0.45)
                        }
                        onTap: { haptic(); notifyTotal = !notifyTotal }
                      }
                    }
                    Row {
                      align: center
                      fill: width
                      gap: 10
                      Text { text: str.freeWindow; style: body; color: #ffffff; weight: 1; maxLines: 1 }
                      Box {
                        width: 46
                        height: 26
                        radius: 13 * corners
                        background: notifyWin ? alpha(green, 0.3) : alpha(green, 0.12)
                        border: 1
                        borderColor: notifyWin ? alpha(green, 0.6) : alpha(green, 0.28)
                        padding: 3
                        align: notifyWin ? "end" : "start"
                        Box {
                          width: 18
                          height: 18
                          radius: 9 * corners
                          background: notifyWin ? green : alpha(green, 0.45)
                        }
                        onTap: { haptic(); notifyWin = !notifyWin }
                      }
                    }
                    Row {
                      align: center
                      fill: width
                      gap: 10
                      Text { text: str.paidLowLabel; style: body; color: #ffffff; weight: 1; maxLines: 1 }
                      Box {
                        width: 46
                        height: 26
                        radius: 13 * corners
                        background: notifyPaid ? alpha(green, 0.3) : alpha(green, 0.12)
                        border: 1
                        borderColor: notifyPaid ? alpha(green, 0.6) : alpha(green, 0.28)
                        padding: 3
                        align: notifyPaid ? "end" : "start"
                        Box {
                          width: 18
                          height: 18
                          radius: 9 * corners
                          background: notifyPaid ? green : alpha(green, 0.45)
                        }
                        onTap: { haptic(); notifyPaid = !notifyPaid }
                      }
                    }
          }
        }

        // ---- paid: one key, one button ----------------------------------
        // Everything paid hangs off one thing: a provider key. Paste it, press
        // connect, and the node, the model and opencode's own provider are all
        // worked out from it. The leftovers live under "advanced", which is
        // where a node on another machine goes.
        Box {
          fill: width
          background: alpha(accent, 0.1)
          radius: 12 * corners
          padding: [10, 10]
          Column {
            gap: 8
            Row {
              fill: width
              align: center
              gap: 8
              Text { text: upper(str.paidModels); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }
              Spacer { weight: 1 }
              Text {
                text: paidOn ? str.connected : str.notConnected
                style: small
                color: paidOn ? paidTone : muted
                maxLines: 1
              }
            }

            // not connected: one line, one key, one button
            if (!paidOn) {
              Text {
                text: str.connectHelp
                style: small
                color: #ffffff
                maxLines: 3
              }
              Row {
                align: center
                gap: 8
                Box {
                  weight: 1
                  height: 38
                  border: 1
                  borderColor: alpha(paidTone, 0.5)
                  radius: 8 * corners
                  Input {
                    text: fKey
                    placeholder: str.apiKey
                    color: foreground
                    fontSize: 14
                    underline: false
                    padding: [10, 5, 7, 0]
                    onChange: fKey = value
                  }
                }
                Button {
                  radius: 8 * corners
                  border: 1
                  borderColor: alpha(accent, 0.3)
                  background: alpha(background, 0.35)
                  text: str.connect
                  color: paidTone
                  onTap: {
                    haptic()
                    run("f=$HOME/.config/opencode-burn/paid.json; of=$HOME/.config/opencode/opencode.json; mkdir -p \"$(dirname \"$f\")\"; u=" + sh(fUrl) + "; k=" + sh(fKey) + "; p=" + sh(fProvider) + "; m=" + sh(fModels) + "; [ -n \"$p\" ] || p=routstr; [ -n \"$u\" ] || u=https://api.routstr.com/v1; [ -n \"$k\" ] || exit 0; ids=$(curl -sS -m 12 -H \"Authorization: Bearer $k\" \"$u/models\" 2>/dev/null | jq -r '[.data[]?.id][:60][]' 2>/dev/null); [ -n \"$m\" ] || m=$(printf '%s\\n' \"$ids\" | head -1); mj=$(printf '%s\\n' \"$ids\" | jq -R . | jq -s 'map(select(length > 0) | {(.): {name: .}}) | add // {}' 2>/dev/null); jq -n --arg u \"$u\" --arg k \"$k\" --arg p \"$p\" --arg m \"$m\" '{url:$u, key:$k, provider:$p, unit:\"msat\", topup:\"https://chat.routstr.com/topup\"} + (if $m != \"\" then {model:$m} else {} end)' > \"$f\" && chmod 600 \"$f\"; [ -f \"$of\" ] || echo {} > \"$of\"; jq --arg u \"$u\" --arg k \"$k\" --arg p \"$p\" --argjson models \"$mj\" '.provider = (.provider // {}) | .provider[$p] = ((.provider[$p] // {}) + {npm:\"@ai-sdk/openai-compatible\", name:\"Routstr\", options:{baseURL:$u, apiKey:$k}}) + (if ($models | length) > 0 then {models:$models} else {} end)' \"$of\" > \"$of.n\" 2>/dev/null && mv \"$of.n\" \"$of\"; true")
                    fKey = ""
                    fUrl = ""
                    fHost = ""
                    fKeyfile = ""
                    fModels = ""
                    fProvider = ""
                  }
                }
              }
              if (paidWhy != "setup") {
                Text { text: paidErrTxt; style: small; color: warnInk; maxLines: 3 }
              }
            }

            // sats are what is tracked; the other three only change how the
            // same balance is read. With no node connected there is no
            // balance to read, so the row stays away like the warning does
            if (paidOn) {
              Row {
                align: center
                gap: 8
                Text { text: str.currency; style: small; color: #ffffff; maxLines: 1 }
                Spacer { weight: 1 }
                for c in ["sat", "gbp", "usd", "eur"] {
                  Box {
                    width: 46
                    height: 26
                    align: center
                    radius: 8 * corners
                    border: 1
                    borderColor: alpha(accent, 0.3)
                    background: currency == c ? alpha(accent, 0.15) : alpha(background, 0.35)
                    onTap: { currency = c; haptic() }
                    Text {
                      text: c == "sat" ? "sats" : upper(c)
                      style: small
                      color: paidTone
                      align: center
                      maxLines: 1
                    }
                  }
                }
              }
            }
            // the warning line, kept out of the overrides: it is a setting,
            // not part of where the node is. The value is entered in the
            // currency on show, and stored in sats.
            if (paidOn) {
              Row {
                align: center
                gap: 8
                Text { text: str.low; style: small; color: #ffffff; maxLines: 1 }
                Spacer { weight: 1 }
                let lowText = satCur || fx <= 0 ? "${paidLow}" : "${round(paidLow * fx, 2)}"
                Box {
                  width: 160
                  height: 34
                  border: 1
                  borderColor: border
                  radius: 8 * corners
                  Row {
                    fill: width
                    align: center
                    justify: end
                    gap: 8
                    padding: [0, 0, 16, 0]
                    Input {
                      height: 34
                      width: max(48, len(lowText) * 8 + 16)
                      text: lowText
                      color: foreground
                      fontSize: 13
                      underline: false
                      padding: [8, 4, 6, 0]
                      onChange: {
                        let n = num(value, 0)
                        paidLow = max(0, round(satCur || fx <= 0 ? n : n / fx))
                      }
                    }
                    Text { text: curCode; style: small; color: muted; maxLines: 1 }
                  }
                }
              }
            }
            // the rest, folded away: a working setup never needs it
            Text {
              text: str.advanced + (advPaid ? " ▾" : " ▸")
              style: small
              color: muted
              maxLines: 1
              onTap: { advPaid = !advPaid; haptic() }
            }

            if (advPaid) {
              Row {
                align: center
                gap: 8
                Text { text: str.providerUrl; style: small; color: #ffffff; width: 64 }
                Box {
                  weight: 1
                  height: 38
                  border: 1
                  borderColor: border
                  radius: 8 * corners
                  Input {
                    text: fUrl
                    placeholder: paidUrl == "" ? str.providerUrlHint : paidUrl
                    color: foreground
                    fontSize: 14
                    underline: false
                    padding: [10, 5, 7, 0]
                    onChange: fUrl = value
                  }
                }
              }
              Row {
                align: center
                gap: 8
                Text { text: str.sshHost; style: small; color: #ffffff; width: 64 }
                Box {
                  weight: 1
                  height: 38
                  border: 1
                  borderColor: border
                  radius: 8 * corners
                  Input {
                    text: fHost
                    placeholder: paidHost == "" ? str.sshHostHint : paidHost
                    color: foreground
                    fontSize: 14
                    underline: false
                    padding: [10, 5, 7, 0]
                    onChange: fHost = value
                  }
                }
              }
              Button {
                radius: 8 * corners
                border: 1
                borderColor: alpha(accent, 0.3)
                background: alpha(background, 0.35)
                text: str.save
                color: paidTone
                fill: true
                onTap: {
                  haptic()
                  run("f=$HOME/.config/opencode-burn/paid.json; mkdir -p $(dirname $f); [ -s $f ] || echo {} > $f; jq --arg h " + sh(fHost) + " --arg u " + sh(fUrl) + " --arg k " + sh(fKey) + " --arg x " + sh(fKeyfile) + " --arg m " + sh(fModels) + " --arg p " + sh(fProvider) + " --arg du msat --arg dt https://chat.routstr.com/topup 'if ($h|length)>0 then .host=$h else . end | if ($u|length)>0 then .url=$u else . end | if ($k|length)>0 then .key=$k else . end | if ($x|length)>0 then .keyfile=$x else . end | if ($m|length)>0 then .model=$m else . end | if ($p|length)>0 then .provider=$p else . end | .unit = (.unit // $du) | .topup = (.topup // $dt)' $f > $f.n && mv $f.n $f; chmod 600 $f; true")
                  fHost = ""
                  fUrl = ""
                  fKey = ""
                  fKeyfile = ""
                  fModels = ""
                  fProvider = ""
                  refresh()
                }
              }
            }

          }
        }

        // step by step onto another machine
        Box {
          fill: width
          background: alpha(accent, 0.1)
          radius: 12 * corners
          padding: [10, 10]
          Column {
            gap: 8
            Text { text: upper(str.linkDevice); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }
            Text { text: str.linkHelp; style: small; color: #ffffff; maxLines: 2 }
                    Row {
                      align: center
                      Text { text: str.step1; style: body; color: #ffffff; width: 64 }
                      Box {
                        width: 200
                      Button {
                        radius: 8 * corners
                        border: 1
                        borderColor: alpha(accent, 0.3)
                        background: alpha(background, 0.35)
                        text: flash ? str.copied : str.copyInstaller
                        color: green
                        animate color: tween(120ms, "out")
                        fill: true
                        onTap: { haptic(); flash = true; flashAt = now + 1; copy("mkdir -p ~/.local/bin && echo '' | base64 -d | gzip -d > ~/.local/bin/opencode-burn-query && chmod +x ~/.local/bin/opencode-burn-query && name=`uname -n 2>/dev/null || cat /etc/hostname` && addr=$name && if command -v tailscale >/dev/null 2>&1; then a=`tailscale ip -4 2>/dev/null | head -1`; [ -n $a ] && addr=$a; fi; echo $(whoami)@$addr ~/.local/bin/opencode-burn-query") }
                        }
                      }
                    }

                    Row {
                      align: top
                      Text { text: str.step2; style: body; color: #ffffff; width: 64; maxLines: 1 }
                      Text { text: str.runTerminal; style: body; color: #ffffff; weight: 1 }
                    }
                    Row {
                      align: top
                      Text { text: str.step3; style: body; color: #ffffff; width: 64; maxLines: 1 }
                      Text { text: str.pasteOutput; style: body; color: #ffffff; weight: 1 }
                    }
                    // a full frame rather than a line under the field: an underline on
                    // its own reads as the end of the text above it, and makes step 4
                    // look like a separate block instead of the next thing to press
                    // the field fills the frame, so its text would otherwise sit at the top
                    // of it with the caret under the border. even vertical padding insets
                    // the text line, which centres the caret; the grey hint is placed by the
                    // same sum so the two lines cannot drift apart.
                    // the field's own hint, rather than a separate line drawn beside it, so
                    // the caret and the grey text are always in the same place: whatever the
                    // field does with one it does with the other.
                    Box {
                      height: 40
                      border: 1
                      borderColor: border
                      radius: 8 * corners
                      Input {
                        text: pasted
                        placeholder: str.deviceHint
                        color: green
                        fontSize: 15
                        underline: false
                        padding: [12, 5, 8, 0]
                        onChange: pasted = value
                      }
                    }

                    Row {
                      align: center
                      Text { text: str.step4; style: body; color: #ffffff; width: 64 }
                      Box {
                        width: 200
                      Button {
                        radius: 8 * corners
                        border: 1
                        borderColor: alpha(accent, 0.3)
                        background: alpha(background, 0.35)
                        text: pending ? str.connecting : str.connect
                        color: pending ? yellow : green
                        animate color: tween(120ms, "out")
                        fill: true
                        onTap: { haptic(); pending = true; pendingAt = now + 15
                                 pendingAddr = len(pasted.trim().split(" ")) > 0 ? pasted.trim().split(" ")[0] : ""
                                 run("mkdir -p $HOME/.config/opencode-burn; f=$HOME/.config/opencode-burn/remote; touch $f; a=$(printf %s ${sh(pasted)} | awk '{print $1}'); awk -v a=$a '$1!=a' $f > $f.r; mv $f.r $f; printf '%s\\n' ${sh(pasted)} >> $f") }
                        }
                        // the wait lives inside the button that was pressed, rather than
                        // as a line under it. it only spins while the wait is on: a
                        // waiting state with nothing to look at reads as a dead button
                        Canvas {
                          width: 20
                          height: 20
                          offset: [174, 7]
                          if pending {
                            let glyphs = ["⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"]
                            let t = time > 100000 ? time / 70 : time * 14
                            text(glyphs[round(t) % 10], width / 2, height / 2, size: 13,
                                 align: center, color: yellow)
                          }
                        }
                      }
                    }

                    // Tailscale cannot be signed in from here: approving it wants a
                    // browser and a human. all the widget can do is notice, and make the
                    // link one tap away instead of something to go and dig out
                    Text {
                      text: authUrl == "" ? "" : str.approveMachine
                      style: small
                      color: green
                      maxLines: 1
                      visible: authUrl != ""
                      onTap: url(authUrl)
                    }

          }
        }

        // the machines on the account
        Box {
          fill: width
          background: alpha(accent, 0.1)
          radius: 12 * corners
          padding: [10, 10]
          Column {
            gap: 8
            Text { text: upper(str.connectedDevices); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }

                    for m in machines {
                      Row {
                        align: center
                        fill: width
                        // the row fills the panel and the name takes the slack, which is
                        // what pushes remove against the right edge. remove keeps its slot
                        // even on the local row (which has no text in it), otherwise that
                        // row's name would absorb 56 more and shove its status sideways
                        Text { text: m.name; style: body; color: #ffffff; weight: 1; maxLines: 1 }
                        Box {
                          width: 108
                          Text {
                            text: m.local ? str.thisDevice : m.ok ? str.answering : str.notAnswering
                            style: body
                            color: green
                            maxLines: 1
                          }
                        }
                        // one slot for whatever a machine is doing, so the two animations
                        // share a column and line up down the list: it turns green while
                        // the machine answers, and is the wake button when it does not.
                        // the same size and the same box either way, so nothing shifts and
                        // the wake glyph is no bigger than the one beside "answering"
                        Box {
                          width: 28
                          height: 24
                          Canvas {
                            if !m.local {
                              let waking = !m.ok && now - wakeAt < 8
                              let glyphs = ["⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"]
                              let t = time > 100000 ? time / 70 : time * 14
                              text(m.ok || waking ? glyphs[round(t) % 10] : "↻",
                                   width / 2, height / 2, size: 13,
                                   align: center, color: m.ok ? green : waking ? yellow : accent)
                            }
                          }
                          // a silent machine looks stuck when the truth is that nobody has
                          // asked it for a minute, so this asks it again now. a press
                          // answers with a spin while the poll comes back. bumping `poke`
                          // re-runs the remote poll alone, rather than every source
                          onTap: { wakeAt = now + 1; poke = poke + 1 }
                        }
                        Text {
                          text: m.local ? "" : str.remove
                          style: body
                          color: green
                          width: 56
                          align: end
                          maxLines: 1
                          // guarded, so a tap on the empty local slot cannot rewrite the file
                          onTap: run("f=$HOME/.config/opencode-burn/remote; touch $f; a=$(printf %s ${sh(m.addr)} | awk '{print $1}'); awk -v a=$a '$1!=a' $f > $f.r; mv $f.r $f; true")
                        }
                      }
                    }

          }
        }

        // and onto the bar of the first one you added
        Box {
          fill: width
          background: alpha(accent, 0.1)
          radius: 12 * corners
          padding: [10, 10]
          Column {
            gap: 8
            Text { text: upper(str.omarchyBar); style: label; color: #ffffff; letterSpacing: 1.2; maxLines: 1 }
                    // what the whole flow is for, offered once the button is past it.
                    // the same 200 as the other two, centred rather than labelled: it is
                    // the end of the flow, not another step in it. pushing it drops the
                    // bar module onto the machine that was linked above
                    Box {
                      fill: width
                      height: 27
                      radius: 8 * corners
                      // same height as the connect button, text centred both
                      // ways, as the pane's step buttons have it
                      border: 1
                      borderColor: alpha(accent, 0.3)
                      background: barPush ? alpha(accent, 0.15) : alpha(background, 0.35)
                        onTap: { haptic(); if barAddr == "" { pane = "setup" } else { barPush = true; barPushAt = now + 12
                                 run("b=''; printf %s \"$b\" | base64 -d | gzip -d | ssh -o BatchMode=yes -o ConnectTimeout=6 -o LogLevel=ERROR -o StrictHostKeyChecking=accept-new -o ControlPath=none ${sh(barAddr)} 'h=$(getent passwd 1000 | cut -d: -f6); u=$(getent passwd 1000 | cut -d: -f1); [ -n \"$h\" ] || { h=$HOME; u=$(id -un); }; mkdir -p \"$h/.local/bin\"; cat > \"$h/.local/bin/opencode-burn-bar\" && chmod 700 \"$h/.local/bin/opencode-burn-bar\" && chown \"$u\" \"$h/.local/bin/opencode-burn-bar\" && { [ \"$(id -u)\" = \"$(id -u \"$u\")\" ] && exec \"$h/.local/bin/opencode-burn-bar\" --install; exec su \"$u\" -c \"$h/.local/bin/opencode-burn-bar --install\"; }' >\"$HOME/.config/opencode-burn/.barout\" 2>&1; true")  } }
                      Row {
                        fill: true
                        align: center
                        justify: center
                        gap: 8
                        Text {
                          text: barPush ? str.pushing : str.addBarWidget
                          style: body
                          color: barPush ? yellow : green
                          align: center
                          maxLines: 1
                        }
                        // the push goes over SSH and takes a few seconds, so
                        // the button turns rather than sitting still
                        Canvas {
                          width: 20
                          height: 20
                          visible: barPush
                          let glyphs = ["⠋","⠙","⠹","⠸","⠼","⠴","⠦","⠧","⠇","⠏"]
                          let t = time > 100000 ? time / 70 : time * 14
                          text(glyphs[round(t) % 10], width / 2, height / 2, size: 13,
                               align: center, color: yellow)
                        }
                      }
                    }

                    // the push landing, said plainly rather than left as a log line. the
                    // helper ends with a word only it writes, so this cannot appear for a
                    // push that failed and only printed why
                    Text {
                      text: contains(barOut ?? "", "waybar module added")
                            ? str.waybarDone
                            : str.omarchyBarDone
                      style: body
                      weight: 1
                      color: #ffffff
                      align: start
                      maxLines: 2
                      visible: contains(barOut ?? "", "SUCCESS")
                    }

                    // what the push found. the button talks to the machine at the top of
                    // this list, so when it has nothing to say the answer is shown here
                    // rather than lost: "waybar is not installed", or the line it added
                    Text {
                      text: first(lines(trim(barOut ?? "")))
                      style: small
                      color: green
                      align: start
                      maxLines: 2
                      visible: trim(barOut ?? "") != ""
                    }

          }
        }

        // who made it, at the foot of this screen and out of the way
        Text {
          text: str.builtBy
          style: small
          color: #ffffff
          align: center
          maxLines: 1
          onTap: url("https://jaquesbody.github.io/")
        }
        Text {
          text: str.inspiredBy
          style: small
          color: #ffffff
          align: center
          maxLines: 1
          padding: [0, 6]
          onTap: url("https://github.com/nixfred/burnbar")
        }
        }
      }
    } else {
      Box {
        fill: true
        clip: true
        offset: [0, -20]
        Column {
          scroll: true
          gap: 10
          fill: true

        // the paid side is its own day: money rather than a quota, read from
        // the node's books, in the same grammar as the free view below so that
        // switching between the two moves nothing on the page
      if (onPaidView) {
        // the balance first: one number, on the provider that holds it, and how
        // many requests the key has ever carried
        Row {
          align: center
          Box {
            width: 62
            height: 62
            align: center
            Canvas {
              width: 62
              height: 62
              let r = 30
              let w = 5.5
              let segs = 16
              let span = 270 / segs
              let gap = 0.18
              let lit = round(clamp(paidFrac, 0, 1) * segs)
              for i in range(segs) {
                let a = 225 + i * span + span * gap / 2
                arc(31, 31, r - w / 2, a, span * (1 - gap),
                    stroke: i < lit ? (paidLowHit ? warnInk : paidInk) : alpha(border, 0.4),
                    width: w, cap: butt)
              }
              if (lit > 0) {
                let a = 225 + (lit - 1) * span + span * gap / 2
                arc(31, 31, r - w / 2, a, span * (1 - gap),
                    stroke: foreground, width: w, cap: butt)
              }
            }
            Text {
              text: "${round(paidFrac * 100)}%"
              fontSize: 17
              color: paidLowHit ? warnInk : paidInk
              align: center
              width: 62
            }
          }
          Column {
            gap: 2
            Text {
              text: balTxt + " " + curCode
              style: huge
              color: paidLowHit ? warnInk : foreground
              maxLines: 1
            }
            Text {
              // the ring's denominator, said out loud: how much of the
              // fullest this key has been is still in it
              text: paidPeak > 0
                ? "${paidProvTxt} · ${round(paidFrac * 100)}% of ${fmtNum(paidPeak)} peak"
                : paidProvTxt
              fontSize: 14
              color: paidLowHit ? warnInk : paidInk
              maxLines: 1
            }
          }
        }

        // the same second row as the free side: a small arc, the window's
        // share of all time on the left, the key on the right
        Row {
          align: center
          Box {
            width: 22
            height: 22
            align: center
            Canvas {
              width: 18
              height: 18
              let segs = 10
              let span = 270 / segs
              let gap = 0.32
              let w = 2
              let r = 8
              let lit = round(clamp(winSats / max(1, spendAll), 0, 1) * segs)
              for i in range(segs) {
                let a = 225 + i * span + span * gap / 2
                arc(9, 9, r - w / 2, a, span * (1 - gap),
                    stroke: i < lit ? paidInk : alpha(border, 0.25), width: w, cap: butt)
              }
              if (lit > 0) {
                let a = 225 + (lit - 1) * span + span * gap / 2
                arc(9, 9, r - w / 2, a, span * (1 - gap),
                    stroke: foreground, width: w, cap: butt)
              }
            }
          }
          Text {
            text: spendRange + " " + winTxt
            style: label
            color: paidInk
            width: 184
            maxLines: 1
          }
        }

        // the day in one picture, drawn at the free screen's size and place:
        // the model slices stacked behind, their legend above, the running
        // total in front, and the same nine-point clock beneath
        Canvas {
          height: 190
          fill: width
          let w = width
          let ticks = 11
          let top = 20
          let y0 = height - ticks
          let gh = y0 - top
          let n = max(1, len(paidSeries))
          let bw = w / n
          let peakSlot = paidSeriesMax
          let cumPeak = max(1, winSats)
          let ly = top + 2
          let colw = w / max(1, len(paidModels))
          rect(0, y0, w, 1, fill: alpha(border, 0.55))
          for i in range(n) {
            let vis = paidModels.filter(m => (m.slots[i] ?? 0) > 0)
            if (len(vis) > 0) {
              for k in range(len(vis)) {
                let hh = max(1, gh * 0.58 * (vis[k].slots[i] ?? 0) / peakSlot)
                let below = sum(vis.take(k).map(x => max(1, gh * 0.58 * (x.slots[i] ?? 0) / peakSlot)))
                rect(bw * i + 1, y0 - below - hh, bw - 2, hh,
                     radius: 1.5 * corners, fill: vis[k].ink)
              }
            } else {
              rect(bw * i + 1, y0 - 2, bw - 2, 2, fill: alpha(muted, 0.18))
            }
          }
          for k in range(len(paidModels)) {
            let cx = k * colw
            rect(cx + 2, ly, 10, 10, radius: 2 * corners, fill: paidModels[k].ink)
            text(sub(paidModels[k].short, 0, 10), cx + 16, ly + 5, size: 9,
                 align: start, color: muted)
          }
          text(rangeLabel, 0, 10, size: 12, align: start, color: paidTone)
          text("peak " + fmtNum(paidSeriesMax) + " " + curCode, w, 10, size: 12, align: end, color: muted)
          // the running total starts below the legend and climbs to the right
          // edge, so its own scale tops out where the line can reach
          let ltop = top + 22
          let lgh = y0 - ltop
          for i in range(n - 1) {
            line(w * i / n, ltop + lgh * (1 - clamp(sum(paidSeries.take(i + 1)) / cumPeak, 0, 1)),
                 w * (i + 1) / n, ltop + lgh * (1 - clamp(sum(paidSeries.take(i + 2)) / cumPeak, 0, 1)),
                 stroke: paidInk, width: 2.5)
          }
          let endY = ltop + lgh * (1 - clamp(sum(paidSeries) / cumPeak, 0, 1))
          circle(w * (n - 1) / n, endY, 4, fill: paidInk)
          // two scales share the frame, small and inside it: sats per bucket
          // behind the bars on the left, the running total on the right, each
          // at its top and halfway mark only
          text(fmtNum(paidSeriesMax), 3, y0 - gh * 0.58, size: 9, align: start,
               color: alpha(foreground, 0.7))
          text(fmtNum(round(paidSeriesMax / 2)), 3, y0 - gh * 0.29, size: 9, align: start,
               color: alpha(foreground, 0.7))
          text(fmtNum(cumPeak), w - 9, ltop + 10, size: 9, align: end,
               color: paidInk)
          text(fmtNum(round(cumPeak / 2)), w - 9, ltop + lgh / 2, size: 9, align: end,
               color: paidInk)
          for i in range(4) {
            text(spendRange == "24h"
                ? fmtTime(now - 86400 + i * 8 * 3600, "HH")
                : spendRange == "7d"
                  ? fmtTime(now - (6 - i * 2) * 86400, "EEE")
                  : fmtTime(now - ((3 - i) / 3) * (n - 1) * 86400, "d/M"),
              w * i / 3, y0 + 9,
              size: 9, align: i == 0 ? "start" : i == 3 ? "end" : "center",
              color: muted)
          }
        }

        // the paid side has no "based on" line, but the free side does: this
        // slot keeps the filter row, the total and the list at the same height
        // on both screens, so flicking between them moves nothing
        Box { height: 20; fill: width }

        // the window the tile's strip reads, picked here too: one state, so the
        // two can never disagree
        Row {
          align: center
          gap: 6
          for r in ["24h", "7d", "30d", "all"] {
            Box {
              width: 46
              height: 26
              align: center
              radius: 8 * corners
              border: 1
              borderColor: alpha(accent, 0.3)
              background: spendRange == r ? alpha(accent, 0.15) : alpha(background, 0.35)
              onTap: { spendRange = r; haptic() }
              Text {
                text: r
                style: small
                color: paidTone
                align: center
                maxLines: 1
              }
            }
          }
          Spacer { weight: 1 }
          Text { text: fmtNum(len(paidModels)) + " " + str.models; style: body; color: muted; width: 96; align: end; maxLines: 1 }
        }

        // the shared total is the chart's home, as it is on the free side:
        // the same three columns, the same five-pixel bar, the same detail row
        Column {
          gap: 3
          fill: width
          Row {
            Text { text: str.allModels; style: body; color: paidInk; weight: 1; maxLines: 1 }
            Text { text: "100%"; style: body; color: paidInk; width: 38; align: end; maxLines: 1 }
            Text {
              text: satCur ? fmtNum(winSats) : "${curSym}${fmtNum(winShow, 2)}"
              style: body
              color: paidInk
              width: 92
              align: end
              maxLines: 1
            }
          }
          Progress {
            value: 100
            color: paidInk
            track: alpha(border, 0.4)
            fill: width
            height: 5
          }
          Row {
            Text { text: rangeLabel + " · " + fmtNum(winReq) + " " + str.req; style: label; color: muted; weight: 1; maxLines: 1 }
            Text { text: fmtNum(bal) + " left"; style: label; color: muted; width: 132; align: end; maxLines: 1 }
          }
        }
        for m in paidModels {
          Column {
            gap: 3
            fill: width
            Row {
              Text { text: m.m; style: body; color: m.m == curModel ? green : foreground; weight: 1; maxLines: 1 }
              Text { text: "now"; style: label; color: green; width: 34; align: end; visible: m.m == curModel; maxLines: 1 }
              Text {
                text: m.sats > 0 ? fmtNum(round(m.sats / paidWinTotal * 100)) + "%" : ""
                style: body
                color: paidInk
                width: 38
                align: end
                maxLines: 1
              }
              Text {
                text: satCur ? fmtNum(m.sats) : "${curSym}${fmtNum(m.sats * fx, 2)}"
                style: body
                color: paidInk
                width: 92
                align: end
                maxLines: 1
              }
            }
            Progress {
              // a model that ran but cost less than a sat still shows a sliver,
              // so a used row never reads as an empty one
              value: m.sats > 0
                ? clamp(m.sats / paidWinTotal * 100, 0, 100)
                : (m.req > 0 ? 2 : 0)
              color: paidInk
              track: alpha(border, 0.4)
              fill: width
              height: 5
            }
            Row {
              Text {
                text: m.p != ""
                  ? replace(replace(m.p, "openrouter:", ""), "generic:", "")
                    + (m.pn > 1 ? " +${m.pn - 1}" : "")
                  : paidProvTxt
                style: label
                color: muted
                weight: 1
                maxLines: 1
              }
              Text {
                text: fmtNum(m.req) + " " + str.req + " · " + fmtBytes(m.tok)
                style: label
                color: muted
                width: 132
                align: end
                maxLines: 1
              }
            }
          }
        }
        if (len(paidModels) == 0) {
          Text { text: str.nothingSpent; style: body; color: muted }
        }

        // who made it, at the foot of this screen and out of the way
        Text {
          text: str.builtBy
          style: small
          color: #ffffff
          align: center
          maxLines: 1
          onTap: url("https://jaquesbody.github.io/")
        }
      } else {
      if totalUsed <= 0 || cur == null {
        Text { text: str.nothingToday; style: title }
        Text { text: "${dailyCap} " + str.requests + " " + str.aDay + " " + str.sharedAllFree; style: small; color: muted }
      } else {
        // numbers first, then at most one line of words each
        // the same day arc as the dial on the tile, beside its own numbers, so
        // the two read as one thing
        Row {
          align: center
          Box {
            width: 62
            height: 62
            align: center
            Canvas {
              width: 62
              height: 62
              let r = 30
              let w = 5.5
              let segs = 16
              let span = 270 / segs
              let gap = 0.18
              let lit = round(clamp(total.pct, 0, 100) / 100 * segs)
              for i in range(segs) {
                let a = 225 + i * span + span * gap / 2
                arc(62 / 2, 62 / 2, r - w / 2, a, span * (1 - gap),
                    stroke: i < lit ? tone : alpha(border, 0.4), width: w, cap: butt)
              }
              if (lit > 0) {
                let a = 225 + (lit - 1) * span + span * gap / 2
                arc(62 / 2, 62 / 2, r - w / 2, a, span * (1 - gap),
                    stroke: foreground, width: w, cap: butt)
              }
            }
            // and the share of the cap inside it, as on the tile
            Text {
              text: pctText
              fontSize: 17
              color: tone
              align: center
              width: 62
            }
          }
          Column {
            gap: 2
            Text { text: "${totalUsed} / ${totalCap}"; style: huge; color: tone; maxLines: 1 }
            Text { text: bankText ? "all · ${verdict} · ${bankText}" : "all models · ${verdict}"; fontSize: 14; color: tone; maxLines: 1 }
          }
        }

        // the rolling five-hour window on the left; on the right the rate and
        // tokens, or the advice when there is one. Folded into the same row on
        // purpose: the chart sits a fixed distance below it, whether or not
        // there is something to say
        Row {
          align: center
          // the inner arc from the tile again: the rolling five-hour window
          Box {
            width: 22
            height: 22
            align: center
            Canvas {
              width: 18
              height: 18
              let segs = 10
              let span = 270 / segs
              let gap = 0.32
              let w = 2
              let r = 8
              let lit = curNoLimit ? 0 : round(clamp(cur.r5h / max(1, cur.win), 0, 1) * segs)
              for i in range(segs) {
                let a = 225 + i * span + span * gap / 2
                arc(9, 9, r - w / 2, a, span * (1 - gap),
                    stroke: i < lit ? fiveHour : alpha(border, 0.25), width: w, cap: butt)
              }
              if (lit > 0) {
                let a = 225 + (lit - 1) * span + span * gap / 2
                arc(9, 9, r - w / 2, a, span * (1 - gap),
                    stroke: foreground, width: w, cap: butt)
              }
            }
          }
          Text {
            text: curNoLimit ? "no limit" : "5h ${cur.r5h}/${cur.win} · peak ${winPeak}/${cur.win}"
            style: label
            color: fiveHour
            width: 184
            maxLines: 1
          }
          Text {
            text: advice != ""
              ? advice
              : busy ? "all ${round(rate * 3600)} req/h · ${fmtBytes(total.tok)}"
                : "all idle · ${fmtBytes(total.tok)}"
            style: label
            color: advice != "" ? adviceTone : fiveHour
            fill: true
            align: end
            maxLines: 1
          }
        }

        // the day in one picture: when it was spent as bars behind, the running
        // total in front of them, both against an even spend of the day
        Canvas {
          height: 190
          fill: width
          let w = width
          let ticks = 11
          let top = 20
          let y0 = height - ticks          // the floor both are drawn on
          let gh = y0 - top
          let dayLen = max(1, db.end - db.day)
          // the scale has to hold the whole band, or the ceiling is off the top;
          // with no ceiling at all, it just has to hold what you spent
          let peak = shownNoLimit ? max(1, shown.used) * 1.12 : max(capHigh, shown.cap) * 1.04
          let yLow = top + gh * (1 - clamp(capLow / peak, 0, 1))
          let yHigh = top + gh * (1 - clamp(capHigh / peak, 0, 1))

          // the band the quota actually falls in
          if (capHigh > 0 && !shownNoLimit) {
            rect(0, yHigh, w, yLow - yHigh, fill: alpha(muted, 0.05))
          }

          // when it was spent, and which machine spent it: one segment per
          // machine that spent anything, this one first, then every device on
          let bw = w / 24
          for i in range(24) {
            let vis = series.filter(x => (x.slots[i] ?? 0) > 0)
            if (len(vis) > 0) {
              for k in range(len(vis)) {
                let hh = max(1, gh * 0.58 * (vis[k].slots[i] ?? 0) / peakSlot)
                let below = sum(vis.take(k).map(x => max(1, gh * 0.58 * (x.slots[i] ?? 0) / peakSlot)))
                rect(bw * i + 1, y0 - below - hh, bw - 2, hh, radius: 1.5 * corners, fill: vis[k].ink)
              }
            } else {
              rect(bw * i + 1, y0 - 2, bw - 2, 2, fill: alpha(muted, 0.18))
            }
          }
          // about. A remote that has gone quiet reads as zero, in yellow, so a
          // silent machine is never mistaken for an idle one
          // one fixed legend line, at the same height as the paid chart's:
          // the cap band moves with the data, but the legend must not
          let ly = top + 2
          let colw = w / max(1, len(series))
          let room = max(5, 16 - len(series))
          for k in range(len(series)) {
            let cx = k * colw
            rect(cx + 2, ly, 10, 10, radius: 2 * corners, fill: series[k].ink)
            text("${sub(series[k].name, 0, room)} ${series[k].used}", cx + 16, ly + 5, size: 9,
                 align: start, color: series[k].ok ? muted : yellow)
          }
          // what this chart is about, said plainly: the shared total by default,
          // or whichever row was tapped to aim it
          text(chartTitle, 0, 10, size: 12, align: start, color: shown.isTotal ? accent : shown.isCur ? green : foreground)
          if (shownBack != null) {
            text(shownBack, w, 10, size: 12, align: end, color: muted)
          }

          // an even spend of the whole day, dashed, then the cap as a flat line
          for i in range(shownNoLimit ? 24 : 0, 24, 2) {
            line(w * i / 24, top + gh * (1 - clamp(shown.cap * i / 24 / peak, 0, 1)), w * (i + 1) / 24, top + gh * (1 - clamp(shown.cap * (i + 1) / 24 / peak, 0, 1)),
                 stroke: alpha(foreground, 0.42), width: 1)
          }
          if (!shownNoLimit) {
            line(0, top + gh * (1 - clamp(shown.cap / peak, 0, 1)), w, top + gh * (1 - clamp(shown.cap / peak, 0, 1)), stroke: alpha(foreground, 0.6), width: 1)
          }

          // the running total: filled down to the floor, then stroked over it
          let nowY = top + gh * (1 - clamp(shown.used / peak, 0, 1))
          let pts = range(25).map(i => [w * i / 24, top + gh * (1 - clamp(sum(shown.slots.take(i + 1)) / peak, 0, 1))])
          let drawn = pts.filter(p => p[0] <= w * dayFrac + 1) + [[w * dayFrac, nowY]]
          if (drawn.length > 1) {
            path(drawn + [[w * dayFrac, y0], [0, y0]], closed: true, fill: alpha(shownTone, 0.18))
          }
          for i in range(24) {
            if (i < 24 * dayFrac) {
              line(w * i / 24, top + gh * (1 - clamp(sum(shown.slots.take(i + 1)) / peak, 0, 1)),
                   w * (i + 1) / 24, top + gh * (1 - clamp(sum(shown.slots.take(i + 2)) / peak, 0, 1)),
                   stroke: shownTone, width: 2.5)
            }
          }

          // where this rate runs you out, as a fraction of the way through the day
          let outAt = clamp(dayFrac + (shown.left / shownRate) / dayLen, dayFrac, 1)
          // the projection, stopping at the cap, drawn as fine dashes
          for i in range(shownNoLimit ? 20 : 0, 20, 2) {
            line(w * (dayFrac + (outAt - dayFrac) * i / 20), top + gh * (1 - clamp(min(shown.cap, shown.used + (outAt - dayFrac) * dayLen * shownRate * i / 20) / peak, 0, 1)),
                 w * (dayFrac + (outAt - dayFrac) * (i + 1) / 20), top + gh * (1 - clamp(min(shown.cap, shown.used + (outAt - dayFrac) * dayLen * shownRate * (i + 1) / 20) / peak, 0, 1)),
                 stroke: accent, width: 2.5)
          }
          // where you are now, and where the rate limit lands
          circle(w * dayFrac, nowY, 4, fill: shownTone)
          if (shown.left > 0 && !shownNoLimit) {
            let yOut = top + gh * (1 - clamp(shown.cap / peak, 0, 1))
            // the drop from the limit back to now, dashed as well
            for i in range(0, 8, 2) {
              line(w * outAt, nowY + (yOut - nowY) * i / 8, w * outAt, nowY + (yOut - nowY) * (i + 1) / 8,
                   stroke: alpha(shownTone, 0.5), width: 1)
            }
            circle(w * outAt, yOut, 4, fill: shownTone)
            // named for what it is, sitting just above its own dot
            text("rate limit", min(w * outAt, w - 42), yOut - 8, size: 9, align: center, color: shownTone)
          }

          // the two scales on show, small and inside the frame: requests per
          // hour behind the bars on the left, the running total on the right,
          // each at its top and halfway mark only
          text("${peakSlot}", 3, y0 - gh * 0.58, size: 9, align: start,
               color: alpha(foreground, 0.7))
          text("${round(peakSlot / 2)}", 3, y0 - gh * 0.29, size: 9, align: start,
               color: alpha(foreground, 0.7))
          text("${round(peak)}", w - 9, top + 32, size: 9, align: end, color: shownTone)
          text("${round(peak / 2)}", w - 9, top + gh / 2, size: 9, align: end, color: shownTone)

          // the clock under the bars
          for i in range(4) {
            text(fmtTime(db.day + i * 6 * 3600, "HH"), w * i * 6 / 24, y0 + 9,
                 size: 9, align: i == 0 ? "start" : i == 3 ? "end" : "center", color: muted)
          }
        }
      }

      // what everything above is measured against, and where to change it, on
      // one line: the numbers, then the pointer at the slider further down.
      // `refresh` asks the database and the other machines now, rather than
      // waiting for the next poll: the tile polls every few minutes so it
      // doesn't cost the battery a live gauge would. Its height is fixed, to
      // match the paid side's slot, so the list below never moves
      Box {
        height: 20
        fill: width
        align: center
        Row {
          fill: width
          align: center
          Text {
            text: str.basedOn + " ~" + capMid + " (" + capLow + "-" + capHigh + ") " + str.aDay + " · " + winCap + "/5hrs · " + str.tweakBelow
            style: small
            color: muted
            maxLines: 1
            weight: 1
          }
        }
      }




      // free models or the whole catalogue; NEW means it was not in the free
      // lineup the last time the widget looked. Fixed at the pills' height so
      // the total and the list start where the paid side's do
      Box {
        height: 26
        fill: width
        align: center
        Row {
          fill: width
          align: center
          Text { text: str.free; style: body; color: showAll ? muted : accent; width: 44; onTap: showAll = false }
          Text { text: "·"; style: label; color: muted; width: 9; align: center }
          Text { text: str.all; style: body; color: showAll ? accent : muted; width: 32; onTap: showAll = true }
          Text { text: "·"; style: label; color: muted; width: 9; align: center }
          Text {
            text: "${showAll ? allIds.length : freeIds.length} models"
            style: body
            color: muted
            width: 86
            maxLines: 1
          }
        }
      }

      // the shared total is the chart's home; a model row drills into that
      // model, and tapping the total row hands the chart back to all of them
      Column {
        gap: 3
        fill: width
        onTap: chartFocus = ""
        Row {
          Text { text: str.allModels; style: body; color: chartFocus == "" ? accent : foreground; weight: 1; maxLines: 1 }
          Text { text: "${round(total.pct)}%"; style: body; color: totalUsed > 0 ? main : muted; width: 38; align: end; maxLines: 1 }
          Text { text: "${totalUsed} / ${totalCap}"; style: body; color: totalUsed > 0 ? main : foreground; width: 92; align: end; maxLines: 1 }
        }
        Progress {
          value: clamp(total.pct, 0, 100)
          color: main
          track: alpha(border, 0.4)
          fill: width
          height: 5
        }
        Row {
          Text { text: str.sharedFree; style: label; color: muted; weight: 1; maxLines: 1 }
          Text { text: max(0, total.left) + " " + str.left; style: label; color: chartFocus == "" ? accent : muted; width: 132; align: end; maxLines: 1 }
        }
      }

      for m in ranked {
        // tap a row to point the chart at that model, tap it again to hand the
        // chart back to the shared all-models total
        Column {
          gap: 3
          fill: width
          onTap: chartFocus = chartFocus == m.id ? "" : m.id
          Row {
            Text { text: m.name; style: body; color: m.isCur ? green : m.isFree && m.r5h >= m.win ? red : m.isFree ? foreground : muted; weight: 1; maxLines: 1 }
            Text { text: str.new; style: label; color: accent; width: 34; align: end; visible: m.isNew }
            Text { text: m.isFree && !m.isUnlimited ? "${round(m.used / max(1, totalCap) * 100)}%" : ""; style: body; color: m.used > 0 ? main : muted; width: 38; align: end; maxLines: 1 }
            Text { text: !m.isFree ? "${m.used}" : m.isUnlimited ? "${m.used} / ∞" : "${m.used} used"; style: body; color: m.used > 0 ? main : foreground; width: 92; align: end; maxLines: 1 }
          }
          Progress {
            value: clamp(m.used / max(1, totalCap) * 100, 0, 100)
            // each bar is that model's bite out of the one shared daily cap,
            // so together they add up to the total row above
            color: main
            track: alpha(border, 0.4)
            fill: width
            height: 5
            visible: m.isFree && !m.isUnlimited
          }
          // what it can do on the left; its own rolling window on the right,
          // which is the only per-model ceiling left
          Row {
            Text { text: m.feats; style: label; color: m.isCur ? green : muted; weight: 1; maxLines: 1 }
            Text {
              text: !m.isFree ? "\$${m.price} per 1M"
                : m.isUnlimited ? "no limit"
                : !m.isLive ? "not in free lineup"
                : "${m.r5h}/${m.win} 5h"
              style: label
              color: m.isCur ? (m.r5h >= m.win ? red : green) : m.r5h >= m.win ? red : muted
              width: 132
              align: end
              maxLines: 1
            }
          }
        }
      }

      // the rate limit, last on the page: editable here, kept across
      // restarts, with a mark at the middle of the band to steer by
      Row {
        align: center
        gap: 6
        Text { text: str.totalDailyCap; style: small; color: muted; width: 104; maxLines: 1; offset: [0, 7] }
        // the mark sits above the track; the label and the value are nudged
        // down so all three still read on the slider's own line
        Box {
          fill: true
          height: 42
          Slider {
            value: dailyCap
            min: capMin
            max: capMax
            step: 10
            height: 28
            fill: width
            offset: [0, 14]
            // the file and its stamp are what the widget pushes and the bar
            // reads; writing them here (rather than in a source) is what makes
            // a change on this phone win over the desktop's
            onChange: {
              dailyCap = value
              run("f=$HOME/.config/opencode-burn/cap; mkdir -p \"$HOME/.config/opencode-burn\"; printf '%s' ${sh(value)} > \"$f\"; date +%s > \"$f.at\"; true")
            }
          }
          Canvas {
            fill: true
            let x = width * (capMid - capMin) / (capMax - capMin)
            line(x, 14, x, 42, stroke: alpha(foreground, 0.5), width: 2)
            text("${capMid}", x, 8, size: 9, align: center, color: muted)
          }
        }
        Text { text: "${dailyCap}"; style: label; color: accent; width: 36; align: end; offset: [0, 7] }

      }

        // who made it, at the foot of this screen and out of the way
        Text {
          text: str.builtBy
          style: small
          color: #ffffff
          align: center
          maxLines: 1
          onTap: url("https://jaquesbody.github.io/")
        }
      }
    }
      }
    }



  }
}

// the gauge in the dial gap counts the models you are not on
