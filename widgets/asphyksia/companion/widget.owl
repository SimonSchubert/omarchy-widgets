widget "companion" {
  size: 3x3
  minSize: 2x2

  meta {
    owl: 5
    description: "The agent as a reactive core: a polar voice waveform, radar attention that locks onto the tool in use, packet streams to and from it. Grows with every interaction."
    version: "1.0"
    license: "MIT"
    category: "dev"
  }

  requires { pacman: ["procps-ng"] }

  // Drive it from this system (one state per call, detail first so it is logged):
  //   owl-send <this widget file> set detail "reading widget.owl"
  //   owl-send <this widget file> set activity bash
  state activity = "idle" persist     // idle | think | bash | read | edit | write | web | error
  state detail = "" persist           // what the agent is doing right now
  state since = 0 persist             // when the current activity started (Unix s)
  state log = [] persist              // last 24 transitions, newest first
  state total = 0 persist             // interactions ever — the core grows with these
  state counts = [0, 0, 0, 0, 0] persist  // per tool, same order as `tools`
  state born = 0 persist              // first interaction (Unix s)

  source now = clock every 1s
  source agents = cmd('c=0; for p in pi claude codex opencode crush grok; do n=$(pgrep -xc "$p" 2>/dev/null || true); c=$((c+n)); done; echo $c') every 10s

  let tools = ["bash", "read", "edit", "web", "think"]
  // signature neon per mode (the current theme is monochrome, so theme
  // names would all glow grey); structure around the core stays themed
  let tint = activity == "bash" ? "#4ade80" : activity == "read" ? "#60a5fa" :
    activity == "edit" ? "#facc15" : activity == "write" ? "#fb923c" :
    activity == "web" ? "#22d3ee" : activity == "think" ? "#c084fc" :
    activity == "error" ? "#f87171" : accent
  let age = since > 0 ? now - since : 0
  // bright while fresh, decays if the agent stops reporting, dim when idle
  let energy = activity == "idle" ? 0.3 : clamp(1.15 - age / 240, 0.15, 1)
  // growth: every interaction counts, the core evolves through stages
  let stage = total >= 400 ? 3 : total >= 120 ? 2 : total >= 30 ? 1 : 0
  let stageNames = ["spark", "sprite", "being", "aura"]
  let countsMax = last(sort(counts)) ?? 0
  let curious = total > 0 ? (counts[1] + counts[3]) / total : 0.5

  on activity {
    // scripts and buttons alike: this mode's clock starts here
    since = now
    log = [[{t: now, tool: value, detail: detail}], log].flatten().take(24)
    total = value != "idle" ? total + 1 : total
    counts = range(len(tools)).map(i => counts[i] + (tools[i] == value ? 1 : 0))
    born = born == 0 && value != "idle" ? now : born
  }
  // scripts send `set detail` before every `set activity`, even when the mode
  // repeats, so a reported detail keeps the clock fresh too. The fallback
  // below writes "went quiet" itself, which must not count as a report.
  on detail {
    since = value == "went quiet" ? since : now
  }
  // a running agent lights it up: on the 0 -> more edge, and also when the
  // widget loads with one already running (`on` skips a first value, `when`
  // does not). It never overrides a mode a script or a button set.
  when num(agents, 0) > 0 {
    detail = activity == "idle" ? "an agent started" : detail
    activity = activity == "idle" ? "think" : activity
  }
  // the last one leaving goes back to idle
  on agents {
    detail = value == 0 && activity == "think" ? "the agents stopped" : detail
    activity = value == 0 && activity == "think" ? "idle" : activity
  }
  // nothing reported for 5 min: settle to idle, unless an agent is still around
  let quiet = activity != "idle" && age > 300 && !(activity == "think" && num(agents, 0) > 0)
  every 10s {
    detail = quiet ? "went quiet" : detail
    activity = quiet ? "idle" : activity
  }

  // The companion: an abstract reactive core. Its waveform is its voice,
  // the radar its attention — searching when idle, locked on the tool in
  // use otherwise, with packets flowing to or from it.
  component Core(ener, col, coreSize, act, stage, cur) {
    Box {
      fill: true
      align: center
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let R = min(width, height) / 2 - 6
        let fr = min(width, height) * 0.30
        let act2 = act == "write" ? "edit" : act
        let ai = indexOf(tools, act2)
        let aang = ai >= 0 ? rad(time * 10 + ai * 360 / len(tools)) : null
        let locked = aang != null
        let nodeCol = act2 == "bash" ? "#4ade80" : act2 == "read" ? "#60a5fa" : act2 == "edit" ? "#facc15" : act2 == "web" ? "#22d3ee" : act2 == "think" ? "#c084fc" : col
        let flick = act == "error" && sin(time * 24) < 0 ? 0.4 : 1

        // --- frame ----------------------------------------------------
        circle(cx, cy, R, stroke: alpha(border, 0.7), width: 1)
        circle(cx, cy, R * 0.62, stroke: alpha(border, 0.35), width: 1)

        // --- chaser tick ring (stage 1+) ------------------------------
        if stage >= 1 {
          for i in range(24) {
            let ta = rad(i * 15 + time * 6)
            let hot = locked ? pow(max(cos(ta - aang), 0), 3) : (i == floor(time * 8) % 24 ? 0.8 : 0)
            let ln = 2.5 + 3 * hot
            line(cx + fr * 1.18 * cos(ta), cy + fr * 1.18 * sin(ta),
              cx + (fr * 1.18 + ln) * cos(ta), cy + (fr * 1.18 + ln) * sin(ta),
              stroke: alpha(col, (0.15 + 0.7 * hot) * flick), width: 1.5)
          }
        }

        // --- voice: polar waveform, one signature per mode ------------
        let lobes = act == "think" ? 3 : act == "bash" ? 7 : act == "read" ? 5 : act == "web" ? 6 : act == "error" ? 11 : 2
        let wspd = act == "idle" ? 1.2 : act == "think" ? 2.5 : act == "bash" ? 9 : act == "read" ? 6 : act == "web" ? 5 : 14
        let wf = (act == "idle" ? 0.025 : act == "think" ? 0.05 : 0.08) * (0.4 + ener)
        path(range(65).map(i => [
          cx + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + time * wspd) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - time * wspd * 0.7) * 0.4 +
            (act == "error" ? sin(rad(i / 64 * 360) * 29 + time * 31) * 0.5 : 0)) * wf) * cos(rad(i / 64 * 360)),
          cy + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + time * wspd) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - time * wspd * 0.7) * 0.4 +
            (act == "error" ? sin(rad(i / 64 * 360) * 29 + time * 31) * 0.5 : 0)) * wf) * sin(rad(i / 64 * 360))
        ]), closed: true, stroke: alpha(col, 0.9 * flick), width: 1.5)
        path(range(65).map(i => [
          cx + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + (time - 0.35) * wspd) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - (time - 0.35) * wspd * 0.4) * 0.4) * wf) * cos(rad(i / 64 * 360)),
          cy + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + (time - 0.35) * wspd) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - (time - 0.35) * wspd * 0.4) * 0.4) * wf) * sin(rad(i / 64 * 360))
        ]), closed: true, stroke: alpha(col, 0.25 * flick), width: 1)

        // --- attention: search sweep, or lock on the tool in use ------
        if !locked {
          rotate(time * (20 + 20 * cur), cx, cy) {
            arc(cx, cy, R * 0.82, 0, 50, stroke: alpha(col, 0.4), width: 2, cap: round)
          }
        } else {
          let nx = cx + R * cos(aang)
          let ny = cy + R * sin(aang)
          line(cx + fr * 1.05 * cos(aang), cy + fr * 1.05 * sin(aang), nx, ny,
            stroke: alpha(nodeCol, 0.25 + 0.5 * ener), width: 1.5)
          // packets: inbound when taking data in, outbound when acting
          let inbound = act == "read" || act == "web"
          for k in range(3) {
            let ph = (time * 0.9 + k / 3) % 1
            let d = inbound ? 1 - ph : ph
            let rr = lerp(fr * 1.05, R, d)
            circle(cx + rr * cos(aang), cy + rr * sin(aang), 1.8, fill: alpha(nodeCol, 0.95 - 0.6 * abs(d - 0.5)))
          }
          // targeting reticle
          circle(nx, ny, 4.5, fill: nodeCol)
          circle(nx, ny, 8 + 2 * sin(time * 5), stroke: alpha(nodeCol, 0.6), width: 1)
          for q in range(4) {
            let ba = aang + rad(45 + q * 90)
            line(nx + 7 * cos(ba), ny + 7 * sin(ba), nx + 11 * cos(ba), ny + 11 * sin(ba),
              stroke: alpha(nodeCol, 0.8), width: 1.5)
          }
        }

        // --- tool nodes ------------------------------------------------
        for t, i in tools {
          let ang = rad(time * 10 + i * 360 / len(tools))
          let x = cx + R * cos(ang)
          let y = cy + R * sin(ang)
          let c = t == "bash" ? "#4ade80" : t == "read" ? "#60a5fa" : t == "edit" ? "#facc15" : t == "web" ? "#22d3ee" : "#c084fc"
          circle(x, y, act2 == t ? 4.5 : 2.5, fill: act2 == t ? c : alpha(c, 0.5))
        }

        // --- thought particles orbiting the core -----------------------
        if act == "think" {
          for k in range(5) {
            let pa = rad(time * 50 + k * 72)
            circle(cx + fr * 0.5 * cos(pa), cy + fr * 0.5 * sin(pa), 1.5, fill: alpha(col, 0.7))
          }
        }

        // --- evolution: structure grows with use -----------------------
        if stage >= 2 {
          rotate(-time * 15, cx, cy) {
            for i in range(12) {
              arc(cx, cy, fr * 1.32, i * 30, 12, stroke: alpha(col, 0.35 * flick), width: 1)
            }
          }
        }
        if stage >= 3 {
          rotate(time * 8, cx, cy) {
            path(range(7).map(i => [cx + fr * 1.45 * cos(rad(i * 60)), cy + fr * 1.45 * sin(rad(i * 60))]),
              closed: true, stroke: alpha(col, 0.3), width: 1)
          }
          for k in range(3) {
            let sa = rad(time * 40 + k * 120)
            circle(cx + fr * 1.45 * cos(sa), cy + fr * 1.45 * sin(sa), 1.6, fill: alpha(col, 0.8))
          }
        }
      }
      Shader {
        size: coreSize
        fallback: accent
        uniforms: { tint: col, energy: ener }
        code: """
          uniform half4 tint;
          uniform float energy;
          half4 main(float2 p) {
            float R = min(size.x, size.y) * 0.5;
            float2 uv = (p - size.xy * 0.5) / R;
            float r = length(uv);
            if (r > 1.05) { return half4(0.0, 0.0, 0.0, 0.0); }
            float a = atan(uv.y, uv.x);
            float t = time * (0.6 + 1.8 * energy);
            float w1 = sin(a * 5.0 + t * 1.7 + sin(r * 9.0 - t * 2.2) * 1.6) * 0.5 + 0.5;
            float w2 = sin(a * 3.0 - t * 1.1 + r * 7.0) * 0.5 + 0.5;
            float plasma = w1 * 0.65 + w2 * 0.35;
            float core = smoothstep(1.0, 0.15, r);
            float rim = exp(-pow((r - 0.85) * 9.0, 2.0));
            float pulse = 0.88 + 0.12 * sin(t * 3.1);
            half3 c = mix(tint.rgb * 0.45, tint.rgb, plasma);
            c = mix(c, half3(1.0), core * plasma * 0.5 * energy);
            c += tint.rgb * rim * (0.3 + 0.6 * energy);
            float alpha = clamp(core * (0.30 + 0.65 * energy) * pulse + rim * 0.45 * energy, 0.0, 1.0);
            return half4(c, alpha * 0.75);
          }
        """
      }
    }
  }

  onTap: screen()

  Column {
    gap: 2
    Box { weight: 1; fill: width; align: center
      Core { ener: energy; col: tint; coreSize: 96; act: activity; stage: stage; cur: curious }
    }
    Row {
      gap: 6
      align: center
      Text { text: activity == "idle" ? "idle" : activity; style: label; color: tint; width: 42 }
      Text {
        text: detail != "" ? detail : num(agents, 0) > 0 ? "${agents} agent${num(agents, 0) == 1 ? "" : "s"} online" : "standing by"
        style: small; color: muted; weight: 1; maxLines: 1
      }
      if activity != "idle" {
        Text { text: fmtDuration(max(age, 0)); style: small; color: muted; width: 44; align: end }
      }
    }
  }

  screen {
    title: "companion"
    Column {
      scroll: true
      gap: 10
      padding: 12
      Box { height: 260; fill: width; align: center
        Core { ener: energy; col: tint; coreSize: 150; act: activity; stage: stage; cur: curious }
      }
      Row {
        gap: 8
        align: center
        Text { text: activity; style: huge; color: tint; weight: 1 }
        if activity != "idle" {
          Text { text: fmtDuration(max(age, 0)); style: title; color: muted; width: 80; align: end }
        }
      }
      Text { text: detail != "" ? detail : "no current task"; style: body; color: muted }

      Text { text: "evolution — ${stageNames[stage]}"; style: muted }
      Row {
        gap: 8
        align: center
        Text { text: "${total} interactions"; style: small; color: foreground; width: 110 }
        Text { text: born > 0 ? "alive ${fmtDuration(max(now - born, 0))}" : "just born"; style: small; color: muted; weight: 1; align: end }
      }
      for t, i in tools key t {
        Row {
          gap: 8
          align: center
          Text { text: t; style: label; color: t == "bash" ? "#4ade80" : t == "read" ? "#60a5fa" : t == "edit" ? "#facc15" : t == "web" ? "#22d3ee" : "#c084fc"; width: 44 }
          Progress { value: countsMax > 0 ? counts[i] / countsMax * 100 : 0; color: t == "bash" ? "#4ade80" : t == "read" ? "#60a5fa" : t == "edit" ? "#facc15" : t == "web" ? "#22d3ee" : "#c084fc"; weight: 1 }
          Text { text: "${counts[i]}"; style: small; font: mono; color: muted; width: 36; align: end }
        }
      }
      Text { text: stage < 3
        ? "curiosity ${round(curious * 100)}% — next form at ${stage == 0 ? 30 : stage == 1 ? 120 : 400} interactions"
        : "curiosity ${round(curious * 100)}% — final form"; style: small; color: muted }

      Text { text: "activity log"; style: muted }
      if len(log) == 0 {
        Text { text: "nothing yet — start an agent or poke a mode below"; style: small; color: muted }
      }
      for e, i in log key i {
        Row {
          gap: 8
          align: center
          Text { text: fmtTime(e.t, "HH:mm:ss"); style: small; font: mono; color: muted; width: 64 }
          Text { text: e.tool; style: label; color: e.tool == "bash" ? "#4ade80" : e.tool == "read" ? "#60a5fa" : e.tool == "edit" ? "#facc15" : e.tool == "write" ? "#fb923c" : e.tool == "web" ? "#22d3ee" : e.tool == "think" ? "#c084fc" : e.tool == "error" ? "#f87171" : accent; width: 52 }
          Text { text: e.detail ?? ""; style: small; color: foreground; weight: 1; maxLines: 1 }
        }
      }

      Text { text: "try a mode"; style: muted }
      Flow {
        gap: 6
        for t in tools {
          Button {
            text: t
            color: t == "bash" ? "#4ade80" : t == "read" ? "#60a5fa" : t == "edit" ? "#facc15" : t == "web" ? "#22d3ee" : "#c084fc"
            onTap: { detail = "manual test"; activity = t }
          }
        }
        Button { text: "idle"; color: muted; onTap: { detail = ""; activity = "idle" } }
      }
      Text {
        text: "any script can drive it, one state per call: owl-send <this widget file> set detail \"reading widget.owl\", then owl-send <this widget file> set activity bash. It also lights up on its own while an agent (pi, claude, codex…) is running, and settles back to idle when it stops."
        style: small; color: muted
      }
      Button { text: "close"; onTap: close() }
    }
  }
}
