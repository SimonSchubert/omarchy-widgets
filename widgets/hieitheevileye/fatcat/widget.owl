widget "fatcat" {
  meta {
    owl: 3
    description: "A gloriously chubby cat that loafs, purrs, naps, and demands snacks on your home screen"
    version: "1.0.1"
    license: "MIT"
    category: "fun"
  }
  size: 3x3
  minSize: 2x2

  source now = clock every 1s
  source bat = android.battery
  source m = android.media

  state born = 0 persist
  state snacks = 0 persist
  state pets = 0 persist
  state fed = 0 persist
  state petAt = 0 persist
  state tapAt = -100
  state tapNow = 0
  state tapKind = ""

  let hour = num(fmtTime(now, "H"))
  let asleep = (hour >= 23 || hour < 7)
  let hungry = fed > 0 && now - fed > 4 * 3600
  let dancing = m.playing == true
  let tired = bat != null && bat.level < 15 && !bat.charging
  let day = born > 0 ? floor((now - born) / 86400) + 1 : 1
  let ago = fed > 0 ? (now - fed < 3600 ? "${max(floor((now - fed) / 60), 1)}m" : "${floor((now - fed) / 3600)}h") : "never"

  let recentlyFed = tapKind == "snack" && now - tapNow < 3
  let recentlyPet = tapKind == "pet" && now - tapNow < 3
  let mood = asleep ? "asleep"
    : recentlyFed ? "eating"
    : recentlyPet ? "purring"
    : dancing ? "dancing"
    : hungry ? "hungry"
    : tired ? "tired"
    : "content"

  let chonkTier = snacks < 8 ? "FINE BOI"
    : snacks < 20 ? "A CHONKER"
    : snacks < 38 ? "HEFTY CHONK"
    : snacks < 60 ? "MEGACHONKER"
    : "OH LAWD HE COMIN'"

  let weightLbs = 11 + round(snacks * 0.4, 1)

  // Status line: one line when it fits, else two lines split at a " · " (the most even split), so
  // nothing is dropped. A mono small cell is ~6.4 dp and the tile's padding ~30 dp: the portrait tile
  // (197 dp) fits 26 cells a line and the landscape one (218 dp) 29. ♥︎ is two code points but one cell.
  let statusCap = tileWidth != null ? floor((tileWidth - 30) / 6.4) : 99
  let statusParts = cols != null && cols < 3 ?
    [mood == "asleep" ? "zzz · ${chonkTier}"
    : mood == "eating" ? "nom nom! ${weightLbs} lb"
    : mood == "purring" ? "purr~ ♥︎${pets} · ${weightLbs} lb"
    : mood == "dancing" ? "♪ ${lower(m.title ?? "music")}"
    : mood == "hungry" ? "hungry · tap bowl"
    : mood == "tired" ? "sleepy · ${bat.level}%"
    : "${chonkTier} · ${weightLbs} lb"]
    : mood == "asleep" ? ["zzz", "${chonkTier} (${weightLbs} lb)", "day ${day}"]
    : mood == "eating" ? ["nom nom nom!", "treats: ${snacks}"]
    : mood == "purring" ? ["purring~", "♥︎${pets} pets", "${chonkTier} (${weightLbs} lb)"]
    : mood == "dancing" ? ["♪ ${lower(m.title ?? "groovin'")}", "${weightLbs} lb"]
    : mood == "hungry" ? ["hungry", "fed ${ago} ago", "tap bowl!"]
    : mood == "tired" ? ["sleepy loaf", "battery ${bat.level}%"]
    : ["${chonkTier}", "${weightLbs} lb", "♥︎${pets}", "day ${day}"]
  let statusOne = join(statusParts, " · ")
  let statusSplits = range(1, len(statusParts)).map(k => [join(take(statusParts, k), " · "), join(drop(statusParts, k), " · ")])
  let statusSplit = first(statusSplits.sortBy(l => max(len(replace(l[0], "♥︎", "♥")), len(replace(l[1], "♥︎", "♥")))))
  let status = len(replace(statusOne, "♥︎", "♥")) <= statusCap || statusSplit == null ? statusOne : join(statusSplit, "\n")

  // Pixel art sprites: 22x15 cat loaf, 6x7 wagging tail, 9x5 food bowl, 7x7 fish treat.
  let catArt = [
    "....bb..........bb....",
    "...bppb........bppb...",
    "..bpffpb.ssss.bpffpb..",
    "..bfffffbssssbfffffb..",
    ".bffffffffssffffffffb.",
    ".bffffffffffffffffffb.",
    "bffffffffffffffffffffb",
    "bfffffffffnnfffffffffb",
    "bfffffffffwwfffffffffb",
    ".bffffffffffffffffffb.",
    "bsssffffffffffffffsssb",
    "bssffffBBBBBBBBffffssb",
    "bffffBBBBBBBBBBBBffffb",
    "bffffBpppBBBBpppBffffb",
    "..bbbbbbbbbbbbbbbbbb.."
  ]

  let tailArt = [
    "..bb..",
    ".bsffb",
    ".bffsb",
    ".bsffb",
    "..bffb",
    "...bfb",
    "....bb"
  ]

  let bowlEmptyArt = [
    ".bbbbbbb.",
    "bmmmmmmmb",
    "bmmmmmmmb",
    ".bmmmmmb.",
    "..bbbbb.."
  ]

  let bowlFullArt = [
    "..ffkff..",
    ".bbbbbbb.",
    "bmmfkmfmb",
    ".bmmmmmb.",
    "..bbbbb.."
  ]

  let fishArt = [
    "..bb...",
    ".bFFb..",
    "bFFFFb.",
    "bFFkFFb",
    "bFFFFb.",
    ".bFFb..",
    "..bb..."
  ]

  let heartArt = [
    ".h.h.",
    "hhhhh",
    "hhhhh",
    ".hhh.",
    "..h.."
  ]

  let pal = {
    b: mix(orange, background, 0.65),
    f: orange,
    s: mix(orange, background, 0.35),
    p: mix(red, yellow, 0.3),
    B: mix(yellow, background, 0.1),
    n: mix(red, yellow, 0.25),
    w: mix(orange, background, 0.65),
    m: mix(cyan, foreground, 0.3),
    k: foreground,
    F: cyan,
    h: red
  }

  Column {
    gap: 2
    Canvas {
      weight: 1
      fill: width
      onTap: {
        tapKind = asleep ? "peek" : (hungry || x > (tileWidth ?? 160) * 0.55) ? "snack" : "pet"
        tapAt = time
        tapNow = now
        snacks = (hungry || x > (tileWidth ?? 160) * 0.55) && !asleep ? snacks + 1 : snacks
        fed = (hungry || x > (tileWidth ?? 160) * 0.55) && !asleep ? now : fed
        pets = !asleep && !hungry && !(x > (tileWidth ?? 160) * 0.55) ? pets + 1 : pets
        petAt = !asleep && !hungry && !(x > (tileWidth ?? 160) * 0.55) ? now : petAt
        born = born > 0 ? born : now
      }

      let p = clamp(floor(min(width / 26, height / 24)), 2, 7)
      let s = p + 0.5
      // Idle effects step on `now` (once a second); the frame clock `time` is
      // only read for a few seconds after a tap, and while music plays.
      let since = now - tapNow < 5 && time >= tapAt ? time - tapAt : 1000
      let happy = since < 3 && tapKind == "pet"
      let eating = since < 2.5 && tapKind == "snack"

      let rugY = floor((height - 3 * p) / p) * p
      let ox = floor((width / 2 - 11 * p) / p) * p - 2 * p
      let oy = rugY - 14 * p
      let bowlX = ox + 18 * p
      let bowlY = rugY - 2 * p

      // Night sky: moon and twinkle stars
      if asleep {
        circle(ox + 3 * p, oy - 2 * p, 3 * p, fill: yellow)
        circle(ox + 4 * p, oy - 3 * p, 2.5 * p, fill: background)
        for k in range(5) {
          let sx = ox + (k * 4 + 1) * p
          let sy = oy - (2 + (k * 3) % 4) * p
          rect(sx, sy, p, p, fill: alpha(foreground, 0.2 + 0.5 * abs(sin(now * 0.9 + k * 1.7))))
        }
      }

      // Cozy woven floor rug
      rect(ox - 2 * p, rugY, 26 * p, 3 * p, radius: p * 1.5, fill: mix(surface, background, 0.4))
      rect(ox, rugY + p * 0.5, 22 * p, p * 1.5, radius: p, fill: mix(border, surface, 0.4))

      // Movement & animations
      let breath = (asleep ? floor(now / 2) % 2 : now % 2) * p
      let purrVibe = happy ? sin(time * 30) * 0.5 * p : 0
      let danceX = dancing ? [0, 1, 0, -1][floor(time * 2.5) % 4] * p : 0
      let danceY = dancing ? [0, -1, 0, 1][floor(time * 2.5) % 4] * (p * 0.5) : 0

      let bx = ox + danceX
      let by = oy + purrVibe + danceY

      // Swishing tail behind right hip
      let tailAngle = dancing ? sin(time * 6) * 20 : [0, 12, 0, -12][now % 4]
      rotate(tailAngle, bx + 19 * p, by + 13 * p) {
        sprite(tailArt, bx + 18 * p, by + 7 * p, p, palette: pal)
      }

      // Main fat cat body loaf
      sprite(catArt, bx, by + breath, p, palette: pal)

      // Whiskers twitching
      let twitch = happy ? sin(time * 25) * p * 0.6 : 0
      line(bx + p, by + breath + 7 * p, bx - 3 * p, by + breath + 6 * p + twitch, stroke: pal.b, width: max(p * 0.7, 1))
      line(bx + p, by + breath + 8 * p, bx - 3 * p, by + breath + 9 * p + twitch, stroke: pal.b, width: max(p * 0.7, 1))
      line(bx + 21 * p, by + breath + 7 * p, bx + 25 * p, by + breath + 6 * p - twitch, stroke: pal.b, width: max(p * 0.7, 1))
      line(bx + 21 * p, by + breath + 8 * p, bx + 25 * p, by + breath + 9 * p - twitch, stroke: pal.b, width: max(p * 0.7, 1))

      // Eyes & expressions
      let ey = by + breath + 5 * p
      let blink = now % 7 == 3
      if asleep && !(tapKind == "peek" && since < 2) {
        rect(bx + 5 * p, ey, 3 * p, s, fill: pal.b)
        rect(bx + 14 * p, ey, 3 * p, s, fill: pal.b)
        for k in range(3) {
          let t = ((now + k * 2) % 6) / 6
          text("z", bx + 15 * p + t * 4 * p, by + 2 * p - t * 8 * p, size: (2 + t * 2) * p, bold: true, color: alpha(foreground, 1 - t))
        }
      } else if asleep {
        // Peek: one grumpy eye
        rect(bx + 5 * p, ey, 3 * p, s, fill: pal.b)
        rect(bx + 14 * p, ey - p * 0.5, 3 * p, 2 * p, fill: background)
        rect(bx + 15 * p, ey, p, p, fill: yellow)
      } else if happy || (eating && since > 0.8) || dancing {
        // Happy squint
        for e in [5, 14] {
          line(bx + e * p, ey + p, bx + (e + 1.5) * p, ey - p * 0.5, stroke: pal.b, width: max(p * 0.8, 1), cap: round)
          line(bx + (e + 1.5) * p, ey - p * 0.5, bx + (e + 3) * p, ey + p, stroke: pal.b, width: max(p * 0.8, 1), cap: round)
        }
      } else if blink {
        rect(bx + 5 * p, ey, 3 * p, s, fill: pal.b)
        rect(bx + 14 * p, ey, 3 * p, s, fill: pal.b)
      } else {
        // Looking around
        let lookX = [0, 1, 0, -1][floor(now / 3) % 4] * p * 0.4
        for e in [5, 14] {
          circle(bx + (e + 1.5) * p, ey + p * 0.5, p * 1.5, fill: mix(green, yellow, 0.4))
          circle(bx + (e + 1.5) * p + lookX, ey + p * 0.5, p * 0.8, fill: background)
          rect(bx + (e + 1.8) * p, ey - p * 0.2, p * 0.6, p * 0.6, fill: foreground)
        }
      }

      // Food bowl and eating animations
      if eating && since < 0.8 {
        let fishY = lerp(by - 5 * p, bowlY - 3 * p, since / 0.8)
        sprite(fishArt, bowlX + p, fishY, p, palette: pal)
      }

      if eating && since >= 0.8 {
        sprite(bowlFullArt, bowlX, bowlY, p, palette: pal)
        if floor(since * 8) % 2 == 0 {
          rect(bx + 10 * p, by + breath + 8 * p, 2 * p, p * 1.2, fill: background)
        }
        for k in range(3) {
          let f = since - 0.8
          rect(bowlX + (1 + k * 2) * p + (k - 1) * f * 5 * p, bowlY - p + f * f * 16 * p, p, p, fill: yellow)
        }
      } else if hungry {
        sprite(bowlEmptyArt, bowlX, bowlY, p, palette: pal)
      } else {
        sprite(bowlFullArt, bowlX, bowlY, p, palette: pal)
      }

      // Purring floating hearts
      if happy {
        for k in range(3) {
          let t = since - k * 0.35
          if t > 0 && t < 1.8 {
            layer(1 - t / 1.8) {
              sprite(heartArt, floor((bx + [3, 11, 18][k] * p + sin(t * 5 + k) * p) / p) * p, floor((by - t * 6 * p) / p) * p, p, palette: pal)
            }
          }
        }
      }

      // Dancing musical notes
      if dancing {
        for k in range(2) {
          let t = (time * 0.5 + k / 2) % 1
          let nx = floor((bx + (k == 0 ? -1 : 23) * p + sin(t * 6) * p) / p) * p
          let ny = floor((by + 5 * p - t * 8 * p) / p) * p
          let nc = alpha(k == 0 ? cyan : magenta, 1 - t)
          rect(nx, ny + 2 * p, 2 * p, 2 * p, fill: nc)
          rect(nx + p, ny - p, p, 3 * p, fill: nc)
          rect(nx + 2 * p, ny - p, p, p, fill: nc)
        }
      }

      // Hungry thought bubble
      if hungry && !eating {
        let cloud = mix(foreground, background, 0.35)
        let tx = bx + 14 * p
        let ty = max(by - 7 * p, 0)
        circle(tx - 2 * p, ty + 5 * p, p * 0.7, fill: cloud)
        circle(tx - p, ty + 3 * p, p * 1.1, fill: cloud)
        rect(tx, ty, 8 * p, 6 * p, radius: p * 1.5, fill: cloud)
        sprite(fishArt, tx + p, ty + p, p, palette: pal)
      }
    }

    Text {
      font: mono
      style: small
      color: muted
      align: center
      maxLines: 2
      text: status
    }
  }
}
