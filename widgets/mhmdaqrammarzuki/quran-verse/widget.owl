// A verse of the day from the Qur'an, in Arabic and in the reader's own language.
//
// Rewritten from "bible-verse" by Dustin Montgomery (en3r0), published in
// SimonSchubert/omarchy-widgets — MIT, Copyright (c) 2026 Simon Schubert and
// contributors. The original fetched one NIV verse a day from ourmanna.com; this
// version fetches a verse and its translation from api.alquran.cloud, and adds a
// language picker that also switches the interface language.
//
// Released under the MIT License. The full text is in the README next to this one,
// and is reproduced on the widget's screen.
//
// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
// IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.
widget "quran-verse" {
  size: 6x3
  minSize: 3x2
  requires { pacman: [] }
  meta {
    owl: 9
    description: "A verse of the day from the Qur'an, in Arabic and in your language"
    version: "1.2"
    license: "MIT"
    category: "productivity"
  }

  // One entry per language. Fields:
  //   code     persisted value of `lang`, and the key that keeps chip rows stable
  //   label    romanized name; the tile's button, and the top line of the chip
  //   native   name in its own script, the chip's second line; omitted where it
  //            would just repeat `label` (the Latin-script languages)
  //   nw       em width of one `native` character. CJK and Hangul fill the em
  //            square (1.0); Cyrillic and Arabic are a little over half; Devanagari
  //            and Bengali are much narrower than they count, because len() counts
  //            the vowel signs that hang off the letters but are not drawn. Without
  //            this the chips cannot be measured, only guessed, and they clip.
  //   edition  identifier of the translation on api.alquran.cloud
  //   t        the interface in this language
  let langs = [
    {code: "id", label: "Bahasa", edition: "id.indonesian",
     t: {title: "ayat hari ini", expand: "Buka ▼", collapse: "Tutup ▲", close: "tutup",
         choose: "pilih bahasa", copy: "salin", share: "bagikan",
         about: "Isi widget ini", notes: "Catatan", kLevel: "Tingkat bahasa", kNodes: "Node", kExpr: "Ekspresi", kAct: "Aksi", kSrc: "Sumber", kState: "State tersimpan", kFonts: "Font", kScripts: "Skrip", kLangs: "Bahasa", kPkg: "Paket"}},
    {code: "en", label: "English", edition: "en.asad",
     t: {title: "verse of the day", expand: "Expand ▼", collapse: "Collapse ▲", close: "close",
         choose: "choose a language", copy: "copy", share: "share",
         about: "What is in this widget", notes: "Notes", kLevel: "Language level", kNodes: "Nodes", kExpr: "Expressions", kAct: "Actions", kSrc: "Sources", kState: "Persisted state", kFonts: "Fonts", kScripts: "Scripts drawn", kLangs: "Languages", kPkg: "Package needed"}},
    {code: "ms", label: "Melayu", edition: "ms.basmeih",
     t: {title: "ayat hari ini", expand: "Buka ▼", collapse: "Tutup ▲", close: "tutup",
         choose: "pilih bahasa", copy: "salin", share: "kongsi",
         about: "Apa dalam widget ini", notes: "Nota", kLevel: "Tahap bahasa", kNodes: "Nod", kExpr: "Ungkapan", kAct: "Tindakan", kSrc: "Sumber", kState: "Keadaan disimpan", kFonts: "Font", kScripts: "Skrip", kLangs: "Bahasa", kPkg: "Pakej"}},
    {code: "es", label: "Español", edition: "es.garcia",
     t: {title: "versículo del día", expand: "Expandir ▼", collapse: "Contraer ▲", close: "cerrar",
         choose: "elegir un idioma", copy: "copiar", share: "compartir",
         about: "Qué hay en este widget", notes: "Notas", kLevel: "Nivel de lenguaje", kNodes: "Nodos", kExpr: "Expresiones", kAct: "Acciones", kSrc: "Fuentes", kState: "Estado guardado", kFonts: "Fuentes tipográficas", kScripts: "Escrituras", kLangs: "Idiomas", kPkg: "Paquete"}},
    {code: "ja", label: "Nihongo", native: "日本語", nw: 1.0, edition: "ja.japanese",
     t: {title: "今日のアヤ", expand: "開く ▼", collapse: "閉じる ▲", close: "閉じる",
         choose: "言語を選ぶ", copy: "コピー", share: "共有",
         about: "このウィジェットの中身", notes: "注記", kLevel: "言語レベル", kNodes: "ノード", kExpr: "式", kAct: "アクション", kSrc: "ソース", kState: "保存される状態", kFonts: "フォント", kScripts: "文字種", kLangs: "言語", kPkg: "パッケージ"}},
    {code: "zh", label: "Zhongwen", native: "中文", nw: 1.0, edition: "zh.mazhonggang",
     t: {title: "今日经文", expand: "展开 ▼", collapse: "收起 ▲", close: "关闭",
         choose: "选择语言", copy: "复制", share: "分享",
         about: "这个小组件包含什么", notes: "说明", kLevel: "语言级别", kNodes: "节点", kExpr: "表达式", kAct: "动作", kSrc: "数据源", kState: "持久化状态", kFonts: "字体", kScripts: "文字系统", kLangs: "语言", kPkg: "软件包"}},
    {code: "ko", label: "Hangugeo", native: "한국어", nw: 1.0, edition: "ko.korean",
     t: {title: "오늘의 경문", expand: "펼치기 ▼", collapse: "접기 ▲", close: "닫기",
         choose: "언어 선택", copy: "복사", share: "공유",
         about: "이 위젯에 담긴 것", notes: "참고", kLevel: "언어 수준", kNodes: "노드", kExpr: "표현식", kAct: "동작", kSrc: "소스", kState: "저장되는 상태", kFonts: "글꼴", kScripts: "문자 체계", kLangs: "언어", kPkg: "패키지"}},
    {code: "tr", label: "Türkçe", edition: "tr.diyanet",
     t: {title: "bugünün ayeti", expand: "Aç ▼", collapse: "Kapat ▲", close: "kapat",
         choose: "bir dil seçin", copy: "kopyala", share: "paylaş",
         about: "Bu bileşende ne var", notes: "Notlar", kLevel: "Dil düzeyi", kNodes: "Düğümler", kExpr: "İfadeler", kAct: "Eylemler", kSrc: "Kaynaklar", kState: "Kalıcı durum", kFonts: "Yazı tipleri", kScripts: "Yazı sistemleri", kLangs: "Diller", kPkg: "Paket"}},
    {code: "fr", label: "Français", edition: "fr.hamidullah",
     t: {title: "verset du jour", expand: "Ouvrir ▼", collapse: "Fermer ▲", close: "fermer",
         choose: "choisir une langue", copy: "copier", share: "partager",
         about: "Ce que contient ce widget", notes: "Notes", kLevel: "Niveau du langage", kNodes: "Nœuds", kExpr: "Expressions", kAct: "Actions", kSrc: "Sources", kState: "État conservé", kFonts: "Polices", kScripts: "Écritures", kLangs: "Langues", kPkg: "Paquet"}},
    {code: "de", label: "Deutsch", edition: "de.aburida",
     t: {title: "Vers des Tages", expand: "Öffnen ▼", collapse: "Schließen ▲", close: "Schließen",
         choose: "Sprache wählen", copy: "Kopieren", share: "Teilen",
         about: "Was in diesem Widget steckt", notes: "Hinweise", kLevel: "Sprachstufe", kNodes: "Knoten", kExpr: "Ausdrücke", kAct: "Aktionen", kSrc: "Quellen", kState: "Gespeicherter Zustand", kFonts: "Schriften", kScripts: "Schriftsysteme", kLangs: "Sprachen", kPkg: "Paket"}},
    {code: "ru", label: "Russkiy", native: "Русский", nw: 0.6, edition: "ru.kuliev",
     t: {title: "айят дня", expand: "Открыть ▼", collapse: "Закрыть ▲", close: "Закрыть",
         choose: "выбрать язык", copy: "Копировать", share: "Поделиться",
         about: "Что есть в этом виджете", notes: "Примечания", kLevel: "Уровень языка", kNodes: "Узлы", kExpr: "Выражения", kAct: "Действия", kSrc: "Источники", kState: "Сохраняемое состояние", kFonts: "Шрифты", kScripts: "Системы письма", kLangs: "Языки", kPkg: "Пакет"}},
    {code: "it", label: "Italiano", edition: "it.piccardo",
     t: {title: "versetto del giorno", expand: "Apri ▼", collapse: "Chiudi ▲", close: "chiudi",
         choose: "scegli una lingua", copy: "copia", share: "condividi",
         about: "Cosa c'è in questo widget", notes: "Note", kLevel: "Livello del linguaggio", kNodes: "Nodi", kExpr: "Espressioni", kAct: "Azioni", kSrc: "Sorgenti", kState: "Stato salvato", kFonts: "Caratteri", kScripts: "Sistemi di scrittura", kLangs: "Lingue", kPkg: "Pacchetto"}},
    {code: "nl", label: "Nederlands", edition: "nl.leemhuis",
     t: {title: "vers van vandaag", expand: "Openen ▼", collapse: "Sluiten ▲", close: "sluiten",
         choose: "kies een taal", copy: "kopieren", share: "delen",
         about: "Wat er in deze widget zit", notes: "Opmerkingen", kLevel: "Taalniveau", kNodes: "Nodes", kExpr: "Expressies", kAct: "Acties", kSrc: "Bronnen", kState: "Bewaarde status", kFonts: "Lettertypen", kScripts: "Schriftsystemen", kLangs: "Talen", kPkg: "Pakket"}},
    {code: "pl", label: "Polski", edition: "pl.bielawskiego",
     t: {title: "werset dnia", expand: "Otwórz ▼", collapse: "Zamknij ▲", close: "zamknij",
         choose: "wybierz język", copy: "kopiuj", share: "udostępnij",
         about: "Co jest w tym widżecie", notes: "Uwagi", kLevel: "Poziom języka", kNodes: "Węzły", kExpr: "Wyrażenia", kAct: "Akcje", kSrc: "Źródła", kState: "Zapisany stan", kFonts: "Kroje pisma", kScripts: "Systemy pisma", kLangs: "Języki", kPkg: "Pakiet"}},
    {code: "hi", label: "Hindi", native: "हिन्दी", nw: 0.42, edition: "hi.hindi",
     t: {title: "आज का आयत", expand: "खोलें ▼", collapse: "बंद करें ▲", close: "बंद करें",
         choose: "भाषा चुनें", copy: "कॉपी", share: "साझा करें",
         about: "इस विजेट में क्या है", notes: "टिप्पणियाँ", kLevel: "भाषा स्तर", kNodes: "नोड", kExpr: "अभिव्यक्तियाँ", kAct: "क्रियाएँ", kSrc: "स्रोत", kState: "सहेजा गया स्थिति", kFonts: "फ़ॉन्ट", kScripts: "लिपियाँ", kLangs: "भाषाएँ", kPkg: "पैकेज"}},
    {code: "bn", label: "Bengali", native: "বাংলা", nw: 0.45, edition: "bn.bengali",
     t: {title: "আজকের আয়াত", expand: "খুলুন ▼", collapse: "বন্ধ করুন ▲", close: "বন্ধ করুন",
         choose: "ভাষা বেছে নিন", copy: "কপি", share: "শেয়ার করুন",
         about: "এই উইজেটে কী আছে", notes: "নোট", kLevel: "ভাষার স্তর", kNodes: "নোড", kExpr: "প্রকাশকলি", kAct: "কাজ", kSrc: "উৎস", kState: "সংরক্ষিত অবস্থা", kFonts: "ফন্ট", kScripts: "লিপি", kLangs: "ভাষা", kPkg: "প্যাকেজ"}},
    {code: "ur", label: "Urdu", native: "اردو", nw: 0.52, edition: "ur.ahmedali",
     t: {title: "آج کا آیت", expand: "کھولیں ▼", collapse: "بند کریں ▲", close: "بند کریں",
         choose: "زبان منتخب کریں", copy: "نقل کریں", share: "شیئر کریں",
         about: "اس ویجٹ میں کیا ہے", notes: "نوٹس", kLevel: "زبان کا سطح", kNodes: "نوڈ", kExpr: "تعبیرات", kAct: "ایکشنز", kSrc: "ذرائع", kState: "محفوظ حالت", kFonts: "فونٹ", kScripts: "رسم الخط", kLangs: "زبانیں", kPkg: "پیکیج"}},
    {code: "ta", label: "Tamil", native: "தமிழ்", nw: 0.65, edition: "ta.tamil",
     t: {title: "இன்றைய ஆய்தம்", expand: "திற ▼", collapse: "மூடு ▲", close: "மூடு",
         choose: "மொழியைத் தேர்ந்தெடுக்கவும்", copy: "நகலெடு", share: "பகிர்",
         about: "இந்த விட்ஜெட்டில் என்ன உள்ளது", notes: "குறிப்புகள்", kLevel: "மொழி நிலை", kNodes: "கணுக்கள்", kExpr: "வெளிப்பாடுகள்", kAct: "செயல்கள்", kSrc: "ஆதாரங்கள்", kState: "சேமிக்கப்பட்ட நிலை", kFonts: "எழுத்துருக்கள்", kScripts: "எழுத்துகள்", kLangs: "மொழிகள்", kPkg: "தொகுப்பு"}},
    {code: "th", label: "Thai", native: "ไทย", nw: 0.55, edition: "th.thai",
     t: {title: "อายต์ของวันนี้", expand: "เปิด ▼", collapse: "ปิด ▲", close: "ปิด",
         choose: "เลือกภาษา", copy: "คัดลอก", share: "แชร์",
         about: "มีอะไรอยู่ในวิดเจ็ตนี้", notes: "หมายเหตุ", kLevel: "ระดับภาษา", kNodes: "โหนด", kExpr: "นิพจน์", kAct: "การกระทำ", kSrc: "แหล่งที่มา", kState: "สถานะที่บันทึกไว้", kFonts: "แบบอักษร", kScripts: "ระบบการเขียน", kLangs: "ภาษา", kPkg: "แพ็กเกจ"}},
    {code: "sw", label: "Kiswahili", edition: "sw.barwani",
     t: {title: "aya ya leo", expand: "Fungua ▼", collapse: "Funga ▲", close: "funga",
         choose: "chagua lugha", copy: "nakili", share: "shiriki",
         about: "Kitu kilichomo kwenye kijiko hiki", notes: "Maelezo", kLevel: "Kiwango cha lugha", kNodes: "Fundo", kExpr: "Mielezi", kAct: "Vitendeleo", kSrc: "Vyanzo", kState: "Hali iliyohifadhiwa", kFonts: "Fonti", kScripts: "Mifumo ya kuandika", kLangs: "Lugha", kPkg: "Kifurushi"}},
    {code: "sv", label: "Svenska", edition: "sv.bernstrom",
     t: {title: "dagens vers", expand: "Öppna ▼", collapse: "Stäng ▲", close: "stäng",
         choose: "välj språk", copy: "kopiera", share: "dela",
         about: "Vad som finns i den här widgeten", notes: "Anteckningar", kLevel: "Språknivå", kNodes: "Noder", kExpr: "Uttryck", kAct: "Åtgärder", kSrc: "Källor", kState: "Sparat tillstånd", kFonts: "Typsnitt", kScripts: "Skriftsystem", kLangs: "Språk", kPkg: "Paket"}},
    {code: "no", label: "Norsk", edition: "no.berg",
     t: {title: "dagens vers", expand: "Åpne ▼", collapse: "Lukk ▲", close: "lukk",
         choose: "velg språk", copy: "kopier", share: "del",
         about: "Hva som er i denne widgeten", notes: "Noter", kLevel: "Språknivå", kNodes: "Noder", kExpr: "Uttrykk", kAct: "Handlinger", kSrc: "Kilder", kState: "Lagret tilstand", kFonts: "Skrifttyper", kScripts: "Skriftsystemer", kLangs: "Språk", kPkg: "Pakke"}},
    {code: "ku", label: "Kurdî", native: "کوردی", nw: 0.55, edition: "ku.asan",
     t: {title: "ئایەتی ڕۆژ", expand: "کردنەوە ▼", collapse: "داخستن ▲", close: "داخستن",
         choose: "زمانێک هەڵبژێرە", copy: "کۆپی", share: "هاوبەشکردن",
         about: "چی لەم ویجێتدا هەیە", notes: "تێبینی",
         kLevel: "ئاستی زمان", kNodes: "گرێک", kExpr: "دەرەکان",
         kAct: "کردارەکان", kSrc: "سەرچاوەکان", kState: "دۆخی پاشەکەوتکراو",
         kFonts: "فۆنتەکان", kScripts: "ئەلفوبێیە نووسراوەکان",
         kLangs: "زمانەکان", kPkg: "پاکێجی پێویست"}}
  ]
  let pick = langs.find(l => l.code == lang) ?? langs[0]
  // api.alquran.cloud has no "verse of the day" endpoint, so the day's number picks
  // one out of the 6236 with hash(): the days do not walk the verses in order,
  // one surah at a time, but scatter over the range. Same verse all day, a new
  // one tomorrow.
  let day = floor((now ?? 0) / 86400)
  let n = floor(hash("ayah", day) * 6236) + 1

  source now = clock every 1m
  source ar = http("https://api.alquran.cloud/v1/ayah/${enc(int(n))}/ar.alquran") json timeout 10s
  source tr = http("https://api.alquran.cloud/v1/ayah/${enc(int(n))}/${enc(pick.edition)}") json timeout 10s
  // Korean is the only edition here that truncates: 2:286 comes back as three
  // characters. When a translation comes back far shorter than the Arabic it
  // translates, that is one of those, and an English copy stands in. A null URL
  // pauses the source, so it only ever fetches for Korean.
  source fb = http(pick.edition == "ko.korean" ? "https://api.alquran.cloud/v1/ayah/${enc(int(n))}/en.asad" : null) json timeout 10s

  state lang = "en" persist
  state arab = true persist
  state picker = false
  state last = null persist
  // Both sections on the screen start folded, so the screen opens on the verse itself.
  // Not persisted: a fresh open always starts short.
  state showParts = false
  state showNotes = false

  let arabic = trim(ar.data.text ?? "")
  let clipped = len(trim(tr.data.text ?? "")) < len(arabic) * 0.1
  let ayah = tr.data == null ? null : {
    arabic: arabic,
    text: clipped ? trim(fb.data.text ?? tr.data.text) : trim(tr.data.text),
    ref: "${tr.data.surah.englishName}: ${tr.data.numberInSurah}"
  }
  // `last` keeps the tile readable with no network.
  let shown = ayah ?? last

  // Long verses get smaller type rather than a scrollbar. Counting characters alone
  // is not enough: Kurdish runs about 2.3x the length of the Arabic it translates,
  // more than any other language here, because it spells words out. `nw` stands in for
  // how wide the script draws, so a language in a wide script reaches the threshold
  // sooner than its character count suggests.
  let longText = len(shown.text ?? "") * (pick.nw ?? 0.6) > 165
  let longArab = len(shown.arabic ?? "") > 140

  // Layout scales off the tile's dp size; the constants below are calibrated for a
  // 400x240 tile. narrow drops the header's title so the two buttons keep their room.
  let w = tileWidth ?? 400
  let h = tileHeight ?? 240
  let scale = clamp(w / 400, 0.8, 1.5)
  let narrow = w < 240
  let arabSize = round(clamp((longArab ? 16 : 20) * scale, 12, 28))
  let textSize = round(clamp((longText ? 12 : 14) * scale, 10, 20))
  let gapOut = round(clamp(h * 0.05, 10, 22))
  let gapIn = round(clamp(h * 0.06, 10, 22))
  let gapBody = round(clamp(h * 0.11, 18, 36))

  // The picker lists all 23 languages at once, so its chips shrink with the tile.
  let chipScale = clamp(w / 400, 0.6, 1.2)
  let chipFont = round(clamp(13 * chipScale, 10, 15))
  let chipFont2 = round(chipFont * 0.78)
  let chipGap = round(clamp(10 * chipScale, 6, 12))
  let chipPadH = round(clamp(12 * chipScale, 8, 14))
  // One height for every chip, so a two-line chip does not step over its one-line
  // neighbour and leave the rows uneven.
  let chipH = round(chipFont * 1.2 + chipFont2 * 1.25 + 4)
  // The close word is in the picked language, so it is measured with that language's
  // em width. A function cannot be held in a `let`, so both pickers spell this out
  // where they use it.
  let closeW = len(pick.t.close) * (pick.nw ?? 0.58) * chipFont + chipPadH * 4

  // What the widget is built from, and what it needs to run. Each row's title is a
  // key into `pick.t`, so it follows the chosen language; the value after it stays
  // English. The values describe what the widget does and what it needs, not what any
  // one machine happens to have installed, so they read the same on every device.
  let parts = [
    [pick.t.kLevel, "9, the level it is written for"],
    [pick.t.kNodes, "Box, Column, Row, Flow, Text, Button"],
    [pick.t.kExpr, "hash, clamp, round, floor, len, trim, max, int, enc, find"],
    [pick.t.kAct, "copy, share, haptic, screen"],
    [pick.t.kSrc, "a clock, and api.alquran.cloud for the verse and its translation"],
    [pick.t.kState, "language, whether the Arabic shows, and the last verse, so it works offline"],
    [pick.t.kFonts, "system fonts, which cover every script here"],
    [pick.t.kScripts, "Arabic, Latin, Cyrillic, Devanagari, Bengali, Tamil, Thai, Urdu, CJK, Hangul"],
    [pick.t.kLangs, "23 translations, one edition each, each checked over all 6236 verses"],
    [pick.t.kPkg, "none, and no shell commands"]
  ]

  on ayah.text { last = ayah }

  onTap: screen()

  Box {
    fill: true

    Column {
      fill: true
      gap: gapOut
      Row {
        align: center
        gap: gapIn
        // The weight: 1 row keeps its space when narrow hides the title, so the
        // buttons stay right-aligned.
        Row {
          weight: 1
          gap: 0
          if !narrow { Text { text: pick.t.title; style: label; color: muted; maxLines: 1 } }
        }
        Button {
          text: arab ? pick.t.collapse : pick.t.expand
          color: muted
          onTap: arab = !arab
        }
        Button { text: pick.label; color: accent; onTap: picker = !picker }
      }
      // Scrolling, so a long verse scrolls instead of losing its end. gapBody keeps
      // the Arabic and the translation from touching.
      Column {
        fill: height
        gap: gapBody
        weight: 1
        scroll: true
        if arab {
          Text {
            text: shown.arabic ?? ""
            fontSize: arabSize
            align: end
            color: foreground
          }
        }
        Text {
          text: shown == null ? "..." : shown.text
          fontSize: textSize
          italic: true
        }
      }
      Text { text: shown.ref ?? ""; style: label; color: accent; align: end }
    }

    if picker {
      Box {
        fill: true
        background: alpha(background, 0.97)
        radius: 8 * corners
        align: center
        Column {
          gap: gapIn
          fill: width
          align: center
          padding: round(clamp(w * 0.04, 10, 20))
          scroll: true
          Text { text: pick.t.choose; fontSize: chipFont; color: muted; align: center; maxLines: 1 }
          // A chip is a Box rather than a Text so it can carry two lines. Its width is
          // the wider of the two, each measured in its own script's em.
          Flow {
            gap: chipGap
            justify: center
            for l in langs key l.code {
              Box {
                width: max(len(l.label) * chipFont * 0.46,
                           len(l.native ?? "") * (l.nw ?? 0) * chipFont2) + chipPadH * 2 + 6
                height: chipH
                background: l.code == lang ? accent : alpha(foreground, 0.08)
                radius: 3 * corners
                align: center
                onTap: { lang = l.code; picker = false }
                Column {
                  gap: 1
                  align: center
                  Text {
                    text: l.label
                    fontSize: chipFont
                    bold: l.code == lang
                    color: l.code == lang ? background : foreground
                    maxLines: 1
                    align: center
                  }
                  if l.native != null {
                    Text {
                      text: l.native
                      fontSize: chipFont2
                      color: l.code == lang ? background : muted
                      maxLines: 1
                      align: center
                    }
                  }
                }
              }
            }
          }
          // A bordered plate rather than a bare word, so closing never lands on the
          // tile underneath and opens the full view by accident.
          Row {
            justify: center
            Box {
              padding: [chipPadH * 2, round(chipFont * 0.8)]
              width: closeW
              border: 1
              borderColor: alpha(accent, 0.6)
              radius: 8 * corners
              align: center
              onTap: picker = false
              Text { text: pick.t.close; fontSize: chipFont; color: accent; align: center; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  screen {
    title: "${shown.ref ?? pick.t.title}"
    Column {
      scroll: true
      gap: 26
      padding: [16, 12]
      // The same fold the tile has, so the Arabic can be put away here too.
      Row {
        justify: end
        Button {
          text: arab ? pick.t.collapse : pick.t.expand
          color: muted
          onTap: arab = !arab
        }
      }
      if arab {
        Text { text: shown.arabic ?? ""; fontSize: 24; align: end; color: foreground }
      }
      Text { text: shown.text ?? "..."; fontSize: 18 }
      Row {
        gap: 10
        Button { text: pick.t.copy; onTap: { copy("${shown.text}\n\n${shown.arabic}\n— ${shown.ref}"); haptic() } }
        Button { text: pick.t.share; onTap: share("${shown.text}\n\n${shown.arabic}\n— ${shown.ref}") }
      }

      Box {
        border: 1
        borderColor: alpha(foreground, 0.18)
        radius: 8 * corners
        padding: [12, 10]
        Column {
          gap: 14
          align: center
          Text { text: pick.t.choose; style: label; color: muted; align: center }
          // The window is wide and holds every language, so its chips stay full size.
          Flow {
            gap: 10
            justify: center
            fill: width
            for l in langs key l.code {
              Box {
                width: max(len(l.label) * 13 * 0.46, len(l.native ?? "") * (l.nw ?? 0) * 10) + 16
                height: 42
                background: l.code == lang ? accent : alpha(foreground, 0.08)
                radius: 3 * corners
                align: center
                onTap: lang = l.code
                Column {
                  gap: 1
                  align: center
                  Text {
                    text: l.label
                    fontSize: 13
                    bold: l.code == lang
                    color: l.code == lang ? background : foreground
                    maxLines: 1
                    align: center
                  }
                  if l.native != null {
                    Text {
                      text: l.native
                      fontSize: 10
                      color: l.code == lang ? background : muted
                      maxLines: 1
                      align: center
                    }
                  }
                }
              }
            }
          }
        }
      }

      // What the widget is built from. The heading follows the language; the values
      // "What is in this widget" and "Notes" share one bordered plate, so the two
      // read as sections of the same panel rather than two things floating apart.
      // A rule between them marks where one ends. Only the headings follow the
      // language; the values beside them name nodes, functions and files, and the
      // notes are a statement about the software, so both stay English.
      Box {
        border: 1
        borderColor: alpha(foreground, 0.18)
        radius: 8 * corners
        padding: [12, 10]
        Column {
          gap: 12
          // Each heading sits on the left with its fold button on the right, so a
          // section reads as a labelled group with its own control.
          Row {
            align: center
            gap: 10
            Text { text: pick.t.about; style: label; color: accent; weight: 1 }
            Button {
              text: showParts ? pick.t.collapse : pick.t.expand
              color: accent
              onTap: showParts = !showParts
            }
          }
          if showParts {
            Column {
              gap: 10
              for p in parts {
                Row {
                  gap: 12
                  // The label column is wide enough for the longest title in any of
                  // the 23 languages, so no title wraps to a second line and knocks
                  // the rows out of line with each other.
                  Text { text: p[0]; style: small; color: muted; width: 132 }
                  Text { text: p[1]; style: small; color: foreground; weight: 1 }
                }
              }
            }
          }
          // The rule needs an explicit width: a Box sized only by its height has no
          // width to resolve against and the renderer gives up on the whole screen.
          Box { fill: width; height: 1; background: alpha(foreground, 0.14) }
          Row {
            align: center
            gap: 10
            Text { text: pick.t.notes; style: label; color: accent; weight: 1 }
            Button {
              text: showNotes ? pick.t.collapse : pick.t.expand
              color: accent
              onTap: showNotes = !showNotes
            }
          }
          if showNotes {
          Column {
            gap: 10
          Text {
            style: small
            color: muted
          text: "This widget began as \"bible-verse\" by Dustin Montgomery (en3r0), published in SimonSchubert/omarchy-widgets. That widget fetched one NIV verse a day from ourmanna.com. This one fetches a verse of the Qur'an and its translation from api.alquran.cloud, and adds a language picker that also switches the interface language. Both the original and this rewrite are MIT licensed."
        }
        Text {
          style: small
          color: muted
          text: "The translations come from the translators and publishers named by the API, not from the author of this widget. The wording of the interface in each language, though, was written for this widget, and it is not always idiomatic: a phrase may sound stilted, or a native speaker may simply prefer a different word. Please treat the translations as a first attempt and correct them if you can."
        }
        Text {
          style: small
          color: muted
          text: "You are welcome to edit this widget however you like, including fixing the translations, adding languages, or changing the layout, as long as you keep it under the MIT License below and keep the credit to the original author."
        }
        Text {
          style: small
          color: muted
          text: """MIT License

Copyright (c) 2026 mhmdaqrammarzuki

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE."""
        }
        Text {
          style: small
          color: muted
          text: "Derived from en3r0/bible-verse, MIT, Copyright (c) 2026 Simon Schubert and contributors. Verse text and translations from api.alquran.cloud."
        }
          }
          }
        }
      }
    }
  }
}
