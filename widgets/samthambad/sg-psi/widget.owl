widget "Singapore PSI" {
  size: 3x4
  minSize: 3x4
  padding: 12

  meta {
    description: "Latest NEA 24-hour PSI and PM2.5 readings for all five Singapore regions. Tap to open haze.gov.sg."
    version: "1.1.1"
    license: "MIT"
    category: "world"
  }
  requires { pacman: [] }

  source response = http("https://api-open.data.gov.sg/v2/real-time/api/psi") every 10m json status
  let latest = response.out.data.items[0]
  let readings = latest.readings.psi_twenty_four_hourly
  let pm25 = latest.readings.pm25_twenty_four_hourly
  let regions = ["north", "south", "east", "west", "central"]
  let ready = response.ok && response.out.code == 0 && readings != null
  onTap: url("https://www.haze.gov.sg/")
  // A wide tile (landscape home screen) is too short for the stacked layout:
  // the header and footer go in a left column beside the five-row table.
  let wide = tileWidth != null && tileHeight != null && tileWidth > tileHeight

  if wide {
    Row {
      fill: true
      gap: 10
      Column {
        width: 88
        fill: height
        gap: 2
        Text { text: "SINGAPORE"; fontSize: 11; color: muted }
        Text { text: "24-hour PSI"; fontSize: 16 }
        Text {
          text: ready ? "${sub(latest.timestamp, 11, 16)} SGT" : response == null ? "Loading…" : "Unavailable"
          fontSize: 10
          color: muted
        }
        if ready {
          Text { text: sub(latest.timestamp, 0, 10); fontSize: 10; color: muted }
        }
        Spacer { weight: 1 }
        Text { text: "NEA · µg/m³"; fontSize: 10; color: muted }
        Text { text: "haze.gov.sg ↗"; fontSize: 10; color: muted }
      }
      Column {
        weight: 1
        fill: height
        gap: 2
        Row {
          fill: width
          gap: 4
          padding: [6, 0]
          Text { text: "Region"; weight: 1; fontSize: 10; color: muted }
          Text { text: "PM2.5"; width: 36; align: end; fontSize: 10; color: muted }
          Text { text: "PSI"; width: 28; align: end; fontSize: 10; color: muted }
        }
        for region in regions {
          let value = readings[region]
          let dust = pm25[region]
          let dustTint = dust == null ? muted : dust <= 55 ? "#2fae5f" : dust <= 150 ? "#f0c000" : dust <= 250 ? "#ef9a00" : "#e5322d"
          Row {
            fill: width
            weight: 1
            align: center
            gap: 4
            padding: [6, 0]
            background: surface
            Text { text: "${upper(sub(region, 0, 1))}${sub(region, 1)}"; weight: 1; fontSize: 12 }
            Text { text: dust; width: 36; align: end; fontSize: 15; color: dustTint }
            Text { text: value; width: 28; align: end; fontSize: 12; color: alpha(foreground, 0.45) }
          }
        }
      }
    }
  } else {
  Column {
    fill: true
    gap: 2
    Text { text: "SINGAPORE"; fontSize: 11; color: muted }
    Text { text: "24-hour PSI"; fontSize: 18 }
    Text {
      text: ready ? "${sub(latest.timestamp, 11, 16)} SGT · ${sub(latest.timestamp, 0, 10)}" : response == null ? "Loading readings…" : "Readings unavailable"
      style: small
      fontSize: 10
      color: muted
    }
    Row {
      fill: width
      gap: 6
      padding: [0, 1]
      Text { text: "Region"; weight: 1; fontSize: 10; color: muted }
      Text { text: "PM2.5"; width: 46; align: end; fontSize: 10; color: muted }
      Text { text: "PSI"; width: 44; align: end; fontSize: 10; color: muted }
    }
    for region in regions {
      let value = readings[region]
      let dust = pm25[region]
      let dustTint = dust == null ? muted : dust <= 55 ? "#2fae5f" : dust <= 150 ? "#f0c000" : dust <= 250 ? "#ef9a00" : "#e5322d"
      Row {
        fill: width
        align: center
        gap: 6
        padding: [8, 1]
        background: surface
        Column {
          weight: 1
          gap: 0
          Text { text: "${upper(sub(region, 0, 1))}${sub(region, 1)}"; fontSize: 13 }
        }
        Text { text: dust; width: 46; align: end; fontSize: 17; color: dustTint }
        Text { text: value; width: 44; align: end; fontSize: 13; color: alpha(foreground, 0.45) }
      }
    }
    Spacer { weight: 1 }
    Column {
      fill: width
      gap: 0
      Text { text: "NEA · PSI & PM2.5 µg/m³"; fontSize: 10; color: muted }
      Text { text: "haze.gov.sg ↗"; fontSize: 10; color: muted }
    }
  }
  }
}
