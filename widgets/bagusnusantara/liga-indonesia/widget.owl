widget "liga indonesia" {
  meta { owl: 5; description: "Klub favoritmu (default Persik Kediri) di Super League Indonesia: posisi, form, laga berikutnya dan klasemen, dari FotMob"; version: "2.3.1"; license: "MIT"; category: "sport" }
  size: 6x5
  minSize: 3x3

  requires { pacman: ["curl", "jq"] }

  // The club to follow, by FotMob team id (default Persik Kediri). Pick another in the
  // screen's "ganti" tab, or from a script: owl-send 70-liga-indonesia.owl set clubId <id>
  state clubId = 165197 persist

  // FotMob's league page carries the whole season (table + every fixture) in __NEXT_DATA__.
  // Team crests are cached once in ~/.cache/liga-id/<team id>.png.
  source liga = cmd("""
    d=~/.cache/liga-id; mkdir -p "$d"
    curl -fs --compressed -m 25 -A Mozilla/5.0 https://www.fotmob.com/leagues/8983/overview/super-league \
    | sed -n 's/.*<script id="__NEXT_DATA__" type="application\/json">\(.*\)<\/script>.*/\1/p' \
    | jq -c '
      def nm: sub(" F\\.?C\\.?$"; "");
      def tm: .utcTime | sub("\\.[0-9]+Z$"; "Z") | fromdate;
      .props.pageProps as $p
      | ($p.fixtures.allMatches | map({id, round, h: (.home.shortName | nm), a: (.away.shortName | nm),
          hid: (.home.id | tonumber), aid: (.away.id | tonumber), t: (.status | tm), s: .status.scoreStr,
          fin: .status.finished, live: (.status.started and (.status.finished | not)),
          min: (.status.liveTime.short // null)}
        # hr: the result from the home side, for whichever club the widget follows.
        | if .s and (.fin or .live) then
            (.s | split(" - ") | map(tonumber? // 0)) as $g
            | . + {hr: (if $g[0] > $g[1] then "W" elif $g[0] < $g[1] then "L" else "D" end)}
          else . end)) as $m
      | {season: $p.details.selectedSeason,
         round: ($m | map(select(.fin | not)) | sort_by(.t) | first | .round // null),
         table: [$p.table[0].data.table.all[] | {r: .idx, n: (.shortName | nm), id, p: .played, w: .wins,
           d: .draws, l: .losses, g: .scoresStr, gd: .goalConDiff, pts, c: .qualColor}],
         live: ($m | map(select(.live))),
         next: ($m | map(select((.fin or .live) | not)) | sort_by(.t) | .[0:9]),
         last: ($m | map(select(.fin)) | sort_by(.t) | .[-9:] | reverse),
         matches: ($m | sort_by(.t))}' > "$d/data.tmp"
    # jq exits 0 on empty input, so keep the last good copy unless this one has data.
    [ -s "$d/data.tmp" ] && mv -f "$d/data.tmp" "$d/data.json"
    [ -s "$d/data.json" ] || exit 1
    for i in $(jq -r '.table[].id' "$d/data.json"); do
      [ -s "$d/$i.png" ] || curl -fs -m 10 -o "$d/$i.png" "https://images.fotmob.com/image_resources/logo/teamlogo/$i"_small.png &
    done; wait
    cat "$d/data.json"
  """) every 10m json timeout 45s
  source now = clock every 1m

  let table = liga.table ?? []
  let live = liga.live ?? []
  let club = table.find(t => t.id == clubId)
  let clubName = club.n == "Persik" ? "Persik Kediri" : club.n
  let games = (liga.matches ?? []).filter(m => m.hid == clubId || m.aid == clubId).map(m => {
    id: m.id, round: m.round, h: m.h, a: m.a, hid: m.hid, aid: m.aid, t: m.t, s: m.s,
    fin: m.fin, live: m.live, min: m.min, home: m.hid == clubId,
    res: m.hr == null ? null : m.hid == clubId ? m.hr : m.hr == "W" ? "L" : m.hr == "L" ? "W" : "D"
  })
  let played = games.filter(m => m.fin)
  let upcoming = games.filter(m => !m.fin && !m.live)
  let liveGame = games.find(m => m.live)
  let nextGame = first(upcoming)
  let lastGame = last(played)
  let form = played.drop(max(0, len(played) - 5))
  // The club's neighbours in the table: as many rows (about 19dp each) as fit under the
  // header, form and matches (about 195dp), so a tall tile isn't left half empty.
  let aroundN = tileHeight == null ? ((rows ?? 5) >= 6 ? 5 : 3) : clamp(floor((tileHeight - 195) / 19), 3, 18)
  let around = table.drop(clamp((club.r ?? 1) - 1 - floor(aroundN / 2), 0, max(0, len(table) - aroundN))).take(aroundN)
  state tab = "klub"

  onTap: screen()

  component Crest(id, sz = 16) {
    Image { src: "~/.cache/liga-id/${id}.png"; fit: contain; width: sz; height: sz }
  }

  component ResultChip(res, sz = 20) {
    Box {
      width: sz
      height: sz
      radius: 4
      align: center
      background: res == "W" ? green : res == "L" ? red : yellow
      Text { text: res == "W" ? "M" : res == "L" ? "K" : "S"; fontSize: sz * 0.55; bold: true; color: background; align: center }
    }
  }

  component TableRow(t, full = false) {
    Row {
      gap: full ? 4 : 6
      align: center
      background: t.id == clubId ? alpha(accent, 0.18) : null
      radius: 4
      Box { width: 3; height: 14; background: t.c ?? surface }
      Text { text: "${t.r}"; fontSize: 12; color: muted; width: 18; align: end }
      Crest { id: t.id }
      Text { text: t.n; fontSize: 13; maxLines: 1; weight: 1; bold: t.id == clubId; color: t.id == clubId ? accent : foreground }
      Text { text: "${t.p}"; fontSize: 12; color: muted; width: 22; align: end }
      if full {
        Text { text: "${t.w}"; fontSize: 12; color: muted; width: 16; align: end }
        Text { text: "${t.d}"; fontSize: 12; color: muted; width: 16; align: end }
        Text { text: "${t.l}"; fontSize: 12; color: muted; width: 16; align: end }
      }
      Text { text: t.gd > 0 ? "+${t.gd}" : "${t.gd}"; fontSize: 12; color: t.gd > 0 ? green : t.gd < 0 ? red : muted; width: 30; align: end }
      Text { text: "${t.pts}"; fontSize: 13; bold: true; width: 26; align: end }
    }
  }

  component TableHead(full = false) {
    Row {
      gap: full ? 4 : 6
      Text { text: "klub"; style: label; weight: 1; padding: [full ? 45 : 51, 0, 0, 0] }
      Text { text: "Mn"; style: label; width: 22; align: end }
      if full {
        Text { text: "M"; style: label; width: 16; align: end }
        Text { text: "S"; style: label; width: 16; align: end }
        Text { text: "K"; style: label; width: 16; align: end }
      }
      Text { text: "SG"; style: label; width: 30; align: end }
      Text { text: "poin"; style: label; width: 26; align: end }
    }
  }

  // A fixture: home + crest, score or kick-off time, crest + away.
  component Match(m, fs = 12) {
    Row {
      gap: 6
      align: center
      Text { text: m.h; fontSize: fs; maxLines: fs >= 13 ? 2 : 1; weight: 1; align: end; bold: m.hid == clubId }
      Crest { id: m.hid }
      Column {
        gap: 0
        width: 58
        if m.fin || m.live {
          Text { text: m.s ?? "-"; fontSize: fs + 1; bold: true; align: center; color: m.live ? red : m.res == "W" ? green : m.res == "L" ? red : m.res == "D" ? yellow : foreground }
          if m.live { Text { text: m.min ?? "live"; fontSize: 10; color: red; align: center } }
        } else {
          Text { text: fmtTime(m.t, "HH:mm"); fontSize: fs; color: accent; align: center }
          Text { text: fmtTime(m.t, "EEE d/M"); fontSize: 10; color: muted; align: center }
        }
      }
      Crest { id: m.aid }
      Text { text: m.a; fontSize: fs; maxLines: fs >= 13 ? 2 : 1; weight: 1; bold: m.aid == clubId }
    }
  }

  // A club fixture with its round, date and venue above it.
  component Fixture(m) {
    Column {
      gap: 2
      Text { text: "pekan ${m.round} · ${fmtTime(m.t, "EEEE d MMM")} · ${m.home ? "kandang" : "tandang"}"; style: label }
      Match { m: m; fs: 13 }
    }
  }

  component TabButton(name) {
    Button { text: name; color: tab == name ? accent : muted; weight: 1; onTap: tab = name }
  }

  Column {
    gap: 6
    if liga == null {
      Text { text: "memuat…"; style: small; color: muted }
    } else {
      // Header: crest, name, rank and points.
      Row {
        gap: 10
        align: center
        Crest { id: clubId; sz: 40 }
        Column {
          gap: 0
          weight: 1
          Text { text: clubName; style: title; maxLines: 1 }
          Text { text: "super league · pekan ${liga.round ?? "-"}"; style: muted; maxLines: 1 }
        }
        Column {
          gap: 0
          width: 64
          Text { text: "#${club.r}"; style: title; color: club.c ?? accent; align: end }
          Text { text: "${club.pts} poin"; style: small; color: muted; align: end }
        }
      }

      if cols >= 4 {
        Row {
          gap: 10
          align: center
          Text { text: "${club.w}M ${club.d}S ${club.l}K · gol ${club.g}"; style: small; color: muted; weight: 1; maxLines: 1 }
          Row { gap: 4; for m in form key m.id { ResultChip { res: m.res } } }
        }
      }

      if liveGame != null {
        Text { text: "sedang main · ${liveGame.min ?? "live"}"; style: label; color: red }
        Match { m: liveGame; fs: 13 }
      } else {
        if nextGame != null {
          Row {
            Text { text: "berikutnya · ${nextGame.home ? "kandang" : "tandang"}"; style: label; weight: 1 }
            Text { text: nextGame.t > now ? "${fmtDuration(nextGame.t - now)} lagi" : ""; style: label; color: accent; width: 110; align: end }
          }
          Match { m: nextGame; fs: 13 }
        }
      }

      // By height in dp, not rows: a row is a different height on every phone. The last match
      // needs about 170dp, the table under it about 225dp.
      if (tileHeight ?? 999) >= 170 && lastGame != null {
        Text { text: "terakhir · pekan ${lastGame.round}"; style: label }
        Match { m: lastGame }
      }

      if (tileHeight ?? 999) >= 225 && cols >= 4 {
        Column {
          gap: 3
          for t in around key t.id { TableRow { t: t } }
        }
      }
      Spacer { weight: 1 }
    }
  }

  screen {
    title: clubName ?? "super league"
    Column {
      gap: 8
      padding: 12
      Row {
        gap: 6
        TabButton { name: "klub" }
        TabButton { name: "tabel" }
        TabButton { name: "liga" }
        TabButton { name: "ganti" }
      }
      Column {
        scroll: true
        weight: 1
        gap: 8
        if tab == "ganti" {
          // Pick the club to follow; the choice is kept across restarts.
          Text { text: "pilih tim favorit"; style: label; color: accent }
          for t in table.sortBy(t => lower(t.n)) key t.id {
            Row {
              gap: 10
              align: center
              padding: [8, 6]
              radius: 6
              background: t.id == clubId ? alpha(accent, 0.18) : null
              onTap: { clubId = t.id; tab = "klub" }
              Crest { id: t.id; sz: 24 }
              Text { text: t.n == "Persik" ? "Persik Kediri" : t.n; weight: 1; maxLines: 1; bold: t.id == clubId; color: t.id == clubId ? accent : foreground }
              Text { text: "#${t.r}"; style: small; color: muted; width: 36; align: end }
            }
          }
        } else if tab == "tabel" {
          TableHead { full: true }
          for t in table key t.id { TableRow { t: t; full: true } }
          Spacer { height: 4 }
          Text { text: "Mn main · M menang · S seri · K kalah · SG selisih gol"; style: small; color: muted }
        } else if tab == "liga" {
          if len(live) > 0 {
            Text { text: "sedang berlangsung"; style: label; color: red }
            for m in live key m.id { Match { m: m; fs: 13 } }
          }
          Text { text: "jadwal liga"; style: label; color: accent }
          for m in liga.next ?? [] key m.id {
            Column {
              gap: 2
              Text { text: "pekan ${m.round} · ${fmtTime(m.t, "EEEE d MMM")}"; style: label }
              Match { m: m; fs: 13 }
            }
          }
          Text { text: "hasil liga"; style: label; color: accent }
          for m in liga.last ?? [] key m.id {
            Column {
              gap: 2
              Text { text: "pekan ${m.round} · ${fmtTime(m.t, "EEEE d MMM")}"; style: label }
              Match { m: m; fs: 13 }
            }
          }
        } else {
          Row {
            gap: 12
            align: center
            Crest { id: clubId; sz: 56 }
            Column {
              gap: 2
              weight: 1
              Text { text: "peringkat ${club.r}"; style: title }
              Text { text: "${club.pts} poin"; color: accent; bold: true }
              Text { text: "${club.p} main · ${club.w} menang · ${club.d} seri · ${club.l} kalah · gol ${club.g}"; style: small; color: muted }
            }
          }
          Row { gap: 4; for m in form key m.id { ResultChip { res: m.res; sz: 24 } } }
          if liveGame != null {
            Text { text: "sedang main"; style: label; color: red }
            Match { m: liveGame; fs: 13 }
          }
          if len(upcoming) > 0 {
            Text { text: "jadwal"; style: label; color: accent }
            for m in upcoming.take(5) key m.id { Fixture { m: m } }
          }
          if len(played) > 0 {
            Text { text: "hasil"; style: label; color: accent }
            for m in played.reverse() key m.id { Fixture { m: m } }
          }
          if len(upcoming) > 5 {
            Text { text: "sisa jadwal"; style: label; color: accent }
            for m in upcoming.drop(5) key m.id { Fixture { m: m } }
          }
        }
      }
      Button { text: "buka di fotmob"; onTap: url("https://www.fotmob.com/teams/${int(clubId)}/overview/${lower(replace(club.n ?? "team", " ", "-"))}") }
    }
  }
}
