// ============================================================================
// AGENT EDITING GUIDE (READ FIRST BEFORE MAKING ANY EDITS)
// ============================================================================
// Widget: DawgWatch (generated from TeamWatch unified engine)
// Source config (if present locally): teamwatch/teams/dawgwatch.json
// Full local guide (if present): teamwatch/AGENTS.md
//
// MANDATORY FIRST STEP:
// Before modifying any code, ASK THE USER:
//   "Do you want to change team data/configuration (colors, team/league IDs,
//    score source, news feeds or number of sources, polling intervals) OR
//    modify the core UI/engine code?"
//
// - IF CHANGING DATA / CONFIG ONLY:
//   1. If `teamwatch/teams/dawgwatch.json` exists locally, edit ONLY that JSON
//      file and run: `python3 teamwatch/build.py --all --check`
//   2. If editing this standalone .owl file on another device, edit ONLY
//      SECTION 1 (TEAM CONFIG) below: theme colors, source URLs, polling
//      intervals, or news feeds. Do NOT rewrite SECTION 2 (CORE ENGINE).
//
// - CURRENT CONFIG SUMMARY:
//   Provider: espn | News feeds (4): ESPN, GoHuskies, FOX Sports, Big Ten
//   Theme: primary=#4B2E83, secondary=#B7A57A, accent=#9668F0
// ============================================================================
widget "dawgwatch" {
  meta {
    description: "Washington Huskies football dashboard: live score, live betting odds, ESPN win probability, stats, schedule, Big Ten standings, and team news"
    version: "1.3"
    license: "MIT"
    category: "sport"
    owl: 19
  }


  size: 6x4
  minSize: 3x3
  padding: [10, 8]

  source now = clock every 1m
  source modes = android.modes
  source schedule = http("https://site.api.espn.com/apis/site/v2/sports/football/college-football/teams/264/schedule") every 1h json timeout 20s
  source standings = http("https://site.api.espn.com/apis/v2/sports/football/college-football/standings?group=5") every 1h json timeout 20s
  source teamStats = http("https://site.api.espn.com/apis/site/v2/sports/football/college-football/teams/264/statistics") every 1h json timeout 20s status
  // === SECTION 1: TEAM CONFIG — NEWS SOURCES (SAFE TO EDIT) ===
  source newsFeed = http("https://site.api.espn.com/apis/site/v2/sports/football/college-football/news?team=264") every 1h json timeout 20s
  source uwNews = http("https://gohuskies.com/api/v2/stories?sportId=3") every 1h json timeout 20s
  source foxRss = http("https://api.foxsports.com/v2/content/optimized-rss?partnerKey=MB0Wehpmuj2lUhuRhQaafhBjAJqaPU244mlTDK1i&size=15&tags=washington-huskies") every 1h timeout 20s status
  source b1gRss = http("https://bigten.org/rss.aspx?path=football") every 1h timeout 20s

  state tab = "score"
  state screenTab = "game"
  state newsFilter = "all"
  state lastLiveProb = null

  // === SECTION 1: TEAM CONFIG — THEME PALETTE (SAFE TO EDIT) ===
  let primaryColor    = #4B2E83
  let secondaryColor  = #B7A57A
  let accentColor     = #9668F0
  let winColor        = #3ddc84

  // Auto-derived UI tokens
  let tabActiveBg     = alpha(primaryColor, 0.25)
  let tabActiveBorder = accentColor
  let tabActiveText   = accentColor
  let highlightBg     = alpha(primaryColor, 0.30)
  let barFillColor    = secondaryColor
  let liveColor       = accentColor
  // === SECTION 2: CORE ENGINE (DO NOT EDIT FOR DATA/THEME CHANGES) ===

  let teamInfo = schedule.team ?? {}
  let recordStr = teamInfo.recordSummary ?? "–"
  let standingStr = teamInfo.standingSummary ?? "Washington Huskies"

  // Season schedule & history
  let schedEvents = schedule.events ?? []
  let pastGames = schedEvents.filter(e => e.competitions[0].status.type.state == 'post')
  let lastGame = last(pastGames)
  let futureGames = schedEvents.filter(e => e.competitions[0].status.type.state == 'pre')
  let nextSchedGame = first(futureGames)
  let liveSchedGames = schedEvents.filter(e => e.competitions[0].status.type.state == 'in')

  // Smart game-window polling (1m during game window, 30m idle)
  let nextSchedTs = parseTime(nextSchedGame.date)
  let lastSchedTs = parseTime(lastGame.date)
  let isGameWindow = len(liveSchedGames) > 0 || (nextSchedTs != null && now >= nextSchedTs - 900 && now <= nextSchedTs + 18000) || (lastSchedTs != null && now >= lastSchedTs && now <= lastSchedTs + 18000)
  source scoreboardLive = http(isGameWindow ? "https://site.api.espn.com/apis/site/v2/sports/football/college-football/scoreboard?groups=5" : null) every 1m json timeout 20s
  source scoreboardIdle = http(!isGameWindow ? "https://site.api.espn.com/apis/site/v2/sports/football/college-football/scoreboard?groups=5" : null) every 30m json timeout 20s
  let scoreboard = (isGameWindow ? scoreboardLive : scoreboardIdle) ?? scoreboardLive ?? scoreboardIdle

  // Live scoreboard (Big Ten + non-conference UW games)
  let sbEvents = scoreboard.events ?? []
  let sbUwGame = sbEvents.find(e => any(e.competitions[0].competitors ?? [], c => (c.team.id ?? '') == '264'))
  let isSbLive = sbUwGame != null && sbUwGame.competitions[0].status.type.state == 'in'
  let isSbFinal = sbUwGame != null && sbUwGame.competitions[0].status.type.state == 'post'

  let recentFinalCandidate = isSbFinal ? sbUwGame : lastGame
  let recentFinalTs = parseTime(recentFinalCandidate.date)
  let showRecentFinal = recentFinalCandidate != null && recentFinalTs != null && now >= recentFinalTs && (now - recentFinalTs) < 86400
  let liveGame = isSbLive ? sbUwGame : (!isSbFinal ? first(liveSchedGames) : null)
  // Featured game: live game first, then a final game within 24h of kickoff (~20h post-game), then next upcoming matchup, fallback to last game
  let featuredGame = liveGame ?? (showRecentFinal ? recentFinalCandidate : null) ?? nextSchedGame ?? lastGame ?? sbUwGame
  let prevGame = lastGame

  // Team Season Stats & Individual Player Leaders
  let tsOffCats = (teamStats != null && teamStats.ok ? teamStats.out.results.stats.categories : []) ?? []
  let tsOppCats = (teamStats != null && teamStats.ok ? teamStats.out.results.opponent : []) ?? []
  let offPassStats = (tsOffCats.find(c => c.name == "passing").stats) ?? []
  let offRushStats = (tsOffCats.find(c => c.name == "rushing").stats) ?? []
  let offMiscStats = (tsOffCats.find(c => c.name == "miscellaneous").stats) ?? []
  let offDefStats = (tsOffCats.find(c => c.name == "defensive").stats) ?? []
  let offIntStats = (tsOffCats.find(c => c.name == "defensiveInterceptions").stats) ?? []
  let oppPassStats = (tsOppCats.find(c => c.name == "passing").stats) ?? []
  let oppRushStats = (tsOppCats.find(c => c.name == "rushing").stats) ?? []
  let oppMiscStats = (tsOppCats.find(c => c.name == "miscellaneous").stats) ?? []
  let oppDefStats = (tsOppCats.find(c => c.name == "defensive").stats) ?? []
  let oppIntStats = (tsOppCats.find(c => c.name == "defensiveInterceptions").stats) ?? []
  let statOffPpg = offPassStats.find(st => st.name == "totalPointsPerGame").displayValue ?? "–"
  let statOppPpg = oppPassStats.find(st => st.name == "totalPointsPerGame").displayValue ?? "–"
  let statOffYpg = offPassStats.find(st => st.name == "yardsPerGame").displayValue ?? "–"
  let statOppYpg = oppPassStats.find(st => st.name == "yardsPerGame").displayValue ?? "–"
  let statOffPass = offPassStats.find(st => st.name == "netPassingYardsPerGame").displayValue ?? "–"
  let statOppPass = oppPassStats.find(st => st.name == "netPassingYardsPerGame").displayValue ?? "–"
  let statOffRush = offRushStats.find(st => st.name == "rushingYardsPerGame").displayValue ?? "–"
  let statOppRush = oppRushStats.find(st => st.name == "rushingYardsPerGame").displayValue ?? "–"
  let statOff3rd = offMiscStats.find(st => st.name == "thirdDownConvPct").displayValue ?? "–"
  let statOpp3rd = oppMiscStats.find(st => st.name == "thirdDownConvPct").displayValue ?? "–"
  let statDefSacks = offDefStats.find(st => st.name == "sacks").displayValue ?? "–"
  let statOppSacks = oppDefStats.find(st => st.name == "sacks").displayValue ?? "–"
  let statDefInts = offIntStats.find(st => st.name == "interceptions").displayValue ?? "–"
  let statOffInts = oppIntStats.find(st => st.name == "interceptions").displayValue ?? "–"
  let statToDiff = offMiscStats.find(st => st.name == "turnOverDifferential").displayValue ?? "–"
  let teamStatRows = [
    {label: "Points / G", team: statOffPpg, opp: statOppPpg},
    {label: "Total Yds / G", team: statOffYpg, opp: statOppYpg},
    {label: "Pass Yds / G", team: statOffPass, opp: statOppPass},
    {label: "Rush Yds / G", team: statOffRush, opp: statOppRush},
    {label: "3rd Down %", team: statOff3rd != "–" ? "${statOff3rd}%" : "–", opp: statOpp3rd != "–" ? "${statOpp3rd}%" : "–"},
    {label: "Sacks", team: statDefSacks, opp: statOppSacks},
    {label: "Interceptions", team: statDefInts, opp: statOffInts}
  ]
  let sbTeamComp = sbUwGame != null ? (sbUwGame.competitions[0].competitors ?? []).find(c => (c.team.id ?? "") == "264") : null
  let teamLeaders = (sbTeamComp.leaders ?? []).map(ld => ({
    cat: replace(ld.shortDisplayName ?? ld.displayName ?? "", " Leader", ""),
    name: ld.leaders[0].athlete.displayName ?? "–",
    pos: ld.leaders[0].athlete.position.abbreviation ?? "",
    line: ld.leaders[0].displayValue ?? "",
    headshot: ld.leaders[0].athlete.headshot.href ?? ld.leaders[0].athlete.headshot ?? "",
    url: ld.leaders[0].athlete.links[0].href ?? ""
  })).filter(x => x.name != "–" && x.line != "")

  // Big Ten Standings (18 teams)
  let b1gEntries = standings.standings.entries ?? []
  let b1gTop3 = take(b1gEntries, 3)
  let uwStandingsEntry = b1gEntries.find(e => (e.team.id ?? '') == '264')
  let uwInTop3 = any(b1gTop3, e => (e.team.id ?? '') == '264')
  let b1gStrip = uwInTop3 ? take(b1gEntries, 4) : (uwStandingsEntry != null ? flatten([b1gTop3, [uwStandingsEntry]]) : b1gTop3)

  // Featured game telemetry
  let fgComp = featuredGame.competitions[0]
  let fgAway = fgComp.competitors.filter(t => t.homeAway == 'away')[0] ?? fgComp.competitors[1]
  let fgHome = fgComp.competitors.filter(t => t.homeAway == 'home')[0] ?? fgComp.competitors[0]
  let fgIsHome = (fgHome.team.id ?? '') == '264'
  let fgUw = fgIsHome ? fgHome : fgAway
  let fgOpp = fgIsHome ? fgAway : fgHome

  let fgOppId = fgOpp.team.id ?? ''
  let fgOppAbbr = fgOpp.team.abbreviation ?? ''
  let fgAwayRankNum = fgAway.curatedRank.current ?? 99
  let fgHomeRankNum = fgHome.curatedRank.current ?? 99
  let fgAwayRank = fgAwayRankNum <= 25 ? fgAwayRankNum : null
  let fgHomeRank = fgHomeRankNum <= 25 ? fgHomeRankNum : null
  let fgAwayAbbr = fgAway.team.abbreviation ?? ''
  let fgHomeAbbr = fgHome.team.abbreviation ?? ''
  let fgAwayName = fgAway.team.shortDisplayName ?? fgAway.team.displayName ?? fgAwayAbbr
  let fgHomeName = fgHome.team.shortDisplayName ?? fgHome.team.displayName ?? fgHomeAbbr

  // Opponent record lookup from Big Ten standings if not in schedule event
  let oppEntry = b1gEntries.find(e => (e.team.id ?? '') == fgOppId)
  let oppRecStr = (oppEntry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? fgOpp.records[0].summary ?? ''
  let fgAwayRec = fgIsHome ? oppRecStr : recordStr
  let fgHomeRec = fgIsHome ? recordStr : oppRecStr

  let fgAwayScore = fgAway.score.displayValue ?? fgAway.score ?? '–'
  let fgHomeScore = fgHome.score.displayValue ?? fgHome.score ?? '–'

  let fgState = fgComp.status.type.state ?? 'pre'
  let fgIsLive = fgState == 'in'
  let fgIsFinal = fgState == 'post'
  let fgIsPre = fgState == 'pre'

  let fgWeekNum = featuredGame.week.number ?? scoreboard.week.number
  let fgTimeValid = fgComp.timeValid != false
  let fgDate = parseTime(featuredGame.date)
  let fgKickDate = fgDate != null ? (fgTimeValid ? fmtTime(fgDate, "EEE, M/d") : fmtTime(fgDate, "EEE, M/d", "America/New_York")) : 'Upcoming'
  let fgKickTime = fgDate != null && fgTimeValid ? fmtTime(fgDate, "h:mm a") : (fgComp.status.type.shortDetail ?? 'TBD')
  let fgStatusText = fgIsLive ? "${fgComp.status.displayClock} Q${fgComp.status.period}" : (fgIsFinal ? (fgComp.status.type.shortDetail ?? "Final") : "${fgKickDate} • ${fgKickTime}")
  let fgVenue = fgComp.venue.fullName ?? 'Husky Stadium'
  let fgCity = fgComp.venue.address.city ?? ''
  let fgStateCode = fgComp.venue.address.state ?? ''
  let fgLocation = fgCity != '' && fgStateCode != '' ? "${fgVenue} (${fgCity}, ${fgStateCode})" : fgVenue

  let fgBcList = fgComp.broadcasts ?? []
  let fgBcNames = fgBcList[0].names ?? []
  let fgBcMedia = fgBcList[0].media.shortName ?? ''
  let fgBroadcast = fgBcNames[0] ?? fgBcMedia ?? ''

  // Live situation (down, distance, red zone)
  let fgSit = fgComp.situation
  let fgDownDist = fgSit != null ? (fgSit.downDistanceText ?? fgSit.shortDownDistanceText ?? '') : ''
  let fgIsRedZone = fgSit != null && fgSit.isRedZone == true

  // Live & pregame betting odds + ESPN win probability
  let fgId = featuredGame.id != null ? str(featuredGame.id) : ""
  let espnCore = "https://sports.core.api.espn.com/v2/sports/football/leagues/college-football"
  source liveOdds = http(fgIsLive && fgId != "" ? "${espnCore}/events/${enc(fgId)}/competitions/${enc(fgId)}/odds" : null) every 30s json timeout 15s status
  source preOdds = http(!fgIsLive && fgId != "" ? "${espnCore}/events/${enc(fgId)}/competitions/${enc(fgId)}/odds" : null) every 1h json timeout 15s status
  source gamePredictor = http(fgId != "" ? "${espnCore}/events/${enc(fgId)}/competitions/${enc(fgId)}/predictor" : null) every 1h json timeout 15s status

  let gameOdds = fgIsLive ? (liveOdds ?? preOdds) : preOdds
  let oddsItems = (gameOdds != null && gameOdds.ok ? gameOdds.out.items : null) ?? []
  let liveOddsItem = oddsItems.find(o => str(o.provider.id ?? "") == "200" || contains(lower(o.provider.name ?? ""), "live"))
  let preOddsItem = oddsItems.find(o => str(o.provider.id ?? "") == "100") ?? oddsItems.find(o => str(o.provider.id ?? "") != "200")
  let fallbackSbOdds = first(fgComp.odds ?? [])
  let hasLiveOdds = !fgIsFinal && liveOddsItem != null
  let activeOdds = hasLiveOdds ? liveOddsItem : (preOddsItem ?? fallbackSbOdds)
  let hasOdds = activeOdds != null

  let oddsProvider = replace(activeOdds.provider.name ?? "DraftKings", " - Live Odds", "")
  let oddsDetails = activeOdds.details ?? ""
  let oddsOuStr = (fgIsFinal ? activeOdds.close.total.american : null) ?? activeOdds.current.total.american ?? (activeOdds.overUnder != null ? "${activeOdds.overUnder}" : "")
  let oddsOverJuice = (fgIsFinal ? activeOdds.close.over.american : null) ?? activeOdds.current.over.american ?? (activeOdds.overOdds != null ? (activeOdds.overOdds > 0 ? "+${int(activeOdds.overOdds)}" : "${int(activeOdds.overOdds)}") : "")
  let oddsUnderJuice = (fgIsFinal ? activeOdds.close.under.american : null) ?? activeOdds.current.under.american ?? (activeOdds.underOdds != null ? (activeOdds.underOdds > 0 ? "+${int(activeOdds.underOdds)}" : "${int(activeOdds.underOdds)}") : "")

  let oddsAwaySpread = (fgIsFinal ? activeOdds.awayTeamOdds.close.pointSpread.american : null) ?? activeOdds.awayTeamOdds.current.pointSpread.american ?? (activeOdds.spread != null ? (activeOdds.spread == 0 ? "PK" : (-activeOdds.spread > 0 ? "+${-activeOdds.spread}" : "${-activeOdds.spread}")) : "")
  let oddsHomeSpread = (fgIsFinal ? activeOdds.homeTeamOdds.close.pointSpread.american : null) ?? activeOdds.homeTeamOdds.current.pointSpread.american ?? (activeOdds.spread != null ? (activeOdds.spread == 0 ? "PK" : (activeOdds.spread > 0 ? "+${activeOdds.spread}" : "${activeOdds.spread}")) : "")
  let oddsAwaySpreadJuice = (fgIsFinal ? activeOdds.awayTeamOdds.close.spread.american : null) ?? activeOdds.awayTeamOdds.current.spread.american ?? (activeOdds.awayTeamOdds.spreadOdds != null ? (activeOdds.awayTeamOdds.spreadOdds > 0 ? "+${int(activeOdds.awayTeamOdds.spreadOdds)}" : "${int(activeOdds.awayTeamOdds.spreadOdds)}") : "")
  let oddsHomeSpreadJuice = (fgIsFinal ? activeOdds.homeTeamOdds.close.spread.american : null) ?? activeOdds.homeTeamOdds.current.spread.american ?? (activeOdds.homeTeamOdds.spreadOdds != null ? (activeOdds.homeTeamOdds.spreadOdds > 0 ? "+${int(activeOdds.homeTeamOdds.spreadOdds)}" : "${int(activeOdds.homeTeamOdds.spreadOdds)}") : "")

  let oddsAwayMl = (fgIsFinal ? activeOdds.awayTeamOdds.close.moneyLine.american : null) ?? activeOdds.awayTeamOdds.current.moneyLine.american ?? (activeOdds.awayTeamOdds.moneyLine != null ? (activeOdds.awayTeamOdds.moneyLine > 0 ? "+${int(activeOdds.awayTeamOdds.moneyLine)}" : "${int(activeOdds.awayTeamOdds.moneyLine)}") : "")
  let oddsHomeMl = (fgIsFinal ? activeOdds.homeTeamOdds.close.moneyLine.american : null) ?? activeOdds.homeTeamOdds.current.moneyLine.american ?? (activeOdds.homeTeamOdds.moneyLine != null ? (activeOdds.homeTeamOdds.moneyLine > 0 ? "+${int(activeOdds.homeTeamOdds.moneyLine)}" : "${int(activeOdds.homeTeamOdds.moneyLine)}") : "")
  let oddsMlCompact = oddsAwayMl != "" && oddsHomeMl != "" ? "${fgAwayAbbr} ${oddsAwayMl} / ${fgHomeAbbr} ${oddsHomeMl}" : (oddsAwayMl != "" ? "${fgAwayAbbr} ${oddsAwayMl}" : (oddsHomeMl != "" ? "${fgHomeAbbr} ${oddsHomeMl}" : ""))

  let oddsSpreadHeadline = oddsDetails != "" ? oddsDetails : (oddsHomeSpread != "" ? "${fgHomeAbbr} ${oddsHomeSpread}" : "")
  let oddsBadgeText = hasLiveOdds ? "● LIVE" : (fgIsFinal || fgIsLive ? "CLOSE" : "ODDS")

  let preCloseDetails = preOddsItem.details ?? ""
  let preCloseOu = preOddsItem.overUnder != null ? "O/U ${preOddsItem.overUnder}" : ""
  let preCloseRef = preCloseDetails != "" && preCloseOu != "" ? "${preCloseDetails} • ${preCloseOu}" : (preCloseDetails != "" ? preCloseDetails : preCloseOu)

  let openAwaySp = activeOdds.awayTeamOdds.open.pointSpread.american ?? ""
  let openHomeSp = activeOdds.homeTeamOdds.open.pointSpread.american ?? ""
  let openSpreadStr = activeOdds.awayTeamOdds.open.favorite == true && openAwaySp != "" ? "${fgAwayAbbr} ${openAwaySp}" : (activeOdds.homeTeamOdds.open.favorite == true && openHomeSp != "" ? "${fgHomeAbbr} ${openHomeSp}" : (openAwaySp != "" ? "${fgAwayAbbr} ${openAwaySp}" : ""))
  let openTotalStr = activeOdds.open.total.american != null ? "O/U ${activeOdds.open.total.american}" : ""
  let openRef = openSpreadStr != "" && openTotalStr != "" ? "${openSpreadStr} • ${openTotalStr}" : (openSpreadStr != "" ? openSpreadStr : openTotalStr)
  let oddsRefLabel = hasLiveOdds && preCloseRef != "" ? "Pregame Close: ${preCloseRef}" : (!hasLiveOdds && openRef != "" ? "Open: ${openRef}" : "")

  let sbLiveAwayProb = fgSit.lastPlay.probability.awayWinPercentage
  let sbLiveHomeProb = fgSit.lastPlay.probability.homeWinPercentage
  let sbLiveProbPair = fgIsLive && fgId != "" && sbLiveAwayProb != null && sbLiveHomeProb != null ? {id: fgId, away: sbLiveAwayProb, home: sbLiveHomeProb} : null
  on sbLiveProbPair first {
    if value != null { lastLiveProb = value }
  }
  let cachedLiveProb = fgIsLive && lastLiveProb != null && lastLiveProb.id == fgId ? lastLiveProb : null
  let liveAwayProbRaw = sbLiveAwayProb ?? cachedLiveProb.away
  let liveHomeProbRaw = sbLiveHomeProb ?? cachedLiveProb.home
  let hasLiveProb = fgIsLive && liveAwayProbRaw != null && liveHomeProbRaw != null

  let predData = gamePredictor != null && gamePredictor.ok ? gamePredictor.out : null
  let predAwayStat = (predData.awayTeam.statistics ?? []).find(s => s.name == "gameProjection")
  let predHomeStat = (predData.homeTeam.statistics ?? []).find(s => s.name == "gameProjection")
  let predAwayPct = predAwayStat.value != null ? num(predAwayStat.value) : null
  let predHomePct = predHomeStat.value != null ? num(predHomeStat.value) : null

  let awayWinPct = hasLiveProb ? liveAwayProbRaw * 100 : predAwayPct
  let homeWinPct = hasLiveProb ? liveHomeProbRaw * 100 : predHomePct
  let hasWinProb = awayWinPct != null && homeWinPct != null
  let awayWinPctStr = hasWinProb ? fixed(awayWinPct, 1) : ""
  let homeWinPctStr = hasWinProb ? fixed(homeWinPct, 1) : ""

  // Previous game details
  let pgComp = prevGame.competitions[0]
  let pgAway = pgComp.competitors.filter(t => t.homeAway == 'away')[0] ?? pgComp.competitors[1]
  let pgHome = pgComp.competitors.filter(t => t.homeAway == 'home')[0] ?? pgComp.competitors[0]
  let pgIsHome = (pgHome.team.id ?? '') == '264'
  let pgUw = pgIsHome ? pgHome : pgAway
  let pgOpp = pgIsHome ? pgAway : pgHome
  let pgWon = pgUw.winner == true
  let pgUwScore = pgUw.score.displayValue ?? pgUw.score ?? '0'
  let pgOppScore = pgOpp.score.displayValue ?? pgOpp.score ?? '0'
  let pgOppId = pgOpp.team.id ?? ''
  let pgOppAbbr = pgOpp.team.abbreviation ?? ''
  let pgResult = "${pgWon ? 'W' : 'L'} ${pgUwScore}-${pgOppScore} ${pgIsHome ? 'vs' : '@'} ${pgOppAbbr}"

  // Next upcoming game summary (shown when featured is a recent final)
  let ngComp = nextSchedGame.competitions[0]
  let ngComps = ngComp.competitors ?? []
  let ngOpp = ngComps.find(t => (t.team.id ?? '') != '264')
  let ngOppId = ngOpp.team.id ?? ''
  let ngOppAbbr = ngOpp.team.abbreviation ?? ''
  let ngOppRankNum = ngOpp.curatedRank.current ?? 99
  let ngOppLabel = ngOppRankNum <= 25 ? "#${ngOppRankNum} ${ngOppAbbr}" : ngOppAbbr
  let ngDate = parseTime(nextSchedGame.date)
  let ngTimeValid = ngComp.timeValid != false
  let ngWhen = ngDate != null ? (ngTimeValid ? fmtTime(ngDate, "EEE, M/d h:mma") : "${fmtTime(ngDate, "EEE, M/d", "America/New_York")} • TBD") : (ngComp.status.type.shortDetail ?? 'TBD')

  // Dynamic N-source news aggregation
  let newsItems_0 = (newsFeed.articles ?? []).map(a => ({
    id: "newsFeed-${a.id ?? a.headline}",
    src: "ESPN",
    title: a.headline ?? "",
    desc: a.description ?? "",
    link: a.links.web.href ?? "",
    ts: parseTime(a.published)
  }))
  let newsItems_1 = (uwNews.items ?? []).map(st => ({
    id: "uwNews-${st.id ?? st.title}",
    src: "GoHuskies",
    title: st.title ?? "",
    desc: st.summary ?? "",
    link: startsWith(st.slug ?? "", "http") ? st.slug : "https://gohuskies.com${st.slug ?? ''}",
    ts: parseTime(st.published)
  }))
  let newsItems_2 = take(matchAll((foxRss != null && foxRss.ok ? foxRss.out : "") ?? "", "<item>[\\s\\S]*?<title>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</title>[\\s\\S]*?<link>([^<]+)</link>[\\s\\S]*?<pubDate>([^<]+)</pubDate>")
    .map(m => ({
      id: "foxRss-${trim(m[1])}",
      src: "FOX Sports",
      title: replace(replace(replace(replace(trim(m[0]), "&amp;", "&"), "&#39;", "'"), "&apos;", "'"), "&quot;", "\""),
      desc: "",
      link: trim(m[1]),
      ts: parseTime(trim(m[2]))
    })), 15)
  let newsItems_3 = take(matchAll(b1gRss ?? "", "<item>[\\s\\S]*?<title>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</title>[\\s\\S]*?<link>([^<]+)</link>[\\s\\S]*?<pubDate>([^<]+)</pubDate>")
    .map(m => ({
      id: "b1gRss-${trim(m[1])}",
      src: "Big Ten",
      title: replace(replace(replace(replace(trim(m[0]), "&amp;", "&"), "&#39;", "'"), "&apos;", "'"), "&quot;", "\""),
      desc: "",
      link: trim(m[1]),
      ts: parseTime(trim(m[2]))
    })), 15)
  let allArticles = flatten([newsItems_0, newsItems_1, newsItems_2, newsItems_3])
    .filter(a => a.title != "" && a.link != "")
    .sortBy(a => -(a.ts ?? 0))
  let newsSources = [
    {id: "all", label: "All", w: 2},
    {id: "ESPN", label: "ESPN", w: 2},
    {id: "GoHuskies", label: "GoHuskies", w: 3},
    {id: "FOX Sports", label: "FOX", w: 2},
    {id: "Big Ten", label: "Big Ten", w: 2}
  ]
  let articles = newsFilter == "all" ? allArticles : allArticles.filter(a => a.src == newsFilter)

  // Responsive tile scaling (adapts to tile size and visible content strips)
  let th = tileHeight ?? 282
  let tw = tileWidth ?? 414
  let hasSubStrip = (fgIsPre && prevGame != null) || (fgIsFinal && nextSchedGame != null)
  let hasLiveSit = fgIsLive && fgDownDist != ""
  let scoreBaseH = 173 + (hasSubStrip ? 23 : 0) + (hasLiveSit ? 19 : 0) + (hasOdds ? 21 : 0) + (hasWinProb ? 21 : 0)
  let scoreSpare = th - scoreBaseH
  let isCompactTile = scoreSpare < 26
  let isNarrowTile = tw < 290
  let isTightWidth = tw < 340
  let extraSpace = max(0, scoreSpare - 46)
  let tileGap = int(clamp(3 + extraSpace * 0.04, 3, 6))
  let cardPadY = int(clamp(4 + extraSpace * 0.06, 4, 8))
  let cardPadX = isNarrowTile ? 6 : 8
  let cardGap = int(clamp(2 + extraSpace * 0.05, 2, 5))
  let tabPadY = int(clamp(3 + extraSpace * 0.04, 3, 6))
  let stripPadY = int(clamp(3 + extraSpace * 0.04, 3, 6))
  let barH = scoreSpare >= 64 ? 4 : 3
  let baseLogoPx = isCompactTile ? 22 : int(clamp(scoreSpare * 0.64, 24, 42))
  let winLogoPx = int(clamp(round(baseLogoPx * 1.08), 26, 40))
  let loseLogoPx = int(max(18, round(baseLogoPx * 0.78)))
  let fgHasWinner = fgIsFinal && (fgAway.winner == true || fgHome.winner == true)
  let awayIsWinner = fgHasWinner && fgAway.winner == true
  let homeIsWinner = fgHasWinner && fgHome.winner == true
  let uwWonFeatured = fgHasWinner && fgUw.winner == true
  let awayLogoPx = fgHasWinner ? (awayIsWinner ? winLogoPx : loseLogoPx) : baseLogoPx
  let homeLogoPx = fgHasWinner ? (homeIsWinner ? winLogoPx : loseLogoPx) : baseLogoPx
  let auraW = fgHasWinner ? min(int(tw * 0.25), int(round(winLogoPx * 2.65))) : baseLogoPx
  let logoSlotH = fgHasWinner ? int(round(winLogoPx * 1.38)) : baseLogoPx
  let screenAwayLogoPx = fgHasWinner ? (awayIsWinner ? 56 : 44) : 54
  let screenHomeLogoPx = fgHasWinner ? (homeIsWinner ? 56 : 44) : 54
  let screenAuraW = fgHasWinner ? 114 : 58
  let screenLogoSlotH = fgHasWinner ? 86 : 58
  let expandBtnSz = int(clamp(min(tw, th) * 0.095, 22, 32))
  let expandIconSz = int(clamp(round(expandBtnSz * 0.56), 13, 18))
  let scoreFontSize = int(clamp(20 + extraSpace * 0.08, 20, 28))
  let centerColW = int(clamp(tw * 0.30, 86, 130))
  let b1gTop2 = take(b1gEntries, 2)
  let uwInTop2 = any(b1gTop2, e => (e.team.id ?? '') == '264')
  let b1gStripTight = uwInTop2 ? take(b1gEntries, 3) : (uwStandingsEntry != null ? flatten([b1gTop2, [uwStandingsEntry]]) : b1gTop2)
  let b1gTop1 = take(b1gEntries, 1)
  let uwInTop1 = any(b1gTop1, e => (e.team.id ?? '') == '264')
  let b1gStripNarrow = uwInTop1 ? take(b1gEntries, 2) : (uwStandingsEntry != null ? flatten([b1gTop1, [uwStandingsEntry]]) : b1gTop1)
  let b1gQuickStrip = isNarrowTile ? b1gStripNarrow : (isTightWidth ? b1gStripTight : b1gStrip)

  component TeamLogo(id, px = 20, plate = false) {
    let tid = str(id ?? '')
    if tid != '' && tid != 'null' {
      if plate {
        let boxSz = px <= 20 ? px : px + 4
        let imgSz = px <= 20 ? max(12, px - 2) : px
        Box {
          size: boxSz
          radius: boxSz / 2
          background: alpha(#ffffff, px <= 20 ? 0.11 : 0.08)
          align: center
          Image {
            src: "https://a.espncdn.com/i/teamlogos/ncaa/500/${tid}.png"
            size: imgSz
            fit: contain
          }
        }
      } else {
        Image {
          src: "https://a.espncdn.com/i/teamlogos/ncaa/500/${tid}.png"
          size: px
          fit: contain
        }
      }
    }
  }

  // ── Shared UI Components (from teamwatch/engine/ui_shared.owl.tmpl) ──
  component NewsFilterBar(padY = 3, chipRadius = 6) {
    Row {
      fill: width
      gap: 4
      for f in newsSources key f.id {
        let active = newsFilter == f.id
        Box {
          weight: f.w
          padding: [padY, 4]
          radius: chipRadius * corners
          background: active ? tabActiveBg : alpha(surface, 0.4)
          border: 1
          borderColor: active ? tabActiveBorder : border
          onTap: { haptic(); newsFilter = f.id }
          Text {
            text: f.label
            style: label
            bold: active
            color: active ? tabActiveText : muted
            align: center
            maxLines: 1
          }
        }
      }
    }
  }

  component WinnerAura(w, h, col) {
    Canvas {
      width: w
      height: h
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2
      let rRing = r * 0.88
      let pulse = 0.94 + 0.06 * sin(time * 2.2)
      let rGlow = r * 0.98 * pulse
      circle(cx, cy, rGlow, fill: radial(cx, cy, rGlow, [alpha(col, 0.34), alpha(col, 0.13), alpha(col, 0.0)]))
      circle(cx, cy, rRing, fill: alpha(col, 0.11), stroke: alpha(col, 0.50), width: 1.3)
      let stars = [
        {dx: -1.24, dy: -0.58, ph: 0.2, s: 1.02},
        {dx: 1.24, dy: -0.54, ph: 1.6, s: 1.10},
        {dx: -1.34, dy: 0.34, ph: 3.1, s: 0.86},
        {dx: 1.32, dy: 0.38, ph: 4.5, s: 0.94},
        {dx: 1.12, dy: -0.84, ph: 2.3, s: 0.72}
      ]
      for st in stars {
        let twk = 0.32 + 0.68 * pow(0.5 + 0.5 * sin(time * 3.0 + st.ph), 2)
        let drift = sin(time * 1.6 + st.ph) * (r * 0.05)
        let sx = clamp(cx + st.dx * rRing, 5, width - 5)
        let sy = clamp(cy + st.dy * rRing + drift, 5, height - 5)
        let sr = max(2.2, r * 0.15 * st.s * (0.65 + 0.55 * twk))
        path([
          [sx, sy - sr], [sx + sr * 0.28, sy - sr * 0.28],
          [sx + sr, sy], [sx + sr * 0.28, sy + sr * 0.28],
          [sx, sy + sr], [sx - sr * 0.28, sy + sr * 0.28],
          [sx - sr, sy], [sx - sr * 0.28, sy - sr * 0.28]
        ], closed: true, fill: alpha(mix(col, foreground, 0.35), 0.40 + 0.60 * twk))
      }
    }
  }

  component BooAura(w, h) {
    Canvas {
      width: w
      height: h
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2
      let rRing = r * 0.88
      let pulse = 0.94 + 0.06 * sin(time * 2.0)
      let rGlow = r * 0.98 * pulse
      circle(cx, cy, rGlow, fill: radial(cx, cy, rGlow, [alpha(red, 0.28), alpha(red, 0.10), alpha(red, 0.0)]))
      circle(cx, cy, rRing, fill: alpha(red, 0.08), stroke: alpha(red, 0.44), width: 1.2)
      let b1 = sin(time * 2.6) * (r * 0.08)
      let b2 = sin(time * 2.6 + 2.2) * (r * 0.08)
      let a1 = 0.55 + 0.45 * (0.5 + 0.5 * sin(time * 3.0))
      let a2 = 0.55 + 0.45 * (0.5 + 0.5 * sin(time * 3.0 + 2.4))
      let tx1 = max(14, cx - rRing * 1.28)
      let ty1 = max(7, cy - rRing * 0.62) + b1
      let tx2 = min(width - 17, cx + rRing * 1.28)
      let ty2 = min(height - 7, cy + rRing * 0.58) + b2
      rotate(-14, tx1, ty1) {
        text("BOO!", tx1, ty1, size: max(7, r * 0.26), color: alpha(red, a1), align: center, bold: true)
      }
      rotate(11, tx2, ty2) {
        text("BOOOO", tx2, ty2, size: max(6.5, r * 0.23), color: alpha(red, a2), align: center, bold: true)
      }
      let d1 = (time * 0.55) % 1
      let d2 = (time * 0.55 + 0.5) % 1
      let vx1 = min(width - 9, cx + rRing * 1.22)
      let vy1 = max(6, cy - rRing * 0.65) + d1 * (r * 0.32)
      let vx2 = max(9, cx - rRing * 1.22)
      let vy2 = max(10, cy + rRing * 0.22) + d2 * (r * 0.32)
      let cr = max(2.2, r * 0.11)
      path([[vx1 - cr, vy1 - cr * 0.5], [vx1, vy1 + cr * 0.5], [vx1 + cr, vy1 - cr * 0.5]], stroke: alpha(red, (1 - d1) * 0.75), width: 1.4, cap: round)
      path([[vx2 - cr, vy2 - cr * 0.5], [vx2, vy2 + cr * 0.5], [vx2 + cr, vy2 - cr * 0.5]], stroke: alpha(red, (1 - d2) * 0.75), width: 1.4, cap: round)
    }
  }

  component ExpandButton(sz, iconSz, col) {
    Box {
      size: sz
      align: center
      radius: 6 * corners
      background: alpha(surface, 0.55)
      border: 1
      borderColor: alpha(border, 0.55)
      onTap: { haptic(); screen() }
      Canvas {
        width: iconSz
        height: iconSz
        let m = iconSz * 0.14
        let h = iconSz * 0.38
        let sw = max(1.6, iconSz * 0.10)
        line(m, iconSz - m, iconSz - m, m, stroke: col, width: sw, cap: round)
        line(iconSz - m - h, m, iconSz - m, m, stroke: col, width: sw, cap: round)
        line(iconSz - m, m, iconSz - m, m + h, stroke: col, width: sw, cap: round)
        line(m, iconSz - m, m + h, iconSz - m, stroke: col, width: sw, cap: round)
        line(m, iconSz - m, m, iconSz - m - h, stroke: col, width: sw, cap: round)
      }
    }
  }


  component ScoreFeaturedCard(expand = false) {
    Column {
      fill: width
      weight: expand ? 1 : 0
      padding: [cardPadX, cardPadY]
      radius: 8 * corners
      background: alpha(surface, 0.6)
      border: 1
      borderColor: fgIsLive ? accentColor : border
      gap: cardGap

      Row {
        fill: width
        align: center
        gap: 6
        Text {
          text: fgIsLive ? "LIVE GAME" : (fgIsFinal ? (fgVenue != "" ? "FINAL • W${fgWeekNum ?? ''} • ${fgVenue}" : "FINAL • WEEK ${fgWeekNum ?? ''}") : (fgVenue != "" ? "W${fgWeekNum ?? ''} • ${fgVenue}" : "UPCOMING • WEEK ${fgWeekNum ?? ''}"))
          style: small
          bold: true
          color: fgIsLive ? accentColor : (fgIsFinal ? (fgUw.winner == true ? secondaryColor : muted) : secondaryColor)
          weight: 1
          maxLines: 1
        }
        if fgIsFinal {
          Text {
            text: fgUw.winner == true ? "WIN" : "LOSS"
            style: label
            bold: true
            color: fgUw.winner == true ? winColor : red
            padding: [4, 1]
            radius: 3 * corners
            background: fgUw.winner == true ? alpha(winColor, 0.2) : alpha(red, 0.2)
          }
        } else if fgBroadcast != "" {
          Text {
            text: fgBroadcast
            style: label
            bold: true
            color: foreground
            padding: [4, 1]
            radius: 3 * corners
            background: alpha(secondaryColor, 0.25)
          }
        }
      }

      // Teams and scores/time
      Row {
        fill: width
        weight: expand ? 1 : 0
        align: center
        gap: 4

        // Away Team
        Column {
          weight: 1
          align: center
          gap: 1
          Box {
            width: awayIsWinner ? auraW : awayLogoPx
            height: logoSlotH
            align: center
            if awayIsWinner {
              if uwWonFeatured {
                WinnerAura { w: auraW; h: logoSlotH; col: secondaryColor }
              } else {
                BooAura { w: auraW; h: logoSlotH }
              }
            }
            Box {
              opacity: fgHasWinner && !awayIsWinner ? 0.82 : 1
              TeamLogo { id: fgAway.team.id; px: awayLogoPx; plate: !awayIsWinner }
            }
          }
          Text {
            text: fgAwayRank != null ? "#${fgAwayRank} ${fgAwayAbbr}" : fgAwayAbbr
            bold: true
            style: small
            color: fgIsFinal && !fgAway.winner ? muted : foreground
            align: center
          }
          if fgAwayRec != "" {
            Text { text: fgAwayRec; style: label; color: muted; align: center }
          }
        }

        // Center Score or Kickoff
        Column {
          align: center
          gap: 1
          width: centerColW
          if fgIsPre {
            Text { text: "AT"; style: label; color: muted; bold: true; align: center }
            Text { text: fgKickDate; style: small; color: foreground; bold: true; align: center }
            Text { text: fgKickTime; style: small; color: secondaryColor; align: center; bold: true }
          } else {
            Row {
              gap: 6
              align: center
              Text {
                text: fgAwayScore
                fontSize: scoreFontSize
                bold: true
                color: fgIsFinal && !fgAway.winner ? muted : foreground
              }
              Text { text: "-"; fontSize: scoreFontSize; color: muted }
              Text {
                text: fgHomeScore
                fontSize: scoreFontSize
                bold: true
                color: fgIsFinal && !fgHome.winner ? muted : foreground
              }
            }
            Text {
              text: fgStatusText
              style: small
              color: fgIsLive ? accentColor : muted
              bold: fgIsLive
              align: center
              maxLines: 1
            }
          }
        }

        // Home Team
        Column {
          weight: 1
          align: center
          gap: 1
          Box {
            width: homeIsWinner ? auraW : homeLogoPx
            height: logoSlotH
            align: center
            if homeIsWinner {
              if uwWonFeatured {
                WinnerAura { w: auraW; h: logoSlotH; col: secondaryColor }
              } else {
                BooAura { w: auraW; h: logoSlotH }
              }
            }
            Box {
              opacity: fgHasWinner && !homeIsWinner ? 0.82 : 1
              TeamLogo { id: fgHome.team.id; px: homeLogoPx; plate: !homeIsWinner }
            }
          }
          Text {
            text: fgHomeRank != null ? "#${fgHomeRank} ${fgHomeAbbr}" : fgHomeAbbr
            bold: true
            style: small
            color: fgIsFinal && !fgHome.winner ? muted : foreground
            align: center
          }
          if fgHomeRec != "" {
            Text { text: fgHomeRec; style: label; color: muted; align: center }
          }
        }
      }

      // Live down & distance
      if fgIsLive && fgDownDist != "" {
        Row {
          align: center
          gap: 6
          Text { text: "🏈 ${fgDownDist}"; style: small; bold: true; color: accentColor }
          if fgIsRedZone {
            Text {
              text: "RED ZONE"
              style: label
              bold: true
              color: red
              padding: [4, 1]
              radius: 3
              background: alpha(red, 0.2)
            }
          }
        }
      }

      // Compact Betting Odds Strip
      if hasOdds {
        Box {
          fill: width
          padding: [6, 2]
          radius: 5 * corners
          background: hasLiveOdds ? alpha(red, 0.12) : alpha(background, 0.35)
          border: hasLiveOdds ? 1 : 0
          borderColor: alpha(red, 0.45)

          Row {
            fill: width
            align: center
            gap: 6
            Text {
              text: oddsBadgeText
              style: label
              bold: true
              color: hasLiveOdds ? red : (fgIsPre || fgIsFinal ? secondaryColor : muted)
            }
            if oddsSpreadHeadline != "" {
              Text { text: oddsSpreadHeadline; style: label; bold: true; color: foreground; maxLines: 1 }
            }
            if oddsOuStr != "" {
              Text { text: "O/U ${oddsOuStr}"; style: label; color: muted; maxLines: 1 }
            }
            Spacer { weight: 1 }
            if !isNarrowTile && oddsMlCompact != "" {
              Text { text: oddsMlCompact; style: label; color: foreground; align: end; maxLines: 1 }
            }
          }
        }
      }

      // Compact ESPN Percentage Odds Bar
      if hasWinProb {
        Column {
          fill: width
          gap: 1
          Row {
            fill: width
            align: center
            Text {
              text: "${fgAwayAbbr} ${awayWinPctStr}%"
              style: label
              bold: !fgIsHome || awayWinPct >= homeWinPct
              color: !fgIsHome ? secondaryColor : (awayWinPct >= homeWinPct ? foreground : muted)
            }
            Spacer { weight: 1 }
            Text {
              text: isNarrowTile ? (hasLiveProb ? "● LIVE" : (fgIsFinal ? "PREGAME" : "WIN PROB")) : (hasLiveProb ? "● ESPN LIVE" : (fgIsFinal ? "PREGAME WIN PROB" : "ESPN WIN PROB"))
              style: label
              bold: hasLiveProb
              color: hasLiveProb ? red : muted
            }
            Spacer { weight: 1 }
            Text {
              text: "${fgHomeAbbr} ${homeWinPctStr}%"
              style: label
              bold: fgIsHome || homeWinPct >= awayWinPct
              color: fgIsHome ? secondaryColor : (homeWinPct >= awayWinPct ? foreground : muted)
            }
          }
          Row {
            fill: width
            height: barH
            radius: 2 * corners
            clip: true
            gap: 2
            Box {
              weight: clamp(awayWinPct, 2, 98)
              height: barH
              background: !fgIsHome ? secondaryColor : alpha(foreground, 0.32)
            }
            Box {
              weight: clamp(homeWinPct, 2, 98)
              height: barH
              background: fgIsHome ? secondaryColor : alpha(foreground, 0.32)
            }
          }
        }
      }
    }
  }

  component ScoreBottomStrips() {
    Column {
      fill: width
      gap: tileGap

      // Previous Game Summary (when featured is upcoming)
      if fgIsPre && prevGame != null {
        Box {
          fill: width
          padding: [6, stripPadY]
          radius: 6 * corners
          background: alpha(surface, 0.6)
          border: 1
          borderColor: border

          Row {
            fill: width
            align: center
            gap: 6
            Text { text: "Last:"; style: small; color: muted }
            Text {
              text: pgWon ? "W" : "L"
              style: small
              bold: true
              color: pgWon ? winColor : red
              padding: [4, 1]
              radius: 3 * corners
              background: pgWon ? alpha(winColor, 0.2) : alpha(red, 0.2)
            }
            TeamLogo { id: pgOppId; px: 16; plate: true }
            Text {
              text: "${pgUwScore}-${pgOppScore} ${pgIsHome ? 'vs' : '@'} ${pgOppAbbr}"
              style: small
              bold: true
            }
            Spacer { weight: 1 }
            Text { text: "W${prevGame.week.number} Final"; style: label; color: muted; maxLines: 1 }
          }
        }
      }

      // Next Upcoming Game Strip (when featured is a recent final)
      if fgIsFinal && nextSchedGame != null {
        Box {
          fill: width
          padding: [6, stripPadY]
          radius: 6 * corners
          background: alpha(surface, 0.6)
          border: 1
          borderColor: border

          Row {
            fill: width
            align: center
            gap: 6
            Text { text: "Next:"; style: small; color: muted }
            TeamLogo { id: ngOppId; px: 16; plate: true }
            Text {
              text: "${ngOpp.homeAway == 'home' ? '@' : 'vs'} ${ngOppLabel}"
              style: small
              bold: true
            }
            Spacer { weight: 1 }
            Text { text: ngWhen; style: label; color: secondaryColor; maxLines: 1 }
          }
        }
      }

      // Big Ten Quick Strip (Top 3 + WASH)
      Box {
        fill: width
        padding: [6, stripPadY]
        radius: 6 * corners
        background: alpha(surface, 0.6)
        border: 1
        borderColor: border
        onTap: { haptic(); tab = "standings" }

        Row {
          fill: width
          align: center
          gap: 4

          Text { text: "B1G"; style: label; bold: true; color: muted; width: 22 }

          for entry, i in b1gQuickStrip key entry.team.id {
            let isUw = (entry.team.id ?? '') == '264'
            let rec = (entry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? '–'

            if i > 0 {
              Box {
                width: 1
                height: 9
                background: alpha(border, 0.55)
              }
            }
            Row {
              align: center
              gap: 3
              TeamLogo { id: entry.team.id; px: 14; plate: true }
              Text {
                text: "${entry.team.abbreviation} ${rec}"
                style: label
                bold: isUw
                color: isUw ? secondaryColor : muted
              }
              if isUw {
                Box {
                  width: 4
                  height: 4
                  radius: 2 * corners
                  background: secondaryColor
                }
              }
            }
          }
          Spacer { weight: 1 }
          Text { text: "›"; style: small; color: muted }
        }
      }
    }
  }

  fps: fgHasWinner && tab == "score" ? (modes.saver ? 15 : 30) : 1
  onTap: { haptic(); screen() }

  Column {
    gap: tileGap
    fill: true

    // Header
    Row {
      gap: 6
      fill: width
      align: center
      Image {
        src: "https://a.espncdn.com/i/teamlogos/ncaa/500/264.png"
        size: 28
        fit: contain
      }
      Column {
        gap: 0
        Row {
          gap: 4
          align: center
          Text { text: "DawgWatch"; style: title; bold: true }
          Text {
            text: recordStr
            style: small
            bold: true
            color: secondaryColor
            padding: [4, 1]
            radius: 4 * corners
            background: alpha(secondaryColor, 0.2)
          }
        }
        Text { text: standingStr; style: label; color: muted; maxLines: 1 }
      }
      Spacer { weight: 1 }
      Row {
        gap: 6
        align: center
        if fgIsLive {
          Text {
            text: "● LIVE"
            style: small
            bold: true
            color: red
            padding: [5, 2]
            radius: 4 * corners
            background: alpha(red, 0.2)
          }
        }
        ExpandButton { sz: expandBtnSz; iconSz: expandIconSz; col: mix(foreground, muted, 0.35) }
      }
    }

    // Tabs
    Row {
      fill: width
      gap: 4
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "score" ? tabActiveBg : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "score" ? accentColor : border
        onTap: { haptic(); tab = "score" }
        Text {
          text: "Score"
          style: small
          bold: tab == "score"
          color: tab == "score" ? accentColor : muted
          align: center
        }
      }
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "standings" ? tabActiveBg : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "standings" ? accentColor : border
        onTap: { haptic(); tab = "standings" }
        Text {
          text: "B1G"
          style: small
          bold: tab == "standings"
          color: tab == "standings" ? accentColor : muted
          align: center
          maxLines: 1
        }
      }
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "stats" ? tabActiveBg : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "stats" ? accentColor : border
        onTap: { haptic(); tab = "stats" }
        Text {
          text: "Stats"
          style: small
          bold: tab == "stats"
          color: tab == "stats" ? accentColor : muted
          align: center
          maxLines: 1
        }
      }
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "news" ? tabActiveBg : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "news" ? accentColor : border
        onTap: { haptic(); tab = "news" }
        Text {
          text: "News"
          style: small
          bold: tab == "news"
          color: tab == "news" ? accentColor : muted
          align: center
        }
      }
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "schedule" ? tabActiveBg : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "schedule" ? accentColor : border
        onTap: { haptic(); tab = "schedule" }
        Text {
          text: isTightWidth ? "Sched" : "Sched"
          style: small
          bold: tab == "schedule"
          color: tab == "schedule" ? accentColor : muted
          align: center
          maxLines: 1
        }
      }
    }

    // Tab content
    if tab == "score" && !isCompactTile {
      Column {
        weight: 1
        fill: width
        gap: tileGap
        ScoreFeaturedCard { expand: true }
        ScoreBottomStrips {}
      }
    } else {
      Column {
        weight: 1
        fill: width
        scroll: true
        onPull: refresh()
        gap: tileGap

        if tab == "score" {
          ScoreFeaturedCard { expand: false }
          ScoreBottomStrips {}
        }

      if tab == "standings" {
        Box {
          fill: width
          padding: 8
          radius: 8 * corners
          background: alpha(surface, 0.6)
          border: 1
          borderColor: border

          Column {
            gap: 4
            fill: width

            Row {
              fill: width
              align: center
              gap: 6
              padding: [4, 2]
              Text { text: "#"; style: label; color: muted; width: 16 }
              Text { text: "TEAM"; style: label; color: muted; weight: 1 }
              Text { text: "OVR"; style: label; color: muted; width: 38; align: end }
              Text { text: "CONF"; style: label; color: muted; width: 38; align: end }
              Text { text: "STRK"; style: label; color: muted; width: 34; align: end }
              Text { text: "DIFF"; style: label; color: muted; width: 36; align: end }
            }

            for entry, i in b1gEntries key entry.team.id {
              let isUw = (entry.team.id ?? '') == '264'
              let rec = (entry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? '–'
              let confRec = (entry.stats.find(s => s.name == 'vs. Conf.') ?? {}).displayValue ?? '–'
              let strk = (entry.stats.find(s => s.name == 'streak') ?? {}).displayValue ?? '–'
              let diff = (entry.stats.find(s => s.name == 'pointDifferential') ?? {}).displayValue ?? '–'

              Row {
                fill: width
                align: center
                gap: 6
                padding: [4, 3]
                radius: 4 * corners
                background: isUw ? highlightBg : rgb(0, 0, 0, 0)

                Text { text: "${i + 1}"; style: small; color: isUw ? secondaryColor : muted; bold: isUw; width: 16 }
                TeamLogo { id: entry.team.id; px: 18; plate: true }
                Text {
                  text: entry.team.shortDisplayName ?? entry.team.displayName
                  style: small
                  bold: isUw
                  color: isUw ? accentColor : foreground
                  weight: 1
                  maxLines: 1
                }
                Text {
                  text: rec
                  style: small
                  bold: true
                  color: isUw ? accentColor : foreground
                  width: 38
                  align: end
                }
                Text {
                  text: confRec
                  style: small
                  color: muted
                  width: 38
                  align: end
                }
                Text {
                  text: strk
                  style: small
                  color: startsWith(strk, 'W') ? winColor : (startsWith(strk, 'L') ? red : muted)
                  width: 34
                  align: end
                }
                Text {
                  text: diff
                  style: label
                  color: startsWith(diff, '+') ? winColor : (startsWith(diff, '-') ? red : muted)
                  width: 36
                  align: end
                }
              }
            }
          }
        }
      }

      if tab == "stats" {
        Column {
          fill: width
          gap: 6

          // Compact Team Season Averages Strip
          Row {
            fill: width
            gap: 4
            for m in [
              {k: "PPG", v: statOffPpg, o: statOppPpg},
              {k: "YPG", v: statOffYpg, o: statOppYpg},
              {k: "PASS", v: statOffPass, o: statOppPass},
              {k: "RUSH", v: statOffRush, o: statOppRush}
            ] {
              Box {
                weight: 1
                padding: [4, 4]
                radius: 6 * corners
                background: alpha(surface, 0.55)
                border: 1
                borderColor: border
                Column {
                  align: center
                  gap: 0
                  Text { text: m.k; style: label; color: muted; align: center }
                  Text { text: m.v; style: small; bold: true; color: accentColor; align: center; maxLines: 1 }
                  Text { text: "vs ${m.o}"; style: label; color: muted; align: center; maxLines: 1 }
                }
              }
            }
          }

          // Player Leaders
          if len(teamLeaders) == 0 {
            Text { text: "No player leaders available yet"; style: small; color: muted; padding: [0, 8] }
          } else {
            for pl in teamLeaders {
              Box {
                fill: width
                padding: [6, 5]
                radius: 6 * corners
                background: alpha(surface, 0.5)
                border: 1
                borderColor: border
                onTap: { if pl.url != "" { haptic(); url(pl.url) } }
                Row {
                  fill: width
                  align: center
                  gap: 8
                  if pl.headshot != "" {
                    Box {
                      size: 28
                      radius: 14
                      clip: true
                      background: alpha(foreground, 0.12)
                      Image { src: pl.headshot; size: 28; fit: cover }
                    }
                  }
                  Column {
                    weight: 1
                    gap: 1
                    Row {
                      fill: width
                      align: center
                      gap: 5
                      Text { text: pl.name; style: small; bold: true; color: foreground; maxLines: 1 }
                      if pl.pos != "" {
                        Text { text: pl.pos; style: label; color: muted }
                      }
                      Spacer { weight: 1 }
                      Text { text: upper(pl.cat); style: label; bold: true; color: accentColor }
                    }
                    Text { text: pl.line; style: label; color: secondaryColor; maxLines: 1 }
                  }
                }
              }
            }
          }
        }
      }

      if tab == "news" {
        Column {
          gap: 4
          fill: width
          Row {
            fill: width
            gap: 4
            for f in newsSources key f.id {
              let active = newsFilter == f.id
              Box {
                weight: 1
                padding: [3, 4]
                radius: 6 * corners
                background: active ? tabActiveBg : alpha(surface, 0.4)
                border: 1
                borderColor: active ? accentColor : border
                onTap: { haptic(); newsFilter = f.id }
                Text {
                  text: f.label
                  style: label
                  bold: active
                  color: active ? accentColor : muted
                  align: center
                  maxLines: 1
                }
              }
            }
          }

          if len(articles) == 0 {
            Text { text: "Loading Huskies news…"; style: small; color: muted; align: center }
          } else {
            for item in articles.take(6) key item.id {
              Box {
                fill: width
                padding: [6, 4]
                radius: 6 * corners
                onTap: { haptic(); url(item.link) }

                Row {
                  fill: width
                  gap: 6
                  align: top
                  Box {
                    width: 4
                    height: 14
                    radius: 2
                    background: secondaryColor
                    offset: [0, 3]
                  }
                  Column {
                    gap: 2
                    weight: 1
                    Text {
                      text: item.title
                      style: small
                      bold: true
                      maxLines: 2
                    }
                    Row {
                      gap: 6
                      if item.ts > 0 {
                        Text { text: fmtAgo(item.ts, now); style: label; color: accentColor; bold: true }
                      }
                      Text { text: item.src; style: label; color: muted; maxLines: 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }

      if tab == "schedule" {
        for g in schedEvents key g.id {
          let gc = g.competitions[0]
          let gcomps = gc.competitors ?? []
          let gUw = gcomps.find(t => (t.team.id ?? '') == '264')
          let gOpp = gcomps.find(t => (t.team.id ?? '') != '264')
          let gOppId = gOpp.team.id ?? ''
          let gOppAbbr = gOpp.team.abbreviation ?? ''
          let gOppRankNum = gOpp.curatedRank.current ?? 99
          let gOppLabel = gOppRankNum <= 25 ? "#${gOppRankNum} ${gOppAbbr}" : gOppAbbr
          let gState = gc.status.type.state ?? 'pre'
          let gWon = gUw.winner == true
          let isDone = gState == 'post'
          let isCurrent = g.id == featuredGame.id
          let scUw = gUw.score.displayValue ?? gUw.score ?? '–'
          let scOpp = gOpp.score.displayValue ?? gOpp.score ?? '–'
          let dt = parseTime(g.date)
          let gTimeValid = gc.timeValid != false

          Box {
            fill: width
            padding: [4, 2]
            radius: 4 * corners
            background: isCurrent ? highlightBg : rgb(0, 0, 0, 0)
            border: isCurrent ? 1 : 0
            borderColor: accentColor

            Row {
              fill: width
              align: center
              gap: 6

              Text { text: "W${g.week.number}"; style: small; color: isCurrent ? accentColor : muted; width: 28; bold: isCurrent }
              TeamLogo { id: gOppId; px: 18 }
              Text {
                text: "${gOpp.homeAway == 'home' ? '@' : 'vs'} ${gOppLabel}"
                style: small
                bold: isCurrent || gState == 'in'
                color: gState == 'in' ? accentColor : foreground
              }
              Spacer { weight: 1 }
              if isDone {
                Text {
                  text: "${gWon ? 'W' : 'L'} ${scUw}-${scOpp}"
                  style: small
                  bold: true
                  color: gWon ? winColor : red
                  align: end
                }
              } else if gState == 'in' {
                Text { text: "LIVE"; style: small; bold: true; color: accentColor; align: end }
              } else {
                Text {
                  text: dt != null ? (gTimeValid ? fmtTime(dt, "M/d h:mma") : "${fmtTime(dt, "M/d", "America/New_York")} TBD") : (gc.status.type.shortDetail ?? 'TBD')
                  style: small
                  color: isCurrent ? secondaryColor : muted
                  bold: isCurrent
                  align: end
                }
              }
            }
          }
        }
      }
    }
    }
  }

  // Full-screen Game Center
  screen {
    title: "DawgWatch"

    Column {
      scroll: true
      onPull: refresh()
      gap: 12
      padding: 12

      // Top Hero Banner
      Box {
        fill: width
        padding: [12, 9]
        radius: 10 * corners
        background: alpha(surface, 0.6)
        border: 1
        borderColor: accentColor

        Row {
          fill: width
          align: center
          gap: 10
          Image {
            src: "https://a.espncdn.com/i/teamlogos/ncaa/500/264.png"
            size: 38
            fit: contain
          }
          Column {
            gap: 1
            weight: 1
            Text { text: "Washington Huskies"; style: body; bold: true }
            Text { text: standingStr; style: label; color: muted }
          }
          Column {
            align: end
            width: 72
            gap: 1
            Text { text: recordStr; style: title; bold: true; color: secondaryColor; align: end }
            Text { text: "RECORD"; style: label; color: muted; align: end }
          }
        }
      }

      // Screen navigation tabs
      Row {
        fill: width
        gap: 6
        Box {
          weight: 1
          padding: [0, 8]
          radius: 8 * corners
          background: screenTab == "game" ? tabActiveBg : alpha(surface, 0.4)
          border: 1
          borderColor: screenTab == "game" ? accentColor : border
          onTap: { haptic(); screenTab = "game" }
          Text {
            text: "Game"
            style: small
            bold: screenTab == "game"
            color: screenTab == "game" ? accentColor : muted
            align: center
          }
        }
        Box {
          weight: 1
          padding: [0, 8]
          radius: 8 * corners
          background: screenTab == "stats" ? tabActiveBg : alpha(surface, 0.4)
          border: 1
          borderColor: screenTab == "stats" ? accentColor : border
          onTap: { haptic(); screenTab = "stats" }
          Text {
            text: "Stats"
            style: small
            bold: screenTab == "stats"
            color: screenTab == "stats" ? accentColor : muted
            align: center
          }
        }
        Box {
          weight: 1
          padding: [0, 8]
          radius: 8 * corners
          background: screenTab == "news" ? tabActiveBg : alpha(surface, 0.4)
          border: 1
          borderColor: screenTab == "news" ? accentColor : border
          onTap: { haptic(); screenTab = "news" }
          Text {
            text: "News"
            style: small
            bold: screenTab == "news"
            color: screenTab == "news" ? accentColor : muted
            align: center
          }
        }
        Box {
          weight: 1
          padding: [0, 8]
          radius: 8 * corners
          background: screenTab == "schedule" ? tabActiveBg : alpha(surface, 0.4)
          border: 1
          borderColor: screenTab == "schedule" ? accentColor : border
          onTap: { haptic(); screenTab = "schedule" }
          Text {
            text: "Schedule"
            style: small
            bold: screenTab == "schedule"
            color: screenTab == "schedule" ? accentColor : muted
            align: center
          }
        }
      }

      // Screen Tab 1: Game Center
      if screenTab == "game" {
        Column {
          gap: 10
          fill: width

          Text { text: fgIsLive ? "LIVE GAME" : (fgIsFinal ? "FINAL RESULT" : "NEXT MATCHUP"); style: label; color: muted }

          Box {
            fill: width
            padding: 14
            radius: 10 * corners
            background: alpha(surface, 0.6)
            border: 1
            borderColor: fgIsLive ? accentColor : border

            Column {
              gap: 12
              fill: width

              Row {
                fill: width
                align: center
                Text {
                  text: fgIsLive ? "● LIVE IN PROGRESS" : (fgIsFinal ? "FINAL SCORE" : "WEEK ${featuredGame.week.number ?? ''} MATCHUP")
                  style: small
                  bold: true
                  color: fgIsLive ? accentColor : secondaryColor
                }
                Spacer { weight: 1 }
                if fgIsFinal {
                  Text {
                    text: fgUw.winner == true ? "WIN" : "LOSS"
                    style: small
                    bold: true
                    color: fgUw.winner == true ? winColor : red
                    padding: [6, 2]
                    radius: 4 * corners
                    background: fgUw.winner == true ? alpha(winColor, 0.2) : alpha(red, 0.2)
                  }
                } else if fgBroadcast != "" {
                  Text {
                    text: "TV: ${fgBroadcast}"
                    style: small
                    color: secondaryColor
                    padding: [6, 2]
                    radius: 4 * corners
                    background: alpha(secondaryColor, 0.15)
                  }
                }
              }

              // Large Matchup View
              Row {
                fill: width
                align: center

                // Away Team
                Column {
                  weight: 1
                  align: center
                  gap: 4
                  Box {
                    width: awayIsWinner ? screenAuraW : screenAwayLogoPx + 4
                    height: screenLogoSlotH
                    align: center
                    if awayIsWinner {
                      if uwWonFeatured {
                        WinnerAura { w: screenAuraW; h: screenLogoSlotH; col: secondaryColor }
                      } else {
                        BooAura { w: screenAuraW; h: screenLogoSlotH }
                      }
                    }
                    Box {
                      opacity: fgHasWinner && !awayIsWinner ? 0.82 : 1
                      TeamLogo { id: fgAway.team.id; px: screenAwayLogoPx; plate: !awayIsWinner }
                    }
                  }
                  Text {
                    text: fgAwayRank != null ? "#${fgAwayRank} ${fgAwayName}" : fgAwayName
                    fontSize: 13
                    bold: true
                    color: fgHasWinner && !fgAway.winner ? muted : foreground
                    align: center
                    maxLines: 2
                  }
                  Text {
                    text: fgAwayRec
                    style: small
                    color: muted
                    align: center
                  }
                }

                // Middle Score / Clock
                Column {
                  width: 116
                  align: center
                  gap: 4

                  if fgIsPre {
                    Text { text: "AT"; style: title; color: muted; bold: true; align: center }
                    Text { text: fgKickDate; style: small; color: foreground; align: center; bold: true }
                    Text { text: fgKickTime; style: small; color: secondaryColor; align: center; bold: true }
                  } else {
                    Row {
                      gap: 6
                      align: center
                      Text {
                        text: fgAwayScore
                        fontSize: 28
                        bold: true
                        color: fgHasWinner && !fgAway.winner ? muted : foreground
                      }
                      Text { text: "-"; fontSize: 28; color: muted }
                      Text {
                        text: fgHomeScore
                        fontSize: 28
                        bold: true
                        color: fgHasWinner && !fgHome.winner ? muted : foreground
                      }
                    }
                    Text {
                      text: fgStatusText
                      style: small
                      color: fgIsLive ? accentColor : muted
                      bold: true
                      align: center
                    }
                    if fgDownDist != "" {
                      Row {
                        align: center
                        gap: 4
                        Text { text: "🏈 ${fgDownDist}"; style: small; bold: true; color: accentColor }
                        if fgIsRedZone {
                          Text { text: "RED ZONE"; style: label; bold: true; color: red }
                        }
                      }
                    }
                  }
                }

                // Home Team
                Column {
                  weight: 1
                  align: center
                  gap: 4
                  Box {
                    width: homeIsWinner ? screenAuraW : screenHomeLogoPx + 4
                    height: screenLogoSlotH
                    align: center
                    if homeIsWinner {
                      if uwWonFeatured {
                        WinnerAura { w: screenAuraW; h: screenLogoSlotH; col: secondaryColor }
                      } else {
                        BooAura { w: screenAuraW; h: screenLogoSlotH }
                      }
                    }
                    Box {
                      opacity: fgHasWinner && !homeIsWinner ? 0.82 : 1
                      TeamLogo { id: fgHome.team.id; px: screenHomeLogoPx; plate: !homeIsWinner }
                    }
                  }
                  Text {
                    text: fgHomeRank != null ? "#${fgHomeRank} ${fgHomeName}" : fgHomeName
                    fontSize: 13
                    bold: true
                    color: fgHasWinner && !fgHome.winner ? muted : foreground
                    align: center
                    maxLines: 2
                  }
                  Text {
                    text: fgHomeRec
                    style: small
                    color: muted
                    align: center
                  }
                }
              }

              // Venue and Details
              Box {
                fill: width
                padding: [10, 8]
                radius: 6 * corners
                background: alpha(surface, 0.4)

                Column {
                  gap: 4
                  Row {
                    Text { text: "Stadium:"; style: small; color: muted; width: 60 }
                    Text { text: fgLocation; style: small; weight: 1 }
                  }
                  if fgIsFinal && fgBroadcast != "" {
                    Row {
                      Text { text: "Network:"; style: small; color: muted; width: 60 }
                      Text { text: fgBroadcast; style: small; weight: 1 }
                    }
                  }
                  if featuredGame.weather != null {
                    Row {
                      Text { text: "Weather:"; style: small; color: muted; width: 60 }
                      Text {
                        text: "${featuredGame.weather.displayValue ?? ''}, ${featuredGame.weather.temperature ?? ''}°F"
                        style: small
                        weight: 1
                      }
                    }
                  }
                }
              }

              // ESPN Gamecast button
              Box {
                fill: width
                padding: [12, 9]
                radius: 6 * corners
                background: alpha(secondaryColor, 0.12)
                border: 1
                borderColor: alpha(secondaryColor, 0.6)
                onTap: { haptic(); url("https://www.espn.com/college-football/game/_/gameId/${featuredGame.id}") }
                Text {
                  text: fgIsLive ? "ESPN Live Gamecast ↗" : (fgIsFinal ? "ESPN Box Score & Recap ↗" : "ESPN Matchup Preview ↗")
                  style: small
                  bold: true
                  color: secondaryColor
                  align: center
                }
              }
            }
          }

          // Betting Odds & ESPN Win Probability Card
          if hasOdds || hasWinProb {
            Text {
              text: (hasLiveOdds || hasLiveProb) ? "LIVE ODDS & WIN PROBABILITY" : (fgIsFinal ? "PREGAME ODDS & WIN PROBABILITY" : "BETTING ODDS & WIN PROBABILITY")
              style: label
              color: muted
            }
            Box {
              fill: width
              padding: 12
              radius: 10 * corners
              background: alpha(surface, 0.6)
              border: 1
              borderColor: (hasLiveOdds || hasLiveProb) ? accentColor : border

              Column {
                gap: 10
                fill: width

                if hasWinProb {
                  Column {
                    gap: 6
                    fill: width
                    Row {
                      fill: width
                      align: center
                      gap: 6
                      if hasLiveProb {
                        Text {
                          text: "● LIVE"
                          style: label
                          bold: true
                          color: red
                          padding: [4, 1]
                          radius: 3 * corners
                          background: alpha(red, 0.2)
                        }
                      }
                      Text {
                        text: hasLiveProb ? "ESPN Win Probability" : (fgIsFinal ? "ESPN Pregame Win Probability" : "ESPN Matchup Predictor")
                        style: small
                        bold: true
                        color: hasLiveProb ? red : foreground
                      }
                      Spacer { weight: 1 }
                      Text { text: "ESPN Analytics"; style: label; color: muted }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      TeamLogo { id: fgAway.team.id; px: 16; plate: true }
                      Text {
                        text: "${fgAwayName} ${awayWinPctStr}%"
                        style: small
                        bold: !fgIsHome || awayWinPct >= homeWinPct
                        color: !fgIsHome ? secondaryColor : (awayWinPct >= homeWinPct ? foreground : muted)
                      }
                      Spacer { weight: 1 }
                      Text {
                        text: "${homeWinPctStr}% ${fgHomeName}"
                        style: small
                        bold: fgIsHome || homeWinPct >= awayWinPct
                        color: fgIsHome ? secondaryColor : (homeWinPct >= awayWinPct ? foreground : muted)
                      }
                      TeamLogo { id: fgHome.team.id; px: 16; plate: true }
                    }

                    Row {
                      fill: width
                      height: 8
                      radius: 4 * corners
                      clip: true
                      gap: 2
                      Box {
                        weight: clamp(awayWinPct, 2, 98)
                        height: 8
                        background: !fgIsHome ? secondaryColor : alpha(foreground, 0.32)
                      }
                      Box {
                        weight: clamp(homeWinPct, 2, 98)
                        height: 8
                        background: fgIsHome ? secondaryColor : alpha(foreground, 0.32)
                      }
                    }
                  }
                }

                if hasWinProb && hasOdds {
                  Box {
                    fill: width
                    height: 1
                    background: alpha(border, 0.6)
                  }
                }

                if hasOdds {
                  Column {
                    gap: 4
                    fill: width
                    Row {
                      fill: width
                      align: center
                      gap: 6
                      if hasLiveOdds {
                        Text {
                          text: "● LIVE"
                          style: label
                          bold: true
                          color: red
                          padding: [4, 1]
                          radius: 3 * corners
                          background: alpha(red, 0.2)
                        }
                      }
                      Text {
                        text: hasLiveOdds ? "Live Betting Lines" : (fgIsLive ? "Closing Lines (Live Paused)" : (fgIsFinal ? "Closing Pregame Lines" : "Game Lines"))
                        style: small
                        bold: true
                        color: hasLiveOdds ? red : foreground
                      }
                      Spacer { weight: 1 }
                      Text {
                        text: oddsProvider
                        style: label
                        bold: true
                        color: secondaryColor
                        padding: [5, 2]
                        radius: 4 * corners
                        background: alpha(secondaryColor, 0.16)
                      }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      padding: [6, 2]
                      Text { text: "TEAM"; style: label; color: muted; weight: 1 }
                      Text { text: "SPREAD"; style: label; color: muted; width: 78; align: end }
                      Text { text: "ML"; style: label; color: muted; width: 44; align: end }
                      Text { text: "TOTAL"; style: label; color: muted; width: 88; align: end }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      padding: [6, 5]
                      radius: 4 * corners
                      background: !fgIsHome ? highlightBg : rgb(0, 0, 0, 0)
                      TeamLogo { id: fgAway.team.id; px: 18; plate: true }
                      Text {
                        text: fgAwayName
                        style: small
                        bold: !fgIsHome
                        color: !fgIsHome ? secondaryColor : foreground
                        weight: 1
                        maxLines: 1
                      }
                      Text {
                        text: oddsAwaySpread != "" ? (oddsAwaySpreadJuice != "" ? "${oddsAwaySpread} (${oddsAwaySpreadJuice})" : oddsAwaySpread) : "–"
                        fontSize: 11
                        bold: true
                        width: 78
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsAwayMl != "" ? oddsAwayMl : "–"
                        fontSize: 11
                        bold: true
                        color: !fgIsHome ? secondaryColor : foreground
                        width: 44
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsOuStr != "" ? (oddsOverJuice != "" ? "O${oddsOuStr} (${oddsOverJuice})" : "O${oddsOuStr}") : "–"
                        fontSize: 11
                        color: muted
                        width: 88
                        align: end
                        maxLines: 1
                      }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      padding: [6, 5]
                      radius: 4 * corners
                      background: fgIsHome ? highlightBg : rgb(0, 0, 0, 0)
                      TeamLogo { id: fgHome.team.id; px: 18; plate: true }
                      Text {
                        text: fgHomeName
                        style: small
                        bold: fgIsHome
                        color: fgIsHome ? secondaryColor : foreground
                        weight: 1
                        maxLines: 1
                      }
                      Text {
                        text: oddsHomeSpread != "" ? (oddsHomeSpreadJuice != "" ? "${oddsHomeSpread} (${oddsHomeSpreadJuice})" : oddsHomeSpread) : "–"
                        fontSize: 11
                        bold: true
                        width: 78
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsHomeMl != "" ? oddsHomeMl : "–"
                        fontSize: 11
                        bold: true
                        color: fgIsHome ? secondaryColor : foreground
                        width: 44
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsOuStr != "" ? (oddsUnderJuice != "" ? "U${oddsOuStr} (${oddsUnderJuice})" : "U${oddsOuStr}") : "–"
                        fontSize: 11
                        color: muted
                        width: 88
                        align: end
                        maxLines: 1
                      }
                    }

                    if oddsRefLabel != "" {
                      Box {
                        fill: width
                        padding: [8, 4]
                        radius: 4 * corners
                        background: alpha(surface, 0.4)
                        Text { text: oddsRefLabel; style: label; color: muted }
                      }
                    }
                  }
                }
              }
            }
          }

          // Big Ten Conference Race Table
          Text { text: "BIG TEN CONFERENCE STANDINGS"; style: label; color: muted }
          Box {
            fill: width
            padding: 10
            radius: 8 * corners
            background: alpha(surface, 0.6)
            border: 1
            borderColor: border

            Column {
              gap: 4
              fill: width

              Row {
                fill: width
                align: center
                gap: 6
                padding: [6, 2]
                Text { text: "#"; style: label; color: muted; width: 18 }
                Text { text: "TEAM"; style: label; color: muted; weight: 1 }
                Text { text: "OVR"; style: label; color: muted; width: 42; align: end }
                Text { text: "CONF"; style: label; color: muted; width: 42; align: end }
                Text { text: "STRK"; style: label; color: muted; width: 38; align: end }
                Text { text: "DIFF"; style: label; color: muted; width: 44; align: end }
              }

              for entry, i in b1gEntries key entry.team.id {
                let isUw = (entry.team.id ?? '') == '264'
                let rec = (entry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? '–'
                let confRec = (entry.stats.find(s => s.name == 'vs. Conf.') ?? {}).displayValue ?? '–'
                let strk = (entry.stats.find(s => s.name == 'streak') ?? {}).displayValue ?? '–'
                let diff = (entry.stats.find(s => s.name == 'pointDifferential') ?? {}).displayValue ?? '–'

                Row {
                  fill: width
                  align: center
                  gap: 6
                  padding: [6, 4]
                  radius: 4 * corners
                  background: isUw ? highlightBg : rgb(0, 0, 0, 0)

                  Text { text: "${i + 1}"; style: small; color: isUw ? secondaryColor : muted; bold: isUw; width: 18 }
                  TeamLogo { id: entry.team.id; px: 20; plate: true }
                  Text {
                    text: entry.team.shortDisplayName ?? entry.team.displayName
                    style: small
                    bold: isUw
                    color: isUw ? accentColor : foreground
                    weight: 1
                    maxLines: 1
                  }
                  Text {
                    text: rec
                    style: small
                    bold: true
                    color: isUw ? accentColor : foreground
                    width: 42
                    align: end
                  }
                  Text {
                    text: confRec
                    style: small
                    color: muted
                    width: 42
                    align: end
                  }
                  Text {
                    text: strk
                    style: small
                    color: startsWith(strk, 'W') ? winColor : (startsWith(strk, 'L') ? red : muted)
                    width: 38
                    align: end
                  }
                  Text {
                    text: diff
                    style: label
                    color: startsWith(diff, '+') ? winColor : (startsWith(diff, '-') ? red : muted)
                    width: 44
                    align: end
                  }
                }
              }
            }
          }

          // Previous Result
          if prevGame != null && prevGame.id != featuredGame.id {
            Text { text: "PREVIOUS RESULT"; style: label; color: muted }
            Box {
              fill: width
              padding: 10
              radius: 8 * corners
              background: alpha(surface, 0.6)
              border: 1
              borderColor: border
              onTap: { haptic(); url("https://www.espn.com/college-football/game/_/gameId/${prevGame.id}") }

              Row {
                fill: width
                align: center
                gap: 8
                Text {
                  text: pgWon ? "WIN" : "LOSS"
                  style: small
                  bold: true
                  color: pgWon ? winColor : red
                  padding: [6, 3]
                  radius: 4 * corners
                  background: pgWon ? alpha(winColor, 0.2) : alpha(red, 0.2)
                }
                TeamLogo { id: pgOppId; px: 28; plate: true }
                Column {
                  gap: 1
                  weight: 1
                  Text {
                    text: "Week ${prevGame.week.number}: ${pgResult}"
                    style: body
                    bold: true
                  }
                  Text { text: "Final Score • Tap for ESPN Recap ↗"; style: small; color: muted }
                }
              }
            }
          }
        }
      }

      // Screen Tab 2: All News
      if screenTab == "stats" {
        Column {
          gap: 10
          fill: width

          Text { text: "PLAYER LEADERS"; style: label; color: muted }
          Box {
            fill: width
            padding: 12
            radius: 10 * corners
            background: alpha(surface, 0.6)
            border: 1
            borderColor: border
            Column {
              gap: 8
              fill: width
              if len(teamLeaders) == 0 {
                Text { text: "Player leaders not available for this week"; style: small; color: muted }
              } else {
                for pl in teamLeaders {
                  Box {
                    fill: width
                    padding: [8, 8]
                    radius: 8 * corners
                    background: alpha(surface, 0.5)
                    border: 1
                    borderColor: border
                    onTap: { if pl.url != "" { haptic(); url(pl.url) } }
                    Row {
                      fill: width
                      align: center
                      gap: 10
                      if pl.headshot != "" {
                        Box {
                          size: 38
                          radius: 19
                          clip: true
                          background: alpha(foreground, 0.12)
                          Image { src: pl.headshot; size: 38; fit: cover }
                        }
                      }
                      Column {
                        weight: 1
                        gap: 2
                        Row {
                          fill: width
                          align: center
                          gap: 6
                          Text { text: pl.name; style: body; bold: true; color: foreground; maxLines: 1 }
                          if pl.pos != "" {
                            Text { text: pl.pos; style: label; color: muted }
                          }
                          Spacer { weight: 1 }
                          Text {
                            text: upper(pl.cat)
                            style: label
                            bold: true
                            color: accentColor
                            padding: [5, 2]
                            radius: 4 * corners
                            background: highlightBg
                          }
                        }
                        Text { text: pl.line; style: small; color: secondaryColor; maxLines: 1 }
                      }
                    }
                  }
                }
              }
            }
          }

          Row {
            fill: width
            align: center
            Text { text: "TEAM SEASON STATS"; style: label; color: muted }
            Spacer { weight: 1 }
            if statToDiff != "–" {
              Text { text: "TO DIFF ${statToDiff}"; style: label; bold: true; color: startsWith(statToDiff, "-") ? red : winColor }
            }
          }
          Box {
            fill: width
            padding: 12
            radius: 10 * corners
            background: alpha(surface, 0.6)
            border: 1
            borderColor: border
            Column {
              gap: 6
              fill: width
              Row {
                fill: width
                padding: [4, 2]
                Text { text: "STAT"; style: label; color: muted; weight: 1 }
                Text { text: "WASH"; style: label; bold: true; color: accentColor; width: 64; align: end }
                Text { text: "OPP"; style: label; color: muted; width: 64; align: end }
              }
              Box { fill: width; height: 1; background: border }
              for r in teamStatRows {
                Row {
                  fill: width
                  align: center
                  padding: [4, 4]
                  Text { text: r.label; style: small; color: foreground; weight: 1 }
                  Text { text: r.team; style: small; bold: true; color: accentColor; width: 64; align: end }
                  Text { text: r.opp; style: small; color: muted; width: 64; align: end }
                }
              }
            }
          }
        }
      }

      if screenTab == "news" {
        Column {
          gap: 8
          fill: width

          Text { text: "LATEST WASHINGTON HUSKIES NEWS"; style: label; color: muted }

          Row {
            fill: width
            gap: 6
            for f in newsSources key f.id {
              let active = newsFilter == f.id
              Box {
                weight: 1
                padding: [4, 6]
                radius: 8 * corners
                background: active ? tabActiveBg : alpha(surface, 0.4)
                border: 1
                borderColor: active ? accentColor : border
                onTap: { haptic(); newsFilter = f.id }
                Text {
                  text: f.label
                  style: label
                  bold: active
                  color: active ? accentColor : muted
                  align: center
                  maxLines: 1
                }
              }
            }
          }

          if len(articles) == 0 {
            Text { text: "Fetching Huskies football news…"; style: small; color: muted }
          } else {
            for item in articles.take(20) key item.id {
              Box {
                fill: width
                padding: 10
                radius: 8 * corners
                background: alpha(surface, 0.6)
                border: 1
                borderColor: border
                onTap: { haptic(); url(item.link) }

                Column {
                  gap: 4
                  fill: width

                  Row {
                    gap: 6
                    align: center
                    if item.ts > 0 {
                      Text { text: fmtAgo(item.ts, now); style: label; color: accentColor; bold: true }
                      Text { text: "•"; style: label; color: muted }
                    }
                    Text { text: item.src; style: label; color: muted }
                  }

                  Text {
                    text: item.title
                    style: body
                    bold: true
                  }

                  if (item.desc ?? "") != "" {
                    Text {
                      text: item.desc
                      style: small
                      color: muted
                      maxLines: 3
                    }
                  }

                  Row {
                    align: center
                    gap: 4
                    Text { text: "Read story ↗"; style: small; color: secondaryColor; bold: true }
                  }
                }
              }
            }
          }
        }
      }

      // Screen Tab 3: Full Schedule
      if screenTab == "schedule" {
        Column {
          gap: 6
          fill: width

          Text { text: "${schedule.season.year ?? 2026} WASHINGTON HUSKIES SCHEDULE"; style: label; color: muted }

          for g in schedEvents key g.id {
            let gc = g.competitions[0]
            let gcomps = gc.competitors ?? []
            let gUw = gcomps.find(t => (t.team.id ?? '') == '264')
            let gOpp = gcomps.find(t => (t.team.id ?? '') != '264')
            let gOppId = gOpp.team.id ?? ''
            let gOppAbbr = gOpp.team.abbreviation ?? ''
            let gOppRankNum = gOpp.curatedRank.current ?? 99
            let gOppFullName = gOpp.team.displayName ?? gOppAbbr
            let gOppFullLabel = gOppRankNum <= 25 ? "#${gOppRankNum} ${gOppFullName}" : gOppFullName
            let gState = gc.status.type.state ?? 'pre'
            let gWon = gUw.winner == true
            let isDone = gState == 'post'
            let isCurrent = g.id == featuredGame.id
            let scUw = gUw.score.displayValue ?? gUw.score ?? '–'
            let scOpp = gOpp.score.displayValue ?? gOpp.score ?? '–'
            let dt = parseTime(g.date)
            let gTimeValid = gc.timeValid != false

            Box {
              fill: width
              padding: [8, 6]
              radius: 6 * corners
              background: isCurrent ? highlightBg : (gState == 'in' ? highlightBg : alpha(surface, 0.6))
              border: 1
              borderColor: (isCurrent || gState == 'in') ? accentColor : border

              Row {
                fill: width
                align: center
                gap: 8

                Text { text: "W${g.week.number}"; style: small; color: isCurrent ? accentColor : muted; width: 32; bold: isCurrent }
                TeamLogo { id: gOppId; px: 22 }
                Column {
                  gap: 1
                  weight: 1
                  Text {
                    text: "${gOpp.homeAway == 'home' ? '@' : 'vs'} ${gOppFullLabel}"
                    style: small
                    bold: true
                    color: (isCurrent || gState == 'in') ? accentColor : foreground
                  }
                  if dt != null {
                    Text {
                      text: gTimeValid ? fmtTime(dt, "EEE, MMM d • h:mm a") : "${fmtTime(dt, "EEE, MMM d", "America/New_York")} • TBD"
                      style: label
                      color: muted
                    }
                  }
                }
                Spacer { weight: 1 }
                if isDone {
                  Text {
                    text: "${gWon ? 'W' : 'L'} ${scUw}-${scOpp}"
                    style: small
                    bold: true
                    color: gWon ? winColor : red
                    padding: [6, 2]
                    radius: 4
                    background: gWon ? alpha(winColor, 0.2) : alpha(red, 0.2)
                  }
                } else if gState == 'in' {
                  Text {
                    text: "LIVE"
                    style: small
                    bold: true
                    color: accentColor
                    padding: [6, 2]
                    radius: 4
                    background: highlightBg
                  }
                } else {
                  Text {
                    text: gc.status.type.shortDetail ?? 'Scheduled'
                    style: small
                    color: isCurrent ? secondaryColor : muted
                    bold: isCurrent
                  }
                }
              }
            }
          }
        }
      }

      // Actions
      Row {
        gap: 8
        fill: width
        Button {
          text: "Official GoHuskies.com ↗"
          weight: 1
          onTap: { haptic(); url("https://gohuskies.com/sports/football") }
        }
        Button {
          text: "Close"
          width: 80
          onTap: { haptic(); close() }
        }
      }
    }
  }
}
