widget "whatsapp chats" {
  size: 6x4
  minSize: 2x1
  requires { pacman: [] }

  meta { owl: 7; description: "Unread WhatsApp chats from the phone's notifications: who wrote, their latest message and when. Tap a chat to open it"; version: "1.0"; license: "MIT"; category: "productivity" }

  // WhatsApp posts one notification per unread chat, plus a summary titled "WhatsApp"
  // ("5 messages from 2 chats") that's left out here. Business is com.whatsapp.w4b.
  source n = android.notifications
  let chats = (n.items ?? [])
    .filter(i => (i.package == "com.whatsapp" || i.package == "com.whatsapp.w4b") && i.title != "WhatsApp" && i.title != "WhatsApp Business" && i.title != "")
  let total = count(chats)

  onTap: androidApp("com.whatsapp")

  if !n.available {
    Column {
      justify: center
      fill: true
      Text { text: "whatsapp chats"; style: muted }
      Text { text: "needs notification access"; style: small; maxLines: 2 }
      // Without access, notification(...) opens the setting that grants it.
      Button { text: "allow"; onTap: notification("open", "") }
    }
  } else if rows != null && rows <= 1 {
    Row {
      align: center
      fill: true
      Image { src: "app:com.whatsapp"; size: 22 }
      Text { text: total == 0 ? "no unread" : total == 1 ? "1 unread chat" : "${total} unread chats"; weight: 1; maxLines: 1; color: total > 0 ? foreground : muted }
    }
  } else {
    Column {
      gap: 6
      fill: true
      Row {
        align: center
        Image { src: "app:com.whatsapp"; size: 18 }
        Text { text: "whatsapp chats"; style: muted; weight: 1 }
        Text { text: total == 0 ? "" : "${total} unread"; style: muted; width: 90; align: end; color: total > 0 ? green : muted }
      }
      if total == 0 {
        Column {
          justify: center
          align: center
          weight: 1
          fill: width
          Text { text: "no unread messages"; style: small; color: muted; align: center }
        }
      } else {
        Column {
          gap: 8
          weight: 1
          scroll: true
          for c in chats key c.key {
            Row {
              gap: 8
              align: top
              onTap: notification("open", c.key)
              Spacer { width: 3; height: 34; background: green; radius: 2 * corners }
              Column {
                gap: 0
                weight: 1
                Row {
                  gap: 6
                  Text { text: c.title; bold: true; maxLines: 1; weight: 1 }
                  if c.profile != null {
                    Text { text: c.profile; style: label; color: muted; width: 40; align: end }
                  }
                  Text { text: fmtTime(c.time, "HH:mm"); style: label; color: muted; width: 44; align: end }
                }
                if c.text != "" {
                  Text { text: c.text; style: small; color: muted; maxLines: cols != null && cols >= 4 ? 2 : 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
