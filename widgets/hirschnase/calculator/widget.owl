widget "calculator" {
  meta {
    owl: 7
    description: "A four-function calculator with percent and sign. Tap the number to copy it."
    version: "1.1"
    license: "MIT"
    category: "productivity"
  }
  requires { pacman: [] }
  size: 4x6
  minSize: 4x5
  padding: 12

  // entry is what the user is typing. The display shows it while typing, and result otherwise.
  state entry = "0" persist
  state typing = true persist
  state result = 0 persist
  // Left side of a pending operation. hasAcc is false after equals, so a new
  // digit starts over, while acc itself stays put for the expression line.
  state acc = 0 persist
  state hasAcc = false persist
  state op = "" persist
  // Remembered right-hand side, so a second equals repeats the last operation.
  state last = 0 persist
  state lastOp = "" persist
  state solved = false persist
  state error = false persist

  // Scratch for the key handler. A handler can't declare locals; later lines
  // see earlier assignments, so these are set before they're read.
  state key = ""
  state seq = 0
  state t = 0
  state s = ""
  state p1 = false
  state p2 = false

  let places = 8
  // "12." is still being typed; the trailing dot must not reach num().
  let bare = endsWith(entry, ".") ? sub(entry, 0, len(entry) - 1) : entry
  let typed = bare == "" || bare == "-" ? 0 : num(bare)
  let view = round(result, places)
  let shown = error ? "error" : typing ? entry : view == 0 ? "0" : "${view}"
  let opMark = op == "+" ? "+" : op == "-" ? "−" : op == "*" ? "×" : op == "/" ? "÷" : ""
  let lastMark = lastOp == "+" ? "+" : lastOp == "-" ? "−" : lastOp == "*" ? "×" : lastOp == "/" ? "÷" : ""
  let expr = error ? "division by zero" : solved && lastOp != "" ? "${round(acc, places)} ${lastMark} ${round(last, places)} =" : hasAcc && op != "" ? "${round(acc, places)} ${opMark}" : ""
  // C wipes the entry; once it's already clear (or a result is showing) it becomes AC.
  let entryClear = error || !typing || entry == "0" || entry == "-0"
  let digit = contains("0123456789", key)
  let isOp = key == "+" || key == "-" || key == "*" || key == "/"
  let size = len(shown) > 16 ? 20 : len(shown) > 12 ? 26 : len(shown) > 8 ? 32 : 40
  // Button labels are fixed at 13, so each key draws its own. "AC" is the wide
  // one (about 1.2 em); this keeps it inside the key as the tile is resized.
  // A wide tile (the landscape home screen) puts the display left of the keypad,
  // so the keys get the whole height instead of sharing it with the display.
  let wide = tileWidth != null && tileHeight != null && tileWidth > tileHeight * 1.3
  let padW = wide ? clamp((tileWidth - 34) * 0.6, 200, 420) : 0
  let dispW = wide ? tileWidth - 34 - padW : 0
  let keyW = wide ? (padW - 18) / 4 : ((tileWidth ?? 360) - 42) / 4
  let keyH = wide ? (tileHeight - 48) / 5 : ((tileHeight ?? 540) - 114) / 5
  let labelSize = round(clamp(min(keyW, keyH) * 0.58, wide ? 12 : 22, 64))
  // Mono digits are about 0.62 em wide; shrink the number to fit the side column.
  let wideSize = round(clamp(dispW / (max(len(shown), 1) * 0.62), 14, size))

  // One handler for every key. key is set by the button, then seq bumps so
  // this runs. Order matters: each section reads flags the earlier ones
  // haven't cleared yet, and a section only writes when key is its own.
  on seq {
    entry = digit ? (error || solved || !typing || entry == "0" || entry == "-0" ? key : len(replace(replace(entry, "-", ""), ".", "")) >= 12 ? entry : entry + key) : entry
    hasAcc = digit && (error || solved) ? false : hasAcc
    op = digit && (error || solved) ? "" : op
    lastOp = digit && (error || solved) ? "" : lastOp
    typing = digit ? true : typing
    solved = digit ? false : solved
    error = digit ? false : error

    entry = key == "." ? (error || solved || !typing ? "0." : contains(entry, ".") ? entry : entry + ".") : entry
    hasAcc = key == "." && (error || solved) ? false : hasAcc
    op = key == "." && (error || solved) ? "" : op
    lastOp = key == "." && (error || solved) ? "" : lastOp
    typing = key == "." ? true : typing
    solved = key == "." ? false : solved
    error = key == "." ? false : error

    entry = key == "b" ? (error || solved || !typing || len(entry) <= 1 || sub(entry, 0, len(entry) - 1) == "-" ? "0" : sub(entry, 0, len(entry) - 1)) : entry
    hasAcc = key == "b" && (error || solved) ? false : hasAcc
    op = key == "b" && (error || solved) ? "" : op
    lastOp = key == "b" && (error || solved) ? "" : lastOp
    typing = key == "b" ? true : typing
    solved = key == "b" ? false : solved
    error = key == "b" ? false : error

    // Snapshot before entry changes, or a plain C would look like AC.
    p1 = key == "c" && entryClear
    entry = key == "c" ? "0" : entry
    typing = key == "c" ? true : typing
    result = p1 ? 0 : result
    acc = p1 ? 0 : acc
    hasAcc = p1 ? false : hasAcc
    op = p1 ? "" : op
    last = p1 ? 0 : last
    lastOp = p1 ? "" : lastOp
    solved = p1 ? false : solved
    error = key == "c" ? false : error

    entry = key == "s" ? (error || !typing ? entry : entry == "0" || entry == "0." ? entry : startsWith(entry, "-") ? sub(entry, 1, len(entry)) : "-" + entry) : entry
    result = key == "s" ? (error ? 0 : typing ? result : result == 0 ? 0 : -result) : result
    acc = key == "s" && !error && !typing && hasAcc && !solved ? -acc : acc
    hasAcc = key == "s" && error ? false : hasAcc
    op = key == "s" && error ? "" : op
    lastOp = key == "s" && error ? "" : lastOp
    typing = key == "s" && error ? true : typing
    solved = key == "s" && error ? false : solved
    error = key == "s" ? false : error

    // 200 + 10% is 200 + 20. For × and ÷, percent just divides the entry by 100.
    t = key == "p" ? (error ? 0 : hasAcc && typing && !solved && (op == "+" || op == "-") ? acc * typed / 100 : (typing ? typed : result) / 100) : t
    result = key == "p" ? t : result
    hasAcc = key == "p" && (error || solved) ? false : hasAcc
    op = key == "p" && (error || solved) ? "" : op
    lastOp = key == "p" && (error || solved) ? "" : lastOp
    acc = key == "p" && (error || solved) ? 0 : acc
    typing = key == "p" ? false : typing
    solved = key == "p" ? false : solved
    error = key == "p" ? false : error
    entry = key == "p" ? "0" : entry

    // Chain when there's a pending op and a new entry; otherwise the key
    // just stores this number and replaces the operator (5 + − becomes 5 −).
    t = isOp ? (typing ? typed : result) : t
    p1 = isOp && !error && hasAcc && typing && op != ""
    p2 = p1 && op == "/" && t == 0
    acc = isOp ? (error || p2 ? (error ? 0 : acc) : p1 ? (op == "+" ? acc + t : op == "-" ? acc - t : op == "*" ? acc * t : acc / t) : t) : acc
    last = p1 && !p2 ? t : last
    lastOp = p1 && !p2 ? op : lastOp
    error = isOp ? p2 : error
    result = isOp ? (error ? 0 : acc) : result
    op = isOp ? (p2 ? "" : key) : op
    hasAcc = isOp ? !p2 : hasAcc
    typing = isOp ? false : typing
    solved = isOp ? false : solved
    entry = isOp ? "0" : entry

    // "5 + =" doubles. A second "=" repeats the last operation.
    s = key == "=" ? (op != "" ? op : solved ? lastOp : "") : s
    t = key == "=" ? (op == "" && solved ? last : typing ? typed : result) : t
    p2 = key == "=" && s == "/" && t == 0
    acc = key == "=" && op == "" && solved && !p2 ? result : acc
    result = key == "=" ? (p2 ? result : s == "" ? t : s == "+" ? acc + t : s == "-" ? acc - t : s == "*" ? acc * t : acc / t) : result
    last = key == "=" && s != "" && !p2 ? t : last
    lastOp = key == "=" && s != "" && !p2 ? s : lastOp
    error = key == "=" ? p2 : error
    solved = key == "=" ? !p2 : solved
    hasAcc = key == "=" ? false : hasAcc
    op = key == "=" ? "" : op
    typing = key == "=" ? false : typing
    entry = key == "=" ? "0" : entry
  }

  // A key matches Button's 1 dp outline, with a label large enough to read.
  component Key(label, tint, sym, plate = null) {
    Box {
      weight: 1
      fill: true
      border: 1
      borderColor: tint
      background: plate
      radius: 8 * corners
      align: center
      onTap: { haptic(); key = sym; seq = seq + 1 }
      Text {
        text: label
        fontSize: labelSize
        color: tint
        align: center
        maxLines: 1
        font: mono
      }
    }
  }

  component Digit(d) {
    Key { label: d; tint: foreground; sym: d }
  }

  component Oper(label, sym) {
    Key {
      label: label
      sym: sym
      tint: op == sym && hasAcc && !typing && !error ? background : accent
      plate: op == sym && hasAcc && !typing && !error ? accent : null
    }
  }

  component Display() {
    Column {
      gap: 0
      justify: center
      fill: wide
      padding: [2, 0, 2, 2]
      onTap: { haptic(); copy(shown) }
      Text {
        text: expr
        height: 16
        style: small
        color: error ? red : muted
        align: end
        maxLines: 1
        font: mono
      }
      Text {
        text: shown
        color: error ? red : foreground
        align: end
        maxLines: 1
        font: mono
        fontSize: wide ? wideSize : size
        bold: true
      }
    }
  }

  component Keypad() {
    Column {
      gap: 6
      fill: true
      Row {
        gap: 6
        weight: 1
        Key { label: entryClear ? "AC" : "C"; tint: muted; sym: "c" }
        Key { label: "⌫"; tint: muted; sym: "b" }
        Key { label: "%"; tint: muted; sym: "p" }
        Oper { label: "÷"; sym: "/" }
      }
      Row {
        gap: 6
        weight: 1
        Digit { d: "7" }
        Digit { d: "8" }
        Digit { d: "9" }
        Oper { label: "×"; sym: "*" }
      }
      Row {
        gap: 6
        weight: 1
        Digit { d: "4" }
        Digit { d: "5" }
        Digit { d: "6" }
        Oper { label: "−"; sym: "-" }
      }
      Row {
        gap: 6
        weight: 1
        Digit { d: "1" }
        Digit { d: "2" }
        Digit { d: "3" }
        Oper { label: "+"; sym: "+" }
      }
      Row {
        gap: 6
        weight: 1
        Key { label: "±"; tint: muted; sym: "s" }
        Digit { d: "0" }
        Key { label: "."; tint: foreground; sym: "." }
        Key { label: "="; tint: background; sym: "="; plate: accent }
      }
    }
  }

  if wide {
    Row {
      gap: 10
      fill: true
      Display { weight: 1; fill: height }
      Keypad { width: padW; fill: height }
    }
  } else {
    Column {
      gap: 8
      fill: true
      Display {}
      Keypad { weight: 1 }
    }
  }
}
