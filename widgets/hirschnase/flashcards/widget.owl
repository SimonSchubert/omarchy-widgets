widget "flashcards" {
  meta {
    owl: 7
    description: "Create, save, import, and learn flashcards. Marks change how often each card appears."
    version: "1.2"
    license: "MIT"
    category: "productivity"
  }
  page: 3
  order: 1
  size: 3x4
  minSize: 3x3
  padding: 12
  requires { pacman: ["jq"] }

  // Deck lives in the plugin data dir and is reloaded whenever the file changes.
  // bias: more (×3), normal (×2), less (×1), never (left out of learn).
  source raw = file("~/.local/share/omalauncher/flashcards/flashcards.json")
  source now = clock every 5m
  let disk = parseJson(raw)

  state view = "list"
  state editId = 0
  state draftFront = ""
  state draftBack = ""
  state draftBias = "normal"
  state formError = ""
  state confirm = false
  state confirmAll = false
  state query = ""
  state page = 0
  state importNote = ""
  state draftName = ""
  state deleteDeckId = ""

  state learnId = 0
  state revealed = false
  state draw = 0
  state seed = 1
  state seeded = false
  state ensured = false
  // Latest mark, so the next draw sees it before jq finishes writing the file.
  state biasId = 0
  state biasVal = ""
  // Scratch for the large-deck picker. Not shown.
  state hold = 0
  state ix = 0

  // decks/<uuid>.json: display name is a field in the file. Built-in decks are present tense only.
  source catalogRaw = file("~/.local/share/omalauncher/flashcards/decks/catalog.json")

  let prep = "set -eu; d=\"$HOME/.local/share/omalauncher/flashcards\"; mkdir -p \"$d/decks\"; f=\"$d/flashcards.json\"; [ -f \"$f\" ] || printf '%s\n' '{\"nextId\":1,\"cards\":[]}' > \"$f\"; [ -f \"$d/decks/catalog.json\" ] || printf '%s\n' '{\"decks\":[]}' > \"$d/decks/catalog.json\"; "
  let jqImport = "'($set[0].cards // []) as $in | .cards = (if (.cards | type) == \"array\" then .cards else [] end) | .nextId = (if (.nextId | type) == \"number\" then .nextId else 1 end) | .name = (if (.name | type) == \"string\" and .name != \"\" then .name else $deckName end) | reduce $in[] as $c (.; if (($c.front | type) != \"string\") or (($c.back | type) != \"string\") or ($c.front == \"\") or ($c.back == \"\") then . elif any(.cards[]?; .front == $c.front and .back == $c.back) then . else .cards += [{id: .nextId, front: $c.front, back: $c.back, bias: (if ($c.bias == \"more\" or $c.bias == \"less\" or $c.bias == \"never\" or $c.bias == \"normal\") then $c.bias else \"normal\" end)}] | .nextId += 1 end)'"
  let catalogCmd = "ct=\"$d/decks/catalog.json\"; tmpc=$(mktemp); find \"$d/decks\" -maxdepth 1 -type f -name '*.json' ! -name 'catalog.json' | sort | while IFS= read -r df; do jq -c '{id: (.id // \"\"), name: (.name // \"Untitled\"), count: ((.cards // []) | length)}' \"$df\"; done | jq -s '{decks: sort_by(.name)}' > \"$tmpc\" && mv \"$tmpc\" \"$ct\" || { rm -f \"$tmpc\"; exit 1; }"
  let blank = trim(draftFront) == "" || trim(draftBack) == ""

  let cards = disk.cards ?? []
  let nCards = len(cards)
  let n = nCards
  // count walks the whole deck. map and sortBy stop at 1000 items, so a big deck is paged with drop.
  let nNever = count(cards, c => (c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")) == "never")
  let nLearn = n - nNever
  let q = lower(trim(query))
  let base = q != "" ? cards.filter(c => contains(lower(c.front ?? ""), q) || contains(lower(c.back ?? ""), q)) : (nCards > 1000 ? cards : cards.sortBy(c => lower(c.front ?? "")))
  let pageSize = 20
  let pageCount = max(1, ceil(len(base) / pageSize))
  let pageSafe = clamp(page, 0, pageCount - 1)
  let slice = base.drop(pageSafe * pageSize).take(pageSize)
  let setList = parseJson(catalogRaw).decks ?? []
  // Weighted pools for decks up to 1000. Larger decks are sampled in on draw.
  let active = cards.filter(c => (c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")) != "never")
  let moreC = active.filter(c => c.id != learnId && (c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")) == "more")
  let lessC = active.filter(c => c.id != learnId && (c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")) == "less")
  let normC = active.filter(c => c.id != learnId && (c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")) == "normal")
  let wM = len(moreC) * 3
  let wN = len(normC) * 2
  let wT = wM + wN + len(lessC)
  let cardRaw = cards.find(c => c.id == learnId)
  let cardBias = cardRaw == null ? "normal" : (cardRaw.id == biasId && biasVal != "" ? biasVal : (cardRaw.bias ?? "normal"))
  let card = cardRaw == null ? null : { id: cardRaw.id, front: cardRaw.front ?? "", back: cardRaw.back ?? "", bias: cardBias }
  let biasWord = cardBias == "more" ? "learn more" : cardBias == "less" ? "learn less" : cardBias == "never" ? "don't learn" : "normal"

  when !ensured && (raw == "" || raw == null) { ensured = true; run(prep + "true") }
  when !seeded && now != null { seed = draw == 0 ? int(now) % 4294967295 + 1 : seed; seeded = true }
  when biasId != 0 && biasVal != "" && (cards.find(c => c.id == biasId).bias ?? "") == biasVal { biasVal = "" }
  when page != pageSafe { page = pageSafe }

  // draw bumps after a mark or "next". Pools already exclude the card on screen.
  // Decks over 1000 cards can't be listed in full, so those are sampled by index.
  on draw {
    hold = learnId
    seed = (seed * 1664525 + 1013904223) % 4294967296
    revealed = false
    ix = abs(int(seed)) % max(nCards, 1)
    learnId = nLearn == 0 ? 0 : (nCards <= 1000 ? (wT == 0 ? (len(active) == 0 ? 0 : active[0].id) : (abs(int(seed)) % max(wT, 1) < wM ? moreC[int(floor((abs(int(seed)) % max(wT, 1)) / 3))].id : (abs(int(seed)) % max(wT, 1) < wM + wN ? normC[int(floor(((abs(int(seed)) % max(wT, 1)) - wM) / 2))].id : lessC[int((abs(int(seed)) % max(wT, 1)) - wM - wN)].id))) : (((cards[ix].id == hold && nLearn > 1) || ((cards[ix].id == biasId && biasVal != "" ? biasVal : (cards[ix].bias ?? "normal")) == "never")) ? 0 : cards[ix].id))
    seed = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? seed : ((seed * 1664525 + 1013904223) % 4294967296)
    ix = abs(int(seed)) % max(nCards, 1)
    learnId = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? learnId : (((cards[ix].id == hold && nLearn > 1) || ((cards[ix].id == biasId && biasVal != "" ? biasVal : (cards[ix].bias ?? "normal")) == "never")) ? 0 : cards[ix].id)
    seed = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? seed : ((seed * 1664525 + 1013904223) % 4294967296)
    ix = abs(int(seed)) % max(nCards, 1)
    learnId = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? learnId : (((cards[ix].id == hold && nLearn > 1) || ((cards[ix].id == biasId && biasVal != "" ? biasVal : (cards[ix].bias ?? "normal")) == "never")) ? 0 : cards[ix].id)
    seed = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? seed : ((seed * 1664525 + 1013904223) % 4294967296)
    ix = abs(int(seed)) % max(nCards, 1)
    learnId = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? learnId : (((cards[ix].id == hold && nLearn > 1) || ((cards[ix].id == biasId && biasVal != "" ? biasVal : (cards[ix].bias ?? "normal")) == "never")) ? 0 : cards[ix].id)
    seed = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? seed : ((seed * 1664525 + 1013904223) % 4294967296)
    ix = abs(int(seed)) % max(nCards, 1)
    learnId = (nCards <= 1000 || nLearn == 0 || learnId != 0) ? learnId : (((cards[ix].id == hold && nLearn > 1) || ((cards[ix].id == biasId && biasVal != "" ? biasVal : (cards[ix].bias ?? "normal")) == "never")) ? 0 : cards[ix].id)
    learnId = (nLearn == 0 || learnId != 0) ? learnId : (cards.find(c => (c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")) != "never").id ?? 0)
  }

  component BiasChoice(label, bias) {
    Text {
      text: label
      align: center
      fill: width
      padding: [8, 10]
      radius: 8 * corners
      border: 1
      borderColor: draftBias == bias ? accent : border
      background: draftBias == bias ? alpha(accent, 0.18) : surface
      color: draftBias == bias ? accent : foreground
      onTap: { draftBias = bias; haptic() }
    }
  }

  component CardRow(c) {
    Box {
      padding: 10
      radius: 8 * corners
      border: 1
      borderColor: border
      background: surface
      onTap: {
        view = "edit"
        editId = c.id
        draftFront = c.front ?? ""
        draftBack = c.back ?? ""
        draftBias = c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")
        formError = ""
        confirm = false
        confirmAll = false
      }
      Column {
        let b = c.id == biasId && biasVal != "" ? biasVal : (c.bias ?? "normal")
        Row {
          gap: 8
          align: center
          Column {
            weight: 1
            gap: 2
            Text { text: c.front ?? ""; maxLines: 2; color: b == "never" ? muted : foreground }
            Text { text: c.back ?? ""; style: small; color: muted; maxLines: 2 }
          }
          Text {
            text: b == "more" ? "more" : b == "less" ? "less" : b == "never" ? "paused" : "normal"
            width: 72
            align: end
            style: small
            color: b == "more" ? orange : b == "less" ? blue : b == "never" ? muted : foreground
          }
        }
      }
    }
  }

  component Mark(label, bias, tint) {
    Button {
      text: label
      color: tint
      fill: width
      onTap: {
        biasId = learnId
        biasVal = bias
        haptic()
        run(learnId == 0 ? ":" : prep + "tmp=$(mktemp); jq --argjson id ${int(learnId)} --arg bias ${sh(bias)} '.cards |= (if type == \"array\" then . else [] end | map(if .id == $id then .bias = (if ($bias == \"more\" or $bias == \"less\" or $bias == \"never\" or $bias == \"normal\") then $bias else \"normal\" end) else . end))' \"$f\" > \"$tmp\" && mv \"$tmp\" \"$f\" || { rm -f \"$tmp\"; exit 1; }")
        draw = learnId == 0 ? draw : draw + 1
      }
    }
  }

  onTap: { view = "list"; confirm = false; screen() }

  Column {
    gap: 8
    fill: true
    Text { text: "flashcards"; style: muted }
    Box {
      weight: 1
      fill: width
      align: center
      radius: 12 * corners
      background: surface
      border: 1
      borderColor: border
      onTap: { view = "list"; confirm = false; screen() }
      Column {
        align: center
        gap: 0
        Text { text: "${nLearn}"; fontSize: 36; align: center }
        Text {
          text: n == 0 ? "no cards yet" : "of ${n} to learn"
          style: small
          color: muted
          align: center
        }
      }
    }
    Row {
      gap: 6
      Button {
        text: "Learn"
        color: accent
        weight: 1
        onTap: { view = "learn"; confirm = false; draw = draw + 1; screen(); haptic() }
      }
      Button {
        text: "Cards"
        weight: 1
        onTap: { view = "list"; confirm = false; screen(); haptic() }
      }
    }
  }

  screen {
    title: view == "learn" ? "Learn" : view == "edit" ? (editId == 0 ? "New card" : "Edit card") : view == "import" ? "Import" : view == "save" ? "Save deck" : "Flashcards"

    Column {
      fill: true
      padding: 12
      gap: 8

      if view == "edit" {
        Column {
          scroll: true
          fill: true
          gap: 10
          Text { text: "‹ Cards"; color: accent; onTap: { view = "list"; confirm = false; formError = "" } }
          Text { text: "Front"; style: label; color: muted }
          Input {
            text: draftFront
            focus: editId == 0
            onChange: draftFront = value
          }
          Text { text: "Back"; style: label; color: muted }
          Input {
            text: draftBack
            onChange: draftBack = value
          }
          Text { text: "Frequency"; style: label; color: muted }
          Text {
            text: "More shows up three times, normal twice, less once. Don't learn stays out."
            style: small
            color: muted
            maxLines: 3
          }
          Grid {
            columns: 2
            gap: 8
            BiasChoice { label: "Learn more"; bias: "more" }
            BiasChoice { label: "Learn less"; bias: "less" }
            BiasChoice { label: "Don't learn"; bias: "never" }
            BiasChoice { label: "Normal"; bias: "normal" }
          }
          if editId != 0 {
            Button {
              text: "Reset to normal"
              fill: width
              onTap: { draftBias = "normal"; haptic() }
            }
          }
          if formError != "" { Text { text: formError; style: small; color: red } }
          Button {
            text: "Save"
            color: accent
            fill: width
            onTap: {
              formError = blank ? "Both sides need text." : ""
              biasId = blank || editId == 0 ? biasId : editId
              biasVal = blank || editId == 0 ? biasVal : draftBias
              view = blank ? view : "list"
              confirm = blank ? confirm : false
              run(blank ? ":" : prep + "tmp=$(mktemp); jq --argjson id ${int(editId)} --arg front ${sh(trim(draftFront))} --arg back ${sh(trim(draftBack))} --arg bias ${sh(draftBias)} 'def clean: if . == \"more\" or . == \"less\" or . == \"never\" or . == \"normal\" then . else \"normal\" end; .cards |= if type == \"array\" then . else [] end | .nextId |= if type == \"number\" then . else 1 end | if $id == 0 then .cards += [{id: .nextId, front: $front, back: $back, bias: ($bias | clean)}] | .nextId += 1 else .cards |= map(if .id == $id then .front = $front | .back = $back | .bias = ($bias | clean) else . end) end' \"$f\" > \"$tmp\" && mv \"$tmp\" \"$f\" || { rm -f \"$tmp\"; exit 1; }")
              haptic()
            }
          }
          if editId != 0 {
            if !confirm {
              Button { text: "Delete"; color: red; fill: width; onTap: { confirm = true; haptic() } }
            } else {
              Row {
                gap: 8
                Button {
                  text: "Really delete"
                  color: red
                  weight: 1
                  onTap: { run(prep + "tmp=$(mktemp); jq --argjson id ${int(editId)} '.cards |= if type == \"array\" then . else [] end | del(.cards[] | select(.id == $id))' \"$f\" > \"$tmp\" && mv \"$tmp\" \"$f\" || { rm -f \"$tmp\"; exit 1; }"); view = "list"; confirm = false; haptic() }
                }
                Button { text: "Cancel"; weight: 1; onTap: confirm = false }
              }
            }
          }
        }
      } else if view == "learn" {
        Column {
          fill: true
          gap: 8
          Text { text: "‹ Cards"; color: accent; onTap: { view = "list"; revealed = false } }
          if nLearn == 0 {
            Column {
              weight: 1
              gap: 8
              justify: center
              Text { text: "Nothing to learn"; style: title }
              Text {
                text: n == 0 ? "Add a card first. The front is the prompt, and Reveal shows the back." : "Every card is set to don't learn. Reset one in the editor to bring it back."
                style: small
                color: muted
                maxLines: 4
              }
              Button { text: "Back to cards"; color: accent; fill: width; onTap: view = "list" }
            }
          } else if card == null {
            Column {
              weight: 1
              align: center
              justify: center
              Text { text: "…"; style: title; color: muted }
            }
          } else {
            Box {
              weight: 1
              fill: width
              align: center
              padding: 18
              radius: 16 * corners
              background: surface
              border: 1
              borderColor: border
              Column {
                fill: width
                gap: 10
                align: center
                Text { text: "Front"; style: label; color: muted }
                Text { text: card.front; fontSize: 30; align: center; maxLines: 6 }
                if revealed {
                  Box { height: 1; fill: width; background: border }
                  Text { text: "Back"; style: label; color: muted }
                  Text { text: card.back; fontSize: 24; align: center; color: accent; maxLines: 6 }
                }
              }
            }
            Text { text: "Now: ${biasWord}"; style: small; color: muted; align: center }
            if !revealed {
              Button { text: "Reveal"; color: accent; fill: width; height: 64; onTap: { revealed = true; haptic() } }
              Button { text: "Next card"; fill: width; height: 64; onTap: { draw = draw + 1; haptic() } }
            } else {
              Grid {
                columns: 2
                gap: 8
                Mark { label: "Learn more"; bias: "more"; tint: orange }
                Mark { label: "Learn less"; bias: "less"; tint: blue }
                Mark { label: "Don't learn"; bias: "never"; tint: muted }
                Mark { label: "Reset"; bias: "normal"; tint: foreground }
              }
              Button { text: "Next card"; fill: width; height: 64; onTap: { draw = draw + 1; haptic() } }
            }
          }
        }
      } else if view == "import" {
        Column {
          fill: true
          gap: 8
          Text { text: "‹ Cards"; color: accent; onTap: { view = "list"; confirmAll = false; deleteDeckId = "" } }
          Text {
            text: "Adds a deck to your cards. Cards you already have, with the same front and back, are skipped."
            style: small
            color: muted
            maxLines: 3
          }
          if importNote != "" {
            Text { text: importNote; style: small; color: accent; maxLines: 3 }
          }
          Column {
            scroll: true
            weight: 1
            gap: 8
            if len(setList) == 0 {
              Text { text: "No decks yet."; style: small; color: muted }
            }
            for s in setList key s.id {
              Box {
                padding: 10
                radius: 8 * corners
                border: 1
                borderColor: border
                background: surface
                Column {
                  gap: 8
                  Row {
                    gap: 8
                    align: center
                    Column {
                      weight: 1
                      gap: 2
                      Text { text: s.name; maxLines: 2 }
                      Text { text: "${s.count} cards"; style: small; color: muted }
                    }
                    if deleteDeckId != s.id {
                      Text {
                        text: "Add"
                        width: 48
                        align: end
                        color: accent
                        onTap: {
                          importNote = "Added ${s.name}. Matching cards were skipped."
                          view = "list"
                          page = 0
                          query = ""
                          confirmAll = false
                          deleteDeckId = ""
                          haptic()
                          run(prep + "id=${sh(s.id)}; printf '%s\n' \"$id\" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || exit 1; s=\"$d/decks/$id.json\"; test -f \"$s\" || exit 1; tmp=$(mktemp); jq --slurpfile set \"$s\" --arg deckName ${sh(s.name)} " + jqImport + " \"$f\" > \"$tmp\" && mv \"$tmp\" \"$f\" || { rm -f \"$tmp\"; exit 1; }")
                        }
                      }
                    }
                    if deleteDeckId != s.id {
                      Text {
                        text: "Delete"
                        width: 64
                        align: end
                        color: red
                        onTap: { deleteDeckId = s.id; importNote = ""; haptic() }
                      }
                    }
                  }
                  if deleteDeckId == s.id {
                    Row {
                      gap: 8
                      Button {
                        text: "Really delete"
                        color: red
                        weight: 1
                        onTap: {
                          importNote = "Deleted ${s.name}."
                          run(prep + "id=${sh(deleteDeckId)}; printf '%s\n' \"$id\" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || exit 1; rm -f -- \"$d/decks/$id.json\"; " + catalogCmd)
                          deleteDeckId = ""
                          haptic()
                        }
                      }
                      Button { text: "Cancel"; weight: 1; onTap: { deleteDeckId = ""; haptic() } }
                    }
                  }
                }
              }
            }
          }
        }
      } else if view == "save" {
        Column {
          fill: true
          gap: 10
          Text { text: "‹ Cards"; color: accent; onTap: { view = "list"; formError = "" } }
          Text {
            text: "Saves a copy of the current deck. Each save writes a new file, so earlier copies stay."
            style: small
            color: muted
            maxLines: 3
          }
          Text { text: "Name"; style: label; color: muted }
          Input {
            text: draftName
            focus: true
            onChange: draftName = value
          }
          if formError != "" { Text { text: formError; style: small; color: red } }
          Button {
            text: "Save"
            color: accent
            fill: width
            onTap: {
              formError = trim(draftName) == "" ? "The deck needs a name." : ""
              view = trim(draftName) == "" ? view : "list"
              importNote = trim(draftName) == "" ? importNote : "Saved ${trim(draftName)}."
              run(trim(draftName) == "" ? ":" : prep + "id=$(uuidgen | tr '[:upper:]' '[:lower:]'); printf '%s\n' \"$id\" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || exit 1; name=${sh(trim(draftName))}; tmp=$(mktemp); jq --arg id \"$id\" --arg name \"$name\" '{id: $id, name: $name, cards: [(.cards // [])[] | select((.front | type) == \"string\" and (.back | type) == \"string\" and .front != \"\" and .back != \"\") | {front, back, bias: (if (.bias == \"more\" or .bias == \"less\" or .bias == \"never\" or .bias == \"normal\") then .bias else \"normal\" end)}]}' \"$f\" > \"$tmp\" && mv \"$tmp\" \"$d/decks/$id.json\" || { rm -f \"$tmp\"; exit 1; }; tmp=$(mktemp); jq --arg name \"$name\" '.name = $name' \"$f\" > \"$tmp\" && mv \"$tmp\" \"$f\" || { rm -f \"$tmp\"; exit 1; }; " + catalogCmd)
              haptic()
            }
          }
          Button {
            text: "Cancel"
            fill: width
            onTap: { view = "list"; formError = "" }
          }
        }
      } else {
        Column {
          fill: true
          gap: 8
          Row {
            align: center
            gap: 8
            Text {
              text: n == 0 ? "No cards yet" : n == 1 ? "1 card · ${nLearn} to learn" : "${n} cards · ${nLearn} to learn"
              style: small
              color: muted
              weight: 1
              maxLines: 2
            }
            Box {
              width: 36
              height: 36
              align: center
              radius: 8 * corners
              border: 1
              borderColor: border
              background: surface
              onTap: { view = "import"; confirmAll = false; deleteDeckId = ""; haptic() }
              Canvas {
                width: 22
                height: 22
                line(11, 2, 11, 12, stroke: accent, width: 2, cap: round)
                line(6, 8, 11, 13, stroke: accent, width: 2, cap: round)
                line(16, 8, 11, 13, stroke: accent, width: 2, cap: round)
                line(4, 16, 4, 20, stroke: foreground, width: 2, cap: round)
                line(4, 20, 18, 20, stroke: foreground, width: 2, cap: round)
                line(18, 20, 18, 16, stroke: foreground, width: 2, cap: round)
              }
            }
          }
          if importNote != "" {
            Text { text: importNote; style: small; color: accent; maxLines: 3 }
          }
          Row {
            gap: 8
            Button {
              text: "New card"
              weight: 1
              onTap: {
                view = "edit"
                editId = 0
                draftFront = ""
                draftBack = ""
                draftBias = "normal"
                formError = ""
                confirm = false
                confirmAll = false
                importNote = ""
                haptic()
              }
            }
            Button {
              text: "Learn"
              color: accent
              weight: 1
              onTap: { view = "learn"; confirmAll = false; importNote = ""; draw = draw + 1; haptic() }
            }
          }
          if n > 0 {
            Input {
              text: query
              placeholder: "Search cards"
              onChange: { query = value; page = 0 }
            }
          }
          Column {
            scroll: true
            weight: 1
            gap: 8
            if n == 0 {
              Text {
                text: "Prompt on the front, answer on the back. Use the icon above to import a deck."
                style: small
                color: muted
                maxLines: 4
              }
            }
            if n > 0 && len(slice) == 0 {
              Text { text: "No matches"; style: small; color: muted }
            }
            for c in slice key c.id {
              CardRow { c: c }
            }
          }
          if len(base) > pageSize {
            Row {
              gap: 8
              align: center
              Button { text: "Prev"; width: 84; onTap: { page = max(0, pageSafe - 1); haptic() } }
              Text {
                text: "${pageSafe * pageSize + 1}–${min((pageSafe + 1) * pageSize, len(base))} of ${len(base)}"
                weight: 1
                align: center
                style: small
                color: muted
              }
              Button { text: "Next"; width: 84; onTap: { page = min(pageSafe + 1, pageCount - 1); haptic() } }
            }
          }
          if q != "" && nCards > 1000 && len(base) == 1000 {
            Text { text: "Showing the first 1000 matches."; style: label; color: muted }
          }
          Button {
            text: "Save deck"
            fill: width
            onTap: {
              view = "save"
              draftName = disk.name ?? ""
              formError = ""
              confirmAll = false
              deleteDeckId = ""
              haptic()
            }
          }
          if n > 0 {
            if !confirmAll {
              Button {
                text: "Delete all cards"
                color: red
                fill: width
                onTap: { confirmAll = true; haptic() }
              }
            } else {
              Row {
                gap: 8
                Button {
                  text: "Really delete all"
                  color: red
                  weight: 1
                  onTap: {
                    run(prep + "tmp=$(mktemp); jq '.cards = []' \"$f\" > \"$tmp\" && mv \"$tmp\" \"$f\" || { rm -f \"$tmp\"; exit 1; }")
                    confirmAll = false
                    learnId = 0
                    revealed = false
                    biasId = 0
                    biasVal = ""
                    page = 0
                    query = ""
                    importNote = ""
                    haptic()
                  }
                }
                Button { text: "Cancel"; weight: 1; onTap: confirmAll = false }
              }
            }
          }
          Text {
            text: "~/.local/share/omalauncher/flashcards/flashcards.json"
            style: label
            color: muted
            maxLines: 2
          }
        }
      }
    }
  }
}
