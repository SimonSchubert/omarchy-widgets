widget "radar wallpaper" {
  meta { description: "Live National Weather Service radar on a night map, centered on this phone."; version: "1.10"; license: "MIT"; category: "world"; owl: 6 }
  page: 1
  order: 30
  size: 3x2
  minSize: 2x2
  requires { pacman: ["curl", "ffmpeg"] }

  // The loop is the program below, written once when the tile starts and
  // installed under the home directory. It is not downloaded. Once a minute
  // the tile touches a heartbeat. If that goes quiet, or the wallpaper is
  // switched off, the program puts the previous background back and exits.
  // page and order apply when this file is added by hand; a store install
  // uses the page you are on.
  source cfg = file("~/.config/omalauncher/nws-wallpaper.conf")
  source st = file("~/.cache/omalauncher/nws-wallpaper/status.json") json
  source sys = android.system every 1m
  source wx = http("https://wttr.in/?format=j1") every 30m timeout 10s json

  let enabled = match(cfg ?? "", "enabled=(0|1)")[0] ?? "1"
  let play = match(cfg ?? "", "play=(loop|still)")[0] ?? "loop"
  let speed = match(cfg ?? "", "speed=(slow|normal)")[0] ?? "normal"
  let reach = match(cfg ?? "", "reach=(close|around|wide)")[0] ?? "around"
  let dim = match(cfg ?? "", "dim=([0-9]+)")[0] ?? "0"
  let refresh = match(cfg ?? "", "refresh=([0-9]+)")[0] ?? "15"
  let phase = st.phase ?? "starting"
  let label = phase == "playing" ? "live" : phase == "paused" ? "paused" : phase == "off" ? "off" : phase == "error" ? "offline" : phase == "fetching" ? "fetching…" : "starting…"
  let reachLabel = reach == "close" ? "closer" : reach == "wide" ? "wider" : "around me"
  let dw = int(sys.display.width)
  let dh = int(sys.display.height)
  let lat = wx.nearest_area[0].latitude
  let lon = wx.nearest_area[0].longitude

  when sys != null {
    run("""
d=$HOME/.local/share/omalauncher/nws-wallpaper
mkdir -p "$d"
tmp=$(mktemp)
cat > "$tmp" << 'NWS_WP_SCRIPT_END'
# Plays an NWS radar loop as the omalauncher wallpaper.
#
# The launcher redraws the wallpaper only when the background name in
# style.toml changes, and it drops swaps faster than about a second. Each
# frame is its own JPEG (nws-conus-00.jpg, ...) and this process rotates the
# name. One daemon does that. mkdir is the lock: flock does not exclude
# other processes here.
#
# The radar tile writes ~/.config/omalauncher/nws-wallpaper.conf and reads
# ~/.cache/omalauncher/nws-wallpaper/status.json. It does not stream this
# script. Frames land in the active theme's background folder.
#
# The loop is the public CONUS mosaic from radar.weather.gov. NWS imagery
# is public domain. Nothing in this file is a private path or a place.
#
# The mosaic is a light map. A night lookup repaints land, water, borders,
# and highways, and leaves the radar colors as NWS drew them.
#
# The phone crop hides the time NWS prints in the corner. Each frame gets
# that time back, and a dot for its place in the loop, so a quiet stretch
# of radar still shows that the loop is moving.
#
# The tile touches a heartbeat about once a minute while its page is on
# screen. If that file is a few minutes old, or the wallpaper is switched
# off, this process puts the previous background back and exits. It does
# not keep polling, and it does not download, once the home screen is gone.
#
# The Weather Service publishes a new loop about every 15 minutes, so that
# is the only fetch interval. refresh 0 keeps the pictures already saved
# and does not download another. A frame step is never faster than 2 seconds,
# because each step makes the launcher decode a full-screen wallpaper.
#
# Optional environment overrides exist so a check can run against a copy
# of the files and leave the live wallpaper alone. Unset, the defaults are
# the per-user omalauncher paths.
set -u

cache="${NWS_WP_CACHE:-$HOME/.cache/omalauncher/nws-wallpaper}"
conf="${NWS_WP_CONF:-$HOME/.config/omalauncher/nws-wallpaper.conf}"
style="${NWS_WP_STYLE:-$HOME/.config/omalauncher/style/style.toml}"
bg_root="${NWS_WP_BG:-$HOME/.config/omarchy/backgrounds}"
ua="omalauncher-nws-wallpaper/1.0 (live wallpaper; radar.weather.gov)"
gif="$cache/loop.gif"
lockdir="$cache/worker.d"
previous="$cache/previous"
owned="$cache/owned"
beat="$cache/heartbeat"
# Touched by the tile about once a minute. A few minutes of silence means
# the home screen is not showing this tile.
beat_max=180
child_pid=""

mkdir -p "$cache" "$(dirname "$conf")" "$(dirname "$style")"

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

conf_get() {
  local k=$1 def=$2 v
  v=$(sed -n "s/^${k}=//p" "$conf" 2>/dev/null | head -1)
  if [ -n "$v" ]; then printf '%s' "$v"; else printf '%s' "$def"; fi
}

# Rewrite one key. The same value does not touch the file, so the daemon's
# wait is not cut short by its own write.
set_key() {
  local k=$1 v=$2 cur tmp i
  cur=$(conf_get "$k" "__missing__")
  if [ "$cur" = "$v" ]; then
    return 0
  fi
  i=0
  while ! mkdir "$cache/conf.lock" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -gt 50 ] && return 1
    sleep 0.1
  done
  tmp=$(mktemp "$cache/conf.XXXXXX")
  if [ -f "$conf" ]; then
    grep -v "^${k}=" "$conf" >"$tmp" || true
  fi
  printf '%s=%s\n' "$k" "$v" >>"$tmp"
  mv -f "$tmp" "$conf"
  rmdir "$cache/conf.lock" 2>/dev/null || true
  conf_mtime=$(stat -c%Y "$conf" 2>/dev/null || echo 0)
}

write_default_conf() {
  [ -f "$conf" ] && return 0
  cat >"$conf" <<'EOF'
# Radar wallpaper. The home-screen tile edits this. Style can turn it off too.
enabled=1
play=loop
speed=normal
dwell=medium
view=local
reach=around
xpan=here
ypan=here
dim=0
sector=conus-large
refresh=15
lat=
lon=
EOF
}

load_conf() {
  write_default_conf
  enabled=$(conf_get enabled 1)
  play=$(conf_get play loop)
  speed=$(conf_get speed normal)
  dwell=$(conf_get dwell medium)
  view=$(conf_get view local)
  reach=$(conf_get reach around)
  pan=$(conf_get xpan here)
  vpan=$(conf_get ypan here)
  dim=$(conf_get dim 0)
  sector=$(conf_get sector conus-large)
  refresh=$(conf_get refresh 15)
  lat=$(conf_get lat "")
  lon=$(conf_get lon "")
  case $enabled in 0|1) ;; *) enabled=1 ;; esac
  case $play in loop|still) ;; *) play=loop ;; esac
  case $speed in slow|normal) ;; *) speed=normal ;; esac
  case $dwell in short|medium|long) ;; *) dwell=medium ;; esac
  case $view in local) ;; *) view=local ;; esac
  case $reach in close|around|wide) ;; *) reach=around ;; esac
  case $pan in west|center|east|here) ;; *) pan=here ;; esac
  case $vpan in north|center|south|here) ;; *) vpan=here ;; esac
  case $dim in ''|*[!0-9]*) dim=0 ;; esac
  [ "$dim" -gt 40 ] && dim=40
  # 0 means do not download. Anything else follows the source, every 15 minutes.
  case $refresh in
    0) ;;
    *) refresh=15 ;;
  esac
  case $sector in
    conus-large|conus|pacnorthwest|pacsouthwest|northrockies|southrockies|uppermissvly|centgrtlakes|northeast|midatlantic|southeast|southplains|southmissvly|alaska|hawaii|carib|guam) ;;
    *) sector=conus-large ;;
  esac
  case $lat in ''|*[!0-9.-]*) lat= ;; esac
  case $lon in ''|*[!0-9.-]*) lon= ;; esac
  conf_mtime=$(stat -c%Y "$conf" 2>/dev/null || echo 0)
  # Each step rewrites the wallpaper. Never faster than 2 seconds.
  case $speed in slow) step=4 ;; *) step=2 ;; esac
  case $dwell in short) hold=2 ;; long) hold=5 ;; *) hold=2 ;; esac
  [ "$step" -lt 2 ] && step=2
  [ "$hold" -lt 2 ] && hold=2
}

sector_name() {
  case $sector in
    conus-large) printf '%s' CONUS-LARGE ;;
    conus) printf '%s' CONUS ;;
    pacnorthwest) printf '%s' PACNORTHWEST ;;
    pacsouthwest) printf '%s' PACSOUTHWEST ;;
    northrockies) printf '%s' NORTHROCKIES ;;
    southrockies) printf '%s' SOUTHROCKIES ;;
    uppermissvly) printf '%s' UPPERMISSVLY ;;
    centgrtlakes) printf '%s' CENTGRLAKES ;;
    northeast) printf '%s' NORTHEAST ;;
    midatlantic) printf '%s' MIDATLANTIC ;;
    southeast) printf '%s' SOUTHEAST ;;
    southplains) printf '%s' SOUTHPLAINS ;;
    southmissvly) printf '%s' SOUTHMISSVLY ;;
    alaska) printf '%s' ALASKA ;;
    hawaii) printf '%s' HAWAII ;;
    carib) printf '%s' CARIB ;;
    guam) printf '%s' GUAM ;;
    *) printf '%s' CONUS-LARGE ;;
  esac
}

worker_alive() {
  local pid age now
  [ -d "$lockdir" ] || return 1
  pid=$(cat "$lockdir/pid" 2>/dev/null || true)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  # The directory exists but the pid is not written yet.
  if [ -z "$pid" ]; then
    now=$(date +%s)
    age=$(stat -c%Y "$lockdir" 2>/dev/null || echo 0)
    [ $((now - age)) -lt 5 ]
    return
  fi
  return 1
}

take_lock() {
  if mkdir "$lockdir" 2>/dev/null; then
    echo $$ >"$lockdir/pid"
    return 0
  fi
  if worker_alive; then
    return 1
  fi
  mv "$lockdir" "$lockdir.old.$$" 2>/dev/null || return 1
  if mkdir "$lockdir" 2>/dev/null; then
    echo $$ >"$lockdir/pid"
    rm -f "$lockdir.old.$$/pid"
    rmdir "$lockdir.old.$$" 2>/dev/null || true
    return 0
  fi
  rm -f "$lockdir.old.$$/pid"
  rmdir "$lockdir.old.$$" 2>/dev/null || true
  return 1
}

release_lock() {
  local p
  p=$(cat "$lockdir/pid" 2>/dev/null || true)
  if [ "$p" = "$$" ]; then
    rm -f "$lockdir/pid"
    rmdir "$lockdir" 2>/dev/null || true
  fi
}

# Stop older daemons of this same file. Leave set, screen, locate, and
# ensure alone, and leave any other wallpaper program alone.
reap_old() {
  local p args snap me
  me=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
  snap="$cache/ps.txt"
  ps -ww -eo pid,args >"$snap" 2>/dev/null || return 0
  while read -r p args; do
    case $p in ''|*[!0-9]*) continue ;; esac
    [ "$p" -le 1 ] && continue
    case $args in
      *"$me daemon"*) ;;
      *) continue ;;
    esac
    [ "$p" = "$$" ] && continue
    [ "$p" = "$PPID" ] && continue
    kill "$p" 2>/dev/null || true
  done <"$snap"
  sleep 0.4
  ps -ww -eo pid,args >"$snap" 2>/dev/null || return 0
  while read -r p args; do
    case $p in ''|*[!0-9]*) continue ;; esac
    [ "$p" -le 1 ] && continue
    case $args in
      *"$me daemon"*) ;;
      *) continue ;;
    esac
    [ "$p" = "$$" ] && continue
    [ "$p" = "$PPID" ] && continue
    kill -9 "$p" 2>/dev/null || true
  done <"$snap"
  rm -f "$snap"
}

read_style() {
  theme=$(sed -n 's/^theme = "\(.*\)"/\1/p' "$style" 2>/dev/null | head -1)
  bg=$(sed -n 's/^background = "\(.*\)"/\1/p' "$style" 2>/dev/null | head -1)
  [ -n "$theme" ] || theme="tokyo-night"
}

# Remember style.toml's mtime after we write it, so a later change is the
# Style menu and not our own frame step.
note_style() {
  stat -c%Y "$style" >"$cache/style-stamp" 2>/dev/null || true
}

style_is_ours() {
  local sm ours
  # No stamp yet means this daemon has not written style.toml. The wallpaper
  # that is already there is the one to restore later, not a request to stop.
  [ -f "$cache/style-stamp" ] || return 0
  sm=$(stat -c%Y "$style" 2>/dev/null || echo 0)
  ours=$(cat "$cache/style-stamp" 2>/dev/null || echo 0)
  [ "$sm" = "$ours" ]
}

screen_size() {
  sw=1080
  scrh=2388
  local a b
  if [ -f "$cache/screen" ] && read -r a b <"$cache/screen"; then
    case $a in
      ''|*[!0-9]*) ;;
      *) case $b in
           ''|*[!0-9]*) ;;
           *) sw=$a; scrh=$b ;;
         esac ;;
    esac
  fi
  if [ "$sw" -lt 200 ] || [ "$sw" -gt 2000 ]; then sw=1080; fi
  if [ "$scrh" -lt 200 ] || [ "$scrh" -gt 4000 ]; then scrh=2388; fi
  if [ $((sw % 2)) -eq 1 ]; then sw=$((sw - 1)); fi
  if [ $((scrh % 2)) -eq 1 ]; then scrh=$((scrh - 1)); fi
}

theme_color() {
  local f c
  if [ -n "${NWS_WP_COLOR:-}" ]; then
    color=$(printf '%s' "$NWS_WP_COLOR" | tr 'A-F' 'a-f')
    return
  fi
  color="111c18"
  for f in \
    "$HOME/.config/omarchy/themes/$theme/colors.toml" \
    "$HOME/.local/share/omarchy/themes/$theme/colors.toml" \
    "/usr/share/omarchy/themes/$theme/colors.toml"
  do
    [ -f "$f" ] || continue
    c=$(sed -n 's/^background = "#\{0,1\}\([0-9A-Fa-f]\{6\}\)"/\1/p' "$f" | head -1)
    if [ -n "$c" ]; then
      color=$(printf '%s' "$c" | tr 'A-F' 'a-f')
      return
    fi
  done
}

frames_dir() {
  dir="$bg_root/$theme"
  mkdir -p "$dir"
}

# 0 if style.toml now names $1. Returns 2 if the background changed to
# something other than what we expected, so a Style pick is left alone.
write_bg() {
  local name=$1 expect=$2
  local tries=0 before cur now tmp
  while [ "$tries" -lt 3 ]; do
    before=$(cat "$style" 2>/dev/null || true)
    cur=$(printf '%s\n' "$before" | sed -n 's/^background = "\(.*\)"/\1/p' | head -1)
    if [ "$cur" = "$name" ]; then
      return 0
    fi
    case $cur in
      nws-conus-*.jpg) ;;
      *)
        if [ "$cur" != "$expect" ]; then
          return 2
        fi
        ;;
    esac
    tmp=$(mktemp "$(dirname "$style")/.style.XXXXXX")
    if printf '%s\n' "$before" | grep -q '^background = '; then
      printf '%s\n' "$before" | sed "s/^background = .*/background = \"$name\"/" >"$tmp"
    else
      printf '%s\n' "$before" >"$tmp"
      printf 'background = "%s"\n' "$name" >>"$tmp"
    fi
    now=$(cat "$style" 2>/dev/null || true)
    if [ "$now" = "$before" ]; then
      mv -f "$tmp" "$style"
      return 0
    fi
    rm -f "$tmp"
    tries=$((tries + 1))
  done
  return 1
}

remember_previous() {
  case $bg in
    ''|nws-conus-*.jpg) ;;
    *) printf '%s\n' "$bg" >"$previous" ;;
  esac
}

# Put back the wallpaper Style was using. A theme file that is not one of
# our frames is the fallback when nothing has been remembered yet.
restore_previous() {
  local prev base f
  prev=$(cat "$previous" 2>/dev/null || true)
  case $prev in
    ''|nws-conus-*.jpg)
      prev=
      for f in "$dir"/*; do
        [ -f "$f" ] || continue
        base=$(basename "$f")
        case $base in
          nws-conus-*.jpg|.*) continue ;;
          *.jpg|*.jpeg|*.png|*.webp|*.gif) prev=$base; break ;;
        esac
      done
      ;;
  esac
  read_style
  if [ -n "$prev" ]; then
    case $bg in
      nws-conus-*.jpg) write_bg "$prev" "$bg" || true ;;
    esac
  fi
  note_style
  rm -f "$owned"
}

download() {
  local tmp code url magic
  url="https://radar.weather.gov/ridge/standard/$(sector_name)_loop.gif"
  tmp="$gif.part"
  rm -f "$tmp"
  rm -f "$cache/http.code"
  if [ -f "$gif" ]; then
    run_while_wanted "$cache/http.code" curl -sS -A "$ua" --max-time 90 -z "$gif" -o "$tmp" -w '%{http_code}' "$url" || true
  else
    run_while_wanted "$cache/http.code" curl -sS -A "$ua" --max-time 90 -o "$tmp" -w '%{http_code}' "$url" || true
  fi
  code=$(cat "$cache/http.code" 2>/dev/null || echo 000)
  case $code in
    200)
      magic=$(head -c 6 "$tmp" 2>/dev/null || true)
      case $magic in
        GIF87a|GIF89a)
          [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
          mv -f "$tmp" "$gif"
          return 0
          ;;
      esac
      rm -f "$tmp"
      log "download not a gif $url"
      return 1
      ;;
    304)
      rm -f "$tmp"
      return 0
      ;;
    *)
      rm -f "$tmp"
      log "download $code $url"
      return 1
      ;;
  esac
}

# NWS ships a light mosaic. Build a night-map lookup once: radar greens,
# yellows, reds, and purples stay, and land, water, borders, and highways
# are redrawn. lut3d applies it, which stays fast enough to republish.
night_geq() {
  cat <<'NWS_NIGHT_GEQ'
geq=r='if(gte(g(X\,Y)\,r(X\,Y)+40)*gte(g(X\,Y)\,b(X\,Y)+15)*gte(g(X\,Y)\,70)+gte(r(X\,Y)\,170)*gte(g(X\,Y)\,150)*lte(b(X\,Y)\,140)+gte(r(X\,Y)\,190)*gte(g(X\,Y)\,70)*lte(g(X\,Y)\,190)*lte(b(X\,Y)\,90)+gte(r(X\,Y)\,200)*lte(g(X\,Y)\,90)*lte(b(X\,Y)\,100)+gte(r(X\,Y)\,130)*gte(b(X\,Y)\,120)*lte(g(X\,Y)\,110)*gte(abs(r(X\,Y)-g(X\,Y))+abs(r(X\,Y)-b(X\,Y))+abs(g(X\,Y)-b(X\,Y))\,140)\,r(X\,Y)\,if(lt((r(X\,Y)+g(X\,Y)+b(X\,Y))/3\,72)*lt(abs(r(X\,Y)-g(X\,Y))\,45)*lt(abs(r(X\,Y)-b(X\,Y))\,45)*lt(abs(g(X\,Y)-b(X\,Y))\,45)\,154\,if(gte(r(X\,Y)\,100)*lt(r(X\,Y)\,200)*gte(r(X\,Y)\,g(X\,Y)+50)*gte(r(X\,Y)\,b(X\,Y)+50)*lt(g(X\,Y)\,110)*lt(b(X\,Y)\,110)\,110\,if(gte(b(X\,Y)\,r(X\,Y)+18)*gte(g(X\,Y)\,r(X\,Y)+8)*gte(b(X\,Y)\,150)*gte(g(X\,Y)\,160)*lt(abs(r(X\,Y)-g(X\,Y))\,100)*lt(abs(r(X\,Y)-b(X\,Y))\,100)*lt(abs(g(X\,Y)-b(X\,Y))\,100)\,20\,16))))':g='if(gte(g(X\,Y)\,r(X\,Y)+40)*gte(g(X\,Y)\,b(X\,Y)+15)*gte(g(X\,Y)\,70)+gte(r(X\,Y)\,170)*gte(g(X\,Y)\,150)*lte(b(X\,Y)\,140)+gte(r(X\,Y)\,190)*gte(g(X\,Y)\,70)*lte(g(X\,Y)\,190)*lte(b(X\,Y)\,90)+gte(r(X\,Y)\,200)*lte(g(X\,Y)\,90)*lte(b(X\,Y)\,100)+gte(r(X\,Y)\,130)*gte(b(X\,Y)\,120)*lte(g(X\,Y)\,110)*gte(abs(r(X\,Y)-g(X\,Y))+abs(r(X\,Y)-b(X\,Y))+abs(g(X\,Y)-b(X\,Y))\,140)\,g(X\,Y)\,if(lt((r(X\,Y)+g(X\,Y)+b(X\,Y))/3\,72)*lt(abs(r(X\,Y)-g(X\,Y))\,45)*lt(abs(r(X\,Y)-b(X\,Y))\,45)*lt(abs(g(X\,Y)-b(X\,Y))\,45)\,163\,if(gte(r(X\,Y)\,100)*lt(r(X\,Y)\,200)*gte(r(X\,Y)\,g(X\,Y)+50)*gte(r(X\,Y)\,b(X\,Y)+50)*lt(g(X\,Y)\,110)*lt(b(X\,Y)\,110)\,80\,if(gte(b(X\,Y)\,r(X\,Y)+18)*gte(g(X\,Y)\,r(X\,Y)+8)*gte(b(X\,Y)\,150)*gte(g(X\,Y)\,160)*lt(abs(r(X\,Y)-g(X\,Y))\,100)*lt(abs(r(X\,Y)-b(X\,Y))\,100)*lt(abs(g(X\,Y)-b(X\,Y))\,100)\,56\,22))))':b='if(gte(g(X\,Y)\,r(X\,Y)+40)*gte(g(X\,Y)\,b(X\,Y)+15)*gte(g(X\,Y)\,70)+gte(r(X\,Y)\,170)*gte(g(X\,Y)\,150)*lte(b(X\,Y)\,140)+gte(r(X\,Y)\,190)*gte(g(X\,Y)\,70)*lte(g(X\,Y)\,190)*lte(b(X\,Y)\,90)+gte(r(X\,Y)\,200)*lte(g(X\,Y)\,90)*lte(b(X\,Y)\,100)+gte(r(X\,Y)\,130)*gte(b(X\,Y)\,120)*lte(g(X\,Y)\,110)*gte(abs(r(X\,Y)-g(X\,Y))+abs(r(X\,Y)-b(X\,Y))+abs(g(X\,Y)-b(X\,Y))\,140)\,b(X\,Y)\,if(lt((r(X\,Y)+g(X\,Y)+b(X\,Y))/3\,72)*lt(abs(r(X\,Y)-g(X\,Y))\,45)*lt(abs(r(X\,Y)-b(X\,Y))\,45)*lt(abs(g(X\,Y)-b(X\,Y))\,45)\,154\,if(gte(r(X\,Y)\,100)*lt(r(X\,Y)\,200)*gte(r(X\,Y)\,g(X\,Y)+50)*gte(r(X\,Y)\,b(X\,Y)+50)*lt(g(X\,Y)\,110)*lt(b(X\,Y)\,110)\,76\,if(gte(b(X\,Y)\,r(X\,Y)+18)*gte(g(X\,Y)\,r(X\,Y)+8)*gte(b(X\,Y)\,150)*gte(g(X\,Y)\,160)*lt(abs(r(X\,Y)-g(X\,Y))\,100)*lt(abs(r(X\,Y)-b(X\,Y))\,100)*lt(abs(g(X\,Y)-b(X\,Y))\,100)\,72\,20))))'
NWS_NIGHT_GEQ
}

ensure_night_cube() {
  local n=33 div raw tmp cube geq expect got lines
  cube="$cache/night.cube"
  if [ -f "$cube" ] && [ "$(cat "$cache/night.ver" 2>/dev/null || true)" = "1" ]; then
    return 0
  fi
  div=$((n - 1))
  raw=$(mktemp "$cache/night-in.XXXXXX")
  tmp=$(mktemp "$cache/night-cube.XXXXXX")
  geq=$(night_geq)
  log "night map"
  if ! run_while_wanted "" ffmpeg -y -v error -f lavfi -i "color=c=black:s=${n}x$((n * n)):r=1" -frames:v 1 \
      -vf "format=rgb24,geq=r='X*255/${div}':g='mod(Y\\,${n})*255/${div}':b='floor(Y/${n})*255/${div}',${geq}" \
      -f rawvideo -pix_fmt rgb24 "$raw"; then
    rm -f "$raw" "$tmp"
    return 1
  fi
  expect=$((n * n * n * 3))
  got=$(wc -c <"$raw" | tr -d ' ')
  if [ "$got" != "$expect" ]; then
    rm -f "$raw" "$tmp"
    return 1
  fi
  if ! od -An -tu1 -v "$raw" | awk -v n="$n" '
    BEGIN { print "TITLE \"nws night map\""; printf "LUT_3D_SIZE %d\n", n }
    {
      for (i = 1; i <= NF; i++) {
        rgb[k++] = $i
        if (k == 3) {
          printf "%.6f %.6f %.6f\n", rgb[0] / 255, rgb[1] / 255, rgb[2] / 255
          k = 0
        }
      }
    }
  ' >"$tmp"; then
    rm -f "$raw" "$tmp"
    return 1
  fi
  lines=$(wc -l <"$tmp" | tr -d ' ')
  if [ "$lines" != "$((2 + n * n * n))" ]; then
    rm -f "$raw" "$tmp"
    return 1
  fi
  mv -f "$tmp" "$cube"
  printf '%s\n' 1 >"$cache/night.ver"
  rm -f "$raw"
}

# One cover crop of the national mosaic, centered on the phone, scaled to
# the whole screen. close / around / wide are shares of the tallest crop
# that still fills the screen. Regional mosaics stay centered.
build_vf() {
  local dim_r dim_g dim_b fx fy geom cw ch cx cy ow oh
  fx=0.52
  fy=0.48
  case $pan in
    west) fx=0.24 ;;
    east) fx=0.78 ;;
    here)
      case $sector in
        conus-large|conus)
          if [ -n "$lon" ]; then
            fx=$(awk -v lon="$lon" 'BEGIN { west=-125; east=-66; left=0.05; right=0.93; f=(lon-west)/(east-west); if (f<0) f=0; if (f>1) f=1; printf "%.4f", left+f*(right-left) }')
          fi
          ;;
      esac
      ;;
  esac
  case $vpan in
    north) fy=0.30 ;;
    south) fy=0.72 ;;
    here)
      case $sector in
        conus-large|conus)
          if [ -n "$lat" ]; then
            fy=$(awk -v lat="$lat" 'BEGIN { north=50; south=23; top=0.08; bot=0.84; f=(north-lat)/(north-south); if (f<0) f=0; if (f>1) f=1; printf "%.4f", top+f*(bot-top) }')
          fi
          ;;
      esac
      ;;
  esac
  geom=$(awk -v iw="$iw" -v ih="$ih" -v sw="$sw" -v scrh="$scrh" -v fx="$fx" -v fy="$fy" -v reach="$reach" 'BEGIN {
    mw = int(ih * sw / scrh); if (mw > iw) mw = iw; if (mw < 2) mw = 2;
    f = 0.72; if (reach == "close") f = 0.48; else if (reach == "wide") f = 1;
    cw = int(mw * f); if (cw < 2) cw = 2; if (cw > iw) cw = iw; if (cw % 2) cw--;
    ch = int(cw * scrh / sw); if (ch % 2) ch--;
    if (ch > ih || ch < 2) { ch = ih; if (ch % 2) ch--; cw = int(ch * sw / scrh); if (cw % 2) cw--; }
    if (cw < 2) cw = 2; if (ch < 2) ch = 2;
    cx = int(fx * iw - cw / 2); if (cx < 0) cx = 0; if (cx > iw - cw) cx = iw - cw; if (cx % 2) cx--;
    if (cx < 0) cx = 0;
    cy = int(fy * ih - ch / 2); if (cy < 0) cy = 0; if (cy > ih - ch) cy = ih - ch; if (cy % 2) cy--;
    if (cy < 0) cy = 0;
    printf "%d %d %d %d %d %d", cw, ch, cx, cy, sw, scrh
  }')
  read -r cw ch cx cy ow oh <<<"$geom"
  log "draw sector=$sector view=$view reach=$reach pan=$pan vpan=$vpan dim=$dim crop=${cw}x${ch}+${cx}+${cy} out=${ow}x${oh}"
  ensure_night_cube || return 1
  local base stamp pip step i prev room doty dotx0 plate_w
  base="crop=${cw}:${ch}:${cx}:${cy},scale=${ow}:${oh}:flags=lanczos,pad=${sw}:${scrh}:(ow-iw)/2:(oh-ih)/2:color=0x${color},format=rgb24,lut3d=file=${cache}/night.cube:interp=nearest"
  if [ "$dim" -gt 0 ]; then
    dim_r=$((16#${color:0:2}))
    dim_g=$((16#${color:2:2}))
    dim_b=$((16#${color:4:2}))
    # A 256-entry table. This ffmpeg rejects bare r, g, and b in geq.
    base="${base},lutrgb=r='val*(100-${dim})/100+${dim_r}*${dim}/100':g='val*(100-${dim})/100+${dim_g}*${dim}/100':b='val*(100-${dim})/100+${dim_b}*${dim}/100'"
  fi
  case ${frames_n:-} in ''|*[!0-9]*) frames_n=10 ;; esac
  [ "$frames_n" -lt 1 ] && frames_n=1
  [ "$frames_n" -gt 18 ] && frames_n=18
  # CONUS-LARGE prints the time at this corner. A smaller product has no
  # matching label, so it only gets the dots.
  stamp=0
  if [ "$iw" -ge 3000 ] && [ "$ih" -ge 1538 ]; then
    stamp=1
  fi
  pip=14
  step=26
  dotx0=52
  if [ "$stamp" -eq 1 ]; then
    room=600
    doty="main_h-118"
  else
    room=420
    doty="main_h-128"
  fi
  if [ "$frames_n" -gt 1 ] && [ $(( (frames_n - 1) * step + pip )) -gt "$room" ]; then
    step=$(( (room - pip) / (frames_n - 1) ))
    [ "$step" -lt 8 ] && step=8
  fi
  if [ "$stamp" -eq 1 ]; then
    vf="[0:v]split[geo][raw];[geo]${base},format=rgba,drawbox=x=32:y=ih-250:w=680:h=160:color=0x07110e@0.75:t=fill[map];"
  else
    plate_w=$((dotx0 - 32 + (frames_n - 1) * step + pip + 24))
    vf="[0:v]${base},format=rgba,drawbox=x=32:y=ih-150:w=${plate_w}:h=52:color=0x07110e@0.75:t=fill[map];"
  fi
  # overlay's n starts at 1 here, so the lit dot uses n-1.
  # Input 1 is the dim pip, input 2 is the lit pip.
  vf="${vf}[2:v]format=rgba[pip];"
  vf="${vf}[1:v]format=rgba,split=${frames_n}"
  i=0
  while [ "$i" -lt "$frames_n" ]; do
    vf="${vf}[d${i}]"
    i=$((i + 1))
  done
  vf="${vf};"
  prev=map
  i=0
  while [ "$i" -lt "$frames_n" ]; do
    vf="${vf}[${prev}][d${i}]overlay=x=$((dotx0 + i * step)):y=${doty}:eof_action=repeat:format=auto[m${i}];"
    prev="m${i}"
    i=$((i + 1))
  done
  if [ "$stamp" -eq 1 ]; then
    vf="${vf}[${prev}][pip]overlay=x=${dotx0}+(n-1)*${step}:y=${doty}:eof_action=repeat:format=auto[dotted];"
    vf="${vf}[raw]crop=700:90:30:1448,format=rgba,geq=r=236:g=244:b=238:a='if(lt(r(X\,Y)+g(X\,Y)+b(X\,Y)\,400)\,255\,0)',scale=620:80:flags=lanczos[stamp];"
    vf="${vf}[dotted][stamp]overlay=48:H-236:format=auto[out]"
  else
    vf="${vf}[${prev}][pip]overlay=x=${dotx0}+(n-1)*${step}:y=${doty}:eof_action=repeat:format=auto[out]"
  fi
}

# A generated color inside the filter adds frames, and the image muxer then
# rejects the timestamps. These are still pictures, overlaid once per frame.
ensure_pips() {
  local on="$cache/pip-on.png" off="$cache/pip-off.png"
  if [ -f "$on" ] && [ -f "$off" ]; then
    return 0
  fi
  mkdir -p "$cache"
  if ! ffmpeg -y -v error -f lavfi -i "color=c=white:s=14x14:d=1" \
      -vf "format=rgba,geq=r=236:g=244:b=238:a='if(lt(hypot(X-6.5\,Y-6.5)\,6)\,255\,0)'" \
      -frames:v 1 "$on"; then
    rm -f "$on"
    return 1
  fi
  if ! ffmpeg -y -v error -f lavfi -i "color=c=white:s=14x14:d=1" \
      -vf "format=rgba,geq=r=236:g=244:b=238:a='if(lt(hypot(X-6.5\,Y-6.5)\,6)\,80\,0)'" \
      -frames:v 1 "$off"; then
    rm -f "$off"
    return 1
  fi
}

publish() {
  local built n f base i other
  read_style
  screen_size
  theme_color
  frames_dir
  [ -f "$gif" ] || return 1
  iw=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$gif" | tr -d ',\r' | head -1)
  ih=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$gif" | tr -d ',\r' | head -1)
  case $iw in ''|*[!0-9]*) return 1 ;; esac
  case $ih in ''|*[!0-9]*) return 1 ;; esac
  frames_n=$(ffprobe -v error -select_streams v:0 -show_entries stream=nb_frames -of csv=p=0 "$gif" | tr -d ',\r' | head -1)
  case $frames_n in ''|*[!0-9]*) frames_n=10 ;; esac
  build_vf || return 1
  built="$dir/.nws-build"
  mkdir -p "$built"
  for f in "$built"/f-*.jpg; do
    [ -e "$f" ] || continue
    rm -f "$f"
  done
  # ffmpeg must be given a real .jpg path. A .tmp name is left undecoded.
  ensure_pips || return 1
  if ! run_while_wanted "" timeout 180 nice -n 10 ffmpeg -y -v error -i "$gif" -i "$cache/pip-off.png" -i "$cache/pip-on.png" -fps_mode passthrough -filter_complex "$vf" -map "[out]" -q:v 3 "$built/f-%02d.jpg"; then
    for f in "$built"/f-*.jpg; do
      [ -e "$f" ] || continue
      rm -f "$f"
    done
    rmdir "$built" 2>/dev/null || true
    return 1
  fi
  n=0
  for f in "$built"/f-*.jpg; do
    [ -e "$f" ] || continue
    mv -f "$f" "$dir/$(printf 'nws-conus-%02d.jpg' "$n")"
    n=$((n + 1))
  done
  rmdir "$built" 2>/dev/null || true
  if [ "$n" -lt 1 ]; then
    return 1
  fi
  for f in "$dir"/nws-conus-*.jpg; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    i=${base#nws-conus-}
    i=${i%.jpg}
    case $i in ''|*[!0-9]*) continue ;; esac
    if [ "$((10#$i))" -ge "$n" ]; then
      rm -f "$f"
    fi
  done
  for other in "$bg_root"/*/nws-conus-*.jpg; do
    [ -e "$other" ] || continue
    case $other in
      "$dir"/*) ;;
      *) rm -f "$other" ;;
    esac
  done
  printf '%s\n' "$(current_mark)" >"$cache/stamp"
  count=$n
  return 0
}

list_frames() {
  frames=()
  local f
  for f in "$dir"/nws-conus-*.jpg; do
    [ -e "$f" ] || continue
    frames+=("$f")
  done
  if [ "${#frames[@]}" -gt 0 ]; then
    mapfile -t frames < <(printf '%s\n' "${frames[@]}" | LC_ALL=C sort)
  fi
  count=${#frames[@]}
}

current_mark() {
  local mt mlat mlon
  mt=$(stat -c%Y "$gif" 2>/dev/null || echo 0)
  mlat=
  mlon=
  if [ "$pan" = "here" ] || [ "$vpan" = "here" ]; then
    mlat=$lat
    mlon=$lon
  fi
  printf '%s\n' "$theme $sw $scrh $color $mt $sector $view $reach $pan $vpan $dim $mlat $mlon cue1"
}

write_status() {
  local phase=$1 reason=$2 tmp
  tmp=$(mktemp "$cache/status.XXXXXX")
  printf '{"ok":true,"phase":"%s","reason":"%s","frame":%s,"count":%s,"enabled":%s,"play":"%s","speed":"%s","dwell":"%s","view":"%s","reach":"%s","pan":"%s","vpan":"%s","dim":%s,"sector":"%s","refresh":%s}\n' \
    "$phase" "$reason" "${show_frame:-0}" "${count:-0}" "$enabled" "$play" "$speed" "$dwell" "$view" "$reach" "$pan" "$vpan" "$dim" "$sector" "$refresh" >"$tmp"
  if [ -f "$cache/status.json" ] && cmp -s "$tmp" "$cache/status.json"; then
    rm -f "$tmp"
    return 0
  fi
  mv -f "$tmp" "$cache/status.json"
}

nap() {
  local t=$1 i=0 m
  while [ "$i" -lt "$t" ]; do
    sleep 1
    i=$((i + 1))
    m=$(stat -c%Y "$conf" 2>/dev/null || echo 0)
    if [ "$m" != "$conf_mtime" ]; then
      return 0
    fi
  done
}

show_frame_file() {
  local name rc
  name=$(basename "$1")
  show_frame=${name#nws-conus-}
  show_frame=${show_frame%.jpg}
  show_frame=$((10#$show_frame))
  read_style
  write_bg "$name" "$bg"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    touch "$owned"
    bg=$name
    note_style
    return 0
  fi
  return "$rc"
}

# write_bg returns 2 when Style changed the background under us. Stop,
# instead of putting the radar back on the next tick.
handoff() {
  local rc=$1
  if [ "$rc" -eq 2 ]; then
    read_style
    case $bg in
      nws-conus-*.jpg) ;;
      *)
        remember_previous
        set_key enabled 0
        enabled=0
        rm -f "$owned"
        note_style
        write_status off style
        ;;
    esac
  fi
  nap 2
}

# 0 when the tile has touched the heartbeat within the last few minutes.
tile_here() {
  local now age
  [ -f "$beat" ] || return 1
  now=$(date +%s)
  age=$(stat -c%Y "$beat" 2>/dev/null || echo 0)
  [ $((now - age)) -le "$beat_max" ]
}

note_beat() {
  mkdir -p "$cache"
  touch "$beat"
}

# Put the previous wallpaper back and exit. Off and a quiet tile both end
# here, so this process does not stay behind polling.
leave() {
  local why=$1
  load_conf
  read_style
  screen_size
  frames_dir
  case $bg in
    nws-conus-*.jpg)
      log "leaving ($why), restoring"
      restore_previous
      ;;
  esac
  rm -f "$owned"
  case $why in
    style) write_status off style ;;
    off) write_status off "" ;;
    *) write_status off quiet ;;
  esac
  exit 0
}

# The download and the frame encode run in their own process group. Stop
# that group when this process exits, including when it is signalled.
stop_child() {
  local i
  if [ -z "$child_pid" ]; then
    return 0
  fi
  if kill -0 "$child_pid" 2>/dev/null; then
    kill -- "-$child_pid" 2>/dev/null || kill "$child_pid" 2>/dev/null || true
    i=0
    while [ "$i" -lt 10 ] && kill -0 "$child_pid" 2>/dev/null; do
      sleep 0.1
      i=$((i + 1))
    done
    if kill -0 "$child_pid" 2>/dev/null; then
      kill -9 -- "-$child_pid" 2>/dev/null || kill -9 "$child_pid" 2>/dev/null || true
    fi
    wait "$child_pid" 2>/dev/null || true
  fi
  child_pid=""
}

# Run a long command, and stop it when the tile goes quiet or the wallpaper
# is switched off. The first argument is a file for the command's output,
# or empty when the output is not needed.
run_while_wanted() {
  local rc m out pid
  out=$1
  shift
  if [ -n "$out" ]; then
    setsid "$@" >"$out" &
  else
    setsid "$@" &
  fi
  pid=$!
  child_pid=$pid
  rc=0
  while kill -0 "$pid" 2>/dev/null; do
    if ! tile_here; then
      stop_child
      leave quiet
    fi
    m=$(stat -c%Y "$conf" 2>/dev/null || echo 0)
    if [ "$m" != "$conf_mtime" ]; then
      load_conf
      if [ "$enabled" != "1" ]; then
        stop_child
        leave off
      fi
    fi
    sleep 1
  done
  wait "$pid" || rc=$?
  child_pid=""
  return "$rc"
}

start_daemon() {
  local cur started old
  cur=$(stat -c%Y "$0" 2>/dev/null || echo 0)
  if worker_alive; then
    started=$(cat "$cache/daemon.stamp" 2>/dev/null || echo missing)
    if [ "$started" = "$cur" ]; then
      return 0
    fi
    # A worker from the previous copy of this file will not watch the
    # heartbeat. Replace it with this copy.
    old=$(cat "$lockdir/pid" 2>/dev/null || true)
    case $old in
      ''|*[!0-9]*) ;;
      *)
        kill "$old" 2>/dev/null || true
        sleep 0.4
        if kill -0 "$old" 2>/dev/null; then
          kill -9 "$old" 2>/dev/null || true
          sleep 0.2
        fi
        ;;
    esac
    if worker_alive; then
      return 0
    fi
  fi
  if [ -f "$cache/log" ] && [ "$(stat -c%s "$cache/log" 2>/dev/null || echo 0)" -gt 200000 ]; then
    tail -c 40000 "$cache/log" >"$cache/log.trim" && mv "$cache/log.trim" "$cache/log"
  fi
  printf '%s\n' "$cur" >"$cache/daemon.stamp"
  # The script is not marked executable, so name the interpreter and start it.
  interp=bash; setsid "$interp" "$0" daemon >>"$cache/log" 2>&1 </dev/null &
  disown 2>/dev/null || true
}

cmd_beat() {
  note_beat
  load_conf
  if [ "$enabled" = "1" ]; then
    start_daemon
  fi
}

cmd_set() {
  local k=${1:-} v=${2:-}
  note_beat
  load_conf
  case $k in
    enabled)
      case $v in 0|1) ;; *) return 1 ;; esac
      set_key enabled "$v"
      ;;
    play)
      case $v in loop|still) ;; *) return 1 ;; esac
      set_key play "$v"
      set_key enabled 1
      ;;
    speed)
      case $v in slow|normal) ;; *) return 1 ;; esac
      set_key speed "$v"
      ;;
    reach)
      case $v in close|around|wide) ;; *) return 1 ;; esac
      set_key reach "$v"
      set_key view local
      set_key xpan here
      set_key ypan here
      ;;
    dim)
      case $v in ''|*[!0-9]*) return 1 ;; esac
      [ "$v" -gt 40 ] && v=40
      set_key dim "$v"
      ;;
    refresh)
      case $v in 0|15) ;; *) return 1 ;; esac
      set_key refresh "$v"
      ;;
    *)
      return 1
      ;;
  esac
  # Off must not start a worker. The one already running sees the config
  # change, puts the previous wallpaper back, and exits.
  if [ "$k" = "enabled" ] && [ "$v" = "0" ]; then
    return 0
  fi
  start_daemon
}

cmd_screen() {
  local w=${1:-} h=${2:-} cur
  case $w in ''|*[!0-9]*) return 1 ;; esac
  case $h in ''|*[!0-9]*) return 1 ;; esac
  [ "$w" -lt 200 ] || [ "$w" -gt 2000 ] && return 1
  [ "$h" -lt 200 ] || [ "$h" -gt 4000 ] && return 1
  cur=$(cat "$cache/screen" 2>/dev/null || true)
  if [ "$cur" != "$w $h" ]; then
    printf '%s %s\n' "$w" "$h" >"$cache/screen"
  fi
}

cmd_locate() {
  local la=${1:-} lo=${2:-}
  case $la in
    ''|*[!0-9.-]*) return 1 ;;
  esac
  case $lo in
    ''|*[!0-9.-]*) return 1 ;;
  esac
  # wttr.in answers Partridge, Kansas (about 37.97, -98.09) when it cannot
  # see the phone. That is not a location. Keep whatever we already have,
  # and do not store Kansas when we have nothing yet either.
  case $la in
    37.9[0-9]|38.0[0-9])
      case $lo in
        -98.[01]*) return 0 ;;
      esac
      ;;
  esac
  load_conf
  set_key lat "$la"
  set_key lon "$lo"
}

daemon_main() {
  if ! take_lock; then
    exit 0
  fi
  trap 'stop_child; release_lock' EXIT
  reap_old
  stat -c%Y "$0" >"$cache/daemon.stamp" 2>/dev/null || true
  load_conf
  log "daemon $$ step=$step hold=$hold refresh=$refresh"
  idx=0
  count=0
  show_frame=0
  next_fetch=0
  fail_until=0
  if ! tile_here; then
    leave quiet
  fi
  write_status fetching ""
  while true; do
    if ! tile_here; then
      leave quiet
    fi
    load_conf
    read_style
    screen_size
    theme_color
    frames_dir

    # A style.toml change we did not write is the Style menu.
    if ! style_is_ours; then
      case $bg in
        nws-conus-*.jpg)
          if [ "$enabled" != "1" ]; then
            set_key enabled 1
            enabled=1
            log "style picked radar, on"
          fi
          touch "$owned"
          note_style
          ;;
        *)
          remember_previous
          if [ "$enabled" != "0" ]; then
            set_key enabled 0
            enabled=0
            log "style picked $bg, off"
          fi
          rm -f "$owned"
          note_style
          leave style
          ;;
      esac
    fi

    if [ "$enabled" != "1" ]; then
      leave off
    fi
    touch "$owned"

    local_sector=$(cat "$cache/sector" 2>/dev/null || true)
    if [ -z "$local_sector" ] && [ -f "$gif" ] && [ "$(sector_name)" = "CONUS-LARGE" ]; then
      printf '%s\n' "CONUS-LARGE" >"$cache/sector"
      local_sector=CONUS-LARGE
    fi
    now=$(date +%s)
    # Updates off: keep playing the frames already saved.
    if [ "$refresh" != "0" ]; then
      if [ $((next_fetch - now)) -gt $((refresh * 60)) ]; then
        next_fetch=$now
      fi
      if [ "$local_sector" != "$(sector_name)" ] || [ "$now" -ge "$next_fetch" ]; then
        if ! tile_here; then
          leave quiet
        fi
        if [ "$local_sector" != "$(sector_name)" ]; then
          rm -f "$gif"
        fi
        if download; then
          printf '%s\n' "$(sector_name)" >"$cache/sector"
          next_fetch=$((now + refresh * 60))
        else
          next_fetch=$((now + 45))
          list_frames
          if [ "$count" -lt 1 ]; then
            write_status error download
            nap 5
            continue
          fi
        fi
      fi
    fi

    list_frames
    mark=$(current_mark)
    if [ "$(cat "$cache/stamp" 2>/dev/null || true)" != "$mark" ]; then
      if [ "$(cat "$cache/fail" 2>/dev/null || true)" = "$mark" ] && [ "$now" -lt "$fail_until" ]; then
        :
      elif publish; then
        rm -f "$cache/fail"
        list_frames
      else
        printf '%s\n' "$mark" >"$cache/fail"
        fail_until=$((now + 45))
        list_frames
        if [ "$count" -lt 1 ]; then
          write_status error frames
          nap 5
          continue
        fi
      fi
    fi

    if [ "$count" -lt 1 ]; then
      write_status error frames
      nap 5
      continue
    fi
    if [ "$idx" -ge "$count" ]; then idx=0; fi

    read_style
    case $bg in
      ''|nws-conus-*.jpg) ;;
      *) remember_previous ;;
    esac

    if ! tile_here; then
      leave quiet
    fi

    if [ "$play" = "still" ]; then
      show_frame_file "${frames[$((count - 1))]}" || { handoff "$?"; continue; }
      write_status paused ""
      nap 3
      continue
    fi

    show_frame_file "${frames[$idx]}" || { handoff "$?"; continue; }
    write_status playing ""
    if [ "$idx" -eq $((count - 1)) ]; then nap "$hold"; else nap "$step"; fi
    idx=$((idx + 1))
  done
}

case ${1:-ensure} in
  ensure|beat)
    cmd_beat
    ;;
  daemon)
    daemon_main
    ;;
  set)
    cmd_set "${2:-}" "${3:-}" || exit 1
    ;;
  screen)
    cmd_screen "${2:-}" "${3:-}" || exit 1
    ;;
  locate)
    cmd_locate "${2:-}" "${3:-}" || exit 1
    ;;
  status)
    if [ -f "$cache/status.json" ]; then
      cat "$cache/status.json"
    else
      printf '%s\n' '{"ok":false,"phase":"stopped"}'
    fi
    ;;
  *)
    printf '%s\n' "usage: nws-wallpaper [ensure|beat|status|set key value|screen w h|locate lat lon]" >&2
    exit 1
    ;;
esac
NWS_WP_SCRIPT_END
if ! cmp -s "$tmp" "$d/nws-wallpaper"; then
  mv -f "$tmp" "$d/nws-wallpaper"
else
  rm -f "$tmp"
fi
""")
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper beat || true")
  }
  every 60s {
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper beat || true")
  }
  when dw != null && dh != null {
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper screen ${int(dw)} ${int(dh)} || true")
  }
  on dw {
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper screen ${int(dw)} ${int(dh)} || true")
  }
  every 60s {
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper screen ${int(dw)} ${int(dh)} || true")
  }
  when lat != null && lon != null {
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper locate ${sh(fixed(lat, 2))} ${sh(fixed(lon, 2))} || true")
  }
  on lat {
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper locate ${sh(fixed(lat, 2))} ${sh(fixed(lon, 2))} || true")
  }
  every 60s {
    run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper locate ${sh(fixed(lat, 2))} ${sh(fixed(lon, 2))} || true")
  }

  component Pick(label, lit, field, choice) {
    Button {
      text: label
      color: lit ? accent : muted
      onTap: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set ${sh(field)} ${sh(choice)} || true")
    }
  }

  onTap: screen()

  Column {
    gap: 2
    Text { text: "radar wall"; style: muted; maxLines: 1 }
    Text { text: label; style: title; maxLines: 1 }
    Text { text: phase == "off" ? "tap for options" : reachLabel; style: small; color: muted; maxLines: 1 }
    Row {
      gap: 8
      if enabled != "1" || play == "still" {
        Button { text: enabled != "1" ? "on" : "play"; onTap: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set play loop || true") }
      } else {
        Button { text: "pause"; onTap: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set play still || true") }
      }
      if enabled == "1" {
        Button { text: "off"; color: muted; onTap: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set enabled 0 || true") }
      }
    }
  }

  screen {
    title: "radar wallpaper"
    Column {
      scroll: true
      gap: 12
      Text { text: "national weather service"; style: label; color: muted }
      Text { text: label; style: title }
      Text { text: "Live radar centered on you, playing behind the home screen."; style: small; color: muted }
      Row {
        gap: 8
        if enabled != "1" || play == "still" {
          Button { text: enabled != "1" ? "on" : "play"; onTap: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set play loop || true") }
        } else {
          Button { text: "pause"; onTap: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set play still || true") }
        }
        if enabled == "1" {
          Button { text: "off"; color: muted; onTap: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set enabled 0 || true") }
        }
      }

      Text { text: "how close"; style: label; color: muted }
      Text { text: "Closer is the storms nearby. Wider takes in the surrounding states."; style: small; color: muted }
      Flow {
        gap: 8
        Pick { label: "closer"; lit: reach == "close"; field: "reach"; choice: "close" }
        Pick { label: "around me"; lit: reach == "around"; field: "reach"; choice: "around" }
        Pick { label: "wider"; lit: reach == "wide"; field: "reach"; choice: "wide" }
      }

      Text { text: "speed"; style: label; color: muted }
      Text { text: "Normal moves about every 2 seconds."; style: small; color: muted }
      Flow {
        gap: 8
        Pick { label: "normal"; lit: speed == "normal"; field: "speed"; choice: "normal" }
        Pick { label: "slow"; lit: speed == "slow"; field: "speed"; choice: "slow" }
      }

      Text { text: "dim ${dim}%"; style: label; color: muted }
      Text { text: "Blends the map toward the theme color so the tiles stay readable."; style: small; color: muted }
      Slider { value: num(dim); min: 0; max: 40; step: 5; onChange: run("bash $HOME/.local/share/omalauncher/nws-wallpaper/nws-wallpaper set dim ${int(value)} || true") }

      Text { text: "update"; style: label; color: muted }
      Text { text: "A new loop about every 15 minutes. Off keeps the pictures already saved."; style: small; color: muted }
      Flow {
        gap: 8
        Pick { label: "every 15 min"; lit: refresh != "0"; field: "refresh"; choice: "15" }
        Pick { label: "off"; lit: refresh == "0"; field: "refresh"; choice: "0" }
      }
    }
  }
}
