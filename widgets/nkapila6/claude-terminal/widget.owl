widget "claude terminal" {
  size: 6x10
  minSize: 6x6
  padding: 0

  meta { owl: 6; description: "Live terminal tabs for Claude Code, Oh My Pi, a shell or your own agents. Run several side by side, open one full screen, edit the list in agents.conf"; version: "1.1"; license: "MIT"; category: "dev" }
  requires { pacman: ["micro"] }

  // Agents come from ~/.config/omalauncher/agents.conf ("name = command" lines), else the defaults
  // below. Tabs start as one per agent; + opens another (say, two Claude sessions), × closes the
  // current one, ⛶ opens the agent full screen and "edit" opens agents.conf. Every tab keeps running
  // while another is shown. Tap the terminal to type and drag to scroll.
  // Claude Code runs with its default renderer: its fullscreen one doesn't scroll by touch here.
  let defaults = [
    { name: "claude", cmd: "claude --settings '{\"tui\":\"default\"}'" },
    { name: "omp", cmd: "omp" },
    { name: "terminal", cmd: "bash" }
  ]
  let starter = """# Tabs of the claude terminal widget, one per line: name = command
claude = claude --settings '{"tui":"default"}'
omp = omp
terminal = bash
"""
  source conf = file("~/.config/omalauncher/agents.conf") optional
  let parsed = lines(conf ?? "").map(l => trim(l))
    .filter(l => l != "" && !startsWith(l, "#") && contains(l, "="))
    .map(l => { name: trim(split(l, "=")[0]), cmd: trim(join(split(l, "=").drop(1), "=")) })
  let agents = len(parsed) > 0 ? parsed : defaults

  state tabs = [] persist
  state nid = 100 persist
  state tab = 0 persist
  state picking = false

  let open = len(tabs) > 0 ? tabs : range(len(agents)).map(i => { id: i, agent: agents[i].name })
  let cur = open.find(t => t.id == tab)
  let curCmd = cur == null ? "bash" : (agents.find(a => a.name == cur.agent)).cmd ?? "bash"

  Column {
    gap: 0
    Row {
      gap: 4
      align: center
      padding: [10, 6]
      Flow {
        gap: 4
        weight: 1
        for t, i in open key t.id {
          let n = open.take(i + 1).count(x => x.agent == t.agent)
          let label = n > 1 ? "${t.agent} ${n}" : t.agent
          Text { text: label; width: len(label) * 9 + 18; style: label; bold: tab == t.id; color: tab == t.id ? accent : muted; onTap: { tab = t.id; picking = false } }
          if tab == t.id && len(open) > 1 {
            Text { text: "×"; width: 22; style: label; color: muted; onTap: { tabs = open.filter(x => x.id != t.id); tab = open.filter(x => x.id != t.id)[0].id } }
          }
        }
      }
      Text { text: "+"; width: 30; style: label; bold: picking; color: picking ? accent : muted; align: center; onTap: picking = !picking }
      Text { text: "⛶"; width: 30; style: label; color: muted; align: center; onTap: screen() }
      Text { text: "edit"; width: 44; style: label; bold: tab == -1; color: tab == -1 ? accent : muted; align: end; onTap: { tab = -1; picking = false } }
    }
    if picking {
      Flow {
        gap: 6
        padding: [10, 0, 10, 6]
        Text { text: "open another:"; width: 104; style: small; color: muted }
        for a in agents key a.name {
          Button { text: a.name; color: accent; onTap: { tabs = [open, [{ id: nid, agent: a.name }]].flatten(); tab = nid; nid = nid + 1; picking = false } }
        }
      }
    }
    Box {
      for t in open key t.id {
        Terminal { visible: tab == t.id; command: "bash -c ${sh((agents.find(a => a.name == t.agent)).cmd ?? "bash")}; exec bash" }
      }
      if tab == -1 {
        Terminal { command: "f=~/.config/omalauncher/agents.conf; [ -f \"$f\" ] || { mkdir -p ~/.config/omalauncher; printf %s ${sh(starter)} > \"$f\"; }; micro \"$f\"; clear; echo 'Saved. Pick a tab above.'; exec bash" }
      }
      if tab != -1 && cur == null {
        Text { text: "Pick a tab above, or add agents with edit."; style: small; color: muted; padding: 12 }
      }
    }
  }

  screen {
    title: cur == null ? "terminal" : cur.agent
    Terminal { command: "bash -c ${sh(curCmd)}; exec bash" }
  }
}
