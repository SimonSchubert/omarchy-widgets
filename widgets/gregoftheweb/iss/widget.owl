widget "ISS Tracker" {
  size: 6x3
  minSize: 5x2
  meta {
    description: "The next International Space Station passes you can actually see over any zip or postal code worldwide: when, how high it gets and which way to look"
    version: "1.3"; license: "MIT"; category: "world"; owl: 6
  }
  requires { pacman: ["python"] }

  state country = "US" persist
  state zip = "" persist
  source now = clock every 1s
  let script = """
    # The next visible ISS passes over a zip or postal code, as JSON. Pure Python: near-earth SGP4 (Vallado),
    # a low-precision sun, and a cache in ~/.cache/iss-tracker so the network is used
    # only for the zip lookup (once) and the orbit (when it is over 3 days old).
    import calendar, json, math, os, sys, time, urllib.parse, urllib.request

    KEEP, MIN_EL, MIN_SEEN, TLE_AGE, HORIZON = 4, 10.0, 60, 3 * 86400, 30 * 86400
    CACHE = os.path.expanduser('~/.cache/iss-tracker')
    TLE_URL = 'https://celestrak.org/NORAD/elements/gp.php?CATNR=25544&FORMAT=tle'
    TAU = 2 * math.pi
    RE, XKE, J2, J3, J4 = 6378.135, 60 / math.sqrt(6378.135 ** 3 / 398600.8), 0.001082616, -0.00000253881, -0.00000165597
    J3OJ2 = J3 / J2


    def fetch(url):
        req = urllib.request.Request(url, headers={'User-Agent': 'iss-tracker-widget'})
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.read().decode()


    def load(name, default):
        try:
            with open(os.path.join(CACHE, name)) as f:
                return json.load(f)
        except (OSError, ValueError):
            return default


    def save(name, data):
        with open(os.path.join(CACHE, name), 'w') as f:
            json.dump(data, f)


    class Sat:
        def __init__(self, l1, l2):
            yy = int(l1[18:20])
            doy = float(l1[20:32])
            year = 2000 + yy if yy < 57 else 1900 + yy
            self.epoch = calendar.timegm((year, 1, 1, 0, 0, 0)) + (doy - 1) * 86400
            b = l1[53:61]
            self.bstar = float(b[0] + '.' + b[1:6].strip()) * 10 ** int(b[6:8])
            r = math.radians
            self.incl, self.node, self.argp, self.mo = r(float(l2[8:16])), r(float(l2[17:25])), r(float(l2[34:42])), r(float(l2[43:51]))
            self.ecco = float('.' + l2[26:33])
            no_kozai = float(l2[52:63]) * TAU / 1440
            e, i = self.ecco, self.incl
            x2o3 = 2 / 3
            ss, qzms2t = 78 / RE + 1, ((120 - 78) / RE) ** 4
            eccsq = e * e
            omeosq = 1 - eccsq
            rteosq = math.sqrt(omeosq)
            cosio = math.cos(i)
            cosio2 = cosio * cosio
            ak = (XKE / no_kozai) ** x2o3
            d1 = 0.75 * J2 * (3 * cosio2 - 1) / (rteosq * omeosq)
            dl = d1 / (ak * ak)
            adel = ak * (1 - dl * dl - dl * (1 / 3 + 134 * dl * dl / 81))
            dl = d1 / (adel * adel)
            no = self.no = no_kozai / (1 + dl)
            ao = (XKE / no) ** x2o3
            sinio = math.sin(i)
            po = ao * omeosq
            con42 = 1 - 5 * cosio2
            self.con41 = con41 = -con42 - cosio2 - cosio2
            posq = po * po
            rp = ao * (1 - e)
            self.isimp = rp < 220 / RE + 1
            sfour, qzms24 = ss, qzms2t
            perige = (rp - 1) * RE
            if perige < 156:
                sfour = perige - 78 if perige >= 98 else 20
                qzms24 = ((120 - sfour) / RE) ** 4
                sfour = sfour / RE + 1
            pinvsq = 1 / posq
            tsi = 1 / (ao - sfour)
            self.eta = eta = ao * e * tsi
            etasq = eta * eta
            eeta = e * eta
            psisq = abs(1 - etasq)
            coef = qzms24 * tsi ** 4
            coef1 = coef / psisq ** 3.5
            cc2 = coef1 * no * (ao * (1 + 1.5 * etasq + eeta * (4 + etasq)) + 0.375 * J2 * tsi / psisq * con41 * (8 + 3 * etasq * (8 + etasq)))
            self.cc1 = cc1 = self.bstar * cc2
            cc3 = -2 * coef * tsi * J3OJ2 * no * sinio / e if e > 1e-4 else 0
            self.x1mth2 = x1mth2 = 1 - cosio2
            self.cc4 = 2 * no * coef1 * ao * omeosq * (eta * (2 + 0.5 * etasq) + e * (0.5 + 2 * etasq) - J2 * tsi / (ao * psisq) * (
                -3 * con41 * (1 - 2 * eeta + etasq * (1.5 - 0.5 * eeta)) + 0.75 * x1mth2 * (2 * etasq - eeta * (1 + etasq)) * math.cos(2 * self.argp)))
            self.cc5 = 2 * coef1 * ao * omeosq * (1 + 2.75 * (etasq + eeta) + eeta * etasq)
            cosio4 = cosio2 * cosio2
            temp1 = 1.5 * J2 * pinvsq * no
            temp2 = 0.5 * temp1 * J2 * pinvsq
            temp3 = -0.46875 * J4 * pinvsq * pinvsq * no
            self.mdot = no + 0.5 * temp1 * rteosq * con41 + 0.0625 * temp2 * rteosq * (13 - 78 * cosio2 + 137 * cosio4)
            self.argpdot = -0.5 * temp1 * con42 + 0.0625 * temp2 * (7 - 114 * cosio2 + 395 * cosio4) + temp3 * (3 - 36 * cosio2 + 49 * cosio4)
            xhdot1 = -temp1 * cosio
            self.nodedot = xhdot1 + (0.5 * temp2 * (4 - 19 * cosio2) + 2 * temp3 * (3 - 7 * cosio2)) * cosio
            self.omgcof = self.bstar * cc3 * math.cos(self.argp)
            self.xmcof = -x2o3 * coef * self.bstar / eeta if e > 1e-4 else 0
            self.nodecf = 3.5 * omeosq * xhdot1 * cc1
            self.t2cof = 1.5 * cc1
            self.xlcof = -0.25 * J3OJ2 * sinio * (3 + 5 * cosio) / max(1 + cosio, 1.5e-12)
            self.aycof = -0.5 * J3OJ2 * sinio
            self.delmo = (1 + eta * math.cos(self.mo)) ** 3
            self.sinmao = math.sin(self.mo)
            self.x7thm1 = 7 * cosio2 - 1
            if not self.isimp:
                cc1sq = cc1 * cc1
                self.d2 = d2 = 4 * ao * tsi * cc1sq
                temp = d2 * tsi * cc1 / 3
                self.d3 = d3 = (17 * ao + sfour) * temp
                self.d4 = d4 = 0.5 * temp * ao * tsi * (221 * ao + 31 * sfour) * cc1
                self.t3cof = d2 + 2 * cc1sq
                self.t4cof = 0.25 * (3 * d3 + cc1 * (12 * d2 + 10 * cc1sq))
                self.t5cof = 0.2 * (3 * d4 + 12 * cc1 * d3 + 6 * d2 * d2 + 15 * cc1sq * (2 * d2 + cc1sq))

        def pos(self, unix):
            # TEME position in km at a Unix time
            t = (unix - self.epoch) / 60
            xmdf = self.mo + self.mdot * t
            argpdf = self.argp + self.argpdot * t
            nodedf = self.node + self.nodedot * t
            argpm, mm = argpdf, xmdf
            t2 = t * t
            nodem = nodedf + self.nodecf * t2
            tempa = 1 - self.cc1 * t
            tempe = self.bstar * self.cc4 * t
            templ = self.t2cof * t2
            if not self.isimp:
                delomg = self.omgcof * t
                delm = self.xmcof * ((1 + self.eta * math.cos(xmdf)) ** 3 - self.delmo)
                mm = xmdf + delomg + delm
                argpm = argpdf - delomg - delm
                t3 = t2 * t
                t4 = t3 * t
                tempa -= self.d2 * t2 + self.d3 * t3 + self.d4 * t4
                tempe += self.bstar * self.cc5 * (math.sin(mm) - self.sinmao)
                templ += self.t3cof * t3 + t4 * (self.t4cof + t * self.t5cof)
            am = (XKE / self.no) ** (2 / 3) * tempa * tempa
            em = max(self.ecco - tempe, 1e-6)
            mm += self.no * templ
            xlm = (mm + argpm + nodem) % TAU
            nodem %= TAU
            argpm %= TAU
            mm = (xlm - argpm - nodem) % TAU
            axnl = em * math.cos(argpm)
            temp = 1 / (am * (1 - em * em))
            aynl = em * math.sin(argpm) + temp * self.aycof
            xl = mm + argpm + nodem + temp * self.xlcof * axnl
            u = (xl - nodem) % TAU
            eo1, tem5, ktr = u, 9999.0, 1
            while abs(tem5) >= 1e-12 and ktr <= 10:
                sineo1, coseo1 = math.sin(eo1), math.cos(eo1)
                tem5 = (u - aynl * coseo1 + axnl * sineo1 - eo1) / (1 - coseo1 * axnl - sineo1 * aynl)
                tem5 = max(-0.95, min(0.95, tem5))
                eo1 += tem5
                ktr += 1
            ecose = axnl * coseo1 + aynl * sineo1
            esine = axnl * sineo1 - aynl * coseo1
            el2 = axnl * axnl + aynl * aynl
            pl = am * (1 - el2)
            rl = am * (1 - ecose)
            betal = math.sqrt(1 - el2)
            temp = esine / (1 + betal)
            sinu = am / rl * (sineo1 - aynl - axnl * temp)
            cosu = am / rl * (coseo1 - axnl + aynl * temp)
            su = math.atan2(sinu, cosu)
            sin2u = 2 * cosu * sinu
            cos2u = 1 - 2 * sinu * sinu
            temp1 = 0.5 * J2 / pl
            temp2 = temp1 / pl
            mrt = rl * (1 - 1.5 * temp2 * betal * self.con41) + 0.5 * temp1 * self.x1mth2 * cos2u
            su -= 0.25 * temp2 * self.x7thm1 * sin2u
            xnode = nodem + 1.5 * temp2 * math.cos(self.incl) * sin2u
            xinc = self.incl + 1.5 * temp2 * math.cos(self.incl) * math.sin(self.incl) * cos2u
            sinsu, cossu = math.sin(su), math.cos(su)
            snod, cnod = math.sin(xnode), math.cos(xnode)
            sini, cosi = math.sin(xinc), math.cos(xinc)
            ux = -snod * cosi * sinsu + cnod * cossu
            uy = cnod * cosi * sinsu + snod * cossu
            uz = sini * sinsu
            return (mrt * RE * ux, mrt * RE * uy, mrt * RE * uz)


    def gmst(unix):
        d = unix / 86400 + 2440587.5 - 2451545
        tc = d / 36525
        return math.radians((280.46061837 + 360.98564736629 * d + 0.000387933 * tc * tc) % 360)


    def to_earth(v, unix):
        g = gmst(unix)
        return (v[0] * math.cos(g) + v[1] * math.sin(g), -v[0] * math.sin(g) + v[1] * math.cos(g), v[2])


    def sun(unix):
        # unit vector to the sun, in the same inertial frame as the satellite
        d = unix / 86400 + 2440587.5 - 2451545
        g = math.radians(357.528 + 0.9856003 * d)
        lam = math.radians(280.460 + 0.9856474 * d + 1.915 * math.sin(g) + 0.020 * math.sin(2 * g))
        eps = math.radians(23.439 - 0.0000004 * d)
        return (math.cos(lam), math.cos(eps) * math.sin(lam), math.sin(eps) * math.sin(lam))


    class Observer:
        def __init__(self, lat, lon):
            self.p, self.l = math.radians(lat), math.radians(lon)
            f = 1 / 298.257223563
            e2 = f * (2 - f)
            n = 6378.137 / math.sqrt(1 - e2 * math.sin(self.p) ** 2)
            self.xyz = (n * math.cos(self.p) * math.cos(self.l), n * math.cos(self.p) * math.sin(self.l), n * (1 - e2) * math.sin(self.p))
            self.up = (math.cos(self.p) * math.cos(self.l), math.cos(self.p) * math.sin(self.l), math.sin(self.p))

        def look(self, earth):
            dx, dy, dz = (earth[k] - self.xyz[k] for k in range(3))
            sp, cp, sl, cl = math.sin(self.p), math.cos(self.p), math.sin(self.l), math.cos(self.l)
            e = -sl * dx + cl * dy
            n = -sp * cl * dx - sp * sl * dy + cp * dz
            u = cp * cl * dx + cp * sl * dy + sp * dz
            return math.degrees(math.atan2(u, math.hypot(e, n))), math.degrees(math.atan2(e, n)) % 360


    def compass(az):
        return ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'][int((az + 22.5) % 360 // 45)]


    def find_passes(sat, obs, start, end, count):
        # Passes you can see: the station above MIN_EL, in sunlight, against a sky
        # with the sun at least 6 degrees down. Only the visible part is reported,
        # since the ISS often fades into earth's shadow (or out of it) mid-sky.
        look = lambda t: obs.look(to_earth(sat.pos(t), t))
        sun_el = lambda t: math.degrees(math.asin(sum(to_earth(sun(t), t)[k] * obs.up[k] for k in range(3))))

        def lit(t):
            r, s = sat.pos(t), sun(t)
            dot = sum(r[k] * s[k] for k in range(3))
            return dot > 0 or math.dist(r, tuple(dot * s[k] for k in range(3))) > 6371

        out, t = [], start
        while len(out) < count and t < end:
            if sun_el(t) > -4:
                t += 300  # daylight: skip ahead (the sun moves under 1.5 degrees in 5 minutes)
                continue
            if look(t)[0] < MIN_EL:
                t += 30
                continue
            rise = t
            while look(rise - 5)[0] >= MIN_EL and rise > t - 900:
                rise -= 5
            seen, tt = [], rise
            while True:
                el, az = look(tt)
                if el < MIN_EL:
                    break
                if sun_el(tt) < -6 and lit(tt):
                    seen.append((tt, el, az))
                tt += 5
            if seen and seen[-1][0] - seen[0][0] >= MIN_SEEN:
                a, b = seen[0], seen[-1]
                out.append({'rise': int(a[0]), 'set': int(b[0]), 'maxAlt': round(max(p[1] for p in seen)),
                            'from': compass(a[2]), 'to': compass(b[2]), 'startAlt': round(a[1]), 'endAlt': round(b[1]),
                            'appears': a[0] > rise + 5, 'fades': b[0] < tt - 10})
            t = tt + 30
        return out, t


    def squash(s):
        return ''.join(ch for ch in s.upper() if ch.isalnum())


    def zippopotam(cc, code):
        p = json.loads(fetch('https://api.zippopotam.us/' + cc.lower() + '/' + urllib.parse.quote(code)))['places'][0]
        region = p.get('state abbreviation') if cc in ('US', 'CA', 'AU') else ''
        return {'lat': float(p['latitude']), 'lon': float(p['longitude']), 'place': p['place name'] + ', ' + (region or cc)}


    def nominatim(cc, **query):
        query.update(format='json', limit=1, addressdetails=1, countrycodes=cc.lower())
        hit = json.loads(fetch('https://nominatim.openstreetmap.org/search?' + urllib.parse.urlencode(query)))[0]
        a = hit.get('address', {})
        code = query.get('q', '')
        if any(ch.isdigit() for ch in code):
            # a free-text hit for something code-like must really be that postal code
            got, want = squash(a.get('postcode', '')), squash(code)
            if not got or not (got.startswith(want) or want.startswith(got)):
                raise LookupError(code)
        name = next((a[k] for k in ('city', 'town', 'village', 'hamlet', 'suburb', 'municipality', 'county', 'state') if k in a), hit['display_name'].split(',')[0])
        return {'lat': float(hit['lat']), 'lon': float(hit['lon']), 'place': name + ', ' + cc}


    def locate(cc, code):
        # Zippopotam knows ~60 countries' postal codes; OpenStreetMap's Nominatim covers the
        # rest (and town names); some countries only list the first part (UK, Canada, NL).
        tries = [lambda: zippopotam(cc, code),
                 lambda: nominatim(cc, postalcode=code),
                 lambda: nominatim(cc, q=code)]
        head = code.split()[0] if ' ' in code else code[:3] if cc == 'CA' else ''
        if head and head != code:
            tries.append(lambda: zippopotam(cc, head))
        for attempt in tries:
            try:
                return attempt()
            except Exception:
                pass
        return None


    def main(cc, code):
        cc, code = cc.strip().upper() or 'US', ' '.join(code.split())
        cc = {'USA': 'US', 'UK': 'GB'}.get(cc, cc)
        if len(cc) != 2 or not cc.isalpha():
            return {'error': 'country: use a 2-letter code like US, GB, DE'}
        if not 1 < len(code) <= 40:
            return {'error': 'enter a zip or postal code'}
        os.makedirs(CACHE, exist_ok=True)
        key = cc + '-' + squash(code)
        loc = load('loc-' + key + '.json', None)
        if loc is None:
            loc = locate(cc, code)
            if loc is None:
                return {'error': code + ' not found in ' + cc + ' (or offline)'}
            save('loc-' + key + '.json', loc)
        now = time.time()
        tle_path = os.path.join(CACHE, 'iss.tle')
        if not os.path.exists(tle_path) or now - os.path.getmtime(tle_path) > TLE_AGE:
            try:
                text = fetch(TLE_URL)
                if '25544' in text:
                    with open(tle_path, 'w') as f:
                        f.write(text)
            except Exception:
                pass
        try:
            with open(tle_path) as f:
                lines = f.read().strip().splitlines()
        except OSError:
            return {'error': 'offline: no orbit data yet', 'place': loc['place']}
        # cached passes are good until a newer orbit arrives; 'until' is how far we've searched
        cache = load('visible-' + key + '.json', {})
        if cache.get('tle') != lines[1]:
            cache = {'tle': lines[1], 'until': now, 'passes': []}
        passes = [p for p in cache['passes'] if p['set'] > now]
        if len(passes) < KEEP and cache['until'] < now + HORIZON:
            more, until = find_passes(Sat(lines[1], lines[2]), Observer(loc['lat'], loc['lon']),
                                      max(now, cache['until']), now + HORIZON, KEEP - len(passes))
            passes += more
            cache.update(until=until, passes=passes)
            save('visible-' + key + '.json', cache)
        return {'country': cc, 'code': code, 'place': loc['place'], 'passes': passes}


    print(json.dumps(main(sys.argv[-2], sys.argv[-1])))
  """

  // The orbit math runs here (SGP4, plain Python). The next four visible passes
  // (up to 30 days out) are kept in ~/.cache/iss-tracker; the network is used only
  // for the zip lookup (once) and the ISS orbit from CelesTrak (every 3 days).
  source iss = cmd("python3 -c 'import sys,textwrap;exec(textwrap.dedent(sys.argv[1]))' ${sh(script)} ${sh(country)} ${sh(zip)}") every 10m json timeout 60s
  on zip { refresh() }
  on country { refresh() }
  let passes = (iss.passes ?? []).filter(p => p.set > now)
  let next = first(passes)
  let up = next != null && next.rise <= now
  // A tile taller than wide (the landscape home screen) is too narrow for one-line
  // pass rows: each pass takes two lines and the countdown gets its own line.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3

  // Square-cut pixel lettering; a/b/c bands give it a chrome gradient.
  let titleArt = """
    a.aaaaa.aaaaa.....aaaaa.aaaa..aaaaa.aaaaa.a...a.aaaaa.aaaa.
    a.a.....a...........a...a...a.a...a.a.....a..a..a.....a...a
    a.a.....a...........a...a...a.a...a.a.....a.a...a.....a...a
    b.bbbbb.bbbbb.......b...bbbbb.bbbbb.b.....bb....bbbb..bbbbb
    b.....b.....b.......b...b..b..b...b.b.....b.b...b.....b..b.
    c.....c.....c.......c...c...c.c...c.c.....c..c..c.....c...c
    c.ccccc.ccccc.......c...c...c.c...c.ccccc.c...c.ccccc.c...c
  """
  // Solar wings (p/q), truss (t), radiators (r), modules (m), beacon (w).
  let stationArt = """
    qpq.qpq....................pqp.pqp
    pqp.pqp....................qpq.qpq
    qpq.qpq.........mmm........pqp.pqp
    pqp.pqp....rr.mmmmmmm.rr...qpq.qpq
    .t...t.....rr.mmmmmmm.rr....t...t.
    ttttttttttttttmmmwmmmtttttttttttttt
    .t...t.....rr.mmmmmmm.rr....t...t.
    pqp.pqp....rr.mmmmmmm.rr...qpq.qpq
    qpq.qpq.........mmm........pqp.pqp
    pqp.pqp....................qpq.qpq
    qpq.qpq....................pqp.pqp
  """
  let stars = range(28).map(i => [(i * 97 + 13) % 1000 / 1000, (i * 61 + 7) % 100 / 100, i % 3])

  onTap: screen()

  component PassRow(p) {
    if tall {
      Column {
        gap: 0
        Row {
          Text { text: fmtTime(p.rise, "EEE M/d h:mm a"); weight: 1; maxLines: 1 }
          Text { text: "${p.maxAlt}°"; width: 40; align: end; color: p.maxAlt >= 40 ? accent : foreground }
        }
        Row {
          Text { text: "${p.from} → ${p.to}"; weight: 1; style: small; color: muted }
          Text { text: "${round((p.set - p.rise) / 60)} min"; width: 56; style: small; color: green; align: end }
        }
      }
    } else {
      Row {
        Text { text: fmtTime(p.rise, "EEE M/d h:mm a"); width: 160 }
        Text { text: "${p.maxAlt}°"; width: 40; color: p.maxAlt >= 40 ? accent : foreground }
        Text { text: "${p.from} → ${p.to}"; weight: 1; style: small; color: muted }
        Text { text: "${round((p.set - p.rise) / 60)} min"; width: 56; style: small; color: green; align: end }
      }
    }
  }

  Column {
    Canvas {
      height: 26
      fill: width
      sprite(titleArt, 1.5, 3.5, 3, palette: {a: alpha(blue, 0.35), b: alpha(blue, 0.35), c: alpha(blue, 0.35)})
      sprite(titleArt, 0, 2, 3, palette: {a: bright_cyan, b: cyan, c: blue})
      line(184, 12, width, 12, stroke: alpha(cyan, 0.35), width: 1)
      line(184, 16, width - 24, 16, stroke: alpha(cyan, 0.2), width: 1)
    }
    if zip == "" {
      Row {
        Input { text: country; placeholder: "US"; width: 52; onSubmit: country = upper(trim(value)) }
        Input { placeholder: "your zip / postal code"; weight: 1; onSubmit: zip = trim(value) }
      }
      Text { text: "2-letter country (US, GB, DE…), then the code"; style: small; color: muted }
    } else {
      if tall {
        Text { text: "over ${iss.place ?? zip}"; style: muted; maxLines: 1 }
        if up || next != null {
          Text { text: up ? "look up now!" : "in ${fmtDuration(next.rise - now)}"; color: up ? green : accent; bold: true }
        }
      } else {
        Row {
          Text { text: "over ${iss.place ?? zip}"; style: muted; weight: 1; maxLines: 1 }
          Text { text: up ? "look up now!" : next == null ? "" : "in ${fmtDuration(next.rise - now)}"
                 width: 140; align: end; color: up ? green : accent; bold: true }
        }
      }
      if iss.error != null { Text { text: iss.error; style: small; color: red } }
      if iss.error == null && iss.passes != null && len(passes) == 0 {
        Text { text: "no visible passes in the next 30 days"; style: small; color: muted }
      }
      for p in passes.take((rows ?? 3) >= 3 ? 4 : 2) key p.rise { PassRow { p: p } }
    }
    Spacer { weight: 1 }
    if (rows ?? 3) >= 3 {
      Canvas {
        height: 36
        fill: width
        for s in stars {
          circle(s[0] * width, s[1] * height, s[2] == 0 ? 1 : 0.6, color: alpha(foreground, s[2] == 0 ? 0.6 : 0.3))
        }
        line(0, height / 2, width, height / 2, stroke: alpha(muted, 0.25), width: 1)
        // steps on the 1 s clock: the frame clock would redraw the tile every frame
        let x = ((now ?? 0) * 14 + width / 2) % (width + 100) - 90
        sprite(stationArt, x, height / 2 - 14, 2.5, palette: {
          p: blue, q: alpha(blue, 0.7), t: muted, r: foreground, m: color15,
          w: (now ?? 0) % 2 == 0 ? red : color15
        })
      }
    }
  }

  screen {
    title: "visible iss passes"
    Column {
      gap: 12
      for p in passes key p.rise {
        Column {
          gap: 0
          Text { text: fmtTime(p.rise, "EEEE, MMM d · h:mm a"); style: title }
          Text { text: "visible ${fmtDuration(p.set - p.rise)} · up to ${p.maxAlt}° high"; style: small }
          Text { text: (p.appears ? "appears at ${p.startAlt}° in the ${p.from}" : "rises in the ${p.from}")
                       + (p.fades ? ", fades at ${p.endAlt}° in the ${p.to}" : ", sets in the ${p.to}")
                 style: small; color: green }
        }
      }
      Text { text: "country · zip or postal code"; style: label }
      Row {
        Input { text: country; placeholder: "US"; width: 60; onSubmit: country = upper(trim(value)) }
        Input { text: zip; placeholder: "zip / postal code"; weight: 1; onSubmit: zip = trim(value) }
      }
      Text { text: "2-letter country code: US, GB, CA, DE, FR, JP, AU, IN…"; style: small; color: muted }
      Button { text: "close"; onTap: close() }
    }
  }
}
