widget "Snow Fall Kronikall" {
  page: 2
  size: 8x1
  minSize: 4x1
  padding: 0
  meta {
    owl: 12
    id: "com.columbiafoundry.snowfallkronikall"
    description: "60 days of snow depth at a ski area you pick, rising over a tree line to a snow stake. Measured by USDA SNOTEL stations in the US, modelled by Open-Meteo anywhere else."
    version: "0.8.0"
    license: "MIT"
    category: "sport"
  }

  // network: at most one data fetch every 3 hours, for the chosen ski area only. The clock only works out
  // the dates, which needs no network
  source now = clock every 1h
  source modes = android.modes

  // the ski area: picked from the list on the screen, or found by name. elev is where on the mountain
  // the model is read, since a searched town sits at the base
  state place = {name: "Whistler", lat: 50.0596, lon: -122.9566, elev: 1850, cc: "CA", tz: "America/Vancouver"} persist
  state model = false persist      // true: Open-Meteo even where a SNOTEL station is near
  state metric = false persist
  state query = ""

  let resorts = [
    {name: "Whistler", lat: 50.0596, lon: -122.9566, elev: 1850, cc: "CA", tz: "America/Vancouver"},
    {name: "Revelstoke", lat: 50.9580, lon: -118.1630, elev: 1900, cc: "CA", tz: "America/Vancouver"},
    {name: "Banff Sunshine", lat: 51.0780, lon: -115.7800, elev: 2200, cc: "CA", tz: "America/Edmonton"},
    {name: "Mt Baker", lat: 48.8570, lon: -121.6650, elev: 1500, cc: "US", tz: "America/Los_Angeles"},
    {name: "Crystal Mountain", lat: 46.9282, lon: -121.5045, elev: 1900, cc: "US", tz: "America/Los_Angeles"},
    {name: "Snoqualmie Pass", lat: 47.4235, lon: -121.4135, elev: 1100, cc: "US", tz: "America/Los_Angeles"},
    {name: "Palisades Tahoe", lat: 39.1968, lon: -120.2354, elev: 2400, cc: "US", tz: "America/Los_Angeles"},
    {name: "Mammoth", lat: 37.6308, lon: -119.0326, elev: 2900, cc: "US", tz: "America/Los_Angeles"},
    {name: "Alta", lat: 40.5884, lon: -111.6386, elev: 2900, cc: "US", tz: "America/Denver"},
    {name: "Park City", lat: 40.6514, lon: -111.5080, elev: 2600, cc: "US", tz: "America/Denver"},
    {name: "Jackson Hole", lat: 43.5875, lon: -110.8279, elev: 2700, cc: "US", tz: "America/Denver"},
    {name: "Big Sky", lat: 45.2857, lon: -111.4012, elev: 2700, cc: "US", tz: "America/Denver"},
    {name: "Sun Valley", lat: 43.6710, lon: -114.3640, elev: 2400, cc: "US", tz: "America/Boise"},
    {name: "Lookout Pass", lat: 47.4560, lon: -115.6970, elev: 1550, cc: "US", tz: "America/Los_Angeles"},
    {name: "Whitefish", lat: 48.4864, lon: -114.3560, elev: 1800, cc: "US", tz: "America/Denver"},
    {name: "Montana Snowbowl", lat: 47.0140, lon: -114.0020, elev: 1900, cc: "US", tz: "America/Denver"},
    {name: "Lost Trail", lat: 45.6930, lon: -113.9500, elev: 2200, cc: "US", tz: "America/Denver"},
    {name: "Vail", lat: 39.6061, lon: -106.3550, elev: 3100, cc: "US", tz: "America/Denver"},
    {name: "Breckenridge", lat: 39.4817, lon: -106.0670, elev: 3300, cc: "US", tz: "America/Denver"},
    {name: "Steamboat", lat: 40.4572, lon: -106.8045, elev: 2800, cc: "US", tz: "America/Denver"},
    {name: "Telluride", lat: 37.9375, lon: -107.8123, elev: 3300, cc: "US", tz: "America/Denver"},
    {name: "Taos", lat: 36.5960, lon: -105.4545, elev: 3200, cc: "US", tz: "America/Denver"},
    {name: "Stowe", lat: 44.5303, lon: -72.7814, elev: 1100, cc: "US", tz: "America/New_York"},
    {name: "Chamonix", lat: 45.9570, lon: 6.9900, elev: 2300, cc: "FR", tz: "Europe/Paris"},
    {name: "Val d'Isère", lat: 45.4500, lon: 6.9800, elev: 2400, cc: "FR", tz: "Europe/Paris"},
    {name: "Zermatt", lat: 45.9800, lon: 7.7300, elev: 2600, cc: "CH", tz: "Europe/Zurich"},
    {name: "St Anton", lat: 47.1400, lon: 10.2400, elev: 2200, cc: "AT", tz: "Europe/Vienna"},
    {name: "Niseko", lat: 42.8600, lon: 140.6800, elev: 900, cc: "JP", tz: "Asia/Tokyo"},
    {name: "Hakuba", lat: 36.7000, lon: 137.8300, elev: 1200, cc: "JP", tz: "Asia/Tokyo"},
    {name: "Thredbo", lat: -36.5000, lon: 148.2900, elev: 1800, cc: "AU", tz: "Australia/Sydney"},
    {name: "Cardrona", lat: -44.8700, lon: 168.9500, elev: 1700, cc: "NZ", tz: "Pacific/Auckland"},
    {name: "Portillo", lat: -32.8400, lon: -70.1300, elev: 2900, cc: "CL", tz: "America/Santiago"}
  ]

  // any other place, by name, from Open-Meteo's geocoder
  source found = http(len(query) > 1 ? "https://geocoding-api.open-meteo.com/v1/search?name=${enc(query)}&count=8" : null) timeout 10s json

  // The clearing houses: SNOTEL, USDA's snow stations, measure depth at ~900 sites in the western US and
  // a few in the east; Open-Meteo models it anywhere on Earth for a given height
  let api = "https://wcc.sc.egov.usda.gov/awdbRestApi/services/v1"
  // the list of SNOTEL stations, only for a US ski area, to find the one nearest it; once a week
  source stations = http(place.cc == "US" ? "${api}/stations?stationTriplets=*:*:SNTL&activeOnly=true&returnForecastPointMetadata=false&returnReservoirMetadata=false&returnStationElements=false" : null) every 168h timeout 30s json
  let near = (stations ?? [])
    .map(s => {s: s, km: sqrt(pow((s.latitude - place.lat) * 111, 2) + pow((s.longitude - place.lon) * 111 * cos(rad(place.lat)), 2))})
    .filter(x => x.km < 15 && abs(x.s.elevation * 0.3048 - place.elev) < 700)
    .sortBy(x => x.km)
  let station = place.cc == "US" && !model ? near[0] : null

  let asOf = now
  let days = range(60).map(i => fmtTime(asOf - (59 - i) * 86400, "yyyy-MM-dd", place.tz))
  source measured = http(station == null ? null : "${api}/data?stationTriplets=${enc(station.s.stationTriplet)}&elements=SNWD&duration=DAILY&beginDate=${enc(days[0])}&endDate=${enc(days[59])}") every 3h timeout 20s json
  // the model only where no station serves, or when the station's answer has too few days
  let stationBad = measured != null && len(keys(groupBy(measured[0].data[0].values ?? [], v => v.date))) <= 10
  source modelled = http(station != null && !stationBad ? null : "https://api.open-meteo.com/v1/forecast?latitude=${enc(str(place.lat))}&longitude=${enc(str(place.lon))}&elevation=${enc(str(place.elev))}&daily=snow_depth_max&past_days=59&forecast_days=1&timezone=auto") every 3h timeout 15s json

  let byDate = groupBy(measured[0].data[0].values ?? [], v => v.date)
  let usingStation = station != null && len(keys(byDate)) > 10
  // inches per day, oldest first; a day without a reading keeps the one before
  let raw = usingStation
    ? days.map(d => get(byDate, d, [])[0].value)
    : (modelled.daily.snow_depth_max ?? []).take(60).map(m => m == null ? null : m * 39.37)
  let depths = scan(raw, (last, v) => v ?? last, 0)
  let depth = last(depths)
  let ready = len(depths) > 0
  let unit = metric ? "cm" : "\""
  let show = round(metric ? depth * 2.54 : depth)
  // how much ground the tile shows: the season's deepest so far fills about two thirds of it
  let top = max(metric ? 24 / 2.54 : 24, max(depths) * 1.45)
  let step = metric
    ? (top * 2.54 <= 80 ? 10 : top * 2.54 <= 200 ? 25 : 50) / 2.54
    : (top <= 36 ? 6 : top <= 96 ? 12 : 24)
  let fresh = len(depths) > 1 ? depth - depths[len(depths) - 2] : 0

  onTap: screen()

  Box {
  // the still scene, drawn again only when the data changes
  Canvas {
    let H = height
    let W = width
    let stakeX = W - 22
    // sky, then tree tops, then the snow over their feet
    rect(0, 0, W, H, fill: linear(0, 0, 0, H, [mix(background, blue, 0.18), background]), radius: 8 * corners)
    for i in range(int(W / 26) + 2) {
      let x = i * 26 + hash(i) * 18 - 6
      let tall = H * (0.3 + hash(i, 1) * 0.45)
      let w = 8 + hash(i, 2) * 6
      let tone = mix(green, background, 0.35 + hash(i, 3) * 0.3)
      for k in range(4) {
        let ty = H - tall + k * tall * 0.22
        path([[x, ty], [x - w * (0.35 + k * 0.22), ty + tall * 0.34], [x + w * (0.35 + k * 0.22), ty + tall * 0.34]], closed: true, fill: tone)
      }
      // a dusting on the top tier once there's been snow
      if depth > 0 {
        path([[x, H - tall], [x - w * 0.17, H - tall + tall * 0.12], [x + w * 0.17, H - tall + tall * 0.12]], closed: true, fill: alpha(#f2f6ff, 0.85))
      }
    }
    if ready {
      let n = len(depths)
      let pts = depths.map((d, i) => [i / (n - 1) * stakeX, H - d / top * H])
      path(flatten([[[0, H]], pts, [[W, H - depth / top * H], [W, H]]]), closed: true, fill: linear(0, H - max(depths) / top * H, 0, H, [#f7faff, #c9d6ea]))
      path(pts, stroke: #ffffff, width: 1.5)
      // the first of each month, faintly
      for i in range(n) {
        if sub(days[i], 8, 10) == "01" {
          line(i / (n - 1) * stakeX, H - 12, i / (n - 1) * stakeX, H, stroke: alpha(muted, 0.6), width: 1)
          text(fmtTime(parseTime(days[i]), "MMM"), i / (n - 1) * stakeX + 3, H - 6, size: 8, align: start, color: mix(muted, background, 0.2))
        }
      }
    }
    // the snow stake at today, banded and marked
    rect(stakeX - 2, 0, 4, H, fill: #f4f4f4)
    for m in range(1, int(top / step) + 1) {
      let my = H - m * step / top * H
      if my > 8 {
      rect(stakeX - 2, my - 2, 4, 4, fill: red)
      line(stakeX + 2, my, stakeX + 6, my, stroke: m * step < depth ? #3a4660 : foreground, width: 1)
      text("${round(metric ? m * step * 2.54 : m * step)}", stakeX + 7, my, size: 7, align: start, color: m * step < depth ? #3a4660 : foreground)
      }
    }
  }
  // falling snow on a day it snowed: the only layer drawn every frame, and not in battery saver
  if fresh > 0.5 && !modes.saver {
    Canvas {
      let H = height
      let W = width
      for f in range(24) {
        let fx = (hash(f) * W + time * (6 + hash(f, 1) * 6)) % W
        let fy = (hash(f, 2) * H + time * (10 + hash(f, 3) * 10)) % H
        circle(fx, fy, 0.8 + hash(f, 4), fill: alpha(#ffffff, 0.8))
      }
    }
  }
  Canvas {
    rect(4, 4, 6.2 * (len(place.name) + len("${show}${unit}") + 2) + 10, 22, fill: alpha(background, 0.6), radius: 5 * corners)
    text([{text: "${place.name}  ", color: muted}, {text: ready ? "${show}${unit}" : "…", bold: true, color: foreground}], 10, 15, size: 11, align: start)
    if fresh > 0.5 {
      text("+${round(metric ? fresh * 2.54 : fresh)}${unit} new", 10, 34, size: 9, align: start, color: cyan)
    }
  }
  }

  screen {
    title: "snow · ${place.name}"
    Column {
      scroll: true
      gap: 8
      Text { text: "${ready ? show : "…"}${unit} on the ground"; style: title }
      Text { text: usingStation
        ? "measured daily at SNOTEL ${station.s.name} (${round(station.s.elevation * 0.3048)} m, ${round(station.km, 1)} km away)"
        : "modelled by Open-Meteo at ${place.elev} m${place.cc == "US" && !model && station == null ? ", no SNOTEL station within 15 km" : ""}"; style: small; color: muted }
      Row {
        gap: 8
        Button { text: metric ? "cm" : "inches"; onTap: metric = !metric }
        if place.cc == "US" {
          Button { text: model ? "use SNOTEL" : "use model"; onTap: model = !model }
        }
      }
      Row {
        gap: 8
        Text { text: "model height"; style: small; color: muted }
        Button { text: "−100 m"; onTap: place = merge(place, {elev: max(0, place.elev - 100)}) }
        Text { text: "${place.elev} m" }
        Button { text: "+100 m"; onTap: place = merge(place, {elev: place.elev + 100}) }
      }
      Input { placeholder: "find a ski area or town"; onSubmit: query = value }
      for r in found.results ?? [] key r.id {
        Box {
          padding: [6, 4]
          onTap: place = {name: r.name, lat: r.latitude, lon: r.longitude, elev: round(r.elevation ?? 1500), cc: r.country_code, tz: r.timezone}
          Text { spans: [r.name, {text: "  ${r.admin1 ?? ""}, ${r.country ?? ""} · ${round(r.elevation ?? 0)} m", color: muted}] }
        }
      }
      Text { text: "ski areas"; style: muted }
      for r in resorts key r.name {
        Box {
          padding: [6, 4]
          background: r.name == place.name ? alpha(accent, 0.15) : null
          radius: 6 * corners
          onTap: place = r
          Text { spans: [r.name, {text: "  ${r.cc} · ${r.elev} m", color: muted}] }
        }
      }
    }
  }
}
