      let ox = clamp(width / 2 - 30 * p, width - 80 * p, 0)   // narrow tiles keep her glass in view
      let oy = max(height - 64 * p, -3 * p)   // wide tiles lose a little hat crown and more of the bottom
      sprite(scene2.rows, ox + scene2.x * p, oy + scene2.y * p, p, palette: pal)
    }
    // what moves: her drinking arm, her face, bubbles, glints, the sea
    Canvas {
      fill: true
      let p = max(width / 80, height / 64)
      let ox = clamp(width / 2 - 30 * p, width - 80 * p, 0)   // narrow tiles keep her glass in view
      let oy = max(height - 64 * p, -3 * p)   // wide tiles lose a little hat crown and more of the bottom
      // seconds into the current act; the wall clock is checked first, so `time`
      // is only read while a tap is fresh (and an old t0 from before the frame
      // clock restarted can't look recent again)
      let e = now - tapNow < 4 && time >= t0 ? time - t0 : 1000
      let sipping = act == "sip" && e < 2.1
      let winking = act == "wink" && e < 1.8
      let pose = !sipping ? 0 : e < 0.45 ? min(3, floor(e / 0.15) + 1) : e < 1.55 ? 3 : max(0, 3 - floor((e - 1.55) / 0.15) - 1)
      let lvl = ((sipping && e < 1.0 ? sips - 1 : sips) % 4 + 4) % 4
      let look = !winking ? "" : e < 0.12 ? "half" : e < 0.45 ? "peek" : e < 1.3 ? "wink" : e < 1.65 ? "peek" : "half"

      // the sea glitters
      for s, i in sparkles {
        let a = sin(now * (1.3 + i * 0.37) + i * 2.1)
        if a > 0.75 {
          rect(ox + s[0] * p, oy + s[1] * p, p, p, fill: alpha(#ffffff, (a - 0.75) * 4))
        }
      }

      // her face over the shades
      if look != "" {
        let f = look == "half" ? half : look == "peek" ? peek : wink
        sprite(f.rows, ox + f.x * p, oy + f.y * p, p, palette: pal)
      } else {
        // the sun catches her lenses every few seconds
        let g = floor(now) % 5 == 0 ? 3 : 6
        if g < 6 {
          sprite(glints[g].rows, ox + glints[g].x * p, oy + glints[g].y * p, p, palette: pal)
        }
      }

      // arm, glass and champagne
      let arm = arms[pose]
      sprite(arm.rows, ox + arm.x * p, oy + arm.y * p, p, palette: pal)
      let liq = liquid[pose][lvl]
      sprite(liq.rows, ox + liq.x * p, oy + liq.y * p, p, palette: pal)
      if pose == 0 {
        let top = bub.tops[lvl]
        let span = bub.bottom - top
        for j in range(3) {
          let by = bub.bottom - floor((now * 3.5 + j * span / 3) % span)
          let bx = bub.x0 + (j * 2 + floor(now * 3.5 / span + j)) % (bub.x1 - bub.x0 + 1)
          if by > top {
            rect(ox + bx * p, oy + by * p, p, p, fill: #fffbe0)
          }
        }
      }

      // a wink comes with a sparkle and a little heart
      if look == "wink" {
        let k = (e - 0.45) / 0.85
        let s = 1 + sin(k * 3.1416 * 3) * 0.25
        layer(1 - k * 0.6) {
          scale(s, s, ox + 46.5 * p, oy + 18.5 * p) { sprite(star, ox + 44 * p, oy + 16 * p, p, palette: heartPal) }
        }
      }
      if act == "wink" && e > 0.5 && e < 2.2 {
        let k = (e - 0.5) / 1.7
        layer(min(1, (1 - k) * 2)) {
          sprite(heart, ox + (45 + k * 10) * p, oy + floor(25 - k * 22) * p, p, palette: heartPal)
        }
      }
    }
  }
}
