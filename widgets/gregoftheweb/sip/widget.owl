widget "sip" {
  size: 3x2
  minSize: 2x2
  padding: 0

  meta {
    owl: 7
    description: "A 16-bit lady lounging under a beach umbrella. Tap: she sips her champagne. Tap again: she peeks over her shades and winks."
    version: "1.0.1"
    license: "MIT"
    category: "fun"
  }

  // 16-bit pixel art on an 80x64 grid, generated from a photo reference (sprite data below)
  //
  // Cheap when idle: the sea sparkles, lens glint and champagne bubbles step on
  // the 1 s clock (`now`), so the tile redraws once a second. The frame clock
  // (`time`) is only read for a few seconds after a tap, for the sip and the wink.
  source now = clock every 1s
  state taps = 0 persist       // odd taps sip, even taps wink
  state sips = 0 persist       // the glass empties a quarter per sip, then it's refilled
  state act = ""
  state t0 = -100              // `time` when the current act started
  state tapNow = 0             // `now` when the current act started

  onTap: {
    act = taps % 2 == 0 ? "sip" : "wink"
    sips = sips + (taps % 2 == 0 ? 1 : 0)
    taps = taps + 1
    t0 = time
    tapNow = now
    haptic()
  }

