widget "sky" {
  size: 6x1
  minSize: 4x1
  padding: 0
  meta { description: "The day and night sky across the past six hours and the next six, now in the middle"; version: "1.3"; license: "MIT"; category: "time"; owl: 6 }
  source now = clock every 1m
  // tapping the tile steps through these ways of showing the time in the middle
  state fmt = 0 persist
  let fmts = ["HH:mm", "h:mm a", "EEE HH:mm", "EEE h:mm a", "EEE d MMM · HH:mm", "EEE d MMM · h:mm a", "EEEE d MMMM", "yyyy-MM-dd HH:mm", "MMM d, yyyy · h:mm a"]
  let label = fmtTime(now, fmts[fmt % len(fmts)])
  onTap: fmt = (fmt + 1) % len(fmts)
  source wx = http("https://wttr.in/?format=j1") every 30m timeout 10s json
  let astro = wx.weather[0].astronomy[0]
  let sunHrs = [astro.sunrise, astro.sunset]
  .map(s => match(s ?? "", "(\\d+):(\\d+) (AM|PM)"))
  .map(m => m == null ? null : num(m[0]) % 12 + (m[2] == "PM" ? 12 : 0) + num(m[1]) / 60)
  let rise = sunHrs[0] ?? 6
  let set = sunHrs[1] ?? 18
  let dayLen = set - rise
  let noon = (rise + set) / 2
  let lo = -6
  let hi = 6
  let hNow = num(fmtTime(now, "H")) + num(fmtTime(now, "m")) / 60
  let steps = 48
  let hours = range(steps + 1).map(i => (hNow + lo + i * 12 / steps + 48) % 24)
  let elev = hours.map(h => h >= rise && h <= set
    ? sin(rad(180 * (h - rise) / dayLen))
    : -sin(rad(180 * ((h - set + 24) % 24) / (24 - dayLen))))
  let sky = elev.map(e =>
    e < -0.35 ? mix(#03050e, #0a1030, (e + 1) / 0.65)
    : e < -0.12 ? mix(#0a1030, #3a2a5e, (e + 0.35) / 0.23)
    : e < 0.0 ? mix(#3a2a5e, #e0705a, (e + 0.12) / 0.12)
    : e < 0.12 ? mix(#e0705a, #f4b26a, e / 0.12)
    : e < 0.35 ? mix(#f4b26a, #7fb6e8, (e - 0.12) / 0.23)
    : mix(#7fb6e8, #a9dcff, (e - 0.35) / 0.65))
  let eNow = elev[int(steps / 2)]
  // dark text in daylight, light text from dusk to dawn (sun below the horizon)
  let ink = eNow > 0 ? #10203a : #e8ecf8
  // the label sits on a pill of the sky's color at now, so a long one stays readable across dusk and dawn
  let skyNow = sky[int(steps / 2)]
  // and an outline of the other ink, so it also reads where the see-through pill crosses light into dark
  let halo = eNow > 0 ? #e8ecf8 : #10203a
  let haloAt = [[-1, 0], [1, 0], [0, -1], [0, 1], [-0.7, -0.7], [0.7, 0.7], [-0.7, 0.7], [0.7, -0.7]]
  let inkStart = elev[0] > 0 ? #10203a : #e8ecf8
  let inkEnd = elev[steps] > 0 ? #10203a : #e8ecf8
  let offRise = (rise - hNow + 36) % 24 - 12
  let offSet = (set - hNow + 36) % 24 - 12
  let offNoon = (noon - hNow + 36) % 24 - 12
  let offMidnight = (noon + 12 - hNow + 36) % 24 - 12
  Canvas {
    let tall = height > width * 1.3
    if tall {
    // a tall tile (the landscape home screen): the timeline runs down the tile, -6h at the top
    let py = height / 12
    rect(0, 0, width, height, fill: linear(0, 0, 0, height, sky), radius: 8 * corners)
    let slot0 = floor((now + lo * 3600) / 1200)
    for k in range(40) {
      let s = slot0 + k
      let d = ((s * 1200 + 600) - now) / 3600
      let hh = (hNow + d + 48) % 24
      let e = hh >= rise && hh <= set ? 1 : -sin(rad(180 * ((hh - set + 24) % 24) / (24 - dayLen)))
      let r1 = abs(sin(s * 12.9898) * 43758.5453) % 1
      let r2 = abs(sin(s * 78.233) * 12543.123) % 1
      let a = clamp((-e - 0.15) * 2.5, 0, 1)
      if a > 0 && d > lo && d < hi {
        circle(4 + r1 * (width - 8), (-lo * py + (d - 0.12 + r2 * 0.24) * py), 0.6 + r2 * 0.8, fill: alpha(#ffffff, a * (0.45 + r1 * 0.55)))
      }
    }
    if offNoon > lo - 1 && offNoon < hi + 1 {
      circle(width / 2, (-lo * py + offNoon * py), width * 0.9, fill: radial(width / 2, (-lo * py + offNoon * py), width * 0.9, [alpha(#fff6d8, 0.55), alpha(#fff6d8, 0)]))
      circle(width / 2, (-lo * py + offNoon * py), width * 0.16, fill: #fff3c4)
    }
    if offMidnight > lo - 1 && offMidnight < hi + 1 {
      circle(width / 2, (-lo * py + offMidnight * py), width * 0.14, fill: #e9ecf5)
      circle(width / 2 - width * 0.06, (-lo * py + offMidnight * py) - width * 0.04, width * 0.12, fill: mix(#03050e, #0a1030, 0.3))
    }
    let tSize = clamp((width - 10) / (len(label) * 0.62 + 0.8), 8, 40)
    let half = min(width / 2 - 2, (len(label) * 0.62 + 0.8) * tSize / 2)
    for p in [[offRise, rise, "↑"], [offSet, set, "↓"]] {
      // a sunrise or sunset label that would fall under the pill moves just above or below it
      let y = -lo * py + p[0] * py
      let ly = abs(y + lo * py) < tSize * 0.75 + 8 ? (p[0] < 0 ? -lo * py - tSize * 0.75 - 8 : -lo * py + tSize * 0.75 + 8) : y
      if p[0] > lo + 0.6 && p[0] < hi - 0.6 {
        line(0, (-lo * py + p[0] * py), 8, (-lo * py + p[0] * py), stroke: alpha(#ffe2a8, 0.8), width: 1)
        line(width - 8, (-lo * py + p[0] * py), width, (-lo * py + p[0] * py), stroke: alpha(#ffe2a8, 0.8), width: 1)
        text("${p[2]}${pad(int(floor(p[1])), 2, "0")}:${pad(int(round((p[1] - floor(p[1])) * 60) % 60), 2, "0")}", width / 2, ly, size: 10, align: center, color: alpha(#ffe2a8, 0.9))
      }
    }
    rect(width / 2 - half, -lo * py - tSize * 0.75, half * 2, tSize * 1.5, fill: alpha(skyNow, 0.45), radius: tSize * 0.75)
    line(0, -lo * py, max(0, width / 2 - half), -lo * py, stroke: alpha(ink, 0.55), width: 1.5)
    line(min(width, width / 2 + half), -lo * py, width, -lo * py, stroke: alpha(ink, 0.55), width: 1.5)
    for o in haloAt {
      text(label, width / 2 + o[0] * max(1, tSize * 0.06), -lo * py + o[1] * max(1, tSize * 0.06), size: tSize, bold: true, align: center, color: alpha(halo, 0.55))
    }
    text(label, width / 2, -lo * py, size: tSize, bold: true, align: center, color: ink)
    text("-6h", width / 2, 10, size: 9, align: center, color: alpha(inkStart, 0.6))
    text("+6h", width / 2, height - 10, size: 9, align: center, color: alpha(inkEnd, 0.6))
    } else {
    let px = width / 12
    rect(0, 0, width, height, fill: linear(0, 0, width, 0, sky), radius: 8 * corners)
    let slot0 = floor((now + lo * 3600) / 1200)
    for k in range(40) {
      let s = slot0 + k
      let d = ((s * 1200 + 600) - now) / 3600
      let hh = (hNow + d + 48) % 24
      let e = hh >= rise && hh <= set ? 1 : -sin(rad(180 * ((hh - set + 24) % 24) / (24 - dayLen)))
      let r1 = abs(sin(s * 12.9898) * 43758.5453) % 1
      let r2 = abs(sin(s * 78.233) * 12543.123) % 1
      let a = clamp((-e - 0.15) * 2.5, 0, 1)
      if a > 0 && d > lo && d < hi {
        circle((-lo * px + (d - 0.12 + r2 * 0.24) * px), 4 + r1 * (height - 8), 0.6 + r2 * 0.8, fill: alpha(#ffffff, a * (0.45 + r1 * 0.55)))
      }
    }
    if offNoon > lo - 1 && offNoon < hi + 1 {
      circle((-lo * px + (offNoon) * px), height / 2, height * 0.9, fill: radial((-lo * px + (offNoon) * px), height / 2, height * 0.9, [alpha(#fff6d8, 0.55), alpha(#fff6d8, 0)]))
      circle((-lo * px + (offNoon) * px), height / 2, height * 0.16, fill: #fff3c4)
    }
    if offMidnight > lo - 1 && offMidnight < hi + 1 {
      circle((-lo * px + (offMidnight) * px), height / 2, height * 0.14, fill: #e9ecf5)
      circle((-lo * px + (offMidnight) * px) + -height * 0.06, height / 2 - height * 0.04, height * 0.12, fill: mix(#03050e, #0a1030, 0.3))
    }
    let tSize = min(clamp(height * 0.32, 16, 40), width * 0.7 / (len(label) * 0.62 + 0.8))
    let half = (len(label) * 0.62 + 0.8) * tSize / 2
    for p in [[offRise, rise, "↑"], [offSet, set, "↓"]] {
      // a sunrise or sunset label that would fall under the pill moves just beside it
      let x = -lo * px + p[0] * px
      let lx = abs(x + lo * px) < half + 30 ? (p[0] < 0 ? -lo * px - half - 30 : -lo * px + half + 30) : x
      if p[0] > lo + 0.4 && p[0] < hi - 0.4 {
        line((-lo * px + (p[0]) * px), height - 10, (-lo * px + (p[0]) * px), height, stroke: alpha(#ffe2a8, 0.8), width: 1)
        text("${p[2]}${pad(int(floor(p[1])), 2, "0")}:${pad(int(round((p[1] - floor(p[1])) * 60) % 60), 2, "0")}", lx, height - 17, size: 10, align: center, color: alpha(#ffe2a8, 0.9))
      }
    }
    rect(-lo * px - half, height / 2 - tSize * 0.75, half * 2, tSize * 1.5, fill: alpha(skyNow, 0.45), radius: tSize * 0.75)
    line(-lo * px, 0, -lo * px, height / 2 - tSize * 0.75, stroke: alpha(ink, 0.55), width: 1.5)
    line(-lo * px, height / 2 + tSize * 0.75, -lo * px, height, stroke: alpha(ink, 0.55), width: 1.5)
    for o in haloAt {
      text(label, -lo * px + o[0] * max(1, tSize * 0.06), height / 2 + o[1] * max(1, tSize * 0.06), size: tSize, bold: true, align: center, color: alpha(halo, 0.55))
    }
    text(label, -lo * px, height / 2, size: tSize, bold: true, align: center, color: ink)
    text("-6h", 16, 12, size: 9, align: center, color: alpha(inkStart, 0.6))
    text("+6h", width - 16, 12, size: 9, align: center, color: alpha(inkEnd, 0.6))
    }
  }
}
