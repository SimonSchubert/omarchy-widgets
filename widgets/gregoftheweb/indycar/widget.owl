widget "Indycar" {
  meta { owl: 5; description: "IndyCar calendar: next race countdown, podiums, driver standings and a street, road, oval and speedway breakdown"; version: "1.1"; license: "MIT"; category: "sport" }

  requires { pacman: ["curl", "jq"] }

  size: 3x4
  minSize: 2x3

  source now = clock every 30s
  source ic = cmd("""
    y=$(date +%Y); ev=$(mktemp); st=$(mktemp)
    curl -sf "https://site.api.espn.com/apis/site/v2/sports/racing/irl/scoreboard?dates=$y" > "$ev"
    if [ "$(jq '.events|length' "$ev")" = 0 ]; then y=$((y-1)); curl -sf "https://site.api.espn.com/apis/site/v2/sports/racing/irl/scoreboard?dates=$y" > "$ev"; fi
    curl -sf "https://site.web.api.espn.com/apis/v2/sports/racing/irl/standings?season=$y" > "$st" || echo null > "$st"
    jq -nc --slurpfile E "$ev" --slurpfile S "$st" --arg y "$y" '$E[0] as $ev | $S[0] as $st |
      def code(a): (a.displayName // a.fullName) | split(" ") as $w | ($w | last) as $l | {"O\u0027Ward": "Pato", "Hunter-Reay": "RHR"}[$l] // "\($w[0][0:1]). \($l[0:3])";
      def lastname(n): n | split(" ") | .[1:] | join(" ");
      ($ev.events | sort_by(.date) | to_entries | map(.value as $e | ($e.name | sub("^Grand Prix of "; "") | sub(" \\(Road Course\\)"; " RC")) as $gp | {
        round: (.key + 1), gp: $gp, name: $e.name,
        city: ($gp | sub(" Race [0-9]+$"; "") | sub(" 500$"; "") | sub(" RC$"; "")),
        country: (if ($gp | test("Ontario|Toronto")) then "Canada" else "USA" end),
        ts: ($e.date | sub("Z$"; ":00Z") | fromdateiso8601),
        done: $e.status.type.completed,
        top: ([$e.competitions[0].competitors[]? | select(.order <= 3) | {p: .order, id: .id, name: lastname(.athlete.displayName), code: code(.athlete)}] | sort_by(.p))
      })) as $races
      | ([$races[] | select(.done) | .top[]]) as $pods
      | {season: $y, races: $races,
         drivers: [($st.children[0].standings.entries // [])[] | .athlete as $a | {
           id: $a.id, pos: (.stats[] | select(.name == "rank") | .value | floor),
           pts: (.stats[] | select(.name == "championshipPts") | .value | floor),
           code: code($a), name: lastname($a.displayName), nat: ($a.flag.alt // ""),
           wins: ([$pods[] | select(.id == $a.id and .p == 1)] | length),
           podiums: ([$pods[] | select(.id == $a.id)] | length)}] | sort_by(.pos)}'
    rm -f "$ev" "$st"
  """) every 30m json timeout 30s

  let races = ic.races ?? []
  let drivers = ic.drivers ?? []
  let results = races.filter(r => r.done && count(r.top) > 0)
  let total = count(races)
  let next = races.find(r => !r.done && r.ts > now - 4 * 3600)
  let done = total > 0 && next == null
  let nextRound = next != null ? next.round : total
  let lastRace = results.last()
  let flags = {USA: "🇺🇸", Canada: "🇨🇦", Spain: "🇪🇸", "New Zealand": "🇳🇿", Australia: "🇦🇺", Brazil: "🇧🇷", "Cayman Islands": "🇰🇾", Denmark: "🇩🇰", England: "🏴󠁧󠁢󠁥󠁮󠁧󠁿", France: "🇫🇷", Germany: "🇩🇪", Japan: "🇯🇵", Mexico: "🇲🇽", Netherlands: "🇳🇱", Norway: "🇳🇴", Sweden: "🇸🇪", Switzerland: "🇨🇭", Italy: "🇮🇹", Israel: "🇮🇱", Argentina: "🇦🇷", Colombia: "🇨🇴"}
  let medals = ["🥇", "🥈", "🥉"]
  // track, the race's well-known name, and discipline; keyed by ESPN's event name minus "Grand Prix of"
  let tracks = {
    "St. Petersburg": {track: "Streets of St. Petersburg", known: "Firestone Grand Prix of St. Petersburg", type: "street"},
    "Phoenix": {track: "Phoenix Raceway", known: "Phoenix International Raceway", type: "oval"},
    "Arlington": {track: "Arlington street circuit", known: "new for 2026", type: "street"},
    "Alabama": {track: "Barber Motorsports Park", known: "Indy Grand Prix of Alabama", type: "road"},
    "Long Beach": {track: "Streets of Long Beach", known: "Long Beach Grand Prix", type: "street"},
    "Indianapolis RC": {track: "Indianapolis road course", known: "Grand Prix of Indianapolis", type: "road"},
    "Indianapolis 500": {track: "Indianapolis Motor Speedway", known: "The Greatest Spectacle in Racing", type: "speedway"},
    "Detroit": {track: "Streets of Detroit", known: "Detroit Grand Prix", type: "street"},
    "Illinois": {track: "Gateway (World Wide Technology Raceway)", known: "Bommarito 500", type: "oval"},
    "Road America": {track: "Road America, Elkhart Lake", known: "Grand Prix at Road America", type: "road"},
    "Mid-Ohio": {track: "Mid-Ohio Sports Car Course", known: "Honda Indy 200 at Mid-Ohio", type: "road"},
    "Nashville": {track: "Nashville Superspeedway", known: "Music City Grand Prix", type: "oval"},
    "Portland": {track: "Portland International Raceway", known: "Grand Prix of Portland", type: "road"},
    "Ontario": {track: "Streets of Markham", known: "successor to the Honda Indy Toronto", type: "street"},
    "Washington, D.C.": {track: "Streets of Washington, D.C.", known: "Freedom 250 Grand Prix", type: "street"},
    "Milwaukee Race 1": {track: "The Milwaukee Mile", known: "Milwaukee Mile 250", type: "oval"},
    "Milwaukee Race 2": {track: "The Milwaukee Mile", known: "Milwaukee Mile 250", type: "oval"},
    "Monterey": {track: "Laguna Seca", known: "Grand Prix of Monterey", type: "road"}
  }
  let kinds = ["street", "road", "oval", "speedway"]
  let kindColor = {street: "#7aa2f7", road: "#9ece6a", oval: "#ff9e64", speedway: "#f7768e"}
  state view = "races"
  // A short, wide tile (the landscape home screen) puts the standings or next race beside
  // the last race and the round progress instead of stacking them all.
  let short = tileWidth != null && tileHeight != null && tileHeight < 220 && tileWidth > tileHeight * 1.3

  onTap: screen()

  if short {
    Column {
      gap: 6
      Row {
        align: center
        Text { text: "indycar ${ic.season ?? ""}"; style: muted; weight: 1; maxLines: 1 }
        Text { text: done ? "season over" : ""; style: label; color: muted; width: 90; align: end; maxLines: 1 }
        Text { text: done ? "🏁" : flags[next.country] ?? "🏎️"; fontSize: 18; width: 28; align: end }
      }
      if total == 0 {
        Text { text: "…"; style: title }
      } else {
        Row {
          gap: 12
          weight: 1
          Column {
            weight: 1
            gap: 4
            if done {
              for d in drivers.take(3) key d.id {
                Row {
                  align: center
                  gap: 6
                  Text { text: medals[d.pos - 1] ?? "${d.pos}"; fontSize: 14; width: 22 }
                  Text { text: d.name; style: body; bold: d.pos == 1; color: d.pos == 1 ? accent : foreground; weight: 1; maxLines: 1 }
                  Text { text: "${d.pts}"; style: small; color: muted; width: 36; align: end }
                }
              }
            } else {
              Text { text: "R${next.round} · ${next.gp}"; style: body; bold: true; maxLines: 1 }
              Text { text: fmtTime(next.ts, "EEE d MMM · HH:mm"); style: small; color: muted; maxLines: 1 }
              Text { text: next.ts > now ? "in ${fmtDuration(next.ts - now)}" : "racing now"; style: title; color: accent; maxLines: 1 }
              if tracks[next.gp] != null {
                Text { text: tracks[next.gp].type; style: label; color: background; background: kindColor[tracks[next.gp].type]; radius: 4; padding: [6, 2]; width: 80; align: center }
              }
            }
          }
          Column {
            width: 104
            gap: 0
            if lastRace != null {
              Row {
                align: center
                gap: 4
                Text { text: flags[lastRace.country] ?? "🏁"; fontSize: 12; width: 20 }
                Text { text: lastRace.gp; style: label; color: muted; weight: 1; maxLines: 1 }
              }
              for t in lastRace.top key t.p {
                Text { text: t.code; style: small; color: t.p == 1 ? foreground : muted; maxLines: 1 }
              }
            }
            Spacer { weight: 1 }
            Row {
              align: center
              gap: 6
              Progress { value: nextRound; max: total; color: accent; weight: 1; height: 6 }
              Text { text: "${nextRound}/${total}"; style: label; color: muted; width: 40; align: end }
            }
          }
        }
      }
    }
  } else {
    Column {
      gap: 6
      Row {
        align: center
        Text { text: "indycar ${ic.season ?? ""}"; style: muted; width: 110 }
        Spacer { weight: 1 }
        Text { text: done ? "🏁" : flags[next.country] ?? "🏎️"; fontSize: 22; width: 30; align: end }
      }

      if total == 0 {
        Text { text: "…"; style: title }
      } else if done {
        Text { text: "season over"; style: title }
        for d in drivers.take(3) key d.id {
          Row {
            align: center
            gap: 8
            Text { text: medals[d.pos - 1] ?? "${d.pos}"; fontSize: 14; width: 24 }
            Text { text: d.name; style: body; bold: d.pos == 1; color: d.pos == 1 ? accent : foreground; weight: 1; maxLines: 1 }
            Text { text: "${d.pts}"; style: small; color: muted; width: 48; align: end }
          }
        }
      } else {
        Text { text: "R${next.round} · ${next.gp}"; style: title; maxLines: 2 }
        Text { text: fmtTime(next.ts, "EEE d MMM · HH:mm"); style: body }
        Text { text: next.ts > now ? "in ${fmtDuration(next.ts - now)}" : "racing now"; style: title; color: accent }
        if tracks[next.gp] != null {
          Text { text: tracks[next.gp].type; style: label; color: background; background: kindColor[tracks[next.gp].type]; radius: 4; padding: [6, 2]; width: 80; align: center }
        }
      }

      if lastRace != null {
        Row {
          gap: 6
          Text { text: flags[lastRace.country] ?? "🏁"; fontSize: 14; width: 24 }
          Column {
            gap: 0
            weight: 1
            Text { text: lastRace.gp; style: label; color: muted }
            Row {
              gap: 6
              for t in lastRace.top key t.p {
                Text { text: t.code; style: small; color: t.p == 1 ? foreground : muted; weight: 1; maxLines: 1 }
              }
            }
          }
        }
      }

      Row {
        align: center
        gap: 8
        Progress { value: nextRound; max: total; color: accent; weight: 1; height: 6 }
        Text { text: "${nextRound}/${total}"; style: label; color: muted; width: 40; align: end }
      }
    }
  }

  component Tab(t, label) {
    Text {
      text: label
      style: label
      width: 84
      align: center
      color: view == t ? background : muted
      background: view == t ? accent : surface
      radius: 4
      padding: [8, 4]
      onTap: { view = t }
    }
  }

  component DriverRow(d) {
    Row {
      align: center
      gap: 8
      Text { text: "${d.pos}"; style: label; color: muted; width: 20 }
      Text { text: flags[d.nat] ?? "·"; fontSize: 14; width: 24 }
      Column {
        gap: 0
        weight: 1
        Text { text: d.name; style: small; bold: d.pos <= 3 }
        Text { text: "${d.wins} wins · ${d.podiums} podiums"; style: label; color: muted }
      }
      Text { text: "${d.pts}"; style: body; bold: d.pos == 1; color: d.pos == 1 ? accent : foreground; width: 56; align: end }
    }
  }

  screen {
    title: "indycar ${ic.season ?? ""}"
    Column {
      padding: 4
      gap: 8
      Row {
        gap: 6
        Tab { t: "races"; label: "races" }
        Tab { t: "podiums"; label: "podiums" }
        Tab { t: "drivers"; label: "drivers" }
        Tab { t: "kinds"; label: "tracks" }
      }

      if view == "races" {
        Column {
          scroll: true
          weight: 1
          gap: 2
          for r in races key r.round {
            let past = r.done
            let isNext = next != null && r.round == next.round
            Row {
              align: center
              gap: 8
              padding: [8, 4]
              radius: 6
              background: past ? surface : (isNext ? mix(accent, background, 0.85) : null)
              Text { text: "${r.round}"; style: label; color: muted; width: 20 }
              Text { text: flags[r.country] ?? "·"; fontSize: 16; width: 26 }
              Column {
                gap: 0
                weight: 1
                Text { text: tracks[r.gp].track ?? r.gp; style: past ? "small" : "body"; bold: isNext; color: past ? muted : foreground }
                Text { text: tracks[r.gp].known ?? r.name; style: label; color: muted; maxLines: 1 }
                if past && count(r.top) > 0 {
                  Text { text: "🏆 ${r.top[0].name}"; style: label; color: muted }
                }
              }
              if tracks[r.gp] != null { Text { text: tracks[r.gp].type; style: label; color: kindColor[tracks[r.gp].type]; width: 64; align: end } }
              Text { text: fmtTime(r.ts, "d MMM"); style: small; color: past ? muted : foreground; width: 52; align: end }
            }
          }
        }
      } else if view == "podiums" {
        Column {
          scroll: true
          weight: 1
          gap: 2
          if count(results) == 0 {
            Text { text: "no races yet"; style: muted }
          }
          for r in results key r.round {
            Row {
              align: center
              gap: 8
              padding: [8, 4]
              radius: 6
              Text { text: "${r.round}"; style: label; color: muted; width: 20 }
              Text { text: flags[r.country] ?? "🏁"; fontSize: 16; width: 26 }
              Column {
                gap: 0
                weight: 1
                Text { text: r.gp; style: body }
                for t in r.top {
                  Text { text: "${medals[t.p - 1]} ${t.name}"; style: label; color: t.p == 1 ? foreground : muted }
                }
              }
            }
          }
        }
      } else if view == "kinds" {
        Column {
          scroll: true
          weight: 1
          gap: 10
          Row {
            gap: 6
            for k in kinds key k {
              Column {
                gap: 0
                weight: 1
                padding: [8, 6]
                radius: 6
                background: mix(kindColor[k], background, 0.8)
                Text { text: "${count(races.filter(r => tracks[r.gp].type == k))}"; style: title; color: kindColor[k]; align: center }
                Text { text: k; style: label; color: muted; align: center }
              }
            }
          }
          for k in kinds key k {
            let rs = races.filter(r => tracks[r.gp].type == k)
            let ws = rs.filter(r => r.done && count(r.top) > 0).map(r => r.top[0].name)
            let best = ws.unique().sortBy(n => -count(ws.filter(x => x == n))).first()
            if count(rs) > 0 {
              Column {
                gap: 2
                Row {
                  align: center
                  gap: 8
                  Text { text: k; style: body; bold: true; color: kindColor[k]; width: 120 }
                  Text { text: best != null ? "most wins: ${best} (${count(ws.filter(x => x == best))})" : ""; style: label; color: muted; weight: 1; align: end; maxLines: 1 }
                }
                for r in rs key r.round {
                  Row {
                    align: center
                    gap: 8
                    padding: [8, 3]
                    radius: 6
                    background: surface
                    Text { text: "${r.round}"; style: label; color: muted; width: 20 }
                    Text { text: tracks[r.gp].track; style: small; weight: 1; maxLines: 1 }
                    Text { text: r.done && count(r.top) > 0 ? "🏆 ${r.top[0].name}" : fmtTime(r.ts, "d MMM"); style: label; color: muted; width: 150; align: end; maxLines: 1 }
                  }
                }
              }
            }
          }
          if count(races.filter(r => tracks[r.gp] == null)) > 0 {
            Text { text: "${count(races.filter(r => tracks[r.gp] == null))} races not in the track list yet"; style: label; color: muted }
          }
        }
      } else {
        Column {
          scroll: true
          weight: 1
          gap: 6
          for d in drivers key d.id {
            DriverRow { d: d }
          }
        }
      }
    }
  }
}

