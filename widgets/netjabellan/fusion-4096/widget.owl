widget "Fusión 4096" {
  size: 4x4
  minSize: 4x4
  meta {
    owl: 21
    description: "Merge matching tiles and reach 4096."
    version: "1.1"
    license: "MIT"
    category: "games"
  }
  requires { pacman: [] }

  strings {
    en {
      heading: "FUSION 4096"
      confirmReset: "Restart?"
      yes: "Yes"
      no: "No"
      noMoves: "No moves"
      goal: "Goal reached!"
      record: "BEST"
      celebration: "4096 REACHED!"
      undo: "Undo"
      restart: "Restart"
      settings: "Settings"
      gestures: "Swipe controls"
      animations: "Animations"
      sounds: "Sounds"
      theme: "Theme"
      enabled: "On"
      disabled: "Off"
      classic: "Classic"
      forest: "Forest"
      sunset: "Sunset"
      paper: "Paper"
      polar: "Polar"
      lavender: "Lavender"
    }
    es {
      heading: "FUSIÓN 4096"
      confirmReset: "¿Reiniciar?"
      yes: "Sí"
      no: "No"
      noMoves: "Sin jugadas"
      goal: "¡Meta lograda!"
      record: "RÉCORD"
      celebration: "¡ALCANZASTE 4096!"
      undo: "Deshacer"
      restart: "Reiniciar"
      settings: "Ajustes"
      gestures: "Gestos"
      animations: "Animaciones"
      sounds: "Sonidos"
      theme: "Tema"
      enabled: "Sí"
      disabled: "No"
      classic: "Clásico"
      forest: "Bosque"
      sunset: "Atardecer"
      paper: "Papel"
      polar: "Polar"
      lavender: "Lavanda"
    }
  }

  background: palette.base
  padding: 10

  let pixel = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"
  state settingsOpen = false
  state gesturesEnabled = true persist
  state swipeX = 0
  state swipeY = 0
  state animationsEnabled = true persist
  state soundsEnabled = true persist
  state themeChoice = 0 persist

  let themes = [
    {base: #121020, control: #2c2249, edge: #8064bd, accent: #91f7da, title: #ffdb76, dim: #9387aa, line: #d3b4ff,
      tiles: [#211a33, #304d85, #206c71, #3c5ca1, #674f96, #913d75, #a74562, #a34e42, #8a632e, #746526, #46713f, #287e74]},
    {base: #101d19, control: #213c30, edge: #63967a, accent: #b0efbf, title: #e9dd9b, dim: #9aac9e, line: #bbebc7,
      tiles: [#1c3029, #315a4b, #3f6952, #416536, #616c34, #847231, #8d5b39, #865349, #714963, #555779, #32697d, #287e74]},
    {base: #241621, control: #48263b, edge: #b96f8b, accent: #ffb2c8, title: #ffd58d, dim: #c6a1b1, line: #ffc1c9,
      tiles: [#382333, #623f66, #75456c, #874668, #9b495e, #a64c4b, #9c572f, #936225, #826c2e, #6a713d, #496e58, #3a746e]},
    {base: #f1e7cf, control: #e1cba1, edge: #8d6847, accent: #493522, title: #6d3027, dim: #665647, line: #694527, ink: #34241a,
      tiles: [#e5d8bb, #f6e3a3, #efc680, #e9ad6f, #de9b76, #e59388, #d3a596, #d6b889, #b9b78a, #a9bf9c, #a9bfd0, #bfb1d3]},
    {base: #e4f5fa, control: #c3e3ed, edge: #527b94, accent: #143d5e, title: #203371, dim: #465f71, line: #345f81, ink: #102d46,
      tiles: [#d3eaf2, #c4edf3, #ace3f1, #9ed6ef, #9ec9ef, #a7bcea, #b9b6ed, #ccc3f0, #aabedb, #92cbc8, #9bd9c6, #b6e6d2]},
    {base: #f2e8f7, control: #e6d1ed, edge: #886598, accent: #472856, title: #692859, dim: #68526e, line: #70457d, ink: #382040,
      tiles: [#e9dcf0, #f2e4ad, #d8b7ed, #ade0da, #efa6bb, #aec8f4, #efba89, #b6d593, #d9a9d5, #9fd7ef, #dbbd90, #a5c0b0]}
  ]
  let palette = themes[themeChoice] ?? themes[0]
  let cells = range(16)
  state tiles = range(16).map(i => i == 5 || i == 10 ? 2 : 0) persist
  state score = 0 persist
  state bestScore = 0 persist
  state goalCelebrated = false persist
  state celebrationTime = 0
  let celebrationDuration = 1.6
  state previous = null
  state reset = false
  state motion = null
  state elapsed = 0
  state audioWait = 0

  let slideDuration = 0.13
  let popDuration = 0.16
  // One shared cooldown keeps rapid taps from restarting or overlapping clips.
  let audioInterval = 0.30
  every frame {
    if score > bestScore { bestScore = score }
    if celebrationTime > 0 { celebrationTime = max(0, celebrationTime - dt) }
    if audioWait > 0 { audioWait = max(0, audioWait - dt) }
    if motion != null {
      elapsed = elapsed + dt
      if elapsed >= (motion.slides ? slideDuration : 0) + popDuration { motion = null }
    }
  }

  // Read each line from the edge toward which the player is moving.
  let orders = [
    cells,
    cells.map(i => 4 * floor(i / 4) + 3 - i % 4),
    cells.map(i => 4 * (i % 4) + floor(i / 4)),
    cells.map(i => 4 * (3 - i % 4) + floor(i / 4))
  ]
  let neighbors = flatten(cells.map(i => flatten([
    i % 4 < 3 ? [{a: i, b: i + 1}] : [],
    i < 12 ? [{a: i, b: i + 4}] : []
  ])))
  let stuck = !contains(tiles, 0) && !any(neighbors, pair => tiles[pair.a] == tiles[pair.b])
  let colors = palette.tiles

  let groupedTurns = orders.map(order => chunk(order, 4).map(line =>
    reduce(line.filter(i => tiles[i] > 0), (row, i) =>
      !row.locked && last(row.groups).value == tiles[i]
        ? {groups: set(row.groups, -1, {value: tiles[i] * 2, from: [last(row.groups).from[0], i]}), locked: true}
        : {groups: flatten([row.groups, [{value: tiles[i], from: [i]}]]), locked: false},
      {groups: [], locked: false}).groups))
  let packedTurns = groupedTurns.map(lines => flatten(lines.map(row => range(4).map(i => row[i] ?? null))))
  let turns = range(4).map(d => cells.map(i => packedTurns[d][indexOf(orders[d], i)]))

  component Arrow(glyph, dir) {
    Box {
      weight: 1
      height: 30
      align: center
      background: palette.control
      border: 1
      borderColor: palette.edge
      radius: 0
      Text { text: glyph; color: palette.accent; font: pixel; fontSize: 13; align: center; fill: width }
      onTap: {
        let direction = dir
        let groups = turns[direction]
        let shifted = groups.map(group => group.value ?? 0)
        let moved = any(cells, i => shifted[i] != tiles[i])
        let merged = cells.filter(i => len(groups[i].from ?? []) == 2)
        if moved {
          let gaps = cells.filter(i => shifted[i] == 0)
          let spawn = gaps[random(len(gaps))]
          previous = {tiles: tiles, score: score}
          if animationsEnabled {
            let moves = flatten(cells.map(i => (groups[i].from ?? []).map(j => {from: j, to: i, value: tiles[j]})))
            motion = {moves: moves, pops: flatten([merged, [spawn]]), slides: true}
            elapsed = 0
          }
          tiles = set(shifted, spawn, random(10) == 0 ? 4 : 2)
          let nextScore = score + sum(merged.map(i => shifted[i]))
          bestScore = max(bestScore, score, nextScore)
          score = nextScore
          if !goalCelebrated && any(merged, i => shifted[i] == 4096) {
            goalCelebrated = true
            celebrationTime = celebrationDuration
          }
        }
        if soundsEnabled && audioWait <= 0 {
          audioWait = audioInterval
          sound(!moved ? "asset:blocked" : len(merged) > 0 ? "asset:settle" : "asset:tap")
        }
      }
    }
  }

  Column {
    gap: 4
    Row {
      align: center
      height: 24
      Text { text: str.heading; font: pixel; fontSize: 9; color: palette.title; weight: 1; maxLines: 1 }
      Column {
        gap: 3
        align: end
        Text { text: fmtNum(score); font: pixel; fontSize: 8; color: palette.accent; maxLines: 1 }
        Text { text: str.record + " " + fmtNum(max(bestScore, score)); font: pixel; fontSize: 6; color: palette.title; maxLines: 1 }
      }
      Box {
        size: 24
        align: center
        background: palette.control
        border: 1
        borderColor: palette.edge
        radius: 0
        onTap: settingsOpen = !settingsOpen
        Canvas {
          size: 16
          sprite([
            "......##......",
            "..##..##..##..",
            ".############.",
            "..##########..",
            "..###....###..",
            "..##......##..",
            "####......####",
            "####......####",
            "..##......##..",
            "..###....###..",
            "..##########..",
            ".############.",
            "..##..##..##..",
            "......##......"
          ], 1, 1, 1, fill: palette.accent)
        }
      }
    }
    if settingsOpen {
      Column {
        weight: 1
        fill: width
        gap: 7
        padding: 8
        background: palette.tiles[0]
        Text { text: str.settings; font: pixel; fontSize: 10; color: palette.title }
        Row {
          align: center
          Text { text: str.animations; weight: 1; color: palette.accent }
          Button {
            text: animationsEnabled ? str.enabled : str.disabled
            onTap: {
              animationsEnabled = !animationsEnabled
              motion = null
            }
          }
        }
        Row {
          align: center
          Text { text: str.sounds; weight: 1; color: palette.accent }
          Button {
            text: soundsEnabled ? str.enabled : str.disabled
            onTap: {
              soundsEnabled = !soundsEnabled
              if soundsEnabled && audioWait <= 0 {
                audioWait = audioInterval
                sound("asset:tap")
              }
            }
          }
        }
        Row {
          align: center
          Text { text: str.gestures; weight: 1; color: palette.accent }
          Button {
            text: gesturesEnabled ? str.enabled : str.disabled
            onTap: {
              gesturesEnabled = !gesturesEnabled
              swipeX = 0
              swipeY = 0
            }
          }
        }
        Text { text: str.theme; color: palette.accent }
        for options in chunk(range(len(themes)), 3) {
          Row {
            fill: width
            for option in options {
              Box {
                weight: 1
                height: 29
                align: center
                radius: 0
                background: themes[option].control
                border: themeChoice == option ? 2 : 1
                borderColor: themeChoice == option ? themes[option].accent : themes[option].edge
                onTap: themeChoice = option
                Text {
                  text: [str.classic, str.forest, str.sunset, str.paper, str.polar, str.lavender][option]
                  color: themes[option].title
                  fontSize: 11
                  fill: width
                  align: center
                  maxLines: 1
                }
              }
            }
          }
        }
      }
    } else {
      Box {
        weight: 1
        fill: width
        Canvas {
          fill: true
          let tileWidth = (width - 9) / 4
          let tileHeight = (height - 9) / 4
          let stepX = tileWidth + 3
          let stepY = tileHeight + 3
          let sliding = motion != null && motion.slides && elapsed < slideDuration
          let progress = 1 - pow(1 - min(1, elapsed / slideDuration), 3)
          let pop = min(1, max(0, (elapsed - (motion.slides ? slideDuration : 0)) / popDuration))
          let pieces = sliding ? motion.moves : cells.filter(i => tiles[i] > 0).map(i => {from: i, to: i, value: tiles[i]})
          for i in cells {
            rect(i % 4 * stepX, floor(i / 4) * stepY, tileWidth, tileHeight,
              fill: colors[0], stroke: mix(colors[0], palette.line, 0.14), width: 1)
          }
          for piece in pieces {
            let tile = piece.value
            let x = (piece.from % 4 + (piece.to % 4 - piece.from % 4) * progress) * stepX
            let y = (floor(piece.from / 4) + (floor(piece.to / 4) - floor(piece.from / 4)) * progress) * stepY
            let tint = colors[len(range(11).filter(i => tile >= pow(2, i + 1)))]
            let bump = !sliding && motion != null && contains(motion.pops, piece.to) ? 1 - 0.24 * (1 - pop) + 0.50 * pop * (1 - pop) : 1
            scale(bump, bump, x + tileWidth / 2, y + tileHeight / 2) {
              rect(x, y, tileWidth, tileHeight, fill: tint, stroke: mix(tint, palette.line, 0.45), width: 1)
              rect(x + 2, y + 2, tileWidth - 4, 2, fill: alpha(#ffffff, 0.20))
              rect(x + 2, y + 4, 2, tileHeight - 7, fill: alpha(#ffffff, 0.12))
              rect(x + 2, y + tileHeight - 4, tileWidth - 4, 2, fill: alpha(#000000, 0.28))
              text(str(tile), x + tileWidth / 2, y + tileHeight / 2,
                size: tile >= 1000 ? 8 : 11, align: center, font: pixel, color: palette.ink ?? #fff4d9)
            }
          }
        }
        if celebrationTime > 0 {
          Box {
            fill: true
            align: center
            if animationsEnabled {
              Canvas {
                fill: true
                let progress = 1 - celebrationTime / celebrationDuration
                let confetti = [palette.title, palette.accent, palette.edge, palette.line]
                for i in range(24) {
                  let spread = 0.4 + (i % 5) * 0.15
                  let angle = i * 0.262
                  let px = width / 2 + cos(angle) * width * 0.43 * progress * spread
                  let py = height / 2 + sin(angle) * height * 0.43 * progress * spread
                  rotate(i * 19 + progress * 180, px, py) {
                    rect(px - 2, py - 3, 4, 6, fill: alpha(confetti[i % 4], min(1, 3 * (1 - progress))))
                  }
                }
              }
            }
            Box {
              padding: [12, 8]
              background: palette.control
              border: 2
              borderColor: palette.title
              radius: 0
              Text { text: str.celebration; font: pixel; fontSize: 8; color: palette.title; fill: width; align: center; maxLines: 1 }
            }
          }
        }
        if gesturesEnabled {
          Box {
            fill: true
            onDrag: {
              swipeX = swipeX + dx
              swipeY = swipeY + dy
            }
            onDragEnd: {
              let horizontal = abs(swipeX) >= abs(swipeY)
              let distance = horizontal ? swipeX : swipeY
              let direction = horizontal ? (distance < 0 ? 0 : 1) : (distance < 0 ? 2 : 3)
              swipeX = 0
              swipeY = 0
              if abs(distance) >= 18 {
                let groups = turns[direction]
                let shifted = groups.map(group => group.value ?? 0)
                let moved = any(cells, i => shifted[i] != tiles[i])
                let merged = cells.filter(i => len(groups[i].from ?? []) == 2)
                if moved {
                  let gaps = cells.filter(i => shifted[i] == 0)
                  let spawn = gaps[random(len(gaps))]
                  previous = {tiles: tiles, score: score}
                  if animationsEnabled {
                    let moves = flatten(cells.map(i => (groups[i].from ?? []).map(j => {from: j, to: i, value: tiles[j]})))
                    motion = {moves: moves, pops: flatten([merged, [spawn]]), slides: true}
                    elapsed = 0
                  }
                  tiles = set(shifted, spawn, random(10) == 0 ? 4 : 2)
                  let nextScore = score + sum(merged.map(i => shifted[i]))
                  bestScore = max(bestScore, score, nextScore)
                  score = nextScore
                  if !goalCelebrated && any(merged, i => shifted[i] == 4096) {
                    goalCelebrated = true
                    celebrationTime = celebrationDuration
                  }
                }
                if soundsEnabled && audioWait <= 0 {
                  audioWait = audioInterval
                  sound(!moved ? "asset:blocked" : len(merged) > 0 ? "asset:settle" : "asset:tap")
                }
              }
            }
          }
        }
      }
      if reset {
        Row {
          align: center
          Text { text: str.confirmReset; font: pixel; fontSize: 7; color: palette.title; weight: 1 }
          Button {
            text: str.yes
            onTap: {
              let picks = shuffle(cells)
              tiles = cells.map(i => i == picks[0] || i == picks[1] ? 2 : 0)
              motion = animationsEnabled ? {pops: [picks[0], picks[1]], slides: false} : null
              elapsed = 0
              previous = null
              bestScore = max(bestScore, score)
              celebrationTime = 0
              score = 0
              reset = false
            }
          }
          Button { text: str.no; onTap: reset = false }
        }
      } else {
        Row {
          align: center
          Text { text: stuck ? str.noMoves : max(tiles) >= 4096 ? str.goal : str.undo; font: pixel; fontSize: 7; weight: 1; color: previous == null ? palette.dim : palette.accent; onTap: {
            if previous != null {
              motion = null
              celebrationTime = 0
              tiles = previous.tiles
              score = previous.score
              previous = null
            }
          } }
          Text { text: str.restart; font: pixel; fontSize: 7; color: palette.title; onTap: reset = true }
        }
      }
      if !gesturesEnabled {
        Row {
          gap: 3
          Arrow { glyph: "←"; dir: 0 }
          Arrow { glyph: "↑"; dir: 2 }
          Arrow { glyph: "↓"; dir: 3 }
          Arrow { glyph: "→"; dir: 1 }
        }
      }
    }
  }

  asset tap = base64""
  asset settle = base64""
  asset blocked = base64""
}
