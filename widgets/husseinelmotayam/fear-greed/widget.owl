widget "fear & greed" {
  size: 3x3
  minSize: 2x2

  meta { owl: 6; description: "CNN Business's Fear & Greed Index for the US stock market, with its history, the seven indicators behind it and a notification when its zone changes"; version: "1.1"; license: "MIT"; category: "finance" }

  // Settings, changed on the screen's settings view
  state alertZone = true persist      // notify when the zone changes
  state alertBelow = 0 persist        // notify when the score falls below this; 0 is off
  state alertAbove = 100 persist      // notify when it rises above this; 100 is off
  state margin = 2 persist            // points past a boundary before a move counts
  state interval = 900 persist        // seconds between fetches
  state view = "index"                // what the screen shows: index or settings

  source now = clock every 1s

  // CNN's own data feed for cnn.com/markets/fear-and-greed. It answers bots with 418,
  // so it's asked like the page asks it: a browser User-Agent and a CNN Referer.
  // The `t` parameter (ignored by CNN) changes every `interval`, which fetches it again.
  source cnn = http(now == null ? null : "https://production.dataviz.cnn.io/index/fearandgreed/graphdata?t=${int(now / interval)}", {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36",
    Referer: "https://edition.cnn.com/",
    Accept: "application/json"
  }) every 1h json timeout 20s status

  // The refresh button spins for a moment while the fetch runs
  state spinUntil = 0
  at spinUntil { spinUntil = 0 }
  let spinning = spinUntil > 0

  // The last good answer, so a failed fetch keeps showing the data it had
  state last = null
  when cnn.ok { last = cnn.out }
  on cnn { last = value.ok ? value.out : last }
  let d = cnn.ok ? cnn.out : last
  let fg = d.fear_and_greed
  let score = fg.score
  let hist = (d.fear_and_greed_historical.data ?? []).map(p => p.y)
  let updated = d.fear_and_greed_historical.timestamp

  // CNN's zones
  let zones = [
    {lo: 0, hi: 25, name: "extreme fear", c: red},
    {lo: 25, hi: 45, name: "fear", c: orange},
    {lo: 45, hi: 55, name: "neutral", c: yellow},
    {lo: 55, hi: 75, name: "greed", c: green},
    {lo: 75, hi: 100, name: "extreme greed", c: bright_green}
  ]
  let colors = {"extreme fear": red, fear: orange, neutral: yellow, greed: green, "extreme greed": bright_green}
  let change = score - fg.previous_close
  let changeText = change == null ? "…" : "${change >= 0 ? "+" : "−"}${fixed(abs(change), 1)}"

  // Alerts. The zone last seen and which thresholds have fired are kept across restarts.
  // A move counts once the score is `margin` points past the boundary, so one that
  // hovers around a boundary notifies once.
  let zone = fg.rating
  state lastZone = "" persist
  state belowFired = false persist
  state aboveFired = false persist
  state lastAlert = "" persist
  let lz = zones.find(z => z.name == lastZone)
  when zone != null && lz == null { lastZone = zone }
  when !alertZone && zone != null && zone != lastZone { lastZone = zone }
  when alertZone && score != null && lz != null && zone != lastZone && (score < lz.lo - margin || score > lz.hi + margin) {
    notify("fear & greed: ${zone}", "${lastZone} → ${zone}, now ${round(score)}")
    lastAlert = "${lastZone} → ${zone} · ${fmtTime(now, "EEE HH:mm")}"
    lastZone = zone
  }
  when alertBelow > 0 && score != null && score < alertBelow && !belowFired {
    notify("fear & greed below ${alertBelow}", "now ${round(score)}, ${zone}")
    lastAlert = "below ${alertBelow}, at ${round(score)} · ${fmtTime(now, "EEE HH:mm")}"
    belowFired = true
  }
  when belowFired && score != null && score >= alertBelow + margin { belowFired = false }
  when alertAbove < 100 && score != null && score > alertAbove && !aboveFired {
    notify("fear & greed above ${alertAbove}", "now ${round(score)}, ${zone}")
    lastAlert = "above ${alertAbove}, at ${round(score)} · ${fmtTime(now, "EEE HH:mm")}"
    aboveFired = true
  }
  when aboveFired && score != null && score <= alertAbove - margin { aboveFired = false }

  // The latest raw value behind each indicator
  let sp = last(d.market_momentum_sp500.data ?? []).y
  let sp125 = last(d.market_momentum_sp125.data ?? []).y
  let momentum = sp == null || sp125 == null ? null : (sp / sp125 - 1) * 100
  let highs = last(d.stock_price_strength.data ?? []).y
  let breadth = last(d.stock_price_breadth.data ?? []).y
  let putCall = last(d.put_call_options.data ?? []).y
  let vix = last(d.market_volatility_vix.data ?? []).y
  let vix50 = last(d.market_volatility_vix_50.data ?? []).y
  let haven = last(d.safe_haven_demand.data ?? []).y
  let junk = last(d.junk_bond_demand.data ?? []).y
  let indicators = [
    {key: "market_momentum_sp500", name: "market momentum",
     detail: "S&P 500 ${round(sp)}, ${momentum >= 0 ? "+" : "−"}${fixed(abs(momentum), 1)}% vs its 125-day average"},
    {key: "stock_price_strength", name: "stock price strength",
     detail: "net new 52-week highs vs lows on the NYSE: ${highs >= 0 ? "+" : "−"}${fixed(abs(highs), 1)}%"},
    {key: "stock_price_breadth", name: "stock price breadth",
     detail: "McClellan volume summation index: ${round(breadth)}"},
    {key: "put_call_options", name: "put and call options",
     detail: "5-day average put/call ratio: ${fixed(putCall, 2)}"},
    {key: "market_volatility_vix", name: "market volatility",
     detail: "VIX ${fixed(vix, 2)} vs its 50-day average ${fixed(vix50, 2)}"},
    {key: "safe_haven_demand", name: "safe haven demand",
     detail: "stocks minus bonds, 20-day return: ${haven >= 0 ? "+" : "−"}${fixed(abs(haven), 2)}%"},
    {key: "junk_bond_demand", name: "junk bond demand",
     detail: "junk bond yield spread over investment grade: ${fixed(junk, 2)}%"}
  ]

  // A half-circle gauge in CNN's five zones, the current one lit, with a knob at the score
  component Gauge(s, rating, thick = 10, labels = false) {
    Canvas {
      let r = max(12, min(width / 2 - thick / 2 - (labels ? 14 : 2), height - thick / 2 - (labels ? 34 : 4)))
      let cx = width / 2
      let cy = labels ? height - 10 : (height + r) / 2
      let cur = s == null ? null : zones[(s >= 25 ? 1 : 0) + (s >= 45 ? 1 : 0) + (s >= 55 ? 1 : 0) + (s >= 75 ? 1 : 0)]
      for z in zones {
        arc(cx, cy, r, 270 + z.lo * 1.8 + 1, (z.hi - z.lo) * 1.8 - 2, stroke: cur != null && z.lo == cur.lo ? z.c : alpha(z.c, 0.3), width: thick, cap: butt)
      }
      if labels {
        for b in [0, 25, 45, 55, 75, 100] {
          let a = rad(270 + b * 1.8)
          text("${b}", cx + (r + thick / 2 + 10) * sin(a), cy - (r + thick / 2 + 10) * cos(a), size: 10, align: center, color: muted)
        }
      }
      if s != null {
        let a = rad(270 + s * 1.8)
        circle(cx + r * sin(a), cy - r * cos(a), thick * 0.9, fill: background)
        circle(cx + r * sin(a), cy - r * cos(a), thick * 0.62, fill: cur.c)
      }
      text(s == null ? "…" : "${round(s)}", cx, cy - r * 0.42, size: r * 0.5, align: center, bold: true, color: foreground)
      text(rating ?? "", cx, cy - r * 0.06, size: clamp(r * 0.15, 10, 16), align: center, color: cur == null ? muted : cur.c)
    }
  }

  // The header's icons, drawn so they don't depend on the font
  component RefreshIcon(spin, tint = muted) {
    Canvas {
      let c = width / 2
      let a = rad(315)
      let px = c + 6 * sin(a)
      let py = c - 6 * cos(a)
      rotate(spin ? (time * 360) % 360 : 0, c, c) {
        arc(c, c, 6, 45, 270, stroke: tint, width: 2, cap: round)
        path([[px + 3 * cos(a), py + 3 * sin(a)], [px - 3 * sin(a) - cos(a), py + 3 * cos(a) - sin(a)], [px + 3 * sin(a) - cos(a), py - 3 * cos(a) - sin(a)]], closed: true, fill: tint)
      }
    }
  }
  component GearIcon(tint = muted) {
    Canvas {
      let c = width / 2
      for i in range(8) {
        rotate(i * 45, c, c) { rect(c - 1.6, c - 8, 3.2, 4, fill: tint) }
      }
      circle(c, c, 5.2, stroke: tint, width: 2.6)
    }
  }

  // A choice among a few options, the chosen one lit
  component Choice(label, on) {
    Text {
      text: label
      style: small
      align: center
      padding: [0, 6]
      border: 1
      borderColor: on ? accent : border
      background: on ? alpha(accent, 0.18) : surface
      color: on ? accent : foreground
    }
  }

  // A setting's name and what it's set to
  component Setting(name, value, note = "") {
    Column {
      gap: 0
      Row {
        align: center
        Text { text: name; weight: 1; maxLines: 1 }
        Text { text: value; width: 110; align: end; color: accent }
      }
      if note != "" { Text { text: note; style: small; color: muted } }
    }
  }

  // A past value on one line, for the wide tile
  component Stat(label, s) {
    Row {
      align: center
      let z = s == null ? null : zones[(s >= 25 ? 1 : 0) + (s >= 45 ? 1 : 0) + (s >= 55 ? 1 : 0) + (s >= 75 ? 1 : 0)]
      Text { text: label; style: small; color: muted; weight: 1; maxLines: 1 }
      Text { text: s == null ? "…" : "${round(s)}"; style: small; bold: true; width: 32; align: end; color: z == null ? muted : z.c }
    }
  }

  // One past value: label, score and its zone
  component Past(label, s) {
    Column {
      gap: 0
      let z = s == null ? null : zones[(s >= 25 ? 1 : 0) + (s >= 45 ? 1 : 0) + (s >= 55 ? 1 : 0) + (s >= 75 ? 1 : 0)]
      Text { text: label; style: label; align: center; maxLines: 1 }
      Text { text: s == null ? "…" : "${round(s)}"; style: title; align: center; color: z == null ? muted : z.c }
      Text { text: z.name ?? ""; style: small; align: center; color: muted; maxLines: 2 }
    }
  }

  onTap: { view = "index"; screen() }

  // The tile's title, with the refresh and settings buttons on its right
  component Header() {
    Row {
      align: center
      gap: 2
      Text {
        text: cnn != null && !cnn.ok ? "offline" : (cols ?? 3) >= 3 ? "fear & greed" : "f&g"
        style: muted
        color: cnn != null && !cnn.ok ? red : muted
        weight: 1
        maxLines: 1
      }
      Box { width: 28; height: 28; align: center; onTap: { spinUntil = now + 2; refresh() }; RefreshIcon { spin: spinning; size: 18 } }
      Box { width: 28; height: 28; align: center; onTap: { view = "settings"; screen() }; GearIcon { size: 18 } }
    }
  }

  Column {
    gap: 2
    if (cols ?? 3) >= 5 {
      Row {
        weight: 1
        gap: 16
        align: center
        Gauge { s: score; rating: fg.rating; thick: rows >= 3 ? 10 : 8; fill: height; weight: 1 }
        Column {
          width: 170
          gap: 0
          Header { }
          Row {
            align: center
            Text { text: "vs close"; style: small; color: muted; weight: 1 }
            Text { text: changeText; style: small; bold: true; width: 48; align: end; color: change == null ? muted : change >= 0 ? green : red }
          }
          Stat { label: "1 week ago"; s: fg.previous_1_week }
          Stat { label: "1 month ago"; s: fg.previous_1_month }
          Stat { label: "1 year ago"; s: fg.previous_1_year }
        }
      }
    } else {
      Header { }
      Gauge { s: score; rating: fg.rating; thick: rows >= 3 ? 10 : 7; fill: width; weight: 1 }
    }
    if (rows ?? 3) >= 3 && (cols ?? 3) < 5 {
      Row {
        justify: spaceBetween
        Text { text: changeText; style: small; color: change == null ? muted : change >= 0 ? green : red; width: 44 }
        Text { text: "1w ${round(fg.previous_1_week)}"; style: small; color: muted; width: 44; align: center }
        Text { text: "1m ${round(fg.previous_1_month)}"; style: small; color: muted; width: 44; align: end }
      }
    }
  }

  screen {
    title: view == "settings" ? "fear & greed settings" : "fear & greed index"
    Column {
      scroll: true
      gap: 12
      Row {
        align: center
        gap: 4
        Text {
          text: d == null ? "loading" : "${cnn.ok ? "updated" : "offline, as of"} ${fmtTime(updated / 1000, "EEE HH:mm")} · ${changeText} vs close"
          style: small
          color: cnn.ok ? muted : red
          weight: 1
        }
        Box { width: 36; height: 36; align: center; onTap: { spinUntil = now + 2; refresh() }; RefreshIcon { spin: spinning; size: 20 } }
        Box {
          width: 36
          height: 36
          align: center
          background: view == "settings" ? alpha(accent, 0.18) : null
          onTap: view = view == "settings" ? "index" : "settings"
          GearIcon { tint: view == "settings" ? accent : muted; size: 20 }
        }
      }

      if view == "settings" {
        Text { text: "alerts"; style: label }
        Row {
          align: center
          Column {
            gap: 0
            weight: 1
            Text { text: "when the zone changes" }
            Text { text: "e.g. fear → extreme fear"; style: small; color: muted }
          }
          Button { text: alertZone ? "on" : "off"; color: alertZone ? accent : muted; width: 72; onTap: { alertZone = !alertZone; lastZone = zone ?? lastZone } }
        }

        Setting { name: "when it falls below"; value: alertBelow == 0 ? "off" : "${alertBelow}"; note: "now ${round(score)}; slide to the left end to turn it off" }
        Slider { value: alertBelow; min: 0; max: 50; step: 5; onChange: { alertBelow = value; belowFired = score < value } }

        Setting { name: "when it rises above"; value: alertAbove == 100 ? "off" : "${alertAbove}"; note: "slide to the right end to turn it off" }
        Slider { value: alertAbove; min: 50; max: 100; step: 5; onChange: { alertAbove = value; aboveFired = score > value } }

        Setting { name: "margin"; value: margin == 0 ? "none" : margin == 1 ? "1 point" : "${margin} points"; note: "points past a boundary or threshold before a move counts, so a score hovering near one alerts once" }
        Slider { value: margin; min: 0; max: 10; step: 1; onChange: margin = value }

        Row {
          align: center
          Text { text: lastAlert == "" ? "no alerts yet" : "last alert: ${lastAlert}"; style: small; color: muted; weight: 1 }
          Button { text: "test"; width: 72; onTap: notify("fear & greed", "notifications work; now ${round(score)}, ${zone}") }
        }
        Text { text: "Alerts are checked while the tile's page is on screen or next to it, and while this screen is open."; style: small; color: muted }

        Text { text: "updates"; style: label }
        Setting { name: "refresh every"; value: interval >= 3600 ? "1 hour" : "${int(interval / 60)} min"; note: "CNN updates the index during US market hours" }
        Row {
          gap: 6
          for o in [{s: 300, l: "5 min"}, {s: 900, l: "15 min"}, {s: 1800, l: "30 min"}, {s: 3600, l: "1 hour"}] {
            Box { weight: 1; onTap: interval = o.s; Choice { label: o.l; on: interval == o.s; fill: width } }
          }
        }

        Row {
          gap: 8
          Button { text: "reset to defaults"; weight: 1; onTap: { alertZone = true; alertBelow = 0; alertAbove = 100; margin = 2; interval = 900; belowFired = false; aboveFired = false } }
          Button { text: "done"; color: accent; weight: 1; onTap: view = "index" }
        }
      } else {
      Gauge { s: score; rating: fg.rating; thick: 16; labels: true; height: 200; fill: width }

      Grid {
        columns: 4
        gap: 6
        Past { label: "prev close"; s: fg.previous_close }
        Past { label: "1 week ago"; s: fg.previous_1_week }
        Past { label: "1 month ago"; s: fg.previous_1_month }
        Past { label: "1 year ago"; s: fg.previous_1_year }
      }

      Text { text: "past year"; style: label }
      Canvas {
        height: 160
        fill: width
        let n = len(hist)
        let x0 = 22
        let w = width - x0 - 6
        let h = height - 18
        let k = (h - 8) / 100
        for z in zones {
          rect(x0, 4 + (100 - z.hi) * k, w, (z.hi - z.lo) * k, fill: alpha(z.c, 0.12))
        }
        for b in [25, 50, 75] {
          text("${b}", x0 - 4, 4 + (100 - b) * k, size: 9, align: end, color: muted)
        }
        if n > 1 {
          path(range(n).map(i => [x0 + i / (n - 1) * w, 4 + (100 - hist[i]) * k]), stroke: foreground, width: 1.5)
          circle(x0 + w, 4 + (100 - score) * k, 3.5, fill: get(colors, fg.rating, muted))
          let first = d.fear_and_greed_historical.data[0].x / 1000
          text(fmtTime(first, "MMM yyyy"), x0, height - 6, size: 10, align: start, color: muted)
          text(fmtTime((first + updated / 1000) / 2, "MMM"), x0 + w / 2, height - 6, size: 10, align: center, color: muted)
          text("now", x0 + w, height - 6, size: 10, align: end, color: muted)
        }
      }

      Text { text: "the seven indicators"; style: label }
      for it in indicators key it.key {
        let x = get(d, it.key)
        Column {
          gap: 4
          padding: 10
          border: 1
          borderColor: border
          Row {
            align: center
            Text { text: it.name; bold: true; weight: 1; maxLines: 1 }
            Text { text: x.score == null ? "…" : "${x.rating} · ${round(x.score)}"; style: small; width: 150; align: end; color: get(colors, x.rating, muted) }
          }
          Text { text: it.detail; style: small; color: muted }
          Progress { value: x.score; color: get(colors, x.rating, muted) }
          Sparkline { values: (x.data ?? []).map(p => p.y); color: alpha(foreground, 0.6); min: min((x.data ?? []).map(p => p.y)); height: 28; fill: width }
        }
      }

      Row {
        align: center
        Text { text: "source: CNN Business"; style: small; color: muted; weight: 1 }
        Button { text: "open on cnn"; onTap: url("https://edition.cnn.com/markets/fear-and-greed") }
      }
      }
    }
  }
}
