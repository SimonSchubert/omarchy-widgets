widget "photoprism random" {
  meta {
    owl: 5
    description: "A random photo from your PhotoPrism library. Tap the photo for the full image; ↻ loads another."
    version: "5.1"
    license: "MIT"
    category: "fun"
  }

  size: 3x4
  minSize: 2x3
  padding: 0

  requires { pacman: ["python"] }

  source sessionFile = file("~/.config/photoprism-random/session.json")
  let sessionText = trim(sessionFile)
  let session = sessionText != null && sessionText != "" ? parseJson(sessionText) : null
  let configured = session.token != null && session.token != ""

  // The photo command reads the session file itself, so sign-in has to run it again.
  state seen = ""
  state panel = "settings"
  when sessionText != null && sessionText != "" && sessionText != seen {
    seen = sessionText
    refresh()
  }

  source shot = cmd("""
python - <<'PY'
import json
import os
import pathlib
import sys
import urllib.error
import urllib.parse
import urllib.request

conf = pathlib.Path.home() / ".config" / "photoprism-random"
session_path = conf / "session.json"
cache = pathlib.Path.home() / ".cache" / "photoprism-random"


def fail(msg):
    print(msg, file=sys.stderr)
    raise SystemExit(1)


def main():
    if not session_path.is_file():
        fail("not configured")
    try:
        cfg = json.loads(session_path.read_text())
    except json.JSONDecodeError:
        fail("not configured")

    base = (cfg.get("url") or "").strip().rstrip("/")
    token = cfg.get("token") or ""
    preview = cfg.get("preview") or "public"
    scope = (cfg.get("scope") or "all").strip() or "all"
    album = (cfg.get("album") or "").strip()
    if base and "://" not in base:
        base = "https://" + base
    if not base.startswith("http://") and not base.startswith("https://"):
        fail("sign in again")
    if not token:
        fail("not configured")

    def call(path, binary=False):
        req = urllib.request.Request(
            base + path,
            headers={"X-Auth-Token": token, "Accept": "*/*"},
        )
        with urllib.request.urlopen(req, timeout=45) as res:
            raw = res.read()
            return raw if binary else json.loads(raw.decode() or "null")

    params = {
        "count": "1",
        "order": "random",
        "merged": "true",
        "primary": "true",
    }
    if scope == "favorites":
        params["favorite"] = "true"
    elif scope == "album":
        if not album:
            fail("album needs a UID")
        params["s"] = album

    try:
        photos = call("/api/v1/photos?" + urllib.parse.urlencode(params))
    except urllib.error.HTTPError as e:
        if e.code == 401:
            fail("session expired")
        fail(f"photos failed: HTTP {e.code}")
    except urllib.error.URLError as e:
        fail("network error: " + str(getattr(e, "reason", e)))
    except Exception as e:
        fail(str(e))

    if not isinstance(photos, list) or not photos:
        fail("no photos")
    item = photos[0]
    photo_hash = item.get("Hash") or ((item.get("Files") or [{}])[0].get("Hash"))
    if not photo_hash:
        fail("could not load photo")

    prefix = (
        "/api/v1/t/"
        + urllib.parse.quote(str(photo_hash), safe="")
        + "/"
        + urllib.parse.quote(str(preview), safe="")
        + "/"
    )

    def fetch_size(size):
        try:
            jpeg = call(prefix + size, binary=True)
        except urllib.error.HTTPError as e:
            if e.code == 401:
                fail("session expired")
            fail(f"image failed: HTTP {e.code}")
        except urllib.error.URLError as e:
            fail("network error: " + str(getattr(e, "reason", e)))
        if not jpeg:
            fail("could not load photo")
        return jpeg

    thumb_jpeg = fetch_size("fit_720")
    full_jpeg = fetch_size("fit_3840")

    cache.mkdir(parents=True, exist_ok=True)
    cache.chmod(0o700)

    def write_jpeg(name, data):
        dest = cache / name
        tmp = cache / f".{name}.part"
        tmp.write_bytes(data)
        tmp.chmod(0o600)
        os.replace(tmp, dest)
        return dest

    # Fixed names so a refresh doesn't leave the tile pointing at a deleted file.
    thumb = write_jpeg("widget.jpg", thumb_jpeg)
    full = write_jpeg("widget-full.jpg", full_jpeg)
    print(json.dumps({"thumb": str(thumb), "full": str(full)}))


if __name__ == "__main__":
    main()
PY
""") every 30m timeout 60s json status

  component SignIn() {
    Button {
      text: "sign in"
      color: accent
      onTap: terminal("""
python -c 'import getpass
import json
import pathlib
import sys
import urllib.error
import urllib.request

conf = pathlib.Path.home() / ".config" / "photoprism-random"
session_path = conf / "session.json"
config_path = conf / "config.json"

def load(path):
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return {}

def fail(msg):
    print(msg, file=sys.stderr)
    raise SystemExit(1)

def ask(label, default):
    prompt = f"{label} [{default}]: " if default else f"{label}: "
    return input(prompt).strip() or default

def main():
    conf.mkdir(parents=True, exist_ok=True)
    conf.chmod(0o700)
    if config_path.is_file():
        config_path.unlink()
    existing = load(session_path)
    url = ask("URL", (existing.get("url") or "").strip())
    if url and "://" not in url:
        url = "https://" + url
    url = url.rstrip("/")
    user = ask("Username", (existing.get("username") or "").strip())
    password = getpass.getpass("Password: ")
    scope = ask("Scope all/favorites/album", (existing.get("scope") or "all").strip() or "all").lower()
    album = ""
    if scope == "album":
        album = ask("Album UID", (existing.get("album") or "").strip())
    if not url.startswith("http://") and not url.startswith("https://") or " " in url:
        fail("URL needs http:// or https://")
    if not user or not password:
        fail("username and password are required")
    if scope not in ("all", "favorites", "album"):
        fail("scope is all, favorites, or album")
    if scope == "album" and not album:
        fail("album needs a UID")
    body = json.dumps({"username": user, "password": password}).encode()
    req = urllib.request.Request(
        url + "/api/v1/session",
        data=body,
        headers={"Content-Type": "application/json", "Accept": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as res:
            sess = json.loads(res.read().decode() or "null")
    except urllib.error.HTTPError as e:
        fail(f"login failed: HTTP {e.code}")
    except urllib.error.URLError as e:
        fail("network error: " + str(getattr(e, "reason", e)))
    token = (sess or {}).get("access_token") or (sess or {}).get("id")
    preview = ((sess or {}).get("config") or {}).get("previewToken") or (sess or {}).get("previewToken") or "public"
    if not token:
        fail("login failed")
    data = {
        "url": url,
        "username": user,
        "token": token,
        "preview": preview,
        "scope": scope,
        "album": album,
    }
    session_path.write_text(json.dumps(data) + "\n")
    session_path.chmod(0o600)
    print("signed in")

try:
    main()
except KeyboardInterrupt:
    print()
    raise SystemExit(1)
'
""", "PhotoPrism")
    }
  }

  if !configured {
    Column {
      justify: center
      align: center
      gap: 10
      fill: true
      padding: 12
      Text { text: "photoprism"; style: muted }
      Text { text: "not signed in"; style: title }
      SignIn {}
    }
  } else if shot == null {
    Column {
      justify: center
      align: center
      fill: true
      padding: 12
      Text { text: "loading…"; style: title }
    }
  } else if !shot.ok {
    Column {
      justify: center
      gap: 8
      fill: true
      padding: 12
      Text { text: "photoprism"; style: muted }
      Text { text: shot.err != "" ? shot.err : "could not load photo"; style: small; maxLines: 5 }
      SignIn {}
      Button { text: "retry"; onTap: refresh() }
      Button { text: "sign out"; onTap: run("rm -f ~/.config/photoprism-random/session.json ~/.config/photoprism-random/config.json; find ~/.cache/photoprism-random -maxdepth 1 -type f -delete 2>/dev/null; true") }
    }
  } else {
    Box {
      fill: true
      Image {
        src: shot.out.thumb
        fit: cover
        fill: true
        onTap: {
          panel = "photo"
          screen()
        }
      }
      Box {
        align: topEnd
        padding: 6
        Row {
          gap: 6
          Button { text: "↻"; onTap: refresh() }
          Button {
            text: "⚙"
            onTap: {
              panel = "settings"
              screen()
            }
          }
        }
      }
    }
  }

  screen {
    title: panel == "photo" ? "" : "PhotoPrism"
    if panel == "photo" {
      Box {
        fill: true
        background: "#000000"
        Image {
          src: shot.ok ? shot.out.full : null
          fit: contain
          fill: true
          onTap: close()
        }
      }
    } else {
      Column {
        gap: 10
        padding: 16
        if session.url != null && session.url != "" {
          Text { text: session.url; style: small; maxLines: 2 }
        }
        if session.username != null && session.username != "" {
          Text { text: session.username; style: muted }
        }
        SignIn {}
        Button { text: "sign out"; onTap: run("rm -f ~/.config/photoprism-random/session.json ~/.config/photoprism-random/config.json; find ~/.cache/photoprism-random -maxdepth 1 -type f -delete 2>/dev/null; true") }
        Button { text: "close"; onTap: close() }
      }
    }
  }
}
