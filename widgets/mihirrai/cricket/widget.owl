widget "cricket" {
  meta { owl: 9; description: "Live cricket scores from Cricbuzz: every match at a glance, live ones first. Tap a match for the scorecard - batsmen, bowlers, rates, recent balls - or the tile for the full board"; version: "1.5"; license: "MIT"; category: "sport" }

  page: 2
  order: 2
  size: 3x4
  minSize: 3x3
  padding: 8

  requires { pacman: ["python"] }

  // Cricbuzz's own JSON endpoints answer empty these days, so this reads the live-scores
  // page and lifts the match list out of the Next.js payload the page ships with.
  // The page is ~200 KB of HTML but only ~38 KB gzipped, which is what the phone asks for.
  source s = cmd("""
python3 - <<'PY'
import gzip, json, re, sys, urllib.request

PAGE = "https://www.cricbuzz.com/cricket-match/live-scores"
AGENT = "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
# States that mean the match is over; anything else with a state is being played now.
FINISHED = {"Complete", "Abandoned", "No Result", "Cancelled", "Postponed"}


def fetch(url):
    request = urllib.request.Request(url, headers={
        "User-Agent": AGENT,
        "Accept": "text/html,application/xhtml+xml",
        "Accept-Encoding": "gzip",
    })
    response = urllib.request.urlopen(request, timeout=25)
    body = response.read()
    if response.headers.get("Content-Encoding") == "gzip":
        body = gzip.decompress(body)
    return body.decode("utf-8", "replace")


def payload(page):
    # Join the Next.js RSC chunks the page ships; the match list is spread across them.
    decoder = json.JSONDecoder()
    chunks = []
    for piece in page.split("self.__next_f.push(")[1:]:
        try:
            decoded = decoder.raw_decode(piece, 0)[0]
        except ValueError:
            continue
        if isinstance(decoded, list) and len(decoded) == 2 and isinstance(decoded[1], str):
            chunks.append(decoded[1])
    return "".join(chunks)


def slice_array(data, key):
    # The JSON array that follows the first "key": in data, matched brackets and all.
    at = data.find('"%s":' % key)
    if at < 0:
        return None
    start = data.index("[", at)
    depth = 0
    quoted = False
    escaped = False
    for i in range(start, len(data)):
        char = data[i]
        if quoted:
            if escaped:
                escaped = False
            elif char == chr(92):
                escaped = True
            elif char == '"':
                quoted = False
        elif char == '"':
            quoted = True
        elif char == "[":
            depth += 1
        elif char == "]":
            depth -= 1
            if depth == 0:
                return json.loads(data[start:i + 1])
    return None


def overs(value):
    return "" if value is None else "%g" % value


def innings(scores):
    # A team's innings as cricket writes them: "240 & 169/4d (65.6)".
    if not scores:
        return ""
    parts = sorted(
        ((v.get("inningsId", 0), v) for k, v in scores.items() if k.startswith("inngs")),
        key=lambda pair: pair[0],
    )
    out = []
    last = len(parts) - 1
    for index, (_, part) in enumerate(parts):
        runs = part.get("runs")
        if runs is None:
            continue
        line = str(runs)
        wickets = part.get("wickets")
        # Always show how many wickets have fallen, all 10 included: a bare "223"
        # for a side that is all out reads like it is still batting.
        if wickets is not None:
            line += "/%d" % wickets
        if part.get("isDeclared"):
            line += "d"
        span = overs(part.get("overs"))
        if index == last and span:
            line += " (%s)" % span
        out.append(line)
    return " & ".join(out)


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")


def matches(page):
    slugs = {}
    for hit in re.findall("/live-cricket-scores/([0-9]+)/([a-z0-9-]+)", page):
        slugs.setdefault(hit[0], hit[1])

    listed = slice_array(payload(page), "matchesList")
    if listed is None:
        raise ValueError("the cricbuzz page has no match list")

    out = []
    for entry in listed:
        game = entry.get("match") or {}
        info = game.get("matchInfo") or {}
        scores = game.get("matchScore") or {}
        place = info.get("venueInfo") or {}
        ident = str(info.get("matchId", ""))
        one = info.get("team1") or {}
        two = info.get("team2") or {}
        state = info.get("state")
        start = info.get("startDate")
        slug = slugs.get(ident) or slugify("%s %s" % (info.get("matchDesc") or "", info.get("seriesName") or ""))
        out.append({
            "id": ident,
            "url": "https://www.cricbuzz.com/live-cricket-scores/%s/%s" % (ident, slug),
            "t1": (one.get("teamSName") or one.get("teamName") or "?")[:6],
            "t2": (two.get("teamSName") or two.get("teamName") or "?")[:6],
            "n1": one.get("teamName") or "?",
            "n2": two.get("teamName") or "?",
            "fmt": info.get("matchFormat") or "",
            "desc": info.get("matchDesc") or "",
            "series": info.get("seriesName") or "",
            "state": state or "",
            "status": info.get("status") or "",
            "short": info.get("shortStatus") or "",
            "live": bool(state) and state != "Preview" and state not in FINISHED,
            "s1": innings(scores.get("team1Score")),
            "s2": innings(scores.get("team2Score")),
            "venue": place.get("city") or place.get("ground") or "",
            # Epoch seconds; the widget formats it, so it reads in the device's own timezone.
            "start": start // 1000 if start else None,
        })
    return out


try:
    print(json.dumps({"matches": matches(fetch(PAGE))}, separators=(",", ":")))
except Exception as error:
    sys.stderr.write("cricbuzz: %s" % error)
    sys.exit(1)
PY
""") every 60s json timeout 30s status

  // Only for the day-aware "today 15:30" / "tomorrow 15:30" labels; a minute is plenty.
  source now = clock every 1m

  // Kept across restarts: a cricket fan who wants only live matches wants them every time.
  state liveOnly = false persist
  // The last board that loaded, kept across restarts. A refresh that fails keeps the
  // previous scores on screen instead of replacing them with the error (the error still
  // goes to .errors/ for owl-check). `on s first` (owl 9) runs for the first load and every
  // refresh after it, so one trigger saves what the board fetched; a failure changes nothing.
  state last = [] persist
  on s first { if value != null && value.ok { last = value.out.matches ?? [] } }
  // The match whose detail the screen is showing, by id; "" means the board. A match that
  // has rolled off the list (it finished and left the page) falls back to the board.
  state open = ""
  // The open match's own page, lifted the same way as the board: Cricbuzz ships who is at
  // the crease and bowling, the run rates, the last few balls, the toss and the player of
  // the match inside the match page's Next.js payload. Only the open match is fetched, and
  // with nothing open the program exits before touching the network. It lives in a """
  // block (where quotes need no escaping), and sh() hands the shell the whole thing as one
  // single-quoted word, so nothing in it is expanded on the way to python.
  let detailPy = """
import gzip, json, sys, urllib.request

AGENT = "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
QUOTE = chr(34)
BACKSLASH = chr(92)


def fetch(url):
    request = urllib.request.Request(url, headers={
        "User-Agent": AGENT,
        "Accept": "text/html,application/xhtml+xml",
        "Accept-Encoding": "gzip",
    })
    response = urllib.request.urlopen(request, timeout=25)
    body = response.read()
    if response.headers.get("Content-Encoding") == "gzip":
        body = gzip.decompress(body)
    return body.decode("utf-8", "replace")


def payload(page):
    decoder = json.JSONDecoder()
    chunks = []
    for piece in page.split("self.__next_f.push(")[1:]:
        try:
            decoded = decoder.raw_decode(piece, 0)[0]
        except ValueError:
            continue
        if isinstance(decoded, list) and len(decoded) == 2 and isinstance(decoded[1], str):
            chunks.append(decoded[1])
    return "".join(chunks)


def slice_braces(data, start):
    depth = 0
    quoted = False
    escaped = False
    for i in range(start, len(data)):
        char = data[i]
        if quoted:
            if escaped:
                escaped = False
            elif char == BACKSLASH:
                escaped = True
            elif char == QUOTE:
                quoted = False
        elif char == QUOTE:
            quoted = True
        elif char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return data[start:i + 1]
    return None


def objects(data, key):
    needle = QUOTE + key + QUOTE + ":"
    found = []
    at = data.find(needle)
    while at >= 0:
        start = at + len(needle)
        while start < len(data) and data[start] == " ":
            start += 1
        if start < len(data) and data[start] == "{":
            raw = slice_braces(data, start)
            if raw is not None:
                try:
                    found.append(json.loads(raw))
                except ValueError:
                    pass
        at = data.find(needle, at + 1)
    return found


def batsman(who):
    if not who or not who.get("name"):
        return None
    return {"name": who.get("name"), "runs": who.get("runs"), "balls": who.get("balls"),
            "fours": who.get("fours"), "sixes": who.get("sixes"), "sr": who.get("strikeRate")}


def bowler(who):
    if not who or not who.get("name"):
        return None
    return {"name": who.get("name"), "overs": who.get("overs"), "maidens": who.get("maidens"),
            "runs": who.get("runs"), "wickets": who.get("wickets"), "econ": who.get("economy")}


def detail(match_id):
    data = payload(fetch("https://www.cricbuzz.com/live-cricket-scores/%s" % match_id))
    mini = None
    for one in objects(data, "miniscore"):
        if one.get("batTeam"):
            mini = one
            break
    header = objects(data, "matchHeader")
    header = header[0] if header else None

    out = {"id": match_id}
    if mini:
        out["status"] = mini.get("status")
        out["crr"] = mini.get("currentRunRate")
        out["rrr"] = mini.get("requiredRunRate")
        out["target"] = mini.get("target")
        out["need"] = mini.get("remRunsToWin")
        out["recent"] = mini.get("recentOvsStats")
        out["lastWicket"] = mini.get("lastWicket")
        out["perf"] = mini.get("latestPerformance") or []
        partner = mini.get("partnerShip") or {}
        out["partnership"] = {"runs": partner.get("runs"), "balls": partner.get("balls")}
        out["batting"] = [x for x in [batsman(mini.get("batsmanStriker")), batsman(mini.get("batsmanNonStriker"))] if x]
        out["bowling"] = [x for x in [bowler(mini.get("bowlerStriker")), bowler(mini.get("bowlerNonStriker"))] if x]
        out["innings"] = (mini.get("matchScoreDetails") or {}).get("inningsScoreList") or []
    if header:
        out["state"] = header.get("state")
        out["status"] = out.get("status") or header.get("status")
        out["dayNight"] = header.get("dayNight")
        out["startLocal"] = header.get("matchStartTimeLocal")
        toss = header.get("tossResults") or {}
        if toss.get("tossWinnerName"):
            decision = (toss.get("decision") or "").lower()
            if decision == "bowling":
                decision = "bowl"
            elif decision == "batting":
                decision = "bat"
            out["toss"] = "%s won the toss and elected to %s" % (toss.get("tossWinnerName"), decision)
        pom = header.get("playersOfTheMatch") or []
        if pom:
            who = pom[0]
            summary = " ".join([x for x in [who.get("battingSummary"), who.get("bowlingSummary")] if x])
            out["pom"] = {"name": who.get("name"), "summary": summary}
    return out


try:
    match_id = sys.argv[1] if len(sys.argv) > 1 else ""
    print(json.dumps(detail(match_id) if match_id else None, separators=(",", ":")))
except Exception as error:
    sys.stderr.write("cricbuzz detail: %s" % error)
    sys.exit(1)
"""
  source detail = cmd("python3 -c ${sh(detailPy)} ${sh(open)}") every 30s json timeout 30s status
  let matches = s != null && s.ok ? (s.out.matches ?? []) : last
  // Live first, then the ones about to start (soonest first), then results (newest first).
  let live = matches.filter(m => m.live).sortBy(m => m.start ?? 0)
  let soon = matches.filter(m => !m.live && m.state == "Preview").sortBy(m => m.start ?? 0)
  let done = matches.filter(m => !m.live && m.state != "Preview").sortBy(m => -(m.start ?? 0))
  // flatten joins the three lists one level (owl 9's depth), not their matches.
  let ordered = flatten([live, soon, done], 1)
  let shown = liveOnly ? live : ordered
  // The match whose detail the screen is showing, by id; "" means the board. A match that
  // has rolled off the list (it finished and left the page) falls back to the board.
  let viewing = open == "" ? null : matches.find(m => m.id == open)

  // Tapping the tile's background always lands on the board, even if a detail was left open;
  // tapping a match (below) opens that match's detail instead.
  onTap: { open = ""; screen() }

  // The live marker: a solid dot with a soft halo and a ring that pulses out of it, one
  // pulse every two seconds so it reads as "live" without blinking. The ring is eased and
  // kept inside the 12 dp box so it never clips against the edge. It only reads `time`, so
  // it only animates while a live match is on screen.
  component Dot() {
    Canvas {
      width: 12
      height: 12
      let t = (time % 2) / 2
      // ease out: the ring races away, then lingers while it fades
      let e = 1 - pow(1 - t, 2)
      circle(6, 6, 5.4, fill: radial(6, 6, 5.4, [alpha(red, 0.30), alpha(red, 0)]))
      circle(6, 6, 3.2 + e * 2, stroke: alpha(red, (1 - t) * 0.75), width: 1)
      circle(6, 6, 3, fill: red)
    }
  }

  // A team's line, with the name in a fixed column so the runs and overs line up down the tile.
  let teamW = 46
  component Score(team, line) {
    Row {
      gap: 6
      Text { text: team; font: mono; fontSize: 12; color: muted; width: teamW; maxLines: 1 }
      Text { text: line; font: mono; fontSize: 12; color: foreground; weight: 1; maxLines: 1 }
    }
  }

  // The filter switch at the top of the screen: a filled pill when it's the active one.
  component Pill(label, on, value) {
    Button {
      text: label
      color: on ? background : foreground
      background: on ? accent : alpha(muted, 0.15)
      radius: 6 * corners
      onTap: { haptic(); liveOnly = value }
    }
  }

  // One match, full width, as the board shows it: status, both innings, the line that
  // matters (result, "trail by 20", "starts in 1h 10m") and where it is being played.
  component Card(m) {
    let when = m.start == null ? "" : fmtTime(m.start, "EEE HH:mm") + " your time"
    let note = m.live ? ((m.short ?? "") != "" ? m.short : (m.status ?? ""))
      : m.state == "Preview" ? (m.start != null && m.start > now ? "starts in ${fmtDuration(m.start - now)} · ${when}" : m.status)
      : m.status
    Column {
      gap: 3
      padding: [12, 10]
      radius: 10 * corners
      border: 1
      borderColor: m.live ? alpha(red, 0.5) : alpha(muted, 0.22)
      background: alpha(red, m.live ? 0.12 : 0)
      onTap: { haptic(); open = m.id }
      Row {
        gap: 8
        align: center
        Text { text: m.live ? "● LIVE" : m.state == "Preview" ? "UPCOMING" : "RESULT"; style: label; bold: m.live; color: m.live ? red : muted; width: 84; maxLines: 1 }
        Text { text: [m.fmt, m.desc].filter(x => x != "").join(" · "); style: label; color: muted; weight: 1; align: end; maxLines: 1 }
      }
      if (m.s1 ?? "") == "" {
        // Not a ball bowled yet: both names on one line, the way a fixture reads.
        Text { text: "${m.n1} v ${m.n2}"; style: body; maxLines: 1 }
      } else {
        Row {
          gap: 8
          align: bottom
          Text { text: m.n1; style: body; weight: 1; maxLines: 1 }
          Text { text: m.s1; font: mono; fontSize: 14; bold: true; width: 150; align: end; maxLines: 1 }
        }
        if (m.s2 ?? "") != "" {
          Row {
            gap: 8
            align: bottom
            Text { text: m.n2; style: body; weight: 1; maxLines: 1 }
            Text { text: m.s2; font: mono; fontSize: 14; bold: true; width: 150; align: end; maxLines: 1 }
          }
        } else {
          Text { text: "${m.n2}  yet to bat"; style: body; color: muted; maxLines: 1 }
        }
      }
      Text { text: note; style: small; color: m.live ? foreground : muted; maxLines: 2 }
      Text { text: [m.series, m.venue].filter(x => x != "").join(" · "); style: small; color: muted; maxLines: 2 }
    }
  }

  // A small labelled number for the detail screen's stats strip.
  component Stat(label, value) {
    Column {
      gap: 0
      width: 104
      Text { text: label; style: label; color: muted; maxLines: 1 }
      Text { text: value; font: mono; fontSize: 13; maxLines: 1 }
    }
  }

  // One batsman at the crease: who, how they are going, and their boundaries and rate.
  component Bat(b) {
    Row {
      gap: 10
      align: center
      Column {
        gap: 0
        weight: 1
        Text { text: b.name; style: body; maxLines: 1 }
        Text { text: "${b.fours} fours · ${b.sixes} sixes · SR ${b.sr}"; style: small; color: muted; maxLines: 1 }
      }
      Text { text: "${b.runs} (${b.balls})"; font: mono; fontSize: 16; bold: true; width: 96; align: end; maxLines: 1 }
    }
  }

  // One bowler: name and economy, then the O-M-R-W figures Cricbuzz leads with.
  component Bowl(b) {
    Row {
      gap: 10
      align: center
      Column {
        gap: 0
        weight: 1
        Text { text: b.name; style: body; maxLines: 1 }
        Text { text: "economy ${b.econ} · ${b.maidens} maidens"; style: small; color: muted; maxLines: 1 }
      }
      Text { text: "${b.overs}-${b.maidens}-${b.runs}-${b.wickets}"; font: mono; fontSize: 13; color: muted; width: 96; align: end; maxLines: 1 }
    }
  }

  // One ball of the recent overs, tinted the way Cricbuzz tints its balls: a wicket on red,
  // a boundary in the theme's accent, everything else quiet. Sized to its own text, since a
  // Text in a Row would otherwise take the whole width.
  component Ball(x) {
    let hit = x == "W"
    let runs = x == "4" || x == "6"
    Text {
      text: x
      font: mono
      fontSize: 12
      width: 18 + len(x) * 8
      align: center
      color: hit ? background : runs ? accent : foreground
      background: hit ? red : runs ? alpha(accent, 0.20) : alpha(muted, 0.15)
      padding: [0, 4]
      radius: 5 * corners
      maxLines: 1
    }
  }

  // One match on its own screen, opened by tapping a row on the tile or a card on the
  // board: the full picture for that game, the way Cricbuzz's own match page opens it --
  // the batsmen at the crease, the bowlers, the rates, the last few balls -- and a way
  // out to Cricbuzz if the user wants the rest.
  component Detail(m) {
    // The fetched scorecard, only when it belongs to the match being shown: an answer for
    // the match opened a moment ago must not leak onto this one while the new one loads.
    let d = detail != null && detail.ok && detail.out != null && detail.out.id == m.id ? detail.out : null
    let batting = d == null ? [] : (d.batting ?? [])
    let bowling = d == null ? [] : (d.bowling ?? [])
    let perf = d == null ? [] : (d.perf ?? [])
    let balls = (d == null ? [] : split(d.recent ?? "", " ")).filter(x => x != "" && x != "|" && x != "...")
    let chasing = d != null && d.target != null && d.need != null && d.need > 0
    let when = m.start == null ? "" : fmtTime(m.start, "EEE d MMM · HH:mm") + " your time"
    let note = m.live ? ((m.short ?? "") != "" ? m.short : (m.status ?? ""))
      : m.state == "Preview" ? (m.start != null && m.start > now ? "starts in ${fmtDuration(m.start - now)}" : (m.status ?? ""))
      : (m.status ?? "")
    let where = [m.series, m.venue].filter(x => x != "").join(" · ")
    Column {
      gap: 12
      fill: true
      Row {
        gap: 8
        align: center
        Button { text: "‹ board"; color: muted; onTap: { haptic(); open = "" } }
        Spacer { weight: 1 }
        Text { text: m.live ? "● LIVE" : m.state == "Preview" ? "UPCOMING" : "RESULT"; style: label; bold: m.live; color: m.live ? red : muted; maxLines: 1 }
      }
      Column {
        gap: 14
        weight: 1
        scroll: true
        Column {
          gap: 12
          padding: [16, 14]
          radius: 12 * corners
          border: 1
          borderColor: m.live ? alpha(red, 0.5) : alpha(muted, 0.22)
          background: alpha(red, m.live ? 0.12 : 0)
          Text { text: [m.fmt, m.desc].filter(x => x != "").join(" · "); style: label; color: muted; maxLines: 1 }
          Row {
            gap: 10
            align: bottom
            Text { text: m.n1; style: title; weight: 1; maxLines: 2 }
            Text { text: (m.s1 ?? "") != "" ? m.s1 : "—"; font: mono; fontSize: 20; bold: true; width: 200; align: end; maxLines: 1 }
          }
          if (m.s2 ?? "") != "" {
            Row {
              gap: 10
              align: bottom
              Text { text: m.n2; style: title; weight: 1; maxLines: 2 }
              Text { text: m.s2; font: mono; fontSize: 20; bold: true; width: 200; align: end; maxLines: 1 }
            }
          } else {
            Text { text: "${m.n2} · yet to bat"; style: title; color: muted; maxLines: 2 }
          }
          if note != "" { Text { text: note; style: body; color: m.live ? foreground : muted; maxLines: 3 } }
        }
        if d == null && m.live && (detail == null || detail.ok) { Text { text: "loading the scorecard…"; style: small; color: muted } }
        if detail != null && detail.ok == false && m.live { Text { text: "scorecard unavailable"; style: small; color: muted } }
        if batting.length > 0 || bowling.length > 0 {
          Column {
            gap: 10
            padding: [14, 12]
            radius: 12 * corners
            border: 1
            borderColor: alpha(muted, 0.22)
            if batting.length > 0 {
              Text { text: m.live ? "at the crease" : "batting"; style: label; color: muted }
              for b in batting key b.name {
                Bat { b: b }
              }
            }
            if bowling.length > 0 {
              Text { text: "bowling"; style: label; color: muted }
              for b in bowling key b.name {
                Bowl { b: b }
              }
            }
          }
        }
        if d != null && d.crr != null {
          // A Flow, so the stats wrap on a narrow phone and spread across a wide one.
          Flow {
            gap: 14
            Stat { label: "CRR"; value: "${d.crr}" }
            if chasing { Stat { label: "RRR"; value: "${d.rrr}" } }
            if d.target != null { Stat { label: "target"; value: "${d.target}" } }
            if d.partnership != null && d.partnership.runs != null { Stat { label: "partnership"; value: "${d.partnership.runs} (${d.partnership.balls})" } }
            if chasing { Stat { label: "to win"; value: "${d.need}" } }
            for p in perf key p.label {
              Stat { label: lower(p.label); value: "${p.runs}/${p.wkts}" }
            }
          }
        }
        if balls.length > 0 {
          Column {
            gap: 6
            Text { text: m.live ? "this over" : "recent overs"; style: label; color: muted }
            Flow {
              gap: 4
              for x in balls {
                Ball { x: x }
              }
            }
          }
        }
        if d != null && (d.lastWicket ?? "") != "" { Text { text: "last wicket  ${d.lastWicket}"; style: small; color: muted; maxLines: 3 } }
        if d != null && (d.toss ?? "") != "" { Text { text: "toss  ${d.toss}"; style: small; color: muted; maxLines: 2 } }
        if d != null && d.pom != null { Text { text: "player of the match  ${d.pom.name}  ${d.pom.summary}"; style: small; color: muted; maxLines: 2 } }
        if where != "" { Text { text: where; style: small; color: muted; maxLines: 3 } }
        if when != "" { Text { text: when; style: small; color: muted; maxLines: 1 } }
      }
      Row {
        gap: 8
        Button { text: "open on cricbuzz ↗"; onTap: { haptic(); url(m.url) } }
        Button { text: "refresh"; color: muted; onTap: { haptic(); refresh() } }
      }
    }
  }

  component Match(m) {
    // Live matches read "Trail by 27"; upcoming ones read how long until the start (owl 9's
    // fmtAgo) and the start time in the device's timezone (with "today"/"tomorrow" when that
    // helps); finished ones read the result. The day is the calendar day, not "under 24
    // hours away": a 05:30 start seen at 22:00 is tomorrow, not today.
    let day = m.start == null ? "" : fmtTime(m.start, "yyyy-MM-dd")
    let when = m.start == null ? ""
      : day == fmtTime(now, "yyyy-MM-dd") ? "today " + fmtTime(m.start, "HH:mm")
      : day == fmtTime(now + 86400, "yyyy-MM-dd") ? "tomorrow " + fmtTime(m.start, "HH:mm")
      : fmtTime(m.start, "EEE HH:mm")
    let away = m.state == "Preview" && m.start != null && m.start > now ? fmtAgo(m.start, now) : ""
    let note = m.live || m.state != "Preview" ? ((m.short ?? "") != "" ? m.short : (m.status ?? "")) : [away, when, m.venue].filter(x => x != "").join(" · ")
    Column {
      gap: 2
      padding: [8, 5]
      radius: 8 * corners
      background: alpha(red, m.live ? 0.10 : 0)
      onTap: { haptic(); open = m.id; screen() }
      Row {
        gap: 6
        align: center
        Text { text: "${m.t1} v ${m.t2}"; bold: true; weight: 1; maxLines: 1 }
        // The dot goes before the format so the format still ends at the tile's edge; the
        // slot is always reserved, so the format column stays lined up down the tile.
        if m.live { Dot { } } else { Spacer { width: 12 } }
        Text { text: m.fmt; style: label; color: muted; width: 34; align: end; maxLines: 1 }
      }
      if (m.s1 ?? "") != "" { Score { team: m.t1; line: m.s1 } }
      if (m.s2 ?? "") != "" { Score { team: m.t2; line: m.s2 } }
      Text { text: note; style: small; color: m.live ? foreground : muted; maxLines: 1 }
    }
  }

  if matches.length == 0 {
    Column {
      gap: 6
      justify: center
      fill: true
      Text { text: "cricket"; style: muted }
      Text {
        text: s == null ? "loading…" : s.ok == false && (s.err ?? "") != "" ? s.err : "no matches right now"
        style: small
        color: muted
        maxLines: 3
      }
      Button { text: "retry"; onTap: { haptic(); refresh() } }
    }
  } else {
    Column {
      gap: 6
      fill: true
      Row {
        gap: 6
        align: center
        Text { text: "cricket"; style: muted; weight: 1; maxLines: 1 }
        Text {
          text: live.length > 0 ? "${live.length} live" : "${matches.length} matches"
          style: label
          color: live.length > 0 ? red : muted
          width: 96
          align: end
          maxLines: 1
        }
      }
      Column {
        gap: 6
        weight: 1
        scroll: true
        for m in shown key m.id {
          Match { m: m }
        }
      }
    }
  }

  screen {
    title: viewing != null ? "${viewing.t1} v ${viewing.t2}" : "cricket"
    // One pass over the board, split into the three groups (owl 9's groupBy); each keeps
    // the order `shown` already has. Groups run live, upcoming, results, so the board reads
    // "what's happening, what's next, what happened".
    let parts = groupBy(shown, m => m.live ? "live" : m.state == "Preview" ? "upcoming" : "results")
    let groups = [
      { title: "live now"; tint: red; rows: parts.live ?? [] },
      { title: "upcoming"; tint: accent; rows: parts.upcoming ?? [] },
      { title: "results"; tint: muted; rows: parts.results ?? [] }
    ]

    // A tapped match takes over the whole screen; the back button returns to the board.
    if viewing != null {
      Detail { m: viewing }
    } else {
      Column {
        gap: 12
        fill: true
        Row {
          gap: 6
          align: center
          Pill { label: "all"; on: !liveOnly; value: false }
          Pill { label: "live"; on: liveOnly; value: true }
          Spacer { weight: 1 }
          Button { text: "refresh"; color: muted; onTap: { haptic(); refresh() } }
        }
        Column {
          gap: 16
          weight: 1
          scroll: true
          if shown.length == 0 {
            Text { text: liveOnly ? "nothing live right now" : "no matches right now"; style: small; color: muted }
            if liveOnly {
              Button { text: "show all"; color: muted; onTap: { haptic(); liveOnly = false } }
            }
          } else {
            for g in groups {
              if g.rows.length > 0 {
                Column {
                  gap: 8
                  Row {
                    gap: 8
                    align: center
                    Text { text: g.title; style: label; color: g.tint; weight: 1; maxLines: 1 }
                    Text { text: "${g.rows.length}"; style: label; color: muted; width: 24; align: end; maxLines: 1 }
                  }
                  for m in g.rows key m.id {
                    Card { m: m }
                  }
                }
              }
            }
            Row {
              justify: end
              Button { text: "open cricbuzz ↗"; color: muted; onTap: url("https://www.cricbuzz.com/cricket-match/live-scores") }
            }
          }
        }
      }
    }
  }
}
