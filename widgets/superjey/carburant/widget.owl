widget "carburant" {
  size: 3x5
  minSize: 3x4

  requires { pacman: ["curl"] }
  meta { description: "Fuel prices at nearby stations: distance, E10/SP98/Gazole/E85 and the cheapest highlighted. Set your town, fuel and radius"; version: "1.0"; license: "MIT"; category: "finance"; owl: 6 }

  // Fallback position from the connection's IP (city-level), no shell.
  source geo = http("http://ip-api.com/json/?fields=status,lat,lon,city") every 12h json timeout 10s
  let okgeo = geo != null && geo.status == "success"

  // The town you live in, typed in the screen; kept across restarts.
  state city = "" persist
  state radiusKm = 25 persist
  source place = cmd("[ -n ${sh(city)} ] && curl -sS -m 10 -G --data-urlencode q=${sh(city)} --data 'type=municipality' --data 'limit=1' 'https://api-adresse.data.gouv.fr/search/' || echo '{\"features\":[]}'") every 12h json timeout 15s status
  let hit = place != null && place.ok ? place.out.features[0] : null
  let loc = hit != null
    ? { lat: hit.geometry.coordinates[1], lon: hit.geometry.coordinates[0], label: hit.properties.label }
    : okgeo ? { lat: geo.lat, lon: geo.lon, label: geo.city } : { lat: null, lon: null, label: null }
  let hasLoc = loc.lat != null

  state fuel = "SP95-E10" persist
  state everyH = 3 persist

  // Polls often, but only refetches when the cache is older than the chosen interval.
  let everyS = everyH * 3600
  source stations = cmd("[ ${int(hasLoc)} -eq 1 ] && { f=$HOME/.cache/owl-carburant.json; now=$(date +%s); mt=$(stat -c %Y $f 2>/dev/null || echo 0); if [ -s $f ] && [ $((now - mt)) -lt ${int(everyS)} ]; then cat $f; else if out=$(curl -sS --max-time 20 'https://api.prix-carburants.2aaz.fr/stations/around/${fixed(loc.lat, 4)},${fixed(loc.lon, 4)}?types=R&responseFields=Address,Fuels,Prices'); then printf %s \"$out\" > $f; printf %s \"$out\"; elif [ -s $f ]; then cat $f; fi; fi; } || echo '[]'") every 15m json timeout 30s status

  on city { run("rm -f ~/.cache/owl-carburant.json") }

  let list = stations != null && stations.ok ? (stations.out ?? []) : []
  let rows = list.map(s => ({
    name: s.name,
    city: s.Address.City.name,
    dist: s.Distance.value,
    lat: s.Coordinates.latitude,
    lon: s.Coordinates.longitude,
    price: (s.Fuels.find(f => f.shortName == fuel) ?? {Price: {value: null}}).Price.value
  })).filter(r => r.dist <= radiusKm * 1000)
  let tileRows = rows.take(3)
  let allRows = rows.take(20)
  let priced = allRows.filter(r => r.price != null)
  let cheapest = priced.length > 0 ? priced.sortBy(r => r.price)[0].price : null

  let fuels = ["SP95-E10", "SP98", "Gazole", "E85"]
  let fuelLabel = fuel == "SP95-E10" ? "E10" : fuel == "Gazole" ? "Gazole" : fuel
  let intervals = [3, 6, 12, 24]
  let radii = [5, 10, 25, 50, 100]

  onTap: screen()

  Column {
    gap: 4
    fill: true
    justify: spaceBetween
    Row {
      align: center
      Text { text: loc.label ?? "set your city"; style: muted; weight: 1; maxLines: 1 }
      Button { text: "↻"; onTap: run("rm -f ~/.cache/owl-carburant.json") }
    }
    Row {
      gap: 4
      Button { text: fuelLabel; weight: 1; onTap: fuel = fuels[(fuels.indexOf(fuel) + 1) % fuels.length] }
      Button { text: "${radiusKm}km"; weight: 1; onTap: radiusKm = radii[(radii.indexOf(radiusKm) + 1) % radii.length] }
    }
    if !hasLoc {
      Text { text: "open to set your town"; style: small }
    } else if stations != null && !stations.ok {
      Text { text: stations.code == 124 ? "timeout" : "offline — tap ↻"; style: small; color: red }
    } else if allRows.length == 0 && stations != null {
      Text { text: "no station within ${radiusKm} km"; style: small }
    }
    for r in tileRows key "${r.lat},${r.lon}" {
      Row {
        align: center
        Column {
          gap: 0
          weight: 1
          Text { text: r.name; style: small; bold: r.price != null && r.price == cheapest; maxLines: 1 }
          Text { text: "${r.city} · ${r.dist >= 1000 ? "${round(r.dist / 1000, 1)} km" : "${r.dist} m"}"; style: label; color: muted; maxLines: 1 }
        }
        Text {
          text: r.price == null ? "–" : fixed(r.price, 3)
          style: body
          bold: r.price != null && r.price == cheapest
          color: r.price != null && r.price == cheapest ? green : foreground
          width: 50
          align: end
        }
      }
    }
  }

  screen {
    title: "carburant"
    Column {
      gap: 8
      scroll: true
      Row {
        align: center
        Input {
          text: city
          placeholder: "ta ville…"
          weight: 1
          onSubmit: city = trim(value)
        }
        Button { text: "${radiusKm} km"; onTap: radiusKm = radii[(radii.indexOf(radiusKm) + 1) % radii.length] }
      }
      Row {
        align: center
        Text { text: !hasLoc ? "set your town above" : city != "" ? "${loc.label} · ${allRows.length} stations" : "IP: ${loc.label}"; style: muted; weight: 1; maxLines: 1 }
        Button { text: fuel; onTap: fuel = fuels[(fuels.indexOf(fuel) + 1) % fuels.length] }
        Button { text: "${everyH}h"; onTap: everyH = intervals[(intervals.indexOf(everyH) + 1) % intervals.length] }
        Button { text: "refresh"; onTap: run("rm -f ~/.cache/owl-carburant.json") }
      }
      if place != null && place.ok && city != "" && hit == null {
        Text { text: "ville introuvable"; style: small; color: yellow }
      }
      if hasLoc && stations != null && !stations.ok {
        Text { text: stations.code == 124 ? "timeout" : "offline — tap refresh"; style: small; color: red }
      } else if hasLoc && allRows.length == 0 && stations != null {
        Text { text: "no station within ${radiusKm} km"; style: small }
      }
      for r in allRows key "${r.lat},${r.lon}" {
        Row {
          align: center
          border: 1
          borderColor: border
          radius: 8 * (corners ?? 1)
          padding: [8, 6]
          // enc() needs owl 8, so the few characters that would break the geo: query are escaped by hand
          onTap: url("geo:${r.lat},${r.lon}?q=${replace(replace(replace(replace("station essence ${r.name} ${r.city}", "%", "%25"), "&", "%26"), "#", "%23"), " ", "%20")}")
          Column {
            gap: 0
            weight: 1
            Text { text: r.name; style: body; bold: r.price != null && r.price == cheapest; maxLines: 1 }
            Text { text: "${r.city} · ${r.dist >= 1000 ? "${round(r.dist / 1000, 1)} km" : "${r.dist} m"}"; style: small; color: muted; maxLines: 1 }
          }
          Text {
            text: r.price == null ? "–" : fixed(r.price, 3)
            style: title
            bold: r.price != null && r.price == cheapest
            color: r.price != null && r.price == cheapest ? green : foreground
            width: 64
            align: end
          }
        }
      }
      Button { text: "close"; onTap: close() }
    }
  }
}
