widget "offgrid solar" {
  meta { owl: 5; description: "Monitor Victron VRM solar power, battery charge and daily yield. Tap to connect your installation."; version: "1.2.0"; license: "MIT"; category: "home" }
  size: 3x3
  minSize: 3x2
  state site = "" persist
  state token = "" persist
  state editing = false
  state draftSite = ""
  state draftToken = ""
  state chartMetric = "off" persist
  state chartPeriod = "day" persist
  state displaySettings = false
  state setupError = ""
  let validDraft = match(draftSite, "^[0-9]+$") != null && len(draftToken) > 0
  let configured = match(site, "^[0-9]+$") != null && len(token) > 0
  source vrm = http(configured ? "https://vrmapi.victronenergy.com/v2/installations/${site}/diagnostics" : null, {"x-authorization": "Token ${token}"}) every 1m json timeout 25s status
  source now = clock every 1m
  let records = configured && vrm.ok && vrm.out.success == true ? (vrm.out.records ?? []) : []
  let pv = filter(records, r => r.code == "PVP")
  let yields = filter(records, r => r.code == "YT")
  let previous = filter(records, r => r.code == "YY")
  let peaks = filter(records, r => r.code == "MCPT")
  let outputs = filter(records, r => r.code == "OP1" || r.code == "OP2" || r.code == "OP3")
  let d = {
    solar: find(records, r => r.code == "Pdc").rawValue ?? (len(pv) > 0 ? sum(map(pv, r => r.rawValue)) : null),
    soc: find(records, r => r.code == "bs").rawValue,
    battery: find(records, r => r.code == "bp").rawValue,
    voltage: find(records, r => r.code == "bv").rawValue,
    current: find(records, r => r.code == "bc").rawValue,
    dc: find(records, r => r.code == "dc").rawValue,
    ac: len(outputs) > 0 ? sum(map(outputs, r => r.rawValue)) : null,
    yield: len(yields) > 0 ? sum(map(yields, r => r.rawValue)) : null,
    yesterday: len(previous) > 0 ? sum(map(previous, r => r.rawValue)) : null,
    peak: len(peaks) > 0 ? sum(map(peaks, r => r.rawValue)) : null,
    time: find(records, r => r.code == "bs").timestamp
  }
  let stale = d.time != null && now - d.time > 1800
  let solarText = d.solar == null ? "… W" : abs(d.solar) >= 1000 ? "${fixed(d.solar / 1000, 1)}kW" : "${round(d.solar)} W"
  let batteryColor = d.soc < 20 ? red : green
  let connected = vrm.ok && vrm.out.success == true
  let connectionText = vrm == null ? "Connecting…" : connected ? "Connected to VRM" : vrm.code == 401 || vrm.code == 403 ? "Access denied. Check your token and installation access." : "Unable to load VRM data. Check your connection and installation ID."
  // Use actual tile dimensions: cell sizes differ between phones and tablets.
  let tileW = tileWidth ?? 180
  let tileH = tileHeight ?? 180
  let compact = tileH < 170
  let wide = tileW >= 340 && tileH >= 180
  let uiScale = clamp(min(tileW / (wide ? 360 : 180), tileH / (compact ? 130 : 210)), 0.85, 1.8)
  let labelSize = 11 * uiScale
  let valueSize = 30 * uiScale
  let showExtra = tileH >= 205
  let showChart = chartMetric != "off" && tileH >= (wide ? 250 : 230)
  let periodSeconds = chartPeriod == "month" ? 30 * 86400 : chartPeriod == "week" ? 7 * 86400 : 86400
  let historyEnd = floor(now / 900) * 900
  let historyStart = historyEnd - periodSeconds
  let intervalName = chartPeriod == "month" ? "days" : "hours"
  let binSeconds = chartPeriod == "month" ? 86400 : 3600
  source past = http(configured && chartMetric != "off" ? "https://vrmapi.victronenergy.com/v2/installations/${site}/stats?type=live_feed&interval=${intervalName}&start=${historyStart}&end=${historyEnd}" : null, {"x-authorization": "Token ${token}"}) every 15m json timeout 25s status
  let chartCode = chartMetric == "battery" ? "bs" : chartMetric == "consumption" ? "total_consumption" : "total_solar_yield"
  let series = past.ok && past.out.success == true ? get(past.out.records, chartCode, []) : []
  let points = series == false || series == null ? [] : filter(series, p => p[0] != null && p[1] != null)
  let chartValues = map(points, p => p[1])
  let chartTitle = chartMetric == "battery" ? "Battery level" : chartMetric == "consumption" ? "Consumption" : "Solar production"
  let periodTitle = chartPeriod == "month" ? "30 days" : chartPeriod == "week" ? "7 days" : "24 hours"
  let chartUnit = chartMetric == "battery" ? "%" : chartPeriod == "month" ? "kWh / day" : "kWh / hour"
  let chartColor = chartMetric == "battery" ? green : chartMetric == "consumption" ? accent : yellow
  let chartMax = chartMetric == "battery" ? 100 : max(max(chartValues) ?? 0, 0.01)
  let chartMessage = past == null ? "Loading history…" : !past.ok || past.out.success != true ? "History unavailable · try refresh" : len(points) == 0 ? "No readings in this period" : ""

  component SolarBlock {
    Column {
      gap: 1
      Text { text: solarText; fontSize: valueSize; color: yellow; maxLines: 1 }
      Text { text: "solar power"; fontSize: labelSize; color: muted; maxLines: 1 }
    }
  }
  component BatteryBlock {
    Column {
      gap: 3 * uiScale
      Row {
        Text { text: "battery"; fontSize: labelSize; weight: 1; maxLines: 1 }
        Text { text: "${round(d.soc)}%"; fontSize: 21 * uiScale; width: 64 * uiScale; align: end; color: batteryColor; maxLines: 1 }
      }
      Progress { value: d.soc; color: batteryColor }
      Text { text: d.battery == null ? "…" : d.battery < 0 ? "Using ${round(abs(d.battery))} W" : "Charging ${round(d.battery)} W"; fontSize: labelSize; maxLines: 1 }
    }
  }
  component Trend(textSize = 11) {
    Column {
      gap: 4
      Text { text: textSize < 12 ? "${chartMetric == 'battery' ? 'Battery' : chartMetric == 'consumption' ? 'Use' : 'Solar'} · ${chartPeriod == 'day' ? '24h' : chartPeriod == 'week' ? '7d' : '30d'}" : "${chartTitle} · ${periodTitle}"; fontSize: textSize; color: chartColor; maxLines: 1 }
      if len(points) == 0 {
        Text { text: chartMessage; fontSize: textSize; color: muted }
      } else {
        Text { text: "0–${fixed(chartMax, chartMetric == 'battery' ? 0 : 2)} ${chartUnit}"; fontSize: textSize; color: muted; maxLines: 1 }
        Canvas {
          fill: width
          weight: 1
          let w = max(width - 2, 1)
          let h = max(height - 4, 1)
          line(1, h + 2, w + 1, h + 2, stroke: alpha(muted, 0.3))
          for p, i in points {
            let x = clamp((p[0] / 1000 - historyStart) / periodSeconds, 0, 1) * w + 1
            let y = h + 2 - clamp(p[1] / chartMax, 0, 1) * h
            if chartMetric == "battery" {
              circle(x, y, 1.5, fill: chartColor)
              if i > 0 && p[0] - points[i - 1][0] <= binSeconds * 1500 {
                let previous = points[i - 1]
                let px = clamp((previous[0] / 1000 - historyStart) / periodSeconds, 0, 1) * w + 1
                let py = h + 2 - clamp(previous[1] / chartMax, 0, 1) * h
                line(px, py, x, y, stroke: chartColor, width: 2)
              }
            } else {
              let bw = max(w * binSeconds / periodSeconds * 0.8, 1)
              rect(max(1, x - bw / 2), y, min(bw, w + 1 - max(1, x - bw / 2)), max(h + 2 - y, 1), fill: alpha(chartColor, 0.8))
            }
          }
        }
        Row {
          Text { text: fmtTime(historyStart, chartPeriod == "day" ? "HH:mm" : "dd MMM"); fontSize: textSize; color: muted; weight: 1; maxLines: 1 }
          Text { text: fmtTime(historyEnd, chartPeriod == "day" ? "HH:mm" : "dd MMM"); fontSize: textSize; color: muted; weight: 1; align: end; maxLines: 1 }
        }
        if textSize >= 12 {
          Text { text: "${len(points)} readings · ${fmtTime(first(points)[0] / 1000, 'dd MMM')}–${fmtTime(last(points)[0] / 1000, 'dd MMM')}"; style: small; color: muted }
        }
      }
    }
  }
  onTap: screen()

  if !configured {
    Column {
      gap: 6
      Text { text: "Victron solar"; fontSize: 18 * uiScale; color: yellow; maxLines: 1 }
      if !compact { Text { text: "Tap to connect your VRM installation."; fontSize: labelSize; color: muted } }
      Button { text: "set up"; onTap: screen() }
    }
  } else {
    Column {
      gap: compact ? 2 : 5 * uiScale
      Row {
        Text { text: "OFFGRID"; fontSize: labelSize; color: accent; weight: 1; maxLines: 1 }
        Text { text: vrm == null ? "…" : !connected ? "offline" : stale ? "old data" : "VRM"; fontSize: labelSize; width: 60 * uiScale; align: end; color: !connected || stale ? yellow : muted; maxLines: 1 }
      }
      if wide {
        Row {
          gap: 20 * uiScale
          SolarBlock { weight: 1 }
          BatteryBlock { weight: 1 }
        }
      } else if compact || showChart {
        Row {
          Text { text: solarText; fontSize: 25 * uiScale; color: yellow; weight: 1; maxLines: 1 }
          Text { text: "${round(d.soc)}%"; fontSize: 22 * uiScale; color: batteryColor; width: 70 * uiScale; align: end; maxLines: 1 }
        }
        Progress { value: d.soc; color: batteryColor }
        Text { text: d.battery == null ? "…" : d.battery < 0 ? "Battery using ${round(abs(d.battery))} W" : "Battery charging ${round(d.battery)} W"; fontSize: labelSize; maxLines: 1 }
      } else {
        SolarBlock { }
        BatteryBlock { }
      }
      if !compact {
        Text { text: "Yield ${fixed(d.yield, 2)} kWh"; fontSize: labelSize; color: yellow; maxLines: 1 }
      }
      if showExtra && !showChart {
        Text { text: "AC ${round(d.ac)} W · DC ${round(d.dc)} W"; fontSize: labelSize; maxLines: 1 }
      }
      if showChart {
        Trend { weight: 1; textSize: labelSize }
      }
      if !compact {
        Text { text: d.time == null ? connectionText : "Data ${fmtTime(d.time, 'dd MMM HH:mm')}"; fontSize: labelSize; color: stale ? yellow : muted; maxLines: 1 }
      }
    }
  }
  screen {
    title: "Offgrid · Victron VRM"
    if configured && displaySettings {
      Column {
        scroll: true
        gap: 14
        Text { text: "Chart settings"; style: title }
        Text { text: "Metric: ${chartMetric == 'off' ? 'Off' : chartTitle}"; style: body }
        Flow {
          Button { text: "off"; color: chartMetric == "off" ? accent : muted; onTap: chartMetric = "off" }
          Button { text: "solar"; color: chartMetric == "solar" ? yellow : muted; onTap: chartMetric = "solar" }
          Button { text: "consumption"; color: chartMetric == "consumption" ? accent : muted; onTap: chartMetric = "consumption" }
          Button { text: "battery level"; color: chartMetric == "battery" ? green : muted; onTap: chartMetric = "battery" }
        }
        Text { text: "Period: ${periodTitle}"; style: body }
        Flow {
          Button { text: "24 hours"; color: chartPeriod == "day" ? accent : muted; onTap: { chartPeriod = "day"; refresh() } }
          Button { text: "week"; color: chartPeriod == "week" ? accent : muted; onTap: { chartPeriod = "week"; refresh() } }
          Button { text: "month"; color: chartPeriod == "month" ? accent : muted; onTap: { chartPeriod = "month"; refresh() } }
        }
        Text { text: "The tile shows the chart when there is enough height. Tap the tile to see it at any size. Solar and consumption show energy per hour, or per day for the month view. Battery shows average charge percentage. Gaps indicate missing readings."; style: small; color: muted }
        Button { text: "done"; onTap: { displaySettings = false; refresh() } }
      }
    } else if !configured || editing {
      Column {
        scroll: true
        gap: 14
        Text { text: "Connect to Victron VRM"; style: title }
        Text { text: "Enter the numeric installation ID from your VRM dashboard URL."; style: small }
        Input { text: draftSite; placeholder: "Installation ID"; onChange: draftSite = trim(value) }
        Text { text: "Create an access token in VRM under Preferences → Integrations → Add."; style: small }
        Input { text: draftToken; placeholder: "API access token"; onChange: draftToken = trim(value) }
        Text { text: "Saved locally on this device. Your token is visible while entering it. Share the widget file, which contains no saved settings."; style: small; color: muted }
        Text { text: setupError; style: small; color: yellow }
        Button { text: "connect"; onTap: {
          setupError = validDraft ? "" : "Enter a numeric installation ID and an access token."
          site = validDraft ? draftSite : site
          token = validDraft ? draftToken : token
          editing = !validDraft
          draftToken = validDraft ? "" : draftToken
          refresh()
        } }
        Button { text: "get a VRM token"; onTap: url("https://vrm.victronenergy.com/access-tokens") }
        if configured {
          Button { text: "cancel"; onTap: { editing = false; draftToken = ""; setupError = "" } }
          Button { text: "clear saved connection"; onTap: { site = ""; token = ""; draftSite = ""; draftToken = ""; editing = false; setupError = "" } }
        }
      }
    } else {
    Column {
      scroll: true
      gap: 16
      Flow {
        Button { text: "chart settings"; onTap: displaySettings = true }
        Button { text: "refresh"; onTap: refresh() }
      }
      Text { text: !connected ? connectionText : stale ? "Older readings — check the GX connection." : "Latest reported readings"; color: stale ? yellow : muted }
      Text { text: "${round(d.solar)} W solar"; style: huge; color: yellow }
      Text { text: "Battery ${round(d.soc)}%"; style: title; color: batteryColor }
      Progress { value: d.soc; color: batteryColor }
      if chartMetric != "off" { Trend { height: 240; textSize: 12 } }
      Text { text: "${fixed(d.voltage, 2)} V · ${fixed(d.current, 2)} A" }
      Text { text: "Battery power ${round(d.battery)} W" }
      Text { text: "Positive = charging · negative = discharging"; style: small; color: muted }
      Text { text: "AC output ${round(d.ac)} W · DC system ${round(d.dc)} W" }
      Text { text: "Reported day yield: ${fixed(d.yield, 2)} kWh"; color: yellow }
      Text { text: "Previous day: ${fixed(d.yesterday, 2)} kWh" }
      Text { text: "Charger peaks: ${round(d.peak)} W" }
      Text { text: "Measured ${fmtTime(d.time, 'dd MMM yyyy HH:mm')}"; style: small; color: muted }
      Text { text: "Checks VRM every minute. Values follow your GX upload interval."; style: small; color: muted }
      Button { text: "open VRM"; onTap: url("https://vrm.victronenergy.com/installation/${site}") }
      Button { text: "connection settings"; onTap: { draftSite = site; draftToken = ""; editing = true } }
    }
    }
  }
}

// Connection settings stay in local launcher state, outside this file.
// No shell dependencies: data is fetched by Android.
