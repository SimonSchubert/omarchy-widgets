widget "quran" {
  page: 1
  order: 1
  size: 3x4
  minSize: 3x4

  meta {
    description: "A daily Quran verse with Arabic, transliteration and an English meaning"
    version: "1.0"
    license: "MIT"
    category: "world"
    owl: 7
  }

  source now = clock every 1m

  let verses = [
    {
      arabic: "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
      transliteration: "Iyyaka na'budu wa iyyaka nasta'in",
      meaning: "You alone we worship, and You alone we ask for help.",
      reference: "Al-Fatihah 1:5"
    },
    {
      arabic: "لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا",
      transliteration: "La yukallifu Allahu nafsan illa wus'aha",
      meaning: "Allah does not burden a soul beyond what it can bear.",
      reference: "Al-Baqarah 2:286"
    },
    {
      arabic: "أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ",
      transliteration: "Ala bidhikri Allahi tatma'innu al-qulub",
      meaning: "Surely, in the remembrance of Allah hearts find peace.",
      reference: "Ar-Ra'd 13:28"
    },
    {
      arabic: "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا",
      transliteration: "Fa-inna ma'al-'usri yusra",
      meaning: "So surely, with hardship comes ease.",
      reference: "Ash-Sharh 94:5"
    },
    {
      arabic: "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
      transliteration: "Innallaha ma'a as-sabirin",
      meaning: "Surely, Allah is with those who are patient.",
      reference: "Al-Baqarah 2:153"
    },
    {
      arabic: "وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنْتُمُ الْأَعْلَوْنَ إِنْ كُنْتُمْ مُؤْمِنِينَ",
      transliteration: "Wa la tahinu wa la tahzanu wa antumul-a'lawna in kuntum mu'minin",
      meaning: "Do not lose heart or grieve; you will prevail if you are believers.",
      reference: "Aal Imran 3:139"
    },
    {
      arabic: "لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا",
      transliteration: "La taqnatu min rahmatillah; innallaha yaghfiru adh-dhunuba jami'a",
      meaning: "Do not despair of Allah's mercy. Surely, Allah forgives all sins.",
      reference: "Az-Zumar 39:53"
    },
    {
      arabic: "فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ",
      transliteration: "Fa-inni qarib; ujibu da'watad-da'i idha da'an",
      meaning: "I am near. I answer the call of the caller when they call upon Me.",
      reference: "Al-Baqarah 2:186"
    },
    {
      arabic: "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ",
      transliteration: "Hasbunallahu wa ni'mal-wakil",
      meaning: "Allah is sufficient for us, and He is the best disposer of affairs.",
      reference: "Aal Imran 3:173"
    },
    {
      arabic: "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَى",
      transliteration: "Wa la-sawfa yu'tika rabbuka fatarda",
      meaning: "Your Lord will give to you, and you will be satisfied.",
      reference: "Ad-Duha 93:5"
    },
    {
      arabic: "وَقُلْ رَبِّ زِدْنِي عِلْمًا",
      transliteration: "Wa qul rabbi zidni 'ilma",
      meaning: "And say, 'My Lord, increase me in knowledge.'",
      reference: "Ta-Ha 20:114"
    },
    {
      arabic: "وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ",
      transliteration: "Wa man yatawakkal 'alallahi fahuwa hasbuh",
      meaning: "Whoever puts their trust in Allah, He is sufficient for them.",
      reference: "At-Talaq 65:3"
    },
    {
      arabic: "وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا وَإِنَّ اللَّهَ لَمَعَ الْمُحْسِنِينَ",
      transliteration: "Walladhina jahadu fina lanahdiyannahum subulana wa innallaha lama'al-muhsinin",
      meaning: "Those who strive for Us, We will surely guide them to Our ways. Allah is with those who do good.",
      reference: "Al-Ankabut 29:69"
    },
    {
      arabic: "أَلَا إِنَّ أَوْلِيَاءَ اللَّهِ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ",
      transliteration: "Ala inna awliya'a Allahi la khawfun 'alayhim wa la hum yahzanun",
      meaning: "Surely, Allah's close servants will have no fear, nor will they grieve.",
      reference: "Yunus 10:62"
    }
  ]
  let dayOfYear = num(fmtTime(now, "D"), 1)
  let verse = verses[(dayOfYear - 1) % len(verses)]
  let today = fmtTime(now, "EEE, d MMM")
  let shareText = "${verse.arabic}\n\n${verse.transliteration}\n\n${verse.meaning}\n\n${verse.reference}"

  onTap: screen()

  Column {
    gap: 0
    fill: true
    align: center
    justify: spaceEvenly
    padding: 8
    Text { text: "VERSE OF THE DAY"; style: label; color: accent; align: center }
    Text { text: today; style: small; color: muted; align: center }
    Column {
      gap: 4
      fill: width
      align: center
      padding: 8
      background: alpha(green, 0.08)
      border: 1
      borderColor: alpha(accent, 0.22)
      radius: 10 * corners
      Text { text: verse.arabic; fontSize: 22; color: green; align: center; maxLines: 4 }
    }
    Text { text: verse.transliteration; style: small; italic: true; color: muted; align: center; maxLines: 4 }
    Text { text: verse.meaning; fontSize: 16; color: foreground; align: center; maxLines: 4 }
    Text { text: verse.reference; style: label; color: accent; align: center }
    Text { text: "Read · reflect · carry it with you"; style: small; color: muted; align: center; maxLines: 1 }
  }

  screen {
    title: "Today's verse"
    Column {
      scroll: true
      gap: 14
      align: center
      Text { text: "VERSE OF THE DAY · ${today}"; style: label; color: accent; align: center }
      Text { text: verse.arabic; fontSize: 34; color: green; align: center; maxLines: 6 }
      Text { text: verse.transliteration; style: body; italic: true; color: muted; align: center; maxLines: 4 }
      Text { text: verse.meaning; fontSize: 26; color: foreground; align: center; maxLines: 4 }
      Text { text: verse.reference; style: label; color: accent; align: center }
      Text { text: "Take a quiet moment with this verse, then choose one way to carry its meaning into today."; style: body; color: muted; align: center }
      Button { text: "share today's verse"; color: accent; onTap: share(shareText) }
      Button { text: "close"; color: muted; onTap: close() }
    }
  }
}
