widget "currencies" {
  size: 3x2
  minSize: 3x2
  padding: 8
  meta {
    owl: 11
    version: "1.1"
    license: "MIT"
    category: "finance"
    description: "Currency exchange rates worldwide, with flags, movement arrows, customisable favourites and a built-in currency converter."
  }

  requires { pacman: [] }

  state base = "GBP" persist
  state favourites = ["TRY", "EUR", "USD", "CNY"] persist
  state savedRates = [] persist
  state savedHistory = [] persist
  state currencies = [] persist
  state view = "rates"
  state query = ""
  state amount = "1"

  // One request covers all quotes; editing favourites or amounts needs no fetch.
  source rates = http("https://api.frankfurter.dev/v2/rates?base=${enc(base)}") every 6h json timeout 20s status
  source catalog = http("https://api.frankfurter.dev/v2/currencies") every 24h json timeout 20s status
  source now = clock every 6h
  source trend = http("https://api.frankfurter.dev/v2/rates?base=${enc(base)}&quotes=${enc(len(favourites) == 0 ? base : join(favourites, ","))}&from=${enc(fmtTime(now - 1209600, "yyyy-MM-dd", "UTC"))}") every 6h json timeout 20s status

  on rates first {
    if rates.ok && len(rates.out) > 0 { savedRates = rates.out }
  }
  on catalog first {
    if catalog.ok && len(catalog.out) > 0 { currencies = catalog.out }
  }
  on trend first {
    if trend.ok && len(trend.out) > 0 { savedHistory = trend.out }
  }

  // Filter by the response's base, so an old response is never relabelled.
  let quotes = savedRates.filter(r => r.base == base && r.rate > 0)
  let historyRows = savedHistory.filter(r => r.base == base && r.rate > 0)
  let selected = favourites.filter(c => c != base)
  let baseFlag = base == "GBP" ? "🇬🇧" : base == "USD" ? "🇺🇸" : base == "EUR" ? "🇪🇺" : base == "TRY" ? "🇹🇷" : base == "CNY" ? "🇨🇳" : base == "JPY" ? "🇯🇵" : base == "HKD" ? "🇭🇰" : base == "TWD" ? "🇹🇼" : base == "KRW" ? "🇰🇷" : base == "INR" ? "🇮🇳" : base == "PKR" ? "🇵🇰" : base == "BDT" ? "🇧🇩" : base == "AED" ? "🇦🇪" : base == "SAR" ? "🇸🇦" : base == "QAR" ? "🇶🇦" : base == "KWD" ? "🇰🇼" : base == "BHD" ? "🇧🇭" : base == "OMR" ? "🇴🇲" : base == "CAD" ? "🇨🇦" : base == "AUD" ? "🇦🇺" : base == "NZD" ? "🇳🇿" : base == "CHF" ? "🇨🇭" : base == "SGD" ? "🇸🇬" : base == "MYR" ? "🇲🇾" : base == "THB" ? "🇹🇭" : base == "IDR" ? "🇮🇩" : base == "PHP" ? "🇵🇭" : base == "VND" ? "🇻🇳" : base == "BRL" ? "🇧🇷" : base == "MXN" ? "🇲🇽" : base == "ARS" ? "🇦🇷" : base == "ZAR" ? "🇿🇦" : base == "EGP" ? "🇪🇬" : base == "NGN" ? "🇳🇬" : base == "KES" ? "🇰🇪" : base == "SEK" ? "🇸🇪" : base == "NOK" ? "🇳🇴" : base == "DKK" ? "🇩🇰" : base == "PLN" ? "🇵🇱" : base == "CZK" ? "🇨🇿" : base == "HUF" ? "🇭🇺" : base == "RON" ? "🇷🇴" : base == "UAH" ? "🇺🇦" : base == "ILS" ? "🇮🇱" : "🌐"
  let dates = unique(quotes.filter(r => contains(selected, r.quote)).map(r => r.date)).sort()
  let dateLabel = len(dates) == 0 ? "No rates yet" : len(dates) == 1 ? first(dates) : "${first(dates)}–${last(dates)}"
  let offline = rates != null && !rates.ok
  let quantity = num(replace(trim(amount), ",", "."))
  let validAmount = quantity != null && quantity >= 0 && quantity <= 1000000000 && trim(amount) != ""
  let matches = currencies.filter(c => contains(lower("${c.iso_code} ${c.name}"), lower(trim(query))))

  onTap: { view = "rates"; screen() }

  Column {
    fill: true
    gap: 2
    Row {
      gap: 4
      Text { text: "CURRENCIES"; color: accent; bold: true; fontSize: 14; weight: 1; maxLines: 1 }
      Text { text: "${baseFlag} ${base}"; color: accent; bold: true; fontSize: 16; maxLines: 1 }
    }
    Column {
      weight: 1
      scroll: true
      gap: 4
      for code in selected key code {
        let rate = quotes.find(r => r.quote == code)
        let series = historyRows.filter(r => r.quote == code).sortBy(r => r.date)
        let foundCurrent = rate != null && any(series, r => r.date == rate.date)
        let previous = rate == null ? null : last(series.filter(r => r.date < rate.date))
        let reversed = rate != null && rate.rate < 1
        let displayed = rate == null ? null : reversed ? 1 / rate.rate : rate.rate
        let movement = !foundCurrent || previous == null ? 0 : (reversed ? sign(previous.rate - rate.rate) : sign(rate.rate - previous.rate))
        let arrow = movement > 0 ? "▲" : movement < 0 ? "▼" : ""
        let flag = code == "GBP" ? "🇬🇧" : code == "USD" ? "🇺🇸" : code == "EUR" ? "🇪🇺" : code == "TRY" ? "🇹🇷" : code == "CNY" ? "🇨🇳" : code == "JPY" ? "🇯🇵" : code == "HKD" ? "🇭🇰" : code == "TWD" ? "🇹🇼" : code == "KRW" ? "🇰🇷" : code == "INR" ? "🇮🇳" : code == "PKR" ? "🇵🇰" : code == "BDT" ? "🇧🇩" : code == "AED" ? "🇦🇪" : code == "SAR" ? "🇸🇦" : code == "QAR" ? "🇶🇦" : code == "KWD" ? "🇰🇼" : code == "BHD" ? "🇧🇭" : code == "OMR" ? "🇴🇲" : code == "CAD" ? "🇨🇦" : code == "AUD" ? "🇦🇺" : code == "NZD" ? "🇳🇿" : code == "CHF" ? "🇨🇭" : code == "SGD" ? "🇸🇬" : code == "MYR" ? "🇲🇾" : code == "THB" ? "🇹🇭" : code == "IDR" ? "🇮🇩" : code == "PHP" ? "🇵🇭" : code == "VND" ? "🇻🇳" : code == "BRL" ? "🇧🇷" : code == "MXN" ? "🇲🇽" : code == "ARS" ? "🇦🇷" : code == "ZAR" ? "🇿🇦" : code == "EGP" ? "🇪🇬" : code == "NGN" ? "🇳🇬" : code == "KES" ? "🇰🇪" : code == "SEK" ? "🇸🇪" : code == "NOK" ? "🇳🇴" : code == "DKK" ? "🇩🇰" : code == "PLN" ? "🇵🇱" : code == "CZK" ? "🇨🇿" : code == "HUF" ? "🇭🇺" : code == "RON" ? "🇷🇴" : code == "UAH" ? "🇺🇦" : code == "ILS" ? "🇮🇱" : "🌐"
        Row {
          gap: 4
          Text { text: "${flag} ${code}"; fontSize: 14; color: muted; width: 54 }
          Text { text: reversed ? "1 ${code}" : "1 ${base}"; fontSize: 13; color: muted; width: 38; maxLines: 1 }
          Text { text: rate == null ? "—" : fmtNum(displayed, displayed >= 10 ? 2 : 4); fontSize: 14; align: end; weight: 1; maxLines: 1 }
          Text { text: arrow; color: movement > 0 ? #22c55e : movement < 0 ? #ef4444 : muted; fontSize: 14; width: 15 }
        }
      }
      if len(selected) == 0 { Text { text: "Tap to add currencies"; style: small; color: muted } }
    }
    Text { text: offline ? (len(quotes) > 0 ? "OFFLINE · Saved · ${dateLabel}" : "OFFLINE · No saved rates") : (len(quotes) > 0 ? "Saved rates · ${dateLabel}" : "No rates yet"); fontSize: 11; color: offline ? yellow : muted; maxLines: 1 }
  }

  screen {
    title: "Currencies"
    Column {
      fill: true
      padding: 12
      gap: 12
      Row {
        Text { text: "${baseFlag} ${base}"; style: title; color: accent; weight: 1 }
        Button { text: "Base"; onTap: { view = "base"; query = "" } }
        Button { text: "Favourites"; onTap: { view = "favourites"; query = "" } }
      }
      if view == "rates" {
        Text { text: "CONVERTER · Enter amount in ${base}"; style: small; color: accent }
        Input { text: amount; placeholder: "e.g. 100.50"; onChange: amount = value }
        if !validAmount { Text { text: "Enter an amount from 0 to 1,000,000,000 (no thousands separators)."; style: small; color: yellow } }
        Text { text: offline ? (len(quotes) > 0 ? "OFFLINE · Saved rates · ${dateLabel}" : "OFFLINE · No saved rates") : len(quotes) == 0 ? "Loading rates…" : "Latest available · ${dateLabel}"; style: small; color: offline ? yellow : muted }
        Column {
          weight: 1
          scroll: true
          gap: 12
          for code in selected key code {
            let rate = quotes.find(r => r.quote == code)
        let flag = code == "GBP" ? "🇬🇧" : code == "USD" ? "🇺🇸" : code == "EUR" ? "🇪🇺" : code == "TRY" ? "🇹🇷" : code == "CNY" ? "🇨🇳" : code == "JPY" ? "🇯🇵" : code == "HKD" ? "🇭🇰" : code == "TWD" ? "🇹🇼" : code == "KRW" ? "🇰🇷" : code == "INR" ? "🇮🇳" : code == "PKR" ? "🇵🇰" : code == "BDT" ? "🇧🇩" : code == "AED" ? "🇦🇪" : code == "SAR" ? "🇸🇦" : code == "QAR" ? "🇶🇦" : code == "KWD" ? "🇰🇼" : code == "BHD" ? "🇧🇭" : code == "OMR" ? "🇴🇲" : code == "CAD" ? "🇨🇦" : code == "AUD" ? "🇦🇺" : code == "NZD" ? "🇳🇿" : code == "CHF" ? "🇨🇭" : code == "SGD" ? "🇸🇬" : code == "MYR" ? "🇲🇾" : code == "THB" ? "🇹🇭" : code == "IDR" ? "🇮🇩" : code == "PHP" ? "🇵🇭" : code == "VND" ? "🇻🇳" : code == "BRL" ? "🇧🇷" : code == "MXN" ? "🇲🇽" : code == "ARS" ? "🇦🇷" : code == "ZAR" ? "🇿🇦" : code == "EGP" ? "🇪🇬" : code == "NGN" ? "🇳🇬" : code == "KES" ? "🇰🇪" : code == "SEK" ? "🇸🇪" : code == "NOK" ? "🇳🇴" : code == "DKK" ? "🇩🇰" : code == "PLN" ? "🇵🇱" : code == "CZK" ? "🇨🇿" : code == "HUF" ? "🇭🇺" : code == "RON" ? "🇷🇴" : code == "UAH" ? "🇺🇦" : code == "ILS" ? "🇮🇱" : "🌐"
            Column {
              gap: 2
              Row {
                Text { text: "${flag} ${code}"; bold: true; color: accent; weight: 1 }
                Text { text: !validAmount || rate == null ? "—" : fmtNum(quantity * rate.rate, 2); align: end; weight: 2 }
              }
              Text { text: rate == null ? "Rate unavailable for ${base}" : "1 ${base} = ${fmtNum(rate.rate, 6)} ${code} · ${rate.date}"; style: small; color: muted }
            }
          }
          if len(selected) == 0 { Text { text: "Choose Favourites to add currencies."; color: muted } }
        }
        Text { text: "Frankfurter · daily reference rates\nChecked every 6 hours while active. Not live trading rates."; style: small; color: muted }
      } else {
        Row {
          Text { text: view == "base" ? "Choose base currency" : "Tap to add or remove"; weight: 1; style: small }
          Button { text: "Done"; onTap: view = "rates" }
        }
        Input { text: query; placeholder: "Search code or name"; onChange: query = value }
        if len(currencies) == 0 {
          Text { text: catalog != null && !catalog.ok ? "Currency list unavailable. Reconnect and try again." : "Loading currencies…"; color: muted }
        }
        Column {
          weight: 1
          lazy: true
          gap: 4
          for c in matches key c.iso_code {
            let flag = c.iso_code == "GBP" ? "🇬🇧" : c.iso_code == "USD" ? "🇺🇸" : c.iso_code == "EUR" ? "🇪🇺" : c.iso_code == "TRY" ? "🇹🇷" : c.iso_code == "CNY" ? "🇨🇳" : c.iso_code == "JPY" ? "🇯🇵" : c.iso_code == "HKD" ? "🇭🇰" : c.iso_code == "TWD" ? "🇹🇼" : c.iso_code == "KRW" ? "🇰🇷" : c.iso_code == "INR" ? "🇮🇳" : c.iso_code == "PKR" ? "🇵🇰" : c.iso_code == "BDT" ? "🇧🇩" : c.iso_code == "AED" ? "🇦🇪" : c.iso_code == "SAR" ? "🇸🇦" : c.iso_code == "QAR" ? "🇶🇦" : c.iso_code == "KWD" ? "🇰🇼" : c.iso_code == "BHD" ? "🇧🇭" : c.iso_code == "OMR" ? "🇴🇲" : c.iso_code == "CAD" ? "🇨🇦" : c.iso_code == "AUD" ? "🇦🇺" : c.iso_code == "NZD" ? "🇳🇿" : c.iso_code == "CHF" ? "🇨🇭" : c.iso_code == "SGD" ? "🇸🇬" : c.iso_code == "MYR" ? "🇲🇾" : c.iso_code == "THB" ? "🇹🇭" : c.iso_code == "IDR" ? "🇮🇩" : c.iso_code == "PHP" ? "🇵🇭" : c.iso_code == "VND" ? "🇻🇳" : c.iso_code == "BRL" ? "🇧🇷" : c.iso_code == "MXN" ? "🇲🇽" : c.iso_code == "ARS" ? "🇦🇷" : c.iso_code == "ZAR" ? "🇿🇦" : c.iso_code == "EGP" ? "🇪🇬" : c.iso_code == "NGN" ? "🇳🇬" : c.iso_code == "KES" ? "🇰🇪" : c.iso_code == "SEK" ? "🇸🇪" : c.iso_code == "NOK" ? "🇳🇴" : c.iso_code == "DKK" ? "🇩🇰" : c.iso_code == "PLN" ? "🇵🇱" : c.iso_code == "CZK" ? "🇨🇿" : c.iso_code == "HUF" ? "🇭🇺" : c.iso_code == "RON" ? "🇷🇴" : c.iso_code == "UAH" ? "🇺🇦" : c.iso_code == "ILS" ? "🇮🇱" : "🌐"
            Row {
              padding: [8, 12]
              background: surface
              radius: 6 * corners
              onTap: {
                if view == "base" {
                  base = c.iso_code
                  view = "rates"
                } else {
                  favourites = contains(favourites, c.iso_code) ? favourites.filter(f => f != c.iso_code) : favourites + [c.iso_code]
                }
              }
              Text { text: "${flag} ${c.iso_code}"; color: accent; width: 72 }
              Text { text: c.name; weight: 1; maxLines: 2 }
              Text { text: (view == "base" ? base == c.iso_code : contains(favourites, c.iso_code)) ? "✓" : "+"; color: accent; width: 20 }
            }
          }
          if len(currencies) > 0 && len(matches) == 0 { Text { text: "No matching currencies"; color: muted } }
        }
      }
    }
  }
}
