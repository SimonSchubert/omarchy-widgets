widget "tailscale" {
  size: 6x5
  minSize: 3x4

  meta { owl: 10; description: "List the Tailscale peers this system can see, copy an IP or hostname, and open the Android app to toggle the VPN."; version: "1.4"; license: "MIT"; category: "system" }

  requires { pacman: ["iproute2", "bind"] }

  // The VPN runs in the Tailscale app on Android, so the tunnel shows up here
  // as a tun interface; each tailnet node is a host route on it. Resolve the
  // names through MagicDNS: ask the guest resolver first, then 100.100.100.100
  // directly since the rootfs resolvers can't reach it. Only /32 host routes
  // are devices; a path like 100.64.0.0/10 is a range, not a peer.
  source ts = cmd("""
    set -u

    # This device's address on the tunnel (the app renames the interface when
    # it reconnects, tun0, tun1, ...).
    self_ip=$(ip -o -4 addr show 2>/dev/null | awk '$2 ~ /^tun/ { for (i = 1; i <= NF; i++) if ($i == "inet") { split($(i + 1), a, "/"); print a[1]; exit } }')

    resolve() {
      local ip=$1 host
      host=$(getent hosts "$ip" 2>/dev/null | awk '{ print $2; exit }')
      [ -z "$host" ] && host=$(dig +short +time=1 +tries=1 -x "$ip" @100.100.100.100 2>/dev/null | awk '$1 !~ /^;/ && NF { sub(/\.$/, "", $1); print $1; exit }')
      printf '%s' "$host"
    }

    self_host=""
    [ -n "$self_ip" ] && self_host=$(resolve "$self_ip")

    # A /32 host route on the tunnel is a device; 100.64.0.0/10 is the range.
    routes=$(ip -o -4 route show table all 2>/dev/null | awk -v self="$self_ip" '
      $3 ~ /^tun/ && $1 ~ /^100[.]/ && ($1 !~ /\// || $1 ~ /\/32$/) {
        ip = $1; sub(/\/32$/, "", ip)
        if (ip != self && ip != "100.100.100.100") print ip
      }' | sort -u)

    peers_json=""
    sep=""
    for ip in $routes; do
      host=$(resolve "$ip")
      if [ -n "$host" ]; then
        peers_json="$peers_json$sep{\"ip\":\"$ip\",\"host\":\"$host\"}"
      else
        peers_json="$peers_json$sep{\"ip\":\"$ip\",\"host\":null}"
      fi
      sep=","
    done

    tailnet=""
    if [ -n "$self_host" ]; then
      case "$self_host" in
        *.*) tailnet=$(printf '%s' "$self_host" | cut -d. -f2-) ;;
      esac
    fi

    if [ -n "$self_ip" ]; then
      if [ -n "$self_host" ]; then
        self_json="{\"ip\":\"$self_ip\",\"host\":\"$self_host\"}"
      else
        self_json="{\"ip\":\"$self_ip\",\"host\":null}"
      fi
    else
      self_json=null
    fi

    if [ -n "$tailnet" ]; then
      tailnet_json="\"$tailnet\""
    else
      tailnet_json=null
    fi

    printf '{"self":%s,"tailnet":%s,"peers":[%s]}\n' "$self_json" "$tailnet_json" "$peers_json"
  """) every 30s json timeout 20s

  // The peers from the last time the tunnel had some. While Tailscale rebuilds
  // the tunnel (it renames the tun interface and reinstalls its routes), the
  // list is empty for a moment, which would otherwise drop the widget to
  // "No peers seen." Keep showing the last list, marked as reconnecting.
  state lastPeerList = [] persist

  let peers = (ts.peers ?? []).sortBy(p => p.host ?? p.ip)
  let selfIp = ts.self != null ? ts.self.ip : null
  let selfHost = ts.self != null ? ts.self.host : null
  let connected = selfIp != null
  let cached = lastPeerList ?? []
  let shown = peers.length > 0 ? peers : cached
  let reconnecting = connected && peers.length == 0 && cached.length > 0
  let tailnet = ts.tailnet
  let label = ts == null ? "…" : reconnecting ? "reconnecting…" : connected ? (peers.length > 0 ? (peers.length == 1 ? "1 peer" : "${peers.length} peers") : "connected") : "disconnected"

  // Remember the peers whenever the tunnel reports some, so a reconnect has a
  // list to fall back to.
  when peers.length > 0 { lastPeerList = peers }

  // Tapping the tile opens the Tailscale app; the VPN is switched there.
  onTap: androidApp("com.tailscale.ipn")

  // The Tailscale mark: a 3x3 dot grid, the T-shaped dots solid, the rest faded.
  component Mark(dim = 26) {
    Canvas {
      width: dim
      height: dim
      let d = dim * 0.24
      let r = d / 2
      let c = [r, dim / 2, dim - r]
      for i in range(3) {
        for j in range(3) {
          circle(c[i], c[j], r, fill: (j == 1 || (i == 1 && j == 2)) ? foreground : alpha(foreground, 0.28))
        }
      }
    }
  }

  Column {
    gap: 8
    padding: 12

    Row {
      gap: 8
      align: center
      Mark { dim: 24; opacity: connected ? 1 : 0.5 }
      Box { width: 10; height: 10; radius: 5; background: connected ? green : ts == null ? muted : red }
      Text {
        text: label
        style: small
        color: reconnecting ? muted : connected ? green : ts == null ? muted : red
        weight: 1
      }
    }

    if tailnet {
      Text { text: split(tailnet, ".")[0]; style: muted; fontSize: 11; maxLines: 1 }
    }

    if connected {
      if shown.length > 0 {
        Column {
          gap: 6
          weight: 1
          fill: width
          scroll: true
          for p in shown key p.ip {
            Column {
              gap: 2
              Row {
                gap: 8
                fill: width
                align: center
                if p.host {
                  Text { text: split(p.host, ".")[0]; style: small; bold: true; maxLines: 1; weight: 1 }
                } else {
                  Text { text: p.ip; style: small; bold: true; font: mono; maxLines: 1; weight: 1 }
                }
                Text { text: "ip"; style: small; color: accent; onTap: copy(p.ip) }
                if p.host {
                  Text { text: "host"; style: small; color: accent; onTap: copy(p.host) }
                }
              }
              if p.host {
                Text { text: p.ip; style: small; color: muted; font: mono; maxLines: 1 }
              }
            }
          }
        }
      } else {
        Column {
          gap: 10
          justify: center
          weight: 1
          Column {
            gap: 2
            Text { text: "this device"; style: small; color: muted }
            Text { text: selfHost ? split(selfHost, ".")[0] : selfIp; style: body; bold: true; maxLines: 1 }
            if selfHost {
              Text { text: selfIp; style: small; color: muted; font: mono; maxLines: 1 }
            }
          }
          Text { text: "No peers seen."; style: small; color: muted; maxLines: 2 }
          Button { text: "open app"; fill: width; onTap: androidApp("com.tailscale.ipn") }
        }
      }
    } else {
      if ts == null {
        Column {
          gap: 10
          justify: center
          weight: 1
          Text { text: "checking…"; style: small; color: muted }
        }
      } else {
        Column {
          gap: 10
          justify: center
          weight: 1
          Text { text: "VPN is off"; style: body }
          Text { text: "Tailscale runs in the Android app; open it to connect."; style: small; color: muted; maxLines: 3 }
          Button { text: "open app"; fill: width; onTap: androidApp("com.tailscale.ipn") }
        }
      }
    }
  }
}
