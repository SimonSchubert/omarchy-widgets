widget "bitcoin-ticker" {
  size: 6x1
  minSize: 3x1
  padding: 0
  meta { description: "A one-row Bitcoin ticker: the coin, the live USD price, and a faint 24-hour trend line. Tap for Coinbase."; version: "1.1"; license: "MIT"; category: "finance" }

  source btc = http("https://api.coinbase.com/v2/prices/BTC-USD/spot") every 1m json timeout 10s
  // 15-minute candles, newest first: [time, low, high, open, close, volume]
  source candles = http("https://api.exchange.coinbase.com/products/BTC-USD/candles?granularity=900") every 5m json timeout 10s

  let btcOrange = "#F7931A"
  // an error reply has no amount: show "…" rather than a wrong "$0"
  let amount = btc.data.amount
  let p = int(num(amount, 0))
  // 83171 -> "83,171"
  let price = p >= 1000000 ? "${floor(p / 1000000)},${pad(floor(p % 1000000 / 1000), 3, "0")},${pad(p % 1000, 3, "0")}" : p >= 1000 ? "${floor(p / 1000)},${pad(p % 1000, 3, "0")}" : "${p}"
  // the last 24 hours, oldest first
  let closes = (candles[0] != null ? candles : []).take(96).reverse().map(c => c[4])
  let lo = first(closes.sort())
  let hi = last(closes.sort())
  let wide = cols >= 5
  let compact = cols < 4
  let label = amount == null ? "…" : "$${price}"
  // "$83,171" fits every size; "$104,005" and "$1,004,005" need a smaller font, and the last one the chart's room
  let fs = (compact ? 20 : 28) * (len(label) <= 7 ? 1 : len(label) <= 8 ? 0.9 : 0.78)
  // a tile taller than wide (the landscape home screen) stacks the coin, a short price and the trend
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3
  // 82451 -> "$82.5k", 104005 -> "$104k", 1004005 -> "$1.00M"
  let short = amount == null ? "…" : p >= 1000000 ? "$${fixed(p / 1000000, 2)}M" : p >= 100000 ? "$${round(p / 1000)}k" : p >= 1000 ? "$${fixed(p / 1000, 1)}k" : "$${p}"
  let tw = tileWidth ?? 60
  let tallCoin = clamp(tw * 0.55, 24, 56)
  let tallFs = clamp((tw - 10) / (len(short) * 0.6), 10, 26)

  onTap: url("https://www.coinbase.com/price/bitcoin")

  Box {
    fill: true
    Canvas {
      // warm light falling from behind the coin
      if tall {
        rect(0, 0, width, height, fill: linear(0, 0, 0, height, [alpha(btcOrange, 0.05), alpha(btcOrange, 0.16), alpha(btcOrange, 0.05)]))
        rect(0, 0, width, height, fill: radial(width / 2, height * 0.42, width * 1.6, [alpha(btcOrange, 0.22), alpha(btcOrange, 0)]))
      } else {
          rect(0, 0, width, height, fill: linear(0, 0, width, 0, [alpha(btcOrange, 0.2), alpha(btcOrange, 0.05), alpha(btcOrange, 0)]))
          rect(0, 0, width, height, fill: radial(height * 0.9, height / 2, height * 2.2, [alpha(btcOrange, 0.22), alpha(btcOrange, 0)]))
        }
      }
      if tall {
        Column {
          fill: true
          padding: [5, 16]
          align: center
          justify: center
          gap: 10
          Canvas {
            size: tallCoin
            let r = width / 2
            circle(r, r + 1.5, r, fill: alpha("#000000", 0.25))
            circle(r, r, r, fill: linear(0, 0, width, width, ["#FFC266", btcOrange, "#C96A00"]))
            circle(r, r, r - 2.5, stroke: alpha("#FFFFFF", 0.4), width: 1.2)
            rotate(14, r, r) { text("₿", r, r + 1, size: r * 1.2, bold: true, align: center, color: "#FFFFFF") }
          }
          Text { text: short; font: sans; fontSize: tallFs; bold: true; color: foreground; maxLines: 1; align: center; fill: width }
          if len(closes) > 1 && hi > lo {
            // 24h trend, under the price
            Canvas {
              fill: width
              height: clamp(tw * 0.8, 24, 80)
              let n = len(closes)
              let pts = range(n).map(i => [3 + i * (width - 9) / (n - 1), 4 + (height - 8) * (1 - (closes[i] - lo) / (hi - lo))])
              path(pts, stroke: linear(0, 0, width, 0, [alpha(btcOrange, 0.15), alpha(btcOrange, 0.6), btcOrange]), width: 1.5, cap: round)
              circle(pts[n - 1][0], pts[n - 1][1], 4.5, fill: alpha(btcOrange, 0.3))
              circle(pts[n - 1][0], pts[n - 1][1], 2.5, fill: btcOrange)
            }
          }
        }
      } else {
      Row {
        fill: true
        padding: [compact ? 12 : 18, 0]
        align: center
        gap: compact ? 8 : 14
        Canvas {
          size: compact ? 28 : 36
          let r = width / 2
          circle(r, r + 1.5, r, fill: alpha("#000000", 0.25))
          circle(r, r, r, fill: linear(0, 0, width, width, ["#FFC266", btcOrange, "#C96A00"]))
          circle(r, r, r - 2.5, stroke: alpha("#FFFFFF", 0.4), width: 1.2)
          rotate(14, r, r) { text("₿", r, r + 1, size: r * 1.2, bold: true, align: center, color: "#FFFFFF") }
        }
        Text { text: label; font: sans; fontSize: fs; bold: true; color: foreground; maxLines: 1; weight: 1 }
        if wide && len(label) <= 8 && len(closes) > 1 && hi > lo {
          // 24h trend, fading in from the left so it never fights the price
          Canvas {
            width: (tileWidth ?? 360) * 0.36
            fill: height
            let n = len(closes)
            let top = height * 0.28
            let h = height * 0.44
            let pts = range(n).map(i => [i * (width - 6) / (n - 1), top + h * (1 - (closes[i] - lo) / (hi - lo))])
            path(pts, stroke: linear(0, 0, width, 0, [alpha(btcOrange, 0), alpha(btcOrange, 0.6), btcOrange]), width: 1.8, cap: round)
            circle(pts[n - 1][0], pts[n - 1][1], 6, fill: alpha(btcOrange, 0.3))
            circle(pts[n - 1][0], pts[n - 1][1], 3, fill: btcOrange)
          }
        }
      }
    }
  }
}
