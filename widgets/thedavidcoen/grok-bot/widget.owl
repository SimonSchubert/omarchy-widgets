widget "grok bot" {
  size: 6x3
  minSize: 3x2

  meta {
    description: "Grok Bot weekly usage percent and reset time from the local Cursor session";
    version: "1.0";
    license: "MIT";
    category: "dev"
  }

  requires { pacman: ["jq", "curl"] }

  // Weekly included usage and its reset, from the local Cursor login (the same
  // session as the cursor plan widget). The token is piped into curl and is
  // not part of the printed JSON. Grok Bot is metered there, not on the Grok account.
  source data = cmd("""
    auth=~/.config/cursor/auth.json
    token=$(jq -r '.accessToken // empty' "$auth")
    if [ -z "$token" ]; then
      printf '%s\n' '{"ok":false,"error":"sign in to Cursor"}'
      exit 0
    fi
    body=$(mktemp)
    code=$(printf 'Authorization: Bearer %s\n' "$token" | curl -sS --max-time 15 -o "$body" -w '%{http_code}' -X POST \
      'https://api2.cursor.sh/aiserver.v1.DashboardService/GetSandUsageStatus' \
      -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}') || code=000
    if [ "$code" != "200" ]; then
      rm -f "$body"
      if [ "$code" = "401" ]; then
        printf '%s\n' '{"ok":false,"error":"sign in to Cursor"}'
      else
        printf '%s\n' '{"ok":false,"error":"usage unavailable"}'
      fi
      exit 0
    fi
    usage=$(cat "$body")
    rm -f "$body"
    jq -nc --argjson u "$usage" '{
      ok: true,
      plan: ($u.grokPlanLabel // "Grok Bot"),
      cursor: ($u.cursorPlanName // ""),
      pct: ($u.usagePercent // 0),
      resets: ($u.nextResetTimestampUtc // "" | if . == "" then null else sub("\\.[0-9]+"; "") | fromdateiso8601 end)
    }' || printf '%s\n' '{"ok":false,"error":"usage unavailable"}'
  """) every 5m json timeout 40s

  let pct = data.ok ? round(data.pct) : null
  let pctColor = pct == null ? muted : pct >= 90 ? red : pct >= 75 ? yellow : accent

  onTap: url("https://cursor.com/dashboard/usage")

  Column {
    gap: 6
    Row {
      gap: 6
      align: center
      Text { text: "grok bot"; style: muted; weight: 1 }
      if data.cursor != null && data.cursor != "" {
        Text { text: data.cursor; style: small; color: muted; width: 56; align: end }
      }
    }
    Text {
      text: data == null ? "…" : data.ok ? data.plan : (data.error ?? "offline")
      style: title
      color: data.ok ? foreground : muted
    }
    Column {
      gap: 2
      Row {
        align: center
        Text { text: "usage"; style: label; weight: 1 }
        Text {
          text: pct == null ? "…" : "${pct}%"
          style: small
          color: pctColor
          width: 40
          align: end
        }
      }
      Progress { value: pct ?? 0; color: pctColor; animate value: spring() }
    }
    if data.ok && data.resets != null {
      Text { text: "resets ${fmtTime(data.resets, "MMM d")}"; style: small; color: muted }
    }
  }
}
