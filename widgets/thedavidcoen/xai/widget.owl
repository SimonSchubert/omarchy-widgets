widget "xai" {
  size: 3x4
  minSize: 3x3

  meta {
    owl: 9
    description: "xAI subscription name, Cursor plan, X verification, and weekly usage from the local Grok and Cursor logins"
    version: "1.0"
    license: "MIT"
    category: "dev"
  }

  requires { pacman: ["jq", "curl"] }

  // Unified account: xAI subscription, Cursor plan, and X verification, plus
  // the shared weekly pool. Tokens are read from the local Grok and Cursor
  // logins and piped into curl, so they are not part of the printed JSON.
  // A paid tier with a linked X account includes the checkmark. Follower and
  // post counts come from the public profile. Subscriber count is shown only
  // when it is above zero.
  source data = cmd("""
    auth=$HOME/.grok/auth.json
    ub=""
    cb=""
    xb=""
    pb=""
    cleanup() {
      [ -n "$ub" ] && rm -f "$ub"
      [ -n "$cb" ] && rm -f "$cb"
      [ -n "$xb" ] && rm -f "$xb"
      [ -n "$pb" ] && rm -f "$pb"
    }
    trap cleanup EXIT
    fail() { printf '%s\n' "$1"; exit 0; }

    [ -f "$auth" ] || fail '{"ok":false,"error":"sign in to Grok"}'
    token=$(jq -r '[.[] | select(type == "object" and .key != null)] | max_by(.expires_at // "") | .key // empty' "$auth" 2>/dev/null || true)
    uid=$(jq -r '[.[] | select(type == "object" and .key != null)] | max_by(.expires_at // "") | .user_id // empty' "$auth" 2>/dev/null || true)
    [ -n "$token" ] || fail '{"ok":false,"error":"sign in to Grok"}'

    ub=$(mktemp)
    code=$(printf 'Authorization: Bearer %s\nx-userid: %s\n' "$token" "$uid" | curl -sS --max-time 15 -o "$ub" -w '%{http_code}' \
      -H @- -H 'Accept: application/json' -H 'X-XAI-Token-Auth: xai-grok-cli' -H 'User-Agent: xai-grok-cli/1.0.62' \
      'https://cli-chat-proxy.grok.com/v1/user?include=subscription') || code=000
    if [ "$code" = "401" ]; then fail '{"ok":false,"error":"sign in to Grok"}'; fi
    if [ "$code" != "200" ]; then fail '{"ok":false,"error":"account unavailable"}'; fi

    cb=$(mktemp)
    code=$(printf 'Authorization: Bearer %s\nx-userid: %s\n' "$token" "$uid" | curl -sS --max-time 15 -o "$cb" -w '%{http_code}' \
      -H @- -H 'Accept: application/json' -H 'X-XAI-Token-Auth: xai-grok-cli' -H 'User-Agent: xai-grok-cli/1.0.62' \
      'https://cli-chat-proxy.grok.com/v1/billing?format=credits') || code=000
    if [ "$code" != "200" ]; then printf '%s\n' '{}' > "$cb"; fi

    xid=$(jq -r '.xUserId // empty' "$ub" 2>/dev/null || true)
    handle=""
    followers=""
    posts=""
    subs=""
    case $xid in
      ''|*[!0-9]*) xid="" ;;
    esac
    if [ -n "$xid" ]; then
      xb=$(mktemp)
      meta=$(curl -sS -L --max-time 12 -A 'Mozilla/5.0' -o "$xb" -w '%{url_effective} %{http_code}' "https://x.com/i/user/$xid") || meta=" x 000"
      url=$(printf '%s\n' "$meta" | awk '{print $1}')
      hcode=$(printf '%s\n' "$meta" | awk '{print $2}')
      handle=$(printf '%s\n' "$url" | sed -nE 's#^https://(www\.)?x\.com/([A-Za-z0-9_]{1,20})/?$#\2#p')
      if [ "$hcode" = "200" ]; then
        posts=$(grep -oE 'tweets\\":[0-9]+' "$xb" | head -1 | grep -oE '[0-9]+$' || true)
        subs=$(grep -oE 'subscribers_count\\":[0-9]+' "$xb" | head -1 | grep -oE '[0-9]+$' || true)
        followers=$(grep -oE 'followers\\":[0-9]+' "$xb" | head -1 | grep -oE '[0-9]+$' || true)
      fi
    fi

    cursor_plan=""
    cursor_price=""
    cauth=$HOME/.config/cursor/auth.json
    if [ -f "$cauth" ]; then
      ctoken=$(jq -r '.accessToken // empty' "$cauth" 2>/dev/null || true)
      if [ -n "$ctoken" ]; then
        pb=$(mktemp)
        pcode=$(printf 'Authorization: Bearer %s\n' "$ctoken" | curl -sS --max-time 15 -o "$pb" -w '%{http_code}' -X POST \
          'https://api2.cursor.sh/aiserver.v1.DashboardService/GetPlanInfo' \
          -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}') || pcode=000
        if [ "$pcode" = "200" ]; then
          cursor_plan=$(jq -r '.planInfo.planName // empty' "$pb" 2>/dev/null || true)
          cursor_price=$(jq -r '.planInfo.price // empty' "$pb" 2>/dev/null || true)
        fi
      fi
    fi

    jq -nc \
      --slurpfile user "$ub" \
      --slurpfile credits "$cb" \
      --arg handle "$handle" \
      --arg followers "$followers" \
      --arg posts "$posts" \
      --arg subs "$subs" \
      --arg xid "$xid" \
      --arg cplan "$cursor_plan" \
      --arg cprice "$cursor_price" '
    def pretty:
      if . == null or . == "" then "xAI"
      elif . == "SuperGrokPlus" or . == "supergrok_plus" then "Super"
      elif . == "SuperGrokHeavy" or . == "supergrok_heavy" then "SuperGrok Heavy"
      elif . == "SuperGrokLite" or . == "supergrok_lite" then "SuperGrok Lite"
      elif . == "SuperGrok" or . == "supergrok" then "SuperGrok"
      elif . == "x_premium_plus" or . == "XPremiumPlus" then "Premium+"
      elif . == "x_premium" or . == "XPremium" then "Premium"
      elif . == "x_basic" or . == "XBasic" then "Basic"
      elif . == "free" or . == "Free" then "Free"
      elif . == "plus" or . == "Plus" then "Plus"
      elif . == "premium" or . == "Premium" then "Premium"
      elif . == "super" or . == "Super" then "Super"
      elif . == "ultra" or . == "Ultra" then "Ultra"
      else . end;
    def pname:
      if . == "GrokBuild" then "build"
      elif . == "GrokChat" then "chat"
      elif . == "GrokAppBuilder" then "apps"
      elif . == "GrokTasks" then "tasks"
      elif . == "Api" then "API"
      elif . == "Imagine" then "imagine"
      elif . == "Voice" then "voice"
      else . end;
    def num($s): if $s == "" then null else ($s | tonumber) end;
    def paid:
      ascii_downcase as $t
      | if $t == "" or $t == "free" then false else true end;
    ($user[0] // {}) as $u
    | ($credits[0].config // {}) as $c
    | (if $c.creditUsagePercent == null and (($c.currentPeriod.type // "") | tostring | contains("WEEKLY")) then 0
       else $c.creditUsagePercent end) as $pct
    | ([($c.productUsage // [])[] | select(.usagePercent != null) | {name: ((.product // "") | pname), pct: .usagePercent}]
       | if length == 1 and $pct != null and (((.[0].pct - $pct) | fabs) < 0.05) then [] else . end) as $products
    | {
        ok: true,
        plan: ($u.subscriptionTier | pretty),
        unified: ($c.isUnifiedBillingUser // false),
        cursor: ($u.cursorMerged // false),
        cursorPlan: (if $cplan == "" then null else $cplan end),
        cursorPrice: (if $cprice == "" then null else $cprice end),
        pct: (if $pct == null then 0 else $pct end),
        products: $products,
        prepaid: (if $c.prepaidBalance.val == null then null else ($c.prepaidBalance.val / 100) end),
        resets: (
          (($c.currentPeriod.end // $c.billingPeriodEnd // "") | tostring)
          | if . == "" then null
            else
              sub("\\.[0-9]+"; "")
              | sub("\\+00:00$"; "Z")
              | if endswith("Z") then fromdateiso8601 else null end
            end
        ),
        x: (
          if $xid == "" then {linked: false}
          else {
            linked: true,
            handle: (if $handle == "" then null else $handle end),
            verified: (($u.subscriptionTier // "") | paid),
            followers: num($followers),
            posts: num($posts),
            subscribers: num($subs)
          } end
        )
      }
    ' || printf '%s\n' '{"ok":false,"error":"account unavailable"}'
  """) every 5m json timeout 40s

  let pct = data.ok ? round(data.pct) : null
  let pctColor = pct == null ? muted : pct >= 90 ? red : pct >= 75 ? yellow : accent
  let products = data.products ?? []
  let cursorText = data.cursorPlan != null && data.cursorPlan != ""
    ? (data.cursorPrice != null && data.cursorPrice != "" ? "${data.cursorPlan} · ${data.cursorPrice}" : data.cursorPlan)
    : (data.cursor ? "linked" : "not linked")
  let twitterText = data.x.linked ? (data.x.verified ? "verified" : "not verified") : "not linked"
  let planName = data.plan == "SuperGrok Plus" || data.plan == "SuperGrokPlus" ? "Super" : data.plan
  let title = data == null ? "…" : !data.ok ? (data.error ?? "offline") : (planName != null && planName != "" && planName != "xAI" ? "xAi Subscription: ${planName}" : "xAi Subscription")

  onTap: url("https://grok.com/dashboard")

  Column {
    gap: 6
    Row {
      gap: 6
      align: center
      Text { text: "xai"; style: muted; weight: 1 }
      if data.ok && data.unified {
        Text { text: "unified"; style: small; color: muted; width: 64; align: end }
      }
    }
    Text {
      text: title
      style: title
      color: data != null && data.ok ? foreground : muted
      maxLines: 2
    }
    if data != null && data.ok {
      Row {
        align: center
        Text { text: "cursor"; style: label; width: 76 }
        Text {
          text: cursorText
          style: small
          weight: 1
          align: end
          maxLines: 1
          color: data.cursorPlan != null && data.cursorPlan != "" ? foreground : muted
        }
      }
      Row {
        align: center
        Text { text: "grok"; style: label; width: 76 }
        Text { text: planName; style: small; weight: 1; align: end; maxLines: 1 }
      }
      Row {
        align: center
        Text { text: "twitter"; style: label; width: 76 }
        Text {
          text: twitterText
          style: small
          weight: 1
          align: end
          maxLines: 1
          color: data.x.verified ? accent : muted
          onTap: {
            if data.x.handle != null {
              url("https://x.com/${enc(data.x.handle)}")
            } else {
              url("https://accounts.x.ai/unify")
            }
          }
        }
      }
    }
    Column {
      gap: 2
      Row {
        align: center
        Text { text: "week"; style: label; weight: 1 }
        Text {
          text: pct == null ? "…" : "${pct}%"
          style: small
          color: pctColor
          width: 40
          align: end
        }
      }
      Progress { value: pct ?? 0; color: pctColor; animate value: spring() }
    }
    if len(products) > 1 {
      for p in products {
        Row {
          align: center
          Text { text: p.name; style: small; color: muted; weight: 1; maxLines: 1 }
          Text { text: "${round(p.pct)}%"; style: small; color: muted; width: 40; align: end }
        }
      }
    }
    if data.ok && data.resets != null {
      Text {
        text: data.prepaid != null && data.prepaid > 0
          ? "\$${fixed(data.prepaid, 2)} credit · resets ${fmtTime(data.resets, "MMM d")}"
          : "resets ${fmtTime(data.resets, "MMM d")}"
        style: small
        color: muted
        maxLines: 2
      }
    }
    if data.ok && data.x.linked {
      Column {
        gap: 2
        if data.x.handle != null {
          Text {
            text: "@${data.x.handle}"
            style: small
            maxLines: 1
            onTap: url("https://x.com/${enc(data.x.handle)}")
          }
        } else {
          Text { text: "X linked"; style: small; color: muted }
        }
        if data.x.followers != null {
          Text {
            text: "${fmtNum(data.x.followers)} followers"
            style: small
            color: muted
            maxLines: 1
          }
        }
        if data.x.posts != null {
          Text {
            text: "${fmtNum(data.x.posts)} posts"
            style: small
            color: muted
            maxLines: 1
          }
        }
        if data.x.subscribers != null && data.x.subscribers > 0 {
          Text {
            text: "${fmtNum(data.x.subscribers)} subscribers"
            style: small
            color: muted
            maxLines: 1
          }
        }
      }
    }
  }
}
