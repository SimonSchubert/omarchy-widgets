widget "xai" {
  size: 3x4
  minSize: 3x3

  meta {
    owl: 9
    description: "xAI subscription name, Cursor plan, X verification, and weekly usage from the local Grok and Cursor logins"
    version: "1.1"
    license: "MIT"
    category: "dev"
  }

  requires { pacman: ["jq", "curl"] }

  // Subscription, Cursor plan, and the X blue check, plus the shared weekly
  // pool. Tokens are read from the local Grok and Cursor logins and piped
  // into curl, so they are not part of the printed JSON. Every request names
  // this widget in its User-Agent. The checkmark is is_blue_verified on the
  // public profile. Billing is fetched every 5 minutes; the plan, the Cursor
  // plan, and the profile are hourly. A 3-row tile keeps the plan, Cursor,
  // X, and the week, and folds the rest into one line.
  source account = cmd("""
    ua='omarchy-widgets/xai (+https://github.com/SimonSchubert/omarchy-widgets)'
    auth=$HOME/.grok/auth.json
    ub=""
    xb=""
    cleanup() {
      [ -n "$ub" ] && rm -f "$ub"
      [ -n "$xb" ] && rm -f "$xb"
    }
    trap cleanup EXIT
    fail() { printf '%s\n' "$1"; exit 0; }

    [ -f "$auth" ] || fail '{"ok":false,"error":"sign in to Grok"}'
    token=$(jq -r '[.[] | select(type == "object" and .key != null)] | max_by(.expires_at // "") | .key // empty' "$auth" 2>/dev/null || true)
    uid=$(jq -r '[.[] | select(type == "object" and .key != null)] | max_by(.expires_at // "") | .user_id // empty' "$auth" 2>/dev/null || true)
    [ -n "$token" ] || fail '{"ok":false,"error":"sign in to Grok"}'

    ub=$(mktemp)
    code=$(printf 'Authorization: Bearer %s\nx-userid: %s\n' "$token" "$uid" | curl -sS --max-time 15 -o "$ub" -w '%{http_code}' \
      -A "$ua" -H @- -H 'Accept: application/json' \
      'https://cli-chat-proxy.grok.com/v1/user?include=subscription') || code=000
    if [ "$code" = "401" ]; then fail '{"ok":false,"error":"sign in to Grok"}'; fi
    if [ "$code" != "200" ]; then fail '{"ok":false,"error":"account unavailable"}'; fi

    xid=$(jq -r '.xUserId // empty' "$ub" 2>/dev/null || true)
    handle=""
    followers=""
    posts=""
    subs=""
    blue=""
    case $xid in
      ''|*[!0-9]*) xid="" ;;
    esac
    if [ -n "$xid" ]; then
      xb=$(mktemp)
      meta=$(curl -sS -L --max-time 12 -A "$ua" -o "$xb" -w '%{url_effective} %{http_code}' "https://x.com/i/user/$xid") || meta=" x 000"
      url=$(printf '%s\n' "$meta" | awk '{print $1}')
      hcode=$(printf '%s\n' "$meta" | awk '{print $2}')
      handle=$(printf '%s\n' "$url" | sed -nE 's#^https://(www\.)?x\.com/([A-Za-z0-9_]{1,20})/?$#\2#p')
      if [ "$hcode" = "200" ] && [ -n "$handle" ]; then
        block=$(awk -v handle="$handle" '
          {
            key = "screen_name\\\":\\\"" handle
            i = index($0, key)
            if (i == 0) next
            print substr($0, i, 2200)
            exit
          }
        ' "$xb")
        posts=$(printf '%s\n' "$block" | grep -oE 'tweets\\":[0-9]+' | head -1 | grep -oE '[0-9]+$' || true)
        subs=$(printf '%s\n' "$block" | grep -oE 'subscribers_count\\":[0-9]+' | head -1 | grep -oE '[0-9]+$' || true)
        followers=$(printf '%s\n' "$block" | grep -oE 'followers\\":[0-9]+' | head -1 | grep -oE '[0-9]+$' || true)
        blue=$(printf '%s\n' "$block" | grep -oE 'is_blue_verified\\":(true|false)' | head -1 | grep -oE 'true|false$' || true)
      fi
    fi

    jq -nc \
      --slurpfile user "$ub" \
      --arg handle "$handle" \
      --arg followers "$followers" \
      --arg posts "$posts" \
      --arg subs "$subs" \
      --arg xid "$xid" \
      --arg blue "$blue" '
    def pretty:
      if . == null or . == "" then "xAI"
      elif . == "SuperGrokPlus" or . == "supergrok_plus" then "Super"
      elif . == "SuperGrokHeavy" or . == "supergrok_heavy" then "SuperGrok Heavy"
      elif . == "SuperGrokLite" or . == "supergrok_lite" then "SuperGrok Lite"
      elif . == "SuperGrok" or . == "supergrok" then "SuperGrok"
      elif . == "x_premium_plus" or . == "XPremiumPlus" then "Premium+"
      elif . == "x_premium" or . == "XPremium" then "Premium"
      elif . == "x_basic" or . == "XBasic" then "Basic"
      elif . == "free" or . == "Free" then "Free"
      elif . == "plus" or . == "Plus" then "Plus"
      elif . == "premium" or . == "Premium" then "Premium"
      elif . == "super" or . == "Super" then "Super"
      elif . == "ultra" or . == "Ultra" then "Ultra"
      else . end;
    def num($s): if $s == "" then null else ($s | tonumber) end;
    ($user[0] // {}) as $u
    | {
        ok: true,
        plan: ($u.subscriptionTier | pretty),
        cursor: ($u.cursorMerged // false),
        x: (
          if $xid == "" then {linked: false}
          else {
            linked: true,
            handle: (if $handle == "" then null else $handle end),
            verified: (if $blue == "true" then true elif $blue == "false" then false else null end),
            followers: num($followers),
            posts: num($posts),
            subscribers: num($subs)
          } end
        )
      }
    ' || printf '%s\n' '{"ok":false,"error":"account unavailable"}'
  """) every 1h json timeout 40s

  source billing = cmd("""
    ua='omarchy-widgets/xai (+https://github.com/SimonSchubert/omarchy-widgets)'
    auth=$HOME/.grok/auth.json
    cb=""
    cleanup() { [ -n "$cb" ] && rm -f "$cb"; }
    trap cleanup EXIT
    fail() { printf '%s\n' "$1"; exit 0; }

    [ -f "$auth" ] || fail '{"ok":false}'
    token=$(jq -r '[.[] | select(type == "object" and .key != null)] | max_by(.expires_at // "") | .key // empty' "$auth" 2>/dev/null || true)
    uid=$(jq -r '[.[] | select(type == "object" and .key != null)] | max_by(.expires_at // "") | .user_id // empty' "$auth" 2>/dev/null || true)
    [ -n "$token" ] || fail '{"ok":false}'

    cb=$(mktemp)
    code=$(printf 'Authorization: Bearer %s\nx-userid: %s\n' "$token" "$uid" | curl -sS --max-time 15 -o "$cb" -w '%{http_code}' \
      -A "$ua" -H @- -H 'Accept: application/json' \
      'https://cli-chat-proxy.grok.com/v1/billing?format=credits') || code=000
    if [ "$code" != "200" ]; then fail '{"ok":false}'; fi

    jq -nc --slurpfile credits "$cb" '
    def pname:
      if . == "GrokBuild" then "build"
      elif . == "GrokChat" then "chat"
      elif . == "GrokAppBuilder" then "apps"
      elif . == "GrokTasks" then "tasks"
      elif . == "Api" then "API"
      elif . == "Imagine" then "imagine"
      elif . == "Voice" then "voice"
      else . end;
    ($credits[0].config // {}) as $c
    | (if $c.creditUsagePercent == null and (($c.currentPeriod.type // "") | tostring | contains("WEEKLY")) then 0
       else $c.creditUsagePercent end) as $pct
    | ([($c.productUsage // [])[] | select(.usagePercent != null) | {name: ((.product // "") | pname), pct: .usagePercent}]
       | if length == 1 and $pct != null and (((.[0].pct - $pct) | fabs) < 0.05) then [] else . end) as $products
    | {
        ok: true,
        unified: ($c.isUnifiedBillingUser // false),
        pct: (if $pct == null then 0 else $pct end),
        products: $products,
        prepaid: (if $c.prepaidBalance.val == null then null else ($c.prepaidBalance.val / 100) end),
        resets: (
          (($c.currentPeriod.end // $c.billingPeriodEnd // "") | tostring)
          | if . == "" then null
            else
              sub("\\.[0-9]+"; "")
              | sub("\\+00:00$"; "Z")
              | if endswith("Z") then fromdateiso8601 else null end
            end
        )
      }
    ' || printf '%s\n' '{"ok":false}'
  """) every 5m json timeout 20s

  source cplan = cmd("""
    ua='omarchy-widgets/xai (+https://github.com/SimonSchubert/omarchy-widgets)'
    cauth=$HOME/.config/cursor/auth.json
    pb=""
    cleanup() { [ -n "$pb" ] && rm -f "$pb"; }
    trap cleanup EXIT
    [ -f "$cauth" ] || { printf '%s\n' '{"ok":true,"plan":null,"price":null}'; exit 0; }
    ctoken=$(jq -r '.accessToken // empty' "$cauth" 2>/dev/null || true)
    [ -n "$ctoken" ] || { printf '%s\n' '{"ok":true,"plan":null,"price":null}'; exit 0; }
    pb=$(mktemp)
    pcode=$(printf 'Authorization: Bearer %s\n' "$ctoken" | curl -sS --max-time 15 -o "$pb" -w '%{http_code}' -X POST \
      -A "$ua" \
      'https://api2.cursor.sh/aiserver.v1.DashboardService/GetPlanInfo' \
      -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}') || pcode=000
    if [ "$pcode" != "200" ]; then printf '%s\n' '{"ok":false}'; exit 0; fi
    jq -nc --slurpfile plan "$pb" '
      ($plan[0].planInfo // {}) as $p
      | {
          ok: true,
          plan: (if ($p.planName // "") == "" then null else $p.planName end),
          price: (if ($p.price // "") == "" then null else $p.price end)
        }
    ' || printf '%s\n' '{"ok":false}'
  """) every 1h json timeout 20s

  let short = (rows ?? 4) < 4
  let planName = account.plan == "SuperGrok Plus" || account.plan == "SuperGrokPlus" ? "Super" : account.plan
  let title = account == null ? "…" : !account.ok ? (account.error ?? "offline") : (planName != null && planName != "" && planName != "xAI" ? planName : "xAI")
  let pct = billing.ok ? round(billing.pct) : null
  let pctColor = pct == null ? muted : pct >= 90 ? red : pct >= 75 ? yellow : accent
  let products = billing.products ?? []
  let shownProducts = (rows ?? 4) >= 5 && len(products) > 1 ? products.take((rows ?? 4) >= 6 ? 3 : 2) : []
  let cursorText = cplan == null ? "…" : (cplan.plan != null && cplan.plan != ""
    ? (cplan.price != null && cplan.price != "" ? "${cplan.plan} · ${cplan.price}" : cplan.plan)
    : (account.cursor ? "linked" : (cplan.ok ? "not linked" : "unavailable")))
  let twitterText = account.x.linked ? (account.x.verified == true ? "verified" : account.x.verified == false ? "not verified" : "linked") : "not linked"
  let creditBit = !short && billing.ok && billing.prepaid != null && billing.prepaid > 0 ? "\$${fixed(billing.prepaid, 2)} credit" : ""
  let resetBit = billing.ok && billing.resets != null ? "resets ${fmtTime(billing.resets, "MMM d")}" : ""
  let handleBit = account.x.handle != null ? "@${account.x.handle}" : ""
  let followBit = !short && account.x.followers != null ? "${fmtNum(account.x.followers)} followers" : ""
  let postBit = !short && account.x.posts != null ? "${fmtNum(account.x.posts)} posts" : ""
  let subBit = !short && account.x.subscribers != null && account.x.subscribers > 0 ? "${fmtNum(account.x.subscribers)} subscribers" : ""
  let detail = [creditBit, resetBit].filter(s => s != "").join(" · ")
  let stats = [handleBit, followBit, postBit, subBit].filter(s => s != "").join(" · ")
  let foot = [resetBit, handleBit].filter(s => s != "").join(" · ")

  onTap: url("https://grok.com/dashboard")

  Column {
    gap: 4
    Row {
      gap: 6
      align: center
      Text { text: "xai"; style: muted; weight: 1 }
      if account.ok && billing.unified {
        Text { text: "unified"; style: small; color: muted; width: 64; align: end }
      }
    }
    Text {
      text: title
      style: title
      color: account != null && account.ok ? foreground : muted
      maxLines: 1
    }
    if account != null && account.ok {
      Row {
        align: center
        Text { text: "cursor"; style: label; width: 64 }
        Text {
          text: cursorText
          style: small
          weight: 1
          align: end
          maxLines: 1
          color: cplan.plan != null && cplan.plan != "" ? foreground : muted
        }
      }
      if !short {
        Row {
          align: center
          Text { text: "grok"; style: label; width: 64 }
          Text { text: planName; style: small; weight: 1; align: end; maxLines: 1 }
        }
      }
      Row {
        align: center
        Text { text: "twitter"; style: label; width: 64 }
        Text {
          text: twitterText
          style: small
          weight: 1
          align: end
          maxLines: 1
          color: account.x.verified == true ? accent : muted
          onTap: {
            if account.x.handle != null {
              url("https://x.com/${enc(account.x.handle)}")
            } else {
              url("https://accounts.x.ai/unify")
            }
          }
        }
      }
      Column {
        gap: 2
        Row {
          align: center
          Text { text: "week"; style: label; weight: 1 }
          Text {
            text: pct == null ? "…" : "${pct}%"
            style: small
            color: pctColor
            width: 40
            align: end
          }
        }
        Progress { value: pct ?? 0; color: pctColor; animate value: spring() }
      }
      if len(shownProducts) > 0 {
        for p in shownProducts {
          Row {
            align: center
            Text { text: p.name; style: small; color: muted; weight: 1; maxLines: 1 }
            Text { text: "${round(p.pct)}%"; style: small; color: muted; width: 40; align: end }
          }
        }
      }
      if short && foot != "" {
        Text {
          text: foot
          style: small
          color: muted
          maxLines: 1
          onTap: {
            if account.x.handle != null { url("https://x.com/${enc(account.x.handle)}") }
          }
        }
      }
      if !short && detail != "" {
        Text { text: detail; style: small; color: muted; maxLines: 1 }
      }
      if !short && stats != "" {
        Text {
          text: stats
          style: small
          color: muted
          maxLines: 1
          onTap: {
            if account.x.handle != null { url("https://x.com/${enc(account.x.handle)}") }
          }
        }
      }
    }
  }
}
