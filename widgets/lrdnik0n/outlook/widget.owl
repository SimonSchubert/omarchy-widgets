widget "outlook" {
  size: 6x4
  minSize: 6x3

  meta {
    owl: 4
    description: "Outlook mail stays on the tile after you clear notifications, up to 20. Tap one to open it. Colors are at the bottom right."
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  // New mail is whatever the Outlook app posts to the shade. No shell, so no packages.
  // Title is the sender. The first line of the text is the subject, and the rest is the body.
  source n = android.notifications
  source now = clock every 60s

  // Names, not baked-in colors, so a theme change repaints the text.
  let palette = [
    { id: "foreground", ink: foreground },
    { id: "accent", ink: accent },
    { id: "muted", ink: muted },
    { id: "red", ink: red },
    { id: "orange", ink: orange },
    { id: "yellow", ink: yellow },
    { id: "green", ink: green },
    { id: "cyan", ink: cyan },
    { id: "blue", ink: blue },
    { id: "magenta", ink: magenta },
    { id: "white", ink: white },
    { id: "black", ink: black }
  ]

  let mail = (n.items ?? []).filter(i => contains(["com.microsoft.office.outlook", "com.microsoft.outlooklite"], i.package) || contains(lower(i.app ?? ""), "outlook"))
  // Saved copies, so clearing the shade does not clear the tile. Newest first; the oldest drops after 20.
  let seen = mail.map(m => {
    key: m.key ?? "",
    sender: trim(m.title ?? ""),
    subject: (lines(m.text ?? "").map(l => trim(l)).filter(l => l != ""))[0] ?? "",
    body: join(drop(lines(m.text ?? "").map(l => trim(l)).filter(l => l != ""), 1), " "),
    time: m.time ?? 0,
    clip: match(lower("${m.title ?? ""}\n${m.text ?? ""}"), "attachment|📎|🖇|(^|\\s)\\S+\\.(pdf|docx?|xlsx?|pptx?|png|jpe?g|gif|zip|csv|txt|heic|webp|mp4|mov|rtf|odt)(\\s|$)") != null
  })
  let seenKeys = seen.map(m => m.key)
  state checked = null
  state colorsOpen = false
  state part = "sender"
  state kept = [] persist
  state senderId = "" persist
  state subjectId = "" persist
  state timeId = "" persist

  let senderSwatch = senderId == "" ? null : palette.find(s => s.id == senderId)
  let subjectSwatch = subjectId == "" ? null : palette.find(s => s.id == subjectId)
  let timeSwatch = timeId == "" ? null : palette.find(s => s.id == timeId)
  let chosen = part == "subject" ? subjectId : part == "time" ? timeId : senderId

  // A small paperclip in the time color, or the theme text color until one is chosen.
  component Clip(ink) {
    Canvas {
      width: 12
      height: 14
      line(4.6, 8.2, 4.6, 3.4, stroke: ink, width: 1.15, cap: round)
      arc(6.6, 3.4, 2, 270, 180, stroke: ink, width: 1.15, cap: round)
      line(8.6, 3.4, 8.6, 10, stroke: ink, width: 1.15, cap: round)
      arc(5.6, 10, 3, 90, 180, stroke: ink, width: 1.15, cap: round)
      line(2.6, 10, 2.6, 5.2, stroke: ink, width: 1.15, cap: round)
    }
  }

  when len(seen) > 0 {
    kept = (seen + kept.filter(k => !contains(seenKeys, k.key))).sortBy(k => -(k.time ?? 0)).take(20)
  }
  on mail {
    kept = (seen + kept.filter(k => !contains(seenKeys, k.key))).sortBy(k => -(k.time ?? 0)).take(20)
  }

  onTap: { checked = now; refresh() }

  Column {
    gap: 4
    fill: true
    Row {
      Text { text: "outlook"; style: muted; weight: 1 }
      if n == null {
        Text { text: "…"; fontSize: 11; color: muted; width: 40; align: end }
      } else if n.available == false {
        Text { text: "allow"; fontSize: 11; color: muted; width: 48; align: end; onTap: notification("open", "") }
      } else if checked != null {
        Text { text: fmtTime(checked, "HH:mm"); fontSize: 11; color: muted; width: 48; align: end }
      }
    }
    if n != null && n.available == false {
      Text { text: "notification access is needed. tap allow."; style: small }
    } else if n != null && len(kept) == 0 {
      Text { text: "no new mail"; style: small }
    }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for item in kept key item.key {
        let who = item.sender != "" ? item.sender : "Outlook"
        let subject = item.subject ?? ""
        let body = item.body ?? ""
        let age = item.time == null || item.time == 0 || now == null ? null : now - item.time
        Row {
          gap: 6
          align: top
          onTap: { checked = now; refresh(); notification("open", item.key) }
          if senderSwatch == null {
            Text { text: "•"; fontSize: 13; width: 12 }
          } else {
            Text { text: "•"; fontSize: 13; width: 12; color: senderSwatch.ink }
          }
          Column {
            gap: 1
            weight: 1
            Row {
              if senderSwatch == null {
                Text { text: who; fontSize: 13; maxLines: 1; weight: 1 }
              } else {
                Text { text: who; fontSize: 13; maxLines: 1; weight: 1; color: senderSwatch.ink }
              }
              Row {
                gap: 3
                align: center
                if item.clip {
                  Clip { ink: timeSwatch == null ? foreground : timeSwatch.ink }
                }
                if timeSwatch == null {
                  Text {
                    text: age == null ? "" : age < 3600 ? "${max(floor(age / 60), 1)}m" : age < 86400 ? "${floor(age / 3600)}h" : "${floor(age / 86400)}d"
                    fontSize: 10; width: 40; align: end
                  }
                } else {
                  Text {
                    text: age == null ? "" : age < 3600 ? "${max(floor(age / 60), 1)}m" : age < 86400 ? "${floor(age / 3600)}h" : "${floor(age / 86400)}d"
                    fontSize: 10; width: 40; align: end; color: timeSwatch.ink
                  }
                }
              }
            }
            if subject != "" && subject != who {
              if subjectSwatch == null {
                Text { text: subject; fontSize: 13; maxLines: 2 }
              } else {
                Text { text: subject; fontSize: 13; maxLines: 2; color: subjectSwatch.ink }
              }
            }
            if body != "" {
              Text { text: body; fontSize: 12; maxLines: 3 }
            }
          }
        }
      }
    }
    if colorsOpen {
      Row {
        gap: 8
        fill: width
        justify: end
        if senderSwatch == null {
          Text { text: "sender"; fontSize: 10; width: 52; align: end; bold: part == "sender"; onTap: part = "sender" }
        } else {
          Text { text: "sender"; fontSize: 10; width: 52; align: end; bold: part == "sender"; color: senderSwatch.ink; onTap: part = "sender" }
        }
        if subjectSwatch == null {
          Text { text: "subject"; fontSize: 10; width: 58; align: end; bold: part == "subject"; onTap: part = "subject" }
        } else {
          Text { text: "subject"; fontSize: 10; width: 58; align: end; bold: part == "subject"; color: subjectSwatch.ink; onTap: part = "subject" }
        }
        if timeSwatch == null {
          Text { text: "time"; fontSize: 10; width: 40; align: end; bold: part == "time"; onTap: part = "time" }
        } else {
          Text { text: "time"; fontSize: 10; width: 40; align: end; bold: part == "time"; color: timeSwatch.ink; onTap: part = "time" }
        }
      }
      Row {
        gap: 4
        fill: width
        justify: end
        for s in palette key s.id {
          Box {
            size: s.id == chosen ? 16 : 12
            background: s.ink
            radius: 8
            border: s.id == chosen ? 1 : 0
            borderColor: foreground
            onTap: {
              subjectId = part == "subject" ? s.id : subjectId
              timeId = part == "time" ? s.id : timeId
              senderId = part != "subject" && part != "time" ? s.id : senderId
            }
          }
        }
      }
    }
    Row {
      fill: width
      justify: end
      if colorsOpen {
        Box {
          padding: [36, 16]
          border: 1
          borderColor: foreground
          radius: 10
          onTap: colorsOpen = false
          Text { text: "done"; fontSize: 20; align: center }
        }
      } else {
        Text { text: "colors"; style: muted; fontSize: 11; width: 52; align: end; onTap: colorsOpen = true }
      }
    }
  }
}
