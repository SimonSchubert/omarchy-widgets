widget "IMD radar" {
  meta {
    owl: 8
    description: "IMD live PPI radar for all 47 stations, with Open-Meteo model wind at 10 to 120 m; lock two named spots as a beating mark, prev/live compare, pan/zoom and refresh interval"
    version: "2.2"
    license: "MIT"
    category: "world"
  }
  size: 6x4
  minSize: 3x3
  padding: 0

  requires { pacman: ["curl", "jq", "gawk", "imagemagick"] }

  // Persisted UI interval (10 / 20 / 30). Script also reads ~/.cache/omalauncher-imd-radar/interval.min.
  state intervalMin = 20 persist
  // IMD radar station code; the screen view's search writes it
  state station = "cni" persist
  // the three most recent picks, shown as buttons under the search field
  state recent1 = "" persist
  state recent2 = "" persist
  state recent3 = "" persist
  state query = ""
  // Two spots the user can lock by lat/long and name; lock picks which one,
  // if any, is drawn on the map — "" leaves the picture unmarked
  state lock = "" persist
  state name1 = "" persist
  state lat1 = "" persist
  state lon1 = "" persist
  state name2 = "" persist
  state lat2 = "" persist
  state lon2 = "" persist
  state view = "current"
  state zoom = 1
  state panX = 0
  state panY = 0

  // Poll every 1m; the script enforces interval.min (10/20/30 buttons) and
  // consumes the force marker, so a "refresh now" that loses the run()/
  // refresh() race still fetches within a minute. Skip path is ~0.5s.
  source radar = cmd("""
    set -euo pipefail
    export LC_ALL=C
    # CONFIG — extend later without changing the tile contract
    # Products on IMD: caz (MAX Z), ppi, sri, ppz, pac, ppv
    # The picker's $C/station file decides what is fetched; cni here is only the
    # fallback before the first tap, and matches the default of state station
    PRODUCT=ppi
    STATION=cni
    C=~/.cache/omalauncher-imd-radar
    mkdir -p "$C"
    # one run at a time: concurrent fetches race on the cache files
    exec 9>"$C/lock"
    if ! flock -n 9; then
      [ -s "$C/meta.json" ] && cat "$C/meta.json" && exit 0
      exit 0
    fi
    [ -f "$C/product" ] && PRODUCT=$(tr -d '[:space:]' < "$C/product")
    [ -f "$C/station" ] && STATION=$(tr -d '[:space:]' < "$C/station")
    # the display name comes from the search pick, so the station list lives in
    # one place; an unknown code falls back to its capitalised form
    NAME=""
    [ -f "$C/station.name" ] && NAME=$(tr -d '[:space:]' < "$C/station.name")
    [ -n "$NAME" ] || NAME=$(printf '%s' "$STATION" | tr '[:lower:]' '[:upper:]')
    URL="https://mausam.imd.gov.in/Radar/"$PRODUCT"_"$STATION".gif"
    PAGE="https://mausam.imd.gov.in/responsive/radar.php?id=$NAME"

    # Frames cached for another station or product are a different image: drop
    # them so the -z conditional fetch below compares same-source timestamps
    if [ -f "$C/product.used" ] && [ "$(tr -d '[:space:]' < "$C/product.used")" != "$STATION.$PRODUCT" ]; then
      rm -f "$C/current.gif" "$C/previous.gif" "$C/diff.png" "$C/diff.geo" "$C/last_modified" "$C/fetched_at"
    fi
    printf '%s' "$STATION.$PRODUCT" > "$C/product.used.tmp" && mv -f "$C/product.used.tmp" "$C/product.used"

    INTERVAL=20
    if [ -f "$C/interval.min" ]; then
      INTERVAL=$(tr -d '[:space:]' < "$C/interval.min")
    fi
    case "$INTERVAL" in 10|20|30) ;; *) INTERVAL=20 ;; esac
    printf '%s' "$INTERVAL" > "$C/interval.min"

    emit() {
      local changed="${1:-false}"
      local updated=0 lm=""
      [ -f "$C/fetched_at" ] && updated=$(tr -d '[:space:]' < "$C/fetched_at")
      [ -f "$C/last_modified" ] && lm=$(tr -d '\r' < "$C/last_modified" | head -n1)
      [ -z "$updated" ] && updated=0
      # The frame's geometry, so a lat/long pair lands on the right pixel: the
      # scope is the left-aligned square of side h with the site at its centre
      # and that half-side covering the product's range. $C/range.km overrides
      # the 150 km every PPI product on IMD plots today.
      local gw=0 gh=0 gcx=0 gcy=0 gk=0 range=150
      [ -f "$C/range.km" ] && range=$(tr -dc '0-9' < "$C/range.km")
      [ -z "$range" ] && range=150
      if [ -s "$C/current.gif" ]; then
        geom=$(magick identify -format "%w %h" "$C/current.gif[0]")
        gw=${geom% *}; gh=${geom#* }
        gcx=$(( gh / 2 )); gcy=$gcx
        gk=$(awk -v h="$gh" -v r="$range" 'BEGIN { printf "%.5f", h / 2 / r }')
      fi
      # the diff is that square cropped around the site and scaled up: report
      # the crop and the scale so the mark lands in both panels
      local dw=0 dh=0 dx=0 dy=0 ds=1 cs=360
      if [ -s "$C/diff.png" ]; then
        dgeom=$(magick identify -format "%w %h" "$C/diff.png")
        dw=${dgeom% *}; dh=${dgeom#* }
        cs=$(( dh / 2 ))
        # the crop that built it, so the mark lines up with a stale diff too
        if [ -s "$C/diff.geo" ]; then
          set -- $(tr -c '0-9' ' ' < "$C/diff.geo")
          [ $# -ge 2 ] && { dx=$1; dy=$2; }
        else
          dx=$(( gcx - cs / 2 )); [ "$dx" -gt $(( gw - cs )) ] && dx=$(( gw - cs )); [ "$dx" -lt 0 ] && dx=0
          dy=$(( gcy - cs / 2 )); [ "$dy" -gt $(( gh - cs )) ] && dy=$(( gh - cs )); [ "$dy" -lt 0 ] && dy=0
        fi
        ds=$(( dh / cs ))
      fi
      jq -nc \
        --arg path "$([ -s "$C/current.gif" ] && echo "$C/current.gif" || true)" \
        --arg prev "$([ -s "$C/previous.gif" ] && echo "$C/previous.gif" || true)" \
        --arg diff "$([ -s "$C/diff.png" ] && echo "$C/diff.png" || true)" \
        --arg product "$PRODUCT" \
        --arg station "$STATION" \
        --arg stationName "$NAME" \
        --arg url "$PAGE" \
        --arg lm "$lm" \
        --argjson updated "$updated" \
        --argjson intervalMin "$INTERVAL" \
        --argjson changed "$changed" \
        --argjson gw "$gw" \
        --argjson gh "$gh" \
        --argjson gcx "$gcx" \
        --argjson gcy "$gcy" \
        --argjson gk "$gk" \
        --argjson range "$range" \
        --argjson dw "$dw" \
        --argjson dh "$dh" \
        --argjson dx "$dx" \
        --argjson dy "$dy" \
        --argjson ds "$ds" \
        '{
          path: (if $path == "" then null else $path end),
          prev: (if $prev == "" then null else $prev end),
          diff: (if $diff == "" then null else $diff end),
          product: $product,
          station: $station,
          stationName: $stationName,
          url: $url,
          updated: (if $updated == 0 then null else $updated end),
          lastModified: (if $lm == "" then null else $lm end),
          intervalMin: $intervalMin,
          changed: $changed,
          geo: {
            w: $gw, h: $gh, cx: $gcx, cy: $gcy, k: $gk, range: $range,
            dw: $dw, dh: $dh, dx: $dx, dy: $dy, ds: $ds
          }
        }'
    }

    # "refresh now" writes epoch seconds into $C/force from its own shell.
    # run() and refresh() race, so the marker outlives the tap: whenever it
    # is newer than the last fetch we go online; the fetch rewrites
    # fetched_at past it, which consumes the marker.
    now=$(date +%s)
    force=""
    [ -f "$C/force" ] && force=$(tr -dc '0-9' < "$C/force")
    if [ -f "$C/fetched_at" ] && [ -s "$C/current.gif" ]; then
      last=$(tr -d '[:space:]' < "$C/fetched_at")
      age=$(( now - last ))
      if [ "$age" -lt $(( INTERVAL * 60 )) ] && { [ -z "$force" ] || [ "$force" -le "$last" ]; }; then
        emit false | tee "$C/meta.json"
        exit 0
      fi
    fi

    tmp="$C/current.gif.$$"
    # stale tmp files from crashed runs — before ours exists
    rm -f "$C"/current.gif.new "$C"/current.gif.*
    code=0
    # No `curl -z`: it compares the server's Last-Modified against this file's
    # mtime, which is our download time and therefore always newer than the
    # frame's own stamp — the fetch then reports "not modified" for cycle after
    # cycle and prev/diff never rotate. Dedupe by bytes instead.
    curl -fsm 30 -A "omalauncher-imd-radar/2.0" -e "$PAGE" -o "$tmp" -D "$C/headers.txt" "$URL" || code=$?

    # Network / HTTP failure: keep showing the last good frame
    if [ "$code" -ne 0 ] && [ ! -s "$tmp" ]; then
      rm -f "$tmp"
      if [ -s "$C/current.gif" ]; then
        emit false
        exit 0
      fi
      exit "$code"
    fi

    # Empty body with a clean exit means the server sent nothing usable
    if [ ! -s "$tmp" ]; then
      rm -f "$tmp"
      if [ -s "$C/current.gif" ]; then
        emit false > "$C/meta.json"
        cat "$C/meta.json"
        exit 0
      fi
      exit 4
    fi

    # Keep the last genuinely different frame as "previous": IMD re-serves the
    # same scan between volume updates, so bytes — not Last-Modified — decide
    changed=false
    if [ -s "$C/current.gif" ]; then
      if cmp -s "$C/current.gif" "$tmp"; then
        changed=false
      else
        cp -f "$C/current.gif" "$C/previous.gif"
        changed=true
      fi
    else
      changed=true
    fi
    mv -f "$tmp" "$C/current.gif"

    # diff = site-area compare, previous and live side by side: a 360x360 box
    # centred on the site — the middle of the square plot — whatever station
    # and frame size it last served, then doubled so the detail reads
    geom=$(magick identify -format "%w %h" "$C/current.gif[0]")
    W=${geom% *}; H=${geom#* }
    X=$(( H / 2 - 180 )); [ "$X" -gt $(( W - 360 )) ] && X=$(( W - 360 )); [ "$X" -lt 0 ] && X=0
    Y=$(( H / 2 - 180 )); [ "$Y" -gt $(( H - 360 )) ] && Y=$(( H - 360 )); [ "$Y" -lt 0 ] && Y=0
    CROP=360x360+$X+$Y
    if [ -s "$C/previous.gif" ] && [ -s "$C/current.gif" ] && ! cmp -s "$C/previous.gif" "$C/current.gif"; then
      magick \
        \( "$C/previous.gif[0]" -crop "$CROP" +repage -scale 200% \
           -fill '#FFFFFF' -gravity northwest -pointsize 28 -annotate +12+12 'prev' \) \
        \( -size 6x720 xc:white \) \
        \( "$C/current.gif[0]" -crop "$CROP" +repage -scale 200% \
           -fill '#FFFFFF' -gravity northwest -pointsize 28 -annotate +12+12 'live' \) \
        +append "$C/diff.png" || true
      printf '%s %s\n' "$X" "$Y" > "$C/diff.geo"
    fi

    lm=$(awk 'BEGIN{IGNORECASE=1} /^Last-Modified:/ {sub(/\r$/,""); sub(/^Last-Modified:[[:space:]]*/,""); print; exit}' "$C/headers.txt" 2>/dev/null || true)
    printf '%s' "$lm" > "$C/last_modified"
    printf '%s' "$(date +%s)" > "$C/fetched_at"
    emit "$changed" > "$C/meta.json"
    cat "$C/meta.json"
  """) every 1m json timeout 60s status

  // IMD's radar network, each entry at the position IMD gives its antenna
  // (its radar index page; the few it omits fall back to the map marker). The
  // scope of every frame is centred on that point, so a locked lat/long is
  // measured from here to land on the picture.
  // `range` is the plot radius in km, read off that station's own frame header.
  // It is recorded only where it was verified; an entry without it is drawn as
  // the 150 km IMD's PPI products plot at, and the caption says so.
  let stations = [
    {code: "agt", name: "Agartala", lat: 23.8315, lon: 91.2868},
    {code: "aya", name: "Ayanagar", lat: 28.4833, lon: 77.125},
    {code: "bnh", name: "Banihal", lat: 33.51, lon: 75.205},
    {code: "bln", name: "Belonia", lat: 23.2489, lon: 91.463},
    {code: "bhp", name: "Bhopal", lat: 23.2599, lon: 77.4126},
    {code: "bhj", name: "Bhuj", lat: 23.242, lon: 69.6669},
    {code: "cni", name: "Chennai", lat: 13.0827, lon: 80.2707, range: 150},
    {code: "delhi", name: "Delhi", lat: 28.5632, lon: 77.1912},
    {code: "dmu", name: "Dimapur", lat: 25.9028, lon: 93.7031},
    {code: "goa", name: "Goa", lat: 15.4909, lon: 73.8278},
    {code: "gop", name: "Gopalpur", lat: 19.2647, lon: 84.862},
    {code: "hyd", name: "Hyderabad", lat: 17.385, lon: 78.4867},
    {code: "jpr", name: "Jaipur", lat: 26.9124, lon: 75.7873},
    {code: "jmu", name: "Jammu", lat: 32.9266, lon: 74.857},
    {code: "jrh", name: "Jorhat", lat: 26.7169, lon: 94.194},
    {code: "jot", name: "Jot", lat: 32.4868, lon: 76.0593},
    {code: "kkl", name: "Karaikal", lat: 10.9254, lon: 79.838, range: 150},
    {code: "koc", name: "Kochi", lat: 9.9312, lon: 76.2673},
    {code: "kol", name: "Kolkata", lat: 22.5726, lon: 88.3639},
    {code: "kuf", name: "Kufri", lat: 31.0978, lon: 77.2678},
    {code: "ldn", name: "Lansdowne", lat: 29.85, lon: 78.6767},
    {code: "leh", name: "Leh", lat: 34.2833, lon: 77.2833},
    {code: "lkn", name: "Lucknow", lat: 26.8467, lon: 80.9462},
    {code: "mpt", name: "Machilipatnam", lat: 16.1905, lon: 81.1362},
    {code: "mlr", name: "Mangaluru", lat: 12.95, lon: 74.84},
    {code: "mbr", name: "Mohanbari", lat: 27.4728, lon: 94.912},
    {code: "mks", name: "Mukteshwar", lat: 29.4604, lon: 79.6558},
    {code: "mum", name: "Mumbai-Colaba", lat: 19.076, lon: 72.8777, range: 150},
    {code: "vrv", name: "Mumbai-Veravali", lat: 19.7343, lon: 72.8763},
    {code: "mur", name: "Murari", lat: 30.7898, lon: 78.9179},
    {code: "ngp", name: "Nagpur", lat: 21.1458, lon: 79.0882},
    {code: "dlh", name: "Palam", lat: 28.5901, lon: 77.0888},
    // the one station found plotting closer: its header prints Range:85.0km
    {code: "plk", name: "Pallikaranai", lat: 12.9451, lon: 80.2115, range: 85},
    {code: "pdp", name: "Paradip", lat: 20.3166, lon: 86.6114},
    {code: "ptl", name: "Patiala", lat: 30.3398, lon: 76.3869},
    {code: "ptn", name: "Patna", lat: 25.5941, lon: 85.1376},
    {code: "rpr", name: "Raipur", lat: 21.25, lon: 81.63},
    {code: "sbp", name: "Sambalpur", lat: 21.5374, lon: 83.9809},
    {code: "sil", name: "Silkheda", lat: 23.5716, lon: 77.2461},
    {code: "cpj", name: "Sohra", lat: 25.2702, lon: 91.7323},
    {code: "slp", name: "Solapur", lat: 17.6599, lon: 75.9064},
    {code: "shr", name: "Sriharikota", lat: 13.7259, lon: 80.2266},
    {code: "srn", name: "Srinagar", lat: 34.0837, lon: 74.7974},
    {code: "sur", name: "Surkandaji", lat: 30.4114, lon: 78.2885},
    {code: "tez", name: "Tezpur", lat: 26.6385, lon: 92.8146},
    {code: "tvm", name: "Thiruvananthapuram", lat: 8.5241, lon: 76.9366},
    {code: "vsk", name: "Visakhapatnam", lat: 17.6868, lon: 83.2185, range: 150}
  ]
  let q = lower(trim(query))
  let matches = q == "" ? [] : take(filter(stations, s => contains(lower(s.name), q) || contains(s.code, q)), 6)
  let recentCodes = take(unique(filter([station, recent1, recent2, recent3], c => c != "")), 3)
  let recentStations = filter(map(recentCodes, c => find(stations, s => s.code == c)), x => x != null)
  // what the row under the field offers: the typed matches, or the last picks
  let picks = q == "" ? recentStations : matches
  let site = find(stations, s => s.code == station)
  let pickedName = site.name ?? upper(station)

  let out = radar != null && radar.ok ? radar.out : null
  let path = out.path
  let updated = out.updated
  let title = "${pickedName} radar"
  let img = view == "diff" ? out.diff : view == "previous" ? out.prev : view == "wind" ? null : out.path
  let caption = out == null
    ? (radar == null ? "loading…" : radar.ok ? "no image" : "offline")
    : (updated != null ? "updated ${fmtTime(updated, "HH:mm")}" : title)
  let maxPanX = (screenWidth ?? 0) / 2 * (zoom - 1)
  let maxPanY = (screenHeight ?? 0) * 0.45 * (zoom - 1)

  // The locked spot, typed as degrees. The frame's own geometry places it: the
  // scope is a square of side h centred on the site, its half-side being the
  // plotted range, so degrees to the north/east scale linearly from there.
  let geo = out.geo
  let spot = lock == "2" ? 2 : 1
  let spotName = lock == "2" ? name2 : name1
  let spotLat = lock == "2" ? lat2 : lat1
  let spotLon = lock == "2" ? lon2 : lon1
  let spotLabel = spotName == "" ? "L${spot}" : spotName
  let markLatN = num(spotLat, 999)
  let markLonN = num(spotLon, 999)
  let markOn = lock != "" && geo != null && site != null && abs(markLatN) <= 90 && abs(markLonN) <= 180

  // Wind comes from Open-Meteo's blended model (DWD ICON and NOAA GFS): nothing
  // is read off an image, so it works for every station and for a locked spot.
  // One request answers both points — the station pair is repeated when nothing
  // is locked, so the reply is always a list — and a changed URL is fetched at
  // once instead of waiting out the interval. Its CC-BY-4.0 licence asks for
  // attribution, so the source is named wherever the numbers appear.
  let siteLat = fixed(site.lat ?? 13.0827, 4)
  let siteLon = fixed(site.lon ?? 80.2707, 4)
  let windLat = "${siteLat},${markOn ? fixed(markLatN, 4) : siteLat}"
  let windLon = "${siteLon},${markOn ? fixed(markLonN, 4) : siteLon}"

  source wind = http("https://api.open-meteo.com/v1/forecast?latitude=${enc(windLat)}&longitude=${enc(windLon)}&current=wind_speed_10m,wind_direction_10m,wind_gusts_10m,wind_speed_80m,wind_direction_80m,wind_speed_120m,wind_direction_120m&wind_speed_unit=kmh&timezone=Asia%2FKolkata") every 15m json timeout 20s status

  let w = wind != null && wind.ok && wind.out != null ? wind.out : null
  // 0 is the station, 1 the locked spot, in the order the URL asked for them
  let siteWind = w != null && w[0] != null ? w[0].current : null
  let spotWind = w != null && markOn && w[1] != null ? w[1].current : null
  let DIRS = split("N NNE NE ENE E ESE SE SSE S SSW SW WSW W WNW NW NNW", " ")
  // the 16 sectors are 22.5° wide, so the one containing a bearing starts at -11.25
  let siteDeg = siteWind != null ? num(siteWind.wind_direction_10m, 0) : 0
  let siteDir = DIRS[int((siteDeg + 11.25) % 360 / 22.5)]
  let spotDeg = spotWind != null ? num(spotWind.wind_direction_10m, 0) : 0
  let spotDir = DIRS[int((spotDeg + 11.25) % 360 / 22.5)]
  let windText = siteWind == null ? null
    : "wind ${siteDir} ${round(siteDeg)}° ${round(num(siteWind.wind_speed_10m, 0))} km/h, gusts ${round(num(siteWind.wind_gusts_10m, 0))}"
  let windTime = siteWind != null ? siteWind.time : null
  let windStamp = replace(str(windTime), "T", " ")
  let windMissing = wind == null ? "asking Open-Meteo…"
    : wind.ok ? "no wind for these coordinates" : "no wind reading — Open-Meteo unreachable"
  let windFrom = siteWind == null ? "wind: Open-Meteo (DWD ICON / NOAA GFS)"
    : "model wind at 10, 80 and 120 m · Open-Meteo, ${windStamp} IST · a model, not a measurement"
  let northKm = (markLatN - (site.lat ?? 0)) * 110.574
  let eastKm = (markLonN - (site.lon ?? 0)) * 111.32 * cos(rad(site.lat ?? 0))
  let markKm = sqrt(northKm * northKm + eastKm * eastKm)
  let markX = (geo.cx ?? 0) + eastKm * (geo.k ?? 0)
  let markY = (geo.cy ?? 0) - northKm * (geo.k ?? 0)
  let diffGap = (geo.dw ?? 0) - 2 * (geo.dh ?? 0)
  let lockNote = lock == "" ? null : markOn
    ? "${spotLabel} · ${round(abs(markLatN), 4)}°${markLatN < 0 ? "S" : "N"} ${round(abs(markLonN), 4)}°${markLonN < 0 ? "W" : "E"} · ${round(markKm)} km from ${pickedName}${markKm > (geo.range ?? 150) ? " · beyond this radar's range" : ""}${site.range == null ? " · assumes this radar plots 150 km" : ""}"
    : "${spotLabel}: type a latitude and a longitude in degrees"
  // the switch shows where a spot has a place: on the live picture it marks the
  // frame, on the wind page it gets its own reading
  let lockUi = view == "current" || view == "wind"

  // one place where a pick lands: a tap, the field's submit or an owl-send set
  on station {
    recent3 = recent2
    recent2 = recent1
    recent1 = old
    // a spot is measured from the station it was locked against, so a new
    // station drops it; the two saved spots keep their names and coordinates
    lock = ""
    run("mkdir -p ~/.cache/omalauncher-imd-radar && printf '%s' ${sh(station)} > ~/.cache/omalauncher-imd-radar/station && printf '%s' ${sh(pickedName)} > ~/.cache/omalauncher-imd-radar/station.name && printf '%s' ${sh(site.range ?? 150)} > ~/.cache/omalauncher-imd-radar/range.km && date +%s > ~/.cache/omalauncher-imd-radar/force")
    refresh()
  }

  // Arrow points where the wind blows FROM (weather-vane style), matching the text
  component WindArrow(bearing, sz = 14, tint = cyan) {
    Canvas {
      width: sz
      height: sz
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2 - 1
      circle(cx, cy, r, stroke: border, width: 1)
      rotate(bearing, cx, cy) {
        path([{x: cx, y: cy - r * 0.55}, {x: cx + r * 0.5, y: cy + r * 0.45}, {x: cx, y: cy + r * 0.18}, {x: cx - r * 0.5, y: cy + r * 0.45}], closed: true, fill: tint)
      }
    }
  }

  // One Open-Meteo reading for one point: the vane and the near-surface wind on
  // the first line, the two taller model levels under it. Before owl 10 a Text in
  // a Row takes all the width left to it, so the row holds one Text only.
  component WindBlock(who, at, cur, deg, dir, tint = cyan) {
    Column {
      gap: 6
      Row {
        gap: 8
        align: center
        WindArrow { bearing: deg; sz: 28; tint: tint }
        Text { text: "${who} · ${dir} ${round(deg)}°"; color: tint; fontSize: 20; maxLines: 1 }
      }
      Text {
        text: "${at} · 10 m ${round(num(cur.wind_speed_10m, 0))} km/h · gusts ${round(num(cur.wind_gusts_10m, 0))}"
        fontSize: 16
        color: foreground
      }
      Text {
        text: "80 m  ${round(num(cur.wind_speed_80m, 0))} km/h ${round(num(cur.wind_direction_80m, 0))}° · 120 m  ${round(num(cur.wind_speed_120m, 0))} km/h ${round(num(cur.wind_direction_120m, 0))}°"
        fontSize: 16
        color: foreground
      }
    }
  }

  // The locked point on the picture: a core that throbs under a ring beating
  // outward. x, y are pixels of the image being shown and w, h its size, so the
  // mark rides the same contain/cover fit — and the same zoom and pan.
  component Mark(x, y, w, h, cover = false, sz = 1) {
    Canvas {
      fill: true
      let s = cover ? max(width / w, height / h) : min(width / w, height / h)
      let px = (width - w * s) / 2 + x * s
      let py = (height - h * s) / 2 + y * s
      let ax = cover ? px : width / 2 + (px - width / 2) * zoom + panX
      let ay = cover ? py : height / 2 + (py - height / 2) * zoom + panY
      let ph = (time % 1.5) / 1.5
      layer(1 - ph) {
        circle(ax, ay, sz * (6 + ph * 20), stroke: bright_red, width: 2.5)
      }
      circle(ax, ay, sz * (3 + abs(sin(time * 3.2)) * 1.4), fill: bright_red, stroke: foreground, width: 1.5)
    }
  }

  // Picks set the station; the on station trigger writes the cache files the
  // scripts read and wipes the frame cache when it changes
  component StationBtn(code, label) {
    Button {
      text: label
      color: station == code ? accent : muted
      onTap: {
        station = code
        query = ""
      }
    }
  }

  onTap: screen()

  Box {
    fill: true
    align: bottom
    if path != null {
      Image { src: path; fit: cover; fill: true }
      if markOn {
        Mark { x: markX; y: markY; w: geo.w; h: geo.h; cover: true; sz: 0.7 }
      }
    } else {
      Column {
        fill: true
        align: center
        gap: 4
        Text { text: title; style: muted }
        Text { text: caption; style: small; color: muted }
      }
    }
    Column {
      fill: width
      gap: 0
      padding: [10, 6]
      background: alpha(background, 0.75)
      Text { text: title; fontSize: 12; maxLines: 1 }
      Text { text: caption; fontSize: 10; color: muted; maxLines: 1 }
      if windText != null {
        Row {
          gap: 4
          align: center
          WindArrow { bearing: siteDeg }
          Text { text: windText; fontSize: 10; color: cyan; maxLines: 1 }
        }
      }
    }
  }

  screen {
    title: title
    Column {
      fill: true
      gap: 8
      padding: 12

      Row {
        gap: 6
        Button {
          text: "live"
          color: view == "current" ? accent : muted
          onTap: view = "current"
        }
        Button {
          text: "diff"
          color: view == "diff" ? accent : muted
          onTap: view = "diff"
        }
        Button {
          text: "prev"
          color: view == "previous" ? accent : muted
          onTap: view = "previous"
        }
        Button {
          text: "wind"
          color: view == "wind" ? accent : muted
          onTap: view = "wind"
        }
        Spacer { weight: 1 }
        Button {
          text: "reset"
          color: zoom == 1 && panX == 0 && panY == 0 ? muted : accent
          onTap: {
            zoom = 1
            panX = 0
            panY = 0
          }
        }
      }

      Input {
        placeholder: "search an IMD radar station…"
        text: query
        clear: true
        onChange: query = value
        // the pick comes before the field empties: picks is derived from the
        // query, so clearing it first would offer the recent three instead
        onSubmit: {
          station = first(picks).code ?? station
          query = ""
        }
      }
      Row {
        gap: 6
        for s in picks {
          StationBtn { code: s.code; label: s.name }
        }
      }
      if q != "" && len(picks) == 0 {
        Text { text: "no IMD radar by that name"; style: small; color: muted }
      }

      // The wind tab has no picture to show, so it takes the map's place with
      // the readings themselves: one block for the station, and one for the
      // locked spot when there is one.
      if view == "wind" {
        Column {
          weight: 1
          fill: width
          align: center
          gap: 16
          if siteWind != null {
            WindBlock { who: pickedName; at: "${siteLat}° ${siteLon}°"; cur: siteWind; deg: siteDeg; dir: siteDir }
          }
          if spotWind != null {
            WindBlock { who: spotLabel; at: "${fixed(markLatN, 4)}° ${fixed(markLonN, 4)}°"; cur: spotWind; deg: spotDeg; dir: spotDir; tint: bright_red }
          }
          if siteWind == null {
            Text { text: windMissing; fontSize: 18; color: foreground }
          }
          Text { text: windFrom; fontSize: 14; color: muted }
        }
      } else {
        Box {
          weight: 1
          fill: width
          clip: true
          onDrag: {
            panX = clamp(panX + dx, -maxPanX, maxPanX)
            panY = clamp(panY + dy, -maxPanY, maxPanY)
          }
          onTap: {
            zoom = zoom < 5 ? zoom + 1 : 1
            panX = zoom == 1 ? 0 : panX
            panY = zoom == 1 ? 0 : panY
          }
          // the diff's two panels hold the same area, so the point lands twice
          let diffX = (markX - (geo.dx ?? 0)) * (geo.ds ?? 1)
          let diffY = (markY - (geo.dy ?? 0)) * (geo.ds ?? 1)
          if img != null {
            Image { src: img; fit: contain; fill: true; scale: zoom; offset: [panX, panY]; animate scale: spring() }
            if markOn {
              if view == "diff" && (geo.dw ?? 0) > 0 {
                for off in [0, (geo.dh ?? 0) + diffGap] {
                  Mark { x: diffX + off; y: diffY; w: geo.dw; h: geo.dh }
                }
              } else {
                Mark { x: markX; y: markY; w: geo.w; h: geo.h }
              }
            }
          } else {
            Column {
              fill: true
              align: center
              gap: 6
              Text {
                text: view == "diff"
                  ? "Need two frames for the site comparison"
                  : view == "previous" ? "No previous frame yet"
                  : "No radar image yet"
                color: muted
              }
              Text { text: "Pulls PPI reflectivity from IMD"; style: small; color: muted }
            }
          }
        }
      }

      if view != "wind" {
        Text { text: "drag to pan · tap map to zoom · tap at 5x to reset"; style: small; color: muted }
      }

      if view == "diff" && out.diff == null {
        Text { text: "Need two frames for the site comparison — wait for the next IMD update"; style: small; color: muted }
      }

      if view != "wind" && windText != null {
        Row {
          gap: 6
          align: center
          WindArrow { bearing: siteDeg; sz: 20 }
          Text { text: windText; fontSize: 16; color: cyan; maxLines: 1 }
        }
      }

      Text { text: "refresh every"; style: small; color: muted }
      Row {
        gap: 6
        Button {
          text: "10m"
          color: intervalMin == 10 ? accent : muted
          onTap: {
            intervalMin = 10
            run("mkdir -p ~/.cache/omalauncher-imd-radar && printf '%s' 10 > ~/.cache/omalauncher-imd-radar/interval.min")
            refresh()
          }
        }
        Button {
          text: "20m"
          color: intervalMin == 20 ? accent : muted
          onTap: {
            intervalMin = 20
            run("mkdir -p ~/.cache/omalauncher-imd-radar && printf '%s' 20 > ~/.cache/omalauncher-imd-radar/interval.min")
            refresh()
          }
        }
        Button {
          text: "30m"
          color: intervalMin == 30 ? accent : muted
          onTap: {
            intervalMin = 30
            run("mkdir -p ~/.cache/omalauncher-imd-radar && printf '%s' 30 > ~/.cache/omalauncher-imd-radar/interval.min")
            refresh()
          }
        }
      }

      Row {
        gap: 8
        Button {
          text: "open IMD"
          onTap: url(out.url ?? "https://mausam.imd.gov.in/responsive/radar.php")
        }
        Button {
          text: "refresh now"
          onTap: {
            run("mkdir -p ~/.cache/omalauncher-imd-radar && date +%s > ~/.cache/omalauncher-imd-radar/force.tmp && mv -f ~/.cache/omalauncher-imd-radar/force.tmp ~/.cache/omalauncher-imd-radar/force")
            refresh()
          }
        }
        Spacer { weight: 1 }
        // the two spots share this line with the links: the named one is drawn
        // on the map, off takes the mark away. Only the live picture offers the
        // switch — the other views just show wherever it was left.
        if lockUi {
          Row {
            gap: 8
            Button {
              text: "off"
              color: lock == "" ? accent : muted
              onTap: lock = ""
            }
            Button {
              text: name1 == "" ? "L1" : name1
              color: lock == "1" ? accent : muted
              onTap: lock = "1"
            }
            Button {
              text: name2 == "" ? "L2" : name2
              color: lock == "2" ? accent : muted
              onTap: lock = "2"
            }
          }
        }
      }

      if lock == "1" && lockUi {
        Row {
          gap: 6
          Input { placeholder: "name"; text: name1; onChange: name1 = value; weight: 1 }
          Input { placeholder: "lat"; text: lat1; onChange: lat1 = value; weight: 1 }
          Input { placeholder: "lon"; text: lon1; onChange: lon1 = value; weight: 1 }
        }
      }
      if lock == "2" && lockUi {
        Row {
          gap: 6
          Input { placeholder: "name"; text: name2; onChange: name2 = value; weight: 1 }
          Input { placeholder: "lat"; text: lat2; onChange: lat2 = value; weight: 1 }
          Input { placeholder: "lon"; text: lon2; onChange: lon2 = value; weight: 1 }
        }
      }
      if lockNote != null && lockUi {
        Text { text: lockNote; style: small; color: muted }
      }

      Text {
        text: (out != null ? "${out.product}_${out.station} · " : "") + "every ${intervalMin}m · zoom ${zoom}x"
        style: small
        color: muted
      }
    }
  }
}
