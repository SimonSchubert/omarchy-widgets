// Author: 9G420. MIT. Seven-language monitor for a user-configured Linux server.
widget "Server Pulse" {
  size: 4x4
  minSize: 2x2
  padding: 10
  meta { owl: 6; version: "1.6.0"; author: "9G420"; license: "MIT"; category: "system"; description: "Read-only status for your own Linux server over pinned SSH; optional LAN first with Tailscale fallback." }
  requires { pacman: ["openssh", "python"] }

  state host = "" persist
  state lanHost = "" persist
  state user = "" persist
  state port = "22" persist
  state displayName = "SERVER" persist
  state lastSnapshot = null
  state language = "en" persist
  state section = "overview"
  state trafficLimit = "150" persist
  state events = [] persist
  state checkStartedAt = 0
  state eventAt = 0
  state motionEnabled = true persist
  state snapshotReceivedAt = 0
  state previousSnapshot = null
  state trafficSamples = []

  let localeCodes = ["en", "zh", "es", "de", "fr", "ja", "ko"]
  let languageIndex = max(0, indexOf(localeCodes, language))
  let hostText = trim(host)
  let lanHostText = trim(lanHost)
  let userText = trim(user)
  let portNumber = num(port, 0)
  let targetOk = match(hostText, "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$") != null
      && (lanHostText == "" || match(lanHostText, "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$") != null)
      && match(userText, "^[A-Za-z_][A-Za-z0-9_.-]{0,31}$") != null
      && portNumber >= 1 && portNumber <= 65535
  let target = userText + "@" + hostText

  // Quiet instrument panel: neutral labels, semantic status, theme accent highlights.
  let pInk = mix(foreground, accent, 0.24)
  let pMuted = foreground
  let pBlue = blue
  let pGreen = accent
  let pRed = red
  let pAccent = accent
  let pCyan = cyan
  let pPanel = surface
  let tileSurface = background
  let pBorder = mix(border, foreground, 0.18)

  // A missing or failed transport never fabricates healthy readings. SSH errors stay on stderr.
  let sshClient = """
import json
import math
from pathlib import Path
import re
import subprocess
import sys
import time

host, lan_host, user, port_text = sys.argv[1:5]
if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}", host)
        or (lan_host and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}", lan_host))
        or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]{0,31}", user)
        or not port_text.isdigit() or not 1 <= int(port_text) <= 65535):
    print('{"schema":0,"error":"invalid_target"}')
    raise SystemExit(0)
ssh_dir = Path.home() / ".ssh"
started = time.monotonic()
targets = ([(lan_host, "lan")] if lan_host and lan_host != host else []) + [(host, "tailscale")]
last_reason = "unreachable"
try:
    result = None
    route = "tailscale"
    for remote_host, candidate_route in targets:
        command = ["ssh", "-T", "-F", "/dev/null", "-i", str(ssh_dir / "server-pulse"), "-p", port_text,
            "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", "-o", "PreferredAuthentications=publickey",
            "-o", "PasswordAuthentication=no", "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=yes",
            "-o", "UserKnownHostsFile=" + str(ssh_dir / "known_hosts"), "-o", "GlobalKnownHostsFile=/dev/null",
            "-o", "UpdateHostKeys=no", "-o", "ForwardAgent=no",
            "-o", "ClearAllForwardings=yes", user + "@" + remote_host, "server-pulse-status"]
        try:
            result = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, timeout=4, check=False)
        except subprocess.TimeoutExpired:
            last_reason = "timeout"
            continue
        if result.returncode == 0:
            route = candidate_route
            break
        diagnostic = result.stderr[:8192].decode("utf-8", "replace").lower()
        if "permission denied" in diagnostic or "authentication failed" in diagnostic:
            raise ValueError("auth")
        if "host key verification failed" in diagnostic or "remote host identification has changed" in diagnostic:
            last_reason = "host_key"
        elif "connection timed out" in diagnostic or "operation timed out" in diagnostic:
            last_reason = "timeout"
        elif "connection refused" in diagnostic:
            last_reason = "refused"
        elif any(term in diagnostic for term in ("no route to host", "could not resolve hostname",
                "temporary failure in name resolution", "name or service not known", "network is unreachable")):
            last_reason = "unreachable"
        else:
            raise ValueError("remote_command")
    if result is None or result.returncode != 0:
        raise ValueError(last_reason)
    elapsed = round((time.monotonic() - started) * 1000, 1)
    if len(result.stdout) > 65536:
        raise ValueError("format")
    value = json.loads(result.stdout.decode("utf-8"))
    if not isinstance(value, dict) or type(value.get("schema")) is not int or value.get("schema") != 1:
        raise ValueError("format")
    def number(value, low, high):
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            return None
        if not math.isfinite(value) or not low <= value <= high:
            return None
        return value
    checked = value.get("checked_at")
    if type(checked) is not int or checked < 1 or checked > int(time.time()) + 60:
        raise ValueError("format")
    memory = value.get("memory") if isinstance(value.get("memory"), dict) else {}
    memory_total = number(memory.get("total_bytes"), 1, 2**63 - 1)
    memory_available = number(memory.get("available_bytes"), 0, memory_total) if memory_total is not None else None
    disk = value.get("root_disk") if isinstance(value.get("root_disk"), dict) else {}
    disk_total = number(disk.get("total_bytes"), 1, 2**63 - 1)
    disk_free = number(disk.get("free_bytes"), 0, disk_total) if disk_total is not None else None
    network = value.get("network") if isinstance(value.get("network"), dict) else {}
    iface = network.get("interface")
    if not isinstance(iface, str) or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,32}", iface):
        iface = None
    power = value.get("power") if isinstance(value.get("power"), dict) else {}
    external = power.get("external_power") if type(power.get("external_power")) is bool else None
    battery_state = power.get("battery_state")
    if battery_state not in ("charging", "discharging", "full", "not charging", "unknown"):
        battery_state = "unknown"
    checked_services = []
    services = value.get("services") if isinstance(value.get("services"), list) else []
    for item in services[:8]:
        if not isinstance(item, dict):
            continue
        name, status, expected = item.get("name"), item.get("status"), item.get("expected")
        if (not isinstance(name, str) or not name or len(name) > 48
                or any(ord(char) < 32 or ord(char) == 127 for char in name)
                or status not in ("active", "inactive", "failed", "unknown")
                or expected not in ("active", "inactive")):
            continue
        checked_services.append({"name": name, "status": status, "expected": expected,
                                 "healthy": status == expected})
    clean = {
        "schema": 1, "checked_at": checked,
        "uptime_seconds": number(value.get("uptime_seconds"), 0, 2**53),
        "load_1m": number(value.get("load_1m"), 0, 1_000_000),
        "cpu_percent": number(value.get("cpu_percent"), 0, 100),
        "memory": {"total_bytes": memory_total, "available_bytes": memory_available,
                   "used_percent": number(memory.get("used_percent"), 0, 100)},
        "root_disk": {"total_bytes": disk_total, "free_bytes": disk_free,
                      "used_percent": number(disk.get("used_percent"), 0, 100)},
        "network": {"interface": iface,
                    "rx_bytes": number(network.get("rx_bytes"), 0, 2**63 - 1),
                    "tx_bytes": number(network.get("tx_bytes"), 0, 2**63 - 1),
                    "link_mbps": number(network.get("link_mbps"), 1, 1_000_000)},
        "power": {"external_power": external,
                  "battery_percent": number(power.get("battery_percent"), 0, 100),
                  "battery_state": battery_state,
                  "battery_power_w": number(power.get("battery_power_w"), 0, 100_000)},
        "temperature_c": number(value.get("temperature_c"), -20, 130),
        "services": checked_services, "rtt_ms": elapsed, "connection_route": route,
    }
    print(json.dumps(clean, ensure_ascii=False, separators=(",", ":"), allow_nan=False))
except subprocess.TimeoutExpired:
    print('{"schema":0,"error":"timeout"}')
except json.JSONDecodeError:
    print('{"schema":0,"error":"format"}')
except UnicodeError:
    print('{"schema":0,"error":"format"}')
except (OSError, ValueError) as exc:
    reason = str(exc) if str(exc) in ("auth", "host_key", "timeout", "refused", "unreachable", "remote_command", "format") else "unreachable"
    print(json.dumps({"schema": 0, "error": reason}, separators=(",", ":")))
"""
  source pulse = cmd(targetOk
    ? "printf '%s' ${sh(sshClient)} | python -I - ${sh(hostText)} ${sh(lanHostText)} ${sh(userText)} ${sh(str(int(portNumber)))}"
    : "printf '%s' '{\"schema\":0,\"error\":\"unreachable\"}'") every 20s timeout 16s json
  source now = clock every 1s

  let strings = {
    unknown: ["UNKNOWN", "未知", "DESCONOCIDO", "UNBEKANNT", "INCONNU", "不明", "알 수 없음"],
    setup: ["SETUP REQUIRED", "需要设置", "CONFIGURACIÓN", "EINRICHTUNG", "CONFIGURATION", "設定が必要", "설정 필요"],
    running: ["RUNNING", "运行正常", "EN MARCHA", "IN BETRIEB", "EN MARCHE", "稼働中", "정상 실행"],
    attention: ["ATTENTION", "需要检查", "ATENCIÓN", "ACHTUNG", "ATTENTION", "要確認", "점검 필요"],
    noSignal: ["NO SIGNAL", "连接失败", "SIN SEÑAL", "KEIN SIGNAL", "AUCUN SIGNAL", "信号なし", "신호 없음"],
    stale: ["STALE DATA", "数据已过期", "DATOS ANTIGUOS", "VERALTETE DATEN", "DONNÉES PÉRIMÉES", "データが古い", "오래된 데이터"],
    overview: ["OVERVIEW", "总览", "RESUMEN", "ÜBERSICHT", "APERÇU", "概要", "개요"],
    network: ["NETWORK", "网络", "RED", "NETZWERK", "RÉSEAU", "ネットワーク", "네트워크"],
    power: ["POWER", "电源", "ENERGÍA", "STROM", "ÉNERGIE", "電源", "전원"],
    resources: ["RESOURCES", "资源", "RECURSOS", "RESSOURCEN", "RESSOURCES", "リソース", "리소스"],
    services: ["SERVICES", "服务", "SERVICIOS", "DIENSTE", "SERVICES", "サービス", "서비스"],
    eventsTitle: ["EVENTS", "事件", "EVENTOS", "EREIGNISSE", "ÉVÉNEMENTS", "イベント", "이벤트"],
    connection: ["CONNECTION", "连接设置", "CONEXIÓN", "VERBINDUNG", "CONNEXION", "接続設定", "연결 설정"],
    cpu: ["CPU LOAD", "CPU 使用率", "CARGA CPU", "CPU-LAST", "CHARGE CPU", "CPU 使用率", "CPU 부하"],
    memory: ["MEMORY", "内存", "MEMORIA", "ARBEITSSPEICHER", "MÉMOIRE", "メモリ", "메모리"],
    disk: ["ROOT DISK", "根磁盘", "DISCO RAÍZ", "ROOT-DATENTRÄGER", "DISQUE RACINE", "ルートディスク", "루트 디스크"],
    uptime: ["UPTIME", "运行时间", "ACTIVIDAD", "LAUFZEIT", "DISPONIBILITÉ", "稼働時間", "가동 시간"],
    checked: ["LAST CHECK", "最近检查", "ÚLTIMA COMPROBACIÓN", "LETZTE PRÜFUNG", "DERNIÈRE VÉRIFICATION", "最終確認", "마지막 확인"],
    inbound: ["DOWNLOAD", "下行", "ENTRADA", "EINGANG", "ENTRÉE", "受信", "수신"],
    outbound: ["UPLOAD", "上行", "SALIDA", "AUSGANG", "SORTIE", "送信", "송신"],
    latency: ["SSH ROUND TRIP", "SSH 往返时间", "RESPUESTA SSH", "SSH-ANTWORTZEIT", "RÉPONSE SSH", "SSH 応答時間", "SSH 응답 시간"],
    interface: ["GUEST INTERFACE", "Linux 客体网卡", "INTERFAZ INVITADA", "GAST-SCHNITTSTELLE", "INTERFACE INVITÉE", "ゲストの接続", "게스트 인터페이스"],
    link: ["GUEST LINK", "客体链路", "ENLACE INVITADO", "GAST-LINK", "LIEN INVITÉ", "ゲスト回線", "게스트 링크"],
    external: ["EXTERNAL POWER", "外接电源", "ALIMENTACIÓN EXTERNA", "EXTERNE STROMVERSORGUNG", "ALIMENTATION EXTERNE", "外部電源", "외부 전원"],
    battery: ["BATTERY", "电池", "BATERÍA", "AKKU", "BATTERIE", "バッテリー", "배터리"],
    temperature: ["TEMPERATURE", "温度", "TEMPERATURA", "TEMPERATUR", "TEMPÉRATURE", "温度", "온도"],
    chargeRate: ["BATTERY POWER", "电池功率", "POTENCIA DE BATERÍA", "AKKULEISTUNG", "PUISSANCE BATTERIE", "バッテリー電力", "배터리 전력"],
    state: ["STATE", "状态", "ESTADO", "STATUS", "ÉTAT", "状態", "상태"],
    expected: ["EXPECTED", "预期", "ESPERADO", "ERWARTET", "ATTENDU", "期待", "기대 상태"],
    noServices: ["No services selected", "尚未选择服务", "Sin servicios elegidos", "Keine Dienste ausgewählt", "Aucun service choisi", "サービス未選択", "선택한 서비스 없음"],
    noEvents: ["No status changes recorded yet", "暂未记录到状态变化", "Aún no hay cambios de estado", "Noch keine Statusänderung", "Aucun changement d’état enregistré", "状態変化はまだありません", "아직 기록된 상태 변경이 없습니다"],
    eventEmptyHelp: ["Changes will appear here when the monitored server status changes.", "监控到服务器状态变化后，会在这里显示时间、变化内容和原因。", "Los cambios aparecerán aquí cuando cambie el estado del servidor.", "Änderungen erscheinen hier, sobald sich der Serverstatus ändert.", "Les changements apparaîtront ici quand l’état du serveur changera.", "サーバー状態が変化すると、ここに表示されます。", "서버 상태가 바뀌면 여기에 표시됩니다."],
    statusChanged: ["STATUS CHANGED", "状态变化", "CAMBIO DE ESTADO", "STATUSÄNDERUNG", "ÉTAT MODIFIÉ", "状態変化", "상태 변경"],
    statusDetected: ["STATUS DETECTED", "检测到状态", "ESTADO DETECTADO", "STATUS ERKANNT", "ÉTAT DÉTECTÉ", "状態を検出", "상태 감지"],
    initialStatus: ["FIRST STATUS", "首次检测", "ESTADO INICIAL", "ERSTER STATUS", "ÉTAT INITIAL", "初回検出", "첫 상태 감지"],
    serviceMismatch: ["One or more services differ from expected state", "有服务状态与预期不符", "Uno o más servicios no coinciden con lo esperado", "Mindestens ein Dienst weicht vom Sollzustand ab", "Un ou plusieurs services ne correspondent pas à l’état attendu", "期待と異なる状態のサービスがあります", "예상 상태와 다른 서비스가 있습니다"],
    staleDataReason: ["No fresh server data for more than 180 seconds", "超过 180 秒没有收到新数据", "Sin datos nuevos durante más de 180 segundos", "Seit über 180 Sekunden keine neuen Daten", "Aucune donnée récente depuis plus de 180 secondes", "180 秒以上新しいデータがありません", "180초 넘게 새 데이터가 없습니다"],
    staleConnectionReason: ["Connection failed; showing the last saved readings", "连接失败，当前显示上次保存的数据", "Falló la conexión; se muestran los últimos datos", "Verbindung fehlgeschlagen; letzte Werte werden angezeigt", "Connexion échouée ; affichage des dernières mesures", "接続に失敗したため、前回の値を表示しています", "연결 실패, 마지막 측정값을 표시합니다"],
    checkedAt: ["Snapshot time", "快照时间", "Hora de captura", "Zeitpunkt", "Heure du relevé", "取得時刻", "측정 시각"],
    threshold: ["TRAFFIC ALERT", "流量提醒", "ALERTA DE TRÁFICO", "DATENVERKEHR-ALARM", "ALERTE DE TRAFIC", "通信量アラート", "트래픽 알림"],
    thresholdHelp: ["Flag traffic above this Mbps limit for five samples.", "连续五次超过此 Mbps 阈值时提醒。", "Avisar tras cinco muestras sobre este límite Mbps.", "Meldung nach fünf Messungen über diesem Mbps-Wert.", "Alerte après cinq mesures au-dessus de cette limite en Mbit/s.", "Mbps のしきい値を5回超えると通知表示。", "Mbps 한도를 5회 연속 넘으면 표시합니다."],
    host: ["TAILNET HOST OR IP", "Tailscale 主机名或 IP", "HOST O IP DE TAILNET", "TAILNET-HOST ODER IP", "HÔTE OU IP TAILNET", "Tailnet のホスト名または IP", "Tailnet 호스트 또는 IP"],
    lanHost: ["HOME LAN HOST OR IP (OPTIONAL)", "家中局域网地址（可选）", "HOST O IP DE LAN (OPCIONAL)", "LAN-HOST ODER IP (OPTIONAL)", "HÔTE OU IP DU LAN (FACULTATIF)", "自宅 LAN のホスト名または IP（任意）", "집 LAN 호스트 또는 IP (선택)"],
    lanHelp: ["Try this address first; fall back to the Tailscale host when it cannot connect.", "优先直连此地址；连不上时自动回退到 Tailscale 地址。", "Se prueba primero; si no conecta, se usa Tailscale.", "Zuerst diese Adresse; bei Fehler Tailscale.", "Cette adresse d’abord ; Tailscale en secours.", "最初にこのアドレスへ接続し、失敗時は Tailscale に切り替えます。", "먼저 이 주소로 연결하고 실패하면 Tailscale로 전환합니다."],
    routeLan: ["LAN DIRECT", "局域网直连", "LAN DIRECTA", "DIREKTES LAN", "LAN DIRECT", "LAN 直結", "LAN 직접 연결"],
    routeTailscale: ["TAILSCALE", "Tailscale", "Tailscale", "Tailscale", "Tailscale", "Tailscale", "Tailscale"],
    account: ["SSH USER", "SSH 用户", "USUARIO SSH", "SSH-BENUTZER", "UTILISATEUR SSH", "SSH ユーザー", "SSH 사용자"],
    port: ["SSH PORT", "SSH 端口", "PUERTO SSH", "SSH-PORT", "PORT SSH", "SSH ポート", "SSH 포트"],
    keyPath: ["Private key: ~/.ssh/server-pulse", "私钥位置：~/.ssh/server-pulse", "Clave privada: ~/.ssh/server-pulse", "Privater Schlüssel: ~/.ssh/server-pulse", "Clé privée : ~/.ssh/server-pulse", "秘密鍵: ~/.ssh/server-pulse", "개인 키: ~/.ssh/server-pulse"],
    keyCheck: ["Host keys must already be verified in ~/.ssh/known_hosts.", "请先将已核验的主机密钥写入 ~/.ssh/known_hosts。", "Verifica antes la clave del servidor en ~/.ssh/known_hosts.", "Prüfe den Hostschlüssel zuerst in ~/.ssh/known_hosts.", "Vérifiez d’abord la clé d’hôte dans ~/.ssh/known_hosts.", "先に ~/.ssh/known_hosts でホスト鍵を確認してください。", "먼저 ~/.ssh/known_hosts에서 호스트 키를 확인하세요."],
    tailscale: ["SSH tries the optional LAN address first, then the Tailscale host. Verify both host keys in known_hosts.", "SSH 会先尝试可选的局域网地址，再连接 Tailscale 主机；请在 known_hosts 中核验两个地址的主机密钥。", "SSH prueba primero la LAN y luego Tailscale. Verifica ambas claves de host.", "SSH versucht zuerst LAN, dann Tailscale. Beide Hostschlüssel in known_hosts prüfen.", "SSH essaie d’abord le LAN, puis Tailscale. Vérifiez les deux clés d’hôte.", "SSH はまず LAN、次に Tailscale を試します。両方のホスト鍵を known_hosts で確認してください。", "SSH는 먼저 LAN, 다음 Tailscale을 시도합니다. 두 호스트 키를 known_hosts에서 확인하세요."],
    guide: ["Tailscale setup guide", "Tailscale 设置说明", "Guía de Tailscale", "Tailscale-Anleitung", "Guide Tailscale", "Tailscale ガイド", "Tailscale 안내"],
    refresh: ["CHECK NOW", "立即检查", "COMPROBAR", "JETZT PRÜFEN", "VÉRIFIER", "今すぐ確認", "지금 확인"],
    checking: ["CHECKING CONNECTION", "正在检查连接", "COMPROBANDO CONEXIÓN", "VERBINDUNG WIRD GEPRÜFT", "VÉRIFICATION DE LA CONNEXION", "接続を確認中", "연결 확인 중"],
    motion: ["MOTION", "动态效果", "MOVIMIENTO", "BEWEGUNG", "ANIMATION", "動き", "동작"],
    motionOn: ["ON", "开", "ACTIVADO", "EIN", "ACTIVÉ", "有効", "켬"],
    motionOff: ["OFF", "关", "DESACTIVADO", "AUS", "DÉSACTIVÉ", "無効", "끔"],
    save: ["SAVE", "保存", "GUARDAR", "SPEICHERN", "ENREGISTRER", "保存", "저장"],
    freshFor: ["Fresh for 180 seconds", "180 秒内为新鲜数据", "Vigente durante 180 s", "180 Sekunden aktuell", "À jour pendant 180 s", "180 秒間は最新", "180초 동안 최신"],
    unknownReason: ["This Linux environment cannot read the host sensor.", "此 Linux 环境无法读取主机传感器。", "Linux no puede leer este sensor del host.", "Linux kann diesen Host-Sensor nicht lesen.", "Linux ne peut pas lire ce capteur hôte.", "Linux 環境からホストセンサーを読めません。", "Linux 환경에서 호스트 센서를 읽을 수 없습니다."],
    dataSource: ["Linux guest readings; not necessarily the physical host link.", "Linux 客体数据，不一定代表物理主机的网络状态。", "Datos del invitado Linux; no necesariamente reflejan el enlace físico del host.", "Linux-Gastwerte; sie zeigen nicht zwingend die physische Hostverbindung.", "Mesures de l’invité Linux ; elles ne reflètent pas forcément le lien physique de l’hôte.", "Linux ゲストの値です。物理ホストの回線を示すとは限りません。", "Linux 게스트 측정값이며 물리 호스트 링크와 다를 수 있습니다."],
    languageTitle: ["LANGUAGE", "语言", "IDIOMA", "SPRACHE", "LANGUE", "言語", "언어"],
    noConnection: ["Set up your server.", "设置你的服务器。", "Configura tu servidor.", "Server einrichten.", "Configurez votre serveur.", "サーバーを設定してください。", "서버를 설정하세요."],
    readOnly: ["Read-only monitoring", "只读监控", "Monitorización de solo lectura", "Nur-Lese-Überwachung", "Surveillance en lecture seule", "読み取り専用の監視", "읽기 전용 모니터링"],
    setupIntro: ["Connect to a server you own or may monitor over a private network. Only your configured SSH target is queried.", "通过私有网络连接你自己的服务器；组件只查询你配置的 SSH 目标。", "Conéctate por red privada a tu propio servidor. Solo se consulta el destino SSH que configures.", "Verbinde dich über ein privates Netzwerk mit deinem Server. Abgefragt wird nur dein konfiguriertes SSH-Ziel.", "Connectez-vous à votre serveur via un réseau privé. Seule votre cible SSH configurée est interrogée.", "プライベートネットワーク経由で自分のサーバーに接続します。設定した SSH 接続先だけを照会します。", "사설 네트워크로 사용자 서버에 연결합니다. 설정한 SSH 대상만 조회합니다."],
    displayName: ["SERVER NAME", "服务器名称", "NOMBRE DEL SERVIDOR", "SERVERNAME", "NOM DU SERVEUR", "サーバー名", "서버 이름"],
    displayNameHint: ["My Server", "我的服务器", "Mi servidor", "Mein Server", "Mon serveur", "マイサーバー", "내 서버"],
    onlineDesc: ["Network and services available", "网络与服务可用", "Red y servicios disponibles", "Netzwerk und Dienste verfügbar", "Réseau et services disponibles", "ネットワークとサービスは利用可能", "네트워크 및 서비스 사용 가능"],
    offlineDesc: ["Private connection unavailable; last snapshot retained", "私网连接不可用；保留上次快照", "Conexión privada no disponible; último estado", "Privatverbindung fehlt; letzter Stand bleibt", "Connexion privée absente ; dernier état conservé", "私網に接続できず、前回の情報を保持", "사설망 연결 실패, 마지막 상태 유지"],
    details: ["OPEN DETAILS", "查看详情", "VER DETALLES", "DETAILS ÖFFNEN", "OUVRIR LES DÉTAILS", "詳細を開く", "세부 정보 보기"],
    partialDesc: ["Some host readings are unavailable", "部分主机数据暂不可用", "Algunos datos del host no están disponibles", "Einige Hostwerte sind nicht verfügbar", "Certaines mesures hôte sont indisponibles", "一部のホスト情報を取得できません", "일부 호스트 측정값을 사용할 수 없습니다"],
    trafficAlert: ["Sustained traffic exceeds the selected limit", "持续流量高于设定阈值", "El tráfico sostenido supera el límite", "Anhaltender Datenverkehr über dem Grenzwert", "Trafic soutenu au-dessus du seuil", "継続通信量が設定値を超過", "지속 트래픽이 설정 한도를 초과"],
    cpuAlert: ["CPU is above 90%", "CPU 使用率超过 90%", "CPU por encima del 90%", "CPU über 90%", "CPU au-dessus de 90 %", "CPU 使用率が 90% 超過", "CPU 사용률 90% 초과"],
    memoryAlert: ["Memory is above 90%", "内存使用率超过 90%", "Memoria por encima del 90%", "Speicher über 90%", "Mémoire au-dessus de 90 %", "メモリ使用率が 90% 超過", "메모리 사용률 90% 초과"],
    diskAlert: ["Root disk is above 90%", "根磁盘使用率超过 90%", "Disco raíz por encima del 90%", "Root-Datenträger über 90%", "Disque racine au-dessus de 90 %", "ルートディスクが 90% 超過", "루트 디스크 90% 초과"],
    errAuth: ["AUTHENTICATION FAILED · check the restricted key/user", "认证失败 · 检查专用密钥和用户", "AUTENTICACIÓN · revisa clave y usuario", "AUTHENTIFIZIERUNG · Schlüssel und Benutzer prüfen", "AUTHENTIFICATION · vérifier clé et utilisateur", "認証失敗 · 鍵とユーザーを確認", "인증 실패 · 키와 사용자 확인"],
    errHostKey: ["HOST KEY MISMATCH · verify known_hosts out of band", "主机密钥不匹配 · 请线下核验 known_hosts", "CLAVE DEL HOST · verifica known_hosts", "HOSTSCHLÜSSEL · known_hosts prüfen", "CLÉ HÔTE · vérifier known_hosts", "ホスト鍵不一致 · known_hosts を別経路で確認", "호스트 키 불일치 · known_hosts 확인"],
    errTimeout: ["CONNECTION TIMED OUT · check server reachability", "连接超时 · 检查服务器网络", "TIEMPO AGOTADO · revisa la pRed", "ZEITÜBERSCHREITUNG · Netzwerk prüfen", "DÉLAI DÉPASSÉ · vérifier le réseau", "接続タイムアウト · 経路を確認", "연결 시간 초과 · 경로 확인"],
    errRefused: ["CONNECTION REFUSED · check SSH port/service", "连接被拒绝 · 检查 SSH 端口/服务", "CONEXIÓN RECHAZADA · revisa SSH", "VERBINDUNG ABGELEHNT · SSH prüfen", "CONNEXION REFUSÉE · vérifier SSH", "接続拒否 · SSH ポート/服务を確認", "연결 거부 · SSH 포트/서비스 확인"],
    errUnreachable: ["ROUTE OR DNS UNAVAILABLE · check private network", "路由或 DNS 不可达 · 检查私网连接", "RUTA O DNS · revisa la pRed privada", "ROUTE ODER DNS · privates Netz prüfen", "ROUTE OU DNS · vérifier le réseau privé", "経路または DNS 不通 · プライベート網を確認", "경로 또는 DNS 오류 · 사설망 확인"],
    errCommand: ["REMOTE COMMAND FAILED · check the server status command", "远端命令失败 · 检查状态采集命令", "FALLO DEL COMANDO · revisa el colector", "FERNER BEFEHL FEHLERHAFT · Statusbefehl prüfen", "ÉCHEC DE COMMANDE · vérifier le collecteur", "リモートコマンド失敗 · 状態コマンドを確認", "원격 명령 실패 · 상태 명령 확인"],
    errFormat: ["INVALID RESPONSE · check the server collector version", "响应格式无效 · 检查服务器采集器版本", "RESPUESTA NO VÁLIDA · revisa el colector", "UNGÜLTIGE ANTWORT · Collector-Version prüfen", "RÉPONSE INVALIDE · vérifier le collecteur", "応答形式エラー · 収集器の版を確認", "응답 형식 오류 · 수집기 버전 확인"],
    dataAge: ["DATA AGE", "数据时效", "ANTIGÜEDAD", "DATENALTER", "ÂGE DES DONNÉES", "データ経過", "데이터 경과"],
    ramAvailable: ["RAM AVAILABLE", "可用内存", "RAM DISPONIBLE", "FREIER RAM", "RAM DISPONIBLE", "空きメモリ", "사용 가능 메모리"],
    stateChanges: ["LOCAL STATE CHANGES", "本地状态变化", "CAMBIOS LOCALES", "LOKALE ÄNDERUNGEN", "CHANGEMENTS LOCAUX", "ローカル状態の変化", "로컬 상태 변경"],
    logsNotRead: ["Each entry shows the server status transition and its detected cause. System logs are not collected.", "每条记录会说明状态如何变化及检测到的原因；不会收集系统日志。", "Cada entrada muestra el cambio de estado y su causa. No se leen registros del sistema.", "Jeder Eintrag zeigt Statuswechsel und erkannte Ursache. Systemprotokolle werden nicht gelesen.", "Chaque entrée indique le changement d’état et sa cause détectée. Aucun journal système n’est collecté.", "状態の変化と検出理由を表示します。システムログは取得しません。", "각 항목에 상태 변경과 감지된 원인을 표시합니다. 시스템 로그는 수집하지 않습니다."],
    interfaceName: ["Interface", "网卡", "Interfaz", "Schnittstelle", "Interface", "インターフェース", "인터페이스"],
    externalOn: ["CONNECTED", "已连接", "CONECTADA", "VERBUNDEN", "BRANCHÉE", "接続中", "연결됨"],
    externalOff: ["DISCONNECTED", "未连接", "DESCONECTADA", "GETRENNT", "DÉBRANCHÉE", "未接続", "연결 끊김"],
    connectedShort: ["AC ON", "外接", "CARGA", "NETZ", "SECTEUR", "外部", "외부 전원"],
    disconnectedShort: ["ON BATTERY", "电池", "BATERÍA", "AKKU", "BATTERIE", "バッテリー", "배터리"],
    okShort: ["ONLINE", "在线", "EN LÍNEA", "ONLINE", "EN LIGNE", "稼働", "온라인"],
    alertShort: ["ALERT", "警报", "ALERTA", "ALARM", "ALERTE", "警告", "경고"],
    offlineShort: ["OFFLINE", "离线", "SIN RED", "OFFLINE", "HORS LIGNE", "オフライン", "오프라인"],
    staleShort: ["STALE", "过期", "ATRASADO", "VERALTET", "PÉRIMÉ", "古い", "오래됨"],
    setupShort: ["SETUP", "设置", "CONFIG.", "SETUP", "CONFIG.", "設定", "설정"],
    unknownShort: ["UNKNOWN", "未知", "DESCONOCIDO", "UNBEKANNT", "INCONNU", "不明", "알 수 없음"],
    tileSetup: ["SET", "设置", "CONFIG.", "SETUP", "CONFIG.", "設定", "설정"],
    tileOffline: ["OFF", "离线", "SIN RED", "OFF", "HORS L.", "圏外", "오프라인"],
    tileStale: ["OLD", "过期", "ANTIG.", "ALT", "PÉRIMÉ", "古い", "오래됨"],
    tileUnknown: ["UNK", "未知", "DESC.", "UNBEK.", "INCON.", "不明", "미상"],
    tileAttention: ["ALERT", "警报", "AVISO", "ALARM", "ALERTE", "警戒", "경고"],
    tileRunning: ["ONLINE", "在线", "EN LÍNEA", "ONLINE", "EN LIGNE", "稼働", "온라인"],
    statusActive: ["active", "运行中", "activo", "aktiv", "actif", "稼働中", "실행 중"],
    statusInactive: ["inactive", "已停止", "inactivo", "inaktiv", "inactif", "停止", "중지됨"],
    statusFailed: ["failed", "失败", "fallido", "fehlgeschlagen", "en échec", "失敗", "실패"],
    statusCharging: ["charging", "充电中", "cargando", "lädt", "en charge", "充電中", "충전 중"],
    statusDischarging: ["discharging", "使用电池", "descargando", "entlädt", "sur batterie", "放電中", "방전 중"],
    statusFull: ["full", "已充满", "completa", "voll", "pleine", "満充電", "완충"],
    statusNotCharging: ["not charging", "未充电", "no carga", "lädt nicht", "ne charge pas", "充電していません", "충전 안 함"],
    serviceUnknown: ["CHECK UNAVAILABLE", "无法检查", "NO DISPONIBLE", "NICHT VERFÜGBAR", "INDISPONIBLE", "確認不可", "확인 불가"],
    serviceUnknownHelp: ["An unknown reading is not counted as a failure.", "未知状态不会直接判定为故障。", "Un estado desconocido no cuenta como fallo.", "Ein unbekannter Status gilt nicht als Fehler.", "不明状態は障害として数えません。", "不明な状態を障害とは判定しません。", "알 수 없는 상태는 실패로 계산하지 않습니다."],
    rxTx: ["RX / TX", "接收 / 发送", "RX / TX", "RX / TX", "RX / TX", "受信 / 送信", "수신 / 송신"],
    diskFree: ["FREE", "可用", "LIBRE", "FREI", "LIBRE", "空き", "여유"],
    privateNetwork: ["PRIVATE NETWORK", "私网", "RED PRIVADA", "PRIVATES NETZ", "RÉSEAU PRIVÉ", "プライベートネットワーク", "사설 네트워크"],
    privateShort: ["PRIVATE", "私网", "PRIVADA", "PRIVAT", "PRIVÉ", "私網", "사설망"],
    polling: ["SAMPLE: 20 s", "采样：20 秒", "MUESTRA: 20 s", "ABTASTUNG: 20 s", "ÉCHANTILLON : 20 s", "採取: 20 秒", "샘플: 20초"],
    unknownLink: ["UNKNOWN", "未知", "DESCONOCIDO", "UNBEKANNT", "INCONNU", "不明", "알 수 없음"]
  }

  let configured = targetOk
  let schemaOk = pulse.schema == 1 && pulse.checked_at != null && pulse.checked_at > 0
      && pulse.checked_at <= now + 60
  let snapshot = schemaOk ? pulse : lastSnapshot
  let hasSnapshot = snapshot.schema == 1 && snapshot.checked_at != null
  let checkedAt = num(snapshot.checked_at, 0)
  let ageSeconds = checkedAt <= 0 ? null : max(0, now - checkedAt)
  let fresh = schemaOk && ageSeconds <= 180
  // Keep counter pairs stable between polls; the one-second UI clock must not replace them.
  when schemaOk && lastSnapshot == null { lastSnapshot = pulse; snapshotReceivedAt = now }
  on pulse.checked_at {
    trafficSamples = pulse.schema == 1 && lastSnapshot.schema == 1 && pulse.checked_at > lastSnapshot.checked_at && pulse.network.rx_bytes != null && pulse.network.tx_bytes != null && lastSnapshot.network.rx_bytes != null && lastSnapshot.network.tx_bytes != null && pulse.network.rx_bytes >= lastSnapshot.network.rx_bytes && pulse.network.tx_bytes >= lastSnapshot.network.tx_bytes
        ? ([((pulse.network.rx_bytes - lastSnapshot.network.rx_bytes) + (pulse.network.tx_bytes - lastSnapshot.network.tx_bytes)) * 8 / (pulse.checked_at - lastSnapshot.checked_at) / 1000000] + trafficSamples).take(5) : []
    previousSnapshot = pulse.schema == 1 ? lastSnapshot : previousSnapshot
    lastSnapshot = pulse.schema == 1 ? pulse : lastSnapshot
    snapshotReceivedAt = pulse.schema == 1 ? now : snapshotReceivedAt
  }
  let checking = checkStartedAt > 0 && now - checkStartedAt < 16
      && (checkedAt <= 0 || checkedAt < checkStartedAt)
  let cpu = num(snapshot.cpu_percent, -1)
  let memUsed = num(snapshot.memory.used_percent, -1)
  let diskUsed = num(snapshot.root_disk.used_percent, -1)
  let coreKnown = cpu >= 0 && cpu <= 100 && memUsed >= 0 && memUsed <= 100
      && diskUsed >= 0 && diskUsed <= 100
  let serviceList = (snapshot.services ?? []).filter(item => item.name != null
      && len(str(item.name)) <= 48 && indexOf(["active", "inactive", "failed", "unknown"], item.status) >= 0
      && indexOf(["active", "inactive"], item.expected) >= 0).take(8)
  let serviceAlert = any(serviceList, item => item.status != "unknown" && item.status != item.expected)
  let trafficLimitMbps = clamp(num(trafficLimit, 150), 1, 100000)
  let previousCheckedAt = previousSnapshot.checked_at
  let previousRxCounter = previousSnapshot.network.rx_bytes
  let previousTxCounter = previousSnapshot.network.tx_bytes
  let sampleSeconds = schemaOk && previousCheckedAt != null ? checkedAt - num(previousCheckedAt, 0) : 0
  let rxCounter = schemaOk ? num(snapshot.network.rx_bytes, -1) : -1
  let txCounter = schemaOk ? num(snapshot.network.tx_bytes, -1) : -1
  let rxPrevious = num(previousRxCounter, -1)
  let txPrevious = num(previousTxCounter, -1)
  let rxMbps = sampleSeconds > 0 && rxCounter >= rxPrevious && rxPrevious >= 0
      ? (rxCounter - rxPrevious) * 8 / sampleSeconds / 1000000 : 0
  let txMbps = sampleSeconds > 0 && txCounter >= txPrevious && txPrevious >= 0
      ? (txCounter - txPrevious) * 8 / sampleSeconds / 1000000 : 0
  // Movement represents the last measured interval, never individual packets.
  let rxReady = fresh && sampleSeconds > 0 && rxPrevious >= 0 && rxCounter >= rxPrevious
  let txReady = fresh && sampleSeconds > 0 && txPrevious >= 0 && txCounter >= txPrevious
  let sampleFlash = fresh && snapshotReceivedAt > 0 && now - snapshotReceivedAt >= 0 && now - snapshotReceivedAt < 3
  let rxRateText = !rxReady ? "--" : rxMbps < 1 ? fmtBytes(rxMbps * 125000) + "/s" : fixed(rxMbps, 2) + " Mb/s"
  let txRateText = !txReady ? "--" : txMbps < 1 ? fmtBytes(txMbps * 125000) + "/s" : fixed(txMbps, 2) + " Mb/s"
  let sustainedTraffic = len(trafficSamples) == 5 && all(trafficSamples, value => value > trafficLimitMbps)
  let alert = fresh && ((cpu >= 0 && cpu > 90) || (memUsed >= 0 && memUsed > 90)
      || (diskUsed >= 0 && diskUsed > 90) || serviceAlert || sustainedTraffic)
  let health = !configured ? "setup" : !hasSnapshot ? "offline" : !fresh ? "stale" : alert ? "attention" : !coreKnown ? "unknown" : "running"
  let healthText = health == "setup" ? strings.setup[languageIndex]
      : health == "offline" ? strings.noSignal[languageIndex]
      : health == "stale" ? (pulse.error != null ? strings.offlineDesc[languageIndex] : strings.stale[languageIndex])
      : health == "unknown" ? strings.unknown[languageIndex]
      : health == "attention" ? strings.attention[languageIndex] : strings.running[languageIndex]
  let healthColor = health == "attention" || health == "offline" ? pRed
      : health == "running" ? pGreen : pMuted
  let firstAlertText = sustainedTraffic ? strings.trafficAlert[languageIndex]
      : serviceAlert ? strings.services[languageIndex]
      : cpu > 90 ? strings.cpuAlert[languageIndex]
      : memUsed > 90 ? strings.memoryAlert[languageIndex]
      : diskUsed > 90 ? strings.diskAlert[languageIndex] : strings.attention[languageIndex]
  let eventReason = health == "attention" ? sustainedTraffic ? "traffic" : serviceAlert ? "services" : cpu > 90 ? "cpu" : memUsed > 90 ? "memory" : diskUsed > 90 ? "disk" : "attention"
      : health == "offline" ? (pulse.error ?? "no_signal")
      : health == "stale" ? (pulse.error != null ? "stale_connection" : "stale_data")
      : health == "unknown" ? "partial"
      : health == "setup" ? "setup" : "online"
  let tileDescription = health == "setup" ? strings.noConnection[languageIndex]
      : health == "offline" ? strings.noSignal[languageIndex]
      : health == "stale" ? strings.stale[languageIndex]
      : health == "attention" ? firstAlertText
      : health == "unknown" ? strings.partialDesc[languageIndex] : strings.onlineDesc[languageIndex]
  let failureText = pulse.error == null ? strings.noSignal[languageIndex]
      : pulse.error == "auth" ? strings.errAuth[languageIndex]
      : pulse.error == "host_key" ? strings.errHostKey[languageIndex]
      : pulse.error == "timeout" ? strings.errTimeout[languageIndex]
      : pulse.error == "refused" ? strings.errRefused[languageIndex]
      : pulse.error == "remote_command" ? strings.errCommand[languageIndex]
      : pulse.error == "format" ? strings.errFormat[languageIndex]
      : strings.errUnreachable[languageIndex]
  on health {
    events = ([{ "at": now, "from": len(events) > 0 ? events[0].state : null, "state": value, "reason": eventReason }] + events).take(12)
    eventAt = now
  }

  component PowerBolt(state) {
    Canvas {
      let tint = state == "on" ? pGreen : state == "off" ? pMuted : pMuted
      let points = [[width * 0.61, height * 0.04], [width * 0.29, height * 0.53], [width * 0.48, height * 0.53], [width * 0.39, height * 0.96], [width * 0.73, height * 0.40], [width * 0.54, height * 0.40]]
      path(points, closed: true, fill: tint)
    }
  }

  component StatusLine(label, value, tint = pInk) {
    Column {
      fill: width
      gap: 5
      height: 62
      Text { text: label; font: mono; fontSize: 10; color: pMuted; maxLines: 2 }
      Text { text: value; font: mono; fontSize: 15; color: value == "--" || value == strings.unknown[languageIndex] || value == strings.unknownLink[languageIndex] ? pMuted : tint; maxLines: 2 }
    }
  }

  component Meter(label, value, pct, tint = pBlue) {
    Column {
      fill: width
      gap: 7
      padding: [0, 6]
      Row {
        gap: 6
        Text { text: label; font: mono; fontSize: 12; color: pMuted; weight: 1; maxLines: 2 }
        Text { text: value; font: mono; fontSize: 16; color: tint; width: 62; align: end; maxLines: 1 }
      }
      Progress { value: pct; max: 100; color: tint; track: alpha(tint, 0.12); height: 3; fill: width }
    }
  }

  component TileMetric(label, value, pct, numberSize = 22) {
    Column {
      fill: width
      gap: 2
      Text { text: label; font: mono; fontSize: 9; color: pMuted; maxLines: 1 }
      Text { text: value; font: mono; fontSize: len(str(value)) >= 4 ? min(numberSize, 18) : numberSize; color: !fresh || pct < 0 ? pMuted : pct > 90 ? pRed : pGreen; maxLines: 1 }
      Progress { value: max(0, pct); animate value: tween(motionEnabled ? 650ms : 0ms, "out"); color: !fresh ? pMuted : pct > 90 ? pRed : pGreen; track: alpha(pAccent, 0.14); height: 2; fill: width }
    }
  }

  component NavTab(label, tab) {
    Column {
      fill: width
      height: 40
      gap: 0
      radius: 5 * corners
      background: section == tab ? alpha(pAccent, 0.14) : mix(background, surface, 0.5)
      onTap: section = tab
      Box {
        fill: width
        weight: 1
        align: center
        padding: [5, 3]
        Text { text: label; font: mono; fontSize: 11; color: section == tab ? pAccent : pMuted; align: center; maxLines: 2 }
      }
      Canvas { fill: width; height: 2; rect(0, 0, width, 2, fill: section == tab ? pAccent : alpha(pBorder, 0.25)) }
    }
  }

  // Three rack bays show actual CPU / RAM / disk utilization.
  // Directional lights encode interval-average throughput, not packet counts.
  component ServerActivity(compact = false) {
    Canvas {
      fill: width
      height: compact ? 18 : 98
      let rackWidth = compact ? 19 : width * 0.40
      let bayHeight = compact ? 4 : 22
      let bayGap = compact ? 2 : 7
      let top = compact ? 1 : 8
      let metrics = [cpu, memUsed, diskUsed]
      let rackTint = fresh ? pAccent : pMuted
      for i in range(3) {
        let y = top + i * (bayHeight + bayGap)
        let utilization = metrics[i]
        let tint = !fresh || utilization < 0 ? pMuted : utilization > 90 ? pRed : pAccent
        rect(0.5, y, rackWidth - 1, bayHeight, radius: compact ? 0 : 3 * corners, stroke: alpha(rackTint, 0.45), width: 0.7)
        circle(compact ? 3 : 7, y + bayHeight / 2, compact ? 0.8 : 1.6, fill: fresh && utilization >= 0 ? tint : alpha(pMuted, 0.3))
        if compact {
          rect(6, y + 1, (rackWidth - 9) * clamp(utilization, 0, 100) / 100, 2, fill: tint)
        } else {
          text(["CPU", "RAM", "DISK"][i], 14, y + bayHeight / 2, size: 8, color: pMuted)
          let segmentWidth = max(1, (rackWidth - 54) / 10)
          for j in range(10) {
            rect(43 + j * segmentWidth, y + 8, max(1, segmentWidth - 2), 6, fill: fresh && utilization > j * 10 ? tint : alpha(pMuted, 0.12))
          }
        }
      }
      let left = rackWidth + (compact ? 20 : 30)
      let right = width - 4
      let span = max(1, right - left)
      for direction in range(2) {
        let y = compact ? 5 + direction * 9 : 29 + direction * 44
        let rate = direction == 0 ? rxMbps : txMbps
        let ready = direction == 0 ? rxReady : txReady
        let tint = direction == 0 ? pBlue : pAccent
        text(direction == 0 ? "RX" : "TX", rackWidth + (compact ? 4 : 9), y, size: compact ? 6 : 8, color: pMuted)
        line(left, y, right, y, stroke: alpha(pMuted, 0.22), width: 1)
        let tip = direction == 0 ? left : right
        let back = direction == 0 ? left + 3 : right - 3
        path([[back, y - 2], [tip, y], [back, y + 2]], stroke: ready ? tint : pMuted, width: 1)
        if ready && rate > 0 {
          // Static fill remains meaningful when motion is disabled.
          line(left, y, left + span * clamp(rate / trafficLimitMbps, 0, 1), y, stroke: alpha(tint, 0.45), width: 2)
          if motionEnabled {
            let phase = (time * clamp(sqrt(rate) * 0.12, 0.12, 1.8)) % 1
            let x = direction == 0 ? right - phase * span : left + phase * span
            circle(x, y, compact ? 1.3 : 2.4, fill: tint)
          }
        }
        if !compact {
          text(direction == 0 ? rxRateText : txRateText, left, y - 11, size: 10, color: ready ? tint : pMuted)
        }
      }
      if motionEnabled && sampleFlash {
        let glow = 0.35 + 0.35 * (0.5 + 0.5 * sin(time * 240))
        let bottom = top + 3 * bayHeight + 2 * bayGap
        line(0.5, top, rackWidth - 0.5, top, stroke: alpha(pAccent, glow), width: 1.2)
        line(0.5, bottom, rackWidth - 0.5, bottom, stroke: alpha(pAccent, glow), width: 1.2)
        line(0.5, top, 0.5, bottom, stroke: alpha(pAccent, glow), width: 1.2)
        line(rackWidth - 0.5, top, rackWidth - 0.5, bottom, stroke: alpha(pAccent, glow), width: 1.2)
      }
    }
  }

  component SampleLight {
    Canvas {
      width: 8
      height: 10
      circle(4, 5, 2, fill: healthColor)
      if motionEnabled && sampleFlash {
        circle(4, 5, 3.5, stroke: alpha(pAccent, 0.4 + 0.3 * sin(time * 240)), width: 1)
      }
    }
  }

  component LiveReadout(label, value, tint) {
    Column {
      fill: width
      gap: 4
      padding: 10
      Text { text: label; font: mono; fontSize: 10; color: pMuted; maxLines: 1 }
      Text { text: value; font: mono; fontSize: 14; color: tint; maxLines: 1 }
    }
  }

  component MetricCard(label, value, detail = "", tint = pInk, pct = -1) {
    Column {
      fill: width
      height: 108
      gap: 5
      padding: 10
      background: mix(background, surface, 0.72)
      border: 1
      borderColor: alpha(pBorder, 0.4)
      radius: 6 * corners
      Text { text: label; font: mono; fontSize: 11; color: pMuted; height: 28; maxLines: 2 }
      Text { text: value; font: mono; fontSize: len(str(value)) > 10 ? 14 : len(str(value)) > 5 ? 18 : 26; color: value == "--" || value == strings.unknown[languageIndex] || value == strings.unknownLink[languageIndex] ? pMuted : tint; maxLines: 1 }
      if detail != "" { Text { text: detail; font: mono; fontSize: 10; color: pMuted; maxLines: 2 } }
      Spacer { weight: 1 }
      if pct >= 0 { Progress { value: pct; max: 100; color: tint; track: alpha(tint, 0.12); height: 3; fill: width } }
    }
  }

  component EventRecord(item) {
    let stateText = item.state == "attention" ? strings.attention[languageIndex] : item.state == "running" ? strings.running[languageIndex] : item.state == "offline" ? strings.noSignal[languageIndex] : item.state == "stale" ? strings.stale[languageIndex] : item.state == "setup" ? strings.setup[languageIndex] : strings.unknown[languageIndex]
    let fromText = item.from == "attention" ? strings.attention[languageIndex] : item.from == "running" ? strings.running[languageIndex] : item.from == "offline" ? strings.noSignal[languageIndex] : item.from == "stale" ? strings.stale[languageIndex] : item.from == "setup" ? strings.setup[languageIndex] : strings.unknown[languageIndex]
    let tint = item.state == "running" ? pGreen : item.state == "attention" || item.state == "offline" ? pRed : pMuted
    let detail = item.reason == "traffic" ? strings.trafficAlert[languageIndex]
        : item.reason == "services" ? strings.serviceMismatch[languageIndex]
        : item.reason == "cpu" ? strings.cpuAlert[languageIndex]
        : item.reason == "memory" ? strings.memoryAlert[languageIndex]
        : item.reason == "disk" ? strings.diskAlert[languageIndex]
        : item.reason == "auth" ? strings.errAuth[languageIndex]
        : item.reason == "host_key" ? strings.errHostKey[languageIndex]
        : item.reason == "timeout" ? strings.errTimeout[languageIndex]
        : item.reason == "refused" ? strings.errRefused[languageIndex]
        : item.reason == "remote_command" ? strings.errCommand[languageIndex]
        : item.reason == "format" ? strings.errFormat[languageIndex]
        : item.reason == "unreachable" ? strings.errUnreachable[languageIndex]
        : item.reason == "stale_connection" ? strings.staleConnectionReason[languageIndex]
        : item.reason == "stale_data" ? strings.staleDataReason[languageIndex]
        : item.reason == "partial" ? strings.partialDesc[languageIndex]
        : item.reason == "setup" ? strings.noConnection[languageIndex]
        : item.reason == "online" ? strings.onlineDesc[languageIndex]
        : item.state == "offline" ? strings.noSignal[languageIndex]
        : item.state == "stale" ? strings.staleDataReason[languageIndex]
        : item.state == "attention" ? strings.attention[languageIndex]
        : item.state == "running" ? strings.onlineDesc[languageIndex]
        : item.state == "setup" ? strings.noConnection[languageIndex] : strings.partialDesc[languageIndex]
    Row {
      gap: 8
      padding: 10
      background: pPanel
      border: 1
      borderColor: pBorder
      Canvas { width: 3; height: 62; let color = item.state == "running" ? pGreen : item.state == "attention" || item.state == "offline" ? pRed : pMuted; rect(0, 0, 3, 62, fill: color) }
      Column {
        fill: width
        gap: 2
        Text { text: fmtTime(item.at, "yyyy-MM-dd HH:mm:ss"); font: mono; style: small; color: pMuted; maxLines: 1 }
        Text { text: item.from == null ? strings.initialStatus[languageIndex] : item.from == item.state ? strings.statusDetected[languageIndex] : strings.statusChanged[languageIndex]; font: mono; style: small; color: pMuted; maxLines: 1 }
        Text { text: item.from == null || item.from == item.state ? stateText : fromText + " → " + stateText; font: mono; style: label; color: tint; maxLines: 1 }
        Text { text: detail; style: small; color: pMuted; maxLines: 2 }
      }
    }
  }

  component LiveTelemetry {
    Column {
      fill: width
      gap: 0
      background: mix(background, surface, 0.45)
      border: 1
      borderColor: alpha(pBorder, 0.4)
      radius: 6 * corners
      padding: [12, 10]
      Row {
        Text { text: strings.network[languageIndex] + " · RX + TX"; font: mono; fontSize: 11; color: pMuted; weight: 1; maxLines: 1 }
        Text { text: snapshot.network.interface ?? "--"; font: mono; fontSize: 10; color: pMuted; width: 70; align: end; maxLines: 1 }
      }
      Text { text: strings.polling[languageIndex]; font: mono; fontSize: 9; color: pMuted; maxLines: 1 }
      ServerActivity { }
      Grid {
        columns: 3
        gap: 1
        LiveReadout { label: "RX"; value: rxRateText; tint: fresh ? pBlue : pMuted }
        LiveReadout { label: "TX"; value: txRateText; tint: fresh ? pGreen : pMuted }
        LiveReadout { label: "RTT"; value: snapshot.rtt_ms == null ? "--" : "${round(snapshot.rtt_ms)} ms"; tint: fresh ? pGreen : pMuted }
      }
    }
  }

  onTap: screen()

  let tileCols = cols ?? 4
  let tileRows = rows ?? 4
  let tileName = trim(displayName) == "" ? "SERVER" : upper(sub(trim(displayName), 0, tileCols <= 2 ? 6 : tileCols == 3 ? 12 : 18))
  let tileStatus = health == "setup" ? strings.tileSetup[languageIndex]
      : health == "offline" ? strings.tileOffline[languageIndex]
      : health == "stale" ? strings.tileStale[languageIndex]
      : health == "unknown" ? strings.tileUnknown[languageIndex]
      : health == "attention" ? strings.tileAttention[languageIndex] : strings.tileRunning[languageIndex]
  let cpuText = cpu < 0 ? "--" : "${round(cpu)}%"
  let memText = memUsed < 0 ? "--" : "${round(memUsed)}%"
  let diskText = diskUsed < 0 ? "--" : "${round(diskUsed)}%"
  let batteryText = snapshot.power.battery_percent == null ? "--%" : "${round(snapshot.power.battery_percent)}%"
  let shortMemory = ["MEM", "内存", "MEM", "RAM", "RAM", "メモリ", "메모리"][languageIndex]
  let shortDisk = ["DISK", "磁盘", "DISCO", "DISK", "DISQUE", "ディスク", "디스크"][languageIndex]
  let shortBattery = ["BATT", "电池", "BAT", "AKKU", "BAT", "電池", "배터리"][languageIndex]
  let powerState = !fresh || snapshot.power.external_power == null ? "unknown" : snapshot.power.external_power ? "on" : "off"
  Column {
    gap: tileCols <= 2 ? 6 : 8
    fill: true
    background: tileSurface
    Row {
      gap: 4
      align: center
      Text { text: tileName; font: mono; fontSize: tileCols <= 2 ? 9 : 12; color: pInk; weight: 1; maxLines: 1 }
      SampleLight { }
      Text { text: tileStatus; font: mono; fontSize: tileCols <= 2 ? 8 : 10; color: healthColor; width: tileCols <= 2 ? 42 : 84; align: end; maxLines: 1 }
    }
    if tileCols <= 2 && tileRows <= 2 {
      if health == "setup" || health == "offline" || health == "attention" || health == "stale" {
        Text { text: tileDescription; font: mono; fontSize: 9; color: healthColor; maxLines: 2 }
      }
      Row {
        gap: 10
        TileMetric { label: "CPU"; value: cpuText; pct: cpu; numberSize: 24; weight: 1 }
        TileMetric { label: shortMemory; value: memText; pct: memUsed; numberSize: 24; weight: 1 }
      }
      ServerActivity { compact: true; weight: 1 }
      Row {
        gap: 8
        align: center
        Text { text: shortDisk + " " + diskText; font: mono; fontSize: 9; color: fresh && diskUsed >= 0 ? pInk : pMuted; weight: 1; maxLines: 1 }
        Text { text: shortBattery + " " + batteryText; font: mono; fontSize: 9; color: fresh && snapshot.power.battery_percent != null ? pInk : pMuted; weight: 1; align: end; maxLines: 1 }
        PowerBolt { state: powerState; width: 8; height: 12 }
      }
    } else if tileCols >= 3 && tileRows <= 2 {
      Row {
        gap: 12
        TileMetric { label: "CPU"; value: cpuText; pct: cpu; numberSize: 20; weight: 1 }
        TileMetric { label: shortMemory; value: memText; pct: memUsed; numberSize: 20; weight: 1 }
        Column { weight: 1; gap: 3; Text { text: "RX · Mb/s"; font: mono; fontSize: 8; color: pMuted; maxLines: 1 }; Text { text: rxReady ? fixed(rxMbps, 2) : "--"; font: mono; fontSize: 20; color: fresh ? pGreen : pMuted; maxLines: 1 } }
      }
    } else if tileCols <= 2 {
      Text { text: tileDescription; font: mono; fontSize: 10; color: healthColor; maxLines: 2 }
      TileMetric { label: "CPU"; value: cpuText; pct: cpu; weight: 1 }
      TileMetric { label: shortMemory; value: memText; pct: memUsed; weight: 1 }
      Row { gap: 4; align: center; PowerBolt { state: powerState; width: 16; height: 20 }; Text { text: strings.battery[languageIndex]; font: mono; fontSize: 9; color: pMuted; weight: 1; maxLines: 1 }; Text { text: batteryText; font: mono; fontSize: 14; color: fresh ? pGreen : pMuted; width: 46; align: end; maxLines: 1 } }
    } else {
      Text { text: tileDescription; font: mono; fontSize: 11; color: healthColor; maxLines: 2 }
      Row {
        gap: 12
        TileMetric { label: strings.cpu[languageIndex]; value: cpuText; pct: cpu; numberSize: tileCols >= 4 ? 28 : 24; weight: 1 }
        TileMetric { label: strings.memory[languageIndex]; value: memText; pct: memUsed; numberSize: tileCols >= 4 ? 28 : 24; weight: 1 }
      }
      Row { gap: 8; Text { text: shortDisk + " " + diskText; font: mono; fontSize: 10; color: fresh ? pInk : pMuted; weight: 1; maxLines: 1 }; PowerBolt { state: powerState; width: 16; height: 18 }; Text { text: batteryText; font: mono; fontSize: 12; color: fresh ? pGreen : pMuted; width: 42; align: end; maxLines: 1 } }
      Row { gap: 8; Text { text: "RX " + (rxReady ? fixed(rxMbps, 2) : "--"); font: mono; fontSize: 10; color: pBlue; weight: 1; maxLines: 1 }; Text { text: "TX " + (txReady ? fixed(txMbps, 2) : "--") + " Mb/s"; font: mono; fontSize: 10; color: pGreen; width: 106; align: end; maxLines: 1 } }
      if tileRows >= 4 {
        ServerActivity { compact: true }
        Row { Text { text: strings.uptime[languageIndex]; font: mono; fontSize: 9; color: pMuted; weight: 1; maxLines: 1 }; Text { text: snapshot.uptime_seconds == null ? "--" : fmtDuration(snapshot.uptime_seconds); font: mono; fontSize: 11; color: fresh ? pGreen : pMuted; width: 100; align: end; maxLines: 1 } }
        Text { text: strings.checked[languageIndex] + "  " + (snapshot.checked_at == null ? "--" : fmtTime(snapshot.checked_at, "HH:mm:ss")); font: mono; fontSize: 9; color: pMuted; maxLines: 1 }
      }
    }
  }

  screen {
    title: trim(displayName) == "" ? "SERVER" : upper(sub(trim(displayName), 0, 24))
    Column {
      gap: 12
      padding: 14
      background: background
      scroll: true
      fill: true
      Row {
        align: center
        Text { text: section == "events" ? strings.eventsTitle[languageIndex] : get(strings, section)[languageIndex]; font: mono; fontSize: 22; color: pInk; weight: 1; maxLines: 1 }
        Column { width: 102; padding: [8, 10]; radius: 5 * corners; background: alpha(pAccent, 0.08); onTap: section = "connection"; Text { text: strings.connection[languageIndex]; font: mono; fontSize: 11; color: section == "connection" ? pAccent : pMuted; align: center; maxLines: 2 } }
      }
      Row {
        align: center
        Text { text: healthText; font: mono; fontSize: 15; color: healthColor; weight: 1; maxLines: 2 }
        Column { width: 102; padding: [8, 10]; radius: 5 * corners; background: alpha(pAccent, 0.12); onTap: { checkStartedAt = now; refresh() }; Text { text: checking ? strings.checking[languageIndex] : strings.refresh[languageIndex]; font: mono; fontSize: 11; color: pAccent; align: center; maxLines: 2 } }
      }
      Text { text: strings.checked[languageIndex] + "  " + (snapshot.checked_at == null ? "--" : fmtTime(snapshot.checked_at, "HH:mm:ss")) + "   /   " + strings.dataAge[languageIndex] + " " + (ageSeconds == null ? "--" : fmtDuration(ageSeconds)); font: mono; fontSize: 10; color: fresh ? pMuted : healthColor; maxLines: 2 }
      if configured && !schemaOk {
        Text { text: failureText; font: mono; fontSize: 11; color: pRed; maxLines: 3 }
      }
      Grid {
        columns: 3
        gap: 3
        NavTab { label: strings.overview[languageIndex]; tab: "overview" }
        NavTab { label: strings.network[languageIndex]; tab: "network" }
        NavTab { label: strings.power[languageIndex]; tab: "power" }
        NavTab { label: strings.resources[languageIndex]; tab: "resources" }
        NavTab { label: strings.services[languageIndex]; tab: "services" }
        NavTab { label: strings.eventsTitle[languageIndex]; tab: "events" }
      }

      if section == "overview" {
        Grid { columns: (screenWidth ?? 400) < 340 ? 1 : 3; gap: 8
          MetricCard { label: strings.uptime[languageIndex]; value: snapshot.uptime_seconds == null ? "--" : fmtDuration(snapshot.uptime_seconds); tint: !fresh || snapshot.uptime_seconds == null ? pMuted : pGreen; weight: 1 }
          MetricCard { label: strings.cpu[languageIndex]; value: cpu < 0 ? "--" : "${round(cpu)}%"; tint: !fresh ? pMuted : cpu > 90 ? pRed : pGreen; weight: 1 }
          MetricCard { label: strings.memory[languageIndex]; value: memUsed < 0 ? "--" : "${round(memUsed)}%"; detail: snapshot.memory.total_bytes == null || snapshot.memory.available_bytes == null ? "" : fmtBytes(snapshot.memory.total_bytes - snapshot.memory.available_bytes) + " / " + fmtBytes(snapshot.memory.total_bytes); tint: !fresh ? pMuted : memUsed > 90 ? pRed : pGreen; weight: 1 }
        }
        LiveTelemetry { }
        Grid { columns: 2; gap: 6
          StatusLine { label: strings.interface[languageIndex]; value: snapshot.network.interface ?? strings.unknownLink[languageIndex]; tint: fresh ? pGreen : pMuted; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.services[languageIndex]; value: len(serviceList) == 0 ? "--" : str(count(serviceList.filter(item => item.healthy))) + " / " + str(len(serviceList)); tint: !fresh ? pMuted : serviceAlert ? pRed : pGreen; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.external[languageIndex]; value: snapshot.power.external_power == null ? strings.unknown[languageIndex] : snapshot.power.external_power ? strings.externalOn[languageIndex] : strings.externalOff[languageIndex]; tint: !fresh ? pMuted : snapshot.power.external_power ? pGreen : pMuted; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.battery[languageIndex]; value: snapshot.power.battery_percent == null ? "--" : "${round(snapshot.power.battery_percent)}%"; tint: fresh ? pGreen : pMuted; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.disk[languageIndex]; value: diskUsed < 0 ? "--" : "${round(diskUsed)}%"; tint: fresh ? pGreen : pMuted; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.temperature[languageIndex]; value: snapshot.temperature_c == null ? "--" : "${snapshot.temperature_c} °C"; tint: fresh ? pGreen : pMuted; padding: 10; background: mix(background, surface, 0.6) }
        }
        Text { text: strings.dataSource[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 3 }
      }

      if section == "network" {
        Grid { columns: (screenWidth ?? 400) < 340 ? 1 : 3; gap: 8
          MetricCard { label: strings.inbound[languageIndex]; value: rxRateText; tint: pBlue; weight: 1 }
          MetricCard { label: strings.outbound[languageIndex]; value: txRateText; tint: pGreen; weight: 1 }
          MetricCard { label: strings.latency[languageIndex]; value: snapshot.rtt_ms == null ? "--" : "${round(snapshot.rtt_ms)} ms"; weight: 1 }
        }
        LiveTelemetry { }
        Grid { columns: 2; gap: 6
          StatusLine { label: strings.privateNetwork[languageIndex]; value: fresh ? strings.running[languageIndex] : strings.noSignal[languageIndex]; tint: fresh ? pGreen : pRed; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.interface[languageIndex]; value: snapshot.network.interface ?? strings.unknownLink[languageIndex]; tint: fresh ? pInk : pMuted; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.link[languageIndex]; value: snapshot.network.link_mbps == null ? strings.unknownLink[languageIndex] : "${snapshot.network.link_mbps} Mb/s"; tint: !fresh || snapshot.network.link_mbps == null ? pMuted : pGreen; padding: 10; background: mix(background, surface, 0.6) }
          StatusLine { label: strings.threshold[languageIndex]; value: sustainedTraffic ? strings.attention[languageIndex] : strings.running[languageIndex]; tint: sustainedTraffic ? pRed : pGreen; padding: 10; background: mix(background, surface, 0.6) }
        }
        Text { text: strings.thresholdHelp[languageIndex] + " · " + strings.dataSource[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 3 }
      }

      if section == "power" {
        Grid { columns: 2; gap: 8
          MetricCard { label: strings.battery[languageIndex]; value: snapshot.power.battery_percent == null ? "--" : "${round(snapshot.power.battery_percent)}%"; detail: snapshot.power.battery_state == "charging" ? strings.statusCharging[languageIndex] : snapshot.power.battery_state == "discharging" ? strings.statusDischarging[languageIndex] : snapshot.power.battery_state == "full" ? strings.statusFull[languageIndex] : snapshot.power.battery_state == "not charging" ? strings.statusNotCharging[languageIndex] : strings.unknown[languageIndex]; tint: fresh ? pGreen : pMuted; pct: snapshot.power.battery_percent == null ? -1 : snapshot.power.battery_percent }
          MetricCard { label: strings.external[languageIndex]; value: snapshot.power.external_power == null ? strings.unknown[languageIndex] : snapshot.power.external_power ? strings.externalOn[languageIndex] : strings.externalOff[languageIndex]; tint: !fresh ? pMuted : snapshot.power.external_power ? pGreen : pMuted }
          MetricCard { label: strings.chargeRate[languageIndex]; value: snapshot.power.battery_power_w == null ? "--" : "${snapshot.power.battery_power_w} W"; detail: snapshot.power.battery_state == "charging" ? strings.statusCharging[languageIndex] : snapshot.power.battery_state == "discharging" ? strings.statusDischarging[languageIndex] : snapshot.power.battery_state == "full" ? strings.statusFull[languageIndex] : snapshot.power.battery_state == "not charging" ? strings.statusNotCharging[languageIndex] : strings.unknown[languageIndex]; tint: fresh ? pGreen : pMuted }
          MetricCard { label: strings.temperature[languageIndex]; value: snapshot.temperature_c == null ? "--" : "${snapshot.temperature_c} °C"; tint: !fresh ? pMuted : snapshot.temperature_c >= 85 ? pRed : pGreen }
        }
        Text { text: strings.dataSource[languageIndex] + " · " + strings.unknownReason[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 3 }
      }

      if section == "resources" {
        Grid { columns: (screenWidth ?? 400) < 340 ? 1 : 3; gap: 8
          MetricCard { label: strings.cpu[languageIndex]; value: cpu < 0 ? "--" : "${round(cpu)}%"; detail: snapshot.load_1m == null ? "" : "Load ${snapshot.load_1m}"; tint: !fresh ? pMuted : cpu > 90 ? pRed : pGreen }
          MetricCard { label: strings.memory[languageIndex]; value: memUsed < 0 ? "--" : "${round(memUsed)}%"; detail: snapshot.memory.available_bytes == null ? "" : fmtBytes(snapshot.memory.available_bytes) + " " + strings.diskFree[languageIndex]; tint: !fresh ? pMuted : memUsed > 90 ? pRed : pGreen }
          MetricCard { label: strings.disk[languageIndex]; value: diskUsed < 0 ? "--" : "${round(diskUsed)}%"; detail: snapshot.root_disk.free_bytes == null ? "" : fmtBytes(snapshot.root_disk.free_bytes) + " " + strings.diskFree[languageIndex]; tint: !fresh ? pMuted : diskUsed > 90 ? pRed : pGreen }
        }
        Meter { label: strings.cpu[languageIndex]; value: cpu < 0 ? "--" : "${round(cpu)}%"; pct: cpu < 0 ? 0 : cpu; tint: !fresh ? pMuted : cpu > 90 ? pRed : pGreen }
        Meter { label: strings.memory[languageIndex]; value: memUsed < 0 ? "--" : "${round(memUsed)}%"; pct: memUsed < 0 ? 0 : memUsed; tint: !fresh ? pMuted : memUsed > 90 ? pRed : pBlue }
        Meter { label: strings.disk[languageIndex]; value: diskUsed < 0 ? "--" : "${round(diskUsed)}%"; pct: diskUsed < 0 ? 0 : diskUsed; tint: !fresh ? pMuted : diskUsed > 90 ? pRed : pGreen }
        Column { gap: 8; StatusLine { label: strings.uptime[languageIndex]; value: snapshot.uptime_seconds == null ? "--" : fmtDuration(snapshot.uptime_seconds); tint: fresh ? pInk : pMuted }; ServerActivity { } }
        Text { text: strings.dataSource[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 3 }
      }

      if section == "services" {
        Text { text: strings.services[languageIndex]; font: mono; style: label; color: pBlue }
        if len(serviceList) == 0 { Text { text: strings.noServices[languageIndex]; style: title; color: pMuted } }
        for item, i in serviceList key item.name {
          Row {
            padding: 10
            background: pPanel
            border: 1
            borderColor: pBorder
            Column {
              weight: 1
              Text { text: item.name; font: mono; style: label; color: !fresh || item.status == "unknown" ? pMuted : item.healthy ? pGreen : pRed; maxLines: 1 }
              Text { text: strings.state[languageIndex] + ": " + (item.status == "active" ? strings.statusActive[languageIndex] : item.status == "inactive" ? strings.statusInactive[languageIndex] : item.status == "failed" ? strings.statusFailed[languageIndex] : strings.unknown[languageIndex]) + "  /  " + strings.expected[languageIndex] + ": " + (item.expected == "active" ? strings.statusActive[languageIndex] : strings.statusInactive[languageIndex]); style: small; color: pMuted; maxLines: 2 }
            }
            Text { text: item.status == "unknown" ? strings.serviceUnknown[languageIndex] : item.healthy ? strings.running[languageIndex] : strings.attention[languageIndex]; font: mono; style: small; color: !fresh || item.status == "unknown" ? pMuted : item.healthy ? pGreen : pRed; width: 112; align: end; maxLines: 1 }
          }
        }
        Text { text: strings.readOnly[languageIndex] + " · " + strings.serviceUnknownHelp[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 3 }
      }

      if section == "events" {
        Text { text: strings.eventsTitle[languageIndex] + " / " + strings.stateChanges[languageIndex]; font: mono; style: label; color: pBlue }
        if len(events) == 0 {
          Text { text: strings.noEvents[languageIndex]; style: title; color: pMuted }
          Text { text: strings.eventEmptyHelp[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 3 }
        }
        for item in events key item.at { EventRecord { item: item } }
        Text { text: strings.logsNotRead[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 2 }
      }

      if section == "connection" {
        Text { text: strings.connection[languageIndex] + " / SSH"; font: mono; style: label; color: pBlue }
        Text { text: strings.setupIntro[languageIndex]; style: small; color: pMuted; background: alpha(pBlue, 0.08); padding: 10; maxLines: 3 }
        Text { text: strings.displayName[languageIndex]; style: small; color: pMuted }
        Input { text: displayName; placeholder: strings.displayNameHint[languageIndex]; onChange: displayName = value; background: pPanel; borderColor: pBorder }
        Text { text: strings.host[languageIndex]; style: small; color: pMuted }
        Input { text: host; placeholder: "server.tailnet-name.ts.net"; onChange: host = value; background: pPanel; borderColor: pBorder }
        Text { text: strings.lanHost[languageIndex]; style: small; color: pMuted }
        Input { text: lanHost; placeholder: "192.168.1.50"; onChange: lanHost = value; background: pPanel; borderColor: pBorder }
        Text { text: strings.lanHelp[languageIndex]; style: small; color: pMuted; maxLines: 2 }
        Text { text: strings.account[languageIndex]; style: small; color: pMuted }
        Input { text: user; placeholder: "status"; onChange: user = value; background: pPanel; borderColor: pBorder }
        Text { text: strings.port[languageIndex]; style: small; color: pMuted }
        Input { text: port; placeholder: "22"; onChange: port = value; background: pPanel; borderColor: pBorder }
        Text { text: checking ? strings.checking[languageIndex] : !targetOk ? strings.noConnection[languageIndex] : fresh ? strings.freshFor[languageIndex] + " / " + strings.polling[languageIndex] + " / " + (snapshot.connection_route == "lan" ? strings.routeLan[languageIndex] : strings.routeTailscale[languageIndex]) : schemaOk ? strings.stale[languageIndex] : strings.noSignal[languageIndex]; style: small; color: checking ? pBlue : fresh ? pGreen : pRed; maxLines: 2 }
        Text { text: strings.keyPath[languageIndex]; font: mono; style: small; color: pMuted; maxLines: 2 }
        Text { text: strings.keyCheck[languageIndex]; style: small; color: pRed; maxLines: 3 }
        Text { text: strings.tailscale[languageIndex]; style: small; color: pMuted; maxLines: 4 }
        Row { Button { text: strings.refresh[languageIndex]; color: pBlue; background: alpha(pBlue, 0.12); borderColor: pBlue; onTap: { checkStartedAt = now; refresh() } }; Button { text: strings.guide[languageIndex]; color: pBlue; background: pPanel; borderColor: pBorder; onTap: url("https://tailscale.com/download/android") } }
        Text { text: strings.languageTitle[languageIndex]; style: small; color: pMuted }
        Flow {
          Button { text: "English"; color: language == "en" ? pBlue : pMuted; onTap: language = "en" }
          Button { text: "简体中文"; color: language == "zh" ? pBlue : pMuted; onTap: language = "zh" }
          Button { text: "Español"; color: language == "es" ? pBlue : pMuted; onTap: language = "es" }
          Button { text: "Deutsch"; color: language == "de" ? pBlue : pMuted; onTap: language = "de" }
          Button { text: "Français"; color: language == "fr" ? pBlue : pMuted; onTap: language = "fr" }
          Button { text: "日本語"; color: language == "ja" ? pBlue : pMuted; onTap: language = "ja" }
          Button { text: "한국어"; color: language == "ko" ? pBlue : pMuted; onTap: language = "ko" }
        }
        Button { text: strings.motion[languageIndex] + ": " + (motionEnabled ? strings.motionOn[languageIndex] : strings.motionOff[languageIndex]); onTap: motionEnabled = !motionEnabled }
        Text { text: strings.threshold[languageIndex] + " (Mb/s)"; style: small; color: pMuted }
        Input { text: trafficLimit; placeholder: "150"; onChange: trafficLimit = value }
        Text { text: strings.thresholdHelp[languageIndex]; style: small; color: pMuted; maxLines: 3 }
        Button { text: strings.refresh[languageIndex]; onTap: { checkStartedAt = now; refresh() } }
      }
      if checking { Row { SampleLight { }; Text { text: strings.checking[languageIndex]; font: mono; style: small; color: pBlue } } }
    }
  }
}
