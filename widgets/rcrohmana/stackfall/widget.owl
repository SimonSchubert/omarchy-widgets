// Stackfall by rcrohmana, 2026. MIT License. A falling-blocks puzzle.
widget "stackfall" {
  size: 4x8
  minSize: 3x6
  padding: 10
  meta { owl: 7; description: "Falling-blocks puzzle on a 10x20 well: tap to rotate, drag sideways to move, swipe down to drop. Saves the game and a high score"; version: "1.3"; license: "MIT"; author: "rcrohmana"; category: "fun" }
  requires { pacman: [] }

  // No shell: the whole game is state and derived lets, driven by a self-rescheduling `at`.
  source now = clock every 1s
  state board = [] persist          // 200 cells, row by row, 0 = empty, 1-7 = piece type + 1
  state piece = {t: 0, r: 0, x: 3, y: -1} persist
  state nxt = 0 persist
  state seed = 48271 persist        // Park-Miller PRNG
  state score = 0 persist
  state lines = 0 persist
  state best = 0 persist
  state over = false persist
  state paused = true               // always opens paused
  state wasPaused = false
  state tk = 0                      // next gravity step (Unix seconds, fractional)
  state act = {a: "", n: 0}         // a move request; `on act` plays it
  state mv = -1
  state bonus = 0
  // swipe tracking
  state lastX = 0
  state lastY = 0
  state gsx = 0
  state gsy = 0
  state ax = 0
  state cont = false
  state locked = false
  state step = 0
  state dropNow = false
  // line-clear animation: the board before clearing, its full rows, and when it began (frame time)
  state fxB = []
  state fxRows = []
  state fxT0 = 0
  state fxGain = 0
  state prevBest = 0 persist        // best before this game, for "new best!"

  let W = 10
  let H = 20
  // pieces in their rotation box: I O T S Z J L
  let BASE = [
    {n: 4, c: [[0, 1], [1, 1], [2, 1], [3, 1]]},
    {n: 2, c: [[0, 0], [1, 0], [0, 1], [1, 1]]},
    {n: 3, c: [[1, 0], [0, 1], [1, 1], [2, 1]]},
    {n: 3, c: [[1, 0], [2, 0], [0, 1], [1, 1]]},
    {n: 3, c: [[0, 0], [1, 0], [1, 1], [2, 1]]},
    {n: 3, c: [[0, 0], [0, 1], [1, 1], [2, 1]]},
    {n: 3, c: [[2, 0], [0, 1], [1, 1], [2, 1]]}
  ]
  let ROT = BASE.map(b => [
    b.c,
    b.c.map(q => [b.n - 1 - q[1], q[0]]),
    b.c.map(q => [b.n - 1 - q[0], b.n - 1 - q[1]]),
    b.c.map(q => [q[1], b.n - 1 - q[0]])
  ])
  // distinct hues from the theme: I light blue, O yellow, T magenta, S green, Z red, J blue, L orange
  let COL = [mix(blue, foreground, 0.45), bright_yellow, magenta, green, red, blue, mix(red, bright_yellow, 0.55)]

  let ready = len(board) == W * H
  let SH = ROT[piece.t][piece.r]
  let level = floor(lines / 10) + 1
  let iv = max(0.8 * pow(0.85, level - 1), 0.15)

  // candidate moves: left, right, down, then rotation with wall kicks
  let r1 = (piece.r + 1) % 4
  let CAND = [
    [piece.r, piece.x - 1, piece.y], [piece.r, piece.x + 1, piece.y], [piece.r, piece.x, piece.y + 1],
    [r1, piece.x, piece.y], [r1, piece.x - 1, piece.y], [r1, piece.x + 1, piece.y],
    [r1, piece.x - 2, piece.y], [r1, piece.x + 2, piece.y], [r1, piece.x, piece.y - 1]
  ]
  let OK = CAND.map(c => all(ROT[piece.t][c[0]], q =>
    c[1] + q[0] >= 0 && c[1] + q[0] < W && c[2] + q[1] < H &&
    (c[2] + q[1] < 0 || board[(c[2] + q[1]) * W + c[1] + q[0]] == 0)))
  let rotI = indexOf(drop(OK, 3), true)

  // how far the piece falls (also the ghost)
  let FALLS = range(1, H + 3).map(d => all(SH, q =>
    piece.y + d + q[1] < H && (piece.y + d + q[1] < 0 || board[(piece.y + d + q[1]) * W + piece.x + q[0]] == 0)))
  let dd = max(indexOf(FALLS, false), 0)
  let LY = piece.y + dd

  // locking: place, clear full rows, spawn the next piece
  let LC = SH.map(q => (LY + q[1]) * W + piece.x + q[0])
  let topOut = any(SH, q => LY + q[1] < 0)
  let placed = range(W * H).map(i => indexOf(LC, i) >= 0 ? piece.t + 1 : board[i])
  let KEPT = range(H).map(r => take(drop(placed, r * W), W)).filter(row => any(row, v => v == 0))
  let cleared = H - len(KEPT)
  let NB = flatten([range(cleared * W).map(i => 0), flatten(KEPT)])
  let gain = [0, 100, 300, 500, 800][cleared] * level
  let ns = (seed * 16807) % 2147483647
  let nn = ns % 7 == nxt ? floor(ns / 7) % 7 : ns % 7
  let SP = {t: nxt, r: 0, x: nxt == 1 ? 4 : 3, y: nxt == 0 ? -1 : 0}
  let spawnOk = all(ROT[SP.t][0], q => NB[(SP.y + q[1]) * W + SP.x + q[0]] == 0)

  let live = ready && !paused && !over
  let FULL = range(H).filter(r => all(take(drop(placed, r * W), W), v => v > 0))
  let FXD = 0.5                     // seconds: rows flash and vanish, then the stack slides down

  on act {
    // -1 nothing, -2 lock (gravity), -3 hard drop, >= 0 move to CAND[mv]
    mv = !live ? -1
      : value.a == "L" ? (OK[0] ? 0 : -1)
      : value.a == "R" ? (OK[1] ? 1 : -1)
      : value.a == "rot" ? (rotI < 0 ? -1 : rotI + 3)
      : value.a == "tick" ? (OK[2] ? 2 : -2)
      : value.a == "drop" ? -3 : -1
    bonus = mv == -3 ? 2 * dd : 0
    fxRows = mv <= -2 && cleared > 0 ? FULL : time - fxT0 > 0.8 ? [] : fxRows
    fxB = mv <= -2 && cleared > 0 ? placed : fxB
    fxT0 = mv <= -2 && cleared > 0 ? time : fxT0
    fxGain = mv <= -2 && cleared > 0 ? gain : fxGain
    tk = mv <= -2 && cleared > 0 && tk > 0 ? tk + FXD : tk
    over = mv <= -2 ? topOut || !spawnOk : over
    score = mv <= -2 ? score + gain + bonus : score
    lines = mv <= -2 ? lines + cleared : lines
    board = mv <= -2 ? NB : board
    piece = mv <= -2 ? SP : mv >= 0 ? {t: piece.t, r: CAND[mv][0], x: CAND[mv][1], y: CAND[mv][2]} : piece
    nxt = mv <= -2 ? nn : nxt
    seed = mv <= -2 ? ns : seed
    best = max(best, score)
    tk = over ? 0 : tk
  }

  // gravity; pauses itself when the page is off screen (the clock stops there)
  at tk {
    paused = paused || tk - now > 4
    act = paused ? act : {a: "tick", n: act.n + 1}
    tk = paused || over ? 0 : max(tk, now) + iv
  }

  // a buzz for a hard drop or cleared lines (both add to the score)
  on score { haptic() }

  when !ready && now > 0 {
    prevBest = best
    seed = now % 2147483646 + 1
    board = range(W * H).map(i => 0)
    piece = {t: seed % 7, r: 0, x: seed % 7 == 1 ? 4 : 3, y: seed % 7 == 0 ? -1 : 0}
    nxt = floor(seed / 7) % 7
    score = 0
    lines = 0
    over = false
    paused = true
  }


  // layout
  let headerH = 48
  let cs = max(floor(min(((tileWidth ?? 280) - 20) / W, ((tileHeight ?? 560) - 20 - headerH - 8) / H)), 8)
  let bw = cs * W
  let bh = cs * H

  component Stat(name, value, tint = foreground) {
    Column {
      gap: 0
      height: headerH
      padding: [4, 3]
      radius: 6 * corners
      background: alpha(foreground, 0.08)
      align: center
      justify: center
      Text { text: name; fontSize: 11; color: alpha(foreground, 0.6); align: center; maxLines: 1 }
      Text { text: "${value}"; bold: true; fontSize: len("${value}") > 5 ? 11 : len("${value}") > 4 ? 12 : 14; color: tint; align: center; maxLines: 1 }
    }
  }

  component Overlay(title, note, tint = foreground) {
    Column {
      fill: true
      align: center
      justify: center
      gap: 4
      background: alpha(background, 0.82)
      Text { text: title; fontSize: 22; bold: true; color: tint; align: center }
      Text { text: note; color: alpha(foreground, 0.85); align: center }
    }
  }

  Column {
    gap: 8
    align: center
    Row {
      height: headerH
      fill: width
      align: center
      gap: 4
      Stat { name: "score"; value: score; weight: 1 }
      // level, with the lines toward the next one
      Column {
        width: 36
        height: headerH
        gap: 1
        padding: [5, 3]
        radius: 6 * corners
        background: alpha(foreground, 0.08)
        align: center
        justify: center
        Text { text: "lvl"; fontSize: 11; color: alpha(foreground, 0.6); align: center; maxLines: 1 }
        Text { text: "${level}"; bold: true; fontSize: 14; color: accent; align: center; maxLines: 1 }
        Progress { value: lines % 10; max: 10; color: accent; track: alpha(foreground, 0.12); height: 3; fill: width; animate value: spring() }
      }
      Stat { name: "best"; value: best; tint: bright_yellow; weight: 1 }
      Column {
        width: 42
        height: headerH
        gap: 2
        padding: [4, 3]
        radius: 6 * corners
        background: alpha(foreground, 0.08)
        align: center
        justify: center
        Text { text: "next"; fontSize: 11; color: alpha(foreground, 0.6); align: center; maxLines: 1 }
        Canvas {
          width: 36
          height: 20
          let pw = nxt == 0 ? 4 : nxt == 1 ? 2 : 3
          let ph = nxt == 0 ? 1 : 2
          let oy = nxt == 0 ? -1 : 0
          for q in ROT[nxt][0] {
            rect(18 - pw * 4.5 + q[0] * 9, 10 - ph * 4.5 + (q[1] + oy) * 9, 8, 8, radius: 2 * corners, fill: COL[nxt])
          }
        }
      }
      Button {
        width: 48
        text: over ? "new" : paused ? "▶" : "❚❚"
        color: over ? accent : paused ? green : bright_yellow
        onTap: {
          board = over ? [] : board
          wasPaused = paused
          paused = over ? true : !paused
          tk = wasPaused && !paused ? now + iv : tk
          haptic()
        }
      }
    }

    Box {
      width: bw
      height: bh
      clip: true
      radius: 6 * corners
      background: alpha(foreground, 0.06)
      align: center
      onTap: {
        wasPaused = paused
        paused = over ? paused : false
        tk = wasPaused && !over ? now + iv : tk
        act = wasPaused || over ? act : {a: "rot", n: act.n + 1}
      }
      // drag sideways moves a column per cell width; a swipe down drops
      onDrag: {
        cont = (abs(x - lastX - dx) < 2 && abs(y - lastY - dy) < 2) || (abs(x - dx - gsx) < 2 && abs(y - dy - gsy) < 2)
        locked = cont ? locked : false
        gsx = cont ? gsx : x - dx
        gsy = cont ? gsy : y - dy
        ax = cont ? ax : gsx
        step = locked ? 0 : x - ax >= cs * 0.9 ? 1 : x - ax <= -cs * 0.9 ? -1 : 0
        act = step != 0 ? {a: step > 0 ? "R" : "L", n: act.n + 1} : act
        ax = ax + step * cs
        dropNow = !locked && y - gsy > cs * 3 && y - gsy > abs(x - gsx) * 1.5
        act = dropNow ? {a: "drop", n: act.n + 1} : act
        locked = locked || dropNow
        lastX = x
        lastY = y
      }

      Canvas {
        width: bw
        height: bh
        for c in range(1, W) { line(c * cs, 0, c * cs, bh, stroke: alpha(foreground, 0.05), width: 1) }
        for r in range(1, H) { line(0, r * cs, bw, r * cs, stroke: alpha(foreground, 0.05), width: 1) }
        let ft = len(fxRows) > 0 ? time - fxT0 : 9
        if ft < FXD {
          let k1 = clamp(ft / 0.25, 0, 1)
          let k2 = clamp((ft - 0.2) / (FXD - 0.2), 0, 1)
          let ease = 1 - pow(1 - k2, 3)
          for r in fxRows { rect(0, r * cs, bw, cs, fill: alpha(foreground, 0.35 * (1 - k1))) }
          for i in range(W * H) {
            if fxB[i] > 0 {
              let r = floor(i / W)
              let c = i % W
              if indexOf(fxRows, r) >= 0 {
                // cleared cells whiten and shrink away, from the middle out
                let g = clamp(k1 * 1.6 - abs(c - 4.5) / 7.5, 0, 1)
                let sz = (cs - 2) * (1 - g)
                if sz > 0.5 {
                  rect(c * cs + cs / 2 - sz / 2, r * cs + cs / 2 - sz / 2, sz, sz, radius: 3 * corners, fill: mix(COL[fxB[i] - 1], foreground, min(k1 * 2, 1)))
                }
              } else {
                let sh = count(fxRows, x => x > r) * cs * ease
                rect(c * cs + 1, r * cs + 1 + sh, cs - 2, cs - 2, radius: 3 * corners, fill: COL[fxB[i] - 1])
              }
            }
          }
        } else {
          for i in range(W * H) {
            if board[i] > 0 {
              rect((i % W) * cs + 1, floor(i / W) * cs + 1, cs - 2, cs - 2, radius: 3 * corners, fill: COL[board[i] - 1])
            }
          }
        }
        if ready && !over {
          for q in SH {
            if LY + q[1] >= 0 && dd > 0 && ft >= FXD {
              rect((piece.x + q[0]) * cs + 1.5, (LY + q[1]) * cs + 1.5, cs - 3, cs - 3, radius: 3 * corners, stroke: alpha(COL[piece.t], 0.5), width: 1.5)
            }
          }
          for q in SH {
            if piece.y + q[1] >= 0 {
              rect((piece.x + q[0]) * cs + 1, (piece.y + q[1]) * cs + 1, cs - 2, cs - 2, radius: 3 * corners, fill: COL[piece.t])
            }
          }
        }
      }

      // "+300" rising from the cleared rows
      Canvas {
        width: bw
        height: bh
        let pt = len(fxRows) > 0 ? time - fxT0 : 9
        if pt < 0.75 {
          let py = avg(fxRows) * cs + cs / 2 - pt * 40
          let pa = pt < 0.5 ? 1 : 1 - (pt - 0.5) / 0.25
          text("+${fxGain}", bw / 2, py, size: cs * 0.9, bold: true, align: center, color: alpha(bright_yellow, pa))
          if len(fxRows) > 1 {
            text(["", "", "double", "triple", "quad!"][len(fxRows)], bw / 2, py - cs * 0.9, size: cs * 0.55, bold: true, align: center, color: alpha(foreground, pa))
          }
        }
      }

      if live {
        // reads the frame clock so handlers see the current `time`
        Canvas { width: 1; height: 1; rect(0, 0, 1, 1, fill: alpha(background, 0 * time)) }
      }

      if over {
        Overlay { title: "game over"; note: "score ${score} · ${lines} lines\ntap new to play again"; tint: red }
        if score > prevBest && score > 0 {
          Text { offset: [0, -64]; text: "new best!"; fontSize: 16; bold: true; color: bright_yellow; align: center }
        }
      } else if paused {
        Overlay { title: "stackfall"; note: "tap to play\n\ntap · rotate\ndrag ← → · move\nswipe ↓ · drop"; tint: accent }
      }
    }
  }
}
