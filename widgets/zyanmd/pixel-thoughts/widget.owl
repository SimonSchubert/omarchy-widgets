widget "pixel thoughts" {
  page: 1
  order: 12
  size: 6x2
  minSize: 4x2
  padding: 0

  meta {
    owl: 8
    description: "Catatan pikiran spontan memanjang dengan latar belakang animasi langit pixel adaptif tema."
    version: "1.1"
    license: "MIT"
    category: "productivity"
    author: "zyanmd"
  }

  requires {
    pacman: ["jq"]
  }

  source now = clock every 1s

  source init = cmd("""
    dir=~/.local/share/pixel-thoughts
    f="$dir/notes.json"
    mkdir -p "$dir"
    if [ ! -s "$f" ]; then
      cat > "$f" <<'EOF'
[
  {"id":1729166000,"text":"bintang-bintang pixel di langit malam ✨","time":1729166000},
  {"id":1729165000,"text":"catat apa saja yang terpikirkan hari ini 💭","time":1729165000},
  {"id":1729164000,"text":"ide cemerlang selalu datang tiba-tiba 💡","time":1729164000}
]
EOF
    fi
    echo ok
  """) every 1h

  source rawNotes = file("~/.local/share/pixel-thoughts/notes.json") json
  source sys = android.system every 5s
  source themeName = file("~/.local/state/omarchy/current/theme.name")
  source themeColors = file("~/.local/state/omarchy/current/theme/colors.toml")

  state textFont = "mono" persist
  state switchSpeed = 8 persist
  state manualOffset = 0 persist
  state filterQuery = ""

  let activeTheme = lower(themeName != "" ? themeName : (sys.theme ?? ""))
  let isLight = contains(lower(themeColors), 'mode = "light"') || contains(activeTheme, "white") || contains(activeTheme, "light") || contains(activeTheme, "latte") || contains(activeTheme, "lupine") || contains(activeTheme, "rose-pine")
  let isSunset = contains(activeTheme, "retro") || contains(activeTheme, "ristretto") || contains(activeTheme, "horizon") || contains(activeTheme, "matte-black") || contains(activeTheme, "orange") || contains(activeTheme, "sunset") || contains(activeTheme, "amber") || contains(activeTheme, "autumn")
  let isAurora = contains(activeTheme, "everforest") || contains(activeTheme, "osaka-jade") || contains(activeTheme, "jade") || contains(activeTheme, "forest") || contains(activeTheme, "kanagawa") || contains(activeTheme, "miasma") || contains(activeTheme, "hackerman")

  let skyMode = isLight ? "day" : isSunset ? "sunset" : isAurora ? "aurora" : "night"

  let notes = (rawNotes == null || rawNotes == "" || rawNotes == []) ? [] : rawNotes
  let totalNotes = len(notes)
  let currentNow = now ?? 0
  let autoStep = (totalNotes > 1 && switchSpeed > 0) ? floor(currentNow / switchSpeed) : 0
  let validIndex = totalNotes > 0 ? ((autoStep + manualOffset) % totalNotes + totalNotes) % totalNotes : 0
  let currentNote = totalNotes > 0 ? notes[validIndex] : {"text": "tulis pikiran kamu…", "time": currentNow}

  // --- 1. BACKGROUND SIANG: AWAN PIXEL & MATAHARI (UNTUK TEMA PUTIH/TERANG) ---
  component DaytimeBackground() {
    Canvas {
      fill: true
      let ps = 2.5

      // Latar belakang mengikuti tema aktif Omalauncher
      rect(0, 0, width, height, fill: linear(0, 0, 0, height, [background, surface]))

      // Matahari pixel hangat di kanan atas
      let sunX = floor((width - 36) / ps) * ps
      let sunY = floor(8 / ps) * ps
      let sP = ps * 1.1
      let sunGlow = 0.6 + 0.4 * abs(sin(time * 1.2))

      // Aura sinar matahari
      rect(sunX - sP, sunY - sP, sP * 8, sP * 8, radius: sP * 2, fill: alpha(yellow ?? orange, 0.22 * sunGlow))
      for c in range(36) {
        let si = c % 6 - 2.5
        let sj = floor(c / 6) - 2.5
        if si * si + sj * sj <= 6.5 {
          rect(sunX + (si + 2.5) * sP, sunY + (sj + 2.5) * sP, sP, sP, fill: alpha(yellow ?? orange, 0.85))
        }
      }

      // Burung pixel melayang di langit
      let flap = floor(time * 3.5) % 2
      let birdArt = flap == 0 ? ["v.v", ".v."] : [".v.", "v.v"]
      let bx = (time * 10 + width * 0.2) % (width + 50) - 25
      let by = 16 + sin(time * 1.8) * 3
      sprite(birdArt, bx, by, ps, palette: { v: alpha(foreground, 0.38) })
      sprite(birdArt, bx + 12, by + 5, ps, palette: { v: alpha(foreground, 0.28) })

      // Sprites Awan Pixel dengan outline retro
      let cloudWide = [
        ".......bbbbbbb..........",
        ".....bbwwwwwwwbb..bbbb..",
        "...bbwwwwwwwwwwwbbwwwwb.",
        "..bwwwwwwwwwwwwwwwwwwwwb",
        ".bwwwwwwwwwwwwwwwwwwwwwb",
        "bwwwwwwwwwwwwwwwwwwwwwwb",
        "bssssssssssssssssssssssb",
        ".bbbbbbbbbbbbbbbbbbbbbb."
      ]
      let cloudMed = [
        ".....bbbbbbb.....",
        "...bbwwwwwwwbb...",
        "..bwwwwwwwwwwwb..",
        ".bwwwwwwwwwwwwwb.",
        "bwwwwwwwwwwwwwwwb",
        "bsssssssssssssssb",
        ".bbbbbbbbbbbbbbb."
      ]
      let cloudSmall = [
        "...bbb......",
        "..bwwwb..bb.",
        ".bwwwwwwwbwb",
        "bwwwwwwwwwwb",
        "bssssssssssb",
        ".bbbbbbbbbb."
      ]

      let cPal = {
        w: mix(background, foreground, 0.05),
        b: alpha(foreground, 0.32),
        s: alpha(mix(accent, muted, 0.5), 0.35)
      }

      let c1x = (time * 4.5 + width * 0.08) % (width + 90) - 60
      sprite(cloudWide, c1x, 8, ps, palette: cPal)

      let c2x = (time * 6.5 + width * 0.45) % (width + 70) - 45
      sprite(cloudMed, c2x, height * 0.65, ps, palette: cPal)

      let c3x = (time * 3.8 + width * 0.8) % (width + 50) - 30
      sprite(cloudSmall, c3x, height * 0.72, ps, palette: cPal)
    }
  }

  // --- 2. BACKGROUND SORE / SENJA: MATAHARI TERBENAM & AWAN EMAS (UNTUK TEMA ORANGE/WARM) ---
  component SunsetBackground() {
    Canvas {
      fill: true
      let ps = 2.5

      // Latar langit senja bertingkat mengikuti tema & warna orange
      rect(0, 0, width, height, fill: linear(0, 0, 0, height, [mix(background, orange, 0.22), mix(surface, orange, 0.42)]))

      // Matahari senja terbenam di kanan
      let sunX = floor((width - 44) / ps) * ps
      let sunY = floor((height * 0.46) / ps) * ps
      let sP = ps * 1.3
      let glow = 0.7 + 0.3 * abs(sin(time * 1.1))

      rect(sunX - sP * 2, sunY - sP * 2, sP * 10, sP * 10, radius: sP * 3, fill: alpha(orange, 0.25 * glow))
      rect(sunX - sP, sunY - sP, sP * 8, sP * 8, radius: sP * 2, fill: alpha(yellow ?? orange, 0.40 * glow))
      for c in range(36) {
        let si = c % 6 - 2.5
        let sj = floor(c / 6) - 2.5
        if si * si + sj * sj <= 6.5 {
          rect(sunX + (si + 2.5) * sP, sunY + (sj + 2.5) * sP, sP, sP, fill: alpha(orange, 0.95))
        }
      }

      // Bintang Kejora (bintang pertama senja) di kiri atas
      let starX = floor(24 / ps) * ps
      let starY = floor(12 / ps) * ps
      let stw = 0.4 + 0.6 * abs(sin(time * 1.5))
      rect(starX, starY, ps * 2, ps * 2, fill: alpha(yellow ?? foreground, stw * 0.85))
      if stw > 0.55 {
        rect(starX - ps * 2, starY, ps * 2, ps * 2, fill: alpha(orange, stw * 0.65))
        rect(starX + ps * 2, starY, ps * 2, ps * 2, fill: alpha(orange, stw * 0.65))
        rect(starX, starY - ps * 2, ps * 2, ps * 2, fill: alpha(orange, stw * 0.65))
        rect(starX, starY + ps * 2, ps * 2, ps * 2, fill: alpha(orange, stw * 0.65))
      }

      // Burung-burung senja terbang pulang
      let flap = floor(time * 3) % 2
      let birdArt = flap == 0 ? ["v.v", ".v."] : [".v.", "v.v"]
      let bx = (width + 40) - (time * 8 + width * 0.25) % (width + 60)
      let by = 14 + sin(time * 1.6) * 3
      sprite(birdArt, bx, by, ps, palette: { v: alpha(foreground, 0.5) })
      sprite(birdArt, bx + 14, by + 5, ps, palette: { v: alpha(foreground, 0.38) })

      // Awan senja bernuansa jingga & emas
      let cloudWide = [
        ".......bbbbbbb..........",
        ".....bbwwwwwwwbb..bbbb..",
        "...bbwwwwwwwwwwwbbwwwwb.",
        "..bwwwwwwwwwwwwwwwwwwwwb",
        ".bwwwwwwwwwwwwwwwwwwwwwb",
        "bwwwwwwwwwwwwwwwwwwwwwwb",
        "bssssssssssssssssssssssb",
        ".bbbbbbbbbbbbbbbbbbbbbb."
      ]
      let cloudMed = [
        ".....bbbbbbb.....",
        "...bbwwwwwwwbb...",
        "..bwwwwwwwwwwwb..",
        ".bwwwwwwwwwwwwwb.",
        "bwwwwwwwwwwwwwwwb",
        "bsssssssssssssssb",
        ".bbbbbbbbbbbbbbb."
      ]

      let duskPal = {
        w: mix(orange, yellow, 0.35),
        b: alpha(mix(orange, foreground, 0.35), 0.45),
        s: alpha(mix(red ?? orange, background, 0.3), 0.5)
      }

      let c1x = (time * 3.5 + width * 0.1) % (width + 90) - 60
      sprite(cloudWide, c1x, 8, ps, palette: duskPal)

      let c2x = (time * 5 + width * 0.55) % (width + 70) - 45
      sprite(cloudMed, c2x, height * 0.68, ps, palette: duskPal)
    }
  }

  // --- 3. BACKGROUND AURORA / ALAM (UNTUK TEMA HIJAU/FOREST/JADE) ---
  component AuroraBackground() {
    Canvas {
      fill: true
      let ps = 2.5

      // Latar langit alam mengikuti tema & sentuhan hijau
      rect(0, 0, width, height, fill: linear(0, 0, 0, height, [background, mix(surface, green, 0.16)]))

      // Gelombang Aurora Borealis pixel lembut
      for i in range(28) {
        let ax = i * (width / 26)
        let ay1 = height * 0.34 + sin(time * 0.8 + i * 0.28) * 10 + cos(time * 0.5 + i * 0.18) * 6
        rect(ax, ay1, width / 24, 18, fill: alpha(green, 0.22 + 0.12 * sin(time * 1.2 + i * 0.2)))

        let ay2 = height * 0.42 + sin(time * 0.6 + i * 0.32 + 1.5) * 8 + cos(time * 0.7 + i * 0.22) * 5
        rect(ax, ay2, width / 24, 14, fill: alpha(cyan ?? green, 0.18 + 0.10 * cos(time * 0.9 + i * 0.25)))
      }

      // Bintang-bintang pixel di balik aurora
      let auroraStars = [
        [0.06, 0.14, 1, 1.2, 0.4],
        [0.18, 0.16, 3, 0.9, 1.8],
        [0.34, 0.12, 1, 1.5, 2.3],
        [0.50, 0.15, 2, 0.8, 0.7],
        [0.66, 0.12, 1, 1.1, 3.2],
        [0.82, 0.16, 3, 0.7, 4.1],
        [0.94, 0.14, 1, 1.7, 1.5],
        [0.08, 0.86, 2, 1.0, 5.0],
        [0.24, 0.82, 1, 0.8, 2.8],
        [0.72, 0.84, 1, 1.2, 1.9],
        [0.88, 0.86, 2, 1.0, 5.4]
      ]

      for s in auroraStars {
        let sx = floor(width * s[0] / ps) * ps
        let sy = floor(height * s[1] / ps) * ps
        let tw = 0.25 + 0.75 * abs(sin(time * s[3] + s[4]))
        let stype = s[2]

        if stype == 1 {
          rect(sx, sy, ps, ps, fill: alpha(mix(foreground, green, 0.3), tw * 0.6))
        }
        if stype == 2 {
          rect(sx, sy, ps * 2, ps * 2, fill: alpha(mix(foreground, cyan ?? green, 0.3), tw * 0.75))
        }
        if stype == 3 {
          rect(sx, sy, ps * 2, ps * 2, fill: alpha(mix(foreground, yellow ?? green, 0.25), tw * 0.85))
          if tw > 0.5 {
            let arm = ps * 2
            rect(sx - arm, sy, arm, arm, fill: alpha(green, tw * 0.6))
            rect(sx + arm, sy, arm, arm, fill: alpha(green, tw * 0.6))
            rect(sx, sy - arm, arm, arm, fill: alpha(green, tw * 0.6))
            rect(sx, sy + arm, arm, arm, fill: alpha(green, tw * 0.6))
          }
        }
      }

      // Bulan sabit pixel
      let moonX = floor((width - 32) / ps) * ps
      let moonY = floor(8 / ps) * ps
      let mP = ps * 1.1
      for c in range(25) {
        let mi = c % 5 - 2
        let mj = floor(c / 5) - 2
        if mi * mi + mj * mj <= 5 && (mi + 1) * (mi + 1) + (mj + 1) * (mj + 1) > 4 {
          rect(moonX + (mi + 2) * mP, moonY + (mj + 2) * mP, mP, mP, fill: alpha(mix(cyan ?? yellow, foreground, 0.3), 0.7))
        }
      }
    }
  }

  // --- 4. BACKGROUND MALAM: BINTANG PIXEL & BULAN (UNTUK TEMA GELAP/NAVY/HITAM) ---
  component StarryBackground() {
    Canvas {
      fill: true
      let ps = 2.5

      // Latar belakang mengikuti tema aktif Omalauncher
      rect(0, 0, width, height, fill: linear(0, 0, 0, height, [background, surface]))

      // Taburan bintang pixel berkelap-kelip membingkai teks
      let starList = [
        [0.05, 0.12, 1, 1.2, 0.4],
        [0.18, 0.15, 3, 0.9, 1.8],
        [0.32, 0.10, 1, 1.5, 2.3],
        [0.48, 0.14, 2, 0.8, 0.7],
        [0.64, 0.10, 1, 1.1, 3.2],
        [0.78, 0.15, 3, 0.7, 4.1],
        [0.92, 0.12, 1, 1.7, 1.5],
        [0.06, 0.88, 2, 1.0, 5.0],
        [0.16, 0.82, 1, 0.8, 2.8],
        [0.30, 0.86, 3, 1.3, 0.2],
        [0.46, 0.82, 1, 1.1, 4.5],
        [0.62, 0.88, 2, 0.9, 3.0],
        [0.76, 0.84, 1, 1.2, 1.9],
        [0.88, 0.86, 3, 1.0, 5.4],
        [0.04, 0.45, 2, 0.8, 2.6],
        [0.08, 0.65, 1, 1.4, 3.8],
        [0.94, 0.48, 1, 1.0, 0.9],
        [0.96, 0.68, 2, 1.6, 2.5],
        [0.22, 0.50, 1, 0.7, 1.1],
        [0.78, 0.52, 1, 0.9, 2.2]
      ]

      for s in starList {
        let sx = floor(width * s[0] / ps) * ps
        let sy = floor(height * s[1] / ps) * ps
        let tw = 0.2 + 0.65 * abs(sin(time * s[3] + s[4]))
        let stype = s[2]

        if stype == 1 {
          rect(sx, sy, ps, ps, fill: alpha(mix(foreground, accent, 0.3), tw * 0.6))
        }
        if stype == 2 {
          rect(sx, sy, ps * 2, ps * 2, fill: alpha(mix(foreground, cyan, 0.3), tw * 0.7))
        }
        if stype == 3 {
          rect(sx, sy, ps * 2, ps * 2, fill: alpha(mix(foreground, yellow, 0.2), tw * 0.8))
          if tw > 0.5 {
            let arm = ps * 2
            rect(sx - arm, sy, arm, arm, fill: alpha(accent, tw * 0.55))
            rect(sx + arm, sy, arm, arm, fill: alpha(accent, tw * 0.55))
            rect(sx, sy - arm, arm, arm, fill: alpha(accent, tw * 0.55))
            rect(sx, sy + arm, arm, arm, fill: alpha(accent, tw * 0.55))
          }
        }
      }

      // Komet / Bintang jatuh sesekali meluncur di langit
      let mSec = time % 9
      if mSec < 1.0 {
        let prog = mSec / 1.0
        let mx = floor(lerp(width * 0.92, width * 0.08, prog) / ps) * ps
        let my = floor(lerp(height * 0.08, height * 0.88, prog) / ps) * ps
        let mFade = 1.0 - prog
        rect(mx, my, ps * 2, ps * 2, fill: alpha(yellow ?? foreground, mFade * 0.8))
        rect(mx + ps * 3, my - ps * 2, ps * 2, ps * 2, fill: alpha(accent, mFade * 0.5))
        rect(mx + ps * 6, my - ps * 4, ps * 2, ps * 2, fill: alpha(cyan ?? accent, mFade * 0.3))
        rect(mx + ps * 9, my - ps * 6, ps, ps, fill: alpha(foreground, mFade * 0.15))
      }

      // Bulan sabit pixel lembut di pojok kanan atas
      let moonX = floor((width - 32) / ps) * ps
      let moonY = floor(8 / ps) * ps
      let mP = ps * 1.1
      for c in range(25) {
        let mi = c % 5 - 2
        let mj = floor(c / 5) - 2
        if mi * mi + mj * mj <= 5 && (mi + 1) * (mi + 1) + (mj + 1) * (mj + 1) > 4 {
          rect(moonX + (mi + 2) * mP, moonY + (mj + 2) * mP, mP, mP, fill: alpha(mix(yellow ?? foreground, foreground, 0.2), 0.6))
        }
      }
    }
  }

  // --- KOMPONEN PEMILIH LANGIT SESUAI TEMA ---
  component ThemedSkyBackground() {
    if skyMode == "day" {
      DaytimeBackground {}
    } else {
      if skyMode == "sunset" {
        SunsetBackground {}
      } else {
        if skyMode == "aurora" {
          AuroraBackground {}
        } else {
          StarryBackground {}
        }
      }
    }
  }

  // --- HOME-SCREEN TILE VIEW (MINIMALIST: HANYA TEKS & BG TEMA OMALAUNCHER) ---
  Box {
    fill: true
    onTap: screen()

    ThemedSkyBackground {}

    Column {
      fill: true
      padding: [18, 12]
      justify: center
      align: center

      Text {
        text: currentNote.text ?? "tulis pikiran kamu…"
        font: textFont
        style: title
        bold: true
        align: center
        maxLines: 3
        color: foreground
      }

      if totalNotes > 1 {
        Spacer { height: 6 }
        Row {
          align: center
          justify: center
          gap: 12

          Box {
            width: 32
            padding: [4, 2]
            radius: 4 * (corners ?? 1)
            background: alpha(surface, 0.45)
            align: center
            onTap: {
              manualOffset = manualOffset - 1
              haptic()
            }
            Text {
              text: "‹"
              font: mono
              bold: true
              fontSize: 14
              align: center
              color: isLight ? "#1d4e89" : alpha(foreground, 0.8)
            }
          }

          Text {
            text: "${validIndex + 1} / ${totalNotes}"
            width: 54
            font: mono
            fontSize: 10
            bold: true
            align: center
            color: isLight ? alpha("#1d4e89", 0.8) : alpha(foreground, 0.6)
            onTap: {
              manualOffset = manualOffset + 1
              haptic()
            }
          }

          Box {
            width: 32
            padding: [4, 2]
            radius: 4 * (corners ?? 1)
            background: alpha(surface, 0.45)
            align: center
            onTap: {
              manualOffset = manualOffset + 1
              haptic()
            }
            Text {
              text: "›"
              font: mono
              bold: true
              fontSize: 14
              align: center
              color: isLight ? "#1d4e89" : alpha(foreground, 0.8)
            }
          }
        }
      }
    }
  }

  // --- FULL SCREEN VIEW ---
  screen {
    title: skyMode == "day" ? "☁ Catatan Pikiran Awan" : skyMode == "sunset" ? "🌅 Catatan Pikiran Senja" : skyMode == "aurora" ? "🌌 Catatan Pikiran Aurora" : "✦ Catatan Pikiran Bintang"

    Box {
      fill: true

      ThemedSkyBackground {}

      Column {
        fill: true
        scroll: true
        padding: [14, 12]
        gap: 10

        // Form tambah catatan baru
        Column {
          fill: width
          gap: 6
          padding: 10
          background: isLight ? alpha("#ffffff", 0.9) : alpha(surface, 0.85)
          border: 1
          borderColor: isLight ? alpha("#6fb0e8", 0.5) : alpha(accent, 0.35)
          radius: 8 * (corners ?? 1)

          Text { text: isLight ? "☁ Tulis Pikiran Baru" : "✦ Tulis Pikiran Baru"; style: label; bold: true; color: isLight ? "#1d4e89" : accent }
          Input {
            placeholder: "Ketik ide, catatan, atau isi kepala kamu…"
            clear: true
            onSubmit: run("dir=~/.local/share/pixel-thoughts; f=\"$dir/notes.json\"; mkdir -p \"$dir\"; [ -f \"$f\" ] || echo '[]' > \"$f\"; jq --arg t ${sh(value)} --argjson now ${int(now)} '. = [{\"id\": $now, \"text\": $t, \"time\": $now}] + .' \"$f\" > \"$f.tmp\" && mv \"$f.tmp\" \"$f\"")
          }
        }

        // --- PENGATURAN WIDGET: FONT PIXEL & KECEPATAN PERGANTIAN TEKS ---
        Column {
          fill: width
          gap: 8
          padding: 10
          background: isLight ? alpha("#ffffff", 0.9) : alpha(surface, 0.85)
          border: 1
          borderColor: isLight ? alpha("#6fb0e8", 0.5) : alpha(accent, 0.35)
          radius: 8 * (corners ?? 1)

          Row {
            fill: width
            align: center
            Text {
              text: "⚙ Pengaturan Widget"
              style: label
              bold: true
              color: isLight ? "#1d4e89" : accent
              weight: 1
            }
            Text {
              text: switchSpeed == 0 ? "rotasi mati" : "ganti tiap ${switchSpeed}s"
              style: small
              font: mono
              color: muted
              width: 120
              align: end
            }
          }

          // 1. Pemilihan Font Pixel
          Column {
            fill: width
            gap: 4
            Text {
              text: "Font Pixel / Gaya Tulisan:"
              style: small
              bold: true
              color: isLight ? "#10233b" : foreground
            }
            Row {
              fill: width
              gap: 6
              for f in [["mono", "Monospace"], ["sans", "Sans Pixel"], ["serif", "Serif Retro"]] key f[0] {
                Box {
                  weight: 1
                  padding: [8, 6]
                  radius: 6 * (corners ?? 1)
                  background: textFont == f[0] ? accent : (isLight ? alpha("#6fb0e8", 0.15) : alpha(surface, 0.6))
                  border: 1
                  borderColor: textFont == f[0] ? accent : (isLight ? alpha("#6fb0e8", 0.3) : alpha(border, 0.4))
                  align: center
                  onTap: {
                    textFont = f[0]
                    haptic()
                  }
                  Text {
                    text: f[1]
                    fontSize: 11
                    bold: textFont == f[0]
                    align: center
                    color: textFont == f[0] ? (isLight ? "#ffffff" : background) : (isLight ? "#10233b" : foreground)
                  }
                }
              }
            }
          }

          // 2. Kecepatan Pergantian Teks
          Column {
            fill: width
            gap: 4
            Text {
              text: "Kecepatan Pergantian Teks:"
              style: small
              bold: true
              color: isLight ? "#10233b" : foreground
            }
            Row {
              fill: width
              gap: 5
              for sp in [[5, "5s"], [8, "8s"], [12, "12s"], [20, "20s"], [0, "Mati"]] key sp[1] {
                Box {
                  weight: 1
                  padding: [7, 5]
                  radius: 6 * (corners ?? 1)
                  background: switchSpeed == sp[0] ? accent : (isLight ? alpha("#6fb0e8", 0.15) : alpha(surface, 0.6))
                  border: 1
                  borderColor: switchSpeed == sp[0] ? accent : (isLight ? alpha("#6fb0e8", 0.3) : alpha(border, 0.4))
                  align: center
                  onTap: {
                    switchSpeed = sp[0]
                    haptic()
                  }
                  Text {
                    text: sp[1]
                    fontSize: 11
                    bold: switchSpeed == sp[0]
                    align: center
                    color: switchSpeed == sp[0] ? (isLight ? "#ffffff" : background) : (isLight ? "#10233b" : foreground)
                  }
                }
              }
            }
          }

          // Status & Preview Pikiran Aktif
          Row {
            fill: width
            align: center
            gap: 6
            Text {
              text: "Aktif (${validIndex + 1}/${totalNotes}):"
              style: small
              font: mono
              color: muted
              width: 85
            }
            Text {
              text: "\"" + (currentNote.text ?? "") + "\""
              style: small
              font: textFont
              bold: true
              weight: 1
              maxLines: 1
              color: isLight ? "#1d4e89" : accent
            }
            if totalNotes > 1 {
              Button {
                text: "ganti ↻"
                onTap: {
                  manualOffset = manualOffset + 1
                  haptic()
                }
              }
            }
          }
        }

        // Pencarian catatan
        Row {
          fill: width
          align: center
          gap: 6
          Input {
            weight: 1
            placeholder: "🔍 Cari dalam catatan…"
            onChange: filterQuery = value
          }
          if filterQuery != "" {
            Button {
              text: "reset"
              onTap: filterQuery = ""
            }
          }
        }

        // Daftar Catatan
        let q = lower(trim(filterQuery))
        let filteredNotes = q == "" ? notes : notes.filter(n => contains(lower(n.text ?? ""), q))

        Text {
          text: "${len(filteredNotes)} catatan tersimpan"
          style: small
          color: muted
        }

        for n in filteredNotes key n.id {
          Box {
            fill: width
            padding: 10
            background: isLight ? alpha("#ffffff", 0.88) : alpha(surface, 0.75)
            border: 1
            borderColor: isLight ? alpha("#6fb0e8", 0.4) : alpha(border, 0.5)
            radius: 8 * (corners ?? 1)

            Column {
              fill: width
              gap: 6

              Row {
                fill: width
                align: center
                Text {
                  text: fmtTime(n.time ?? now, "EEEE, dd MMM yyyy · HH:mm")
                  style: small
                  color: isLight ? "#1d4e89" : accent
                  weight: 1
                }
              }

              Text {
                text: n.text ?? ""
                font: textFont
                style: body
                color: isLight ? "#10233b" : foreground
              }

              Row {
                fill: width
                align: center
                gap: 6
                Spacer { weight: 1 }
                Button {
                  text: "salin"
                  onTap: {
                    copy(n.text ?? "")
                    notify("Tersalin", n.text ?? "")
                  }
                }
                Button {
                  text: "bagikan"
                  onTap: share(n.text ?? "")
                }
                Button {
                  text: "hapus"
                  color: red
                  onTap: run("dir=~/.local/share/pixel-thoughts; f=\"$dir/notes.json\"; jq --argjson id ${int(n.id)} '[.[] | select(.id != $id)]' \"$f\" > \"$f.tmp\" && mv \"$f.tmp\" \"$f\"")
                }
              }
            }
          }
        }

        Spacer { height: 16 }

        // Kartu Kredit Pembuat (mirip photo-widget)
        Row {
          fill: width
          padding: [14, 12]
          background: isLight ? alpha("#ffffff", 0.9) : alpha(surface, 0.75)
          border: 1
          borderColor: isLight ? alpha("#6fb0e8", 0.4) : alpha(border, 0.4)
          radius: 12 * (corners ?? 1)
          gap: 12
          onTap: {
            url("https://github.com/zyanmd")
            haptic()
          }

          Box {
            size: 38
            radius: 10 * (corners ?? 1)
            clip: true
            background: isLight ? alpha("#6fb0e8", 0.2) : alpha(accent, 0.15)
            border: 1
            borderColor: isLight ? alpha("#6fb0e8", 0.4) : alpha(accent, 0.35)
            align: center
            Text {
              text: "🐙"
              fontSize: 20
              align: center
            }
          }

          Column {
            weight: 1
            gap: 2
            Text {
              text: "Dibuat oleh zyanmd"
              style: label
              bold: true
              color: isLight ? "#10233b" : foreground
            }
            Text {
              text: "github.com/zyanmd"
              style: small
              color: isLight ? "#1d4e89" : accent
            }
          }

          Button {
            text: "Kunjungi ↗"
            width: 95
            color: isLight ? alpha("#6fb0e8", 0.3) : alpha(accent, 0.25)
            onTap: {
              url("https://github.com/zyanmd")
              haptic()
            }
          }
        }

        Spacer { height: 16 }
        Button {
          text: "tutup layar"
          color: accent
          onTap: close()
        }
      }
    }
  }
}
