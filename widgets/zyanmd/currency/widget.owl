widget "currency" {
  meta {
    owl: 8
    description: "Kurs mata uang & perbandingan forex global dengan grafik live transparan"
    version: "4.3"
    license: "MIT"
    category: "finance"
  }

  page: 1
  order: 4
  size: 6x3
  minSize: 6x2
  padding: 10

  requires { pacman: ["curl", "jq"] }

  // State: Terpasang di Layar Utama (Tile Homescreen - Persisted)
  state pinnedSymbol = "USDIDR" persist
  state timeSpan = "1m" persist

  // State: Pasangan yang Sedang Diinspeksi di Layar Modal Detail (Clean state)
  state selectedSymbol = ""

  // State: Currency List Filters, Sorting & Pagination (Clean state, no search persist)
  state pageNumber = 1
  state pageLimit = 20
  state baseFilter = ""
  state quoteFilter = ""
  state sortField = "percent_change"
  state sortDirection = "desc"
  state trendFilter = "all"
  state searchKeyword = ""

  // Data sources
  // 1. Fetch live currency pair rate and real time-series points from Yahoo Finance / Frankfurter
  source cur = cmd("set -- ${sh(selectedSymbol != '' ? selectedSymbol : pinnedSymbol)} ${sh(timeSpan)}; " + """
raw_sym="${1:-USDIDR}"
sp="${2:-1m}"
sym=$(echo "$raw_sym" | tr -d '/' | tr '[:lower:]' '[:upper:]')
b="${sym:0:3}"
q="${sym:3:3}"
[ -z "$q" ] && q="USD"

case "$sp" in
  "1w") y_range="7d"; y_interval="1h" ;;
  "1m") y_range="1mo"; y_interval="1d" ;;
  "3m") y_range="3mo"; y_interval="1d" ;;
  "6m") y_range="6mo"; y_interval="1d" ;;
  "1y") y_range="1y"; y_interval="1wk" ;;
  "5y") y_range="5y"; y_interval="1mo" ;;
  *) y_range="1mo"; y_interval="1d" ;;
esac

# 1. Fetch live rate, previous close & historical points from Yahoo Finance chart
res=$(curl -sf -m 6 -H "User-Agent: Mozilla/5.0" "https://query1.finance.yahoo.com/v8/finance/chart/${sym}=X?range=${y_range}&interval=${y_interval}")

if [ -n "$res" ] && echo "$res" | jq -e '.chart.result[0].meta.regularMarketPrice' >/dev/null 2>&1; then
  echo "$res" | jq -c --arg sym "$sym" --arg b "$b" --arg q "$q" '
    .chart.result[0] as $r |
    ($r.meta.regularMarketPrice) as $price |
    ($r.meta.chartPreviousClose // $price) as $prev |
    ($r.meta.regularMarketTime // 0) as $time |
    ([$r.indicators.quote[0].close[]? | select(. != null and . > 0)] + [$price]) as $pts |
    ($pts | min) as $min_p |
    ($pts | max) as $max_p |
    ($price - $prev) as $chg |
    (if $prev > 0 then ($chg / $prev * 100) else 0 end) as $pct |
    ($pts[-6] // $pts[0]) as $p_w |
    ($pts[-22] // $pts[0]) as $p_m |
    $pts[0] as $p_y |
    (if $p_w > 0 then (($price - $p_w) / $p_w * 100) else 0 end) as $w |
    (if $p_m > 0 then (($price - $p_m) / $p_m * 100) else 0 end) as $m |
    (if $p_y > 0 then (($price - $p_y) / $p_y * 100) else 0 end) as $y |
    {
      symbol: $sym,
      base_currency: $b,
      quote_currency: $q,
      price: $price,
      change: $chg,
      percent_change: $pct,
      weekly: $w,
      monthly: $m,
      ytd: $y,
      points: $pts,
      min: $min_p,
      max: $max_p,
      direction: (if $chg > 0 then "positive" elif $chg < 0 then "negative" else "neutral" end),
      date: (if $time > 0 then ($time | todateiso8601[:10]) else "Live" end)
    }
  '
  exit 0
fi

# 2. Fallback to Frankfurter if Yahoo is unavailable
fres=$(curl -sf -m 6 "https://api.frankfurter.dev/v1/latest?base=${b}&symbols=${q}")
if [ -n "$fres" ] && echo "$fres" | jq -e '.rates' >/dev/null 2>&1; then
  echo "$fres" | jq -c --arg sym "$sym" --arg b "$b" --arg q "$q" '
    (.rates[$q] // 0) as $price |
    {
      symbol: $sym,
      base_currency: $b,
      quote_currency: $q,
      price: $price,
      change: 0,
      percent_change: 0,
      weekly: 0,
      monthly: 0,
      ytd: 0,
      points: [$price, $price],
      min: $price,
      max: $price,
      direction: "neutral",
      date: (.date // "Live")
    }
  '
  exit 0
fi

exit 1
""") every 5m json timeout 10s status

  // 2. Full Live Currency Rates with Filters, Sorting, and Pagination from Frankfurter
  source rates = cmd("set -- ${int(pageNumber)} ${int(pageLimit)} ${sh(sortField)} ${sh(sortDirection)} ${sh(baseFilter)} ${sh(quoteFilter)} ${sh(trendFilter)} ${sh(searchKeyword)} ${sh(pinnedSymbol)}; " + """
pg="${1:-1}"
lim="${2:-20}"
sb="${3:-percent_change}"
ord="${4:-desc}"
b="${5:-}"
q="${6:-}"
dir="${7:-all}"
search="${8:-}"
pin="${9:-USDIDR}"
pin_b="${pin:0:3}"
pin_q="${pin:3:3}"
[ -z "$pin_q" ] && pin_q="IDR"

res=$(curl -sf -m 10 "https://api.frankfurter.dev/v1/$(date +%Y-01-01)..")
if [ -z "$res" ]; then
  exit 1
fi

echo "$res" | jq -c \
  --argjson pg "$pg" \
  --argjson lim "$lim" \
  --arg sb "$sb" \
  --arg ord "$ord" \
  --arg b "$b" \
  --arg q "$q" \
  --arg dir "$dir" \
  --arg search "$search" \
  --arg pin_b "$pin_b" \
  --arg pin_q "$pin_q" '
  (.rates | keys) as $dates |
  ($dates | last) as $d_today |
  ($dates[-2] // $d_today) as $d_yest |
  ($dates[-6] // $dates[0]) as $d_week |
  ($dates[-22] // $dates[0]) as $d_month |
  $dates[0] as $d_ytd |
  (.rates[$d_today] + {"EUR": 1}) as $r_today |
  (.rates[$d_yest] + {"EUR": 1}) as $r_yest |
  (.rates[$d_week] + {"EUR": 1}) as $r_week |
  (.rates[$d_month] + {"EUR": 1}) as $r_month |
  (.rates[$d_ytd] + {"EUR": 1}) as $r_ytd |
  ["IDR", "USD", "EUR", "GBP", "JPY", "SGD"] as $quotes |
  ($r_today | keys) as $all_cur |
  [
    $quotes[] as $q_cur |
    $all_cur[] as $b_cur |
    select($b_cur != $q_cur) |
    ($r_today[$q_cur] / $r_today[$b_cur]) as $p_today |
    ($r_yest[$q_cur] / $r_yest[$b_cur]) as $p_yest |
    ($r_week[$q_cur] / $r_week[$b_cur]) as $p_week |
    ($r_month[$q_cur] / $r_month[$b_cur]) as $p_month |
    ($r_ytd[$q_cur] / $r_ytd[$b_cur]) as $p_ytd |
    ($p_today - $p_yest) as $chg |
    (if $p_yest > 0 then ($chg / $p_yest * 100) else 0 end) as $pct |
    (if $p_week > 0 then (($p_today - $p_week) / $p_week * 100) else 0 end) as $w |
    (if $p_month > 0 then (($p_today - $p_month) / $p_month * 100) else 0 end) as $m |
    (if $p_ytd > 0 then (($p_today - $p_ytd) / $p_ytd * 100) else 0 end) as $y |
    {
      symbol: "\($b_cur)\($q_cur)",
      base: $b_cur,
      quote: $q_cur,
      group: (if ($b_cur == "USD" or $b_cur == "EUR" or $b_cur == "GBP" or $b_cur == "JPY") then "Major" elif ($b_cur == "IDR" or $b_cur == "SGD" or $b_cur == "MYR" or $b_cur == "THB" or $b_cur == "PHP") then "Asia" else "Lainnya" end),
      price: $p_today,
      change: $chg,
      pct: $pct,
      weekly: $w,
      monthly: $m,
      ytd: $y,
      direction: (if $chg > 0 then "positive" elif $chg < 0 then "negative" else "neutral" end),
      date: $d_today
    }
  ] as $all_pairs |
  ($all_pairs | map(select(.base == $pin_b and .quote == $pin_q)) | first // null) as $pin_item |
  ($all_pairs |
    (if $search != "" then map(select((.symbol | test($search; "i")) or (.base | test($search; "i")) or (.quote | test($search; "i")))) else . end) |
    (if $b != "" then map(select(.base == ($b | ascii_upcase))) else . end) |
    (if $q != "" then map(select(.quote == ($q | ascii_upcase))) else . end) |
    (if $dir != "all" then map(select(.direction == $dir)) else . end) |
    (if $sb == "price" then (if $ord == "asc" then sort_by(.price) else (sort_by(.price) | reverse) end)
     elif $sb == "weekly" then (if $ord == "asc" then sort_by(.weekly) else (sort_by(.weekly) | reverse) end)
     elif $sb == "symbol" then (if $ord == "asc" then sort_by(.symbol) else (sort_by(.symbol) | reverse) end)
     else (if $ord == "asc" then sort_by(.pct) else (sort_by(.pct) | reverse) end)
     end)
  ) as $filtered |
  ($filtered | length) as $total_rates |
  ([(($total_rates + $lim - 1) / $lim | floor), 1] | max) as $total_pages |
  ($filtered[($pg - 1) * $lim : $pg * $lim]) |
  to_entries | map({
    id: "\(.value.symbol)_\(.key)",
    symbol: .value.symbol,
    base: .value.base,
    quote: .value.quote,
    group: .value.group,
    price: .value.price,
    change: .value.change,
    pct: .value.pct,
    weekly: .value.weekly,
    monthly: .value.monthly,
    ytd: .value.ytd,
    yoy: 0,
    direction: .value.direction,
    date: .value.date
  }) |
  {
    items: .,
    page: $pg,
    total_pages: $total_pages,
    total_rates: $total_rates,
    pinned: $pin_item
  }
'
""") every 10m json timeout 25s status

  // 3. Official Currency Names from Frankfurter API
  source filters = cmd("""
curl -sf "https://api.frankfurter.dev/v1/currencies" | jq -c 'to_entries | map({code: .key, name: .value})'
""") every 6h json status

  // Derived expressions
  let isFetchingRates = rates != null && rates.status == "fetching"
  let ratesData = rates == null ? null : (rates.out ?? null)
  let ratesList = ratesData == null ? [] : (ratesData.items ?? [])
  let totalPages = ratesData == null ? max(1, pageNumber) : max(1, ratesData.total_pages ?? 1)
  let totalRates = ratesData == null ? 0 : (ratesData.total_rates ?? 0)

  let d = cur == null ? null : (cur.out ?? null)

  // Pasangan yang Dilihat di Modal Detail vs Terpasang di Layar Utama
  let viewSymbol = selectedSymbol != "" ? selectedSymbol : pinnedSymbol
  let viewBase = len(viewSymbol) >= 6 ? sub(viewSymbol, 0, 3) : (d != null ? (d.base_currency ?? viewSymbol) : viewSymbol)
  let viewQuote = len(viewSymbol) >= 6 ? sub(viewSymbol, 3, 6) : (d != null ? (d.quote_currency ?? "") : "")
  let reversedSymbol = len(viewSymbol) >= 6 ? "${sub(viewSymbol, 3, 6)}${sub(viewSymbol, 0, 3)}" : viewSymbol
  let isPinned = viewSymbol == pinnedSymbol

  let pinnedBase = len(pinnedSymbol) >= 6 ? sub(pinnedSymbol, 0, 3) : pinnedSymbol
  let pinnedQuote = len(pinnedSymbol) >= 6 ? sub(pinnedSymbol, 3, 6) : ""

  let activeItem = find(ratesList, r => r.symbol == viewSymbol)
  let pinnedItem = find(ratesList, r => r.symbol == pinnedSymbol)
  let isCurrentPair = d != null && (d.symbol == viewSymbol || (d.base_currency == viewBase && d.quote_currency == viewQuote))

  // Data Modal Detail (Interaktif)
  let curPrice = isCurrentPair ? d.price : (activeItem != null ? activeItem.price : 0)
  let curChange = isCurrentPair ? d.change : (activeItem != null ? activeItem.change : 0)
  let curPct = isCurrentPair ? d.percent_change : (activeItem != null ? activeItem.pct : 0)
  let curDir = isCurrentPair ? (d.direction ?? (d.change > 0 ? "positive" : d.change < 0 ? "negative" : "neutral")) : (activeItem != null ? (activeItem.direction ?? (activeItem.change > 0 ? "positive" : activeItem.change < 0 ? "negative" : "neutral")) : "neutral")
  let curDate = isCurrentPair ? (d.date ?? "Feed Pasar") : (activeItem != null ? (activeItem.date ?? "Feed Pasar") : "Memuat…")
  let curWeekly = isCurrentPair ? d.weekly : (activeItem != null ? activeItem.weekly : 0)
  let curMonthly = isCurrentPair ? d.monthly : (activeItem != null ? activeItem.monthly : 0)
  let curYtd = isCurrentPair ? d.ytd : (activeItem != null ? activeItem.ytd : 0)

  let isUp = curDir == "positive" || curChange > 0
  let isDown = curDir == "negative" || curChange < 0
  let chgColor = isUp ? green : isDown ? red : muted
  let chgSign = isUp ? "+" : ""
  let chgArrow = isUp ? "▲" : isDown ? "▼" : "•"

  let bCur = viewBase
  let qCur = viewQuote
  let pairTitle = "${bCur} / ${qCur}"
  let viewTitle = pairTitle

  let filterList = filters == null ? [] : (filters.out ?? [])
  let bMeta = find(filterList, f => f.code == bCur)
  let qMeta = find(filterList, f => f.code == qCur)
  let bName = bMeta != null ? bMeta.name : bCur
  let qName = qMeta != null ? qMeta.name : qCur
  let fullPairName = "${bName} ke ${qName}"
  let fullViewName = fullPairName

  // Dynamic price & change formatting based on quote currency (Modal)
  let qSym = qCur == "IDR" ? "Rp " : qCur == "USD" ? "$ " : qCur == "EUR" ? "€ " : qCur == "GBP" ? "£ " : qCur == "JPY" ? "¥ " : ""
  let priceStr = curPrice == 0 ? "…" : qCur == "IDR" ? "Rp ${round(curPrice)}" : curPrice >= 100 ? "${qSym}${fixed(curPrice, 2)}" : curPrice < 0.001 ? "${qSym}${fixed(curPrice, 6)}" : "${qSym}${fixed(curPrice, 4)}"
  let chgVal = curChange == 0 ? "0" : qCur == "IDR" ? "${round(curChange, 2)}" : curChange >= 1 || curChange <= -1 ? "${fixed(curChange, 2)}" : abs(curChange) < 0.001 ? "${fixed(curChange, 6)}" : "${fixed(curChange, 4)}"
  let chgStr = curPrice == 0 ? "…" : "${chgArrow} ${chgSign}${chgVal} (${chgSign}${fixed(curPct, 2)}%)"

  let pts = isCurrentPair && d.points != null ? d.points : []
  let rawMin = isCurrentPair ? d.min : null
  let rawMax = isCurrentPair ? d.max : null
  let maxStr = rawMax == null ? "…" : qCur == "IDR" ? "H: ${round(rawMax)}" : rawMax >= 100 ? "H: ${fixed(rawMax, 2)}" : rawMax < 0.001 ? "H: ${fixed(rawMax, 6)}" : "H: ${fixed(rawMax, 4)}"
  let minStr = rawMin == null ? "…" : qCur == "IDR" ? "L: ${round(rawMin)}" : rawMin >= 100 ? "L: ${fixed(rawMin, 2)}" : rawMin < 0.001 ? "L: ${fixed(rawMin, 6)}" : "L: ${fixed(rawMin, 4)}"
  let maxValStr = rawMax == null ? "…" : qCur == "IDR" ? "Rp ${round(rawMax)}" : rawMax >= 100 ? "${qSym}${fixed(rawMax, 2)}" : rawMax < 0.001 ? "${qSym}${fixed(rawMax, 6)}" : "${qSym}${fixed(rawMax, 4)}"
  let minValStr = rawMin == null ? "…" : qCur == "IDR" ? "Rp ${round(rawMin)}" : rawMin >= 100 ? "${qSym}${fixed(rawMin, 2)}" : rawMin < 0.001 ? "${qSym}${fixed(rawMin, 6)}" : "${qSym}${fixed(rawMin, 4)}"

  // Data Terkunci untuk Tile Homescreen (Selalu Menampilkan Pasangan Terpasang)
  let pinnedRate = ratesData == null ? null : (ratesData.pinned ?? null)
  let tilePrice = (d != null && d.symbol == pinnedSymbol) ? d.price : (pinnedRate != null ? pinnedRate.price : (pinnedItem != null ? pinnedItem.price : 0))
  let tileChange = (d != null && d.symbol == pinnedSymbol) ? d.change : (pinnedRate != null ? pinnedRate.change : (pinnedItem != null ? pinnedItem.change : 0))
  let tilePct = (d != null && d.symbol == pinnedSymbol) ? d.percent_change : (pinnedRate != null ? pinnedRate.pct : (pinnedItem != null ? pinnedItem.pct : 0))
  let tileDir = (d != null && d.symbol == pinnedSymbol) ? (d.direction ?? (d.change > 0 ? "positive" : d.change < 0 ? "negative" : "neutral")) : (pinnedRate != null ? pinnedRate.direction : (pinnedItem != null ? (pinnedItem.direction ?? "neutral") : "neutral"))
  let tileWeekly = (d != null && d.symbol == pinnedSymbol) ? d.weekly : (pinnedRate != null ? pinnedRate.weekly : (pinnedItem != null ? pinnedItem.weekly : 0))
  let tileMonthly = (d != null && d.symbol == pinnedSymbol) ? d.monthly : (pinnedRate != null ? pinnedRate.monthly : (pinnedItem != null ? pinnedItem.monthly : 0))
  let tileYtd = (d != null && d.symbol == pinnedSymbol) ? d.ytd : (pinnedRate != null ? pinnedRate.ytd : (pinnedItem != null ? pinnedItem.ytd : 0))
  let tilePts = (d != null && d.symbol == pinnedSymbol && d.points != null) ? d.points : []
  let tileMin = (d != null && d.symbol == pinnedSymbol) ? d.min : null
  let tileMax = (d != null && d.symbol == pinnedSymbol) ? d.max : null

  let tileUp = tileDir == "positive" || tileChange > 0
  let tileDown = tileDir == "negative" || tileChange < 0
  let tileColor = tileUp ? green : tileDown ? red : muted
  let tileSign = tileUp ? "+" : ""
  let tileArrow = tileUp ? "▲" : tileDown ? "▼" : "•"

  let pBMeta = find(filterList, f => f.code == pinnedBase)
  let pQMeta = find(filterList, f => f.code == pinnedQuote)
  let pBName = pBMeta != null ? pBMeta.name : pinnedBase
  let pQName = pQMeta != null ? pQMeta.name : pinnedQuote
  let fullPinnedName = "${pBName} ke ${pQName}"
  let tileTitle = "${pinnedBase} / ${pinnedQuote}"

  let tQSym = pinnedQuote == "IDR" ? "Rp " : pinnedQuote == "USD" ? "$ " : pinnedQuote == "EUR" ? "€ " : pinnedQuote == "GBP" ? "£ " : pinnedQuote == "JPY" ? "¥ " : ""
  let tilePriceStr = tilePrice == 0 ? "…" : pinnedQuote == "IDR" ? "Rp ${round(tilePrice)}" : tilePrice >= 100 ? "${tQSym}${fixed(tilePrice, 2)}" : tilePrice < 0.001 ? "${tQSym}${fixed(tilePrice, 6)}" : "${tQSym}${fixed(tilePrice, 4)}"
  let tileChgVal = tileChange == 0 ? "0" : pinnedQuote == "IDR" ? "${round(tileChange, 2)}" : tileChange >= 1 || tileChange <= -1 ? "${fixed(tileChange, 2)}" : abs(tileChange) < 0.001 ? "${fixed(tileChange, 6)}" : "${fixed(tileChange, 4)}"
  let tileChgStr = tilePrice == 0 ? "…" : "${tileArrow} ${tileSign}${tileChgVal} (${tileSign}${fixed(tilePct, 2)}%)"
  let tileMaxStr = tileMax == null ? "…" : pinnedQuote == "IDR" ? "H: ${round(tileMax)}" : tileMax >= 100 ? "H: ${fixed(tileMax, 2)}" : tileMax < 0.001 ? "H: ${fixed(tileMax, 6)}" : "H: ${fixed(tileMax, 4)}"
  let tileMinStr = tileMin == null ? "…" : pinnedQuote == "IDR" ? "L: ${round(tileMin)}" : tileMin >= 100 ? "L: ${fixed(tileMin, 2)}" : tileMin < 0.001 ? "L: ${fixed(tileMin, 6)}" : "L: ${fixed(tileMin, 4)}"


  component StatItem(label, val, c = foreground) {
    Column {
      weight: 1
      gap: 1
      Text { text: label; fontSize: 9; color: muted; maxLines: 1 }
      Text { text: val; fontSize: 10; bold: true; color: c; maxLines: 1 }
    }
  }

  component MiniMetric(label, val, c = foreground) {
    Box {
      weight: 1
      padding: [8, 8]
      radius: 6 * corners
      background: alpha(surface, 0.6)
      border: 1
      borderColor: alpha(border, 0.25)
      Column {
        align: center
        gap: 2
        Text { text: label; fontSize: 10; color: muted; align: center; maxLines: 1 }
        Text { text: val; fontSize: 12; bold: true; color: c; align: center; maxLines: 1 }
      }
    }
  }

  onTap: {
    selectedSymbol = ""
    screen()
  }

  // Main Tile Layout (Wide 6 columns)
  Column {
    gap: 8
    fill: true

    // Top Section: Info (Left) + Custom Theme Transparent Chart (Right)
    Row {
      gap: 10
      fill: width
      weight: 1

      // Left Column: Currency Pair Header, Price, Change Badge, Mini Stats
      Column {
        weight: 1
        fill: height
        justify: spaceBetween

        Column {
          gap: 2

          Text {
            text: tileTitle
            fontSize: 20
            bold: true
            color: foreground
          }

          Text {
            text: fullPinnedName
            fontSize: 10
            style: muted
            maxLines: 1
          }

          Text {
            text: tilePriceStr
            fontSize: 22
            bold: true
            color: foreground
          }

          Row {
            Box {
              padding: [6, 2]
              radius: 4 * corners
              background: alpha(tileColor, 0.15)
              border: 1
              borderColor: alpha(tileColor, 0.35)
              Text {
                text: tileChgStr
                fontSize: 10
                bold: true
                color: tileColor
              }
            }
          }
        }

        // Mini Stats row
        if tilePrice > 0 {
          Row {
            gap: 6
            fill: width
            StatItem { label: "1W"; val: "${tileWeekly >= 0 ? '+' : ''}${fixed(tileWeekly, 2)}%"; c: tileWeekly >= 0 ? green : red }
            StatItem { label: "1M"; val: "${tileMonthly >= 0 ? '+' : ''}${fixed(tileMonthly, 2)}%"; c: tileMonthly >= 0 ? green : red }
            StatItem { label: "YTD"; val: "${tileYtd >= 0 ? '+' : ''}${fixed(tileYtd, 2)}%"; c: tileYtd >= 0 ? green : red }
          }
        }
      }

      // Right Section: Custom Theme Transparent Chart (NO PHOTO / NO IMAGE)
      Box {
        weight: 1.25
        fill: height
        padding: [6, 6]
        radius: 8 * corners
        background: alpha(surface, 0.45)
        border: 1
        borderColor: alpha(border, 0.35)
        clip: true

        Column {
          fill: true
          justify: spaceBetween

          // Top Header: High Price + Fixed-width Span Pill
          Row {
            fill: width
            align: center
            Text {
              text: tileMaxStr
              fontSize: 9
              color: muted
              weight: 1
            }
            Box {
              width: 26
              height: 15
              align: center
              radius: 3 * corners
              background: alpha(accent, 0.2)
              Text {
                text: upper(timeSpan)
                fontSize: 9
                bold: true
                align: center
                color: accent
              }
            }
          }

          // Custom Native Sparkline Chart (Theme Colors, Transparent Area Fill)
          if count(tilePts) > 1 {
            Sparkline {
              values: tilePts
              min: tileMin
              max: tileMax
              color: tileColor
              area: alpha(tileColor, 0.2)
              thickness: 2.2
              weight: 1
              fill: width
            }
          } else {
            Box {
              weight: 1
              fill: width
              align: center
              Text { text: "memuat grafik…"; fontSize: 10; color: muted }
            }
          }

          // Bottom Header: Low Price + Fixed-width Direction
          Row {
            fill: width
            align: center
            Text {
              text: tileMinStr
              fontSize: 9
              color: muted
              weight: 1
            }
            Text {
              text: upper(tileDir)
              fontSize: 9
              bold: true
              color: tileColor
              width: 55
              align: end
            }
          }
        }
      }
    }

    // Bottom Section: Pinned Status & Launcher Touch Hint (No accidental taps!)
    Row {
      fill: width
      align: center

      Text {
        text: "TERPASANG: ${pinnedBase}/${pinnedQuote} • Live Pasar"
        fontSize: 9.5
        bold: true
        color: muted
        weight: 1
        maxLines: 1
      }

      Text {
        text: "Ketuk untuk 167+ kurs ↗"
        fontSize: 9.5
        bold: true
        color: accent
        width: 150
        align: end
        maxLines: 1
      }
    }
  }

  // Full-screen Modal Detail
  screen {
    title: "Kurs Valas • ${bCur}/${qCur}"

    Column {
      scroll: true
      gap: 10
      padding: [12, 12]
      fill: width

      // Card 1: Active Currency Pair Hero & Interactive Real-Time Chart
      Box {
        fill: width
        background: alpha(surface, 0.7)
        radius: 10 * corners
        padding: 12
        border: 1
        borderColor: border

        Column {
          fill: width
          gap: 10

          // Top Header: Title, Subtitle, Pin Action & Swap Button
          Row {
            align: center
            fill: width
            justify: spaceBetween
            gap: 8

            Column {
              weight: 1
              gap: 2
              Text { text: viewTitle; style: title; bold: true }
              Text { text: fullViewName; fontSize: 11; color: muted; maxLines: 1 }
            }

            Row {
              gap: 6
              align: center

              // Pin to Homescreen Action Button or Active Indicator
              if viewSymbol == pinnedSymbol {
                Box {
                  width: 95
                  height: 28
                  radius: 4 * corners
                  background: alpha(green, 0.2)
                  border: 1
                  borderColor: green
                  align: center
                  Text { text: "✓ Terpasang"; fontSize: 9.5; bold: true; color: green; align: center; maxLines: 1 }
                }
              } else {
                Box {
                  width: 95
                  height: 28
                  radius: 4 * corners
                  background: accent
                  border: 1
                  borderColor: accent
                  align: center
                  onTap: {
                    pinnedSymbol = viewSymbol
                    selectedSymbol = ""
                  }
                  Text { text: "⭐ Pasang"; fontSize: 10; bold: true; color: background; align: center; maxLines: 1 }
                }
              }

              // Swap Base ⇄ Quote Button
              Box {
                width: 65
                height: 28
                radius: 4 * corners
                background: alpha(surface, 0.9)
                border: 1
                borderColor: alpha(border, 0.4)
                align: center
                onTap: {
                  selectedSymbol = (reversedSymbol == pinnedSymbol) ? "" : reversedSymbol
                }
                Text { text: "⇄ Balik"; fontSize: 10; bold: true; color: foreground; align: center; maxLines: 1 }
              }
            }
          }

          // Price & Change Overview
          Row {
            align: center
            fill: width

            Column {
              weight: 1
              gap: 2
              Text {
                text: priceStr
                fontSize: curPrice < 0.001 ? 19 : 24
                bold: true
                color: foreground
                maxLines: 1
              }
              Text {
                text: "1 ${bCur} = ${priceStr} ${qCur} • ${curDate}"
                fontSize: 10
                color: muted
              }
            }

            Box {
              width: 140
              padding: [8, 6]
              radius: 5 * corners
              background: alpha(chgColor, 0.15)
              border: 1
              borderColor: alpha(chgColor, 0.3)
              align: center
              Column {
                align: center
                gap: 1
                Text { text: chgStr; bold: true; color: chgColor; fontSize: 12 }
                Text { text: "Perubahan 24 Jam"; fontSize: 8; color: muted }
              }
            }
          }

          // Span Selector & High / Low summary
          Row {
            justify: spaceBetween
            align: center
            fill: width
            Text {
              text: "Rentang: ${upper(timeSpan)} • H: ${maxValStr} • L: ${minValStr}"
              fontSize: 10
              color: muted
              weight: 1
            }
          }

          Row {
            gap: 5
            fill: width
            for s in ["1w", "1m", "3m", "6m", "1y", "5y"] key s {
              Box {
                weight: 1
                padding: [6, 4]
                radius: 4 * corners
                background: timeSpan == s ? accent : alpha(background, 0.6)
                border: 1
                borderColor: timeSpan == s ? accent : alpha(border, 0.3)
                align: center
                onTap: timeSpan = s
                Text {
                  text: upper(s)
                  fontSize: 11
                  bold: timeSpan == s
                  align: center
                  color: timeSpan == s ? background : foreground
                }
              }
            }
          }

          // Native Transparent Sparkline Chart
          Box {
            height: 125
            fill: width
            padding: [8, 6]
            radius: 8 * corners
            background: alpha(background, 0.45)
            border: 1
            borderColor: alpha(border, 0.3)

            if count(pts) > 1 {
              Sparkline {
                values: pts
                min: rawMin
                max: rawMax
                color: chgColor
                area: alpha(chgColor, 0.22)
                thickness: 2.8
                fill: true
              }
            } else {
              Box {
                fill: true
                align: center
                Text { text: "memuat grafik…"; fontSize: 12; color: muted; align: center }
              }
            }
          }

          // Integrated Performance Stats (2x2 Grid with generous space)
          if curPrice > 0 {
            Column {
              gap: 6
              fill: width

              Row {
                gap: 6
                fill: width
                MiniMetric { label: "1 Minggu (Weekly)"; val: "${curWeekly >= 0 ? '+' : ''}${fixed(curWeekly, 2)}%"; c: curWeekly >= 0 ? green : red }
                MiniMetric { label: "1 Bulan (Monthly)"; val: "${curMonthly >= 0 ? '+' : ''}${fixed(curMonthly, 2)}%"; c: curMonthly >= 0 ? green : red }
              }

              Row {
                gap: 6
                fill: width
                MiniMetric { label: "Tahun Ini (YTD)"; val: "${curYtd >= 0 ? '+' : ''}${fixed(curYtd, 2)}%"; c: curYtd >= 0 ? green : red }
                MiniMetric { label: "Tren Pasar"; val: isUp ? "▲ NAIK" : isDown ? "▼ TURUN" : "NETRAL"; c: chgColor }
              }
            }
          }

          // Quick Popular Forex Pairs Switcher (2 rows of 3, comfortable touch targets)
          Column {
            gap: 5
            fill: width

            Text { text: "Pasangan Populer:"; fontSize: 10; color: muted; maxLines: 1 }

            Row {
              gap: 6
              fill: width
              for p in ["USDIDR", "EURUSD", "USDJPY"] key p {
                let isSel = viewSymbol == p
                let b = sub(p, 0, 3)
                let q = sub(p, 3, 6)
                Box {
                  weight: 1
                  height: 30
                  radius: 5 * corners
                  background: isSel ? accent : alpha(surface, 0.8)
                  border: 1
                  borderColor: isSel ? accent : alpha(border, 0.3)
                  align: center
                  onTap: {
                    selectedSymbol = (p == pinnedSymbol) ? "" : p
                  }
                  Text {
                    text: "${b} / ${q}"
                    fontSize: 10.5
                    bold: isSel
                    color: isSel ? background : foreground
                    align: center
                    maxLines: 1
                  }
                }
              }
            }

            Row {
              gap: 6
              fill: width
              for p in ["GBPIDR", "SGDIDR", "EURIDR"] key p {
                let isSel = viewSymbol == p
                let b = sub(p, 0, 3)
                let q = sub(p, 3, 6)
                Box {
                  weight: 1
                  height: 30
                  radius: 5 * corners
                  background: isSel ? accent : alpha(surface, 0.8)
                  border: 1
                  borderColor: isSel ? accent : alpha(border, 0.3)
                  align: center
                  onTap: {
                    selectedSymbol = (p == pinnedSymbol) ? "" : p
                  }
                  Text {
                    text: "${b} / ${q}"
                    fontSize: 10.5
                    bold: isSel
                    color: isSel ? background : foreground
                    align: center
                    maxLines: 1
                  }
                }
              }
            }
          }
        }
      }

      // Card 2: Full Live Currency Exchange Rates with Filters, Sorting & Pagination
      Box {
        fill: width
        background: alpha(surface, 0.7)
        radius: 10 * corners
        padding: 12
        border: 1
        borderColor: border

        Column {
          fill: width
          gap: 10

          // Title & Total Info
          Row {
            align: center
            fill: width
            Text {
              text: "Daftar Kurs Valas"
              style: label
              weight: 1
            }
            Text {
              text: "${totalRates} Pasangan"
              fontSize: 10
              color: muted
              width: 100
              align: end
            }
          }

          // Reset Filter Banner (Shown whenever search or filters are active)
          if searchKeyword != "" || baseFilter != "" || quoteFilter != "" || trendFilter != "all" {
            Box {
              fill: width
              padding: [8, 6]
              radius: 6 * corners
              background: alpha(accent, 0.15)
              border: 1
              borderColor: alpha(accent, 0.4)
              onTap: {
                searchKeyword = ""
                baseFilter = ""
                quoteFilter = ""
                trendFilter = "all"
                pageNumber = 1
              }
              Row {
                align: center
                justify: spaceBetween
                fill: width
                Text {
                  text: "🔍 Filter aktif (${totalRates} hasil) • Ketuk untuk Reset"
                  fontSize: 10
                  bold: true
                  color: accent
                  weight: 1
                }
                Text {
                  text: "Tampilkan Semua ✕"
                  fontSize: 10
                  bold: true
                  color: accent
                  width: 120
                  align: end
                }
              }
            }
          }

          // Search Box with Reset Button
          Row {
            gap: 6
            fill: width
            align: center

            Input {
              text: searchKeyword
              placeholder: "Cari pair atau mata uang (USD, IDR, JPY, EUR)..."
              weight: 1
              onSubmit: {
                searchKeyword = trim(value)
                pageNumber = 1
              }
            }

            if searchKeyword != "" {
              Box {
                padding: [8, 8]
                radius: 4 * corners
                background: alpha(red, 0.2)
                border: 1
                borderColor: red
                align: center
                onTap: {
                  searchKeyword = ""
                  pageNumber = 1
                }
                Text { text: "Reset ✕"; fontSize: 10; bold: true; color: red }
              }
            }
          }

          // Filter: Quote Currency Tabs (Tujuan)
          Column {
            gap: 4
            fill: width
            Text { text: "Filter Kurs Tujuan (Quote):"; fontSize: 10; color: muted; maxLines: 1 }
            Row {
              gap: 4
              fill: width
              for q in ["", "idr", "usd", "eur", "gbp", "jpy", "sgd"] key q {
                let isSel = quoteFilter == q
                let lbl = q == "" ? "ALL" : upper(q)
                Box {
                  weight: 1
                  height: 28
                  radius: 4 * corners
                  background: isSel ? accent : alpha(surface, 0.8)
                  border: 1
                  borderColor: isSel ? accent : alpha(border, 0.25)
                  align: center
                  onTap: { quoteFilter = q; pageNumber = 1 }
                  Text { text: lbl; fontSize: 9.5; bold: isSel; color: isSel ? background : foreground; align: center; maxLines: 1 }
                }
              }
            }
          }

          // Sort Fields Row
          Column {
            gap: 4
            fill: width
            Text { text: "Urutkan Data Kurs:"; fontSize: 10; color: muted; maxLines: 1 }
            Row {
              gap: 5
              fill: width
              for sf in ["percent_change", "price", "weekly", "symbol"] key sf {
                let isSel = sortField == sf
                let sLabel = sf == "percent_change" ? "% Berubah" : sf == "price" ? "Harga" : sf == "weekly" ? "1 Minggu" : "Simbol"
                Box {
                  weight: 1
                  height: 28
                  radius: 4 * corners
                  background: isSel ? accent : alpha(surface, 0.8)
                  border: 1
                  borderColor: isSel ? accent : alpha(border, 0.25)
                  align: center
                  onTap: { sortField = sf; pageNumber = 1 }
                  Text { text: sLabel; fontSize: 9.5; bold: isSel; color: isSel ? background : foreground; align: center; maxLines: 1 }
                }
              }
            }
          }

          // Order, Trend Direction & Limit Row
          Row {
            gap: 6
            fill: width
            align: center

            // Order Toggle (DESC / ASC)
            Box {
              weight: 1
              height: 28
              padding: [4, 6]
              radius: 4 * corners
              background: alpha(accent, 0.2)
              border: 1
              borderColor: accent
              align: center
              onTap: { sortDirection = sortDirection == "desc" ? "asc" : "desc"; pageNumber = 1 }
              Text {
                text: sortDirection == "desc" ? "▼ Urut: DESC" : "▲ Urut: ASC"
                fontSize: 10
                bold: true
                color: accent
                align: center
                maxLines: 1
              }
            }

            // Direction Filter Toggle (Semua, Naik, Turun)
            Box {
              weight: 1
              height: 28
              padding: [4, 6]
              radius: 4 * corners
              background: trendFilter == "all" ? alpha(surface, 0.8) : trendFilter == "positive" ? alpha(green, 0.25) : alpha(red, 0.25)
              border: 1
              borderColor: trendFilter == "all" ? alpha(border, 0.3) : trendFilter == "positive" ? green : red
              align: center
              onTap: { trendFilter = trendFilter == "all" ? "positive" : trendFilter == "positive" ? "negative" : "all"; pageNumber = 1 }
              Text {
                text: trendFilter == "all" ? "Tren: Semua" : trendFilter == "positive" ? "▲ Hanya Naik" : "▼ Hanya Turun"
                fontSize: 10
                bold: true
                color: trendFilter == "positive" ? green : trendFilter == "negative" ? red : foreground
                align: center
                maxLines: 1
              }
            }

            // Limit pills
            Row {
              gap: 3
              align: center
              for lim in [10, 20, 50] key lim {
                Box {
                  width: 28
                  height: 26
                  radius: 4 * corners
                  background: pageLimit == lim ? accent : alpha(surface, 0.7)
                  align: center
                  onTap: { pageLimit = lim; pageNumber = 1 }
                  Text {
                    text: "${lim}"
                    fontSize: 9.5
                    bold: pageLimit == lim
                    color: pageLimit == lim ? background : muted
                    align: center
                    maxLines: 1
                  }
                }
              }
            }
          }

          // Sub-Header: Title & Status
          Row {
            justify: spaceBetween
            align: center
            fill: width

            Text {
              text: isFetchingRates ? "Memuat data kurs…" : "Daftar Pasangan Kurs"
              fontSize: 11
              bold: true
              weight: 1
              color: isFetchingRates ? accent : foreground
              maxLines: 1
            }

            Text {
              text: "${totalRates} Total • Hal ${pageNumber}/${totalPages}"
              fontSize: 10
              color: muted
              width: 140
              align: end
              maxLines: 1
            }
          }

          // Currency Exchange Rates List
          if rates == null || (isFetchingRates && ratesData == null) {
            Box {
              padding: 20
              align: center
              Text { text: "Memuat kurs mata uang…"; fontSize: 11; color: muted }
            }
          } else if rates.status == "error" && ratesData == null {
            Box {
              padding: 20
              align: center
              Text { text: "Gagal memuat data kurs dari server. Periksa koneksi internet."; fontSize: 11; color: red }
            }
          } else if count(ratesList) == 0 {
            Box {
              padding: 20
              align: center
              Text { text: "Tidak ada pasangan kurs yang cocok dengan filter."; fontSize: 11; color: muted }
            }
          } else {
            Column {
              gap: 6
              for item in ratesList key item.id {
                let isItemPinned = pinnedSymbol == item.symbol
                let isItemViewing = viewSymbol == item.symbol

                Box {
                  padding: [10, 10]
                  radius: 6 * corners
                  background: isItemViewing ? alpha(accent, 0.18) : isItemPinned ? alpha(green, 0.12) : alpha(background, 0.5)
                  border: 1
                  borderColor: isItemViewing ? accent : isItemPinned ? alpha(green, 0.6) : alpha(border, 0.25)
                  onTap: {
                    selectedSymbol = (item.symbol == pinnedSymbol) ? "" : item.symbol
                  }

                  Column {
                    gap: 6
                    fill: width

                    // Baris 1: Simbol & Kategori (Kiri), Harga & % (Kanan)
                    Row {
                      align: center
                      fill: width

                      Row {
                        align: center
                        gap: 6
                        weight: 1

                        Text {
                          text: "${item.base} / ${item.quote}"
                          bold: true
                          fontSize: 13
                          color: foreground
                          maxLines: 1
                        }

                        Box {
                          padding: [3, 2]
                          radius: 3 * corners
                          background: alpha(surface, 0.8)
                          Text { text: item.group; fontSize: 8; color: muted; maxLines: 1 }
                        }

                        if isItemPinned {
                          Box {
                            padding: [3, 3]
                            radius: 3 * corners
                            background: alpha(green, 0.25)
                            border: 1
                            borderColor: green
                            Text { text: "⭐ TERPASANG"; fontSize: 8; bold: true; color: green; maxLines: 1 }
                          }
                        }

                        if isItemViewing && !isItemPinned {
                          Box {
                            padding: [3, 3]
                            radius: 3 * corners
                            background: alpha(accent, 0.2)
                            border: 1
                            borderColor: accent
                            Text { text: "DILIHAT"; fontSize: 8; bold: true; color: accent; maxLines: 1 }
                          }
                        }
                      }

                      Row {
                        align: center
                        justify: end
                        width: 160
                        gap: 6

                        Text {
                          text: item.quote == "IDR" ? "Rp ${round(item.price)}" : item.price >= 100 ? "${fixed(item.price, 2)} ${item.quote}" : item.price < 0.001 ? "${fixed(item.price, 6)} ${item.quote}" : "${fixed(item.price, 4)} ${item.quote}"
                          bold: true
                          font: mono
                          fontSize: 13
                          color: foreground
                          align: end
                          maxLines: 1
                        }

                        Box {
                          padding: [4, 4]
                          radius: 3 * corners
                          background: item.pct > 0 ? alpha(green, 0.2) : item.pct < 0 ? alpha(red, 0.2) : alpha(surface, 0.6)
                          Text {
                            text: "${item.pct >= 0 ? '+' : ''}${fixed(item.pct, 2)}%"
                            fontSize: 9.5
                            bold: true
                            color: item.pct > 0 ? green : item.pct < 0 ? red : muted
                            maxLines: 1
                          }
                        }
                      }
                    }

                    // Baris 2: Indikator Delta, 1W, 1M, YTD
                    Row {
                      justify: spaceBetween
                      align: center
                      fill: width

                      Text {
                        text: "Δ ${item.change >= 0 ? '+' : ''}${item.quote == 'IDR' ? round(item.change, 2) : fixed(item.change, 4)}"
                        fontSize: 9.5
                        style: muted
                        weight: 1
                        maxLines: 1
                      }

                      Row {
                        gap: 8
                        align: center

                        Text {
                          text: "1W ${item.weekly >= 0 ? '+' : ''}${fixed(item.weekly, 1)}%"
                          fontSize: 9.5
                          color: item.weekly > 0 ? green : item.weekly < 0 ? red : muted
                          maxLines: 1
                        }

                        Text {
                          text: "1M ${item.monthly >= 0 ? '+' : ''}${fixed(item.monthly, 1)}%"
                          fontSize: 9.5
                          color: item.monthly > 0 ? green : item.monthly < 0 ? red : muted
                          maxLines: 1
                        }

                        Text {
                          text: "YTD ${item.ytd >= 0 ? '+' : ''}${fixed(item.ytd, 1)}%"
                          fontSize: 9.5
                          color: item.ytd > 0 ? green : item.ytd < 0 ? red : muted
                          maxLines: 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }

          // Pagination Controls Bar (Paging)
          Box {
            padding: 10
            background: alpha(surface, 0.6)
            radius: 8 * corners
            border: 1
            borderColor: alpha(border, 0.25)

            Column {
              gap: 8
              fill: width

              // Baris Utama: Tombol Prev Lebar, Status Halaman di Tengah, Tombol Next Lebar
              Row {
                align: center
                gap: 8
                fill: width

                Box {
                  weight: 1
                  height: 38
                  padding: [10, 4]
                  radius: 5 * corners
                  background: pageNumber > 1 ? accent : alpha(background, 0.3)
                  border: 1
                  borderColor: pageNumber > 1 ? accent : alpha(border, 0.2)
                  align: center
                  onTap: pageNumber = pageNumber > 1 ? pageNumber - 1 : pageNumber
                  Row {
                    align: center
                    justify: center
                    gap: 4
                    Text {
                      text: "◀"
                      fontSize: 11
                      bold: true
                      color: pageNumber > 1 ? background : muted
                    }
                    Text {
                      text: "Sebelumnya"
                      fontSize: 11
                      bold: true
                      color: pageNumber > 1 ? background : muted
                      maxLines: 1
                    }
                  }
                }

                Column {
                  width: 95
                  align: center
                  gap: 1
                  Text {
                    text: isFetchingRates ? "Memuat…" : "Hal ${pageNumber} / ${totalPages}"
                    fontSize: 11.5
                    bold: true
                    align: center
                    color: isFetchingRates ? accent : foreground
                    maxLines: 1
                  }
                  Text {
                    text: "${totalRates} mata uang"
                    fontSize: 9
                    color: muted
                    align: center
                    maxLines: 1
                  }
                }

                Box {
                  weight: 1
                  height: 38
                  padding: [10, 4]
                  radius: 5 * corners
                  background: pageNumber < totalPages ? accent : alpha(background, 0.3)
                  border: 1
                  borderColor: pageNumber < totalPages ? accent : alpha(border, 0.2)
                  align: center
                  onTap: pageNumber = pageNumber < totalPages ? pageNumber + 1 : pageNumber
                  Row {
                    align: center
                    justify: center
                    gap: 4
                    Text {
                      text: "Berikutnya"
                      fontSize: 11
                      bold: true
                      color: pageNumber < totalPages ? background : muted
                      maxLines: 1
                    }
                    Text {
                      text: "▶"
                      fontSize: 11
                      bold: true
                      color: pageNumber < totalPages ? background : muted
                    }
                  }
                }
              }

              // Baris Navigasi Cepat: Lompat ke Halaman Pertama & Terakhir
              Row {
                align: center
                gap: 8
                fill: width

                Box {
                  weight: 1
                  height: 28
                  padding: [6, 2]
                  radius: 4 * corners
                  background: pageNumber > 1 ? alpha(surface, 0.9) : alpha(background, 0.25)
                  border: 1
                  borderColor: alpha(border, 0.2)
                  align: center
                  onTap: pageNumber = pageNumber > 1 ? 1 : pageNumber
                  Text {
                    text: "⏮ Lompat ke Hal 1"
                    fontSize: 9.5
                    color: pageNumber > 1 ? foreground : muted
                    align: center
                    maxLines: 1
                  }
                }

                Box {
                  weight: 1
                  height: 28
                  padding: [6, 2]
                  radius: 4 * corners
                  background: pageNumber < totalPages ? alpha(surface, 0.9) : alpha(background, 0.25)
                  border: 1
                  borderColor: alpha(border, 0.2)
                  align: center
                  onTap: pageNumber = pageNumber < totalPages ? totalPages : pageNumber
                  Text {
                    text: "Lompat ke Hal Akhir (${totalPages}) ⏭"
                    fontSize: 9.5
                    color: pageNumber < totalPages ? foreground : muted
                    align: center
                    maxLines: 1
                  }
                }
              }
            }
          }
        }
      }

      // Action buttons
      Row {
        fill: width
        gap: 8
        Button {
          text: "Segarkan (Refresh)"
          weight: 1
          onTap: refresh()
        }
        Button {
          text: "Tutup"
          weight: 1
          color: muted
          onTap: {
            selectedSymbol = ""
            close()
          }
        }
      }
    }
  }
}
