widget "fizzy" {
  // Your open Fizzy cards (fizzy.do, by 37signals), newest activity first; tap one to open it.
  // Token: Fizzy > your profile > API > Personal access tokens (read + write, to close and add cards).
  // It's typed in on the phone and kept encrypted, never in this file.
  meta { description: "Open cards from your Fizzy boards, with a personal access token kept encrypted on the phone"; version: "1.0.1"; license: "MIT"; category: "dev"; owl: 12 }
  size: 6x5
  minSize: 3x3

  state token = null secret
  // Board name to show, or "" for all boards.
  state board = ""
  // Card numbers closed here, hidden at once: the next fetch may still list them.
  state done = []
  // post's answer: {ok, code, out}. Starts at 0 so the first answer counts as a change.
  state closed = 0
  state reopened = 0
  state problem = ""
  // Only cards assigned to me.
  state mine = false
  // Column id to show, or "" for any column (only with a board picked).
  state col = ""
  state added = 0
  // The card just closed, offered for undo: {number, title}, or null.
  state last = null

  source now = clock every 1m
  source me = http(token == null ? null : "https://app.fizzy.do/my/identity", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 30m json status
  // The account slug comes as "/123456"; the digits go through enc() between fixed path parts.
  let uid = me == null || me.out == null ? null : me.out.accounts[0].user.id
  let acct = me == null || me.out == null ? null : replace(me.out.accounts[0].slug, "/", "")
  source blist = http(acct == null ? null : "https://app.fizzy.do/${enc(acct)}/boards", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 10m json status
  let boards = blist == null || !blist.ok ? [] : blist.out
  let bobj = board == "" ? null : boards.find(b => b.name == board)
  source cols = http(acct == null || bobj == null ? null : "https://app.fizzy.do/${enc(acct)}/boards/${enc(bobj.id)}/columns", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 10m json status
  let colList = bobj == null || cols == null || !cols.ok ? [] : cols.out
  let colObj = col == "" ? null : colList.find(k => k.id == col)
  let colName = colObj == null ? null : colObj.name
  source feed = http(acct == null ? null : mine && uid != null ? (col != "" ? "https://app.fizzy.do/${enc(acct)}/cards?assignee_ids%5B%5D=${enc(uid)}&column_ids%5B%5D=${enc(col)}" : "https://app.fizzy.do/${enc(acct)}/cards?assignee_ids%5B%5D=${enc(uid)}") : (col != "" ? "https://app.fizzy.do/${enc(acct)}/cards?column_ids%5B%5D=${enc(col)}" : "https://app.fizzy.do/${enc(acct)}/cards"), {Authorization: "Bearer ${token}", Accept: "application/json"}) every 2m json status
  let all = feed == null || !feed.ok ? [] : feed.out.filter(c => !contains(done, c.number))
  let cards = bobj == null ? all : all.filter(c => c.board.id == bobj.id)
  let status = token == null ? "" : me == null ? "loading…" : me.code == 401 ? "Fizzy doesn't take this token" : feed == null ? "loading…" : feed.ok ? "${len(cards)} open" : "couldn't load (${feed.code})"

  // A close that failed brings its card back and drops the undo offer.
  on closed {
    problem = value.ok ? "" : value.code == 403 ? "this token can't write: make one with read + write" : "couldn't close it (${value.code})"
    if !value.ok && last != null {
      done = done.filter(n => n != last.number)
      last = null
    }
  }

  on reopened {
    problem = value.ok ? "" : value.code == 403 ? "this token can't write: make one with read + write" : "couldn't undo it (${value.code})"
  }

  on added {
    problem = value.ok ? "" : value.code == 403 ? "this token can't write: make one with read + write" : "couldn't add it (${value.code})"
  }

  onTap: screen()

  // "● Board › Column", tinted by board so each board is recognisable at a glance.
  component Tag(label, seed) {
    Text { text: "● ${label}"; style: small; maxLines: 1; color: [blue, green, magenta, orange, cyan, yellow][int(hash(seed) * 6)] }
  }

  Column {
    gap: 8
    if token == null {
      Text { text: "fizzy"; color: accent; style: title }
      Text { text: "A Fizzy personal access token (profile > API). It's kept encrypted on this phone."; style: small; color: muted; maxLines: 3 }
      Input { placeholder: "token"; password: true; onSubmit: token = trim(value) }
    } else {
      Row {
        gap: 8
        Text { text: "fizzy"; color: accent; style: title }
        Text { text: board != "" && feed != null && feed.ok ? "${board} · ${len(cards)}" : status; style: small; color: (feed != null && !feed.ok) || (me != null && me.code == 401) ? red : muted; weight: 1 }
        Text { text: "sign out"; style: small; color: muted; onTap: { token = null; done = []; last = null; board = ""; col = ""; mine = false; problem = "" } }
      }
      Column {
        scroll: true
        weight: 1
        gap: 6
        if feed != null && feed.ok && len(cards) == 0 { Text { text: "All clear."; style: muted } }
        for c in cards key c.id {
          Column {
            gap: 2
            padding: [10, 8]
            radius: 10
            background: surface
            onTap: url(c.url)
            Row {
              gap: 8
              Tag { label: "${c.board.name}${c.column.name != null ? " › ${c.column.name}" : ""}"; seed: c.board.name; weight: 1 }
              Text { text: fmtAgo(parseTime(c.last_active_at), now); style: small; color: muted }
            }
            Text { text: "#${c.number} ${c.title}"; maxLines: 2 }
          }
        }
      }
    }
  }

  screen {
    title: "fizzy"
    Column {
      gap: 10
      padding: [8, 0]
      Flow {
        gap: 8
        Text { text: "all ${len(all)}"; style: small; padding: [5, 12]; radius: 14; background: board == "" ? accent : surface; color: board == "" ? background : foreground; onTap: { board = ""; col = "" } }
        Text { text: "mine"; style: small; padding: [5, 12]; radius: 14; background: mine ? accent : surface; color: mine ? background : foreground; onTap: mine = !mine }
        for b in boards key b.id {
          Text { text: b.name; style: small; padding: [5, 12]; radius: 14; background: board == b.name ? accent : surface; color: board == b.name ? background : foreground; onTap: { board = b.name; col = "" } }
        }
      }
      if board != "" && (len(colList) > 0 || col != "") {
        Flow {
          gap: 6
          Text { text: "any column"; style: small; padding: [3, 10]; radius: 12; border: 1; borderColor: col == "" ? accent : border; color: col == "" ? accent : muted; onTap: col = "" }
          for k in colList key k.id {
            Text { text: k.name; style: small; padding: [3, 10]; radius: 12; border: 1; borderColor: col == k.id ? accent : border; color: col == k.id ? accent : muted; onTap: col = k.id }
          }
        }
      }
      Column {
        scroll: true
        weight: 1
        gap: 10
        if feed != null && feed.ok && len(cards) == 0 { Text { text: "All clear."; style: muted } }
        for c in cards key c.id {
          Row {
            gap: 10
            padding: 12
            radius: 12
            background: surface
            Column {
              weight: 1
              gap: 3
              onTap: url(c.url)
              Row {
                gap: 8
                Tag { label: "${c.board.name}${(c.column.name ?? colName) != null ? " › ${c.column.name ?? colName}" : ""}"; seed: c.board.name; weight: 1 }
                Text { text: fmtAgo(parseTime(c.last_active_at), now); style: small; color: muted }
              }
              Text { text: "#${c.number} ${c.title}"; maxLines: 3 }
              if len(c.tags ?? []) > 0 { Text { text: join(c.tags, " · "); style: small; color: muted } }
            }
            // The secret goes in the header written out here: a let can't hold it.
            Box {
              width: 40
              height: 40
              radius: 20
              align: center
              background: alpha(accent, 0.15)
              onTap: {
                closed = post("https://app.fizzy.do/${enc(acct)}/cards/${int(c.number)}/closure", null, {Authorization: "Bearer ${token}", Accept: "application/json"})
                done = done + [c.number]
                last = {number: c.number, title: c.title}
              }
              Text { text: "✓"; color: accent; align: center }
            }
          }
        }
      }
      if last != null {
        Row {
          gap: 8
          padding: [10, 6]
          radius: 12
          background: alpha(accent, 0.12)
          Text { text: "closed #${last.number}"; style: small; weight: 1; maxLines: 1 }
          Text {
            text: "undo"
            color: accent
            padding: [2, 8]
            onTap: {
              reopened = post("https://app.fizzy.do/${enc(acct)}/cards/${int(last.number)}/closure", null, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "DELETE")
              done = done.filter(n => n != last.number)
              last = null
            }
          }
          Text { text: "✕"; style: small; color: muted; padding: [2, 8]; onTap: last = null }
        }
      }
      if problem != "" { Text { text: problem; color: red; style: small } }
      if bobj != null {
        // The secret goes in the header written out here: a let can't hold it.
        Input {
          placeholder: "add a card to ${board}"
          clear: true
          padding: [10, 12]
          radius: 12
          background: surface
          onSubmit: if trim(value) != "" { added = post("https://app.fizzy.do/${enc(acct)}/boards/${enc(bobj.id)}/cards", {card: {title: trim(value)}}, {Authorization: "Bearer ${token}", Accept: "application/json"}) }
        }
      }
    }
  }
}
