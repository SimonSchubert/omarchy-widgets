widget "gunnery" {
  meta { owl: 23; description: "Pirate gunnery: flick pixel-art powder, wadding and a cannonball across the deck, bouncing off barrels, into the cannon's muzzle in order to load one gun for the sailing widget"; version: "1.4"; license: "MIT"; category: "games" }
  page: 1
  order: 7
  size: 3x3
  minSize: 3x3
  padding: 0
  background: #1a1109

  // mkdir and echo write the load counter the sailing widget reads
  requires { pacman: ["coreutils", "grep"] }
  // Linked to the sailing widget when it's on home; on its own otherwise (standalone: levels)
  // The sailing widget, found by its declared name (whatever the file is called, a store install
  // is market-<user>-<name>.owl): "home" is its file on home, "removed" one taken off home into
  // .removed/, both "" when it isn't installed
  source sailFind = cmd("cd ~/.config/omalauncher/widgets && printf '{\"home\": \"%s\", \"removed\": \"%s\"}' \"$(grep -l '^widget \"sailing\"' *.owl 2>/dev/null | head -1)\" \"$(grep -l '^widget \"sailing\"' .removed/*.owl 2>/dev/null | head -1 | sed 's|^.removed/||')\"") every 5m json
  // Until the first check is in, count it as there, so nothing flips at start
  let sailOwl = sailFind == null ? "40-sailing.owl" : (sailFind.home ?? "")
  let hasSailing = sailOwl != ""
  let sailRemoved = sailFind == null ? "" : (sailFind.removed ?? "")
  // On its own, the header offers Sailing (from the store, or back from .removed/) until dismissed
  state hideSailHint = false persist
  let showSailHint = sailFind != null && !hasSailing && !hideSailHint

  source modes = android.modes
  // The tilt nudges the iron ball, very slightly
  source m = android.motion
  // Written by 40-sailing.owl: {loaded, max}
  source guns = file("~/.cache/cannons.json") json

  // Progress kept across restarts
  state loads = 0 persist        // guns loaded in total (the sailing widget counts these)
  state best = 0 persist         // fewest shots for one load
  state score = 0 persist        // 300 / 200 / 100 a load, by how few shots it took
  state soundOn = true persist

  // The round in play
  state playing = false persist
  state items = [] persist       // [{id, k, x, y, vx, vy, r, m, drag, roll}]
  state step = 0 persist         // 0 powder, 1 wad, 2 ball, then loaded
  state shots = 0 persist
  state seed = 1 persist
  state cannonY = 80 persist

  // Moment to moment
  state gt = 0.0
  state grab = -1
  state aimX = 0.0
  state aimY = 0.0
  state banner = ""
  state bannerT = 0.0
  state flash = ""
  state flashT = 0.0
  state puff = 0.0
  state fireT = 0.0              // 1 when the sailing widget fires: recoil, flash and smoke
  state restX = 0.0              // tilt when the round started, taken as level
  state restY = 0.0

  // Low performance mode: 5 s without a touch freezes the deck (no physics, no blinking) at 1 frame a second;
  // any touch wakes it
  state idleT = 0.0
  let frozen = playing && idleT >= 5
  // Linked to the sailing widget, with every cannon loaded: nothing to load, no pieces
  let allLoaded = hasSailing && guns != null && guns.max != null && num(guns.loaded, 0) >= num(guns.max, 1)
  let pipStep = allLoaded && !playing ? 3 : step
  lock: playing && !frozen
  fps: playing && !frozen ? (modes.saver ? 30 : 60) : (bannerT > 0 || puff > 0 || fireT > 0 ? 30 : 1)

  let W = tileWidth ?? 190
  let H = (tileHeight ?? 200) - 28
  let need = ["powder", "wad", "ball"][step] ?? "done"
  let needName = need == "powder" ? "POWDER" : (need == "wad" ? "WADDING" : (need == "ball" ? "BALL" : "LOADED"))

  // Pixel art is drawn in 2 dp pixels, on that grid
  let P = 2

  // The cannon: a 30x11 pixel sprite on the right rail, its muzzle facing the deck
  let cL = W - 66
  let cR = W - 6
  let cT = cannonY - 9
  let cB = cannonY + 9
  // Suction reaches this far from the mouth of the muzzle
  let mx = cL - 4
  let suckR = 42

  // Barrels (round obstacles), laid out from the round's seed
  let barrels = [
    {x: W * (0.30 + hash(seed, 1) * 0.16), y: H * (0.14 + hash(seed, 2) * 0.16), r: 11},
    {x: W * (0.36 + hash(seed, 3) * 0.16), y: H * (0.44 + hash(seed, 4) * 0.12), r: 11},
    {x: W * (0.30 + hash(seed, 5) * 0.16), y: H * (0.70 + hash(seed, 6) * 0.14), r: 11}
  ]


  let cannonArt = [
    ".kkk..........................",
    "kshhkkkkkkkkkkkkkkkkkkkkkkkk..",
    "khrrkbsssssssbsssssssbsssssk..",
    "kroorbhhhhhhhbhhhhhhhbhhhhhk..",
    "koooobhhhhhhhbhhhhhhhbhhhhhkkk",
    "koooobiiiiiiibiiiiiiibiiiiikhk",
    "koooodiiiiiiidiiiiiiidiiiiikkk",
    "kroorddddddddddddddddddddddk..",
    "kdrrkddddddddddddddddddddddk..",
    "kdddkkkkkkkkkkkkkkkkkkkkkkkk..",
    ".kkk.........................."
  ]
  let cannonPal = {k: #000000, s: #7a7f89, h: #3a3d44, i: #1d1f23, d: #0e0f11, b: #555a64, r: #5d626c, o: #050505}

  let barrelArt = [
    "...kkkkk...",
    ".kkwhwwwkk.",
    ".kwbbbbbwk.",
    "kwbwwwwwbwk",
    "kwbwlllwbwk",
    "kwbwlllwbwk",
    "kwbwlllwbwk",
    "kwbwwwwwbwk",
    ".kwbbbbbwk.",
    ".kkwwwwwkk.",
    "...kkkkk..."
  ]
  let barrelPal = {k: #1b0f06, w: #8b5a2b, h: #c08a4e, b: #3b3f46, l: #a8743f}

  let ballArt = ["..kkk..", ".kshik.", "kshiidk", "khiiidk", "kiiiddk", ".kiddk.", "..kkk.."]
  let ballPal = {k: #000000, s: #9ca0a8, h: #4b4f57, i: #26282d, d: #111214}
  let powderArt = ["..kyk..", ".kryrk.", "krhrrrk", "krhrrdk", "krrrrdk", ".krddk.", "..kkk.."]
  let powderPal = {k: #1b0f06, r: #c0262d, h: #ef5350, d: #7f1d1d, y: #fbbf24}
  let wadArt = ["..kkk..", ".kwwwk.", "kwgwgwk", "kwwgwwk", "kwgwgwk", ".kwwwk.", "..kkk.."]
  let wadPal = {k: #1b0f06, w: #ece6d6, g: #a39a85}
  let shadowPal = {k: #000000, s: #000000, h: #000000, i: #000000, d: #000000, b: #000000, r: #000000, o: #000000, w: #000000, l: #000000, y: #000000, g: #000000}

  // Throw sounds: the iron ball clinks, the powder bag thuds, the wadding rustles like paper
  asset sndClink = base64""
  asset sndBag = base64""
  asset sndPaper = base64""

  // A shot from the sailing widget empties the gun shown here
  when fireT > 0.99 {
    if !playing { step = 0 }
  }

  when allLoaded {
    playing = false
    items = []
    grab = -1
  }

  let gunsText = guns != null && guns.max != null ? "${guns.loaded}/${guns.max}" : "-"

  every frame {
    if bannerT > 0 { bannerT = max(0, bannerT - dt) }
    if flashT > 0 { flashT = max(0, flashT - dt) }
    if puff > 0 { puff = max(0, puff - dt * 1.5) }
    if fireT > 0 { fireT = max(0, fireT - dt * 0.8) }

    if playing && idleT < 5 {
      idleT = idleT + dt
    }
    if playing && idleT < 5 {
      gt = gt + dt
      // Tilting the phone rolls the iron ball, only a little
      let tx = clamp((m.x ?? 0) - restX, -1, 1) * 14
      let ty = clamp((m.y ?? 0) - restY, -1, 1) * 14

      // 1) move: drag, tilt, stop when slow
      items = items.map(p => p.id == grab ? merge(p, {vx: 0, vy: 0}) : merge(p, {
        vx: (p.vx + tx * p.roll * dt) * max(0, 1 - p.drag * dt),
        vy: (p.vy + ty * p.roll * dt) * max(0, 1 - p.drag * dt)
      }))
      items = items.map(p => p.roll < 0.5 && abs(p.vx) + abs(p.vy) < 10 && !(p.k == need && dist([p.x, p.y], [mx, cannonY]) < suckR) ? merge(p, {vx: 0, vy: 0}) : merge(p, {x: p.x + p.vx * dt, y: p.y + p.vy * dt}))

      // 2) items knock each other, by mass
      let snap = items
      items = items.map(p => reduce(snap, (q, o) => o.id == p.id ? q : [dist([q.x, q.y], [o.x, o.y])].map(d => d >= q.r + o.r || d < 0.01 ? q : [[(q.x - o.x) / d, (q.y - o.y) / d, o.m / (q.m + o.m)]].map(n => [(q.vx - o.vx) * n[0] + (q.vy - o.vy) * n[1]].map(vn => merge(q, {
        x: q.x + n[0] * (q.r + o.r - d) * n[2],
        y: q.y + n[1] * (q.r + o.r - d) * n[2],
        vx: vn < 0 ? q.vx - 1.8 * vn * n[2] * n[0] : q.vx,
        vy: vn < 0 ? q.vy - 1.8 * vn * n[2] * n[1] : q.vy
      }))[0])[0])[0], p))

      // 3) barrels bounce them
      items = items.map(p => reduce(barrels, (q, b) => [dist([q.x, q.y], [b.x, b.y])].map(d => d >= q.r + b.r || d < 0.01 ? q : [[(q.x - b.x) / d, (q.y - b.y) / d]].map(n => [q.vx * n[0] + q.vy * n[1]].map(vn => merge(q, {
        x: b.x + n[0] * (q.r + b.r),
        y: b.y + n[1] * (q.r + b.r),
        vx: vn < 0 ? q.vx - 1.7 * vn * n[0] : q.vx,
        vy: vn < 0 ? q.vy - 1.7 * vn * n[1] : q.vy
      }))[0])[0])[0], p))

      // 4) suction: the piece the gun needs is drawn in once it's near the muzzle, like a vacuum,
      //    harder the closer it gets, with its sideways speed damped so it doesn't orbit
      items = items.map(p => p.k != need || p.id == grab ? p : [[mx - p.x, cannonY - p.y]].map(v => [max(0.01, dist(v))].map(d => d > suckR ? p : [(1 - d / suckR) * 900 + 120].map(a => merge(p, {
        vx: (p.vx + v[0] / d * a * dt) * max(0, 1 - 4 * dt),
        vy: (p.vy + v[1] / d * a * dt) * max(0, 1 - 4 * dt)
      }))[0])[0])[0])

      // 5) the muzzle: something flying in straight is loaded, or thrown back if it's out of order;
      //    the needed piece is also taken once suction has pulled it right to the mouth
      let entering = first(items.filter(p => (p.x + p.r > cL - 5 && p.x < cL + 8 && abs(p.y - cannonY) < 14 && p.vx > 12) || (p.k == need && p.id != grab && dist([p.x, p.y], [mx, cannonY]) < 9)))
      if entering != null {
        if entering.k == need {
          items = items.filter(p => p.id != entering.id)
          step = step + 1
          puff = 1.0
          if step >= 3 {
            playing = false
            loads = loads + 1
            best = best == 0 ? shots : min(best, shots)
            score = score + (shots <= 3 ? 300 : (shots <= 5 ? 200 : 100))
            banner = shots <= 3 ? "LOADED! ★★★" : (shots <= 5 ? "LOADED! ★★" : "LOADED! ★")
            bannerT = 3.0
            grab = -1
            run("mkdir -p ~/.cache && echo '{\"loads\": ${int(loads)}}' > ~/.cache/gunnery.json")
            haptic("strong")
          } else {
            flash = step == 1 ? "powder in! now wadding" : "wadding in! now the ball"
            flashT = 1.6
            haptic("medium")
          }
        } else {
          items = items.map(p => p.id == entering.id ? merge(p, {x: cL - p.r - 1, vx: -abs(p.vx) * 0.7 - 40, vy: p.vy + (p.y < cannonY ? -30 : 30)}) : p)
          flash = "${need} first!"
          flashT = 1.4
          haptic("light")
        }
      }

      // 6) the cannon's barrel is solid
      items = items.map(p => [[clamp(p.x, cL, cR), clamp(p.y, cT, cB)]].map(c => [dist([p.x, p.y], c)].map(d => d >= p.r ? p : (d < 0.01 ? merge(p, {x: cL - p.r, vx: -abs(p.vx)}) : [[(p.x - c[0]) / d, (p.y - c[1]) / d]].map(n => [p.vx * n[0] + p.vy * n[1]].map(vn => merge(p, {
        x: c[0] + n[0] * p.r,
        y: c[1] + n[1] * p.r,
        vx: vn < 0 ? p.vx - 1.6 * vn * n[0] : p.vx,
        vy: vn < 0 ? p.vy - 1.6 * vn * n[1] : p.vy
      }))[0])[0]))[0])[0])

      // 7) the rails
      items = items.map(p => merge(p, {
        x: clamp(p.x, p.r + 4, W - p.r - 4),
        y: clamp(p.y, p.r + 4, H - p.r - 4),
        vx: p.x < p.r + 4 ? abs(p.vx) * 0.6 : (p.x > W - p.r - 4 ? -abs(p.vx) * 0.6 : p.vx),
        vy: p.y < p.r + 4 ? abs(p.vy) * 0.6 : (p.y > H - p.r - 4 ? -abs(p.vy) * 0.6 : p.vy)
      }))
    }
  }

  Column {
    fill: true
    gap: 0

    Box {
      fill: width
      padding: [6, 6, 6, 2]
      // Header, the same in bilge, carpentry and gunnery: linked to the sailing widget it shows the
      // game's name and what it does for the ship; on its own, its level and the bar to the next one
      Row {
        height: 20
        fill: width
        align: center
        gap: 3
        if hasSailing {
          Text { text: "💣 GUNNERY"; bold: true; fontSize: 10; color: #f59e0b }
          Spacer { weight: 1 }
                Text { text: "GUNS ${gunsText}"; fontSize: 10; bold: true; color: allLoaded ? #4ade80 : #fde047 }
        } else if showSailHint {
          Text {
            text: sailRemoved != "" ? "⛵ ADD SAILING" : "⛵ GET SAILING"
            fontSize: 10
            bold: true
            color: #0d1329
            background: #f59e0b
            padding: [4, 1]
            radius: 3
            onTap: {
              if sailRemoved != "" {
                run("cd ~/.config/omalauncher/widgets && [ ! -e ${sh(sailRemoved)} ] && mv .removed/${sh(sailRemoved)} .")
                refresh()
              } else {
                launcher("store")
              }
            }
          }
          Spacer { weight: 1 }
          Text { text: "✕"; fontSize: 10; bold: true; color: muted; background: #1e293b; padding: [4, 1]; radius: 3; onTap: hideSailHint = true }
        } else {
          Text { text: "LVL ${1 + floor(loads / 3)}"; bold: true; fontSize: 10; color: #f59e0b }
          Progress { value: clamp(loads % 3, 0, 3); max: 3; color: #f59e0b; track: #2a1c0e; weight: 1; height: 6; radius: 3 }
          Text { text: "${loads % 3}/${3}"; fontSize: 10; color: muted }
        }
        Text { text: "★${score}"; fontSize: 10; bold: true; color: #fbbf24 }
        Text {
          text: soundOn ? "♪" : "✕"
          fontSize: 10
          bold: true
          color: soundOn ? #38bdf8 : muted
          background: #2a1c0e
          padding: [4, 1]
          radius: 3
          onTap: soundOn = !soundOn
        }
        Text {
          text: "↺"
          fontSize: 11
          bold: true
          color: foreground
          background: #2a1c0e
          padding: [4, 0]
          radius: 3
          onTap: {
                playing = false
                grab = -1
                banner = ""
            }
        }
      }
    }

    Canvas {
      width: W
      height: H

      // Deck planks, pixel style
      rect(0, 0, width, height, fill: #5c3a1c)
      for i in range(ceil(height / 12)) {
        rect(0, i * 12, width, 10, fill: i % 2 == 0 ? #7a4f2a : #70482a)
        rect(0, i * 12, width, 2, fill: #8a5c33)
        let j = ((i * 58) % 150) + 12
        rect(j, i * 12, 2, 10, fill: #4a2e15)
        rect(j - 6, i * 12 + 4, 2, 2, fill: #c9a26b)
        rect(j + 6, i * 12 + 4, 2, 2, fill: #c9a26b)
      }
      // Rails: a pixel frame
      rect(0, 0, width, 4, fill: #a37f1c)
      rect(0, height - 4, width, 4, fill: #a37f1c)
      rect(0, 0, 4, height, fill: #a37f1c)
      rect(width - 4, 0, 4, height, fill: #a37f1c)
      rect(4, 4, width - 8, 2, fill: #3a2410)
      rect(4, 4, 2, height - 8, fill: #3a2410)

      // The cannon, iron black, its muzzle to the deck
      // Recoil: kicked back toward the rail when it fires, rolling forward again
      let kick = fireT > 0.85 ? (1 - fireT) / 0.15 * 6 : fireT / 0.85 * 6
      let gx = cL + round(kick / P) * P
      layer(0.35) { sprite(cannonArt, gx + P, cannonY - 11 * P / 2 + P * 2, P, palette: shadowPal) }
      sprite(cannonArt, gx, cannonY - 11 * P / 2, P, palette: cannonPal)
      // Load pips on the barrel
      for i in range(3) { // powder fills the rightmost, then wadding, then the ball on the left
        rect(gx + 26 + (2 - i) * 8, cannonY - 3, 6, 6, fill: #000000)
        rect(gx + 27 + (2 - i) * 8, cannonY - 2, 4, 4, fill: pipStep > i ? (i == 0 ? #ef5350 : (i == 1 ? #ece6d6 : #9ca0a8)) : #2a2c31)
      }
      // Suction: dashes streaming into the muzzle while the needed piece is in reach
      if playing && !frozen && any(items, p => p.k == need && p.id != grab && dist([p.x, p.y], [mx, cannonY]) < suckR) {
        for j in range(5) {
          let f = 1 - ((gt * 2.5 + j / 5) % 1)
          let ang = j * 1.26
          rect(round((mx - cos(ang) * 2 - abs(cos(ang)) * f * suckR * 0.8) / P) * P, round((cannonY + sin(ang) * f * suckR * 0.8) / P) * P, 2, 2, fill: alpha(#e0f2fe, 0.25 + (1 - f) * 0.5))
        }
      }
      // Firing: a pixel flash out of the muzzle, then smoke rolling off
      if fireT > 0.6 {
        let fl = (fireT - 0.6) / 0.4
        rect(round((gx - 10 - fl * 0) / P) * P, cannonY - 6, 10, 12, fill: #fde047)
        rect(gx - 18, cannonY - 4, 8, 8, fill: #fb923c)
        rect(gx - 24, cannonY - 2, 6, 4, fill: alpha(#ef4444, fl))
        rect(gx - 6, cannonY - 10, 4, 4, fill: #fde047)
        rect(gx - 6, cannonY + 6, 4, 4, fill: #fde047)
      }
      if fireT > 0 && fireT < 0.95 {
        let sm = 1 - fireT
        for j in range(7) {
          let sx = cL - 8 - sm * (20 + hash(j, 1) * 40)
          let sy = cannonY + (hash(j, 2) - 0.5) * (8 + sm * 34)
          let sz = round((4 + sm * 8 * hash(j, 3)) / P) * P
          rect(round(sx / P) * P, round(sy / P) * P, sz, sz, fill: alpha(j % 2 == 0 ? #d4d4d4 : #a3a3a3, min(1, fireT * 1.4) * 0.85))
        }
      }
      if puff > 0 {
        let pr = 4 + (1 - puff) * 12
        for j in range(6) {
          rect(round((cL - 6 - pr * 0.8 + cos(j * 1.05) * pr * 0.6) / P) * P, round((cannonY + sin(j * 1.05) * pr) / P) * P, 4, 4, fill: alpha(#e5e5e5, puff * 0.8))
        }
      }

      // Barrels
      for b in barrels {
        let bx = round(b.x / P) * P - 11
        let by = round(b.y / P) * P - 11
        layer(0.35) { sprite(barrelArt, bx + P, by + P * 2, P, palette: shadowPal) }
        sprite(barrelArt, bx, by, P, palette: barrelPal)
      }

      // Aim: a dotted pixel line while an item is held
      let held = first(items.filter(p => p.id == grab))
      if held != null {
        let ax = aimX - held.x
        let ay = aimY - held.y
        let al = max(1, dist([ax, ay]))
        let k = min(al, 70) / al
        for j in range(1, 9) {
          rect(round((held.x + ax * k * j / 8) / P) * P - 2, round((held.y + ay * k * j / 8) / P) * P - 2, j == 8 ? 6 : 4, j == 8 ? 6 : 4, fill: j == 8 ? #fde047 : alpha(#fde047, 0.5 + j * 0.05))
        }
      }

      // Powder, wadding and the ball
      for p in items {
        let px = round(p.x / P) * P - 7
        let py = round(p.y / P) * P - 7
        layer(0.35) { sprite(p.k == "ball" ? ballArt : (p.k == "wad" ? wadArt : powderArt), px + P, py + P, P, palette: shadowPal) }
        sprite(p.k == "ball" ? ballArt : (p.k == "wad" ? wadArt : powderArt), px, py, P, palette: p.k == "ball" ? ballPal : (p.k == "wad" ? wadPal : powderPal))
        if (p.k == need && playing && grab < 0 && (frozen || floor(gt * 3) % 2 == 0)) || p.id == grab {
          rect(px - 4, py - 4, 4, 2, fill: #fde047)
          rect(px - 4, py - 4, 2, 4, fill: #fde047)
          rect(px + 14, py - 4, 4, 2, fill: #fde047)
          rect(px + 16, py - 4, 2, 4, fill: #fde047)
          rect(px - 4, py + 16, 4, 2, fill: #fde047)
          rect(px - 4, py + 14, 2, 4, fill: #fde047)
          rect(px + 14, py + 16, 4, 2, fill: #fde047)
          rect(px + 16, py + 14, 2, 4, fill: #fde047)
        }
      }

      // HUD
      if playing {
        text("next: ${needName}", 8, 12, size: 9, bold: true, color: #fde047, font: "mono")
        text("shots ${shots}", width - 8, 12, size: 9, color: alpha(#fef3c7, 0.8), font: "mono", align: end)
        if frozen {
          text("❚❚ paused · touch to play", width / 2, height - 10, size: 8, color: alpha(#fef3c7, 0.75), font: "mono", align: center)
        }
        if flashT > 0 {
          text(flash, width / 2, height - 10, size: 9, bold: true, color: alpha(flash == "${need} first!" ? #fca5a5 : #bbf7d0, clamp(flashT, 0, 1)), font: "mono", align: center)
        }
      } else if allLoaded && fireT <= 0 {
        text("ALL CANNONS LOADED", 8, 12, size: 9, bold: true, color: #4ade80, font: "mono")
      } else if fireT > 0 {
        // The sailing widget fired this gun: show it plain, no menu over it
        text("FIRE!", width / 2, 18, size: 13, bold: true, color: alpha(#fde047, min(1, fireT * 2)), font: "mono", align: center)
      } else {
          rect(0, 0, width, height, fill: alpha(#0b0704, 0.62))
          if bannerT > 0 || banner != "" {
            text(banner, width / 2, height / 2 - 30, size: 15, bold: true, color: #fde047, font: "mono", align: center)
            text("${shots} shots · best ${best}", width / 2, height / 2 - 12, size: 9, color: #fef3c7, font: "mono", align: center)
          } else {
            text("GUNNERY", width / 2, height / 2 - 30, size: 15, bold: true, color: #f59e0b, font: "mono", align: center)
            text("guns loaded ${loads} · best ${best > 0 ? best : "-"}", width / 2, height / 2 - 12, size: 9, color: #fef3c7, font: "mono", align: center)
          }
          text("drag from a piece to aim, let go to fire", width / 2, height / 2 + 8, size: 8, color: alpha(#fef3c7, 0.8), font: "mono", align: center)
          text("powder → wadding → ball", width / 2, height / 2 + 22, size: 8, color: alpha(#fef3c7, 0.8), font: "mono", align: center)
          text("TAP TO LOAD A GUN", width / 2, height / 2 + 42, size: 11, bold: true, color: #fde047, font: "mono", align: center)
      }

      onPress: {
        idleT = 0
        if playing {
          let g = first(items.filter(p => dist([p.x, p.y], [x, y]) < p.r + 16 && abs(p.vx) + abs(p.vy) < 80).sortBy(p => dist([p.x, p.y], [x, y])))
          grab = g != null ? g.id : -1
          aimX = x
          aimY = y
        }
      }
      onDrag: {
        idleT = 0
        if grab >= 0 {
          aimX = x
          aimY = y
        }
      }
      onDragEnd: {
        idleT = 0
        let g = first(items.filter(p => p.id == grab))
        if g != null {
          let ax = aimX - g.x
          let ay = aimY - g.y
          let al = dist([ax, ay])
          if al > 8 {
            let k = min(al, 70) / al * 6.5 / sqrt(g.m)
            items = items.map(p => p.id == g.id ? merge(p, {vx: ax * k, vy: ay * k}) : p)
            shots = shots + 1
            if soundOn { sound(g.k == "ball" ? sndClink : (g.k == "wad" ? sndPaper : sndBag)) }
          }
        }
        grab = -1
      }
      onTap: {
        idleT = 0
        if !playing && !allLoaded {
          let ks = shuffle(["powder", "wad", "ball"])
          seed = random(1000000)
          cannonY = round(H * (0.25 + random() * 0.5))
          items = range(3).map(i => {
            id: i,
            k: ks[i],
            x: 16,
            y: H * (0.2 + i * 0.3),
            vx: 0,
            vy: 0,
            r: 7,
            m: ks[i] == "ball" ? 2.2 : (ks[i] == "wad" ? 0.6 : 1.0),
            drag: ks[i] == "ball" ? 0.8 : (ks[i] == "wad" ? 2.6 : 1.7),
            roll: ks[i] == "ball" ? 1.0 : 0.0
          })
          restX = m.x ?? 0
          restY = m.y ?? 0
          step = 0
          shots = 0
          grab = -1
          gt = 0
          banner = ""
          bannerT = 0
          flash = ""
          playing = true
        } else {
          grab = -1
        }
      }
    }
  }
}
