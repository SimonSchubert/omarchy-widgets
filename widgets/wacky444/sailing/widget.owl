ues":7,"direction":"South-West"}]},"Penobscot Island":{"archipelago":"Stork","colonized":true,"connections":[{"destination":"Amity Island","distance_leagues":3,"direction":"North-West"},{"destination":"Hinga Island","distance_leagues":4,"direction":"South-East"},{"destination":"Scrimshaw Island","distance_leagues":6,"direction":"South-West"},{"destination":"Wissahickon Island","distance_leagues":4,"direction":"East"}]},"Pukru Island":{"archipelago":"Orion","colonized":true,"connections":[{"destination":"Aimuari Island","distance_leagues":2,"direction":"North-East"},{"destination":"Saiph Island","distance_leagues":7,"direction":"South-West"},{"destination":"Toba Island","distance_leagues":10,"direction":"North"}]},"Qaniit Island":{"archipelago":"Crab","colonized":false,"connections":[{"destination":"Nunataq Island","distance_leagues":7,"direction":"West"},{"destination":"Paollu Island","distance_leagues":7,"direction":"North-East"}]},"Quetzal Island":{"archipelago":"Orion","colonized":true,"connections":[{"destination":"Matariki Island","distance_leagues":7,"direction":"North-West"},{"destination":"Saiph Island","distance_leagues":8,"direction":"West"}]},"Rowes Island":{"archipelago":"Stork","colonized":false,"connections":[{"destination":"Amity Island","distance_leagues":3,"direction":"South-East"},{"destination":"Hoarfrost Island","distance_leagues":7,"direction":"West"},{"destination":"Squibnocket Island","distance_leagues":4,"direction":"North-East"}]},"Saiph Island":{"archipelago":"Orion","colonized":true,"connections":[{"destination":"Ix Chel","distance_leagues":6,"direction":"West"},{"destination":"Pukru Island","distance_leagues":7,"direction":"North-East"},{"destination":"Quetzal Island","distance_leagues":8,"direction":"East"}]},"Sayers Rock":{"archipelago":"Ursa","colonized":true,"connections":[{"destination":"Doyle Island","distance_leagues":3,"direction":"East"},{"destination":"Manu Island","distance_leagues":6,"direction":"South-West"},{"destination":"Marlowe Island","distance_leagues":6,"direction":"North-West"}]},"Scrimshaw Island":{"archipelago":"Stork","colonized":true,"connections":[{"destination":"Admiral Island","distance_leagues":6,"direction":"South-West"},{"destination":"Amity Island","distance_leagues":8,"direction":"North"},{"destination":"Bowditch Island","distance_leagues":5,"direction":"South-East"},{"destination":"Hinga Island","distance_leagues":5,"direction":"East"},{"destination":"Penobscot Island","distance_leagues":6,"direction":"North-East"}]},"Scurvy Reef":{"archipelago":"Osprey","colonized":false,"connections":[{"destination":"Ambush Island","distance_leagues":3,"direction":"South-East"},{"destination":"Bowditch Island","distance_leagues":8,"direction":"North"},{"destination":"Isle of Kent","distance_leagues":5,"direction":"West"}]},"Sho-ke Island":{"archipelago":"Canis","colonized":false,"connections":[{"destination":"Sirius Island","distance_leagues":5,"direction":"South"},{"destination":"Tumult Island","distance_leagues":8,"direction":"West"}]},"Sirius Island":{"archipelago":"Canis","colonized":false,"connections":[{"destination":"Immokalee Island","distance_leagues":8,"direction":"South"},{"destination":"Sho-ke Island","distance_leagues":5,"direction":"North"},{"destination":"Tumult Island","distance_leagues":8,"direction":"West"}]},"Spaniel Island":{"archipelago":"Pelican","colonized":true,"connections":[{"destination":"Gauntlet Island","distance_leagues":10,"direction":"North"},{"destination":"Starfish Island","distance_leagues":4,"direction":"South-West"},{"destination":"Ventress Island","distance_leagues":6,"direction":"South-East"}]},"Squibnocket Island":{"archipelago":"Stork","colonized":false,"connections":[{"destination":"Amity Island","distance_leagues":6,"direction":"South"},{"destination":"Rowes Island","distance_leagues":4,"direction":"South-West"}]},"Starfish Island":{"archipelago":"Pelican","colonized":false,"connections":[{"destination":"Fowler Island","distance_leagues":6,"direction":"South-West"},{"destination":"Greenwich Island","distance_leagues":3,"direction":"West"},{"destination":"Halley Island","distance_leagues":6,"direction":"South"},{"destination":"Spaniel Island","distance_leagues":4,"direction":"North-East"},{"destination":"Ventress Island","distance_leagues":4,"direction":"East"}]},"Terjit Island":{"archipelago":"Ibis","colonized":false,"connections":[{"destination":"Barbary Island","distance_leagues":4,"direction":"North-West"},{"destination":"Kasidim Island","distance_leagues":6,"direction":"South"},{"destination":"Tichka Plateau","distance_leagues":4,"direction":"East"}]},"The Beaufort Islands":{"archipelago":"Crab","colonized":false,"connections":[{"destination":"Alkaid Island","distance_leagues":7,"direction":"South-West"},{"destination":"Nunataq Island","distance_leagues":6,"direction":"North-East"},{"destination":"Wissahickon Island","distance_leagues":11,"direction":"West"}]},"The Lowland Hundred":{"archipelago":"Horse Head","colonized":true,"connections":[{"destination":"Barnard Island","distance_leagues":5,"direction":"North-West"},{"destination":"Lyonesse Island","distance_leagues":5,"direction":"West"}]},"Tichka Plateau":{"archipelago":"Ibis","colonized":false,"connections":[{"destination":"Hubble's Eye","distance_leagues":9,"direction":"North-East"},{"destination":"Kasidim Island","distance_leagues":4,"direction":"South-West"},{"destination":"Terjit Island","distance_leagues":4,"direction":"West"}]},"Toba Island":{"archipelago":"Orion","colonized":false,"connections":[{"destination":"Accompong Island","distance_leagues":8,"direction":"North-East"},{"destination":"Chachapoya Island","distance_leagues":6,"direction":"East"},{"destination":"Pukru Island","distance_leagues":10,"direction":"South"}]},"Tumult Island":{"archipelago":"Canis","colonized":true,"connections":[{"destination":"Armstrong Island","distance_leagues":4,"direction":"West"},{"destination":"Sho-ke Island","distance_leagues":8,"direction":"East"},{"destination":"Sirius Island","distance_leagues":8,"direction":"East"}]},"Umbarten Island":{"archipelago":"Pleiades","colonized":false,"connections":[{"destination":"Iocane Island","distance_leagues":4,"direction":"South-East"},{"destination":"Morgana Island","distance_leagues":3,"direction":"North-West"}]},"Ventress Island":{"archipelago":"Pelican","colonized":true,"connections":[{"destination":"Arakoua Island","distance_leagues":6,"direction":"South-East"},{"destination":"Halley Island","distance_leagues":4,"direction":"South-West"},{"destination":"Spaniel Island","distance_leagues":6,"direction":"North-West"},{"destination":"Starfish Island","distance_leagues":4,"direction":"West"}]},"Wensleydale":{"archipelago":"Gull","colonized":true,"connections":[{"destination":"Admiral Island","distance_leagues":3,"direction":"North-East"},{"destination":"Basset Island","distance_leagues":6,"direction":"North"},{"destination":"Cromwell Island","distance_leagues":4,"direction":"South-West"},{"destination":"Isle of Kent","distance_leagues":4,"direction":"South-East"}]},"Wissahickon Island":{"archipelago":"Stork","colonized":true,"connections":[{"destination":"Hinga Island","distance_leagues":6,"direction":"South"},{"destination":"Penobscot Island","distance_leagues":4,"direction":"West"},{"destination":"The Beaufort Islands","distance_leagues":11,"direction":"East"}]}}
  source modes = android.modes
  // The companion widgets, found by their declared name (whatever the file is called, a store
  // install is market-<user>-<name>.owl): "home" is the file on home, "removed" one taken off
  // home into .removed/, both "" when it isn't installed
  source mates = cmd("cd ~/.config/omalauncher/widgets && s=; printf '{'; for n in bilge carpentry gunnery; do h=$(grep -l '^widget \"'$n'\"' *.owl 2>/dev/null | head -1); r=$(grep -l '^widget \"'$n'\"' .removed/*.owl 2>/dev/null | head -1 | sed 's|^.removed/||'); printf '%s\"%s\": {\"home\": \"%s\", \"removed\": \"%s\"}' \"$s\" \"$n\" \"$h\" \"$r\"; s=,; done; printf '}'") every 5m json
  // Until the first check is in, count them as there, so nothing flips at start
  let bilgeOwl = mates == null ? "30-bilge.owl" : (mates.bilge.home ?? "")
  let carpentryOwl = mates == null ? "32-carpentry.owl" : (mates.carpentry.home ?? "")
  let gunneryOwl = mates == null ? "35-gunnery.owl" : (mates.gunnery.home ?? "")
  let hasBilge = bilgeOwl != ""
  let hasCarpentry = carpentryOwl != ""
  // Gunnery widget: when it's on home, cannons only reload by playing it
  let hasGunnery = gunneryOwl != ""

  // A banner on the island for the first missing companion the player hasn't dismissed
  state hiddenMates = [] persist
  let MATES = [
    {key: "bilge", label: "Bilge", icon: "🪣", gain: "pump water at sea"},
    {key: "carpentry", label: "Carpentry", icon: "🔨", gain: "patch the hull at sea"},
    {key: "gunnery", label: "Gunnery", icon: "💣", gain: "load guns by hand"}
  ]
  let missingMates = mates == null ? [] : MATES.filter(m => (mates[m.key].home ?? "") == "" && !contains(hiddenMates, m.key))
  let mate = len(missingMates) > 0 ? missingMates[0] : null
  let mateRemoved = mate != null ? (mates[mate.key].removed ?? "") : ""
  source gunFile = file("~/.cache/gunnery.json") json
  state gunSeen = 0 persist
  // Bilge widget: it writes the total it has pumped; sailing owns the water and takes off what's new
  source bilgeFile = file("~/.cache/bilge-pumps.json") json
  state bilgeSeen = -1.0 persist
  state lastSyncedGuns = ""
  state lastSyncedDamage = -1.0
  state lastSyncedWater = -1.0
  state lastSyncedRate = -999.0

  // Player persistent progress
  state poe = 100 persist
  state shipIdx = -1 persist
  state ownedShips = [] persist
  state currentIsland = "Admiral Island" persist
  state view = "island" persist
  state lastBattleGains = 60 persist

  // Sailing state (persisted between sessions)
  state destIsland = "Wensleydale" persist
  state destDirection = "South-West" persist
  state destColonized = true persist
  state totalLeagues = 3.0 persist
  state leaguesRemaining = 3.0 persist
  state currentSpeed = 0.0 persist
  state water = 0.0 persist
  state damage = 0.0 persist
  state loadedCannons = 4.0 persist
  state playerHp = 100 persist
  state seaScroll = 0.0
  state enemyNearby = false
  state enemyShipIdx = 0
  state enemyTimer = 0.0
  state enemySpawnTimer = 4.0

  // Battle state
  state turnTimer = 3.0
  state playerAction = ""
  state playerX = 140.0
  state playerY = 175.0
  state playerAngle = 0.0 persist
  state enemyX = 140.0
  state enemyY = 65.0
  state enemyAngle = 180.0
  state enemyHp = 100
  state enemyMaxHp = 100
  state battleLog = "Prepare for broadsides!"
  state cannonAnim = 0.0

  // Victory / Defeat state
  state victoryTimer = 0.0
  state winPoeTarget = 100
  state winPoeGained = 0
  state displayPoe = 100
  state lossPenalty = 30
  state sparks = []

  // Treasure state
  state chestAnim = 0.0
  state treasureVal = 0

  fps: (view == "sailing" || view == "battle" || view == "victory" || view == "treasure") ? (modes.saver ? 15 : 30) : 10

  // Dimensions
  let W = tileWidth ?? 300
  let H = tileHeight ?? 300

  // 13 Ships progression with distinct dimensions, styles, rigs, and color schemes
  let SHIPS = [
    {name: "Sloop", cost: 100, hp: 100, cannons: 4, shots: 1, len: 16, w: 8, hull: #8b5a2b, deck: #cda882, sail: #fef3c7, masts: 1, style: "sloop"},
    {name: "Cutter", cost: 220, hp: 140, cannons: 8, shots: 1, len: 19, w: 9, hull: #7c4820, deck: #cda882, sail: #f8fafc, masts: 1, style: "cutter"},
    {name: "Dhow", cost: 460, hp: 180, cannons: 8, shots: 1, len: 22, w: 9, hull: #854d0e, deck: #d4b494, sail: #fef9c3, masts: 2, style: "dhow"},
    {name: "Fanchuan", cost: 1000, hp: 230, cannons: 8, shots: 1, len: 25, w: 11, hull: #991b1b, deck: #deb887, sail: #ea580c, masts: 2, style: "junk"},
    {name: "Longship", cost: 2200, hp: 280, cannons: 8, shots: 1, len: 28, w: 8, hull: #451a03, deck: #a16207, sail: #dc2626, masts: 1, style: "longship"},
    {name: "Baghlah", cost: 4700, hp: 350, cannons: 12, shots: 2, len: 30, w: 12, hull: #713f12, deck: #d2b48c, sail: #fef08a, masts: 2, style: "baghlah"},
    {name: "Merchant Brig", cost: 10000, hp: 420, cannons: 12, shots: 2, len: 33, w: 13, hull: #543d2b, deck: #e0cda9, sail: #f1f5f9, masts: 2, style: "brig"},
    {name: "Junk", cost: 22000, hp: 500, cannons: 12, shots: 2, len: 36, w: 15, hull: #78350f, deck: #deb887, sail: #c2410c, masts: 3, style: "junk"},
    {name: "War Brig", cost: 47000, hp: 600, cannons: 16, shots: 2, len: 39, w: 15, hull: #262626, deck: #cdaa7d, sail: #f8fafc, masts: 2, style: "brig"},
    {name: "Merchant Galleon", cost: 100000, hp: 720, cannons: 20, shots: 2, len: 43, w: 17, hull: #451a03, deck: #d8c29d, sail: #fef3c7, masts: 3, style: "galleon"},
    {name: "Xebec", cost: 220000, hp: 850, cannons: 20, shots: 2, len: 46, w: 14, hull: #3f3f46, deck: #e2cead, sail: #e0f2fe, masts: 3, style: "xebec"},
    {name: "War Frigate", cost: 470000, hp: 1000, cannons: 24, shots: 2, len: 49, w: 19, hull: #1e293b, deck: #c7af88, sail: #ffffff, masts: 3, style: "frigate"},
    {name: "Grand Frigate", cost: 1000000, hp: 1300, cannons: 28, shots: 3, len: 54, w: 22, hull: #0f172a, deck: #be9f77, sail: #ffffff, masts: 3, style: "grand_frigate"}
  ]

  let curShip = shipIdx >= 0 ? SHIPS[shipIdx] : null

  // Island connections lookup
  let islData = ISLANDS[currentIsland]
  let islArch = islData.archipelago ?? "Gull"
  let islColonized = islData.colonized ?? true
  let defaultConns = [
    {destination: "Wensleydale", distance_leagues: 3, direction: "South-West"},
    {destination: "Basset Island", distance_leagues: 5, direction: "North-West"},
    {destination: "Isle of Kent", distance_leagues: 6, direction: "South"},
    {destination: "Scrimshaw Island", distance_leagues: 6, direction: "North-East"}
  ]
  let rawConns = islData.connections ?? defaultConns
  let connections = rawConns.map(c => merge(c, {
    colonized: (ISLANDS[c.destination].colonized ?? (c.destination == "Auk Island" || c.destination == "Bryher Island" || c.destination == "Scurvy Reef" || c.destination == "Hinga Island" ? false : true)),
    archipelago: (ISLANDS[c.destination].archipelago ?? islArch)
  }))

  // Real-time sailing physics
  let effSpeed = currentSpeed * max(0.15, 1.0 - (water / 100.0) * 0.85)
  let remainingSecs = effSpeed > 0 ? (leaguesRemaining / (effSpeed / 20.0)) : 999.0
  let etaClock = fmtTime(clamp(round(remainingSecs), 0, 3600), "m:ss", "UTC")

  // ---------------- PORT REPAIRS ----------------
  // Docked at an island: the yard patches the hull, pumps the bilge and loads the guns,
  // one tick a second. Rates scale with the ship (its HP and cannon count), so any ship
  // goes from 100% damage to 0% and from empty to every cannon loaded in 60 s.
  let REPAIR_SECS = 60.0
  let docked = view == "island" || view == "shop" || view == "chart" || view == "treasure"
  let maxGuns = curShip != null ? curShip.cannons : 4
  let needsRepair = curShip != null && (damage > 0.0 || water > 0.0 || loadedCannons < maxGuns)
  let repairing = docked && needsRepair
  let hullNow = curShip != null ? round(curShip.hp * (1.0 - damage / 100.0)) : 0
  // How fast the water is changing right now, in % a second: rising from a leaking hull while
  // sailing, falling while the port yard pumps. Bilge uses it to move its water smoothly
  let waterRate = (view == "sailing" && damage > 8.0) ? round((damage / 100.0) * 2.25, 3) : ((repairing && water > 0.0) ? round(-100.0 / REPAIR_SECS, 3) : 0.0)
  let repairLeft = ceil(max(damage, water, (1.0 - loadedCannons / maxGuns) * 100.0) / (100.0 / REPAIR_SECS))

  every 1s {
    if repairing {
      let hpPerTick = curShip.hp / REPAIR_SECS
      let hpNow = min(curShip.hp, curShip.hp * (1.0 - damage / 100.0) + hpPerTick)
      damage = max(0.0, (1.0 - hpNow / curShip.hp) * 100.0)
      if damage < 0.01 {
        damage = 0.0
      }
      water = max(0.0, water - 100.0 / REPAIR_SECS)
      loadedCannons = min(maxGuns, loadedCannons + maxGuns / REPAIR_SECS)

      // Tell the other widgets every tick: carpentry and bilge read ship-status.json,
      // gunnery reads cannons.json
      lastSyncedDamage = damage
      lastSyncedWater = water
      lastSyncedGuns = "${floor(loadedCannons)}/${int(maxGuns)}"
      let portRate = water > 0.0 ? round(-100.0 / REPAIR_SECS, 3) : 0.0
      lastSyncedRate = portRate
      run("mkdir -p ~/.cache && echo '{\"damage\": ${round(damage, 1)}, \"water\": ${round(water, 1)}, \"waterRate\": ${round(portRate, 3)}}' > ~/.cache/ship-status.json && echo '{\"loaded\": ${floor(loadedCannons)}, \"max\": ${int(maxGuns)}}' > ~/.cache/cannons.json")
    }
  }


  every 1s {
    if abs(damage - lastSyncedDamage) >= 0.2 || abs(water - lastSyncedWater) >= 0.2 || (water == 0.0 && lastSyncedWater != 0.0) || (damage == 0.0 && lastSyncedDamage != 0.0) || waterRate != lastSyncedRate {
      lastSyncedDamage = damage
      lastSyncedWater = water
      lastSyncedRate = waterRate
      run("mkdir -p ~/.cache && echo '{\"damage\": ${round(damage, 1)}, \"water\": ${round(water, 1)}, \"waterRate\": ${round(waterRate, 3)}}' > ~/.cache/ship-status.json")
    }
  }

  on bilgeFile first {
    let n = num(bilgeFile.pumped, 0.0)
    if n >= 0 {
      if bilgeSeen >= 0 && n > bilgeSeen {
        water = max(0.0, water - (n - bilgeSeen))
      }
      bilgeSeen = n
    }
  }

  // Each load finished in the gunnery widget puts one more cannon in
  on gunFile first {
    let n = num(gunFile.loads, -1)
    if n >= 0 {
      if n > gunSeen {
        let maxG = curShip != null ? curShip.cannons : 4
        loadedCannons = min(maxG, floor(loadedCannons) + n - gunSeen)
      }
      gunSeen = n
    }
  }

  // Tell the gunnery widget how many guns are loaded
  every 1s {
    let gunsNow = "${floor(loadedCannons)}/${int(curShip != null ? curShip.cannons : 4)}"
    if gunsNow != lastSyncedGuns {
      lastSyncedGuns = gunsNow
      run("mkdir -p ~/.cache && echo '{\"loaded\": ${floor(loadedCannons)}, \"max\": ${int(curShip != null ? curShip.cannons : 4)}}' > ~/.cache/cannons.json")
    }
  }

  on damage {
    let shipMax = curShip != null ? curShip.hp : 100
    playerHp = min(shipMax, round(shipMax * (1.0 - damage / 100.0)))
  }



  every frame {
    // ---------------- SAILING MODE ----------------
    if view == "sailing" {
      // Acceleration from 0 up to 1.0
      if currentSpeed < 1.0 {
        currentSpeed = min(1.0, currentSpeed + dt * 0.18)
      }

      // Distance covered (20 seconds per league at full speed)
      let lgsDelta = (effSpeed / 20.0) * dt
      leaguesRemaining = max(0.0, leaguesRemaining - lgsDelta)

      // Water and damage physics. At sea nothing repairs itself: patch the hull and
      // pump the bilge by hand (carpentry and bilge widgets), or dock at an island
      if damage > 8.0 {
        water = min(100.0, water + (damage / 100.0) * 2.25 * dt)
      }

      // Cannons reload over time (12.5% per 3s turn), unless the gunnery widget loads them
      let maxC = curShip != null ? curShip.cannons : 4
      if !hasGunnery {
        loadedCannons = min(maxC, loadedCannons + (maxC * 0.125 / 3.0) * dt)
      }

      // Sea wave scroll (seamless wrap at 3360.0 LCM)
      seaScroll = (seaScroll + dt * 35.0 * max(0.2, effSpeed)) % 3360.0

      // Enemy ship encounter logic
      if !enemyNearby {
        enemySpawnTimer = enemySpawnTimer - dt
        if enemySpawnTimer <= 0 {
          let pRank = max(0, shipIdx)
          let roll = random(0, 100)
          let r = random(0, 4095)
          let step = r < 2048 ? 1 : (r < 3072 ? 2 : (r < 3584 ? 3 : (r < 3840 ? 4 : (r < 3968 ? 5 : (r < 4032 ? 6 : (r < 4064 ? 7 : (r < 4080 ? 8 : (r < 4088 ? 9 : (r < 4092 ? 10 : (r < 4094 ? 11 : 12))))))))))
          let deltaRank = roll < 50 ? 0 : (roll < 75 ? -step : step)
          enemyShipIdx = clamp(pRank + deltaRank, 0, 12)
          enemyNearby = true
          enemyTimer = 8.0
          enemySpawnTimer = random(12, 22)
        }
      } else {
        enemyTimer = enemyTimer - dt
        if enemyTimer <= 0 {
          enemyNearby = false
        }
      }

      // Check arrival at destination
      if leaguesRemaining <= 0.0 {
        currentIsland = destIsland
        enemyNearby = false
        if destColonized {
          view = "island"
        } else {
          view = "treasure"
          chestAnim = 0.0
          let nextCost = shipIdx < 12 ? SHIPS[shipIdx + 1].cost : 1000000
          let myCost = curShip != null ? curShip.cost : 100
          let gap = max(100, nextCost - myCost)
          let factor = max(0.05, 0.22 - (max(0, shipIdx) * 0.014))
          treasureVal = round(gap * factor)
        }
      }
    }

    // ---------------- BATTLE MODE ----------------
    if view == "battle" {
      if floor(loadedCannons) <= 0 && playerAction == "shoot" {
        playerAction = ""
      }
      turnTimer = turnTimer - dt
      if cannonAnim > 0 {
        cannonAnim = max(0.0, cannonAnim - dt * 2.0)
      }

      // Turn executes every 3 seconds
      if turnTimer <= 0.0 {
        turnTimer = 3.0
        cannonAnim = 1.0

        // 1. Player turn action execution
        let prevAction = playerAction
        let pAngleBefore = playerAngle
        let pToEnemy = (deg(atan2(enemyX - playerX, -(enemyY - playerY))) + 360) % 360
        let pDiffBefore = abs((pAngleBefore - pToEnemy + 540) % 360 - 180)

        if playerAction == "L" {
          playerAngle = (playerAngle - 45 + 360) % 360
          playerX = clamp(playerX + sin(rad(playerAngle)) * 18, 25, W - 25)
          playerY = clamp(playerY - cos(rad(playerAngle)) * 18, 30, H - 30)
          battleLog = "Turned port!"
        } else if playerAction == "R" {
          playerAngle = (playerAngle + 45) % 360
          playerX = clamp(playerX + sin(rad(playerAngle)) * 18, 25, W - 25)
          playerY = clamp(playerY - cos(rad(playerAngle)) * 18, 30, H - 30)
          battleLog = "Turned starboard!"
        } else if playerAction == "F" {
          playerX = clamp(playerX + sin(rad(playerAngle)) * 26, 25, W - 25)
          playerY = clamp(playerY - cos(rad(playerAngle)) * 26, 30, H - 30)
          battleLog = "Sailed full ahead!"
        } else if playerAction == "shoot" && floor(loadedCannons) >= 1 {
          let pShots = curShip != null ? curShip.shots : 1
          let actualShots = min(pShots, floor(loadedCannons))
          loadedCannons = max(0.0, loadedCannons - actualShots)
          // Tell the gunnery widget its gun fired, for the recoil and smoke
          if hasGunnery {
            run("owl-send ${sh(gunneryOwl)} set fireT 1 >/dev/null 2>&1 || true")
          }

          let pdx = enemyX - playerX
          let pdy = enemyY - playerY
          let pdist = sqrt(pdx * pdx + pdy * pdy)
          let broadsideDev = abs(pDiffBefore - 90)

          if pdist < 130 {
            let baseDmg = round(actualShots * (28 + max(0, shipIdx) * 5))
            if broadsideDev <= 20 {
              let hitDmg = baseDmg
              enemyHp = max(0, enemyHp - hitDmg)
              battleLog = "Direct broadside hit! -${hitDmg} HP"
            } else if broadsideDev <= 55 {
              let hitDmg = round(baseDmg * 0.5)
              enemyHp = max(0, enemyHp - hitDmg)
              battleLog = "Inclined broadside! -${hitDmg} HP"
            } else {
              battleLog = "No broadside angle! Cannons missed"
            }
          } else {
            battleLog = "Cannonballs fell short!"
          }
        } else {
          battleLog = "Holding steady..."
        }
        let hadShot = prevAction == "shoot"
        playerAction = ""

        // Cannons reload 12.5% per turn (1 cannon every 2 turns in Sloop with 4 cannons)
        let maxBattleC = curShip != null ? curShip.cannons : 4
        if !hasGunnery {
          loadedCannons = min(maxBattleC, loadedCannons + maxBattleC * 0.125)
        }

        // Check if player maneuver forces enemy to veer away 1 step (50% chance)
        let pDiffAfter = abs((playerAngle - pToEnemy + 540) % 360 - 180)
        let isTurnAway = (prevAction == "L" || prevAction == "R") && pDiffAfter > pDiffBefore
        let attemptsVeer = prevAction == "F" || isTurnAway
        let didVeer = attemptsVeer && (random(0, 100) < 50)

        if didVeer {
          let toPlayer = (deg(atan2(playerX - enemyX, -(playerY - enemyY))) + 360) % 360
          let eDiff = (enemyAngle - toPlayer + 540) % 360 - 180
          let awayStep = eDiff >= 0 ? 45 : -45
          if abs(eDiff) < 180 {
            enemyAngle = (enemyAngle + awayStep + 360) % 360
          }
          battleLog = "${battleLog} • Veered away"
        }

        // 2. Enemy AI action (rotation-based broadside & chance to shoot)
        let enemyToPlayer = (deg(atan2(playerX - enemyX, -(playerY - enemyY))) + 360) % 360
        let enemyRelAngle = abs((enemyAngle - enemyToPlayer + 540) % 360 - 180)
        let isBroadside = enemyRelAngle >= 60 && enemyRelAngle <= 120

        if isBroadside {
          // Broadside facing player: 65% chance to fire
          if random(0, 100) < 65 {
            // 70% accuracy
            if random(0, 100) < 70 {
              let eShots = SHIPS[enemyShipIdx].shots
              let eDmg = round(eShots * (14 + enemyShipIdx * 3))
              playerHp = max(0, playerHp - eDmg)
              let shipMax = curShip != null ? curShip.hp : 100
              damage = clamp(((shipMax - playerHp) / shipMax) * 100.0, 0.0, 100.0)
              water = min(100.0, water + eDmg * 0.3)
              lastSyncedRate = 0.0
              run("mkdir -p ~/.cache && echo '{\"damage\": ${round(damage, 1)}, \"water\": ${round(water, 1)}, \"waterRate\": 0}' > ~/.cache/ship-status.json")
              battleLog = hadShot ? "${battleLog} • Took -${eDmg} HP" : "${battleLog} • Enemy broadside struck! (-${eDmg} HP)"
            } else {
              battleLog = hadShot ? "${battleLog} • Enemy missed!" : "${battleLog} • Enemy broadside missed!"
            }
          } else {
            // Holding fire / reloading
            battleLog = hadShot ? "${battleLog} • Enemy reloading" : "${battleLog} • Enemy holds fire, reloading..."
          }
        } else if !didVeer {
          // Not facing broadside and did not veer away: turn to bring broadside guns to bear
          let turnDir = enemyAngle == 180 ? (random(0, 10) < 5 ? 45 : -45) : ((enemyAngle < 90 || (enemyAngle > 180 && enemyAngle < 270)) ? 45 : -45)
          enemyAngle = (enemyAngle + turnDir + 360) % 360
          battleLog = hadShot ? "${battleLog} • Enemy maneuvering" : "${battleLog} • Enemy maneuvering for broadside..."
        }

        // 3. Victory / Defeat resolution
        if enemyHp <= 0 {
          let prize = round(SHIPS[enemyShipIdx].cost * 0.22 + random(35, 75))
          winPoeGained = prize
          winPoeTarget = poe + prize
          lastBattleGains = prize
          displayPoe = poe
          victoryTimer = 0.0
          sparks = []
          enemyNearby = false
          enemyTimer = 0.0
          enemySpawnTimer = random(14, 25)
          view = "victory"
        } else if playerHp <= 0 || water >= 100 {
          let pen = max(20, round(lastBattleGains * 0.5))
          poe = max(0, poe - pen)
          lossPenalty = pen
          // The ship limps home as it is: no free repair, it's fixed in port over time
          damage = playerHp <= 0 ? 100.0 : damage
          enemyNearby = false
          enemyTimer = 0.0
          enemySpawnTimer = random(14, 25)
          view = "defeat"
        }
      }
    }

    // ---------------- VICTORY MODE ----------------
    if view == "victory" {
      victoryTimer = victoryTimer + dt
      let progress = clamp(victoryTimer / 2.2, 0.0, 1.0)
      displayPoe = round(lerp(poe, winPoeTarget, progress))
      if progress >= 1.0 {
        poe = winPoeTarget
      }

      // Golden sparks particle emission
      let p1 = {
        x: W * 0.5 + random(-35, 35),
        y: H * 0.45 + random(-15, 15),
        vx: random(-70, 70),
        vy: random(-110, -30),
        life: random(0.5, 1.2),
        color: random(0, 10) < 5 ? #f59e0b : #fbbf24
      }
      sparks = (sparks + [p1])
        .map(p => merge(p, {x: p.x + p.vx * dt, y: p.y + p.vy * dt, vy: p.vy + 120 * dt, life: p.life - dt}))
        .filter(p => p.life > 0)
    }

    // ---------------- TREASURE MODE ----------------
    if view == "treasure" {
      if chestAnim < 1.0 {
        chestAnim = min(1.0, chestAnim + dt * 1.6)
      }
    }
  }

  // ---------------- UI CONTAINER ----------------
  Box {
    fill: true
    background: #09131f

    // ==========================================
    // VIEW 1: COLONIZED ISLAND (PORT / SHOPVIEW)
    // ==========================================
    if view == "island" {
      Column {
        fill: true
        padding: 6
        gap: 4

        // Header
        Row {
          fill: width
          align: center
          Row {
            weight: 1
            align: center
            gap: 4
            Box { size: 6; radius: 3; background: #10b981 }
            Text { text: currentIsland; fontSize: 12; bold: true; color: foreground; maxLines: 1 }
          }
          Text { text: "${fmtNum(poe)} PoE"; fontSize: 13; bold: true; color: #fbbf24 }
        }
        Row {
          fill: width
          align: center
          Text { text: "${islArch} • Colonized"; style: small; color: muted; weight: 1; maxLines: 1 }
          Text { text: curShip != null ? curShip.name : "No Ship"; style: small; color: accent }
        }

        // Port Scene Canvas
        Canvas {
          height: 44
          fill: width
          // Ocean Water
          rect(0, 0, width, height, radius: 5, fill: #13273e)
          // Waves
          for i in range(3) {
            line(width * 0.1 + i * 28, 10 + i * 10, width * 0.35 + i * 28, 10 + i * 10, stroke: alpha(#38bdf8, 0.25), width: 1.5)
          }
          // Wood Dock Pier
          rect(width * 0.05, 8, width * 0.35, 28, radius: 3, fill: #5c3b1e, stroke: #3a220d, width: 1.5)
          for k in range(4) {
            line(width * 0.05 + k * 18, 8, width * 0.05 + k * 18, 36, stroke: #3a220d, width: 1.5)
          }
          // Moored Ship
          if curShip != null {
            let cx = width * 0.72
            let cy = 22
            let slen = curShip.len * 0.7
            let sw = curShip.w * 0.7

            // Hull
            if curShip.style == "junk" {
              path([
                [cx - sw * 0.36, cy - slen * 0.5],
                [cx + sw * 0.36, cy - slen * 0.5],
                [cx + sw * 0.5, cy - slen * 0.15],
                [cx + sw * 0.5, cy + slen * 0.32],
                [cx + sw * 0.38, cy + slen * 0.5],
                [cx - sw * 0.38, cy + slen * 0.5],
                [cx - sw * 0.5, cy + slen * 0.32],
                [cx - sw * 0.5, cy - slen * 0.15]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            } else if curShip.style == "longship" {
              path([
                [cx, cy - slen * 0.55],
                [cx + sw * 0.48, cy - slen * 0.1],
                [cx + sw * 0.48, cy + slen * 0.1],
                [cx, cy + slen * 0.55],
                [cx - sw * 0.48, cy + slen * 0.1],
                [cx - sw * 0.48, cy - slen * 0.1]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
              for o in [-0.22, -0.07, 0.07, 0.22] {
                line(cx - sw * 0.45, cy + slen * o, cx - sw * 0.9, cy + slen * o + 3, stroke: #cdaa7d, width: 1.2)
                line(cx + sw * 0.45, cy + slen * o, cx + sw * 0.9, cy + slen * o + 3, stroke: #cdaa7d, width: 1.2)
              }
            } else if curShip.style == "dhow" || curShip.style == "xebec" {
              path([
                [cx, cy - slen * 0.6],
                [cx + sw * 0.5, cy - slen * 0.15],
                [cx + sw * 0.45, cy + slen * 0.32],
                [cx + sw * 0.28, cy + slen * 0.5],
                [cx - sw * 0.28, cy + slen * 0.5],
                [cx - sw * 0.45, cy + slen * 0.32],
                [cx - sw * 0.5, cy - slen * 0.15]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            } else {
              path([
                [cx, cy - slen * 0.55],
                [cx + sw * 0.5, cy - slen * 0.2],
                [cx + sw * 0.5, cy + slen * 0.3],
                [cx + sw * 0.35, cy + slen * 0.5],
                [cx - sw * 0.35, cy + slen * 0.5],
                [cx - sw * 0.5, cy + slen * 0.3],
                [cx - sw * 0.5, cy - slen * 0.2]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            }

            if curShip.style == "cutter" || curShip.style == "xebec" || curShip.style == "frigate" || curShip.style == "grand_frigate" || curShip.style == "galleon" {
              line(cx, cy - slen * 0.52, cx, cy - slen * 0.68, stroke: #1a0f07, width: 1.5)
            }
            if curShip.style == "galleon" || curShip.style == "frigate" || curShip.style == "grand_frigate" {
              rect(cx - sw * 0.38, cy + slen * 0.36, sw * 0.76, slen * 0.12, radius: 1, fill: #201309, stroke: (curShip.style == "grand_frigate" ? #fbbf24 : #3a220d), width: 1.2)
            }

            rect(cx - sw * 0.32, cy - slen * 0.3, sw * 0.64, slen * 0.58, radius: 2, fill: curShip.deck)

            if curShip.masts == 1 {
              circle(cx, cy, 2.5, fill: #1c1008)
              line(cx - sw * 0.6, cy, cx + sw * 0.6, cy, stroke: #1c1008, width: 2)
              arc(cx, cy - 3, sw * 0.55, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
            } else if curShip.masts == 2 {
              let m1y = cy - slen * 0.18
              let m2y = cy + slen * 0.16
              circle(cx, m1y, 2, fill: #1c1008)
              circle(cx, m2y, 2.3, fill: #1c1008)
              if curShip.style == "dhow" || curShip.style == "baghlah" {
                line(cx - sw * 0.52, m1y + 4, cx + sw * 0.52, m1y - 6, stroke: #1c1008, width: 1.8)
                line(cx - sw * 0.46, m1y + 3, cx + sw * 0.46, m1y - 5, stroke: curShip.sail, width: 2.5, cap: round)
                line(cx - sw * 0.58, m2y + 5, cx + sw * 0.58, m2y - 7, stroke: #1c1008, width: 1.8)
                line(cx - sw * 0.52, m2y + 4, cx + sw * 0.52, m2y - 6, stroke: curShip.sail, width: 3, cap: round)
              } else if curShip.style == "junk" {
                line(cx - sw * 0.48, m1y, cx + sw * 0.48, m1y, stroke: #1c1008, width: 1.8)
                arc(cx, m1y - 2, sw * 0.45, 270, 180, stroke: curShip.sail, width: 2.6, cap: round)
                line(cx - sw * 0.55, m2y, cx + sw * 0.55, m2y, stroke: #1c1008, width: 1.8)
                arc(cx, m2y - 2, sw * 0.52, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
              } else {
                line(cx - sw * 0.52, m1y, cx + sw * 0.52, m1y, stroke: #1c1008, width: 1.8)
                arc(cx, m1y - 2, sw * 0.48, 270, 180, stroke: curShip.sail, width: 2.4, cap: round)
                line(cx - sw * 0.62, m2y, cx + sw * 0.62, m2y, stroke: #1c1008, width: 1.8)
                arc(cx, m2y - 3, sw * 0.58, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
              }
            } else {
              let m1y = cy - slen * 0.25
              let m2y = cy
              let m3y = cy + slen * 0.24
              circle(cx, m1y, 1.8, fill: #1c1008)
              circle(cx, m2y, 2.2, fill: #1c1008)
              circle(cx, m3y, 1.6, fill: #1c1008)
              if curShip.style == "xebec" {
                line(cx - sw * 0.45, m1y + 3, cx + sw * 0.45, m1y - 5, stroke: #1c1008, width: 1.6)
                line(cx - sw * 0.4, m1y + 2, cx + sw * 0.4, m1y - 4, stroke: curShip.sail, width: 2.2, cap: round)
                line(cx - sw * 0.55, m2y + 4, cx + sw * 0.55, m2y - 6, stroke: #1c1008, width: 1.8)
                line(cx - sw * 0.5, m2y + 3, cx + sw * 0.5, m2y - 5, stroke: curShip.sail, width: 2.6, cap: round)
                line(cx - sw * 0.4, m3y + 3, cx + sw * 0.4, m3y - 5, stroke: #1c1008, width: 1.6)
                line(cx - sw * 0.35, m3y + 2, cx + sw * 0.35, m3y - 4, stroke: curShip.sail, width: 2, cap: round)
              } else {
                line(cx - sw * 0.48, m1y, cx + sw * 0.48, m1y, stroke: #1c1008, width: 1.8)
                arc(cx, m1y - 2, sw * 0.45, 270, 180, stroke: curShip.sail, width: 2.4, cap: round)
                line(cx - sw * 0.62, m2y, cx + sw * 0.62, m2y, stroke: #1c1008, width: 2)
                arc(cx, m2y - 3, sw * 0.6, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
                line(cx - sw * 0.44, m3y, cx + sw * 0.44, m3y, stroke: #1c1008, width: 1.6)
                arc(cx, m3y - 2, sw * 0.4, 270, 180, stroke: curShip.sail, width: 2.2, cap: round)
              }
            }
          } else {
            text("⚓ Shipyard Awaits", width * 0.72, 22, size: 10, bold: true, align: center, color: #fbbf24)
          }
        }

        // Status Card (while repairing in port, it shows the repair progress instead)
        if repairing {
          Column {
            fill: width
            padding: [6, 4]
            gap: 3
            background: alpha(#f59e0b, 0.12)
            radius: 4
            Row {
              fill: width
              align: center
              Text { text: "🔧 Repairing ${curShip.name}…"; style: small; bold: true; color: #fbbf24; weight: 1; maxLines: 1 }
              Text { text: fmtTime(repairLeft, "m:ss", "UTC"); style: small; bold: true; color: #fbbf24 }
            }
            Row {
              fill: width
              gap: 6
              Column {
                weight: 1
                gap: 2
                Text { text: "Hull ${hullNow}"; style: small; color: muted; maxLines: 1 }
                Progress { value: 100 - damage; max: 100; color: #10b981; track: alpha(foreground, 0.12); fill: width; height: 5; radius: 2.5 }
              }
              Column {
                weight: 1
                gap: 2
                Text { text: "Bilge ${round(water)}%"; style: small; color: muted; maxLines: 1 }
                Progress { value: 100 - water; max: 100; color: #38bdf8; track: alpha(foreground, 0.12); fill: width; height: 5; radius: 2.5 }
              }
              Column {
                weight: 1
                gap: 2
                Text { text: "Guns ${floor(loadedCannons)}/${int(maxGuns)}"; style: small; color: muted; maxLines: 1 }
                Progress { value: loadedCannons; max: maxGuns; color: #f59e0b; track: alpha(foreground, 0.12); fill: width; height: 5; radius: 2.5 }
              }
            }
          }
        } else {
          Box {
            fill: width
            padding: [6, 4]
            background: alpha(surface, 0.6)
            radius: 4
            if shipIdx == -1 {
              Text { text: "⚠️ Buy your Sloop in the Shipyard!"; color: #fbbf24; style: small; maxLines: 1 }
            } else {
              Column {
                gap: 1
                Text { text: "${curShip.name} (Cannons: ${curShip.cannons}, HP: ${curShip.hp})"; bold: true; color: foreground; style: small; maxLines: 1 }
                Text { text: "⚓ Shipshape, guns loaded"; style: small; color: #10b981; maxLines: 1 }
              }
            }
          }
        }

        // A companion widget missing: where to get it, or a tap to put it back on home
        if mate != null {
          Row {
            fill: width
            align: center
            gap: 5
            padding: [6, 3]
            radius: 4
            background: alpha(#38bdf8, 0.12)
            Column {
              weight: 1
              Text { text: mateRemoved != "" ? "${mate.icon} ${mate.label}" : "${mate.icon} No ${mate.label}"; style: small; bold: true; color: #7dd3fc; maxLines: 1 }
              Text { text: mateRemoved != "" ? "taken off home" : mate.gain; style: small; color: muted; maxLines: 1 }
            }
            Text {
              text: mateRemoved != "" ? "ADD" : "STORE"
              style: small
              bold: true
              color: #09131f
              background: accent
              padding: [7, 4]
              radius: 3
              onTap: {
                if mateRemoved != "" {
                  run("cd ~/.config/omalauncher/widgets && [ ! -e ${sh(mateRemoved)} ] && mv .removed/${sh(mateRemoved)} .")
                  refresh()
                } else {
                  launcher("store")
                }
              }
            }
            Text {
              text: "✕"
              style: small
              bold: true
              color: muted
              background: alpha(surface, 0.8)
              padding: [6, 4]
              radius: 3
              onTap: { hiddenMates = hiddenMates + [mate.key] }
            }
          }
        }

        Spacer { weight: 1 }

        // Action Buttons
        Row {
          fill: width
          gap: 6
          Button {
            text: "SHIPYARD"
            weight: 1
            onTap: { view = "shop" }
          }
          if shipIdx >= 0 {
            Button {
              text: "SAIL"
              color: accent
              weight: 1
              onTap: { view = "chart" }
            }
          }
        }
      }
    }

    // ==========================================
    // VIEW 2: SHIPYARD (ALL 13 SHIPS)
    // ==========================================
    if view == "shop" {
      Column {
        fill: true
        padding: 10
        gap: 6

        Row {
          fill: width
          align: center
          Text { text: "SHIPYARD"; style: title; bold: true; color: foreground }
          Spacer { weight: 1 }
          Text { text: "${fmtNum(poe)} PoE"; style: title; bold: true; color: #fbbf24 }
        }

        Text { text: "Full price shipyard. Upgrade all the way to Grand Frigate:"; style: small; color: muted }

        Column {
          fill: width
          weight: 1
          scroll: true
          gap: 4

          for s, i in SHIPS key s.name {
            let isOwned = (shipIdx == i) || contains(ownedShips, i)
            Row {
              fill: width
              padding: 6
              align: center
              background: shipIdx == i ? alpha(accent, 0.18) : (isOwned ? alpha(accent, 0.08) : alpha(surface, 0.45))
              radius: 4
              gap: 6

              Column {
                weight: 1
                gap: 1
                Row {
                  align: center
                  gap: 4
                  Text { text: s.name; bold: true; color: shipIdx == i ? accent : foreground }
                  if shipIdx == i {
                    Text { text: "(Active)"; style: small; color: #10b981 }
                  } else if isOwned {
                    Text { text: "(Owned)"; style: small; color: #38bdf8 }
                  }
                }
                Text { text: "${s.masts}-Mast ${capitalize(s.style)} • HP ${s.hp} • ${s.cannons} Cannons"; style: small; color: muted }
              }

              if shipIdx == i {
                Text { text: "ACTIVE"; style: small; bold: true; color: #10b981 }
              } else if isOwned {
                Button {
                  text: "BOARD"
                  color: accent
                  onTap: {
                    if shipIdx >= 0 && !contains(ownedShips, shipIdx) {
                      ownedShips = ownedShips + [shipIdx]
                    }
                    shipIdx = i
                    playerHp = s.hp
                    damage = 0.0
                    water = 0.0
                    loadedCannons = s.cannons
                    view = "island"
                  }
                }
              } else if poe >= s.cost {
                Button {
                  text: "BUY ${fmtNum(s.cost)}"
                  color: green
                  onTap: {
                    sound(sndCoins)
                    poe = poe - s.cost
                    if !contains(ownedShips, i) {
                      ownedShips = ownedShips + [i]
                    }
                    if shipIdx >= 0 && !contains(ownedShips, shipIdx) {
                      ownedShips = ownedShips + [shipIdx]
                    }
                    shipIdx = i
                    playerHp = s.hp
                    damage = 0.0
                    water = 0.0
                    loadedCannons = s.cannons
                    view = "island"
                  }
                }
              } else {
                Text { text: "${fmtNum(s.cost)} PoE"; style: small; color: muted }
              }
            }
          }
        }

        Button {
          text: "← Back to Island"
          fill: width
          onTap: { view = "island" }
        }
      }
    }

    // ==========================================
    // VIEW 3: CHART SEA ROUTES (CONNECTED ISLANDS)
    // ==========================================
    if view == "chart" {
      Column {
        fill: true
        padding: 10
        gap: 6

        // Header
        Row {
          fill: width
          align: center
          Text { text: "CHART COURSE"; fontSize: 13; bold: true; color: foreground }
          Spacer { weight: 1 }
          Text { text: currentIsland; fontSize: 11; color: muted }
        }

        Text { text: "Select a charted connection (10s/league at full speed):"; style: small; color: muted }

        Column {
          fill: width
          weight: 1
          scroll: true
          gap: 4

          for c in connections key c.destination {
            Row {
              fill: width
              padding: 8
              align: center
              background: alpha(surface, 0.5)
              radius: 4
              gap: 8

              Column {
                weight: 1
                gap: 1
                Row {
                  align: center
                  gap: 4
                  Box { size: 7; radius: 3.5; background: c.colonized ? #10b981 : #f59e0b }
                  Text { text: c.destination; bold: true; color: foreground }
                }
                Text { text: "${c.distance_leagues} leagues (${c.distance_leagues * 20}s) • ${c.direction} • ${c.colonized ? "Colonized Port" : "Uncolonized Haven"}"; style: small; color: muted }
              }

              Button {
                text: "SAIL"
                color: accent
                onTap: {
                  destIsland = c.destination
                  destDirection = c.direction
                  destColonized = c.colonized
                  totalLeagues = c.distance_leagues
                  leaguesRemaining = c.distance_leagues
                  currentSpeed = 0.0
                  view = "sailing"
                }
              }
            }
          }
        }

        Button {
          text: "← Back to Island"
          fill: width
          onTap: { view = "island" }
        }
      }
    }

    // ==========================================
    // VIEW 4: SAILING SEA VIEW (WITH GAUGES & ANIM)
    // ==========================================
    if view == "sailing" {
      Box {
        fill: true

        // Ocean & Ship Canvas
        Canvas {
          fill: true

          // Sea backdrop
          rect(0, 0, width, height, fill: #0d2238)

          // 1. Deep ocean current swells (slow background layer, 24px period)
          let deepOff = (seaScroll * 0.5) % 24.0
          for drow in range(14) {
            let dy = (drow - 1) * 24.0 + deepOff
            line(width * 0.2, dy, width * 0.8, dy, stroke: alpha(#0284c7, 0.12), width: 2.2)
          }

          // 2. Main ocean wave crests & ripples (seamless 28px period)
          let offsetWave = seaScroll % 28.0
          for row in range(14) {
            let wy = (row - 1) * 28.0 + offsetWave
            line(0, wy, width, wy, stroke: alpha(#38bdf8, 0.16), width: 1.5)
            line(15, wy + 7, width * 0.45, wy + 7, stroke: alpha(#38bdf8, 0.10), width: 1.1)
            line(width * 0.55, wy + 14, width - 15, wy + 14, stroke: alpha(#38bdf8, 0.10), width: 1.1)
          }

          // 3. Surface wave flecks & whitecaps (fast foreground layer, 36px period)
          let surfOff = (seaScroll * 1.5) % 36.0
          for srow in range(11) {
            let sy = (srow - 1) * 36.0 + surfOff
            line(width * 0.12, sy + 4, width * 0.32, sy + 4, stroke: alpha(#e0f2fe, 0.14), width: 1.3, cap: round)
            line(width * 0.68, sy + 18, width * 0.88, sy + 18, stroke: alpha(#e0f2fe, 0.14), width: 1.3, cap: round)
          }

          // ---------------- OWN SHIP ----------------
          if curShip != null {
            let px = width * 0.5
            let py = height * 0.52
            let slen = curShip.len
            let sw = curShip.w

            // Wake foam behind ship
            line(px - sw * 0.4, py + slen * 0.4, px - sw * 0.8, py + slen * 0.85, stroke: alpha(#ffffff, 0.35), width: 2)
            line(px + sw * 0.4, py + slen * 0.4, px + sw * 0.8, py + slen * 0.85, stroke: alpha(#ffffff, 0.35), width: 2)

            // Wooden Hull
            if curShip.style == "junk" {
              path([
                [px - sw * 0.36, py - slen * 0.5],
                [px + sw * 0.36, py - slen * 0.5],
                [px + sw * 0.5, py - slen * 0.15],
                [px + sw * 0.5, py + slen * 0.32],
                [px + sw * 0.38, py + slen * 0.5],
                [px - sw * 0.38, py + slen * 0.5],
                [px - sw * 0.5, py + slen * 0.32],
                [px - sw * 0.5, py - slen * 0.15]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            } else if curShip.style == "longship" {
              path([
                [px, py - slen * 0.55],
                [px + sw * 0.48, py - slen * 0.1],
                [px + sw * 0.48, py + slen * 0.1],
                [px, py + slen * 0.55],
                [px - sw * 0.48, py + slen * 0.1],
                [px - sw * 0.48, py - slen * 0.1]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
              for o in [-0.22, -0.07, 0.07, 0.22] {
                line(px - sw * 0.45, py + slen * o, px - sw * 0.9, py + slen * o + 3, stroke: #cdaa7d, width: 1.2)
                line(px + sw * 0.45, py + slen * o, px + sw * 0.9, py + slen * o + 3, stroke: #cdaa7d, width: 1.2)
              }
            } else if curShip.style == "dhow" || curShip.style == "xebec" {
              path([
                [px, py - slen * 0.6],
                [px + sw * 0.5, py - slen * 0.15],
                [px + sw * 0.45, py + slen * 0.32],
                [px + sw * 0.28, py + slen * 0.5],
                [px - sw * 0.28, py + slen * 0.5],
                [px - sw * 0.45, py + slen * 0.32],
                [px - sw * 0.5, py - slen * 0.15]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            } else {
              path([
                [px, py - slen * 0.55],
                [px + sw * 0.5, py - slen * 0.2],
                [px + sw * 0.5, py + slen * 0.3],
                [px + sw * 0.35, py + slen * 0.5],
                [px - sw * 0.35, py + slen * 0.5],
                [px - sw * 0.5, py + slen * 0.3],
                [px - sw * 0.5, py - slen * 0.2]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            }

            if curShip.style == "cutter" || curShip.style == "xebec" || curShip.style == "frigate" || curShip.style == "grand_frigate" || curShip.style == "galleon" {
              line(px, py - slen * 0.52, px, py - slen * 0.68, stroke: #1a0f07, width: 1.5)
            }
            if curShip.style == "galleon" || curShip.style == "frigate" || curShip.style == "grand_frigate" {
              rect(px - sw * 0.38, py + slen * 0.36, sw * 0.76, slen * 0.12, radius: 1, fill: #201309, stroke: (curShip.style == "grand_frigate" ? #fbbf24 : #3a220d), width: 1.2)
            }
            if curShip.cannons >= 16 {
              for cp in [-0.2, 0.0, 0.2] {
                circle(px - sw * 0.48, py + slen * cp, 1.2, fill: #000000)
                circle(px + sw * 0.48, py + slen * cp, 1.2, fill: #000000)
              }
            }

            // Deck
            rect(px - sw * 0.32, py - slen * 0.3, sw * 0.64, slen * 0.58, radius: 2, fill: curShip.deck)

            // Masts & Sails
            if curShip.masts == 1 {
              circle(px, py, 2.5, fill: #1c1008)
              line(px - sw * 0.6, py, px + sw * 0.6, py, stroke: #1c1008, width: 2)
              arc(px, py - 3, sw * 0.55, 270, 180, stroke: curShip.sail, width: 3, cap: round)
            } else if curShip.masts == 2 {
              let m1y = py - slen * 0.18
              let m2y = py + slen * 0.16
              circle(px, m1y, 2, fill: #1c1008)
              circle(px, m2y, 2.3, fill: #1c1008)
              if curShip.style == "dhow" || curShip.style == "baghlah" {
                line(px - sw * 0.52, m1y + 4, px + sw * 0.52, m1y - 6, stroke: #1c1008, width: 2)
                line(px - sw * 0.46, m1y + 3, px + sw * 0.46, m1y - 5, stroke: curShip.sail, width: 2.8, cap: round)
                line(px - sw * 0.58, m2y + 5, px + sw * 0.58, m2y - 7, stroke: #1c1008, width: 2)
                line(px - sw * 0.52, m2y + 4, px + sw * 0.52, m2y - 6, stroke: curShip.sail, width: 3.2, cap: round)
              } else if curShip.style == "junk" {
                line(px - sw * 0.48, m1y, px + sw * 0.48, m1y, stroke: #1c1008, width: 2)
                arc(px, m1y - 2, sw * 0.45, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
                line(px - sw * 0.38, m1y - 2, px + sw * 0.38, m1y - 2, stroke: #3a1505, width: 1)
                line(px - sw * 0.55, m2y, px + sw * 0.55, m2y, stroke: #1c1008, width: 2)
                arc(px, m2y - 2, sw * 0.52, 270, 180, stroke: curShip.sail, width: 3, cap: round)
                line(px - sw * 0.45, m2y - 2, px + sw * 0.45, m2y - 2, stroke: #3a1505, width: 1)
              } else {
                line(px - sw * 0.52, m1y, px + sw * 0.52, m1y, stroke: #1c1008, width: 2)
                arc(px, m1y - 2, sw * 0.48, 270, 180, stroke: curShip.sail, width: 2.6, cap: round)
                line(px - sw * 0.62, m2y, px + sw * 0.62, m2y, stroke: #1c1008, width: 2)
                arc(px, m2y - 3, sw * 0.58, 270, 180, stroke: curShip.sail, width: 3.2, cap: round)
              }
            } else {
              let m1y = py - slen * 0.25
              let m2y = py
              let m3y = py + slen * 0.24
              circle(px, m1y, 2, fill: #1c1008)
              circle(px, m2y, 2.5, fill: #1c1008)
              circle(px, m3y, 1.8, fill: #1c1008)
              if curShip.style == "xebec" {
                line(px - sw * 0.45, m1y + 3, px + sw * 0.45, m1y - 5, stroke: #1c1008, width: 1.8)
                line(px - sw * 0.4, m1y + 2, px + sw * 0.4, m1y - 4, stroke: curShip.sail, width: 2.5, cap: round)
                line(px - sw * 0.55, m2y + 4, px + sw * 0.55, m2y - 6, stroke: #1c1008, width: 2)
                line(px - sw * 0.5, m2y + 3, px + sw * 0.5, m2y - 5, stroke: curShip.sail, width: 3, cap: round)
                line(px - sw * 0.4, m3y + 3, px + sw * 0.4, m3y - 5, stroke: #1c1008, width: 1.8)
                line(px - sw * 0.35, m3y + 2, px + sw * 0.35, m3y - 4, stroke: curShip.sail, width: 2.2, cap: round)
              } else if curShip.style == "junk" {
                line(px - sw * 0.42, m1y, px + sw * 0.42, m1y, stroke: #1c1008, width: 1.8)
                arc(px, m1y - 2, sw * 0.4, 270, 180, stroke: curShip.sail, width: 2.4, cap: round)
                line(px - sw * 0.55, m2y, px + sw * 0.55, m2y, stroke: #1c1008, width: 2)
                arc(px, m2y - 2, sw * 0.52, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
                line(px - sw * 0.38, m3y, px + sw * 0.38, m3y, stroke: #1c1008, width: 1.8)
                arc(px, m3y - 2, sw * 0.35, 270, 180, stroke: curShip.sail, width: 2.2, cap: round)
              } else {
                line(px - sw * 0.48, m1y, px + sw * 0.48, m1y, stroke: #1c1008, width: 2)
                arc(px, m1y - 2, sw * 0.45, 270, 180, stroke: curShip.sail, width: 2.6, cap: round)
                line(px - sw * 0.62, m2y, px + sw * 0.62, m2y, stroke: #1c1008, width: 2.2)
                arc(px, m2y - 3, sw * 0.6, 270, 180, stroke: curShip.sail, width: 3.2, cap: round)
                line(px - sw * 0.44, m3y, px + sw * 0.44, m3y, stroke: #1c1008, width: 1.8)
                arc(px, m3y - 2, sw * 0.4, 270, 180, stroke: curShip.sail, width: 2.4, cap: round)
              }
            }
          }

          // ---------------- ENEMY SHIP CRUISING BY ----------------
          if enemyNearby {
            let es = SHIPS[enemyShipIdx]
            let ex = width * 0.78
            let ey = height * 0.32 + sin(seaScroll * 0.1) * 6
            let elen = es.len
            let ew = es.w

            // Corsair Hull
            if es.style == "junk" {
              path([
                [ex - ew * 0.36, ey - elen * 0.5],
                [ex + ew * 0.36, ey - elen * 0.5],
                [ex + ew * 0.5, ey - elen * 0.15],
                [ex + ew * 0.5, ey + elen * 0.32],
                [ex + ew * 0.38, ey + elen * 0.5],
                [ex - ew * 0.38, ey + elen * 0.5],
                [ex - ew * 0.5, ey + elen * 0.32],
                [ex - ew * 0.5, ey - elen * 0.15]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
            } else if es.style == "longship" {
              path([
                [ex, ey - elen * 0.55],
                [ex + ew * 0.48, ey - elen * 0.1],
                [ex + ew * 0.48, ey + elen * 0.1],
                [ex, ey + elen * 0.55],
                [ex - ew * 0.48, ey + elen * 0.1],
                [ex - ew * 0.48, ey - elen * 0.1]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
              for o in [-0.22, -0.07, 0.07, 0.22] {
                line(ex - ew * 0.45, ey + elen * o, ex - ew * 0.9, ey + elen * o + 3, stroke: #7f1d1d, width: 1.2)
                line(ex + ew * 0.45, ey + elen * o, ex + ew * 0.9, ey + elen * o + 3, stroke: #7f1d1d, width: 1.2)
              }
            } else if es.style == "dhow" || es.style == "xebec" {
              path([
                [ex, ey - elen * 0.6],
                [ex + ew * 0.5, ey - elen * 0.15],
                [ex + ew * 0.45, ey + elen * 0.32],
                [ex + ew * 0.28, ey + elen * 0.5],
                [ex - ew * 0.28, ey + elen * 0.5],
                [ex - ew * 0.45, ey + elen * 0.32],
                [ex - ew * 0.5, ey - elen * 0.15]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
            } else {
              path([
                [ex, ey - elen * 0.55],
                [ex + ew * 0.5, ey - elen * 0.2],
                [ex + ew * 0.5, ey + elen * 0.3],
                [ex + ew * 0.35, ey + elen * 0.5],
                [ex - ew * 0.35, ey + elen * 0.5],
                [ex - ew * 0.5, ey + elen * 0.3],
                [ex - ew * 0.5, ey - elen * 0.2]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
            }

            if es.style == "cutter" || es.style == "xebec" || es.style == "frigate" || es.style == "grand_frigate" || es.style == "galleon" {
              line(ex, ey - elen * 0.52, ex, ey - elen * 0.68, stroke: #450a0a, width: 1.5)
            }
            if es.style == "galleon" || es.style == "frigate" || es.style == "grand_frigate" {
              rect(ex - ew * 0.38, ey + elen * 0.36, ew * 0.76, elen * 0.12, radius: 1, fill: #310808, stroke: #591010, width: 1.2)
            }

            // Black sails
            if es.masts == 1 {
              line(ex - ew * 0.6, ey, ex + ew * 0.6, ey, stroke: #000000, width: 2)
              arc(ex, ey - 3, ew * 0.55, 270, 180, stroke: #1c1917, width: 3, cap: round)
            } else if es.masts == 2 {
              let em1y = ey - elen * 0.18
              let em2y = ey + elen * 0.16
              if es.style == "dhow" || es.style == "baghlah" {
                line(ex - ew * 0.52, em1y + 4, ex + ew * 0.52, em1y - 6, stroke: #000000, width: 2)
                line(ex - ew * 0.46, em1y + 3, ex + ew * 0.46, em1y - 5, stroke: #1c1917, width: 2.8, cap: round)
                line(ex - ew * 0.58, em2y + 5, ex + ew * 0.58, em2y - 7, stroke: #000000, width: 2)
                line(ex - ew * 0.52, em2y + 4, ex + ew * 0.52, em2y - 6, stroke: #1c1917, width: 3.2, cap: round)
              } else {
                line(ex - ew * 0.52, em1y, ex + ew * 0.52, em1y, stroke: #000000, width: 2)
                arc(ex, em1y - 2, ew * 0.48, 270, 180, stroke: #1c1917, width: 2.6, cap: round)
                line(ex - ew * 0.62, em2y, ex + ew * 0.62, em2y, stroke: #000000, width: 2)
                arc(ex, em2y - 3, ew * 0.58, 270, 180, stroke: #1c1917, width: 3.2, cap: round)
              }
            } else {
              let em1y = ey - elen * 0.25
              let em2y = ey
              let em3y = ey + elen * 0.24
              line(ex - ew * 0.48, em1y, ex + ew * 0.48, em1y, stroke: #000000, width: 1.8)
              arc(ex, em1y - 2, ew * 0.45, 270, 180, stroke: #1c1917, width: 2.5, cap: round)
              line(ex - ew * 0.62, em2y, ex + ew * 0.62, em2y, stroke: #000000, width: 2)
              arc(ex, em2y - 3, ew * 0.6, 270, 180, stroke: #1c1917, width: 3, cap: round)
              line(ex - ew * 0.44, em3y, ex + ew * 0.44, em3y, stroke: #000000, width: 1.8)
              arc(ex, em3y - 2, ew * 0.4, 270, 180, stroke: #1c1917, width: 2.4, cap: round)
            }

            text("CORSAIR", ex, ey - elen * 0.7, size: 7, bold: true, align: center, color: #ef4444)
          }

          // ---------------- SEMICIRCLE GAUGES (AT BOTTOM) ----------------
          let gY = height - 28
          let r = min(width * 0.11, 21)

          // 1. SPEED GAUGE (bone white, more is better)
          let cx1 = width * 0.2
          arc(cx1, gY, r, 270, 180, stroke: alpha(foreground, 0.15), width: 4.5, cap: round)
          if effSpeed > 0.01 {
            arc(cx1, gY, r, 270, clamp(effSpeed * 180, 2, 180), stroke: #f4ecd8, width: 4.5, cap: round)
          }
          text("${round(effSpeed * 100)}%", cx1, gY - 3, size: 8.5, bold: true, align: center, color: #f4ecd8)
          text("SPEED", cx1, gY + 11, size: 7, bold: true, align: center, color: muted)

          // 2. WATER GAUGE (blue, less is better)
          let cx2 = width * 0.5
          arc(cx2, gY, r, 270, 180, stroke: alpha(foreground, 0.15), width: 4.5, cap: round)
          if water > 0.5 {
            arc(cx2, gY, r, 270, clamp((water / 100.0) * 180, 2, 180), stroke: #38bdf8, width: 4.5, cap: round)
          }
          text("${round(water)}%", cx2, gY - 3, size: 8.5, bold: true, align: center, color: #38bdf8)
          text("WATER", cx2, gY + 11, size: 7, bold: true, align: center, color: muted)

          // 3. DAMAGE GAUGE (red, less is better)
          let cx3 = width * 0.8
          arc(cx3, gY, r, 270, 180, stroke: alpha(foreground, 0.15), width: 4.5, cap: round)
          if damage > 0.5 {
            arc(cx3, gY, r, 270, clamp((damage / 100.0) * 180, 2, 180), stroke: #ef4444, width: 4.5, cap: round)
          }
          text("${round(damage)}%", cx3, gY - 3, size: 8.5, bold: true, align: center, color: #ef4444)
          text("DAMAGE", cx3, gY + 11, size: 7, bold: true, align: center, color: muted)
        }

        // Overlay Headers and Controls
        Column {
          fill: true
          padding: 6

          // Top Info Row
          Row {
            fill: width
            align: center
            background: alpha(#09131f, 0.88)
            padding: [6, 4]
            radius: 4

            Text { text: "${destIsland} (${destDirection}) • ⏱ ${etaClock} (${round(leaguesRemaining, 1)}/${totalLeagues} lgs)"; fontSize: 11; bold: true; color: foreground; weight: 1 }
            Text { text: "${fmtNum(poe)} PoE"; fontSize: 11; bold: true; color: #fbbf24 }
          }

          Spacer { weight: 1 }

          // Bottom Pillage Window Bar (above gauges)
          if enemyNearby {
            Row {
              fill: width
              align: center
              background: alpha(#1c1917, 0.92)
              padding: [6, 4]
              radius: 4
              gap: 6

              Column {
                weight: 1
                gap: 1
                Text { text: "⚔ ${SHIPS[enemyShipIdx].name} (${round(enemyTimer)}s)"; fontSize: 11; bold: true; color: #f59e0b }
                Progress { value: enemyTimer; max: 8.0; color: yellow }
              }

              Button {
                text: "⚔ PILLAGE"
                color: red
                onTap: {
                  let maxHp = curShip != null ? curShip.hp : 100
                  playerHp = clamp(round(maxHp * (1.0 - damage / 100.0)), 1, maxHp)
                  let maxC = curShip != null ? curShip.cannons : 4
                  loadedCannons = clamp(loadedCannons, 0.0, maxC)
                  enemyHp = SHIPS[enemyShipIdx].hp
                  enemyMaxHp = SHIPS[enemyShipIdx].hp
                  turnTimer = 3.0
                  playerAction = ""
                  playerX = W * 0.5
                  playerY = H * 0.68
                  playerAngle = 0.0
                  enemyX = W * 0.5
                  enemyY = H * 0.28
                  enemyAngle = 180.0
                  battleLog = "Corsair engaged! Choose action:"
                  view = "battle"
                }
              }
            }
          }

          // Clearance for bottom semicircle gauges
          Spacer { height: 44 }
        }
      }
    }

    // ==========================================
    // VIEW 5: BATTLE MODE (3S TURNS & BROADSIDES)
    // ==========================================
    if view == "battle" {
      Column {
        fill: true
        padding: 6
        gap: 4

        // Battle HUD Top
        Row {
          fill: width
          align: center
          background: alpha(#0f172a, 0.85)
          padding: 4
          radius: 4
          gap: 6

          Column {
            weight: 1
            gap: 1
            Text { text: "${SHIPS[enemyShipIdx].name} (${enemyHp}/${enemyMaxHp})"; style: small; bold: true; color: #ef4444 }
            Progress { value: enemyHp; max: enemyMaxHp; color: red }
          }
          Column {
            weight: 1
            gap: 1
            Text { text: "Hull (${playerHp}/${curShip.hp}) • ${floor(loadedCannons)} Cannons"; style: small; bold: true; color: #10b981 }
            Progress { value: playerHp; max: curShip.hp; color: green }
          }
        }

        // Tactical Water Arena
        Canvas {
          fill: width
          weight: 1

          rect(0, 0, width, height, radius: 6, fill: #0f2742)

          let ex = width * 0.5
          let ey = height * 0.24
          let px = width * 0.5
          let py = height * 0.72

          // Cannonball fire effects
          if cannonAnim > 0 {
            circle(px - 22, py, 3.5, fill: #fbbf24)
            circle(px + 22, py, 3.5, fill: #fbbf24)
            circle(ex - 18, ey, 3.5, fill: #ef4444)
            circle(ex + 18, ey, 3.5, fill: #ef4444)
          }

          // Enemy Ship Top-Down
          rotate(enemyAngle, ex, ey) {
            let es = SHIPS[enemyShipIdx]
            let elen = es.len
            let ew = es.w

            // Corsair Hull
            if es.style == "junk" {
              path([
                [ex - ew * 0.36, ey - elen * 0.5],
                [ex + ew * 0.36, ey - elen * 0.5],
                [ex + ew * 0.5, ey - elen * 0.15],
                [ex + ew * 0.5, ey + elen * 0.32],
                [ex + ew * 0.38, ey + elen * 0.5],
                [ex - ew * 0.38, ey + elen * 0.5],
                [ex - ew * 0.5, ey + elen * 0.32],
                [ex - ew * 0.5, ey - elen * 0.15]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
            } else if es.style == "longship" {
              path([
                [ex, ey - elen * 0.55],
                [ex + ew * 0.48, ey - elen * 0.1],
                [ex + ew * 0.48, ey + elen * 0.1],
                [ex, ey + elen * 0.55],
                [ex - ew * 0.48, ey + elen * 0.1],
                [ex - ew * 0.48, ey - elen * 0.1]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
              for o in [-0.22, -0.07, 0.07, 0.22] {
                line(ex - ew * 0.45, ey + elen * o, ex - ew * 0.9, ey + elen * o + 3, stroke: #7f1d1d, width: 1.2)
                line(ex + ew * 0.45, ey + elen * o, ex + ew * 0.9, ey + elen * o + 3, stroke: #7f1d1d, width: 1.2)
              }
            } else if es.style == "dhow" || es.style == "xebec" {
              path([
                [ex, ey - elen * 0.6],
                [ex + ew * 0.5, ey - elen * 0.15],
                [ex + ew * 0.45, ey + elen * 0.32],
                [ex + ew * 0.28, ey + elen * 0.5],
                [ex - ew * 0.28, ey + elen * 0.5],
                [ex - ew * 0.45, ey + elen * 0.32],
                [ex - ew * 0.5, ey - elen * 0.15]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
            } else {
              path([
                [ex, ey - elen * 0.55],
                [ex + ew * 0.5, ey - elen * 0.2],
                [ex + ew * 0.5, ey + elen * 0.3],
                [ex + ew * 0.35, ey + elen * 0.5],
                [ex - ew * 0.35, ey + elen * 0.5],
                [ex - ew * 0.5, ey + elen * 0.3],
                [ex - ew * 0.5, ey - elen * 0.2]
              ], closed: true, fill: #7f1d1d, stroke: #450a0a, width: 1.5)
            }

            if es.style == "cutter" || es.style == "xebec" || es.style == "frigate" || es.style == "grand_frigate" || es.style == "galleon" {
              line(ex, ey - elen * 0.52, ex, ey - elen * 0.68, stroke: #450a0a, width: 1.5)
            }
            if es.style == "galleon" || es.style == "frigate" || es.style == "grand_frigate" {
              rect(ex - ew * 0.38, ey + elen * 0.36, ew * 0.76, elen * 0.12, radius: 1, fill: #310808, stroke: #591010, width: 1.2)
            }

            // Black sails
            if es.masts == 1 {
              line(ex - ew * 0.6, ey, ex + ew * 0.6, ey, stroke: #000000, width: 2)
              arc(ex, ey - 3, ew * 0.55, 270, 180, stroke: #1c1917, width: 3, cap: round)
            } else if es.masts == 2 {
              let em1y = ey - elen * 0.18
              let em2y = ey + elen * 0.16
              if es.style == "dhow" || es.style == "baghlah" {
                line(ex - ew * 0.52, em1y + 4, ex + ew * 0.52, em1y - 6, stroke: #000000, width: 2)
                line(ex - ew * 0.46, em1y + 3, ex + ew * 0.46, em1y - 5, stroke: #1c1917, width: 2.8, cap: round)
                line(ex - ew * 0.58, em2y + 5, ex + ew * 0.58, em2y - 7, stroke: #000000, width: 2)
                line(ex - ew * 0.52, em2y + 4, ex + ew * 0.52, em2y - 6, stroke: #1c1917, width: 3.2, cap: round)
              } else {
                line(ex - ew * 0.52, em1y, ex + ew * 0.52, em1y, stroke: #000000, width: 2)
                arc(ex, em1y - 2, ew * 0.48, 270, 180, stroke: #1c1917, width: 2.6, cap: round)
                line(ex - ew * 0.62, em2y, ex + ew * 0.62, em2y, stroke: #000000, width: 2)
                arc(ex, em2y - 3, ew * 0.58, 270, 180, stroke: #1c1917, width: 3.2, cap: round)
              }
            } else {
              let em1y = ey - elen * 0.25
              let em2y = ey
              let em3y = ey + elen * 0.24
              line(ex - ew * 0.48, em1y, ex + ew * 0.48, em1y, stroke: #000000, width: 1.8)
              arc(ex, em1y - 2, ew * 0.45, 270, 180, stroke: #1c1917, width: 2.5, cap: round)
              line(ex - ew * 0.62, em2y, ex + ew * 0.62, em2y, stroke: #000000, width: 2)
              arc(ex, em2y - 3, ew * 0.6, 270, 180, stroke: #1c1917, width: 3, cap: round)
              line(ex - ew * 0.44, em3y, ex + ew * 0.44, em3y, stroke: #000000, width: 1.8)
              arc(ex, em3y - 2, ew * 0.4, 270, 180, stroke: #1c1917, width: 2.4, cap: round)
            }
          }

          // Player Ship Top-Down
          rotate(playerAngle, px, py) {
            let slen = curShip.len
            let sw = curShip.w

            // Hull
            if curShip.style == "junk" {
              path([
                [px - sw * 0.36, py - slen * 0.5],
                [px + sw * 0.36, py - slen * 0.5],
                [px + sw * 0.5, py - slen * 0.15],
                [px + sw * 0.5, py + slen * 0.32],
                [px + sw * 0.38, py + slen * 0.5],
                [px - sw * 0.38, py + slen * 0.5],
                [px - sw * 0.5, py + slen * 0.32],
                [px - sw * 0.5, py - slen * 0.15]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            } else if curShip.style == "longship" {
              path([
                [px, py - slen * 0.55],
                [px + sw * 0.48, py - slen * 0.1],
                [px + sw * 0.48, py + slen * 0.1],
                [px, py + slen * 0.55],
                [px - sw * 0.48, py + slen * 0.1],
                [px - sw * 0.48, py - slen * 0.1]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
              for o in [-0.22, -0.07, 0.07, 0.22] {
                line(px - sw * 0.45, py + slen * o, px - sw * 0.9, py + slen * o + 3, stroke: #cdaa7d, width: 1.2)
                line(px + sw * 0.45, py + slen * o, px + sw * 0.9, py + slen * o + 3, stroke: #cdaa7d, width: 1.2)
              }
            } else if curShip.style == "dhow" || curShip.style == "xebec" {
              path([
                [px, py - slen * 0.6],
                [px + sw * 0.5, py - slen * 0.15],
                [px + sw * 0.45, py + slen * 0.32],
                [px + sw * 0.28, py + slen * 0.5],
                [px - sw * 0.28, py + slen * 0.5],
                [px - sw * 0.45, py + slen * 0.32],
                [px - sw * 0.5, py - slen * 0.15]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            } else {
              path([
                [px, py - slen * 0.55],
                [px + sw * 0.5, py - slen * 0.2],
                [px + sw * 0.5, py + slen * 0.3],
                [px + sw * 0.35, py + slen * 0.5],
                [px - sw * 0.35, py + slen * 0.5],
                [px - sw * 0.5, py + slen * 0.3],
                [px - sw * 0.5, py - slen * 0.2]
              ], closed: true, fill: curShip.hull, stroke: #1a0f07, width: 1.5)
            }

            if curShip.style == "cutter" || curShip.style == "xebec" || curShip.style == "frigate" || curShip.style == "grand_frigate" || curShip.style == "galleon" {
              line(px, py - slen * 0.52, px, py - slen * 0.68, stroke: #1a0f07, width: 1.5)
            }
            if curShip.style == "galleon" || curShip.style == "frigate" || curShip.style == "grand_frigate" {
              rect(px - sw * 0.38, py + slen * 0.36, sw * 0.76, slen * 0.12, radius: 1, fill: #201309, stroke: (curShip.style == "grand_frigate" ? #fbbf24 : #3a220d), width: 1.2)
            }
            if curShip.cannons >= 16 {
              for cp in [-0.2, 0.0, 0.2] {
                circle(px - sw * 0.48, py + slen * cp, 1.2, fill: #000000)
                circle(px + sw * 0.48, py + slen * cp, 1.2, fill: #000000)
              }
            }

            // Deck
            rect(px - sw * 0.32, py - slen * 0.3, sw * 0.64, slen * 0.58, radius: 2, fill: curShip.deck)

            // Masts & Sails
            if curShip.masts == 1 {
              circle(px, py, 2.5, fill: #1c1008)
              line(px - sw * 0.6, py, px + sw * 0.6, py, stroke: #1c1008, width: 2)
              arc(px, py - 3, sw * 0.55, 270, 180, stroke: curShip.sail, width: 3, cap: round)
            } else if curShip.masts == 2 {
              let m1y = py - slen * 0.18
              let m2y = py + slen * 0.16
              circle(px, m1y, 2, fill: #1c1008)
              circle(px, m2y, 2.3, fill: #1c1008)
              if curShip.style == "dhow" || curShip.style == "baghlah" {
                line(px - sw * 0.52, m1y + 4, px + sw * 0.52, m1y - 6, stroke: #1c1008, width: 2)
                line(px - sw * 0.46, m1y + 3, px + sw * 0.46, m1y - 5, stroke: curShip.sail, width: 2.8, cap: round)
                line(px - sw * 0.58, m2y + 5, px + sw * 0.58, m2y - 7, stroke: #1c1008, width: 2)
                line(px - sw * 0.52, m2y + 4, px + sw * 0.52, m2y - 6, stroke: curShip.sail, width: 3.2, cap: round)
              } else if curShip.style == "junk" {
                line(px - sw * 0.48, m1y, px + sw * 0.48, m1y, stroke: #1c1008, width: 2)
                arc(px, m1y - 2, sw * 0.45, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
                line(px - sw * 0.38, m1y - 2, px + sw * 0.38, m1y - 2, stroke: #3a1505, width: 1)
                line(px - sw * 0.55, m2y, px + sw * 0.55, m2y, stroke: #1c1008, width: 2)
                arc(px, m2y - 2, sw * 0.52, 270, 180, stroke: curShip.sail, width: 3, cap: round)
                line(px - sw * 0.45, m2y - 2, px + sw * 0.45, m2y - 2, stroke: #3a1505, width: 1)
              } else {
                line(px - sw * 0.52, m1y, px + sw * 0.52, m1y, stroke: #1c1008, width: 2)
                arc(px, m1y - 2, sw * 0.48, 270, 180, stroke: curShip.sail, width: 2.6, cap: round)
                line(px - sw * 0.62, m2y, px + sw * 0.62, m2y, stroke: #1c1008, width: 2)
                arc(px, m2y - 3, sw * 0.58, 270, 180, stroke: curShip.sail, width: 3.2, cap: round)
              }
            } else {
              let m1y = py - slen * 0.25
              let m2y = py
              let m3y = py + slen * 0.24
              circle(px, m1y, 2, fill: #1c1008)
              circle(px, m2y, 2.5, fill: #1c1008)
              circle(px, m3y, 1.8, fill: #1c1008)
              if curShip.style == "xebec" {
                line(px - sw * 0.45, m1y + 3, px + sw * 0.45, m1y - 5, stroke: #1c1008, width: 1.8)
                line(px - sw * 0.4, m1y + 2, px + sw * 0.4, m1y - 4, stroke: curShip.sail, width: 2.5, cap: round)
                line(px - sw * 0.55, m2y + 4, px + sw * 0.55, m2y - 6, stroke: #1c1008, width: 2)
                line(px - sw * 0.5, m2y + 3, px + sw * 0.5, m2y - 5, stroke: curShip.sail, width: 3, cap: round)
                line(px - sw * 0.4, m3y + 3, px + sw * 0.4, m3y - 5, stroke: #1c1008, width: 1.8)
                line(px - sw * 0.35, m3y + 2, px + sw * 0.35, m3y - 4, stroke: curShip.sail, width: 2.2, cap: round)
              } else if curShip.style == "junk" {
                line(px - sw * 0.42, m1y, px + sw * 0.42, m1y, stroke: #1c1008, width: 1.8)
                arc(px, m1y - 2, sw * 0.4, 270, 180, stroke: curShip.sail, width: 2.4, cap: round)
                line(px - sw * 0.55, m2y, px + sw * 0.55, m2y, stroke: #1c1008, width: 2)
                arc(px, m2y - 2, sw * 0.52, 270, 180, stroke: curShip.sail, width: 2.8, cap: round)
                line(px - sw * 0.38, m3y, px + sw * 0.38, m3y, stroke: #1c1008, width: 1.8)
                arc(px, m3y - 2, sw * 0.35, 270, 180, stroke: curShip.sail, width: 2.2, cap: round)
              } else {
                line(px - sw * 0.48, m1y, px + sw * 0.48, m1y, stroke: #1c1008, width: 2)
                arc(px, m1y - 2, sw * 0.45, 270, 180, stroke: curShip.sail, width: 2.6, cap: round)
                line(px - sw * 0.62, m2y, px + sw * 0.62, m2y, stroke: #1c1008, width: 2.2)
                arc(px, m2y - 3, sw * 0.6, 270, 180, stroke: curShip.sail, width: 3.2, cap: round)
                line(px - sw * 0.44, m3y, px + sw * 0.44, m3y, stroke: #1c1008, width: 1.8)
                arc(px, m3y - 2, sw * 0.4, 270, 180, stroke: curShip.sail, width: 2.4, cap: round)
              }
            }
          }

          // Broadside guide lines
          rotate(playerAngle, px, py) {
            line(px - 40, py, px - curShip.w * 0.6, py, stroke: alpha(#fbbf24, 0.4), width: 1)
            line(px + curShip.w * 0.6, py, px + 40, py, stroke: alpha(#fbbf24, 0.4), width: 1)
          }
        }

        // Battle Log & Timer Bar
        Row {
          fill: width
          align: center
          Text { text: battleLog; style: small; bold: true; color: #fbbf24; weight: 1 }
          Text { text: "${round(turnTimer, 1)}s"; style: small; color: muted }
        }

        // Yellow Turn Decreasing Bar
        Progress {
          value: turnTimer
          max: 3.0
          color: yellow
        }

        // Action Buttons Row
        Row {
          fill: width
          gap: 5
          Box {
            weight: 1
            height: 38
            align: center
            radius: 6
            background: playerAction == "L" ? #0284c7 : alpha(#0f172a, 0.85)
            border: playerAction == "L" ? 2 : 1
            borderColor: playerAction == "L" ? #38bdf8 : alpha(#38bdf8, 0.45)
            onTap: { playerAction = playerAction == "L" ? "" : "L"; sound(sndMove) }
            Text {
              text: "↰"
              fontSize: 22
              bold: true
              align: center
              color: playerAction == "L" ? #ffffff : #38bdf8
            }
          }
          Box {
            weight: 1
            height: 38
            align: center
            radius: 6
            background: playerAction == "F" ? #15803d : alpha(#0f172a, 0.85)
            border: playerAction == "F" ? 2 : 1
            borderColor: playerAction == "F" ? #4ade80 : alpha(#4ade80, 0.45)
            onTap: { playerAction = playerAction == "F" ? "" : "F"; sound(sndMove) }
            Text {
              text: "↑"
              fontSize: 22
              bold: true
              align: center
              color: playerAction == "F" ? #ffffff : #4ade80
            }
          }
          Box {
            weight: 1
            height: 38
            align: center
            radius: 6
            background: playerAction == "R" ? #b45309 : alpha(#0f172a, 0.85)
            border: playerAction == "R" ? 2 : 1
            borderColor: playerAction == "R" ? #fbbf24 : alpha(#fbbf24, 0.45)
            onTap: { playerAction = playerAction == "R" ? "" : "R"; sound(sndMove) }
            Text {
              text: "↱"
              fontSize: 22
              bold: true
              align: center
              color: playerAction == "R" ? #ffffff : #fbbf24
            }
          }
          let canShoot = floor(loadedCannons) >= 1
          Box {
            weight: 1.1
            height: 38
            align: center
            radius: 6
            background: !canShoot ? alpha(#1e293b, 0.5) : (playerAction == "shoot" ? #b91c1c : alpha(#0f172a, 0.85))
            border: (playerAction == "shoot" && canShoot) ? 2 : 1
            borderColor: !canShoot ? alpha(#475569, 0.3) : ((playerAction == "shoot" && canShoot) ? #f87171 : alpha(#ef4444, 0.45))
            onTap: {
              if canShoot {
                playerAction = playerAction == "shoot" ? "" : "shoot"
                sound(sndBoom)
              }
            }
            Text {
              text: "💥"
              fontSize: 20
              align: center
              color: !canShoot ? #475569 : #f87171
            }
          }
        }
      }
    }

    // ==========================================
    // VIEW 6: VICTORY SCREEN (GOLDEN SPARKS & POE)
    // ==========================================
    if view == "victory" {
      Box {
        fill: true

        // Sparks Canvas
        Canvas {
          fill: true
          rect(0, 0, width, height, fill: #0b1522)

          // Golden sparks
          for s in sparks {
            circle(s.x, s.y, clamp(s.life * 3.5, 1, 4), fill: s.color)
          }

          // Golden burst crown
          circle(width * 0.5, height * 0.22, 36, fill: alpha(#fbbf24, 0.2))
          circle(width * 0.5, height * 0.22, 24, fill: alpha(#f59e0b, 0.35))
          text("👑", width * 0.5, height * 0.22 - 4, size: 24, align: center)
        }

        Column {
          fill: true
          align: center
          justify: center
          padding: 8
          gap: 4

          Spacer { height: 55 }

          Text { text: "VICTORY AT SEA!"; fontSize: 16; bold: true; color: #fbbf24 }
          Text { text: "Plundered ${SHIPS[enemyShipIdx].name}!"; style: body; color: foreground }

          Spacer { weight: 1 }

          Text { text: "+${fmtNum(winPoeGained)} PoE Plundered!"; fontSize: 13; bold: true; color: #10b981 }
          Text { text: "${fmtNum(displayPoe)} PoE"; style: title; bold: true; color: #f59e0b }

          Spacer { weight: 1 }

          Button {
            text: "⛵ CONTINUE SAILING"
            color: accent
            fill: width
            onTap: {
              sound(sndCash)
              enemyNearby = false
              enemyTimer = 0.0
              enemySpawnTimer = random(14, 25)
              currentSpeed = 0.0
              view = "sailing"
            }
          }
        }
      }
    }

    // ==========================================
    // VIEW 7: DEFEAT SCREEN
    // ==========================================
    if view == "defeat" {
      Column {
        fill: true
        align: center
        justify: center
        padding: 16
        gap: 10

        Text { text: "💀 DEFEAT AT SEA"; style: title; bold: true; color: #ef4444 }
        Text { text: "Your ship took too much damage or took on water!"; align: center; color: muted }
        Text { text: "-${fmtNum(lossPenalty)} PoE taken by the corsairs"; bold: true; color: #fbbf24 }
        Text { text: "No free repairs: the yard fixes her in port (up to 1 min)"; style: small; align: center; color: muted }

        Spacer { height: 12 }

        Button {
          text: "⚓ LIMP BACK TO PORT"
          color: accent
          fill: width
          onTap: {
            sound(sndDefeatJingle)
            view = "island"
          }
        }
      }
    }

    // ==========================================
    // VIEW 8: UNCOLONIZED ISLAND TREASURE CHEST
    // ==========================================
    if view == "treasure" {
      Box {
        fill: true

        // Treasure Island Canvas with Opening Chest
        Canvas {
          fill: true

          // Sea & Island Sand
          rect(0, 0, width, height, fill: #0b1f33)
          circle(width * 0.5, height * 0.32, 54, fill: #d97706)
          circle(width * 0.5, height * 0.32, 46, fill: #fde047)

          // Golden rays radiating from open chest
          if chestAnim > 0.25 {
            circle(width * 0.5, height * 0.24, 25 * chestAnim, fill: alpha(#fbbf24, 0.45))
            circle(width * 0.5, height * 0.24, 15 * chestAnim, fill: alpha(#fef08a, 0.6))
          }

          // Chest Base
          let bx = width * 0.5
          let by = height * 0.26
          rect(bx - 24, by, 48, 25, radius: 4, fill: #78350f, stroke: #451a03, width: 2)
          line(bx - 24, by + 9, bx + 24, by + 9, stroke: #fbbf24, width: 2)
          circle(bx, by + 9, 3, fill: #fbbf24)

          // Chest Lid with rotation opening animation
          let lidAngle = chestAnim * -65
          rotate(lidAngle, bx - 24, by) {
            rect(bx - 25, by - 11, 50, 11, radius: 4, fill: #92400e, stroke: #451a03, width: 2)
            line(bx - 25, by - 5, bx + 25, by - 5, stroke: #fbbf24, width: 2)
          }
        }

        Column {
          fill: true
          align: center
          justify: center
          padding: 8
          gap: 2

          Text { text: "🏝 UNCOLONIZED HAVEN"; style: small; bold: true; color: #f59e0b }
          Text { text: currentIsland; fontSize: 13; bold: true; color: foreground }

          Spacer { height: 50 }

          Text { text: "+${fmtNum(treasureVal)}"; style: huge; bold: true; color: #fbbf24 }
          Text { text: "Buried treasure to fund your fleet upgrades!"; style: small; color: muted }

          Spacer { weight: 1 }

          Button {
            text: "COLLECT & CHART COURSE"
            color: accent
            fill: width
            onTap: {
              sound(sndCash)
              poe = poe + treasureVal
              view = "chart"
            }
          }
        }
      }
    }
  }

  // Full-screen Screen View
  screen {
    title: "Yohoho! Sailing Game"
    Column {
      scroll: true
      padding: 16
      gap: 12

      Text { text: "Emerald Ocean Cartography"; style: title; bold: true }
      Text { text: "Current Port: ${currentIsland} (${islArch} Archipelago)"; color: muted }
      Text { text: "${curShip != null ? curShip.name : "None"} • ${fmtNum(poe)} PoE"; color: accent; bold: true }

      Row {
        gap: 8
        Button { text: "Shipyard"; onTap: { view = "shop"; close() } }
        Button { text: "Chart Course"; onTap: { view = "chart"; close() } }
      }

      Button { text: "Close Screen"; color: muted; onTap: { close() } }
    }
  }
}
