widget "sailing" {
  meta {
    owl: 23
    description: "Puzzle Pirates Emerald Ocean sailing adventure: command ships, sail between islands, battle corsairs with 3s broadside turns, and find island treasures"
    version: "1.0"
    license: "MIT"
    category: "games"
  }
  page: 1
  order: 4
  size: 3x3
  minSize: 3x3
  padding: 0

  requires { pacman: ["jq", "grep", "coreutils"] }

  // Audio sound effects
  asset sndBoom = base64""
  asset sndMove = base64""
  asset sndCash = base64""
  asset sndCoins = base64""
  asset sndDefeatJingle = base64""


  // The Emerald Ocean's islands: archipelago, colonized, and the routes to their neighbours
  let ISLANDS = {"Accompong Island":{"archipelago":"Pleiades","colonized":true,"connections":[{"destination":"Gallows Island","distance_leagues":4,"direction":"West"},{"destination":"Iocane Island","distance_leagues":4,"direction":"North-East"},{"destination":"Toba Island","distance_leagues":8,"direction":"South-West"}]},"Admiral Island":{"archipelago":"Gull","colonized":true,"connections":[{"destination":"Basset Island","distance_leagues":5,"direction":"North-West"},{"destination":"Isle of Kent","distance_leagues":6,"direction":"South"},{"destination":"Scrimshaw Island","distance_leagues":6,"direction":"North-East"},{"destination":"Wensleydale","distance_leagues":3,"direction":"South-West"}]},"Aimuari Island":{"archipelago":"Orion","colonized":true,"connections":[{"destination":"Matariki Island","distance_leagues":2,"direction":"North-East"},{"destination":"Pukru Island","distance_leagues":2,"direction":"South-West"}]},"Albatross Island":{"archipelago":"Osprey","colonized":true,"connections":[{"destination":"Deadlight Dunes","distance_leagues":5,"direction":"West"},{"destination":"Gauntlet Island","distance_leagues":4,"direction":"South-West"},{"destination":"Mirage Island","distance_leagues":8,"direction":"North-West"}]},"Alkaid Island":{"archipelago":"Ursa","colonized":true,"connections":[{"destination":"McGuffin's Isle","distance_leagues":4,"direction":"South-East"},{"destination":"The Beaufort Islands","distance_leagues":7,"direction":"North-East"}]},"Ambush Island":{"archipelago":"Osprey","colonized":true,"connections":[{"destination":"Jack's Last Gift","distance_leagues":6,"direction":"South"},{"destination":"Mirage Island","distance_leagues":6,"direction":"South-East"},{"destination":"Scurvy Reef","distance_leagues":3,"direction":"North-West"}]},"Amity Island":{"archipelago":"Stork","colonized":true,"connections":[{"destination":"Penobscot Island","distance_leagues":3,"direction":"South-East"},{"destination":"Rowes Island","distance_leagues":3,"direction":"N