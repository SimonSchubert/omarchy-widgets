widget "cdm-review" {
  meta { owl: 12; description: "Native CDM gate and question review with bounded offline text and browser-approved pairing"; version: "1.2"; license: "MIT"; category: "productivity" }
  size: 6x4
  minSize: 3x3

  // One deployment origin. Editing it deliberately invalidates OWL's origin-bound secrets;
  // pair again after changing it. No token or browser cookie is ever pasted into this file.
  let api = "https://ai.cdm.space"

  state token = null secret
  state pairToken = null secret
  state account = null persist
  state deviceId = null persist
  state retiredDeviceIds = [] persist
  state authGeneration = 0 persist
  state authPending = false persist
  state verifyChecks = 0
  state authNotice = ""
  state pairAttempt = 0
  state pairStart = null
  state pairStartAttempt = -1
  state pairStartSeq = 0
  state pairPoll = null
  state pairPollAttempt = -1
  state pairPollSeq = 0
  state pairRequest = null persist
  state pairing = false
  state pairStarting = false
  state pairPolling = false
  state pairStatus = ""

  state lastQueue = null persist
  state hidden = [] persist
  state drafts = {} persist
  state draftBases = {} persist
  // At most six plaintext presentation snapshots. HTML/images/bytes are never copied here.
  state details = [] persist
  state conflicts = {} persist
  state itemErrors = {} persist
  state current = null persist
  state tab = "review"

  // Each action slot keeps one frozen request until its response (or the 30 s post timeout) is
  // consumed. A unique sequence value makes the completion observable even when two responses
  // are structurally equal, and even if Compose coalesces a reset with its completion.
  state seq0 = 0
  state res0 = null
  state tgt0 = null persist
  state live0 = false

  state seq1 = 0
  state res1 = null
  state tgt1 = null persist
  state live1 = false

  state seq2 = 0
  state res2 = null
  state tgt2 = null persist
  state live2 = false

  state seq3 = 0
  state res3 = null
  state tgt3 = null persist
  state live3 = false

  let snapshotReceiptTools = ["onec_receipt_create", "onec_receipt_update", "onec_receipt_update_edited"]
  let generationLabel = "${int(authGeneration)}"

  // Generation in every URL forces a new read after re-pair; the response envelope must prove
  // that same generation plus the verified account/device and exact item before any application.
  source me = http(token == null ? null : "${api}/api/native/me?native_generation=${int(authGeneration)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source q = http(token == null || account == null || authPending ? null : "${api}/api/native/review-queue?limit=50&native_generation=${int(authGeneration)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 30s json status

  source e = http(token == null || authPending || current == null ? null : current.key.kind == "gate" ? "${api}/api/swarms/${enc(current.key.pack)}/gates/${enc(current.key.id)}?native_generation=${int(authGeneration)}" : "${api}/api/swarms/${enc(current.key.pack)}/asks/${enc(current.key.id)}?native_generation=${int(authGeneration)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source r = http(token == null || authPending || current == null || current.key.kind != "gate" ? null : "${api}/api/swarms/${enc(current.key.pack)}/gates/${enc(current.key.id)}/review?native_generation=${int(authGeneration)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source c = http(token == null || authPending || current == null || current.key.kind != "gate" || !contains(snapshotReceiptTools, current.tool_name ?? "") ? null : "${api}/api/swarms/${enc(current.key.pack)}/gates/${enc(current.key.id)}/receipt?native_generation=${int(authGeneration)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source o = http(token == null || authPending || current == null ? null : "${api}/api/swarms/${enc(current.key.pack)}/operator-state/${enc(current.key.kind)}/${enc(current.key.id)}?native_generation=${int(authGeneration)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status

  let blank = {text: "", picks: [], reason: "", postmortem: false, mode: "normal"}
  let meBinding = me != null && me.out != null ? me.out.phone_binding : null
  let meBound = me != null && meBinding != null && meBinding.generation == generationLabel && meBinding.account != null && meBinding.device_id != null && (authPending || (meBinding.account == account && meBinding.device_id == deviceId)) && (!me.ok || (me.out.user != null && me.out.device != null && me.out.user.id == meBinding.account && me.out.device.id == meBinding.device_id))
  let queueValid = q != null && q.ok && q.out != null && account != null && q.out.phone_binding != null && q.out.phone_binding.generation == generationLabel && q.out.phone_binding.account == account && q.out.phone_binding.device_id == deviceId && q.out.account == account && q.out.device_id == deviceId
  let cachedQueue = lastQueue != null && lastQueue.account == account ? lastQueue : null
  let queue = queueValid ? q.out : cachedQueue
  let qItems = (queue ?? {}).items ?? []
  let problems = (queue ?? {}).problems ?? []
  let visibleItems = qItems.filter(item => !hidden.any(k => k == item.key))
  let targets = [tgt0, tgt1, tgt2, tgt3]
  let results = [res0, res1, res2, res3]
  let lives = [live0, live1, live2, live3]
  let poolFree = targets.any(t => t == null)
  let activityCount = len(targets.filter(t => t != null && t.account == account))
  let retiredCount = len(targets.filter(t => t != null && t.account != account))
  let currentId = current == null || account == null ? "" : toJson({account: account, key: current.key})
  let currentIndex = current == null ? -1 : indexOf(visibleItems.map(item => toJson(item.key)), toJson(current.key))
  let nextItem = current == null ? null : currentIndex >= 0 && currentIndex + 1 < len(visibleItems) ? visibleItems[currentIndex + 1] : null
  let entry = current == null ? null : details.find(d => d.key == currentId)
  let loaded = entry != null && entry.loaded == true
  let exact = (entry ?? {}).exact
  let review = (entry ?? {}).review
  let receipt = (entry ?? {}).receipt
  let serverState = (entry ?? {}).state
  let mail = (review ?? {}).mail
  let isMail = exact != null && exact.tool_name == "mail_send_draft"
  let isReceipt = current != null && current.key.kind == "gate" && exact != null && contains(snapshotReceiptTools, exact.tool_name ?? "")
  let htmlOnly = isMail && mail != null && trim(mail.body_plain ?? "") == ""
  let localDraft = get(drafts, currentId, null)
  let draft = localDraft != null ? merge(blank, localDraft) : serverState != null && serverState.draft != null ? merge(blank, serverState.draft) : blank
  let draftTooLong = len(draft.text) > 16000 || len(draft.reason) > 4000
  let handoffPending = localDraft != null && (serverState == null || serverState.draft == null || merge(blank, localDraft) != merge(blank, serverState.draft))
  let draftBase = get(draftBases, currentId, null)
  let serverRevision = serverState == null || serverState.revision == null ? "none" : serverState.revision
  let serverMoved = current != null && localDraft != null && draftBase != null && serverRevision != draftBase
  let options = (exact ?? {}).options ?? []
  let selected = join(draft.picks.map(i => options[i].label), ", ")
  let answerText = selected != "" && trim(draft.text) != "" ? "${selected}\n\n${trim(draft.text)}" : selected != "" ? selected : trim(draft.text)
  let currentBusy = current != null && targets.any(t => t != null && t.account == account && t.item.key == current.key)
  let currentInQueue = queueValid && current != null && qItems.any(item => item.key == current.key)
  let currentAvailable = current != null && !authPending && queueValid && !contains(q.out.unavailable_packs ?? [], current.key.pack) && (currentInQueue || queue.next_cursor != null)
  let canWrite = token != null && currentAvailable && loaded && !currentBusy
  let canonicalPayload = exact == null || exact.input == null ? null : exact.input.payload
  let canonicalPayloadReady = canonicalPayload != null && len(keys(canonicalPayload)) > 0
  let receiptContextReady = receipt != null && len(keys(receipt)) > 0
  let gateReady = canWrite && exact != null && exact.status == "pending" && review != null && review.review_state == "ready" && (!isMail || (mail != null && trim(mail.body_plain ?? "") != "")) && (!isReceipt || (canonicalPayloadReady && receiptContextReady))
  let askReady = canWrite && exact != null && exact.status == "pending" && trim(exact.question ?? "") != ""
  let currentError = get(itemErrors, currentId, null)
  let currentConflict = get(conflicts, currentId, null)
  let recipients = mail == null ? "" : join((mail.to ?? []).map(a => a.name != "" ? "${a.name} <${a.address}>" : a.address), ", ")
  let cc = mail == null ? "" : join((mail.cc ?? []).map(a => a.name != "" ? "${a.name} <${a.address}>" : a.address), ", ")
  let bcc = mail == null ? "" : join((mail.bcc ?? []).map(a => a.name != "" ? "${a.name} <${a.address}>" : a.address), ", ")
  let verifyStalled = authPending && verifyChecks >= 3
  let pairBusy = pairStarting || pairPolling

  every 5s {
    if pairing && pairRequest != null && pairToken != null && !pairPolling && !pairStarting {
      pairPolling = true
      pairPollAttempt = pairAttempt
      pairPollSeq = pairPollSeq + 1
      pairPoll = post("${api}/auth/native/poll", {request_id: pairRequest.request_id}, {Authorization: "Bearer ${pairToken}", Accept: "application/json"})
    }
  }

  every 15s { if authPending { verifyChecks = verifyChecks + 1 } }

  on [pairStartSeq, pairStart] first {
    if pairStart != null {
      let result = pairStart
      let attempt = pairStartAttempt
      // Clear the reply at once: it holds the public challenge and its poll token.
      pairStart = null
      if pairStarting {
        pairStarting = false
        if attempt == pairAttempt && pairing && result.ok && result.out.request_id != null && result.out.poll_token != null {
          pairRequest = {request_id: result.out.request_id, user_code: result.out.user_code, verification_uri: result.out.verification_uri, expires_in: result.out.expires_in, interval: result.out.interval}
          pairToken = result.out.poll_token
          pairStatus = "Confirm the matching code in your normal browser."
        } else if attempt == pairAttempt && pairing {
          pairing = false
          pairStatus = "Could not start pairing. Check the connection and try again."
        }
      }
    }
  }

  on [pairPollSeq, pairPoll] first {
    if pairPoll != null {
      let result = pairPoll
      let attempt = pairPollAttempt
      // Clear the reply at once: an authorized one holds the device token.
      pairPoll = null
      pairPolling = false
      if pairing && pairRequest != null && attempt == pairAttempt {
        if result.ok && result.out.status == "authorized" && result.out.device_token != null {
          authPending = true
          authGeneration = authGeneration + 1
          token = result.out.device_token
          pairToken = null
          pairRequest = null
          pairing = false
          verifyChecks = 0
          pairStatus = "Verifying the new device grant…"
        } else if result.ok && result.out.status == "pending" {
          pairStatus = "Waiting for browser confirmation…"
        } else if !result.ok && (result.code == -1 || result.code == 429 || result.code >= 500) {
          // Keep the same challenge and poll bearer: a lost authorized reply replays the same grant
          // while the five-minute challenge is still valid.
          pairStatus = "Polling unavailable; retrying this challenge while it remains valid…"
        } else {
          pairing = false
          pairToken = null
          pairRequest = null
          pairStatus = result.ok && result.out.status == "denied" ? "Pairing was denied in the browser." : result.ok && result.out.status == "expired" ? "Pairing expired. Start a new challenge." : "Pairing expired or could not be confirmed. Start a new challenge."
        }
      }
    }
  }

  on me first {
    if meBound && me.ok && me.out.user.id != null && me.out.device.id != null {
      let newId = me.out.device.id
      // A grant creates a new device id. A previously seen id is a stale HTTP reply, not proof of
      // the new credential. Only /native/me can prove the account; old content stays closed until it does.
      let fresh = newId != deviceId && !contains(retiredDeviceIds, newId)
      if fresh {
        retiredDeviceIds = deviceId == null ? retiredDeviceIds : unique(retiredDeviceIds + [deviceId])
        if account == null {
          account = me.out.user.id
          deviceId = newId
          authPending = false
          authNotice = ""
          pairStatus = ""
        } else if me.out.user.id == account {
          // SAME account: preserve drafts, details, reading position and every pending slot.
          deviceId = newId
          authPending = false
          authNotice = ""
          pairStatus = ""
        } else {
          // Different account: hide old presentation and quarantine old slots; never render or write it.
          account = me.out.user.id
          deviceId = newId
          authPending = false
          lastQueue = null
          current = null
          hidden = []
          tab = "review"
          authNotice = "A different CDM account was verified. The previous account's drafts and requests stay quarantined here."
        }
        verifyChecks = 0
      } else if authPending {
        verifyChecks = verifyChecks + 1
      }
    } else if meBound && !me.ok && (me.code == 401 || me.code == 403) {
      // Do not auto-clear a token on one 401: an old-generation /native/me reply can arrive after a
      // newer grant was installed. Surface the recovery path and let the user retry, re-pair or
      // cancel verification; drafts stay. A normal expired session is already actionable via the
      // queue's 401 re-pair block.
      if authPending || pairing {
        authNotice = "The device grant was rejected or revoked. Retry verification, pair again, or cancel verification; same-account drafts are kept."
        verifyChecks = verifyChecks + 1
      }
    }
  }

  on [account, deviceId, q] first {
    if !authPending && queueValid {
      lastQueue = q.out
      // A pack missing from a partial response is not proof that its hidden item resolved.
      hidden = hidden.filter(k => q.out.next_cursor != null || contains(q.out.unavailable_packs ?? [], k.pack) || q.out.items.any(item => item.key == k))
    }
  }

  on [e, r, c, o] first {
    if !authPending && current != null && account != null {
      let key = currentId
      let kind = current.key.kind
      let id = current.key.id
      let pack = current.key.pack
      let prev = details.find(d => d.key == key)
      let exactBinding = e != null && e.out != null ? e.out.phone_binding : null
      let stateBinding = o != null && o.out != null ? o.out.phone_binding : null
      let reviewBinding = r != null && r.out != null ? r.out.phone_binding : null
      let receiptBinding = c != null && c.out != null ? c.out.phone_binding : null
      let exactBound = exactBinding != null && exactBinding.generation == generationLabel && exactBinding.account == account && exactBinding.device_id == deviceId && exactBinding.item == current.key
      let stateBound = stateBinding != null && stateBinding.generation == generationLabel && stateBinding.account == account && stateBinding.device_id == deviceId && stateBinding.item == current.key
      let reviewBound = reviewBinding != null && reviewBinding.generation == generationLabel && reviewBinding.account == account && reviewBinding.device_id == deviceId && reviewBinding.item == current.key
      let receiptBound = receiptBinding != null && receiptBinding.generation == generationLabel && receiptBinding.account == account && receiptBinding.device_id == deviceId && receiptBinding.item == current.key
      let exactOk = exactBound && e.ok && e.out.id == id && e.out.pack == pack
      let stateOk = stateBound && o.ok && o.out.kind == kind && o.out.item_id == id
      let reviewOk = kind == "ask" || (reviewBound && r.ok && r.out.gate_id == id)
      let tool = exactOk ? e.out.tool_name : prev != null && prev.exact != null ? prev.exact.tool_name : current.tool_name
      let receiptGate = kind == "gate" && contains(snapshotReceiptTools, tool ?? "")
      let receiptOk = !receiptGate || (receiptBound && (c.ok && c.out.gate_id == id || c.code == 404))
      if exactOk || stateOk || (kind == "gate" && reviewOk) || (receiptGate && receiptBound) {
        let prevEntry = prev ?? {key: key, exact: null, review: null, receipt: null, receiptError: null, state: null, loaded: false}
        let rawMail = kind == "gate" && reviewOk ? r.out.mail : null
        let oldMail = prevEntry.review != null ? prevEntry.review.mail : null
        let mailProj = !reviewOk ? oldMail : rawMail == null ? null : {subject: rawMail.subject, to: rawMail.to, cc: rawMail.cc, bcc: rawMail.bcc, body_plain: rawMail.body_plain, attachments: (rawMail.attachments ?? []).map(a => {filename: a.filename, content_type: a.content_type, size: a.size})}
        let exactProj = exactOk ? (kind == "gate" ? {id: e.out.id, pack: e.out.pack, status: e.out.status, preview_gfm: e.out.preview_gfm, tool_name: e.out.tool_name, submitted_at: e.out.submitted_at, input: receiptGate ? e.out.input : null} : {id: e.out.id, pack: e.out.pack, status: e.out.status, header: e.out.header, question: e.out.question, options: (e.out.options ?? []).map(o => {label: o.label, description: o.description}), multi: e.out.multi, kind: e.out.kind, created_at: e.out.created_at}) : prevEntry.exact
        let reviewProj = kind == "gate" && reviewOk ? {review_state: r.out.review_state, review_error: r.out.review_error, mail: mailProj} : prevEntry.review
        let stateProj = stateOk ? {revision: o.out.revision, draft: o.out.draft, parked: o.out.parked} : prevEntry.state
        let receiptProj = !receiptGate ? null : receiptBound && c.ok && c.out.gate_id == id ? c.out.review_context : receiptBound && c.code == 404 ? null : prevEntry.receipt
        let receiptErr = !receiptGate ? null : receiptBound && c.ok && c.out.gate_id == id ? null : receiptBound && c.code == 404 ? "no_review_snapshot" : prevEntry.receiptError
        let complete = prevEntry.loaded == true || (exactOk && stateOk && reviewOk && receiptOk)
        details = ([merge(prevEntry, {exact: exactProj, review: reviewProj, receipt: receiptProj, receiptError: receiptErr, state: stateProj, loaded: complete})] + details.filter(d => d.key != key)).take(6)
      }
    }
  }

  on [seq0, res0] first {
    if live0 && tgt0 != null && res0 != null {
      let t = tgt0
      let reply = res0
      if t.account != account {
        // The verified account changed while this request was out. Never apply or render its reply.
        live0 = false
        res0 = null
      } else {
        let key = t.id
        let match = reply.out.kind == t.item.key.kind && reply.out.item_id == t.item.key.id
        let gateMatch = reply.out.id == t.item.key.id && reply.out.pack == t.item.key.pack
        let matched = t.action == "allow" || t.action == "deny" ? gateMatch : t.action == "save" || t.action == "skip" ? match : true
        if reply.ok && matched {
          if t.action == "save" || t.action == "skip" {
            details = details.map(d => d.key == key ? merge(d, {state: {revision: reply.out.revision, draft: reply.out.draft, parked: reply.out.parked}}) : d)
            draftBases = set(draftBases, key, reply.out.revision ?? "none")
          }
          if t.action == "allow" || t.action == "deny" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.status, preview_gfm: reply.out.preview_gfm ?? d.exact.preview_gfm})}) : d)
          }
          if t.action == "answer" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: "answered"})}) : d)
          }
          if t.action == "allow" || t.action == "deny" || t.action == "answer" {
            if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
            draftBases = remove(draftBases, key)
          }
          conflicts = remove(conflicts, key)
          itemErrors = remove(itemErrors, key)
          live0 = false
          res0 = null
          tgt0 = null
        } else if reply.ok {
          itemErrors = set(itemErrors, key, {action: t.action, code: reply.code, message: "The server answered for a different item. Reopen and check the exact item before another action."})
          if t.action != "save" && t.action != "prepare" { hidden = hidden.filter(k => k != t.item.key) }
          live0 = false
          refresh()
        } else {
          let code = reply.code
          let msg = code == -1 ? "No response; outcome unknown. Reopen and check the exact item before another action." : code == 401 || code == 403 ? "Authorization rejected; pair again, then check the exact item." : code == 409 ? "Changed elsewhere; both copies are retained." : "Request failed (${code}); reopen and check the exact item."
          itemErrors = set(itemErrors, key, {action: t.action, code: code, message: msg})
          if t.action == "allow" || t.action == "deny" || t.action == "answer" || t.action == "skip" {
            hidden = hidden.filter(k => k != t.item.key)
          }
          if code == 409 {
            if t.action == "save" || t.action == "skip" {
              if reply.out.detail != null && reply.out.detail.current != null && reply.out.detail.current.kind == t.item.key.kind && reply.out.detail.current.item_id == t.item.key.id {
                conflicts = set(conflicts, key, {server: reply.out.detail.current, local: t.action == "skip" ? get(drafts, key, blank) : t.draft})
                details = details.map(d => d.key == key ? merge(d, {state: reply.out.detail.current}) : d)
                if t.action == "skip" { itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Skip was not applied: the parking revision changed elsewhere. The item is still pending; both copies are retained."}) }
              } else {
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Conflict response did not name this item. Reopen and check."})
              }
            } else if t.action == "allow" || t.action == "deny" {
              if reply.out.gate != null && reply.out.gate.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.gate.status, preview_gfm: reply.out.gate.preview_gfm ?? d.exact.preview_gfm})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            } else if t.action == "answer" {
              if reply.out.ask != null && reply.out.ask.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.ask.status})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            }
          }
          live0 = false
          refresh()
        }
      }
    }
  }

  on [seq1, res1] first {
    if live1 && tgt1 != null && res1 != null {
      let t = tgt1
      let reply = res1
      if t.account != account {
        live1 = false
        res1 = null
      } else {
        let key = t.id
        let match = reply.out.kind == t.item.key.kind && reply.out.item_id == t.item.key.id
        let gateMatch = reply.out.id == t.item.key.id && reply.out.pack == t.item.key.pack
        let matched = t.action == "allow" || t.action == "deny" ? gateMatch : t.action == "save" || t.action == "skip" ? match : true
        if reply.ok && matched {
          if t.action == "save" || t.action == "skip" {
            details = details.map(d => d.key == key ? merge(d, {state: {revision: reply.out.revision, draft: reply.out.draft, parked: reply.out.parked}}) : d)
            draftBases = set(draftBases, key, reply.out.revision ?? "none")
          }
          if t.action == "allow" || t.action == "deny" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.status, preview_gfm: reply.out.preview_gfm ?? d.exact.preview_gfm})}) : d)
          }
          if t.action == "answer" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: "answered"})}) : d)
          }
          if t.action == "allow" || t.action == "deny" || t.action == "answer" {
            if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
            draftBases = remove(draftBases, key)
          }
          conflicts = remove(conflicts, key)
          itemErrors = remove(itemErrors, key)
          live1 = false
          res1 = null
          tgt1 = null
        } else if reply.ok {
          itemErrors = set(itemErrors, key, {action: t.action, code: reply.code, message: "The server answered for a different item. Reopen and check the exact item before another action."})
          if t.action != "save" && t.action != "prepare" { hidden = hidden.filter(k => k != t.item.key) }
          live1 = false
          refresh()
        } else {
          let code = reply.code
          let msg = code == -1 ? "No response; outcome unknown. Reopen and check the exact item before another action." : code == 401 || code == 403 ? "Authorization rejected; pair again, then check the exact item." : code == 409 ? "Changed elsewhere; both copies are retained." : "Request failed (${code}); reopen and check the exact item."
          itemErrors = set(itemErrors, key, {action: t.action, code: code, message: msg})
          if t.action == "allow" || t.action == "deny" || t.action == "answer" || t.action == "skip" {
            hidden = hidden.filter(k => k != t.item.key)
          }
          if code == 409 {
            if t.action == "save" || t.action == "skip" {
              if reply.out.detail != null && reply.out.detail.current != null && reply.out.detail.current.kind == t.item.key.kind && reply.out.detail.current.item_id == t.item.key.id {
                conflicts = set(conflicts, key, {server: reply.out.detail.current, local: t.action == "skip" ? get(drafts, key, blank) : t.draft})
                details = details.map(d => d.key == key ? merge(d, {state: reply.out.detail.current}) : d)
                if t.action == "skip" { itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Skip was not applied: the parking revision changed elsewhere. The item is still pending; both copies are retained."}) }
              } else {
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Conflict response did not name this item. Reopen and check."})
              }
            } else if t.action == "allow" || t.action == "deny" {
              if reply.out.gate != null && reply.out.gate.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.gate.status, preview_gfm: reply.out.gate.preview_gfm ?? d.exact.preview_gfm})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            } else if t.action == "answer" {
              if reply.out.ask != null && reply.out.ask.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.ask.status})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            }
          }
          live1 = false
          refresh()
        }
      }
    }
  }

  on [seq2, res2] first {
    if live2 && tgt2 != null && res2 != null {
      let t = tgt2
      let reply = res2
      if t.account != account {
        live2 = false
        res2 = null
      } else {
        let key = t.id
        let match = reply.out.kind == t.item.key.kind && reply.out.item_id == t.item.key.id
        let gateMatch = reply.out.id == t.item.key.id && reply.out.pack == t.item.key.pack
        let matched = t.action == "allow" || t.action == "deny" ? gateMatch : t.action == "save" || t.action == "skip" ? match : true
        if reply.ok && matched {
          if t.action == "save" || t.action == "skip" {
            details = details.map(d => d.key == key ? merge(d, {state: {revision: reply.out.revision, draft: reply.out.draft, parked: reply.out.parked}}) : d)
            draftBases = set(draftBases, key, reply.out.revision ?? "none")
          }
          if t.action == "allow" || t.action == "deny" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.status, preview_gfm: reply.out.preview_gfm ?? d.exact.preview_gfm})}) : d)
          }
          if t.action == "answer" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: "answered"})}) : d)
          }
          if t.action == "allow" || t.action == "deny" || t.action == "answer" {
            if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
            draftBases = remove(draftBases, key)
          }
          conflicts = remove(conflicts, key)
          itemErrors = remove(itemErrors, key)
          live2 = false
          res2 = null
          tgt2 = null
        } else if reply.ok {
          itemErrors = set(itemErrors, key, {action: t.action, code: reply.code, message: "The server answered for a different item. Reopen and check the exact item before another action."})
          if t.action != "save" && t.action != "prepare" { hidden = hidden.filter(k => k != t.item.key) }
          live2 = false
          refresh()
        } else {
          let code = reply.code
          let msg = code == -1 ? "No response; outcome unknown. Reopen and check the exact item before another action." : code == 401 || code == 403 ? "Authorization rejected; pair again, then check the exact item." : code == 409 ? "Changed elsewhere; both copies are retained." : "Request failed (${code}); reopen and check the exact item."
          itemErrors = set(itemErrors, key, {action: t.action, code: code, message: msg})
          if t.action == "allow" || t.action == "deny" || t.action == "answer" || t.action == "skip" {
            hidden = hidden.filter(k => k != t.item.key)
          }
          if code == 409 {
            if t.action == "save" || t.action == "skip" {
              if reply.out.detail != null && reply.out.detail.current != null && reply.out.detail.current.kind == t.item.key.kind && reply.out.detail.current.item_id == t.item.key.id {
                conflicts = set(conflicts, key, {server: reply.out.detail.current, local: t.action == "skip" ? get(drafts, key, blank) : t.draft})
                details = details.map(d => d.key == key ? merge(d, {state: reply.out.detail.current}) : d)
                if t.action == "skip" { itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Skip was not applied: the parking revision changed elsewhere. The item is still pending; both copies are retained."}) }
              } else {
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Conflict response did not name this item. Reopen and check."})
              }
            } else if t.action == "allow" || t.action == "deny" {
              if reply.out.gate != null && reply.out.gate.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.gate.status, preview_gfm: reply.out.gate.preview_gfm ?? d.exact.preview_gfm})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            } else if t.action == "answer" {
              if reply.out.ask != null && reply.out.ask.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.ask.status})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            }
          }
          live2 = false
          refresh()
        }
      }
    }
  }

  on [seq3, res3] first {
    if live3 && tgt3 != null && res3 != null {
      let t = tgt3
      let reply = res3
      if t.account != account {
        live3 = false
        res3 = null
      } else {
        let key = t.id
        let match = reply.out.kind == t.item.key.kind && reply.out.item_id == t.item.key.id
        let gateMatch = reply.out.id == t.item.key.id && reply.out.pack == t.item.key.pack
        let matched = t.action == "allow" || t.action == "deny" ? gateMatch : t.action == "save" || t.action == "skip" ? match : true
        if reply.ok && matched {
          if t.action == "save" || t.action == "skip" {
            details = details.map(d => d.key == key ? merge(d, {state: {revision: reply.out.revision, draft: reply.out.draft, parked: reply.out.parked}}) : d)
            draftBases = set(draftBases, key, reply.out.revision ?? "none")
          }
          if t.action == "allow" || t.action == "deny" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.status, preview_gfm: reply.out.preview_gfm ?? d.exact.preview_gfm})}) : d)
          }
          if t.action == "answer" {
            details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: "answered"})}) : d)
          }
          if t.action == "allow" || t.action == "deny" || t.action == "answer" {
            if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
            draftBases = remove(draftBases, key)
          }
          conflicts = remove(conflicts, key)
          itemErrors = remove(itemErrors, key)
          live3 = false
          res3 = null
          tgt3 = null
        } else if reply.ok {
          itemErrors = set(itemErrors, key, {action: t.action, code: reply.code, message: "The server answered for a different item. Reopen and check the exact item before another action."})
          if t.action != "save" && t.action != "prepare" { hidden = hidden.filter(k => k != t.item.key) }
          live3 = false
          refresh()
        } else {
          let code = reply.code
          let msg = code == -1 ? "No response; outcome unknown. Reopen and check the exact item before another action." : code == 401 || code == 403 ? "Authorization rejected; pair again, then check the exact item." : code == 409 ? "Changed elsewhere; both copies are retained." : "Request failed (${code}); reopen and check the exact item."
          itemErrors = set(itemErrors, key, {action: t.action, code: code, message: msg})
          if t.action == "allow" || t.action == "deny" || t.action == "answer" || t.action == "skip" {
            hidden = hidden.filter(k => k != t.item.key)
          }
          if code == 409 {
            if t.action == "save" || t.action == "skip" {
              if reply.out.detail != null && reply.out.detail.current != null && reply.out.detail.current.kind == t.item.key.kind && reply.out.detail.current.item_id == t.item.key.id {
                conflicts = set(conflicts, key, {server: reply.out.detail.current, local: t.action == "skip" ? get(drafts, key, blank) : t.draft})
                details = details.map(d => d.key == key ? merge(d, {state: reply.out.detail.current}) : d)
                if t.action == "skip" { itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Skip was not applied: the parking revision changed elsewhere. The item is still pending; both copies are retained."}) }
              } else {
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Conflict response did not name this item. Reopen and check."})
              }
            } else if t.action == "allow" || t.action == "deny" {
              if reply.out.gate != null && reply.out.gate.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.gate.status, preview_gfm: reply.out.gate.preview_gfm ?? d.exact.preview_gfm})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            } else if t.action == "answer" {
              if reply.out.ask != null && reply.out.ask.id == t.item.key.id {
                details = details.map(d => d.key == key ? merge(d, {exact: merge(d.exact, {status: reply.out.ask.status})}) : d)
                conflicts = set(conflicts, key, {resolved: true, local: t.draft})
                itemErrors = remove(itemErrors, key)
              } else {
                hidden = hidden.filter(k => k != t.item.key)
                itemErrors = set(itemErrors, key, {action: t.action, code: code, message: "Changed elsewhere, but the reply did not name this item. Reopen and check."})
              }
            }
          }
          live3 = false
          refresh()
        }
      }
    }
  }

  when token == null && authPending && !pairing {
    authPending = false
    verifyChecks = 0
    pairToken = null
    pairRequest = null
    authNotice = "This surface is no longer paired. Pair again; same-account drafts are kept."
  }

  when !pairing && pairRequest == null && pairToken != null {
    pairToken = null
  }

  when !pairing && !pairStarting && !pairPolling && pairRequest != null && pairToken == null {
    // A persisted challenge lost its polling credential (origin change or cleared secret): it can
    // no longer be resumed, so start a new one rather than showing a dead code.
    pairRequest = null
    pairStatus = ""
  }

  component ActionButton(item, label, action, advance = false, enabled = true) {
    Button {
      text: label
      color: enabled && poolFree ? accent : muted
      onTap: {
        if enabled && poolFree && !pairing && !authPending && !targets.any(t => t != null && t.account == account && t.item.key == item.key) {
          let slot = tgt0 == null ? 0 : tgt1 == null ? 1 : tgt2 == null ? 2 : 3
          let next = nextItem
          let expected = action == "save" || action == "skip" ? serverState.revision : null
          let target = {id: toJson({account: account, key: item.key}), account: account, generation: authGeneration, item: item, action: action, draft: action == "skip" || action == "prepare" ? blank : draft, answer: action == "answer" ? answerText : "", expected: expected}
          itemErrors = remove(itemErrors, target.id)
          if slot == 0 {
            seq0 = seq0 + 1
            tgt0 = target
            live0 = true
            res0 = null
            if action == "allow" || action == "deny" {
              res0 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/decide", {verdict: action, reasoning: action == "deny" ? draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "answer" {
              res0 = post("${api}/api/swarms/${enc(item.key.pack)}/asks/${enc(item.key.id)}/answer", {answer: answerText}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "save" {
              res0 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, draft: draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "skip" {
              res0 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "prepare" {
              res0 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            }
          } else if slot == 1 {
            seq1 = seq1 + 1
            tgt1 = target
            live1 = true
            res1 = null
            if action == "allow" || action == "deny" {
              res1 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/decide", {verdict: action, reasoning: action == "deny" ? draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "answer" {
              res1 = post("${api}/api/swarms/${enc(item.key.pack)}/asks/${enc(item.key.id)}/answer", {answer: answerText}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "save" {
              res1 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, draft: draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "skip" {
              res1 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "prepare" {
              res1 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            }
          } else if slot == 2 {
            seq2 = seq2 + 1
            tgt2 = target
            live2 = true
            res2 = null
            if action == "allow" || action == "deny" {
              res2 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/decide", {verdict: action, reasoning: action == "deny" ? draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "answer" {
              res2 = post("${api}/api/swarms/${enc(item.key.pack)}/asks/${enc(item.key.id)}/answer", {answer: answerText}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "save" {
              res2 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, draft: draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "skip" {
              res2 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "prepare" {
              res2 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            }
          } else {
            seq3 = seq3 + 1
            tgt3 = target
            live3 = true
            res3 = null
            if action == "allow" || action == "deny" {
              res3 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/decide", {verdict: action, reasoning: action == "deny" ? draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "answer" {
              res3 = post("${api}/api/swarms/${enc(item.key.pack)}/asks/${enc(item.key.id)}/answer", {answer: answerText}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            } else if action == "save" {
              res3 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, draft: draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "skip" {
              res3 = post("${api}/api/swarms/${enc(item.key.pack)}/operator-state/${enc(item.key.kind)}/${enc(item.key.id)}", {expected_revision: expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
            } else if action == "prepare" {
              res3 = post("${api}/api/swarms/${enc(item.key.pack)}/gates/${enc(item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
            }
          }
          if advance {
            hidden = unique(hidden + [item.key])
            current = next
            tab = "review"
            if next == null { close() } // last item: optimistic close
          }
        }
      }
    }
  }

  component Pairing() {
    Column {
      gap: 12
      weight: 1
      Text { text: "CDM review"; style: title; color: accent }
      Text { text: "Native gate and question review. Pair this surface with your CDM account in your normal browser; no token or cookie is copied."; color: muted }
      if authNotice != "" { Text { text: authNotice; color: yellow } }
      if !pairing {
        if pairRequest != null && pairToken != null {
          Text { text: "A pairing challenge is still waiting. Resume polling it before its five-minute deadline, or cancel and start again."; color: yellow }
          Text { text: "Matching code"; style: muted }
          Text { text: pairRequest.user_code; style: huge; color: accent }
          Button { text: "Open browser consent"; onTap: url(pairRequest.verification_uri) }
          Text { text: pairStatus; color: muted }
          Flow {
            gap: 8
            Button { text: "Resume waiting"; color: accent; onTap: { pairing = true; pairStatus = "Waiting for browser confirmation…" } }
            Button { text: "Cancel pairing"; color: muted; onTap: { pairing = false; pairRequest = null; pairToken = null; pairAttempt = pairAttempt + 1; pairStatus = "" } }
          }
        } else {
          Button {
            text: pairBusy ? "Finishing the previous check…" : "Pair this device"
            color: pairBusy ? muted : accent
            onTap: {
              if !pairBusy {
                authNotice = ""
                pairStatus = "Starting a five-minute browser challenge…"
                pairRequest = null
                pairToken = null
                pairing = true
                pairStarting = true
                pairAttempt = pairAttempt + 1
                pairStartAttempt = pairAttempt
                pairStartSeq = pairStartSeq + 1
                pairStart = null
                pairStart = post("${api}/auth/native/start", {device_kind: "phone", device_name: "CDM review face"}, {Accept: "application/json"})
              }
            }
          }
        }
      } else {
        if pairRequest != null {
          Text { text: "Matching code"; style: muted }
          Text { text: pairRequest.user_code; style: huge; color: accent }
          Text { text: "In the browser, confirm this exact code for the same CDM operator account. Fresh sign-in and consent happen there." }
          Button { text: "Open browser consent"; onTap: url(pairRequest.verification_uri) }
        }
        Text { text: pairStatus; color: muted }
        Button {
          text: pairBusy ? "Cancelling… (finishing the current check)" : "Cancel pairing"
          color: muted
          onTap: {
            pairing = false
            pairRequest = null
            pairToken = null
            pairAttempt = pairAttempt + 1
            pairStatus = pairBusy ? "Stopping the current challenge check…" : ""
          }
        }
      }
    }
  }

  component QueueStatus() {
    Column {
      gap: 2
      if q == null && cachedQueue == null { Text { text: "Loading queue…"; color: muted } }
      if q != null && !queueValid { Text { text: cachedQueue == null ? "Fresh queue unavailable — not empty. Re-pair or verify to recover." : "Offline/stale copy — actions paused."; color: red } }
      if queueValid && !q.out.complete { Text { text: "Partial queue: ${join(q.out.unavailable_packs, ", ")} unavailable. Counts are lower bounds — not done."; color: yellow } }
      if cachedQueue != null && cachedQueue.complete == false && !(queueValid && q.out.complete) { Text { text: "The cached copy was partial; its counts are lower bounds."; color: yellow } }
      if queue != null && queue.next_cursor != null { Text { text: "This native page is bounded; ${queue.total} known reviews. More pages remain in the full app."; color: muted } }
      if !poolFree { Text { text: "All four action slots need an outcome checked. New actions pause visibly; no tap is silently dropped."; color: yellow } }
    }
  }

  component ReceiptField(label, value) {
    Column {
      gap: 0
      Text { text: label; style: small; color: muted }
      Text { text: value }
    }
  }

  component RefView(type, value, absentText = "not provided", details = false) {
    Column {
      gap: 0
      let text = trim("${value}")
      let id = lower(text)
      let refs = receipt.references ?? {}
      let saved = get(refs, "Справочник.${type}/${id}", get(refs, "${type}/${id}", get(refs, "Справочник.${type}/${text}", get(refs, "${type}/${text}", null))))
      if value == null || text == "" {
        Text { text: absentText; color: muted }
      } else if saved != null && trim(saved.name ?? "") != "" {
        Text { text: saved.name }
        if details && (saved.inn != null || saved.kpp != null) {
          Text { text: "${saved.inn != null ? "INN ${saved.inn}" : ""}${saved.inn != null && saved.kpp != null ? " · " : ""}${saved.kpp != null ? "KPP ${saved.kpp}" : ""}"; style: small; color: muted }
        }
        if details && (saved.number != null || saved.date != null) {
          Text { text: "${saved.number != null ? "№ ${saved.number}" : ""}${saved.number != null && saved.date != null ? " · " : ""}${saved.date ?? ""}"; style: small; color: muted }
        }
      } else if match(text, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$') != null {
        Text { text: "Unresolved: ${text}"; color: yellow }
      } else {
        Text { text: text }
      }
    }
  }

  component RefField(label, type, value, absentText = "not provided", details = false) {
    Column {
      gap: 0
      Text { text: label; style: small; color: muted }
      RefView { type: type; value: value; absentText: absentText; details: details }
    }
  }

  component UnitView(unit, nomenclature, service = false) {
    Column {
      gap: 0
      let text = trim("${unit}")
      let id = lower(text)
      let refs = receipt.references ?? {}
      let saved = get(refs, "Справочник.КлассификаторЕдиницИзмерения/${id}", get(refs, "КлассификаторЕдиницИзмерения/${id}", get(refs, "Справочник.КлассификаторЕдиницИзмерения/${text}", get(refs, "КлассификаторЕдиницИзмерения/${text}", null))))
      let cardId = lower(trim("${nomenclature}"))
      let card = get(refs, "Справочник.Номенклатура/${cardId}", get(refs, "Номенклатура/${cardId}", get(refs, "Справочник.Номенклатура/${trim("${nomenclature}")}", get(refs, "Номенклатура/${trim("${nomenclature}")}", null))))
      let matches = entries(refs).filter(e => (startsWith(e.key, "Справочник.КлассификаторЕдиницИзмерения/") || startsWith(e.key, "КлассификаторЕдиницИзмерения/")) && e.value.code == text && trim(e.value.name ?? "") != "")
      if unit == null || text == "" {
        Text { text: service ? "Unit: not specified" : card != null && trim(card.default_unit.name ?? "") != "" ? "Unit: ${card.default_unit.name} (card)" : "Unit: card default (unresolved)"; color: service || card == null ? muted : foreground }
      } else if saved != null && trim(saved.name ?? "") != "" {
        Text { text: "Unit: ${saved.name}${saved.code != null ? " (ОКЕИ ${saved.code})" : ""}" }
      } else if match(text, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$') != null {
        Text { text: "Unit unresolved: ${text}"; color: yellow }
      } else if match(text, '^[0-9]{3}$') != null {
        if len(matches) == 1 {
          Text { text: "Unit: ${matches[0].value.name} (ОКЕИ ${text})" }
        } else {
          Text { text: "Unit unresolved ОКЕИ ${text} (${len(matches)} matches)"; color: yellow }
        }
      } else {
        Text { text: "Unit: ${text}" }
      }
    }
  }

  component ReceiptLine(line, service = false) {
    Column {
      gap: 5
      padding: 10
      background: surface
      let meta = service ? [
        line.account != null ? "acct ${line.account}" : null,
        line.vat_account != null ? "VAT acct ${line.vat_account}" : null,
        line.cost_item != null ? "cost item ${line.cost_item}" : null,
        line.nomenclature_group != null ? "group ${line.nomenclature_group}" : null,
        line.subdivision != null ? "subdivision ${line.subdivision}" : null
      ] : [
        line.account != null ? "acct ${line.account}" : null,
        line.vat_account != null ? "VAT acct ${line.vat_account}" : null,
        line.country != null ? "country ${line.country}" : null,
        line.customs_number != null ? "ДТ ${line.customs_number}" : null
      ]
      if line.nomenclature != null {
        RefView { type: "Номенклатура"; value: line.nomenclature; absentText: "not provided" }
      } else {
        Text { text: "Line without a nomenclature reference"; color: muted }
      }
      if service && trim(line.content ?? "") != "" { Text { text: line.content } }
      Row {
        gap: 12
        Text { text: "Qty: ${line.quantity ?? "—"}"; weight: 1 }
        UnitView { unit: line.unit; nomenclature: line.nomenclature; service: service }
      }
      Text { text: "Amount w/o VAT: ${line.amount ?? "—"}" }
      Text { text: "VAT rate: ${line.vat_rate ?? "—"} · VAT amount: ${line.vat_amount ?? "—"}" }
      if contains(keys(line), "price") { Text { text: "Price: ${line.price}" } }
      if len(meta.filter(x => x != null && trim("${x}") != "")) > 0 {
        Text { text: join(meta.filter(x => x != null && trim("${x}") != ""), " · "); style: small; color: muted }
      }
      if line.rnpt != null {
        Text { text: "РНПТ: ${line.rnpt.number ?? "—"}${line.rnpt.quantity != null ? " · qty ${line.rnpt.quantity}" : ""}"; style: small; color: muted }
      }
    }
  }

  component ReceiptProposal() {
    Column {
      gap: 10
      let input = exact.input
      let payload = (input ?? {}).payload ?? {}
      let updating = exact.tool_name == "onec_receipt_update" || exact.tool_name == "onec_receipt_update_edited"
      let goods = payload.goods ?? []
      let services = payload.services ?? []
      let totals = payload.totals
      let updateId = updating ? (input.guid ?? payload.receipt_guid) : null
      let omitted = updating ? "unchanged (keeps the draft's value)" : "not provided"
      if len(keys(payload)) == 0 || receipt == null || len(keys(receipt)) == 0 {
        Text { text: len(keys(payload)) == 0 ? "Canonical payload unavailable or empty. Native approval is disabled; use the full app." : "No saved receipt comparison text (legacy request). Resubmit or review it in the full app; native approval is disabled here."; color: yellow }
      } else {
        Text { text: updating ? "Proposed receipt draft edit" : "Proposed new receipt draft"; style: title; color: accent }
        if input.base != null { ReceiptField { label: "Base"; value: "${input.base}" } }
        if updateId != null { ReceiptField { label: "Receipt draft to rewrite"; value: "${updateId}" } }
        if payload.is_upd == true { ReceiptField { label: "УПД status"; value: "${payload.upd_status ?? "provided"}" } }
        RefField { label: "Supplier"; type: "Контрагенты"; value: payload.counterparty; details: true }
        RefField { label: "Contract"; type: "ДоговорыКонтрагентов"; value: payload.contract; absentText: omitted; details: true }
        RefField { label: "Organization"; type: "Организации"; value: payload.organization; absentText: "Connector default (identity not verified)" }
        RefField { label: "Warehouse"; type: "Склады"; value: payload.warehouse; absentText: len(goods) > 0 ? "Connector default (identity not verified)" : omitted }
        if contains(keys(payload), "supplier_agent") {
          if payload.supplier_agent == null {
            ReceiptField { label: "Supplier agent"; value: "cleared (no agent payment)" }
          } else {
            Text { text: "Supplier agent"; style: small; color: muted }
            RefView { type: "Контрагенты"; value: payload.supplier_agent.counterparty }
            RefView { type: "ДоговорыКонтрагентов"; value: payload.supplier_agent.contract; details: true }
          }
        }
        ReceiptField { label: "Supplier number"; value: payload.incoming_number == null ? omitted : "${payload.incoming_number}" }
        ReceiptField { label: "Supplier date"; value: payload.incoming_date == null ? "Receipt accounting date (default)" : "${payload.incoming_date}" }
        ReceiptField { label: "Accounting date"; value: payload.date == null ? omitted : "${payload.date}" }
        if payload.sf_date != null || updating || payload.register_sf == true {
          ReceiptField { label: "СФ accounting date"; value: payload.sf_date != null ? "${payload.sf_date}" : updating ? "Existing СФ retained; new СФ uses supplier/receipt date" : "Supplier date, or receipt date if omitted (default)" }
        }
        Text { text: "Goods"; style: title }
        if len(goods) == 0 {
          Text { text: updating && len(services) > 0 ? "No goods rows — existing goods will be cleared on approval." : updating ? "No goods rows." : "No goods rows."; color: updating ? yellow : muted }
        }
        for line in goods { ReceiptLine { line: line; service: false } }
        Text { text: "Services"; style: title }
        if len(services) == 0 {
          Text { text: updating && len(goods) > 0 ? "No service rows — existing services will be cleared on approval." : "No service rows."; color: updating && len(goods) > 0 ? yellow : muted }
        }
        for line in services { ReceiptLine { line: line; service: true } }
        if updating && len(goods) == 0 && len(services) == 0 {
          Text { text: "The connector rejects an update without goods or service lines; nothing will be cleared."; color: yellow }
        }
        if totals != null {
          ReceiptField { label: "Total w/o VAT"; value: "${totals.amount_without_vat ?? "—"}" }
          ReceiptField { label: "VAT"; value: "${totals.vat ?? "—"}" }
          ReceiptField { label: "Total with VAT"; value: "${totals.amount_with_vat ?? "—"}" }
        }
        Text { text: "Effect of approval"; style: title }
        Text { text: updating ? "Approving rewrites the UNPOSTED receipt. Omitted date, contract, supplier number and agent are retained; other connector defaults may replace header values." : "Approving creates an UNPOSTED receipt draft (no posting, no deduction)." }
        Text { text: payload.remove_sf == true ? "The attached unposted СФ will be detached and marked for deletion." : payload.register_sf == true ? "An unposted СФ will be registered only if none exists." : "No new СФ will be created." }
        ReceiptField { label: "Advance offset"; value: "${payload.advance_offset ?? "auto (default)"}" }
        ReceiptField { label: "Settlement / advance accounts"; value: "${payload.settlement_account ?? "60.01"} / ${payload.advance_account ?? "60.02"}" }
        ReceiptField { label: "VAT deduction"; value: payload.reflect_vat_deduction == null ? "not claimed (default)" : payload.reflect_vat_deduction == true ? "claimed" : "not claimed" }
        if trim(payload.comment ?? "") != "" { ReceiptField { label: "Comment"; value: payload.comment } }
        Text { text: "Original from supplier"; style: title }
        if receipt.record != null { ReceiptField { label: "Record"; value: "${receipt.record.title} · ${receipt.record.short_id}" } }
        ReceiptField { label: "Captured at"; value: receipt.captured_at }
        ReceiptField { label: "Source"; value: "${receipt.source.status}${receipt.source.filename != null ? " · ${receipt.source.filename}" : ""}${receipt.source.size != null ? " · ${fmtBytes(receipt.source.size)}" : ""}" }
        if receipt.source.sha256 != null { ReceiptField { label: "Source SHA-256"; value: receipt.source.sha256 } }
        if receipt.source.message != null { Text { text: receipt.source.message; color: yellow } }
        for warning in receipt.warnings ?? [] { Text { text: "⚠ ${warning}"; color: yellow } }
        Row {
          Button { text: "Original document (browser)"; color: muted; onTap: url("${api}/api/swarms/${enc(current.key.pack)}/gates/${enc(current.key.id)}/receipt/source") }
          Button { text: "Copy raw proposal"; color: muted; onTap: copy(toJson(input)) }
          Button { text: "Copy raw context"; color: muted; onTap: copy(toJson(receipt)) }
        }
      }
    }
  }

  component ServerCopy(server) {
    Column {
      gap: 4
      if server != null {
        Text { text: "Server copy"; style: small; color: muted }
        Text { text: "Revision: ${server.revision}" }
        if server.draft == null {
          Text { text: "No server draft." }
        } else {
          Text { text: "Text: ${server.draft.text == "" ? "(empty)" : server.draft.text}" }
          Text { text: "Reason: ${server.draft.reason == "" ? "(none)" : server.draft.reason}" }
          Text { text: "Picks: ${len(server.draft.picks ?? []) == 0 ? "(none)" : join((server.draft.picks ?? []).map(p => (options[p] ?? {}).label ?? "#${p}"), ", ")}" }
          if server.draft.mode != null { Text { text: "Mode: ${server.draft.mode}"; style: small; color: muted } }
        }
        Text { text: "Parked on server: ${server.parked == true ? "yes" : "no"}"; style: small; color: muted }
        Button {
          text: "Use server copy (discard mine)"
          color: muted
          onTap: {
            drafts = server.draft == null ? remove(drafts, currentId) : set(drafts, currentId, merge(blank, server.draft))
            details = details.map(d => d.key == currentId ? merge(d, {state: server}) : d)
            conflicts = remove(conflicts, currentId)
            draftBases = set(draftBases, currentId, server.revision == null ? "none" : server.revision)
          }
        }
      }
    }
  }

  component ReviewScreen() {
    Column {
      fill: width
      weight: 1
      gap: 10
      if pairing || (pairRequest != null && pairToken != null) {
        Pairing { }
      } else if authPending {
        Column {
          gap: 10
          weight: 1
          Text { text: "Verifying new device grant…"; style: title; color: accent }
          Text { text: "Old content and all writes stay closed until /native/me proves the account. Same-account drafts, reading state and pending requests are preserved."; color: muted }
          if authNotice != "" { Text { text: authNotice; color: yellow } }
          if verifyStalled { Text { text: "Verification has not completed. The grant may be invalid or the network unavailable. Retry, pair again, or cancel verification; your drafts are kept."; color: yellow } }
          Flow {
            gap: 8
            Button { text: "Retry verification"; color: muted; onTap: refresh() }
            Button {
              text: pairBusy ? "Finishing the current check…" : "Pair again"
              color: pairBusy ? muted : accent
              onTap: {
                if !pairBusy {
                  authNotice = ""
                  pairStatus = "Starting a five-minute browser challenge…"
                  pairRequest = null
                  pairToken = null
                  pairing = true
                  pairStarting = true
                  pairAttempt = pairAttempt + 1
                  pairStartAttempt = pairAttempt
                  pairStartSeq = pairStartSeq + 1
                  pairStart = null
                  pairStart = post("${api}/auth/native/start", {device_kind: "phone", device_name: "CDM review face"}, {Accept: "application/json"})
                }
              }
            }
            Button {
              text: "Cancel verification"
              color: muted
              onTap: {
                authPending = false
                token = null
                pairing = false
                pairRequest = null
                pairToken = null
                pairStatus = ""
                authNotice = "Verification cancelled. Pair again to review; same-account drafts are kept."
                verifyChecks = 0
              }
            }
          }
        }
      } else if token == null {
        Pairing { }
      } else {
        Row {
          Text { text: "CDM review"; style: title; color: accent; weight: 1 }
          Text { text: "↻"; style: title; color: accent; padding: [8, 4]; onTap: refresh() }
        }
        Text { text: queue == null ? "Count unknown" : "${queue.total} reviews · ${queue.problem_count} problems · ${activityCount + retiredCount} requests"; color: muted }
        QueueStatus { }
        if q != null && !queueValid && !authPending {
          Text { text: "A fresh queue is unavailable. Re-pair or verify the account if this persists; same-account drafts and pending requests are preserved, and a different verified account stays isolated."; color: yellow }
          Button {
            text: pairBusy ? "Finishing the previous check…" : "Re-pair / verify account"
            color: pairBusy ? muted : accent
            onTap: {
              if !pairBusy && !authPending {
                authNotice = ""
                pairStatus = "Starting a five-minute browser challenge…"
                pairRequest = null
                pairToken = null
                pairing = true
                pairStarting = true
                pairAttempt = pairAttempt + 1
                pairStartAttempt = pairAttempt
                pairStartSeq = pairStartSeq + 1
                pairStart = null
                pairStart = post("${api}/auth/native/start", {device_kind: "phone", device_name: "CDM review face"}, {Accept: "application/json"})
              }
            }
          }
        }
        Flow {
          gap: 8
          Text { text: "Review"; padding: [4, 10]; background: tab == "review" ? accent : surface; color: tab == "review" ? background : foreground; onTap: tab = "review" }
          Text { text: queue == null ? "Problems" : "Problems ${queue.problem_count}"; padding: [4, 10]; background: tab == "problems" ? accent : surface; color: tab == "problems" ? background : foreground; onTap: tab = "problems" }
          Text { text: "Requests ${activityCount + retiredCount}"; padding: [4, 10]; background: tab == "activity" ? accent : surface; color: tab == "activity" ? background : foreground; onTap: tab = "activity" }
        }
        if tab == "problems" {
          Column {
            scroll: true
            weight: 1
            gap: 8
            if queue == null || len(problems) == 0 {
              Text { text: queueValid && q.out.complete && (q.out.problem_count ?? 0) == 0 ? "No known preparation problems." : "Problem state unknown or incomplete while the queue is unavailable or partial."; color: muted }
            }
            if queueValid && q.out.problems_complete == false {
              Text { text: "Only the first ${len(problems)} of ${q.out.problem_count} preparation problems are listed here; open the full app for all of them."; color: yellow }
            }
            if cachedQueue != null && !queueValid && cachedQueue.problems_complete == false {
              Text { text: "The cached problem list was incomplete; its count is a lower bound."; color: yellow }
            }
            for p in problems key toJson(p.key) {
              Column {
                gap: 5
                padding: 10
                background: surface
                Text { text: p.title; fontWeight: 600 }
                Text { text: "${p.review_state}: ${p.review_error.message}"; color: yellow }
                Text { text: "Approval stays unavailable until the exact review is ready."; style: small; color: muted }
                if get(itemErrors, toJson({account: account, key: p.key}), null) != null {
                  Text { text: get(itemErrors, toJson({account: account, key: p.key}), {}).message; color: red }
                }
                Flow {
                  gap: 8
                  if p.retry_prepare { ActionButton { item: p; label: "Retry preparation"; action: "prepare"; enabled: queueValid && !authPending && contains(q.out.unavailable_packs ?? [], p.key.pack) == false && !targets.any(t => t != null && t.account == account && t.item.key == p.key) } }
                  Button { text: "Open full app"; onTap: url("${api}/#/${enc(p.key.kind)}/${enc(p.key.pack)}/${enc(p.key.id)}") }
                }
              }
            }
          }
        } else if tab == "activity" {
          Column {
            scroll: true
            weight: 1
            gap: 8
            if activityCount == 0 && retiredCount == 0 { Text { text: "No outstanding or unreconciled requests."; color: muted } }
            if retiredCount > 0 { Text { text: "${retiredCount} previous-account slot(s) remain isolated and count toward the four-slot guard."; color: yellow } }
            for r, i in results {
              let t = targets[i]
              let live = lives[i]
              let err = t == null ? null : get(itemErrors, t.id, null)
              let conflict = t == null ? null : get(conflicts, t.id, null)
              if t != null && t.account == account {
                Column {
                  gap: 5
                  padding: 10
                  background: surface
                  Text { text: "${t.item.title} · ${t.action}"; fontWeight: 600 }
                  Text {
                    text: r == null ? (live ? "Request outstanding; the queue advanced optimistically." : "Restored request: outcome unknown. CHECK ONLY — it will never be resent automatically.") : r.ok ? "Confirmed" : r.code == 409 && conflict != null && conflict.resolved == true ? "Resolved elsewhere; check the exact item." : "Late failure: ${err != null ? err.message : "reopen and check"}"
                    color: r != null && !r.ok && conflict != null && conflict.resolved == true ? yellow : r != null && !r.ok ? red : r == null && !live ? yellow : muted
                  }
                  if live { Text { text: "This request is still in flight. It cannot be cleared or reused until its response or the 30 s timeout is consumed."; style: small; color: muted } }
                  Flow {
                    gap: 8
                    Button {
                      text: r == null && !live ? "Reopen / check only" : "Reopen / check"
                      onTap: {
                        current = t.item
                        hidden = hidden.filter(k => k != t.item.key)
                        tab = "review"
                      }
                    }
                    Button { text: "Full app"; onTap: url("${api}/#/review/${enc(t.item.key.kind)}/${enc(t.item.key.pack)}/${enc(t.item.key.id)}") }
                    if !live {
                      Button {
                        text: "Clear after check"
                        color: muted
                        onTap: {
                          hidden = hidden.filter(k => k != t.item.key)
                          itemErrors = remove(itemErrors, t.id)
                          if i == 0 { res0 = null; tgt0 = null; live0 = false }
                          else if i == 1 { res1 = null; tgt1 = null; live1 = false }
                          else if i == 2 { res2 = null; tgt2 = null; live2 = false }
                          else { res3 = null; tgt3 = null; live3 = false }
                        }
                      }
                    }
                  }
                }
              }
              if t != null && t.account != account {
                Column {
                  gap: 5
                  padding: 10
                  background: surface
                  Text { text: "Previous-account request retained. Item identity/content is hidden; it cannot be reopened, checked or submitted here."; color: yellow }
                  if live {
                    Text { text: "Still in flight; wait for its response or timeout before discarding."; style: small; color: muted }
                  } else {
                    Button {
                      text: "Discard retained slot"
                      color: muted
                      onTap: {
                        if i == 0 { res0 = null; tgt0 = null; live0 = false }
                        else if i == 1 { res1 = null; tgt1 = null; live1 = false }
                        else if i == 2 { res2 = null; tgt2 = null; live2 = false }
                        else { res3 = null; tgt3 = null; live3 = false }
                      }
                    }
                  }
                }
              }
            }
          }
        } else {
          if current == null {
            Column {
              weight: 1
              gap: 10
              Text {
                text: activityCount > 0 ? "Queue advanced. Requests still need confirmation or checking; this is not a background-delivery claim." : queue == null ? "The queue is not loaded. This is unknown, not empty." : !queueValid ? "Showing the cached queue. It is useful for reading but is not a fleet claim, and writes stay paused." : !q.out.complete ? "Some packs are unavailable. The visible page is empty, not the fleet." : queue.next_cursor != null ? "This page is complete; more reviews remain in the full app." : "No visible ready reviews."
                style: title
              }
              if len(visibleItems) > 0 {
                Button { text: "Review next (${len(visibleItems)} on this page)"; onTap: { current = visibleItems[0]; tab = "review" } }
              }
              Button { text: "Open full app"; onTap: url(api) }
              Button { text: "Requests / problems"; color: muted; onTap: tab = activityCount > 0 ? "activity" : "problems" }
              Button { text: "Close"; color: muted; onTap: close() } // the screen's own close
            }
          } else {
            Row {
              Text { text: "${current.key.pack} · ${current.key.kind} #${current.key.id}"; style: small; color: muted; weight: 1 }
              Text { text: currentIndex >= 0 ? "${currentIndex + 1}/${queue.total}" : "exact item"; style: small; color: muted }
            }
            Column {
              scroll: true
              weight: 1
              gap: 10
              Text { text: current.title; style: title; fontWeight: 600 }
              if currentError != null { Text { text: currentError.message; color: red } }
              if currentBusy {
                Column {
                  gap: 4
                  Text { text: "A request for this item is outstanding or needs checking. Actions pause so no tap is dropped."; color: yellow }
                  Button { text: "Open requests"; color: muted; onTap: tab = "activity" }
                }
              }
              if queueValid && current != null && !currentInQueue && queue.next_cursor == null && !contains(q.out.unavailable_packs ?? [], current.key.pack) {
                Text { text: "This item is no longer in the fresh queue. It was probably resolved elsewhere; open the full app or refresh before another action."; color: yellow }
              }
              if !loaded {
                Column {
                  gap: 6
                  Text { text: entry == null ? "Loading exact review…" : "Loading the complete exact review; actions stay disabled until every required part has loaded."; color: muted }
                  Text { text: "If this does not finish, the pack may be unavailable. Retry, or open the full app for the exact item."; style: small; color: muted }
                  Flow {
                    gap: 8
                    Button { text: "Retry exact read"; color: muted; onTap: refresh() }
                    Button { text: "Open full app"; color: muted; onTap: url("${api}/#/${enc(current.key.kind)}/${enc(current.key.pack)}/${enc(current.key.id)}") }
                  }
                }
              }
              if entry != null && loaded {
                if current.key.kind == "gate" {
                  if isReceipt {
                    ReceiptProposal { }
                  } else if mail != null {
                    Text { text: "Subject: ${mail.subject}"; fontWeight: 600 }
                    Text { text: "To: ${recipients}" }
                    if cc != "" { Text { text: "Cc: ${cc}" } }
                    if bcc != "" { Text { text: "Bcc: ${bcc}" } }
                    if htmlOnly {
                      Text { text: "This review has no plain-text body. The native face cannot show its HTML body, so approval and rejection are disabled here. Open the full app to read the formatted message and decide."; color: yellow }
                    } else {
                      Text { text: "Complete body + signature text"; style: small; color: muted }
                      Text { text: mail.body_plain ?? "" }
                      Row { Button { text: "Copy complete text"; color: muted; onTap: copy(mail.body_plain ?? "") } }
                    }
                    for a, i in mail.attachments ?? [] {
                      Button {
                        text: "Attachment: ${a.filename} (${fmtBytes(a.size)})"
                        color: muted
                        onTap: url("${api}/api/swarms/${enc(current.key.pack)}/gates/${enc(current.key.id)}/draft/attachments/${int(i)}")
                      }
                    }
                  } else if isMail {
                    Text { text: "The exact mail body is unavailable, so native approval is disabled. Open the full app for the exact item."; color: yellow }
                  } else {
                    Text { text: "Gate proposal"; style: small; color: muted }
                    Text { text: exact.preview_gfm ?? current.title }
                  }
                  if exact.status != "pending" { Text { text: "Resolved elsewhere (${exact.status}). Your unsent draft is retained."; color: yellow } }
                  if review == null || review.review_state != "ready" { Text { text: "Review is not ready; approval and rejection stay disabled."; color: yellow } }
                  Input {
                    text: draft.reason
                    placeholder: "Rejection reason (required to reject)"
                    onChange: {
                      if get(draftBases, currentId, null) == null { draftBases = set(draftBases, currentId, serverState == null || serverState.revision == null ? "none" : serverState.revision) }
                      drafts = set(drafts, currentId, merge(draft, {reason: value, mode: trim(value) != "" ? "deny" : "normal"}))
                    }
                  }
                  if len(draft.reason) > 4000 { Text { text: "Rejection reason exceeds 4000 characters; shorten it before rejecting."; color: red } }
                } else {
                  Text { text: exact.header ?? "Question"; fontWeight: 600 }
                  Text { text: exact.question ?? "" }
                  if exact.status != "pending" { Text { text: "Answered elsewhere. Your unsent draft is retained."; color: yellow } }
                  for option, i in options {
                    Button {
                      text: "${contains(draft.picks, i) ? "✓" : "○"} ${option.label}${option.description != null ? " — ${option.description}" : ""}"
                      color: contains(draft.picks, i) ? accent : muted
                      onTap: {
                        if get(draftBases, currentId, null) == null { draftBases = set(draftBases, currentId, serverState == null || serverState.revision == null ? "none" : serverState.revision) }
                        drafts = set(drafts, currentId, merge(draft, {picks: exact.multi ? (contains(draft.picks, i) ? draft.picks.filter(p => p != i) : (draft.picks + [i]).sort()) : [i]}))
                      }
                    }
                  }
                  Input {
                    text: draft.text
                    placeholder: "Answer / additional detail"
                    onChange: {
                      if get(draftBases, currentId, null) == null { draftBases = set(draftBases, currentId, serverState == null || serverState.revision == null ? "none" : serverState.revision) }
                      drafts = set(drafts, currentId, merge(draft, {text: value}))
                    }
                  }
                  if len(answerText) > 4000 { Text { text: "Answer exceeds 4000 characters; shorten it before sending."; color: red } }
                }
                if draftTooLong { Text { text: "Draft exceeds the server limits (16000 text / 4000 reason characters); shorten it before saving."; color: red } }
                if currentConflict != null {
                  Column {
                    gap: 5
                    padding: 8
                    background: surface
                    Text { text: currentConflict.resolved == true ? "Resolved elsewhere. Your local unsent copy is still below." : "Server draft changed elsewhere. Both copies are retained; choose explicitly."; color: yellow }
                    if currentConflict.server != null {
                      ServerCopy { server: currentConflict.server }
                      Text { text: "Your local copy stays in the inputs above until you choose. Parking is separate from the draft."; style: small; color: muted }
                    }
                  }
                }
                if serverMoved && currentConflict == null {
                  Column {
                    gap: 5
                    padding: 8
                    background: surface
                    Text { text: "The server draft changed elsewhere since you started editing. Your local copy stays above; both copies are retained."; color: yellow }
                    ServerCopy { server: serverState }
                  }
                }
                if handoffPending && !serverMoved && currentConflict == null {
                  Text { text: "This local draft is not on the server yet. Save draft first, or the full app will not see these edits; the local copy stays on this phone."; color: yellow }
                }
              }
            }
            Flow {
              gap: 8
              ActionButton { item: current; label: "Save draft"; action: "save"; enabled: canWrite && !draftTooLong }
              if current.key.kind == "gate" {
                ActionButton { item: current; label: "Approve"; action: "allow"; advance: true; enabled: gateReady }
                ActionButton { item: current; label: "Reject"; action: "deny"; advance: true; enabled: gateReady && trim(draft.reason) != "" && len(draft.reason) <= 4000 }
              } else {
                ActionButton { item: current; label: "Answer"; action: "answer"; advance: true; enabled: askReady && trim(answerText) != "" && len(answerText) <= 4000 }
              }
              ActionButton { item: current; label: "Skip"; action: "skip"; advance: true; enabled: canWrite && exact != null && exact.status == "pending" }
              Button {
                text: "Next"
                color: muted
                onTap: { current = nextItem; tab = "review" }
              }
              Button { text: handoffPending ? "Quick full app (draft stays local)" : "Quick full app"; color: muted; onTap: url("${api}/#/review/${enc(current.key.kind)}/${enc(current.key.pack)}/${enc(current.key.id)}") }
              Button { text: handoffPending ? "Full app escape (draft stays local)" : "Full app escape"; color: muted; onTap: url("${api}/#/${enc(current.key.kind)}/${enc(current.key.pack)}/${enc(current.key.id)}") }
            }
          }
        }
      }
    }
  }

  onTap: screen()

  Column {
    gap: 8
    Text { text: "CDM review"; style: title; color: accent }
    if authPending {
      Text { text: "Verifying new grant; drafts and requests preserved"; color: yellow }
    } else if token == null {
      Text { text: pairing ? "Browser pairing in progress" : pairRequest != null ? "Pairing challenge pending — tap to resume" : "Tap to pair and open native review"; color: muted }
      if pairRequest != null { Text { text: "Code: ${pairRequest.user_code}"; color: accent } }
      if authNotice != "" { Text { text: authNotice; maxLines: 2; color: yellow } }
    } else {
      Text { text: queue == null ? "Counts unknown — not empty" : "${queue.total} ready · ${queue.problem_count} problems"; style: title }
      if q != null && !queueValid { Text { text: "Offline/stale — actions pause inside"; color: red } }
      if queueValid && !q.out.complete { Text { text: "Partial: ${join(q.out.unavailable_packs, ", ")} unavailable"; color: yellow } }
      if cachedQueue != null && !queueValid && cachedQueue.complete == false { Text { text: "Cached copy partial — counts are lower bounds"; color: yellow } }
      if activityCount + retiredCount > 0 { Text { text: "${activityCount + retiredCount} requests to confirm/check"; color: yellow } }
      if retiredCount > 0 { Text { text: "${retiredCount} previous-account request(s) remain quarantined; open Requests to discard."; maxLines: 2; color: yellow } }
      for p in problems.take(2) key toJson(p.key) {
        Text { text: "⚠ ${p.title}"; maxLines: 2; color: yellow }
      }
      Text { text: "Tap for native review"; style: small; color: muted }
    }
  }

  screen {
    title: "CDM review"
    ReviewScreen { }
  }
}
