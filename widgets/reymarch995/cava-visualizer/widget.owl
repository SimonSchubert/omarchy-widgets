widget "android-cava-visualizer" {
  meta { owl: 6; description: "Visualize Android internal audio with CAVA via the WiFi Audio Streaming app's HTTP stream"; version: "1.1.0"; license: "MIT"; category: "fun" }
  size: 6x2
  minSize: 3x1
  padding: 0

  requires { pacman: ["python", "cava", "ffmpeg"] }

  state paused = false persist
  state playerControlsEnabled = false persist
  state albumBlendEnabled = true persist
  state blendStrength = 90 persist
  state widgetBlendStrength = 120 persist
  source m = android.media
  state showGuide = false
  state addressDraft = ""
  state editingAddress = false
  state settingsScreenSeen = false
  source settings = file("~/.config/omalauncher/cava-visualizer/settings.json") json
  let endpoint = settings.endpoint ?? ""
  let saveEndpoint = """
import json, sys
from pathlib import Path

path = Path.home() / ".config/omalauncher/cava-visualizer/settings.json"
path.parent.mkdir(parents=True, exist_ok=True)
try:
    data = json.loads(path.read_text())
except (OSError, ValueError):
    data = {}

if data.get("endpoint") == sys.argv[1]:
    sys.exit(0)
data["endpoint"] = sys.argv[1]
temp = path.with_name(path.name + ".tmp")
temp.write_text(json.dumps(data) + chr(10))
temp.replace(path)
"""
  let stereo = num(settings.stereo, 0) != 0
  let requestedBars = clamp(int(num(settings.bars, 61)), 4, 64)
  let barCount = stereo ? requestedBars + requestedBars % 2 : requestedBars
  let sensitivity = clamp(int(num(settings.sensitivity, 77)), 1, 100)
  let autoSensitivity = settings.autosens != 0
  let jitteriness = int(num(settings.jitteriness, 32))
  let waveMode = clamp(int(num(settings.wave_mode, settings.bass_waves == 0 ? 0 : 2)), 0, 2)
  let saveSettings = """
import json, sys
from pathlib import Path

path = Path.home() / ".config/omalauncher/cava-visualizer/settings.json"
path.parent.mkdir(parents=True, exist_ok=True)
try:
    data = json.loads(path.read_text())
except (OSError, ValueError):
    data = {}

original = dict(data)
args = sys.argv[1:]
for index in range(0, len(args), 4):
    key, low, high, raw = args[index:index + 4]
    if raw.lstrip("-").isdigit():
        data[key] = max(int(low), min(int(high), int(raw)))

if data == original:
    sys.exit(0)
temp = path.with_name(path.name + ".tmp")
temp.write_text(json.dumps(data) + chr(10))
temp.replace(path)
"""

  component SettingsDivider() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.2) }
  }

  component NumberSetting(key, labelText, current, low, high, step = 1) {
    Column {
      Text { text: labelText; style: label }
      Row {
        gap: 6
        Button {
          text: "←"
          onTap: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${int(current - step)}")
        }
        Slider {
          value: current
          min: low
          max: high
          step: step
          weight: 1
          onChange: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${int(value)}")
        }
        Button {
          text: "→"
          onTap: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${int(current + step)}")
        }
        Input {
          text: str(current)
          placeholder: "number"
          width: 74
          onSubmit: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${sh(trim(value))}")
        }
      }
    }
  }

  // Keep the bridge in this file so a store install needs no helper scripts.
  let bridgeCommand = """python3 -c '
import json, os, select, signal, subprocess, tempfile, time
from collections import deque
from pathlib import Path
from urllib.parse import urlsplit

stopping = False
last_output = None
retry_delay = 2
def stop(_sig, _frame):
    global stopping
    stopping = True
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

def publish(payload):
    global last_output
    output = json.dumps(payload, separators=(",", ":"))
    if output != last_output:
        print(output, flush=True)
        last_output = output

def emit(ok, values, address=None):
    publish({"ok": ok, "bars": values, "scale": display_scale, "address": address})

def bass_only_waves(values, stereo, raw_range):
    # Use CAVA wave shaping on the lowest third of each channel, leaving the
    # remaining frequency bands unchanged. Stereo bass faces the center.
    result = list(values)
    count = len(values)
    channels = [list(range(count))]
    if stereo:
        channels = [list(range(count // 2 - 1, -1, -1)),
                    list(range(count // 2, count))]
    for indices in channels:
        bass_count = min(len(indices), max(2, (len(indices) + 2) // 3))
        bass_indices = indices[:bass_count]
        shaped = [values[i] * raw_range for i in bass_indices]
        for i in range(bass_count):
            shaped[i] /= 1.25
            for j in range(bass_count):
                if i != j:
                    shaped[j] = max(shaped[j], shaped[i] - (i - j) ** 2)
        for i, value in zip(bass_indices, shaped):
            wave = max(0, min(1, int(value) / raw_range))
            result[i] = round(values[i] * 0.45 + wave * 0.55, 3)
    return result

class AutoGain:
    def __init__(self):
        self.gain = 3.0
        self.peaks = deque()
        self.last_adjust = None
        self.last_clip = None

    def update(self, values, now):
        self.peaks.append((now, max(values, default=0)))
        while self.peaks and self.peaks[0][0] < now - 1.5:
            self.peaks.popleft()
        if self.last_adjust is None:
            self.last_adjust = now
            self.last_clip = now
        elapsed = now - self.last_adjust
        if elapsed < 0.5 or now - self.peaks[0][0] < 0.9:
            return round(self.gain, 3)
        peaks = sorted(peak for _, peak in self.peaks)
        clipped = sum(peak * self.gain >= 0.98 for peak in peaks)
        if clipped >= max(2, len(peaks) * 0.3):
            # Leave headroom, reducing in steps so the whole spectrum stays stable.
            reference = peaks[int((len(peaks) - 1) * 0.9)]
            target = max(0.75, min(3.0, 0.88 / max(reference, 0.001)))
            self.gain = min(self.gain, max(target, self.gain * 0.85))
            self.last_clip = now
        elif now - self.last_clip > 8 and 0.02 < peaks[-1] and peaks[-1] * self.gain < 0.65:
            # Recover slowly, only with audible input; silence must not pump gain.
            self.gain = min(3.0, self.gain + min(elapsed, 1) * 0.04)
        self.last_adjust = now
        return round(self.gain, 3)

def settings_version():
    try:
        stat = settings_file.stat()
        return stat.st_mtime_ns, stat.st_size
    except OSError:
        return None

def wait_for_change(seconds):
    version = settings_version()
    deadline = time.monotonic() + seconds
    while not stopping and time.monotonic() < deadline:
        time.sleep(min(1, max(0, deadline - time.monotonic())))
        if settings_version() != version:
            return

def stop_process(proc):
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()

root = Path.home() / ".config/omalauncher/cava-visualizer"
settings_file = root / "settings.json"
publish({"ok": False, "bars": [], "scale": 3.0, "address": None,
                  "message": "connecting to app"})

while not stopping:
    try:
        cfg = json.loads(settings_file.read_text())
    except (OSError, ValueError):
        cfg = {}
    if not isinstance(cfg, dict):
        cfg = {}
    endpoint = str(cfg.get("endpoint") or "").strip()
    if not endpoint:
        publish({"ok": False, "bars": [], "scale": 3.0, "address": None,
                          "message": "set app IP:port"})
        wait_for_change(30)
        continue
    try:
        raw_url = endpoint if "://" in endpoint else "http://" + endpoint
        parsed = urlsplit(raw_url)
        if parsed.scheme != "http":
            raise ValueError
        host = parsed.hostname or ""
        if not host or any(ch.isspace() for ch in host):
            raise ValueError
        port = parsed.port or 8080
        if parsed.query or parsed.fragment or parsed.username or parsed.password:
            raise ValueError
        authority = f"[{host}]" if ":" in host else host
        display_address = f"{authority}:{port}"
        path = parsed.path.rstrip("/") or "/stream"
        url = f"http://{authority}:{port}{path}"
        count = max(4, min(64, int(cfg.get("bars", 61))))
        stereo = cfg.get("stereo", 0) != 0
        if stereo:
            count += count % 2
        sensitivity = max(1, min(100, int(cfg.get("sensitivity", 77))))
        auto_sensitivity = cfg.get("autosens", 1) != 0
        jitteriness = max(0, min(100, int(cfg.get("jitteriness", 32))))
        wave_mode = max(0, min(2, int(cfg.get("wave_mode", 0 if cfg.get("bass_waves", 1) == 0 else 2))))
        # A smaller native wave canvas gives peaks narrower shoulders.
        raw_range = 100 if wave_mode else 1000
        display_scale = 3.0
    except (ValueError, TypeError):
        publish({"ok": False, "bars": [], "scale": 3.0, "address": endpoint,
                          "message": "check app IP:port"})
        wait_for_change(30)
        continue
    zero = [0] * count
    version = settings_version()
    changed = False
    with tempfile.TemporaryDirectory(prefix="oma-cava-") as temp:
        fifo = Path(temp) / "audio.fifo"
        config = Path(temp) / "cava.conf"
        os.mkfifo(fifo, 0o600)
        config.write_text(chr(10).join([
            "[general]", f"bars = {count}", "bar_width = 1", "bar_spacing = 0",
            "framerate = 20", "autosens = 0", f"sensitivity = {sensitivity}",
            "lower_cutoff_freq = 50", "higher_cutoff_freq = 10000",
            "[input]", "method = fifo", f"source = {fifo}", "sample_rate = 44100",
            "sample_bits = 16", "[smoothing]", f"noise_reduction = {100 - jitteriness}",
            f"monstercat = {1 if wave_mode == 2 else 0}", f"waves = {1 if wave_mode == 2 else 0}",
            "[output]",
            "method = raw", "channels = stereo" if stereo else "channels = mono",
            "mono_option = average", "reverse = 0", "raw_target = /dev/stdout",
            "data_format = ascii", f"ascii_max_range = {raw_range}", "bar_delimiter = 59",
            "frame_delimiter = 10"
        ]) + chr(10))
        cava = ffmpeg = None
        fifo_out = None
        try:
            cava = subprocess.Popen(["cava", "-p", str(config)], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, bufsize=0)
            os.set_blocking(cava.stdout.fileno(), False)
            # Keep the FIFO open while children start; Python never copies PCM.
            fifo_out = os.open(fifo, os.O_RDWR | os.O_NONBLOCK)
            ffmpeg = subprocess.Popen([
                "ffmpeg", "-nostdin", "-y", "-threads", "1", "-hide_banner", "-loglevel", "error",
                "-rw_timeout", "3000000", "-reconnect", "1", "-reconnect_streamed", "1",
                "-reconnect_delay_max", "3", "-probesize", "32768", "-analyzeduration", "0",
                "-f", "aac", "-i", url, "-vn", "-f", "s16le", "-acodec", "pcm_s16le",
                "-ar", "44100", "-ac", "2", str(fifo)], stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            buffer = b""
            auto_gain = AutoGain()
            last_frame = last_emit = time.monotonic()
            next_settings_check = last_frame + 1
            while not stopping and ffmpeg.poll() is None and cava.poll() is None:
                now = time.monotonic()
                if now >= next_settings_check:
                    if settings_version() != version:
                        changed = True
                        break
                    next_settings_check = now + 1
                ready, _, _ = select.select([cava.stdout], [], [], 0.5)
                if cava.stdout in ready:
                    latest = None
                    while True:
                        try:
                            chunk = os.read(cava.stdout.fileno(), 8192)
                        except BlockingIOError:
                            break
                        if not chunk:
                            break
                        buffer += chunk
                        while True:
                            cut = buffer.find(bytes([10]))
                            if cut < 0:
                                break
                            line, buffer = buffer[:cut], buffer[cut + 1:]
                            try:
                                values = [max(0, min(1, int(v) / raw_range))
                                          for v in line.decode("ascii").split(";") if v]
                                if len(values) >= count:
                                    latest = values[:count]
                            except ValueError:
                                pass
                        if len(buffer) > 16384:
                            buffer = b""
                    if latest is not None:
                        if wave_mode == 1:
                            latest = bass_only_waves(latest, stereo, raw_range)
                        if auto_sensitivity:
                            display_scale = auto_gain.update(latest, time.monotonic())
                        emit(True, latest, display_address)
                        last_frame = last_emit = time.monotonic()
                        if any(v > 0.015 for v in latest):
                            retry_delay = 2
                now = time.monotonic()
                if now - last_frame > 2.5:
                    break
                if now - last_emit > 1:
                    emit(False, zero, display_address)
                    last_emit = now
        except (OSError, subprocess.SubprocessError):
            pass
        finally:
            stop_process(ffmpeg)
            stop_process(cava)
            if fifo_out is not None:
                os.close(fifo_out)
            if cava is not None and cava.stdout is not None:
                cava.stdout.close()
    if not stopping:
        publish({"ok": False, "bars": zero, "scale": 3.0,
                          "address": display_address,
                          "message": "start app or check URL"})
        if not changed:
            wait_for_change(retry_delay)
            retry_delay = min(30, retry_delay * 2)
'"""
  // A dormant command keeps the stream idle without decoding or polling.
  source frame = stream(paused ? "sleep infinity" : bridgeCommand) json

  let bars = frame != null && frame.ok == true ? frame.bars : []
  let active = frame != null && frame.ok == true
  let scale = frame != null ? num(frame.scale, 3.0) : 3.0
  let audible = !paused && active && any(bars, v => num(v, 0) > 0.015)

  when editingAddress && screenWidth > 0 { settingsScreenSeen = true }
  when editingAddress && settingsScreenSeen && screenWidth == null {
    run("python3 -c ${sh(saveEndpoint)} ${sh(trim(addressDraft))}")
    editingAddress = false
    settingsScreenSeen = false
  }

  Box {
    fill: true
    // Match now-playing-plus: album art fades into the theme background.
    let widgetBlend = widgetBlendStrength / 100
    if albumBlendEnabled && m.art != null {
      Image { src: m.art; fit: cover; fill: true; opacity: blendStrength / 100 }
      Canvas {
        fill: true
        rect(0, 0, width, height, fill: linear(0, 0, width, 0, [alpha(background, min(1, widgetBlend * 0.4)), alpha(background, min(1, widgetBlend * 0.7)), alpha(background, min(1, widgetBlend))]))
      }
    }
    Box {
      fill: true
      padding: 12
      Canvas {
        fill: true
        // Draw the selected CAVA wave shape without extra temporal filtering.
        let n = min(len(bars), 64)
        if !paused && n > 0 {
          let gap = max(2, width * 0.012)
          let bw = max(2, (width - gap * (n - 1)) / n)
          for i in range(n) {
            let level = clamp(num(bars[i], 0) * scale, 0, 1)
            let bh = height * level
            let x = i * (bw + gap)
            let y = height - bh
            rect(x, y, bw, bh, radius: min(bw / 2, 6), fill: active ? mix(accent, cyan, i / max(n - 1, 1) * 0.45) : alpha(muted, 0.28))
          }
        }
        if !paused && !audible {
          let msg = frame != null && frame.message != null ? str(frame.message) : "waiting for audio"
          // A narrow tile (landscape) can't fit the line at 13sp: split it in two and shrink if still needed.
          if len(msg) * 13 * 0.6 <= width - 8 {
            text(msg, width / 2, (height / 2 - 8), size: 13, align: center, color: foreground)
          } else {
            let ws = words(msg)
            let half = ceil(len(ws) / 2)
            let l1 = join(take(ws, half), " ")
            let l2 = join(drop(ws, half), " ")
            let fs = clamp((width - 8) / (max(len(l1), len(l2)) * 0.6), 8, 13)
            text(l1, width / 2, (height / 2 - 8) - fs * 0.65, size: fs, align: center, color: foreground)
            text(l2, width / 2, (height / 2 - 8) + fs * 0.65, size: fs, align: center, color: foreground)
          }
          if frame != null && frame.address != null && frame.address != "" {
            text(frame.address, width / 2, height / 2 + 20, size: 10, align: center, color: muted)
          }
        }
      }

      Row {
        fill: true
        gap: 4
        justify: spaceBetween
        align: top
        Button {
          text: "⚙︎"
          background: surface
          onTap: {
            addressDraft = endpoint
            editingAddress = true
            settingsScreenSeen = false
            screen()
          }
        }
        Button { text: paused ? "▶" : "Ⅱ"; background: surface; onTap: paused = !paused }
      }

      Box {
        fill: true
        align: center
        if paused { Text { text: "[paused]"; style: title; color: muted; align: center } }
      }
      if playerControlsEnabled {
        Box {
          fill: true
          align: bottomEnd
          Row {
            width: 116
            height: 32
            gap: 4
            Button { text: "⏮"; width: 36; height: 32; background: alpha(surface, 0.7); onTap: media("previous") }
            Button { text: m.playing == true ? "Ⅱ" : "▶"; width: 36; height: 32; background: alpha(surface, 0.7); onTap: media("toggle") }
            Button { text: "⏭"; width: 36; height: 32; background: alpha(surface, 0.7); onTap: media("next") }
          }
        }
      }
    }
  }

  screen {
    title: "visualizer settings"
    Column {
      fill: true
      scroll: true
      gap: 10

      Button { text: showGuide ? "hide guide ?" : "guide ?"; onTap: showGuide = !showGuide }
      if showGuide {
        Text {
          text: "Install WiFi Audio Streaming. In the app, choose Send (Server), select HTTP/Web, then start streaming. Play audio on the phone and enter the server IP:port below. If there is no audio, open the app settings and make sure Internal Audio is toggled on; grant capture permission if prompted. If latency is too high, decrease it in the app."
          style: body
          color: foreground
        }
      }

      SettingsDivider { }
      Text { text: "audio server address"; style: label }
      Input {
        text: addressDraft
        placeholder: "192.168.1.20 (port defaults to 8080)"
        onChange: addressDraft = value
      }

      SettingsDivider { }
      Text { text: "frequency layout"; style: label }
      Button {
        text: stereo ? "Stereo · bass in center" : "Mono · bass on left"
        onTap: run("python3 -c ${sh(saveSettings)} stereo 0 1 ${stereo ? 0 : 1}")
      }
      Text { text: "50 Hz–10 kHz per channel. Stereo mirrors the left and right channels, like CAVA."; style: small; color: muted }
      SettingsDivider { }
      NumberSetting { key: "bars"; labelText: "bar count"; current: barCount; low: 4; high: 64; step: stereo ? 2 : 1 }
      SettingsDivider { }
      NumberSetting { key: "sensitivity"; labelText: "sensitivity"; current: sensitivity; low: 1; high: 100 }
      SettingsDivider { }
      Text { text: "auto sensitivity"; style: label }
      Button {
        text: autoSensitivity ? "Enabled" : "Disabled"
        onTap: run("python3 -c ${sh(saveSettings)} autosens 0 1 ${autoSensitivity ? 0 : 1}")
      }
      Text { text: "Lowers gain when peaks repeatedly reach the top, then recovers slowly during quieter music. Manual sensitivity stays saved."; style: small; color: muted }
      SettingsDivider { }
      NumberSetting { key: "jitteriness"; labelText: "jitteriness (higher = more)"; current: jitteriness; low: 0; high: 100 }
      SettingsDivider { }
      Text { text: "wave smoothing"; style: label }
      Flow {
        gap: 6
        for mode in [{label: "Off", value: 0}, {label: "Bass only", value: 1}, {label: "Full spectrum", value: 2}] {
          Button {
            text: mode.label
            background: waveMode == mode.value ? alpha(accent, 0.2) : surface
            onTap: run("python3 -c ${sh(saveSettings)} wave_mode 0 2 ${sh(mode.value)}")
          }
        }
      }
      SettingsDivider { }
      Button {
        text: "reset CAVA defaults"
        onTap: run("python3 -c ${sh(saveSettings)} bars 4 64 61 sensitivity 1 100 77 jitteriness 0 100 32 stereo 0 1 0 autosens 0 1 1 wave_mode 0 2 2")
      }

      SettingsDivider { }
      Text { text: "album art background"; style: label }
      Text { text: "Use the current track’s album art, fading into the background from left to right."; style: small; color: muted }
      Row {
        gap: 8
        Button {
          text: "Default"
          background: albumBlendEnabled && blendStrength == 90 && widgetBlendStrength == 120 ? alpha(accent, 0.2) : surface
          onTap: {
            albumBlendEnabled = true
            blendStrength = 90
            widgetBlendStrength = 120
          }
        }
      }
      Button {
        text: albumBlendEnabled ? "Enabled" : "Disabled"
        onTap: albumBlendEnabled = !albumBlendEnabled
      }
      if albumBlendEnabled {
        if m.available == false {
          Button { text: "grant access to album art"; onTap: media("open") }
        } else if m.art == null {
          Text { text: "Album art appears when your music app shares it."; style: small; color: muted }
        }
        Text { text: "album art visibility: ${round(blendStrength)}%"; style: small; color: muted }
        Slider {
          value: blendStrength
          min: 0
          max: 100
          step: 5
          live: true
          onChange: blendStrength = value
        }
        Text { text: "background blend: ${round(widgetBlendStrength)}%"; style: small; color: muted }
        Slider {
          value: widgetBlendStrength
          min: 0
          max: 200
          step: 5
          live: true
          onChange: widgetBlendStrength = value
        }
      }

      SettingsDivider { }
      Text { text: "music player controls"; style: label }
      Text { text: "Show previous, play/pause and next at the bottom right."; style: small; color: muted }
      Button {
        text: playerControlsEnabled ? "Enabled" : "Disabled"
        onTap: playerControlsEnabled = !playerControlsEnabled
      }
      if playerControlsEnabled && m.available == false {
        Button { text: "grant access to music controls"; onTap: media("open") }
      }

      SettingsDivider { }
      Button {
        text: "close"
        onTap: {
          run("python3 -c ${sh(saveEndpoint)} ${sh(trim(addressDraft))}")
          editingAddress = false
          settingsScreenSeen = false
          close()
        }
      }
    }
  }
}
