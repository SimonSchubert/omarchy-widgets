widget "herdr control" {
  size: 3x4
  minSize: 3x3
  padding: 10

  meta {
    owl: 11
    description: "Monitor named remote Herdr agents and open one directly in a terminal"
    version: "1.1"
    license: "MIT"
    category: "dev"
  }

  requires { pacman: ["openssh", "jq"] }
  // Enter an OpenSSH target, such as user@server.example.com or a Host alias.
  state connectionTarget = "" persist
  state view = "sessions"
  state showSessions = false persist


  // Discovery polls each running session's snapshot so agent names and statuses stay current.
  source remote = cmd("if [ -z ${sh(connectionTarget)} ]; then printf '{\"ok\":false,\"error\":\"configure remote access\",\"sessions\":[]}'; else list=$(ssh -n -o BatchMode=yes -o ConnectTimeout=8 ${sh(connectionTarget)} '~/.local/bin/herdr session list --json' 2>/dev/null) || { printf '{\"ok\":false,\"error\":\"remote Herdr is unavailable\",\"sessions\":[]}'; exit 0; }; printf '%s' \"$list\" | jq -c '.sessions[]?' | while IFS= read -r session; do name=$(printf '%s' \"$session\" | jq -r '.name'); directory=$(printf '%s' \"$session\" | jq -r '.session_dir // \"\"'); running=$(printf '%s' \"$session\" | jq -r '.running // false'); states='[]'; agents='[]'; if [ \"$running\" = true ]; then safe_name=$(printf '%q' \"$name\"); snapshot=$(ssh -n -o BatchMode=yes -o ConnectTimeout=8 ${sh(connectionTarget)} \"~/.local/bin/herdr --session $safe_name api snapshot\" 2>/dev/null || true); if [ -n \"$snapshot\" ]; then states=$(printf '%s' \"$snapshot\" | jq -c '[.result.snapshot.agents[]?.agent_status? | select(type == \"string\")] | unique' 2>/dev/null || printf '[]'); agents=$(printf '%s' \"$snapshot\" | jq -c '.result.snapshot as $s | ([ $s.workspaces[]? | {key: .workspace_id, value: (.label // (\"space \" + ((.number // 0) | tostring)))} ] | from_entries) as $workspace_names | ($s.agents // []) | map({id: (.pane_id // .terminal_id // .agent), name: ($workspace_names[.workspace_id] // .agent // .terminal_title_stripped // .terminal_title // .pane_id), terminal: (.terminal_id // \"\"), cwd: (.foreground_cwd // .cwd // \"\"), status: (.agent_status // \"unknown\")})' 2>/dev/null || printf '[]'); fi; fi; status=$(printf '%s' \"$states\" | jq -r 'if any(.[]; . == \"blocked\") then \"blocked\" elif any(.[]; . == \"done\") then \"done\" elif any(.[]; . == \"working\") then \"working\" elif length > 0 then \"idle\" else \"running\" end'); jq -cn --arg name \"$name\" --arg directory \"$directory\" --arg status \"$status\" --argjson states \"$states\" --argjson agents \"$agents\" '{name: $name, directory: $directory, status: $status, running: ($status != \"stopped\"), attention: ($status == \"blocked\" or $status == \"done\"), states: $states, agents: $agents}'; done | jq -sc '{ok:true,sessions:.}'; fi") every 15s json timeout 30s status
  let payload = remote.out ?? {ok: false, error: "connecting…", sessions: []}
  let sessions = (payload.sessions ?? []).sortBy(s => s.name)
  let connected = remote.ok == true && payload.ok == true
  let connectionStatus = remote == null ? "connecting" : remote.ok != true ? "command failed" : payload.ok == true ? "connected" : payload.error ?? "unavailable"
  let connectionDetail = connectionStatus == "connected" ? "${len(sessions)} sessions found" : remote.err ?? payload.error ?? "waiting for first poll"
  let connectionColor = connectionStatus == "connected" ? green : connectionStatus == "connecting" ? yellow : red
  let attention = sessions.filter(s => s.attention)
  let agentCount = sum(sessions.map(s => len(s.agents ?? [])))
  let listEmpty = showSessions ? len(sessions) == 0 : agentCount == 0

  onTap: screen()

  Column {
    gap: 6
    fill: true
    Text { text: "herdr"; style: muted }
    Row {
      align: center
      Text { text: connected ? (showSessions ? "${len(sessions)} sessions" : "${agentCount} agents") : payload.error ?? "loading…"; style: title; weight: 1; maxLines: 1 }
      if len(attention) > 0 {
        Text { text: "${len(attention)} !"; style: label; color: red; align: end }
      }
    }
    if len(sessions) == 0 {
      Text { text: connected ? (showSessions ? "no remote sessions" : "no remote agents") : "check settings"; style: small; color: muted; maxLines: 2 }
    } else {
      Column {
        gap: 4
        weight: 1
        scroll: true
        for s in sessions key s.name {
          Column {
            gap: 1
            if showSessions {
            Row {
              gap: 6
              height: 48
              align: center
              padding: [4, 2]
              background: alpha(surface, 0.35)
              border: 1
              borderColor: border
              radius: 4 * corners
              onTap: terminal("ssh ${sh(connectionTarget)} -tt '~/.local/bin/herdr' --session ${sh(s.name)}", "herdr · ${s.name}")
              Text {
                text: "●"
                color: s.status == "blocked" ? red : s.status == "done" ? yellow : s.status == "working" ? accent : s.status == "idle" ? green : muted
                fontSize: 14
                width: 14
              }
              Column {
                gap: 1
                weight: 1
                Text { text: s.name; fontSize: 14; maxLines: 1 }
                Text { text: s.directory; style: label; color: muted; maxLines: 1 }
              }
              Text { text: s.status; style: label; color: s.attention ? red : muted; maxLines: 1; align: end }
            }
            }
            for a in s.agents ?? [] key a.id {
              Row {
                gap: 6
                height: 48
                align: center
                padding: showSessions ? [20, 2, 4, 2] : [4, 2]
                background: alpha(surface, 0.25)
                border: 1
                borderColor: alpha(border, 0.8)
                radius: 4 * corners
                onTap: terminal("ssh ${sh(connectionTarget)} -tt '~/.local/bin/herdr' --session ${sh(s.name)} terminal attach ${sh(a.terminal)}", "herdr · ${s.name} · ${a.name}")
                Text { text: "◆"; color: accent; width: 14 }
                Column {
                  gap: 0
                  weight: 1
                  Text { text: a.name; style: small; maxLines: 1 }
                  Text { text: a.cwd; style: label; color: muted; maxLines: 1 }
                }
                Text { text: a.status; style: label; color: a.status == "blocked" ? red : a.status == "working" ? accent : muted; maxLines: 1; align: end }
              }
            }
          }
        }
      }
    }
    Row {
      gap: 8
      Text { text: "tap for settings"; style: muted; weight: 1 }
      Text { text: "⚙"; color: accent; onTap: { view = "settings"; screen() } }
    }
  }

  screen {
    title: view == "settings" ? "herdr settings" : showSessions ? "herdr sessions" : "herdr agents"
    Column {
      gap: 12
      padding: [12, 0]
      scroll: true

      if view == "settings" {
        Text { text: "remote connection"; style: title }
        Text { text: "Use a host, user@host, or a Host alias from ~/.ssh/config. Herdr connects through OpenSSH and opens the selected named session."; style: muted; maxLines: 4 }

        Text { text: "status"; style: label }
        Row {
          gap: 8
          Text { text: connectionStatus; color: connectionColor; weight: 1 }
          Text { text: connectionDetail; style: small; color: muted; align: end; maxLines: 2 }
        }

        Text { text: "remote target"; style: label }
        Input { text: connectionTarget; placeholder: "user@server.example.com"; onChange: connectionTarget = trim(value) }
        Text { text: "session rows"; style: label }
        Button { text: showSessions ? "enabled · show sessions" : "disabled · hide sessions"; onTap: showSessions = !showSessions }
        Text { text: "When disabled, the tile hides session rows."; style: small; color: muted; maxLines: 3 }

        Text { text: "SSH key setup"; style: label }
        Text { text: "If you do not already have a key, run this in a terminal:"; style: small; color: muted; maxLines: 2 }
        Text { text: "ssh-keygen -t ed25519"; font: mono; style: small; color: accent; maxLines: 1 }
        Text { text: "Copy the key to the remote host:"; style: small; color: muted; maxLines: 2 }
        Text { text: "ssh-copy-id user@host"; font: mono; style: small; color: accent; maxLines: 2 }
        Text { text: "For a non-default SSH port, add a Host entry to ~/.ssh/config and enter its alias. Then refresh this widget."; style: small; color: muted; maxLines: 3 }

        Row {
          gap: 10
          Button { text: "back"; onTap: { view = "sessions"; close() } }
          Button { text: "done"; onTap: { view = "sessions"; close(); refresh() } }
        }
      } else {
        Row {
          align: center
          Text { text: showSessions ? "${len(sessions)} remote sessions" : "${agentCount} remote agents"; style: title; weight: 1 }
          Text { text: "settings"; style: small; color: accent; onTap: view = "settings" }
        }
        Text { text: connected ? (showSessions ? "Tap a session to open only that session in Herdr." : "Tap an agent to attach directly.") : payload.error ?? "loading…"; style: muted; maxLines: 3 }

        if listEmpty {
          Text { text: connected ? (showSessions ? "No sessions found." : "No agents found.") : "Open settings to check the remote target and SSH credentials."; style: body; color: muted; maxLines: 4 }
        } else {
          for s in sessions key s.name {
            Column {
              gap: 6
              padding: showSessions ? 12 : 0
              background: showSessions ? alpha(surface, 0.65) : alpha(background, 0)
              border: showSessions ? 1 : 0
              borderColor: s.attention ? red : border
              radius: showSessions ? 8 * corners : 0
              onTap: { if showSessions { terminal("ssh ${sh(connectionTarget)} -tt '~/.local/bin/herdr' --session ${sh(s.name)}", "herdr · ${s.name}") } }
              if showSessions {
              Row {
                gap: 10
                height: 48
                align: center
                Text {
                  text: "●"
                  color: s.status == "blocked" ? red : s.status == "done" ? yellow : s.status == "working" ? accent : s.status == "idle" ? green : muted
                  fontSize: 18
                  width: 20
                }
                Column {
                  gap: 3
                  weight: 1
                  Text { text: s.name; fontSize: 15; bold: true; maxLines: 1 }
                  Text { text: s.directory; style: small; color: muted; maxLines: 1 }
                  Text { text: s.status == "blocked" ? "needs your answer" : s.status == "done" ? "ready for your review" : s.status; style: label; color: s.attention ? red : muted; maxLines: 2 }
                }
                Text { text: "open ↗"; style: small; color: accent; align: center }
              }
              }
              for a in s.agents ?? [] key a.id {
                Row {
                  gap: 8
                  height: 48
                  align: center
                  padding: showSessions ? [12, 6, 4, 6] : [4, 6]
                  background: alpha(surface, 0.3)
                  border: 1
                  borderColor: border
                  radius: 4 * corners
                  onTap: terminal("ssh ${sh(connectionTarget)} -tt '~/.local/bin/herdr' --session ${sh(s.name)} terminal attach ${sh(a.terminal)}", "herdr · ${s.name} · ${a.name}")
                  Text { text: "◆"; color: accent; width: 18 }
                  Column {
                    gap: 0
                    weight: 1
                    Text { text: a.name; style: small; maxLines: 1 }
                    Text { text: a.cwd; style: label; color: muted; maxLines: 1 }
                  }
                  Text { text: a.status; style: label; color: a.status == "blocked" ? red : a.status == "working" ? accent : muted; align: end }
                }
              }
            }
          }
        }

        Row {
          gap: 10
          Button { text: "refresh"; onTap: refresh() }
          Button { text: "settings"; onTap: view = "settings" }
        }
      }
    }
  }
}
