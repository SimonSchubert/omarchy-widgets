widget "widget maker" {
  size: 6x4
  minSize: 4x3
  meta { owl: 6; description: "Describe a widget in plain words and Claude Code writes and checks it. You see what it runs before you add it to your home screen"; version: "1.1"; license: "MIT"; category: "dev" }

  requires { pacman: ["jq", "diffutils"] }

  // How it works: the tile installs a small script, ~/.local/share/owlmaker/make. It hands your
  // request to Claude Code, together with README.md and examples/. Claude writes one draft in
  // ~/.cache/owlmaker/pending and checks it with owlmaker-check, which copies it into the widgets
  // folder for owl-check and takes it out again. Claude Code can only write that one draft, its
  // Bash can only run owlmaker-check, and it has no web or MCP connectors. A draft that passes
  // waits on the full screen, which shows what it runs; it only reaches the home screen when you
  // tap add (or apply, for a change). A draft that fails is moved to ~/.cache/owlmaker/failed.
  source now = clock every 1s
  source env = cmd("""
    d=~/.local/share/owlmaker
    has() { command -v "$1" >/dev/null && echo true || echo false; }
    printf '{"v":"%s","claude":%s}' "$(cat $d/VERSION 2>/dev/null)" "$(has claude)"
  """) every 5m json
  source st = file("~/.cache/owlmaker/status.json") json
  source step = file("~/.cache/owlmaker/step")
  // Whether the run is really still going: its pid file holds a pid and that process's start time.
  source alive = cmd("""
    read -r p s < ~/.cache/owlmaker/pid 2>/dev/null && [ -n "$s" ] &&
      [ "$(sed 's/.*) //' /proc/$p/stat 2>/dev/null | cut -d' ' -f20)" = "$s" ] && r=true || r=false
    printf '{"run":%s,"t":%s}' $r "$(date +%s)"
  """) every 1m json
  // The widgets made here: file|title, newest first.
  source made = cmd("""
    cd ~/.config/omalauncher/widgets 2>/dev/null || exit 0
    for f in $(ls -t made-*.owl 2>/dev/null); do
      printf '%s|%s\n' "$f" "$(sed -n 's/^widget "\([^"]*\)".*/\1/p' "$f" | head -1)"
    done
  """) every 1m
  // Drafts waiting to be added: their title, the lines that run or install something and, for a
  // change, the diff against the widget on the home screen.
  source pending = cmd("""
    W=~/.config/omalauncher/widgets
    cd ~/.cache/owlmaker/pending 2>/dev/null || { echo '[]'; exit 0; }
    for f in $(ls -t *.owl 2>/dev/null); do
      runs=$(awk -v q="$(printf '\042\042\042')" '
        b { sub(/^[ \t]+/, ""); print; if (index($0, q)) b = 0; next }
        /(cmd|run|http|launcher|open)\(|requires/ { s = $0; if (gsub(q, "", s) % 2) b = 1; sub(/^[ \t]+/, ""); print }
      ' "$f")
      [ ${#runs} -gt 8000 ] && runs="${runs:0:8000}
… and more: discard it if you're not sure"
      edit=false; changes=""
      [ -f "$W/$f" ] && { edit=true; changes=$(diff -u "$W/$f" "$f" | tail -n +3 | grep '^[-+]' | head -c 4000); }
      jq -nc --arg file "$f" --arg title "$(sed -n 's/^widget "\([^"]*\)".*/\1/p' "$f" | head -1)" \
        --arg runs "$runs" --arg changes "$changes" --argjson edit $edit \
        '{file:$file, title:$title, runs:$runs, changes:$changes, edit:$edit}'
    done | jq -sc .
  """) every 1m json

  state notified = 0 persist
  state next = "" persist       // a request waiting for the current run to finish
  state nextEdit = "" persist
  state editing = ""            // the made widget the field changes, on the full screen
  state confirmDel = ""
  state gone = []
  state sentAt = 0

  let version = "6"
  let hasClaude = env.claude == true
  let ready = env.v == version
  let stopped = st.state == "working" && alive.run == false && alive.t >= st.t
  let working = st.state == "working" && !stopped
  let starting = sentAt > 0 && (st.t ?? 0) < sentAt && (now ?? 0) - sentAt < 45
  let busy = working || starting
  let drafts = pending ?? []
  let list = lines(made ?? "").filter(l => l != "").map(l => {file: split(l, "|")[0], title: split(l, "|").drop(1).join("|")}).filter(m => gone.indexOf(m.file) < 0)
  let titleOf = list.find(m => m.file == editing).title ?? editing
  let ideas = [
    "my phone's storage as a ring, with the biggest folders in ~ below it",
    "a countdown to New Year with a big number of days",
    "today's top 5 Hacker News stories, tap to open",
    "the ISS position on a small world map, updated every minute"
  ]

  on st.state { refresh() }
  when ready && !busy && next != "" && hasClaude {
    run("printf '%s' ${sh(next)} > ~/.cache/owlmaker/request.txt; printf '%s' ${sh(nextEdit)} > ~/.cache/owlmaker/target.txt; setsid ~/.local/share/owlmaker/make claude >/dev/null 2>&1 &")
    sentAt = now
    next = ""
    nextEdit = ""
  }
  when st.state == "done" && st.t != notified {
    notify(st.edit != "" ? "change ready" : "widget ready", "Open widget maker to see what it runs and add it")
    notified = st.t
  }

  onTap: screen()

  component Spinner() {
    Canvas { width: 16; height: 16; arc(8, 8, 6, (now ?? 0) * 90 % 360, 100, stroke: accent, width: 2, cap: round) }
  }

  component AgentChip() {
    Text {
      text: "claude"
      style: small
      color: accent
      align: center
      width: 84
      padding: [8, 3]
      border: 1
      borderColor: accent
      radius: 10
    }
  }

  component Status() {
    if starting {
      Row { align: center; Spinner {}; Text { text: "starting…"; style: small; color: accent; weight: 1 } }
    } else if working {
      Column {
        gap: 4
        Text { text: st.edit != "" ? "changing: ${st.req}" : st.req; style: body; maxLines: 2 }
        Row {
          align: center
          Spinner {}
          Text { text: trim(step ?? "") == "" ? "working" : trim(step); style: small; color: accent; weight: 1; maxLines: 1 }
          Text { text: fmtDuration(now - st.t); style: small; color: muted; width: 56; align: end }
        }
      }
    } else if st.state == "failed" {
      Text { text: "✗ ${st.error}"; style: small; color: red; maxLines: 3 }
    } else if stopped {
      Text { text: "✗ stopped before it finished (Linux or the app was closed): send it again"; style: small; color: red; maxLines: 2 }
    }
  }

  Column {
    gap: 8
    fill: true
    Row {
      align: center
      Text { text: "widget maker"; style: label; weight: 1 }
      if ready && hasClaude { AgentChip {} }
    }
    if env != null && !hasClaude {
      Text { text: "Widget maker uses Claude Code. Install it and log in first."; style: small; maxLines: 3 }
      Button { text: "set up Claude Code"; onTap: launcher("agents") }
    } else if !ready {
      Text { text: env.v == "" ? "One-time setup: a small script that runs Claude Code." : "An update to the widget maker script is ready."; style: small; color: muted; maxLines: 2 }
      Button {
        text: env.v == "" ? "set up" : "update"
        onTap: run("""
mkdir -p ~/.local/share/owlmaker/bin ~/.cache/owlmaker/pending
cat > ~/.local/share/owlmaker/bin/owlmaker-check.new <<'CHECK_EOF'
#!/bin/bash
# owlmaker-check: owl-check only reads widgets in the widgets folder, so the draft named in
# $OWLMAKER_DRAFT goes in for the check and comes out again. Previews are kept in ~/.cache/owlmaker.
d=$OWLMAKER_DRAFT
[ -f "$d" ] || { echo "no draft at $d"; exit 1; }
W=~/.config/omalauncher/widgets
C=~/.cache/owlmaker
t=$W/owlmaker-check.owl
cp "$d" "$t"
out=$(owl-check "$t" 2>&1)
s=$?
cp "$W/.preview/owlmaker-check.owl.png" "$C/preview.png" 2>/dev/null
cp "$W/.preview/owlmaker-check.owl.screen.png" "$C/preview.screen.png" 2>/dev/null
rm -f "$t"
printf '%s\n' "$out" | sed -e "s|$W/.preview/owlmaker-check.owl.screen.png|$C/preview.screen.png|" \
  -e "s|$W/.preview/owlmaker-check.owl.png|$C/preview.png|" -e "s|owlmaker-check.owl|$(basename "$d")|g"
exit $s
CHECK_EOF
cat > ~/.local/share/owlmaker/make.new <<'MAKE_EOF'
#!/bin/bash
# make claude: drafts the widget described in ~/.cache/owlmaker/request.txt, or a change to the
# file named in target.txt, in ~/.cache/owlmaker/pending. The widget maker's full screen shows a
# draft and adds it to the home screen only when the user taps add.
# Progress: ~/.cache/owlmaker/status.json and step.
agent=$1
W=~/.config/omalauncher/widgets
C=~/.cache/owlmaker
P=$C/pending
mkdir -p "$C/failed" "$P"
req=$(head -c 4000 "$C/request.txt")
target=$(basename -- "$(cat "$C/target.txt" 2>/dev/null)" 2>/dev/null)
started() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f20; }
[ -f "$C/pid" ] && read -r p s <"$C/pid"
if [ -n "$s" ] && [ "$(started "$p")" = "$s" ]; then echo "already making one" >&2; exit 1; fi
echo "$$ $(started $$)" >"$C/pid"
trap 'rm -f "$C/pid"' EXIT

status() { # state file summary error
  jq -nc --arg state "$1" --arg req "$req" --arg file "$2" --arg summary "$3" --arg error "$4" \
    --arg agent "$agent" --arg edit "$target" --argjson t "$(date +%s)" \
    '{state:$state, req:$req, file:$file, summary:$summary, error:$error, agent:$agent, edit:$edit, t:$t}' \
    >"$C/status.tmp" && mv "$C/status.tmp" "$C/status.json"
}
step() { echo "$1" >"$C/step"; }
step "starting $agent"
status working "" "" ""
[ "$agent" = claude ] || { status failed "" "" "unknown agent: $agent"; exit 1; }

rm -f "$C/backup.owl"
if [ -n "$target" ]; then
  name=$target
  F=$P/$name
  # A change starts from a draft of the same widget that is still waiting, if there is one.
  if [ -f "$F" ]; then cp "$F" "$C/backup.owl"
  elif [ -f "$W/$name" ]; then cp "$W/$name" "$F"
  else status failed "" "" "that widget isn't there any more"; exit 1; fi
  task="Change the widget in $F as asked: $req
Keep everything the request doesn't touch. Raise its meta version (1.0 becomes 1.1)."
else
  name=made-$(date +%m%d-%H%M%S).owl
  F=$P/$name
  task="Make a new home-screen widget: $req
Write it to exactly this file: $F"
fi
prompt="You write home-screen widgets for omalauncher, an Android launcher with Arch Linux inside.
$task

First read $W/README.md, which documents the OWL widget language, and one or two files in
$W/examples/ that are close to the request. Then write the widget. Then run: owlmaker-check
It checks $F the way the launcher sees it, and prints errors and the paths of PNG previews
drawn with live data. Fix every error, open the PNGs, and fix what looks wrong: cut-off or
overlapping text, wasted space, unreadable colours, a layout that doesn't fit the tile. Check
again; at most four rounds.

Rules:
- Create or change only $F. You can't write anywhere else.
- Nothing personal in the file: no tokens, keys, names or home location. If the widget needs one,
  keep it in a persisted state that the user sets with an Input on the widget's screen { }.
- Prefer http() and file() over shell commands that fetch or read. Poll no more often than the data changes.
  Read 'time' only if the widget really animates (it redraws every frame).
- Put values into commands the way README.md says, so a value can never run as code.
- Include meta { owl: <the version it needs>; description; version: \"1.0\"; license: \"MIT\";
  category }. Declare every package its commands need in requires { pacman: [...] }. Don't install
  anything: the widget offers the install to the user. Errors from a missing program that is in
  requires are fine.
- Use theme colour names so it follows the user's theme. Make it look good: it's on their home screen.
Don't ask questions; make sensible choices. End with one short sentence saying what the widget shows."

cd "$P"
: >"$C/agent.log"
# File tools that can only write the draft, Bash only for owlmaker-check, no web and no MCP connectors.
OWLMAKER_DRAFT=$F PATH=~/.local/share/owlmaker/bin:$PATH ENABLE_CLAUDEAI_MCP_SERVERS=false \
  claude -p "$prompt" --strict-mcp-config \
  --tools "Read,Write,Edit,Glob,Grep,Bash" \
  --allowedTools "Read Glob Grep Edit(./$name) Bash(owlmaker-check:*)" \
  --output-format stream-json --verbose 2>"$C/agent.err" |
while IFS= read -r line; do
  printf '%s\n' "$line" >>"$C/agent.log"
  t=$(jq -r 'select(.type=="assistant") | .message.content[]? | select(.type=="tool_use")
    | .name + " " + ((.input.file_path // .input.command // .input.pattern // "") | tostring)' <<<"$line" 2>/dev/null | tail -1)
  case "$t" in
    "Read "*README*) step "reading the OWL docs" ;;
    "Read "*.png) step "looking at the preview" ;;
    "Read "*|"Glob "*|"Grep "*) step "looking at examples" ;;
    "Write "*) step "writing the widget" ;;
    "Edit "*) step "polishing it" ;;
    "Bash "*owlmaker-check*) step "checking it on the launcher" ;;
  esac
done
summary=$(jq -r 'select(.type=="result") | .result // empty' "$C/agent.log" 2>/dev/null | grep -v '^\s*$' | tail -1 | cut -c1-300)
[ -n "$summary" ] || summary=$(grep -v '^\s*$' "$C/agent.log" | tail -1 | cut -c1-300)

# The draft has to compile. Runtime errors are allowed: a package in requires may not be installed yet.
step "final check"
rm -f "$C/check.txt"
[ -f "$F" ] && OWLMAKER_DRAFT=$F ~/.local/share/owlmaker/bin/owlmaker-check >"$C/check.txt" 2>&1
if grep -q "^$name: compiles" "$C/check.txt" 2>/dev/null; then
  rm -f "$C/backup.owl"
  status done "$name" "$summary" ""
else
  err=$( [ -f "$F" ] && grep -v '^\s*$' "$C/check.txt" | sed -n 2,3p | tr '\n' ' ' || tail -c 200 "$C/agent.err")
  [ -f "$F" ] && mv "$F" "$C/failed/"
  [ -f "$C/backup.owl" ] && mv "$C/backup.owl" "$F"
  status failed "" "$summary" "${err:-the agent wrote no widget}"
  exit 1
fi
MAKE_EOF
chmod +x ~/.local/share/owlmaker/bin/owlmaker-check.new ~/.local/share/owlmaker/make.new &&
  mv ~/.local/share/owlmaker/bin/owlmaker-check.new ~/.local/share/owlmaker/bin/owlmaker-check &&
  mv ~/.local/share/owlmaker/make.new ~/.local/share/owlmaker/make &&
  echo 6 > ~/.local/share/owlmaker/VERSION
""")
      }
    } else {
      Row {
        align: center
        padding: [10, 8]
        border: 1
        borderColor: border
        radius: 8
        onTap: screen()
        Text { text: next != "" ? "up next: ${next}" : busy ? "＋ queue another widget" : "describe a widget…"; style: small; color: next != "" ? foreground : muted; maxLines: 1; weight: 1 }
      }
      Status {}
      if len(drafts) > 0 {
        Text { text: "✓ ${len(drafts)} ready: ${drafts[0].title}. Tap to see what it runs and add it"; style: small; color: green; maxLines: 2 }
      }
      Column {
        gap: 4
        weight: 1
        for m in list.take(rows >= 4 ? 3 : 1) key m.file {
          Text { text: "▸ ${m.title}"; style: small; color: muted; maxLines: 1 }
        }
      }
    }
  }

  screen {
    title: "widget maker"
    Column {
      gap: 12
      padding: 16
      scroll: true
      if ready && hasClaude {
        Row {
          align: center
          gap: 8
          Text { text: "Describe a widget. Claude Code writes and checks it in a few minutes, then it waits here until you add it."; style: small; color: muted; weight: 1; maxLines: 3 }
          AgentChip {}
        }
        if editing != "" {
          Row {
            align: center
            gap: 8
            Text { text: "changing: ${titleOf}"; style: small; color: accent; weight: 1; maxLines: 1 }
            Button { text: "✕"; color: muted; onTap: editing = "" }
          }
          Input {
            placeholder: "what to change, e.g. make the numbers bigger"
            clear: true
            onSubmit: { next = trim(value); nextEdit = editing; editing = "" }
          }
        } else {
          Input {
            placeholder: busy ? "next widget: starts when this one is done" : "e.g. days left until my exams"
            clear: true
            onSubmit: { next = trim(value); nextEdit = "" }
          }
          if !busy && next == "" && len(drafts) == 0 {
            Text { text: "or try one:"; style: small; color: muted }
            for idea in ideas key idea {
              Text { text: "→ ${idea}"; style: small; color: accent; maxLines: 2; padding: [0, 2]; onTap: { next = idea; nextEdit = "" } }
            }
          }
        }
        if next != "" && busy {
          Row {
            align: center
            gap: 8
            Text { text: "up next: ${next}"; style: small; weight: 1; maxLines: 2 }
            Button { text: "✕"; color: muted; onTap: { next = ""; nextEdit = "" } }
          }
        }
        Status {}
      } else {
        Text { text: "Finish setting up on the tile first."; style: small; color: muted }
      }
      for d in drafts key d.file {
        Column {
          gap: 6
          padding: 12
          border: 1
          borderColor: accent
          radius: 8
          Text { text: d.edit ? "change ready: ${d.title}" : "new widget ready: ${d.title}"; style: body; maxLines: 2 }
          if d.edit && d.changes != "" {
            Text { text: "what changes"; style: label; color: muted }
            Text { text: d.changes; style: small; font: mono; maxLines: 40 }
          }
          Text { text: d.runs == "" ? "It runs no commands." : "what it runs and installs (look before you add it)"; style: label; color: muted }
          if d.runs != "" {
            Text { text: d.runs; style: small; font: mono }
          }
          Row {
            gap: 8
            Button { text: d.edit ? "apply" : "add"; onTap: run("mv -f -- ~/.cache/owlmaker/pending/${sh(d.file)} ~/.config/omalauncher/widgets/") }
            Button { text: "discard"; color: muted; onTap: run("rm -f -- ~/.cache/owlmaker/pending/${sh(d.file)}") }
          }
        }
      }
      Text { text: len(list) == 0 ? "Widgets you add show up here." : "${len(list)} made here · change: describe what to change · remove asks once more"; style: small; color: muted; maxLines: 2 }
      for m in list key m.file {
        Row {
          gap: 8
          align: center
          Text { text: m.title; style: small; weight: 1; maxLines: 1 }
          Text { text: "change"; style: small; color: editing == m.file ? accent : foreground; width: 56; align: center; onTap: { editing = editing == m.file ? "" : m.file; confirmDel = "" } }
          if confirmDel == m.file {
            Text { text: "sure?"; style: small; color: red; width: 56; align: center; onTap: { gone = gone + [m.file]; confirmDel = ""; run("rm -f -- ~/.config/omalauncher/widgets/${sh(m.file)}") } }
          } else {
            Text { text: "remove"; style: small; color: muted; width: 56; align: center; onTap: { confirmDel = m.file; editing = "" } }
          }
        }
      }
    }
  }
}
