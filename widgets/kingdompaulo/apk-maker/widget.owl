mv "$D/template/app/build.gradle.kts.new" "$D/template/app/build.gradle.kts"
mkdir -p "$D/template/app/src/main"
cat > "$D/template/app/src/main/AndroidManifest.xml.new" <<'APKMAKER_FILE_EOF'
<?xml version="1.0" encoding="utf-8"?>
