      skyCondDetail: sunAlt => sunAlt == null ? "—" : sunAlt >= 0 ? "Luz de día" : sunAlt > -6 ? "Crepúsculo civil" : sunAlt > -12 ? "Crepúsculo náutico" : sunAlt > -18 ? "Crepúsculo astronómico" : "Noche astronómica"
      skyQuality: (sunAlt, moonAlt, moonLit, cloud) => sunAlt >= 0 ? "De día" : sunAlt > -18 ? "Crepúsculo" : cloud != null && cloud >= 75 ? "Cubierto (${cloud}%)" : cloud != null && cloud >= 40 ? "Nuboso (${cloud}%)" : moonAlt > 5 && moonLit >= 60 ? "Luz lunar" : cloud == null ? "Cielo oscuro · nubes desconocidas" : "Cielo oscuro · pocas nubes previstas"
      eventName: label => get({"Sunset": "Puesta de Sol (0°)", "Sunrise": "Salida del Sol (0°)", "Civil dusk": "Fin crepúsculo civil (−6°)", "Civil dawn": "Inicio alba civil (−6°)", "Nautical dusk": "Fin crepúsculo náutico (−12°)", "Nautical dawn": "Inicio alba náutica (−12°)", "Astronomical dusk": "Inicio noche astronómica (−18°)", "Astronomical dawn": "Fin noche astronómica (−18°)", "Moonrise": "Salida de la Luna", "Moonset": "Puesta de la Luna"}, label, label)
      resultsFor: q => "Resultados para \"${q}\""
      questName: id => get({"alnilam": "Cinturón de Orión", "sirius": "Sirio", "canopus": "Canopo", "betelgeuse": "Betelgeuse", "rigel": "Rigel", "aldebaran": "Aldebarán", "antares": "Antares", "vega": "Vega", "altair": "Altair", "arcturus": "Arturo", "spica": "Espiga (Spica)", "regulus": "Régulo", "jupiter": "Júpiter", "saturn": "Saturno", "moon": "Luna"}, id, id)
      questGroup: id => get({"alnilam": "Orión · ε Ori", "sirius": "Can Mayor · α CMa", "canopus": "Carina · α Car", "betelgeuse": "Orión · α Ori", "rigel": "Orión · β Ori", "aldebaran": "Tauro · α Tau", "antares": "Escorpio · α Sco", "vega": "Lira · α Lyr", "altair": "Águila · α Aql", "arcturus": "Boyero · α Boo", "spica": "Virgo · α Vir", "regulus": "Leo · α Leo", "jupiter": "Planeta", "saturn": "Planeta", "moon": "Satélite Terrestre"}, id, "")
      questHop: id => get({
