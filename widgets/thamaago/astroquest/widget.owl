        "sirius": "Localización: Estrella más brillante (−1,46 mag). Sigue el Cinturón de Orión abajo-izquierda.",
        "canopus": "Localización: 2ª estrella más brillante (−0,74 mag), ~36° al sur de Sirio.",
        "betelgeuse": "Localización: Estrella naranja-rojiza brillante sobre el Cinturón de Orión.",
        "rigel": "Localización: Estrella blanco-azulada bajo el Cinturón de Orión, opuesta a Betelgeuse.",
        "aldebaran": "Localización: Estrella naranja en un cúmulo en V; sigue el Cinturón de Orión arriba-derecha.",
        "antares": "Localización: Estrella roja intensa en el centro del anzuelo en J de Escorpio.",
        "vega": "Localización: Brillante estrella azul-blanca del Triángulo de Verano.",
        "altair": "Localización: Estrella blanca escoltada de cerca por dos estrellas más tenues.",
        "arcturus": "Localización: Gigante naranja-dorada; sigue el arco del mango de la Osa Mayor.",
        "spica": "Localización: Estrella azul-blanca al sur de Arturo siguiendo el arco de la Osa Mayor.",
        "regulus": "Localización: Estrella principal en la base del signo de interrogación invertido de Leo.",
        "jupiter": "Localización: Planeta blanco-dorado muy brillante y fijo (no titila).",
        "saturn": "Localización: Planeta amarillo-crema de brillo constante sin parpadeo.",
        "moon": "Localización: Observa cráteres a lo largo del terminador (límite entre luz y sombra)."
      }, id, "")
      questLore: id => get({
        "alnilam": "Supergigante azul (B0Ia) a ~1.340 años luz; luminosidad ~375.000 Soles.",
        "sirius": "Sistema binario (A1V + enana blanca Sirio B) a 8,6 años luz.",
        "canopus": "Supergigante F0Ia a ~310 años luz; referencia primaria de navegación espacial.",
        "betelgeuse": "Supergigante roja (M1–M2 Ia) a ~500–650 años luz; radio ~760 radios solares.",
        "rigel": "Sistema cuádruple supergigante azul a ~860 años luz; ~120.000 luminosidades solares.",
        "aldebaran": "Gigante naranja K5III a 65 años luz, en primer plano frente a las Híades.",
        "antares": "Supergigante roja M1.5Iab a ~550 años luz; radio ~680 radios solares.",
        "vega": "Estrella A0V de rápida rotación a 25 años luz; punto cero de la escala de magnitudes.",
        "altair": "Estrella A7V a 16,7 años luz que rota en 8,9 horas (~286 km/s en el ecuador).",
        "arcturus": "Gigante naranja K1.5III a 36,7 años luz moviéndose a 122 km/s respecto al Sol.",
        "spica": "Binaria espectroscópica cercana (B1III + B2V) a 250 años luz con periodo de 4,01 días.",
        "regulus": "Sistema estelar cuádruple a 79 años luz; la componente principal rota en 15,9 horas.",
        "jupiter": "Gigante gaseoso; prismáticos 7x–10x resuelven sus 4 lunas galileanas.",
        "saturn": "Gigante anillado; los anillos abarcan 282.000 km con solo ~10 m de espesor.",
        "moon": "Distancia media 384.400 km (1,28 segundos luz); periodo sinódico 29,53 días."
      }, id, "")
    }
  }

  // Persistent states
  state streak_days = 0 persist
  state last_found_date = "" persist
  state found_quests = [] persist
  state quest_idx = 0 persist
  state theme_mode = "cosmic" persist
  state bonus_xp = 0 persist
  state quiz_idx = 0 persist
  state quiz_streak = 0 persist
  state follow_best = true persist
  state observations = [] persist
  state quiz_solved = [] persist
  state weather_enabled = false persist
  state observing_site = null persist

  // 15 Naked-Eye Catalogue Objects
  let quests = [
    { id: "alnilam",    mag: "1.69",  color: #93C5FD },
    { id: "sirius",     mag: "-1.46", color: #E0F2FE },
    { id: "canopus",    mag: "-0.74", color: #FEF08A },
    { id: "betelgeuse", mag: "0.50",  color: #FCA5A5 },
    { id: "rigel",      mag: "0.13",  color: #BFDBFE },
    { id: "aldebaran",  mag: "0.86",  color: #FDBA74 },
    { id: "antares",    mag: "1.06",  color: #F87171 },
    { id: "vega",       mag: "0.03",  color: #BAE6FD },
    { id: "altair",     mag: "0.76",  color: #E2E8F0 },
    { id: "arcturus",   mag: "-0.05", color: #FCD34D },
    { id: "spica",      mag: "0.97",  color: #93C5FD },
    { id: "regulus",    mag: "1.36",  color: #DBEAFE },
    { id: "jupiter",    mag: "-2.4",  color: #FDE68A },
    { id: "saturn",     mag: "0.6",   color: #FDE047 },
    { id: "moon",       mag: "-12.6", color: #F8FAFC }
  ]

  // Asterism guide lines connecting catalogue indices (Orion, Orion->Sirius/Aldebaran, Summer pair, Spring arc)
  let guide_pairs = [[3, 0], [0, 4], [0, 1], [0, 5], [7, 8], [9, 10]]

  // Local UI states
  state screen_tab = "radar"
  state plan_idx = -1
  state plan_cursor = -1
  state plan_new_only = false
  state plan_show_all = false
  state plan_picker = false
  state observation_note = ""
  state show_details = false
  state show_settings = false
  state journal_page = 0
  state journal_notice = ""
  state export_location = false
  state edit_entry_id = ""
  state edit_note = ""
  state remove_entry_id = ""
  state time_offset_hrs = 0
  state celebrate_msg = ""
  state editing_location = false
  state waiting_gps = false
  state city_draft = ""
  state city_query = ""
  state latitude_draft = ""
  state longitude_draft = ""
  state location_error = ""

  onTap: {
    haptic()
    screen()
  }

  source now = clock every 10s
  source here = android.location
  source modes = android.modes

  on here {
    if waiting_gps && location_open && value.granted && value.available && value.lat != null && value.lon != null {
      observing_site = {lat: round(num(value.lat), 4), lon: round(num(value.lon), 4), name: str.phoneLocName, method: "gps", confirmed_at: now}
      waiting_gps = false
      editing_location = false
      location_error = ""
      haptic()
    }
  }

  let stored_idx = clamp(int(quest_idx), 0, len(quests) - 1)

  // Theme palette (Cosmic Mode vs Strict Red Night-Vision Mode)
  let is_cosmic = theme_mode == "cosmic"
  let c_bg = is_cosmic ? #080D20 : #000000
  let c_card = is_cosmic ? #111B32 : #000000
  let c_pri = is_cosmic ? #79D9ED : #FF3333
  let c_sec = is_cosmic ? #E9C58B : #FF3333
  let c_ok = is_cosmic ? #34D399 : #FF3333
  let c_text = is_cosmic ? #E2E8F0 : #FF3333
  let c_muted = is_cosmic ? #94A3B8 : alpha(#FF3333, 0.72)
  let c_border = is_cosmic ? #293C59 : #FF3333
  let c_accent_border = is_cosmic ? #79D9ED : #FF3333

  // Location setup
  let site_lat = num(observing_site.lat)
  let site_lon = num(observing_site.lon)
  let location_ready = site_lat != null && site_lon != null && site_lat >= -90 && site_lat <= 90 && site_lon >= -180 && site_lon <= 180
  let site_label = !location_ready ? str.chooseSite : (observing_site.method == "coordinates" || observing_site.method == "gps" ? (observing_site.method == "gps" ? str.phoneLocName : str.selectedCoords) + " (" + str(round(site_lat, 2)) + "°, " + str(round(site_lon, 2)) + "°)" : (observing_site.name ?? str.selectedCoords))
  let location_open = !location_ready || editing_location
  let draft_lat = num(trim(latitude_draft))
  let draft_lon = num(trim(longitude_draft))
  let coordinates_valid = len(trim(latitude_draft)) > 0 && len(trim(longitude_draft)) > 0 && draft_lat != null && draft_lon != null && draft_lat >= -90 && draft_lat <= 90 && draft_lon >= -180 && draft_lon <= 180
  source places = http(location_open && len(trim(city_query)) >= 2 && len(trim(city_query)) <= 80 ? "https://geocoding-api.open-meteo.com/v1/search?name=${enc(city_query)}&count=5&language=${enc(lang())}&format=json" : null) every 1h json status timeout 10s

  // Local offline ephemeris calculation using Python + Astropy
  let site_lat_arg = location_ready ? str(site_lat) : ""
  let site_lon_arg = location_ready ? str(site_lon) : ""
  let minute_epoch = floor(now / 60) * 60
  let sky_epoch = minute_epoch
  source astro_result = cmd("if [ ${sh(location_ready && sky_epoch != null)} != true ]; then printf '{}'; exit 0; fi; python -I -c 'import json, math, sys\nimport numpy as np\n\nSTEP, SAMPLES = 900, 97\nSTARS = [(84.05338935, -1.20191983, 1.69), (101.28715455, -16.71611569, -1.46),\n         (95.9879577, -52.69566045, -0.74), (88.7929386, 7.40706274, 0.50),\n         (78.63446805, -8.20164055, 0.13), (68.980161, 16.50930138, 0.86),\n         (247.35192045, -26.4320025, 1.06), (279.23473545, 38.78369185, 0.03),\n         (297.6958296, 8.86832203, 0.76), (213.91530015, 19.18241038, -0.05),\n         (201.29824695, -11.16132203, 0.97), (152.0929611, 11.96720709, 1.36)]\n\ndef intervals(mask):\n    result, start = [], None\n    for k in range(len(mask) - 1):\n        good = mask[k] and mask[k + 1]\n        if good and start is None:\n            start = k\n        if start is not None and (not good or k == len(mask) - 2):\n            result.append((start, k if not good else k + 1))\n            start = None\n    return result\n\ndef crossings(values, threshold, timestamp, down_label, up_label):\n    thresholds = [threshold] * len(values) if isinstance(threshold, (float, int)) else threshold\n    result, previous_side = [], None\n    for k in range(len(values) - 1):\n        a, b = values[k] - thresholds[k], values[k + 1] - thresholds[k + 1]\n        if a != 0:\n            previous_side = a\n        if a * b < 0 or (a == 0 and b != 0 and (previous_side is None or previous_side * b < 0)):\n            result.append({\"label\": down_label if b < 0 else up_label, \"time\": int(round(timestamp + (k + a / (a - b)) * STEP))})\n    return result\n\ndef dark_intervals(sun_alts, timestamp):\n    result = []\n    start = timestamp if sun_alts[0] <= -18 else None\n    for event in crossings(sun_alts, -18, timestamp, \"dark\", \"light\"):\n        if event[\"label\"] == \"dark\":\n            start = event[\"time\"]\n        elif start is not None:\n            if event[\"time\"] > start:\n                result.append({\"start\": start, \"end\": event[\"time\"]})\n            start = None\n    if start is not None:\n        result.append({\"start\": start, \"end\": timestamp + (len(sun_alts) - 1) * STEP})\n    return result\n\ndef light_bands(sun_alts):\n    bands = []\n    for j in range(len(sun_alts) - 1):\n        k = 2 if sun_alts[j] >= 0 else 1 if sun_alts[j] > -18 else 0\n        if bands and bands[-1][\"k\"] == k:\n            bands[-1][\"e\"] = j + 1\n        else:\n            bands.append({\"s\": j, \"e\": j + 1, \"k\": k})\n    return bands\n\ndef summarize(hours, sun_alts, timestamp):\n    ranked, stats = [], []\n    for i in range(len(hours[0])):\n        alts = [row[i][\"alt\"] for row in hours]\n        cx = crossings(alts, 0.0, timestamp, \"set\", \"rise\")\n        nxt_rise = next((e[\"time\"] for e in cx if e[\"label\"] == \"rise\"), None)\n        nxt_set = next((e[\"time\"] for e in cx if e[\"label\"] == \"set\"), None)\n        pk_step = int(max(range(len(hours)), key=lambda k: alts[k]))\n        stats.append({\"rise\": nxt_rise, \"set\": nxt_set, \"peak_step\": pk_step, \"peak_time\": timestamp + pk_step * STEP, \"peak_alt\": alts[pk_step]})\n        eligible = [sun_alts[k] <= -6 and row[i][\"alt\"] >= 20 and row[i][\"sun_sep\"] >= 30 and row[i][\"mag\"] <= 2 for k, row in enumerate(hours)]\n        windows = []\n        for start, end in intervals(eligible):\n            peak = max(range(start, end + 1), key=lambda k: hours[k][i][\"alt\"])\n            score = hours[peak][i][\"alt\"] / 15 - hours[peak][i][\"mag\"] + (end - start) / 20\n            windows.append({\"start\": timestamp + start * STEP, \"end\": timestamp + end * STEP, \"start_step\": start, \"end_step\": end, \"best_step\": peak, \"peak_alt\": hours[peak][i][\"alt\"], \"score\": round(score, 3)})\n        if windows:\n            best = max(windows, key=lambda w: w[\"score\"])\n            ranked.append({\"idx\": i, \"windows\": windows, \"best_step\": best[\"best_step\"], \"start\": best[\"start\"], \"end\": best[\"end\"], \"peak_alt\": best[\"peak_alt\"], \"score\": best[\"score\"]})\n    ranked.sort(key=lambda item: (-item[\"score\"], item[\"idx\"]))\n    return ranked, dark_intervals(sun_alts, timestamp), stats\n\ndef calculate(latitude, longitude, timestamp):\n    if not (math.isfinite(latitude) and math.isfinite(longitude) and -90 <= latitude <= 90 and -180 <= longitude <= 180):\n        raise ValueError(\"Coordinates out of range\")\n    if not 946684800 <= timestamp <= 4102444800:\n        raise ValueError(\"Unsupported timestamp\")\n    from astropy import units as u\n    from astropy.coordinates import AltAz, EarthLocation, SkyCoord, get_body, get_body_barycentric, solar_system_ephemeris\n    from astropy.time import Time\n    from astropy.utils import iers\n    iers.conf.auto_download = False\n    iers.conf.iers_degraded_accuracy = \"warn\"\n    iers.conf.auto_max_age = None\n    solar_system_ephemeris.set(\"builtin\")\n    site = EarthLocation.from_geodetic(longitude * u.deg, latitude * u.deg)\n    times = Time(timestamp, format=\"unix\") + np.arange(SAMPLES) * (15 * u.minute)\n    frame = AltAz(obstime=times, location=site, pressure=0 * u.hPa)\n    sun = get_body(\"sun\", times, site).transform_to(frame)\n    catalogue = SkyCoord(ra=[s[0] for s in STARS] * u.deg, dec=[s[1] for s in STARS] * u.deg, frame=\"icrs\")\n    star_grid = catalogue[None, :].transform_to(AltAz(obstime=times[:, None], location=site, pressure=0 * u.hPa))\n    az_cols, alt_cols, sep_cols = [star_grid.az.deg], [star_grid.alt.deg], [star_grid.separation(sun[:, None]).deg]\n    mag_cols = [np.broadcast_to([s[2] for s in STARS], (SAMPLES, len(STARS)))]\n    moon_bary = get_body_barycentric(\"moon\", times)\n    moon_to_sun = get_body_barycentric(\"sun\", times) - moon_bary\n    moon_to_earth = get_body_barycentric(\"earth\", times) - moon_bary\n    phase_cosines = np.clip((moon_to_sun.dot(moon_to_earth) / (moon_to_sun.norm() * moon_to_earth.norm())).value, -1.0, 1.0)\n    earth_sun = sun.distance.to_value(u.au)\n    for name, ref_mag in ((\"jupiter\", -9.40), (\"saturn\", -8.88), (\"moon\", -12.717)):\n        body = get_body(name, times, site).transform_to(frame)\n        sep = body.separation(sun)\n        delta = body.distance.to_value(u.au)\n        radius = np.sqrt(np.maximum(1e-20, delta**2 + earth_sun**2 - 2 * delta * earth_sun * np.cos(sep.rad)))\n        phase = np.arccos(np.clip((radius**2 + delta**2 - earth_sun**2) / (2 * radius * delta), -1.0, 1.0))\n        if name == \"moon\":\n            dist_km = delta * 149597870.7\n            mags = ref_mag + 1.49 * phase + 0.0431 * phase**4 + 5 * np.log10(dist_km / 384400)\n            moon_alt_raw = body.alt.deg\n            moon_info = [{\"illumination\": round(float(50 * (1 + phase_cosines[h])), 2), \"alt\": round(float(moon_alt_raw[h]), 2)} for h in range(SAMPLES)]\n            moon_thresholds = (-34 / 60 - np.degrees(np.arcsin(1737.4 / dist_km))).tolist()\n        else:\n            mags = ref_mag + 5 * np.log10(radius * delta) + (0.005 if name == \"jupiter\" else 0.044) * np.degrees(phase)\n        az_cols.append(body.az.deg[:, None])\n        alt_cols.append(body.alt.deg[:, None])\n        sep_cols.append(sep.deg[:, None])\n        mag_cols.append(mags[:, None])\n    all_az = np.round(np.hstack(az_cols), 2) % 360\n    all_alt = np.round(np.hstack(alt_cols), 2)\n    all_sep = np.round(np.hstack(sep_cols), 2)\n    all_mag = np.round(np.hstack(mag_cols), 2)\n    if not (np.all(np.isfinite(all_az)) and np.all(np.isfinite(all_alt)) and np.all(np.isfinite(all_sep)) and np.all(np.isfinite(all_mag)) and np.all((0 <= all_az) & (all_az < 360)) and np.all((-90 <= all_alt) & (all_alt <= 90)) and np.all((0 <= all_sep) & (all_sep <= 180))):\n        raise ValueError(\"Invalid sky calculation\")\n    az_l, alt_l, mag_l, sep_l = all_az.tolist(), all_alt.tolist(), all_mag.tolist(), all_sep.tolist()\n    hours = [[{\"az\": az_l[h][i], \"alt\": alt_l[h][i], \"mag\": mag_l[h][i], \"sun_sep\": sep_l[h][i]} for i in range(15)] for h in range(SAMPLES)]\n    sun_raw = sun.alt.deg.tolist()\n    sun_alts = np.round(sun.alt.deg, 3).tolist()\n    ranked, dark, stats = summarize(hours, sun_alts, timestamp)\n    events = []\n    for level, evening, morning in ((-50 / 60, \"Sunset\", \"Sunrise\"), (-6, \"Civil dusk\", \"Civil dawn\"), (-12, \"Nautical dusk\", \"Nautical dawn\"), (-18, \"Astronomical dusk\", \"Astronomical dawn\")):\n        events.extend(crossings(sun_raw, level, timestamp, evening, morning))\n    events.extend(crossings(moon_alt_raw.tolist(), moon_thresholds, timestamp, \"Moonset\", \"Moonrise\"))\n    events.sort(key=lambda e: e[\"time\"])\n    return {\"ok\": True, \"schema\": 2, \"generated_at\": timestamp, \"latitude\": latitude, \"longitude\": longitude, \"step_seconds\": STEP, \"hours\": hours, \"sun_alts\": sun_alts, \"bands\": light_bands(sun_alts), \"moon\": moon_info, \"stats\": stats, \"planner\": {\"ranked\": ranked, \"dark\": dark, \"events\": events}}\n\nif __name__ == \"__main__\":\n    try:\n        result = calculate(float(sys.argv[1]), float(sys.argv[2]), int(sys.argv[3]))\n    except ImportError:\n        result = {\"ok\": False, \"error\": \"Astronomy unavailable: Python astropy is missing\"}\n    except (ValueError, TypeError, IndexError, OverflowError):\n        result = {\"ok\": False, \"error\": \"Check observing coordinates and phone time, then refresh\"}\n    except Exception:\n        result = {\"ok\": False, \"error\": \"Sky calculation failed; refresh or check astronomy installation\"}\n    print(json.dumps(result, allow_nan=False, separators=(\",\", \":\")))\n' ${sh(site_lat_arg)} ${sh(site_lon_arg)} ${sh(sky_epoch)}") every 1m json status timeout 30s
  let astro_weather = astro_result.ok ? astro_result.out : null

  // Optional live cloud cover from Open-Meteo
  source weather = http(location_ready && weather_enabled ? "https://api.open-meteo.com/v1/forecast?latitude=${enc(round(site_lat, 2))}&longitude=${enc(round(site_lon, 2))}&current=cloud_cover&hourly=cloud_cover&forecast_days=2&timezone=auto&timeformat=unixtime" : null) every 15m json status timeout 10s
  let weather_matches = location_ready && weather_enabled && weather.ok && weather.out.latitude != null && weather.out.longitude != null && abs(num(weather.out.latitude) - site_lat) < 0.3 && abs((num(weather.out.longitude) - site_lon + 540) % 360 - 180) < 0.3
  let weather_time = num(weather.out.current.time)
  let cloud_cover = weather_matches && weather_time != null && abs(minute_epoch - weather_time) < 3600 && weather.out.current.cloud_cover != null ? clamp(num(weather.out.current.cloud_cover), 0, 100) : null
  let site_zone = observing_site.timezone ?? (weather_matches ? weather.out.timezone : null) ?? null

  let safe_step = clamp(int(round(time_offset_hrs * 4)), 0, 96)
  let safe_hr = safe_step / 4
  let sky_data_ok = location_ready && astro_weather.latitude == site_lat && astro_weather.longitude == site_lon && astro_weather.ok == true && astro_weather.schema == 2 && astro_weather.step_seconds == 900 && astro_weather.generated_at != null && len(astro_weather.hours) == 97 && len(astro_weather.sun_alts) == 97 && len(astro_weather.moon) == 97 && len(astro_weather.hours[0]) == len(quests)
  let sky_ready = sky_data_ok && abs(minute_epoch - astro_weather.generated_at) <= 1800 && len(astro_weather.hours[safe_step]) == len(quests)
  let sky_error = astro_result == null ? str.loadingSky : !astro_result.ok ? str.skyUnavailable : astro_weather.error ?? (sky_ready ? str.loadingSky : str.skyUnavailable)
  let active_targets = sky_ready ? (astro_weather.hours[safe_step] ?? []) : []
  let next_step_targets = sky_ready ? (astro_weather.hours[min(96, safe_step + 1)] ?? []) : []
  let sun_alt = sky_ready ? num(astro_weather.sun_alts[safe_step]) : null
  let is_daylight = sun_alt != null && sun_alt >= 0
  let is_twilight = sun_alt != null && sun_alt < 0 && sun_alt > -18
  let live_targets = sky_ready ? astro_weather.hours[0] : []
  let live_next_targets = sky_ready ? astro_weather.hours[1] : []
  let live_sun_alt = sky_ready ? num(astro_weather.sun_alts[0]) : null

  // Best target now: high (>=20°), safe from Sun (>=30°), bright (<=2 mag)
  let best_candidates = range(len(quests)).filter(i => num(live_targets[i].alt ?? -90) >= 20 && num(live_targets[i].sun_sep ?? 0) >= 30 && num(live_targets[i].mag ?? 99) <= 2).sortBy(i => num(live_targets[i].mag) - min(70, num(live_targets[i].alt)) / 15)
  let best_idx = live_sun_alt != null && live_sun_alt < 0 ? first(best_candidates) : null
  let safe_idx = follow_best && safe_hr == 0 && best_idx != null ? best_idx : stored_idx
  let current_quest = quests[safe_idx]
  let current_name = str.questName(current_quest.id)
  let current_group = str.questGroup(current_quest.id)
  let live_q_pos = active_targets[safe_idx]
  let next_q_pos = next_step_targets[safe_idx]
  let eff_az = num(live_q_pos.az)
  let eff_alt = num(live_q_pos.alt)
  let is_rising = num(next_q_pos.alt ?? eff_alt) >= eff_alt
  let q_stat = sky_ready && astro_weather.stats != null ? astro_weather.stats[safe_idx] : null
  let q_rise_str = q_stat != null && q_stat.rise != null ? fmtTime(q_stat.rise, "HH:mm", site_zone) : ""
  let q_set_str = q_stat != null && q_stat.set != null ? fmtTime(q_stat.set, "HH:mm", site_zone) : ""
  let q_peak_str = q_stat != null && q_stat.peak_time != null ? fmtTime(q_stat.peak_time, "HH:mm", site_zone) : "—"
  let q_peak_alt = q_stat != null && q_stat.peak_alt != null ? round(num(q_stat.peak_alt)) : 0
  let visible_count = count(active_targets, t => num(t.alt ?? -90) >= 0)

  let best_name = best_idx != null ? str.questName(quests[best_idx].id) : ""
  let best_message = str.bestToast(sky_ready, live_sun_alt, best_idx, best_name, cloud_cover)
  let conditions_label = !sky_ready || sun_alt == null ? str.skyUnavailable : str.conditionsSummary(safe_hr > 0, sun_alt, weather_enabled, cloud_cover)
  let friendly_direction = str.directionName(int(floor((eff_az + 11.25) / 22.5)) % 16)

  on observing_site { time_offset_hrs = 0; plan_cursor = -1; plan_idx = -1; celebrate_msg = "" }
  on screen_tab { plan_picker = false; remove_entry_id = ""; edit_entry_id = "" }

  let clamped_found = count(quests, q => contains(found_quests, q.id))
  let target_tint = is_cosmic ? current_quest.color : c_pri
  let target_done = contains(found_quests, current_quest.id)

  let next_window = sky_ready ? first((astro_weather.planner.ranked ?? []).sortBy(t => first(t.windows).start)) : null
  let next_window_label = next_window == null ? str.noRankedAny : str.nextWindowAt(fmtTime(first(next_window.windows).start, "HH:mm", site_zone), str.questName(quests[next_window.idx].id), round(num(next_window.peak_alt)))
  let tile_pos = sky_ready ? live_targets[safe_idx] : null
  let tile_next_pos = sky_ready ? live_next_targets[safe_idx] : null
  let tile_rising = num(tile_next_pos.alt ?? 0) >= num(tile_pos.alt ?? 0)
  let tile_direction = str.compass(int(floor((num(tile_pos.az) + 11.25) / 22.5)) % 16)
  let tile_conditions = !sky_ready ? str.skyUnavailable : live_sun_alt >= 0 ? str.daylight : live_sun_alt > -18 ? str.twilight : str.darkSky
  let tile_clouds = !weather_enabled ? str.cloudsOff : cloud_cover == null ? str.cloudsNA : str.cloudPct(round(cloud_cover))
  let tile_tall = (tileHeight ?? 200) >= 140
  let tile_wide = (tileWidth ?? 360) >= 240
  let live_chart_dots = range(len(quests)).filter(i => sky_ready && num(live_targets[i].alt ?? -90) >= 0).map(i => {idx: i, px: 28 - 22 * (90 - num(live_targets[i].alt)) / 90 * sin(rad(num(live_targets[i].az))), py: 28 - 22 * (90 - num(live_targets[i].alt)) / 90 * cos(rad(num(live_targets[i].az)))})

  // HOME TILE
  if location_open {
    Column {
      fill: true; justify: spaceBetween; gap: 4
      Text { text: "✦ ASTROQUEST"; font: sans; fontSize: 12; bold: true; color: c_pri }
      Text { text: str.whereObserving; font: sans; fontSize: 18; bold: true; color: c_text }
      Text { text: str.setLocationBtn; font: sans; fontSize: 12; bold: true; color: c_bg; background: c_pri; align: center; padding: 6; radius: 8 * corners; onTap: screen() }
    }
  } else {
    Column {
      fill: true; justify: spaceBetween; gap: 3
      Row {
        fill: width; align: center; gap: 8
        Text { text: "✦ ASTROQUEST"; font: sans; fontSize: !tile_wide ? 10 : 11; bold: true; letterSpacing: 0.6; color: c_pri; weight: 1 }
        if tile_wide {
          Text { text: tile_conditions + (sky_ready ? " · ☾ " + str(round(num(astro_weather.moon[0].illumination))) + "%" : "") + " · " + tile_clouds; font: sans; fontSize: 10; color: c_muted; maxLines: 1 }
        }
        Text { text: str.foundBadge(clamped_found); font: sans; fontSize: 10; bold: true; color: c_sec; onTap: { screen_tab = "journal"; screen() } }
      }
      Row {
        fill: width; align: center; gap: 8
        Column {
          weight: 1; gap: 2
          Text {
            text: !sky_ready ? sky_error : follow_best && best_idx == null ? (live_sun_alt >= 0 ? str.lookLater : str.noneUp) : current_name + " · mag " + str(tile_pos.mag ?? current_quest.mag)
            font: sans; fontSize: !tile_wide ? 17 : 20; bold: true; color: target_tint; maxLines: 1
          }
          Text {
            text: !sky_ready ? str.checkLocationHint : follow_best && best_idx == null ? next_window_label : num(tile_pos.alt) >= 0 ? str.upSummary(round(num(tile_pos.az)), tile_direction, round(num(tile_pos.alt)), tile_rising ? "↑" : "↓") + (q_set_str != "" ? " · ↓" + q_set_str : "") : str.belowHorizonShort + " · " + str.scheduleLine(q_rise_str, q_peak_str, q_peak_alt, "")
            font: sans; fontSize: 11; color: c_text; maxLines: 1
          }
        }
        if tile_wide && sky_ready {
          // Live mini overhead sky radar on home screen tile
          Canvas {
            width: 56; height: 56
            circle(28, 28, 24, fill: c_card, stroke: c_border, width: 1)
            circle(28, 28, 12, stroke: alpha(c_border, 0.5), width: 1)
            line(4, 28, 52, 28, stroke: alpha(c_border, 0.4))
            line(28, 4, 28, 52, stroke: alpha(c_border, 0.4))
            for d in live_chart_dots {
              let sel = d.idx == safe_idx
              if sel { circle(d.px, d.py, 5, stroke: c_pri, width: 1.2) }
              circle(d.px, d.py, sel ? 2.8 : 2.0, fill: is_cosmic ? quests[d.idx].color : c_pri)
            }
          }
        }
      }
      if tile_tall && !tile_wide {
        Text { text: tile_conditions + " · " + tile_clouds; font: sans; fontSize: 10; color: c_muted; maxLines: 1 }
      }
      Row {
        fill: width; gap: 6
        Text { text: str.tileObserve; font: sans; fontSize: 11; bold: true; color: c_bg; background: c_pri; padding: [6, 6]; radius: 8 * corners; align: center; weight: 1; onTap: { time_offset_hrs = 0; screen_tab = "radar"; screen() } }
        Text { text: str.tileTonight; font: sans; fontSize: 11; bold: true; color: c_pri; background: c_card; padding: [6, 6]; radius: 8 * corners; align: center; weight: 1; onTap: { screen_tab = "tonight"; screen() } }
        Text { text: str.tileAlmanac; font: sans; fontSize: 11; bold: true; color: c_sec; background: c_card; padding: [6, 6]; radius: 8 * corners; align: center; weight: 1; onTap: { screen_tab = "almanac"; screen() } }
      }
    }
  }

  screen {
    title: "AstroQuest"
    Column {
      scroll: true; onPull: refresh(); fill: width; padding: 12; gap: 8; background: c_bg
      Row {
        fill: width; gap: 6; align: center
        Column {
          weight: 1; gap: 1
          Text { text: str.subtitle; font: sans; fontSize: 10; letterSpacing: 0.8; bold: true; color: c_pri; maxLines: 1 }
          Text { text: site_label; font: sans; fontSize: 11; color: c_muted; maxLines: 1; onTap: { if location_ready { latitude_draft = str(site_lat); longitude_draft = str(site_lon); location_error = ""; city_query = ""; editing_location = !editing_location } } }
        }
        if modes.torch != null {
          Text { text: modes.torch ? str.torchOn : str.torchOff; font: sans; fontSize: 11; bold: modes.torch; color: modes.torch ? c_bg : c_sec; background: modes.torch ? c_sec : c_card; padding: [7, 6]; radius: 8 * corners; onTap: { haptic(); torch(modes.torch ? false : 20) } }
        }
        Text { text: is_cosmic ? str.redBtn : str.cosmicBtn; font: sans; fontSize: 11; color: c_pri; padding: [7, 6]; background: c_card; radius: 8 * corners; onTap: theme_mode = is_cosmic ? "red" : "cosmic" }
        Text { text: "⚙"; font: sans; fontSize: 18; color: c_sec; padding: [6, 4]; onTap: show_settings = !show_settings }
      }

      if location_open {
        Column {
          fill: width; gap: 9; padding: 12; background: c_card; border: 1; borderColor: c_accent_border; radius: 14 * corners
          Text { text: str.chooseSite; font: sans; fontSize: 18; bold: true; color: c_pri }
          Text { text: str.siteIntro; fontSize: 12; color: c_text }
          if here != null {
            Text {
              text: here.granted && here.available && here.lat != null ? str.applyPhoneLoc(round(num(here.lat), 2), round(num(here.lon), 2)) : str.usePhoneLoc
              font: sans; fontSize: 12; bold: true; align: center; padding: [10, 9]
              color: c_bg; background: c_ok; radius: 8 * corners
              onTap: {
                haptic()
                if here.granted && here.available && here.lat != null && here.lon != null {
                  observing_site = {lat: round(num(here.lat), 4), lon: round(num(here.lon), 4), name: str.phoneLocName, method: "gps", confirmed_at: now}
                  editing_location = false
                  location_error = ""
                } else {
                  waiting_gps = true
                  location("request")
                }
              }
            }
          }
          Input { text: city_draft; placeholder: str.cityPlaceholder; color: c_text; fontSize: 13; onChange: city_draft = value; onSubmit: { if len(trim(value)) >= 2 && len(trim(value)) <= 80 { city_query = trim(value); location_error = "" } else { location_error = str.cityErr } } }
          Text { text: str.searchCities; color: c_bg; background: c_pri; padding: [10, 8]; align: center; bold: true; radius: 8 * corners; onTap: { if len(trim(city_draft)) >= 2 && len(trim(city_draft)) <= 80 { city_query = trim(city_draft); location_error = ""; refresh() } else { location_error = str.cityErr } } }
          if len(city_query) >= 2 {
            Text { text: str.resultsFor(city_query); fontSize: 11; color: c_sec }
            if places == null { Text { text: str.searching; color: c_muted } }
            else if !places.ok { Text { text: str.searchOffline; color: c_sec } }
            else if len(places.out.results ?? []) == 0 { Text { text: str.noCityMatch; color: c_sec } }
            for place in (places.ok ? places.out.results ?? [] : []).take(5) key place.id {
              Column {
                fill: width; padding: [10, 8]; gap: 3; background: c_bg; border: 1; borderColor: c_border; radius: 10 * corners
                Text { text: place.name + ", " + (place.admin1 ?? place.country ?? ""); fontSize: 13; bold: true; color: c_text }
                Text { text: (place.country ?? "") + " · " + str(round(num(place.latitude), 3)) + ", " + str(round(num(place.longitude), 3)); fontSize: 10; color: c_muted }
                onTap: {
                  let chosen_lat = num(place.latitude)
                  let chosen_lon = num(place.longitude)
                  if chosen_lat != null && chosen_lon != null && chosen_lat >= -90 && chosen_lat <= 90 && chosen_lon >= -180 && chosen_lon <= 180 {
                    waiting_gps = false
                    observing_site = {lat: chosen_lat, lon: chosen_lon, name: place.name + ", " + (place.country ?? ""), timezone: place.timezone, method: "city center", confirmed_at: now}
                    city_query = ""
                    city_draft = ""
                    editing_location = false
                    screen_tab = "radar"
                    location_error = ""
                    haptic()
                  }
                }
              }
            }
          }
          Text { text: str.orCoords; fontSize: 13; bold: true; color: c_sec }
          Text { text: str.coordsHint; fontSize: 11; color: c_muted }
          Row {
            fill: width; gap: 8
            Input { text: latitude_draft; placeholder: str.latPlaceholder; color: c_text; weight: 1; onChange: latitude_draft = value }
            Input { text: longitude_draft; placeholder: str.lonPlaceholder; color: c_text; weight: 1; onChange: longitude_draft = value }
          }
          Text {
            text: str.useCoords
            color: coordinates_valid ? c_bg : c_muted
            background: coordinates_valid ? c_pri : c_bg
            padding: [10, 8]; align: center; bold: true; radius: 8 * corners
            onTap: {
              if coordinates_valid {
                let selected_lat = draft_lat
                let selected_lon = draft_lon
                waiting_gps = false
                observing_site = {lat: selected_lat, lon: selected_lon, name: "Selected coordinates", method: "coordinates", confirmed_at: now}
                city_query = ""
                city_draft = ""
                editing_location = false
                screen_tab = "radar"
                location_error = ""
                haptic()
              } else { location_error = str.coordsErr }
            }
          }
          if location_error != "" { Text { text: location_error; fontSize: 11; color: c_sec } }
          Text { text: str.privacyNote; fontSize: 10; color: c_muted }
          if location_ready {
            Row {
              fill: width; gap: 8
              Text { text: str.keepLocation; align: center; padding: 8; color: c_pri; weight: 1; onTap: { waiting_gps = false; editing_location = false } }
              Text { text: str.forgetLocation; align: center; padding: 8; color: #FF3333; weight: 1; onTap: { waiting_gps = false; observing_site = null; weather_enabled = false; latitude_draft = ""; longitude_draft = ""; city_draft = ""; city_query = ""; location_error = ""; editing_location = false } }
            }
          }
        }
      } else if show_settings {
        Column {
          fill: width; padding: 12; gap: 8; background: c_card; border: 1; borderColor: c_border; radius: 12 * corners
          Text { text: str.settingsTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
          Row {
            fill: width; align: center; gap: 8; padding: [8, 6]; background: c_bg; radius: 8 * corners
            Column {
              weight: 1; gap: 2
              Text { text: "◎ " + site_label; fontSize: 12; bold: true; color: c_text }
              Text { text: str(round(site_lat, 4)) + "°, " + str(round(site_lon, 4)) + "° · " + (site_zone ?? ""); fontSize: 10; color: c_muted }
            }
            Text { text: str.changeSite; fontSize: 11; bold: true; color: c_pri; padding: [6, 4] }
            onTap: { latitude_draft = str(site_lat); longitude_draft = str(site_lon); location_error = ""; city_query = ""; editing_location = true }
          }
          Text { text: weather_enabled ? str.cloudWeatherOn : str.cloudWeatherOff; font: sans; fontSize: 12; bold: true; color: weather_enabled ? c_ok : c_text; padding: [8, 6]; background: c_bg; radius: 8 * corners; onTap: { weather_enabled = !weather_enabled; refresh() } }
          Text { text: str.privacyNote; font: sans; fontSize: 10; color: c_muted }
          Row {
            fill: width; gap: 8
            Text { text: str.refreshBtn; font: sans; fontSize: 12; color: c_pri; padding: 8; background: c_bg; radius: 8 * corners; align: center; weight: 1; onTap: refresh() }
            Text { text: str.closeSettings; font: sans; fontSize: 12; bold: true; color: c_bg; background: c_pri; padding: 8; radius: 8 * corners; align: center; weight: 1; onTap: show_settings = false }
          }
        }
      }

      if !location_open {
        Row {
          fill: width; gap: 6
          for tab in [{id: "radar", label: str.tabObserve}, {id: "tonight", label: str.tabTonight}, {id: "almanac", label: str.tabAlmanac}, {id: "journal", label: str.tabJournal}] {
            Text { text: tab.label; font: sans; fontSize: 11; bold: true; align: center; weight: 1; padding: [6, 8]; color: screen_tab == tab.id ? c_bg : c_text; background: screen_tab == tab.id ? c_pri : c_card; radius: 10 * corners; onTap: { screen_tab = tab.id; celebrate_msg = "" } }
          }
        }
        if celebrate_msg != "" {
          Text { text: celebrate_msg + "  ×"; font: sans; fontSize: 12; color: c_ok; background: alpha(c_ok, 0.12); padding: 8; radius: 8 * corners; onTap: celebrate_msg = "" }
        }

        if screen_tab == "radar" {
          let chart_side = max(152, min(180, (screenWidth ?? 360) - 104))
          let chart_radius = chart_side / 2 - 18
          let chart_coords = range(len(quests)).map(i => {
            idx: i,
            up: sky_ready && num(active_targets[i].alt ?? -90) >= 0,
            px: chart_side / 2 - chart_radius * (90 - num(active_targets[i].alt ?? -90)) / 90 * sin(rad(num(active_targets[i].az ?? 0))),
            py: chart_side / 2 - chart_radius * (90 - num(active_targets[i].alt ?? -90)) / 90 * cos(rad(num(active_targets[i].az ?? 0)))
          })
          let chart_targets = chart_coords.filter(d => d.up)
          let sky_dark_enough = !is_daylight || current_quest.id == "moon"
          let log_allowed = safe_hr == 0 && sky_ready && eff_alt >= 0 && num(live_q_pos.sun_sep ?? 0) >= 30 && sky_dark_enough
          let duplicate_observation = any(observations, e => e.target == current_quest.id && now - num(e.time ?? 0) >= 0 && now - num(e.time ?? 0) < 60)

          if !sky_ready {
            Text { text: sky_error + " · " + str.tapRefresh; font: sans; fontSize: 12; color: c_sec; padding: 10; background: c_card; radius: 10 * corners; onTap: refresh() }
          }

          // TARGET INSTRUMENT CARD
          Column {
            fill: width; gap: 5; padding: [12, 10]; background: c_card; border: 1; borderColor: c_accent_border; radius: 14 * corners
            Row {
              fill: width; gap: 6; align: center
              Column {
                weight: 1; gap: 1
                Text { text: current_name + (target_done ? " ✓" : ""); font: sans; fontSize: 20; bold: true; color: target_tint; maxLines: 1 }
                Text { text: current_group + " · mag " + str(live_q_pos.mag ?? current_quest.mag); font: sans; fontSize: 11; color: c_muted; maxLines: 1 }
              }
              Text { text: follow_best ? str.autoOn : str.bestNow; font: sans; fontSize: 11; color: c_sec; padding: [7, 4]; background: c_bg; radius: 6 * corners; onTap: { follow_best = true; time_offset_hrs = 0; celebrate_msg = best_message } }
              Text { text: "‹"; fontSize: 20; color: c_pri; padding: [8, 2]; onTap: { let previous = safe_idx; quest_idx = (previous + len(quests) - 1) % len(quests); follow_best = false } }
              Text { text: "›"; fontSize: 20; color: c_pri; padding: [8, 2]; onTap: { let previous = safe_idx; quest_idx = (previous + 1) % len(quests); follow_best = false } }
            }

            // Direction, Altitude Sight Diagram, and Rise/Peak/Set Telemetry
            Row {
              fill: width; gap: 8; align: center
              Column {
                weight: 1; gap: 3
                Text {
                  text: !sky_ready ? str.directionsUnavailable : eff_alt < 0 ? str.belowGuide(round(eff_alt), q_peak_str, q_peak_alt) : str.lookGuide(round(eff_az), friendly_direction, round(eff_alt), is_rising)
                  font: sans; fontSize: 13; bold: true; color: sky_ready && eff_alt >= 0 ? c_text : c_sec
                }
                if sky_ready && q_stat != null {
                  Text { text: str.scheduleLine(q_rise_str, q_peak_str, q_peak_alt, q_set_str); font: sans; fontSize: 11; color: c_pri }
                }
                Text { text: str.questHop(current_quest.id); font: sans; fontSize: 11; color: c_text }
              }
              if sky_ready {
                // Functional Elevation Quadrant Sight (0° horizon to 90° zenith)
                Canvas {
                  width: 58; height: 58
                  let ox = 10
                  let oy = 48
                  let r = 38
                  line(ox, oy, ox + r, oy, stroke: c_border, width: 1.5)
                  line(ox, oy, ox, oy - r, stroke: c_border, width: 1.5)
                  path(range(10).map(k => [ox + r * cos(rad(k * 10)), oy - r * sin(rad(k * 10))]), stroke: alpha(c_border, 0.7), width: 1)
                  let clamped_a = clamp(eff_alt, 0, 90)
                  let tx = ox + r * cos(rad(clamped_a))
                  let ty = oy - r * sin(rad(clamped_a))
                  if eff_alt >= 0 {
                    line(ox, oy, tx, ty, stroke: c_pri, width: 1.5)
                    circle(tx, ty, 3.5, fill: target_tint)
                  }
                  text(str(round(eff_alt)) + "°", ox + r - 2, oy - 6, size: 9, bold: true, align: end, color: eff_alt >= 0 ? c_pri : c_muted, font: sans)
                }
              }
            }

            Text { text: conditions_label; font: sans; fontSize: 11; color: c_sec }

            if sky_ready && eff_alt < 0 && q_stat != null && q_stat.peak_alt >= 5 {
              Text {
                text: str.jumpPeakBtn + " (" + q_peak_str + " · " + str(q_peak_alt) + "°)"
                font: sans; fontSize: 12; bold: true; align: center; padding: [8, 8]; color: c_bg; background: c_pri; radius: 10 * corners
                onTap: { let pk = q_stat.peak_step; let pin = safe_idx; quest_idx = pin; follow_best = false; time_offset_hrs = pk / 4; haptic() }
              }
            } else if safe_hr == 0 && is_daylight && current_quest.id != "moon" {
              Text {
                text: str.daylightWaitBtn
                font: sans; fontSize: 12; bold: true; align: center; padding: [8, 8]; color: c_sec; background: c_bg; border: 1; borderColor: c_border; radius: 10 * corners
                onTap: { let selected_target = safe_idx; plan_idx = selected_target; plan_cursor = -1; screen_tab = "tonight"; haptic() }
              }
            } else {
              Input { text: observation_note; placeholder: str.notePlaceholder; fontSize: 12; color: c_text; onChange: observation_note = sub(value, 0, 500) }
              Text {
                text: len(observations) >= 500 ? str.journalFullBtn : duplicate_observation ? str.justLoggedBtn : safe_hr > 0 ? str.previewOnlyBtn : !log_allowed ? str.unavailableLogBtn : target_done ? str.logAgainBtn : str.logFirstBtn
                font: sans; fontSize: 13; bold: true; align: center; padding: [8, 8]; color: log_allowed && !duplicate_observation && len(observations) < 500 ? c_bg : (safe_hr > 0 ? c_pri : c_muted); background: log_allowed && !duplicate_observation && len(observations) < 500 ? c_pri : c_bg; border: 1; borderColor: log_allowed && !duplicate_observation ? c_pri : c_border; radius: 10 * corners
                onTap: {
                  haptic()
                  if log_allowed && !duplicate_observation && len(observations) < 500 {
                    let logged_index = safe_idx
                    let logged_id = current_quest.id
                    let logged_name = str.questName(logged_id)
                    let was_found = contains(found_quests, logged_id)
                    let today = fmtTime(now, "yyyy-MM-dd", site_zone, "en")
                    let midnight = parseTime(today, null, site_zone)
                    let yesterday = fmtTime(midnight - 43200, "yyyy-MM-dd", site_zone, "en")
                    if today != null && midnight != null && last_found_date != today {
                      streak_days = last_found_date == yesterday ? max(0, int(streak_days)) + 1 : 1
                      last_found_date = today
                    }
                    if !was_found {
                      found_quests = unique(flatten([found_quests, [logged_id]]))
                      bonus_xp = max(0, int(bonus_xp)) + 25
                    }
                    observations = flatten([[{id: str(now) + "-" + logged_id, target: logged_id, name: logged_name, time: now, calculated_at: astro_weather.generated_at, site: {name: site_label, lat: site_lat, lon: site_lon, timezone: site_zone}, az: eff_az, alt: eff_alt, clouds: cloud_cover, note: sub(trim(observation_note), 0, 500)}], observations])
                    observation_note = ""
                    celebrate_msg = str.loggedToast(logged_name)
                    quest_idx = logged_index
                    follow_best = false
                  } else if safe_hr > 0 {
                    time_offset_hrs = 0
                  }
                }
              }
            }
            Row {
              fill: width; gap: 8; align: center
              Text { text: show_details ? str.moreOpen : str.moreClosed; font: sans; fontSize: 11; color: c_pri; padding: [8, 5]; background: c_bg; radius: 6 * corners; align: center; weight: 1; onTap: show_details = !show_details }
              Text { text: str.planLink; font: sans; fontSize: 11; color: c_sec; padding: [8, 5]; background: c_bg; radius: 6 * corners; align: center; weight: 1; onTap: { let selected_target = safe_idx; let selected_step = safe_step; plan_idx = selected_target; plan_cursor = selected_step; screen_tab = "tonight" } }
            }
          }

          if show_details {
            Column {
              fill: width; padding: 10; gap: 6; background: c_card; border: 1; borderColor: c_border; radius: 12 * corners
              Text { text: str.aboutHeader(current_name); font: sans; fontSize: 11; bold: true; color: c_sec }
              Text { text: str.questLore(current_quest.id); font: sans; fontSize: 12; color: c_text }
              Text { text: str.brightnessLine(fixed(eff_az, 1), fixed(eff_alt, 1), str(live_q_pos.mag ?? current_quest.mag)); font: sans; fontSize: 11; color: c_muted }
              Text { text: str.nextHoursTitle; font: sans; fontSize: 10; bold: true; color: c_pri }
              if sky_ready {
                Row {
                  fill: width; gap: 6
                  for h in range(4) {
                    let hp = astro_weather.hours[h * 4][safe_idx]
                    let ha = num(hp.alt)
                    let hs = num(astro_weather.sun_alts[h * 4])
                    Column {
                      weight: 1; padding: [6, 6]; background: h == safe_hr ? alpha(c_pri, 0.14) : c_bg; border: 1; borderColor: h == safe_hr ? c_pri : c_border; radius: 8 * corners; align: center; gap: 2
                      Text { text: h == 0 ? str.nowLabel : fmtTime(astro_weather.generated_at + h * 3600, "HH:mm", site_zone); font: sans; fontSize: 11; bold: true; color: c_text }
                      Text { text: ha < 0 ? str(round(ha)) + "°" : str(round(ha)) + "°"; font: sans; fontSize: 12; bold: true; color: ha >= 20 && hs < 0 ? c_ok : ha >= 0 ? c_text : c_muted }
                      Text { text: str.hourStatus(hs, ha); font: sans; fontSize: 9; color: c_sec; maxLines: 1 }
                      onTap: { let pinned = safe_idx; quest_idx = pinned; follow_best = false; time_offset_hrs = h }
                    }
                  }
                }
              }
              Text { text: str.safetyNote; font: sans; fontSize: 10; color: c_muted }
            }
          }

          // OVERHEAD SKY MAP & 24H SCRUBBER
          Column {
            fill: width; align: center; gap: 4; padding: [10, 8]; background: c_card; radius: 14 * corners
            Row {
              fill: width; gap: 8; align: center
              Text { text: safe_hr > 0 ? str.skyPreviewHeader(fmtDuration(safe_step * 900)) : str.skyNowHeader(visible_count); font: sans; fontSize: 11; bold: true; color: c_pri; weight: 1 }
              Text { text: sky_ready ? fmtTime(astro_weather.generated_at + safe_hr * 3600, "EEE HH:mm", site_zone) : ""; font: sans; fontSize: 11; color: c_sec }
            }
            Canvas {
              width: chart_side; height: chart_side
              let cx = width / 2
              let cy = height / 2
              let cr = width / 2 - 18
              circle(cx, cy, cr, fill: c_bg)
              for ring in [1, 0.6667, 0.3333] { circle(cx, cy, cr * ring, stroke: c_border, width: 1) }
              line(cx - cr, cy, cx + cr, cy, stroke: alpha(c_border, 0.45))
              line(cx, cy - cr, cx, cy + cr, stroke: alpha(c_border, 0.45))
              // Asterism guide lines when both stars are above horizon
              for pair in guide_pairs {
                let a = chart_coords[pair[0]]
                let b = chart_coords[pair[1]]
                if a.up && b.up {
                  line(a.px, a.py, b.px, b.py, stroke: alpha(c_pri, 0.28), width: 1)
                }
              }
              text(str.compass(0), cx, 8, size: 11, bold: true, align: center, color: c_pri, font: sans)
              text(str.compass(8), cx, height - 8, size: 10, align: center, color: c_muted, font: sans)
              text(str.compass(4), 8, cy, size: 10, align: center, color: c_muted, font: sans)
              text(str.compass(12), width - 8, cy, size: 10, align: center, color: c_muted, font: sans)
              for dot in chart_targets {
                let dot_pos = active_targets[dot.idx]
                let selected = dot.idx == safe_idx
                let tint = is_cosmic ? quests[dot.idx].color : c_pri
                if selected {
                  circle(dot.px, dot.py, 10, fill: alpha(tint, 0.2))
                  circle(dot.px, dot.py, 8, stroke: c_pri, width: 1.5)
                }
                circle(dot.px, dot.py, clamp(3.5 - num(dot_pos.mag) * 0.35, 2.2, 5), fill: tint)
                if selected {
                  text(str.questName(quests[dot.idx].id), clamp(dot.px, 48, width - 48), dot.py > cy ? dot.py - 14 : dot.py + 15, size: 10, bold: true, align: center, color: c_text, font: sans)
                }
              }
              if !sky_ready { text(str.waitingSky, cx, cy, size: 11, align: center, color: c_muted, font: sans) }
              if sky_ready && len(chart_targets) == 0 { text(str.noneUp, cx, cy, size: 11, align: center, color: c_muted, font: sans) }
              onTap: {
                let touch_x = x
                let touch_y = y
                let hit = first(chart_targets.sortBy(d => pow(d.px - touch_x, 2) + pow(d.py - touch_y, 2)))
                if hit != null && pow(hit.px - touch_x, 2) + pow(hit.py - touch_y, 2) <= 576 {
                  quest_idx = hit.idx
                  follow_best = false
                  haptic()
                }
              }
            }
            Text { text: str.chartCaption; font: sans; fontSize: 10; color: c_muted; align: center }
            Row {
              fill: width; gap: 6; align: center
              Text { text: str.nowLabel; font: sans; fontSize: 10; bold: true; color: safe_hr == 0 ? c_bg : c_pri; background: safe_hr == 0 ? c_pri : c_bg; padding: [8, 4]; radius: 6 * corners; onTap: time_offset_hrs = 0 }
              Slider { value: time_offset_hrs; min: 0; max: 24; step: 0.25; live: true; color: c_pri; track: c_border; weight: 1; height: 20; onChange: { let pinned = safe_idx; quest_idx = pinned; follow_best = false; time_offset_hrs = round(value * 4) / 4 } }
              Text { text: safe_step == 0 ? str.nowLabel : "+" + fmtDuration(safe_step * 900); font: sans; fontSize: 11; color: c_sec; width: 46; align: end }
            }
          }

          // CATALOGUE GRID WITH LIVE ALTITUDES
          Text { text: str.targetsUpHeader(visible_count); font: sans; fontSize: 11; bold: true; color: c_pri }
          Grid {
            columns: 3; gap: 5; fill: width
            for q, i in quests key q.id {
              let t_alt = sky_ready ? num(active_targets[i].alt ?? -90) : -90
              let up = t_alt >= 0
              Column {
                padding: [6, 5]; background: i == safe_idx ? alpha(c_pri, 0.18) : c_card; border: 1; borderColor: i == safe_idx ? c_pri : c_border; radius: 8 * corners; align: center; gap: 1
                Text { text: (contains(found_quests, q.id) ? "✓ " : up ? "● " : "") + str.questName(q.id); font: sans; fontSize: 11; bold: up; maxLines: 1; color: i == safe_idx ? c_pri : up ? c_text : c_muted }
                Text { text: !sky_ready ? "—" : up ? str(round(t_alt)) + "° · " + str.compass(int(floor((num(active_targets[i].az) + 11.25) / 22.5)) % 16) : str.belowHorizonShort; font: sans; fontSize: 9; maxLines: 1; color: up ? c_sec : c_muted }
                onTap: { quest_idx = i; follow_best = false; haptic() }
              }
            }
          }
        }

        if screen_tab == "tonight" {
          let plan_ranked = sky_ready ? (astro_weather.planner.ranked ?? []).filter(t => !plan_new_only || !contains(found_quests, quests[t.idx].id)) : []
          let plan_target_idx = clamp(plan_idx >= 0 ? int(plan_idx) : int(first(plan_ranked).idx ?? safe_idx), 0, len(quests) - 1)
          let plan_target = quests[plan_target_idx]
          let plan_target_name = str.questName(plan_target.id)
          let plan_summary = sky_ready ? find(astro_weather.planner.ranked ?? [], t => t.idx == plan_target_idx) : null
          let plan_stat = sky_ready && astro_weather.stats != null ? astro_weather.stats[plan_target_idx] : null
          let plan_step = clamp(plan_cursor >= 0 ? int(plan_cursor) : int(plan_summary.best_step ?? plan_stat.peak_step ?? 0), 0, 96)
          let plan_epoch = sky_ready ? astro_weather.generated_at + plan_step * 900 : null
          let plan_position = sky_ready ? astro_weather.hours[plan_step][plan_target_idx] : null
          let plan_sun = sky_ready ? num(astro_weather.sun_alts[plan_step]) : null
          let plan_moon = sky_ready ? astro_weather.moon[plan_step] : null
          let plan_windows = plan_summary.windows ?? []
          let plan_eligible = sky_ready && plan_sun <= -6 && num(plan_position.alt ?? -90) >= 20 && num(plan_position.sun_sep ?? 0) >= 30 && num(plan_position.mag ?? 99) <= 2
          let plan_curve = sky_ready ? astro_weather.hours.map(h => num(h[plan_target_idx].alt)) : []
          let plan_bands = sky_ready ? (astro_weather.bands ?? []) : []
          let curve_width = max(180, min(300, (screenWidth ?? 360) - 96))
          let plan_dark = sky_ready ? astro_weather.planner.dark ?? [] : []
          let forecast_fresh = weather_matches && weather_time != null && abs(minute_epoch - weather_time) < 3600 && len(weather.out.hourly.time ?? []) == len(weather.out.hourly.cloud_cover ?? [])
          let forecast_hour = forecast_fresh && plan_epoch != null ? first(range(len(weather.out.hourly.time ?? [])).filter(i => num(weather.out.hourly.time[i]) <= plan_epoch && plan_epoch - num(weather.out.hourly.time[i]) < 3600)) : null
          let plan_cloud = forecast_hour != null && weather.out.hourly.cloud_cover[forecast_hour] != null ? clamp(num(weather.out.hourly.cloud_cover[forecast_hour]), 0, 100) : null
          let plan_clock_label = sky_ready ? fmtTime(plan_epoch, "EEE HH:mm", site_zone) : "—"
          let plan_condition = !sky_ready ? str.skyUnavailable : str.skyCondDetail(plan_sun)

          Column {
            fill: width; gap: 5; padding: 12; background: c_card; radius: 12 * corners
            Text { text: str.tonightTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
            if sky_ready {
              if len(plan_dark) == 0 {
                Text { text: str.noDarkness; font: sans; fontSize: 13; bold: true; color: c_sec }
                Text { text: str.noDarknessHint; font: sans; fontSize: 11; color: c_muted }
              } else {
                for night in plan_dark {
                  Text { text: night.start == astro_weather.generated_at && night.end == astro_weather.generated_at + 86400 ? str.darkAllPeriod : night.start == astro_weather.generated_at ? str.darkUntil(fmtTime(night.end, "EEE HH:mm", site_zone)) : night.end == astro_weather.generated_at + 86400 ? str.darkFrom(fmtTime(night.start, "EEE HH:mm", site_zone)) : str.darkRange(fmtTime(night.start, "EEE HH:mm", site_zone), fmtTime(night.end, "EEE HH:mm", site_zone)); font: sans; fontSize: 14; bold: true; color: c_text }
                }
              }
              Text { text: str.moonNow(round(num(astro_weather.moon[0].illumination)), round(num(astro_weather.moon[0].alt))); font: sans; fontSize: 12; color: c_sec }
            } else {
              Text { text: sky_error + " · " + str.tapRefresh; font: sans; fontSize: 12; color: c_pri; padding: 8; onTap: refresh() }
            }
          }

          if sky_ready {
            Column {
              fill: width; gap: 7; padding: 12; background: c_card; border: 1; borderColor: c_border; radius: 12 * corners
              Row {
                fill: width; gap: 8; align: center
                Box {
                  weight: 1
                  Text { text: plan_target_name + " ▾"; font: sans; fontSize: 20; bold: true; color: is_cosmic ? plan_target.color : c_pri; onTap: plan_picker = true }
                  Popup {
                    visible: plan_picker; onDismiss: plan_picker = false; width: curve_width; background: c_card; border: 1; borderColor: c_border; radius: 10 * corners
                    Column {
                      height: 220; scroll: true; fill: width; gap: 3; padding: 8
                      for q, qi in quests key q.id {
                        let st = astro_weather.stats[qi]
                        Text { text: str.questName(q.id) + " · " + str.peakBest(round(num(st.peak_alt))); font: sans; fontSize: 13; color: qi == plan_target_idx ? c_pri : c_text; padding: [8, 10]; background: qi == plan_target_idx ? alpha(c_pri, 0.1) : c_bg; onTap: { plan_idx = qi; plan_cursor = -1; plan_picker = false; haptic() } }
                      }
                    }
                  }
                }
                Text { text: str.atTime(plan_clock_label); font: sans; fontSize: 11; color: c_sec }
              }
              Text { text: str.altitudeHeader; font: sans; fontSize: 10; color: c_muted }
              Column {
                fill: width; align: center
                Canvas {
                  width: curve_width; height: 144
                  let plot_w = width - 32
                  let plot_h = height - 36
                  for b in plan_bands {
                    rect(24 + plot_w * b.s / 96, 12, plot_w * (b.e - b.s) / 96 + 0.3, plot_h, fill: b.k == 2 ? mix(c_bg, c_sec, 0.15) : b.k == 1 ? mix(c_bg, c_sec, 0.05) : mix(c_bg, c_pri, 0.05))
                  }
                  for altitude in [0, 20, 45, 90] {
                    let gy = height - 24 - altitude / 90 * plot_h
                    line(24, gy, width - 8, gy, stroke: altitude == 20 ? alpha(c_ok, 0.55) : c_border, width: 1)
                    text(str(altitude) + "°", 20, gy, size: 9, align: end, color: c_muted, font: sans)
                  }
                  clip(24, 12, plot_w, plot_h) {
                    if len(plan_curve) == 97 {
                      path(range(97).map(j => [24 + plot_w * j / 96, height - 24 - plan_curve[j] / 90 * plot_h]), stroke: c_pri, width: 2)
                    }
                    for w in plan_windows {
                      line(24 + plot_w * w.start_step / 96, height - 25, 24 + plot_w * w.end_step / 96, height - 25, stroke: c_ok, width: 3)
                    }
                  }
                  let selected_x = 24 + plot_w * plan_step / 96
                  line(selected_x, 12, selected_x, height - 24, stroke: c_sec, width: 1)
                  if num(plan_position.alt) >= 0 {
                    circle(selected_x, height - 24 - num(plan_position.alt) / 90 * plot_h, 4, fill: c_sec)
                  }
                  for h in [0, 6, 12, 18, 24] {
                    text(h == 0 ? str.nowLabel : "+" + str(h) + "h", 24 + plot_w * h / 24, height - 9, size: 9, align: h == 0 ? "start" : h == 24 ? "end" : "center", color: c_muted, font: sans)
                  }
                  onTap: plan_cursor = clamp(int(round((x - 24) / (curve_width - 32) * 96)), 0, 96)
                }
              }
              Slider { value: plan_step / 4; min: 0; max: 24; step: 0.25; live: true; color: c_pri; track: c_border; onChange: plan_cursor = clamp(int(round(value * 4)), 0, 96) }
              Row {
                fill: width; gap: 8; align: center
                Text { text: num(plan_position.alt) < 0 ? str.belowHorizonShort + " (" + str(round(num(plan_position.alt))) + "°)" : "Az " + str(round(num(plan_position.az))) + "° " + str.compass(int(floor((num(plan_position.az) + 11.25) / 22.5)) % 16) + " · Alt " + str(round(num(plan_position.alt))) + "°"; font: sans; fontSize: 14; bold: true; color: c_text; weight: 1 }
                Text { text: plan_eligible ? str.goodWindow : str.outsideWindow; font: sans; fontSize: 11; color: plan_eligible ? c_ok : c_muted }
              }
              Text { text: str.planMoonStatus(plan_condition, round(num(plan_moon.illumination)), round(num(plan_moon.alt))); font: sans; fontSize: 11; color: c_sec }
              Text { text: str.cloudForecast(weather_enabled, plan_cloud != null ? round(plan_cloud) : null, forecast_hour != null ? fmtTime(weather.out.hourly.time[forecast_hour], "EEE HH:mm", site_zone) : ""); font: sans; fontSize: 11; color: plan_cloud != null && plan_cloud >= 70 ? c_sec : c_muted }
              if num(plan_moon.illumination) >= 50 && num(plan_moon.alt) > 0 && plan_target.id != "moon" {
                Text { text: str.moonWashHint; font: sans; fontSize: 10; color: c_muted }
              }
              if len(plan_windows) > 0 {
                Text { text: str.bestWindowsHeader; font: sans; fontSize: 10; bold: true; color: c_pri }
                for w in plan_windows {
                  Text { text: str.windowPeakRange(fmtTime(w.start, "EEE HH:mm", site_zone), fmtTime(w.end, "EEE HH:mm", site_zone), round(num(w.peak_alt))); font: sans; fontSize: 12; color: c_ok; padding: [8, 8]; background: c_bg; radius: 8 * corners; onTap: plan_cursor = int(w.best_step) }
                }
              } else {
                Text { text: str.noWindowTarget; font: sans; fontSize: 12; color: c_muted }
              }
              Text {
                text: plan_step == 0 ? str.observeNowBtn : str.previewObserveBtn
                font: sans; fontSize: 13; bold: true; align: center; padding: [10, 9]; color: c_bg; background: c_pri; radius: 8 * corners
                onTap: { let chosen_target = plan_target_idx; let chosen_offset = plan_step / 4; quest_idx = chosen_target; follow_best = false; time_offset_hrs = chosen_offset; celebrate_msg = ""; screen_tab = "radar"; haptic() }
              }
            }

            Row {
              fill: width; gap: 8; align: center
              Text { text: str.rankedHeader(len(plan_ranked)); font: sans; fontSize: 11; bold: true; color: c_pri; weight: 1 }
              Text { text: plan_new_only ? str.newOnlyOn : str.allTargetsBtn; font: sans; fontSize: 11; color: c_sec; padding: [8, 6]; background: c_card; radius: 8 * corners; onTap: { plan_new_only = !plan_new_only; plan_idx = -1; plan_cursor = -1 } }
            }
            Text { text: str.rankedSub; font: sans; fontSize: 11; color: c_muted }
            if len(plan_ranked) == 0 {
              Text { text: plan_new_only ? str.noRankedNew : str.noRankedAny; font: sans; fontSize: 12; color: c_muted; padding: 12; background: c_card; radius: 10 * corners }
            }
            for target, place in (plan_show_all ? plan_ranked : plan_ranked.take(6)) key target.idx {
              Column {
                fill: width; gap: 3; padding: [12, 9]; background: target.idx == plan_target_idx ? alpha(c_pri, 0.12) : c_card; border: 1; borderColor: target.idx == plan_target_idx ? c_pri : c_border; radius: 10 * corners
                Row {
                  fill: width; gap: 8; align: center
                  Text { text: pad(str(place + 1), 2, "0") + " · " + str.questName(quests[target.idx].id) + (contains(found_quests, quests[target.idx].id) ? " ✓" : ""); font: sans; fontSize: 14; bold: true; color: c_text; weight: 1 }
                  Text { text: str.peakBest(round(num(target.peak_alt))); font: sans; fontSize: 11; color: c_sec }
                }
                Text { text: str.bestWindowRange(fmtTime(target.start, "EEE HH:mm", site_zone), fmtTime(target.end, "EEE HH:mm", site_zone), str(quests[target.idx].mag)); font: sans; fontSize: 11; color: c_muted }
                onTap: { plan_idx = int(target.idx); plan_cursor = -1; haptic() }
              }
            }
            if len(plan_ranked) > 6 {
              Text { text: plan_show_all ? str.showTop6 : str.showAllTargets(len(plan_ranked)); font: sans; fontSize: 12; color: c_pri; align: center; padding: 8; onTap: plan_show_all = !plan_show_all }
            }
          }
        }

        // ALMANAC TAB: Moon Phase Graphic, Sun/Twilight Crossings, 12h Hourly Sky & Cloud Conditions, Field Ruler
        if screen_tab == "almanac" {
          let moon_now = sky_ready ? astro_weather.moon[0] : null
          let moon_lit = moon_now != null ? num(moon_now.illumination) : 0
          let moon_waxing = sky_ready && num(astro_weather.moon[min(8, len(astro_weather.moon) - 1)].illumination) >= moon_lit
          let moon_pos = sky_ready ? live_targets[14] : null
          let moon_stat = sky_ready && astro_weather.stats != null ? astro_weather.stats[14] : null
          let almanac_events = sky_ready ? astro_weather.planner.events ?? [] : []
          let forecast_ok = weather_matches && weather_time != null && abs(minute_epoch - weather_time) < 3600 && len(weather.out.hourly.time ?? []) == len(weather.out.hourly.cloud_cover ?? [])

          // Lunar Phase & Telemetry Card
          Column {
            fill: width; padding: 12; gap: 8; background: c_card; border: 1; borderColor: c_border; radius: 12 * corners
            Text { text: str.almanacMoonTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
            if sky_ready {
              Row {
                fill: width; gap: 12; align: center
                Canvas {
                  width: 64; height: 64
                  circle(32, 32, 26, fill: c_bg, stroke: c_border, width: 1.5)
                  let frac = clamp(moon_lit / 100, 0, 1)
                  for dy in range(-25, 26, 2) {
                    let half_w = sqrt(max(0, 676 - dy * dy))
                    let term = half_w * (1 - 2 * frac)
                    let x1 = moon_waxing ? 32 + term : 32 - half_w
                    let x2 = moon_waxing ? 32 + half_w : 32 - term
                    if x2 > x1 {
                      line(x1, 32 + dy, x2, 32 + dy, stroke: is_cosmic ? #F8FAFC : c_pri, width: 2.2)
                    }
                  }
                }
                Column {
                  weight: 1; gap: 3
                  Text { text: str.moonPhaseLabel(round(moon_lit), moon_waxing) + " · " + str(round(moon_lit)) + "%"; font: sans; fontSize: 16; bold: true; color: c_text }
                  Text {
                    text: num(moon_pos.alt) >= 0 ? "Az " + str(round(num(moon_pos.az))) + "° (" + str.compass(int(floor((num(moon_pos.az) + 11.25) / 22.5)) % 16) + ") · Alt " + str(round(num(moon_pos.alt))) + "°" : str.belowHorizonShort + " (" + str(round(num(moon_pos.alt))) + "°)"
                    font: sans; fontSize: 12; color: c_sec
                  }
                  if moon_stat != null {
                    Text {
                      text: str.scheduleLine(moon_stat.rise != null ? fmtTime(moon_stat.rise, "HH:mm", site_zone) : "", fmtTime(moon_stat.peak_time, "HH:mm", site_zone), round(num(moon_stat.peak_alt)), moon_stat.set != null ? fmtTime(moon_stat.set, "HH:mm", site_zone) : "")
                      font: sans; fontSize: 11; color: c_muted
                    }
                  }
                }
              }
            } else {
              Text { text: sky_error; font: sans; fontSize: 12; color: c_muted }
            }
          }

          // Sun & Twilight Almanac
          Column {
            fill: width; padding: 12; gap: 6; background: c_card; radius: 12 * corners
            Text { text: str.almanacSunTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
            if sky_ready {
              Text { text: str.sunStatusLine(fixed(live_sun_alt, 1), str.skyCondDetail(live_sun_alt)); font: sans; fontSize: 13; bold: true; color: c_sec }
              if len(almanac_events) == 0 {
                Text { text: str.noSunMoonEvents; font: sans; fontSize: 12; color: c_muted }
              }
              for event in almanac_events {
                Row {
                  fill: width; gap: 8; padding: [4, 2]
                  Text { text: str.eventName(event.label); font: sans; fontSize: 12; color: c_text; weight: 1 }
                  Text { text: fmtTime(event.time, "EEE HH:mm", site_zone); font: sans; fontSize: 12; bold: true; color: c_pri }
                }
              }
            }
          }

          // 12-Hour Sky & Cloud Forecast Table
          if sky_ready {
            Column {
              fill: width; padding: 12; gap: 5; background: c_card; radius: 12 * corners
              Text { text: str.almanacHourlyTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
              if !weather_enabled {
                Text { text: str.enableCloudsPrompt; font: sans; fontSize: 11; color: c_sec; onTap: { weather_enabled = true; refresh() } }
              }
              for h in range(0, 12, 2) {
                let step_k = h * 4
                let t_ep = astro_weather.generated_at + h * 3600
                let s_alt = num(astro_weather.sun_alts[step_k])
                let m_alt = num(astro_weather.moon[step_k].alt)
                let m_lit = num(astro_weather.moon[step_k].illumination)
                let f_idx = forecast_ok ? first(range(len(weather.out.hourly.time ?? [])).filter(i => num(weather.out.hourly.time[i]) <= t_ep && t_ep - num(weather.out.hourly.time[i]) < 3600)) : null
                let hr_cloud = f_idx != null && weather.out.hourly.cloud_cover[f_idx] != null ? round(clamp(num(weather.out.hourly.cloud_cover[f_idx]), 0, 100)) : null
                Row {
                  fill: width; gap: 8; padding: [8, 5]; background: c_bg; radius: 6 * corners; align: center
                  Text { text: h == 0 ? str.nowLabel : fmtTime(t_ep, "HH:mm", site_zone); font: sans; fontSize: 12; bold: true; color: c_text; width: 46 }
                  Text { text: "☉ " + str(round(s_alt)) + "° · ☾ " + str(round(m_alt)) + "°"; font: sans; fontSize: 11; color: c_muted; width: 88 }
                  Text { text: str.skyQuality(s_alt, m_alt, m_lit, hr_cloud); font: sans; fontSize: 11; bold: true; color: s_alt <= -18 && hr_cloud != null && hr_cloud < 40 && !(m_alt > 5 && m_lit >= 60) ? c_ok : c_sec; weight: 1; align: end }
                  onTap: { time_offset_hrs = h; screen_tab = "radar"; haptic() }
                }
              }
            }
          }

          // Practical Angular Field Ruler
          Column {
            fill: width; padding: 12; gap: 5; background: c_card; radius: 12 * corners
            Text { text: str.almanacRulerTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
            Text { text: str.ruler1; font: sans; fontSize: 12; color: c_text }
            Text { text: str.ruler5; font: sans; fontSize: 12; color: c_text }
            Text { text: str.ruler10; font: sans; fontSize: 12; color: c_text }
            Text { text: str.ruler20; font: sans; fontSize: 12; color: c_text }
          }
        }

        if screen_tab == "journal" {
          let journal_pages = max(1, int(ceil(len(observations) / 8)))
          let safe_journal_page = clamp(int(journal_page), 0, journal_pages - 1)

          Column {
            fill: width; padding: 12; gap: 6; background: c_card; radius: 12 * corners
            Text { text: str.journalTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
            Text { text: str.journalCounts(len(observations), clamped_found); font: sans; fontSize: 18; bold: true; color: c_text }
            Progress { value: clamped_found; max: 15; color: c_pri; track: c_border }
          }
          if len(observations) == 0 {
            Column {
              fill: width; padding: 16; gap: 8; background: c_card; radius: 12 * corners
              Text { text: str.emptyJournalTitle; font: sans; fontSize: 16; bold: true; color: c_text }
              Text { text: str.emptyJournalSub; font: sans; fontSize: 12; color: c_muted }
              Text { text: str.findTargetLink; font: sans; fontSize: 13; bold: true; color: c_pri; padding: [4, 6]; onTap: screen_tab = "radar" }
            }
          }
          for entry in observations.drop(safe_journal_page * 8).take(8) key entry.id {
            Column {
              fill: width; padding: 12; gap: 4; background: c_card; radius: 12 * corners
              Row {
                fill: width; align: center; gap: 8
                Text { text: str.questName(entry.target ?? entry.name); font: sans; fontSize: 16; bold: true; color: c_text; weight: 1 }
                Text { text: "Az " + str(round(num(entry.az ?? 0))) + "° · Alt " + str(round(num(entry.alt))) + "°" + (entry.clouds != null ? " · " + str(round(num(entry.clouds))) + "% cloud" : ""); font: sans; fontSize: 11; color: c_sec }
              }
              Text { text: fmtTime(entry.time, "EEE d MMM yyyy · HH:mm", entry.site.timezone) + " · " + entry.site.name; font: sans; fontSize: 11; color: c_muted }
              if entry.note != "" { Text { text: entry.note; font: sans; fontSize: 12; color: c_text } }
              if edit_entry_id == entry.id {
                Input { text: edit_note; placeholder: str.notePlaceholder; fontSize: 12; color: c_text; onChange: edit_note = sub(value, 0, 500) }
                Row {
                  fill: width; gap: 8
                  Text { text: str.saveNote; font: sans; fontSize: 12; bold: true; color: c_pri; padding: 8; onTap: { observations = observations.map(e => e.id == edit_entry_id ? merge(e, {note: sub(trim(edit_note), 0, 500)}) : e); edit_entry_id = ""; edit_note = "" } }
                  Text { text: str.cancelBtn; font: sans; fontSize: 12; color: c_muted; padding: 8; onTap: edit_entry_id = "" }
                }
              } else {
                Row {
                  fill: width; gap: 8
                  Text { text: entry.note == "" ? str.addNote : str.editNoteBtn; font: sans; fontSize: 11; color: c_pri; padding: [0, 6]; weight: 1; onTap: { edit_entry_id = entry.id; edit_note = entry.note; remove_entry_id = "" } }
                  Text { text: str.removeBtn; font: sans; fontSize: 11; color: c_muted; padding: [6, 6]; onTap: remove_entry_id = entry.id }
                }
              }
              if remove_entry_id == entry.id {
                Text { text: str.confirmRemovePrompt; font: sans; fontSize: 11; color: c_sec }
                Row {
                  fill: width; gap: 8
                  Text { text: str.confirmRemoveBtn; font: sans; fontSize: 12; bold: true; color: c_sec; padding: 8; onTap: { observations = observations.filter(e => e.id != remove_entry_id); remove_entry_id = ""; edit_entry_id = "" } }
                  Text { text: str.keepEntryBtn; font: sans; fontSize: 12; color: c_pri; padding: 8; onTap: remove_entry_id = "" }
                }
              }
            }
          }
          if journal_pages > 1 {
            Row {
              fill: width; gap: 8; align: center
              Text { text: str.newerBtn; font: sans; fontSize: 12; color: c_pri; padding: 8; onTap: journal_page = max(0, safe_journal_page - 1) }
              Text { text: str(safe_journal_page + 1) + "/" + str(journal_pages); font: sans; fontSize: 12; color: c_muted; align: center; weight: 1 }
              Text { text: str.olderBtn; font: sans; fontSize: 12; color: c_pri; padding: 8; onTap: journal_page = min(journal_pages - 1, safe_journal_page + 1) }
            }
          }
          Column {
            fill: width; padding: 12; gap: 6; background: c_card; radius: 12 * corners
            Text { text: str.exportTitle; font: sans; fontSize: 11; bold: true; letterSpacing: 0.8; color: c_pri }
            Text { text: export_location ? str.exportLocOn : str.exportLocOff; font: sans; fontSize: 12; color: c_text; padding: [0, 6]; onTap: export_location = !export_location }
            Row {
              fill: width; gap: 8
              Text { text: str.copyJson; font: sans; fontSize: 12; bold: true; color: c_pri; padding: 8; background: c_bg; radius: 8 * corners; align: center; weight: 1; onTap: { copy(toJson({version: 1, widget: "AstroQuest", discoveries: found_quests, observations: observations.map(e => export_location ? e : remove(e, "site"))})); journal_notice = str.copiedNotice } }
              Text { text: str.shareJson; font: sans; fontSize: 12; bold: true; color: c_pri; padding: 8; background: c_bg; radius: 8 * corners; align: center; weight: 1; onTap: share(toJson({version: 1, widget: "AstroQuest", discoveries: found_quests, observations: observations.map(e => export_location ? e : remove(e, "site"))})) }
            }
            if journal_notice != "" { Text { text: journal_notice; font: sans; fontSize: 11; color: c_ok } }
          }
        }
      }
    }
  }
}
