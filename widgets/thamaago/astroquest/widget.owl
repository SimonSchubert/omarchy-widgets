widget "AstroQuest" {
  page: 1
  order: 4
  size: 6x3
  minSize: 3x2
  padding: 10
  background: theme_mode == "cosmic" ? #080D20 : #000000

  meta {
    description: "Offline naked-eye astronomy instrument: real-time overhead sky chart, azimuth/altitude finder, 24h observability planner, Sun/Moon almanac, and observation logbook"
    version: "4.6"
    license: "MIT"
    category: "world"
    owl: 18
  }

  requires {
    pacman: ["python", "python-astropy", "python-numpy"]
  }

  strings {
    en {
      subtitle: "SKY INSTRUMENT"
      whereObserving: "Set your observing location"
      setLocationBtn: "◎ Set location"
      chooseSite: "Observing location"
      siteIntro: "Star, planet, Sun, and Moon positions are computed locally for your coordinates and time."
      usePhoneLoc: "◎ Use phone location (GPS/network)"
      applyPhoneLoc: (lat, lon) => "◎ Use phone location (${lat}°, ${lon}°)"
      phoneLocName: "Phone location"
      privacyNote: "Ephemeris calculations run offline via Astropy. City search sends the city name to Open-Meteo. Optional cloud forecasts query Open-Meteo with coordinates rounded to 2 decimals."
      cityPlaceholder: "Search city"
      searchCities: "Search city"
      searching: "Searching…"
      searchOffline: "Search offline. Use phone location or coordinates below."
      noCityMatch: "No matching city found. Try another name or coordinates."
      orCoords: "Manual coordinates (offline)"
      coordsHint: "Decimal degrees: Latitude (−90 to 90), Longitude (−180 to 180). South and West are negative."
      latPlaceholder: "Latitude"
      lonPlaceholder: "Longitude"
      useCoords: "Apply coordinates"
      cityErr: "Enter a city name between 2 and 80 characters"
      coordsErr: "Enter valid latitude (−90 to 90) and longitude (−180 to 180)"
      keepLocation: "Cancel"
      forgetLocation: "Clear saved location"
      selectedCoords: "Coordinates"
      settingsTitle: "INSTRUMENT SETTINGS"
      changeSite: "Change"
      cloudWeatherOn: "Open-Meteo cloud forecast · ON"
      cloudWeatherOff: "Open-Meteo cloud forecast · OFF"
      refreshBtn: "↻ Recalculate now"
      closeSettings: "Done"
      redBtn: "☾ Red"
      cosmicBtn: "✦ Night"
      torchOn: "☼ On"
      torchOff: "☼ Torch"
      tabObserve: "Sky Map"
      tabTonight: "Planner"
      tabAlmanac: "Almanac"
      tabJournal: "Logbook"
      tileObserve: "◎ Sky Map"
      tileTonight: "☾ Planner"
      tileAlmanac: "☼ Almanac"
      autoOn: "Auto ✓"
      bestNow: "Best target"
      loadingSky: "Computing ephemeris…"
      checkLocationHint: "Check location or tap to refresh"
      lookLater: "Daytime · Wait for dusk"
      belowHorizonShort: "Below horizon"
      daylight: "Daylight"
      twilight: "Twilight"
      darkSky: "Dark sky"
      cloudsOff: "clouds off"
      cloudsNA: "clouds n/a"
      skyUnavailable: "Sky data unavailable"
      tapRefresh: "Tap to recalculate"
      chartCaption: "Zenith projection · Center = 90° overhead · Outer ring = 0° horizon"
      nowLabel: "Now"
      waitingSky: "Computing…"
      noneUp: "No catalogue targets above horizon"
      directionsUnavailable: "Ephemeris unavailable"
      notePlaceholder: "Field note (seeing, color, equipment, sky clarity…)"
      journalFullBtn: "Logbook full (500) · Export in Logbook"
      justLoggedBtn: "✓ Logged <1m ago"
      previewOnlyBtn: "Preview time active · Tap to return to Now"
      daylightWaitBtn: "☀ Sun is up · Tap to view tonight's peak window →"
      unavailableLogBtn: "Below horizon or <30° from Sun"
      logAgainBtn: "✓ Log observation"
      logFirstBtn: "+ Log observation"
      moreOpen: "− Hide 4h table & details"
      moreClosed: "+ 4h altitude table & info"
      planLink: "24h curve →"
      jumpPeakBtn: "Jump to peak →"
      nextHoursTitle: "NEXT 4 HOURS (1H STEPS)"
      safetyNote: "Solar safety lock: targets within 30° of the Sun cannot be logged."
      tonightTitle: "24-HOUR OBSERVING PLANNER"
      noDarkness: "No astronomical darkness (Sun > −18°) in this 24h window"
      noDarknessHint: "Bright planets and 1st-magnitude stars remain visible during twilight."
      darkAllPeriod: "Astronomical darkness throughout 24h window"
      noMoonCross: "No Moon rise/set crossing in this 24h window"
      altitudeHeader: "24H ALTITUDE CURVE (0°–90°) · tap graph or drag slider"
      goodWindow: "Optimal window ✓"
      outsideWindow: "Low / bright sky"
      moonWashHint: "Moon >50% illuminated above horizon reduces faint-star contrast."
      bestWindowsHeader: "OPTIMAL WINDOWS (Sun ≤ −6°, Alt ≥ 20°)"
      noWindowTarget: "Does not reach ≥20° altitude during dark sky in the next 24h."
      observeNowBtn: "Open on Sky Map (Now) →"
      previewObserveBtn: "Preview this time on Sky Map →"
      newOnlyOn: "Unlogged only ✓"
      allTargetsBtn: "All 15"
      rankedSub: "Ranked by peak altitude, magnitude, and dark-sky duration."
      noRankedNew: "All qualifying targets tonight have been logged. Tap All 15."
      noRankedAny: "No targets meet dark-sky criteria (Alt ≥20°, Sun ≤−6°) in 24h."
      showTop6: "Show top 6"
      almanacMoonTitle: "LUNAR PHASE & POSITION"
      almanacSunTitle: "SUN & TWILIGHT ALMANAC (NEXT 24H)"
      almanacHourlyTitle: "HOURLY SKY & CLOUD CONDITIONS"
      almanacRulerTitle: "ANGULAR FIELD RULER (ARM'S LENGTH)"
      ruler1: "1° · Pinky fingertip width (2 Moon diameters)"
      ruler5: "5° · Three middle fingers together"
      ruler10: "10° · Clenched fist (1 fist = 10° altitude)"
      ruler20: "20° · Outstretched handspan (thumb to pinky)"
      noSunMoonEvents: "No horizon/twilight crossings in the next 24 hours."
      enableCloudsPrompt: "Enable Open-Meteo cloud forecast in ⚙ for hourly cloud cover"
      journalTitle: "OBSERVATION LOGBOOK"
      emptyJournalTitle: "No observations logged yet."
      emptyJournalSub: "Select a visible target in Sky Map, verify it in the sky, and log it to record its exact timestamp, azimuth, altitude, and sky conditions."
      findTargetLink: "Open Sky Map →"
      saveNote: "Save"
      cancelBtn: "Cancel"
      addNote: "+ Note"
      editNoteBtn: "Edit note"
      removeBtn: "Delete"
      confirmRemovePrompt: "Delete this observation record?"
      confirmRemoveBtn: "Delete"
      keepEntryBtn: "Cancel"
      newerBtn: "‹ Newer"
      olderBtn: "Older ›"
      exportTitle: "DATA EXPORT (JSON)"
      exportLocOn: "Include coordinates in JSON · ON"
      exportLocOff: "Include coordinates in JSON · OFF"
      copyJson: "Copy JSON"
      shareJson: "Share JSON"
      copiedNotice: "Copied JSON to clipboard ✓"
      foundBadge: done => "${done}/15 logged"
      cloudPct: pct => "${pct}% cloud"
      nextWindowAt: (time, name, alt) => "Next: ${name} ~${time} (peaks ${alt}°)"
      upSummary: (az, dir, alt, trend) => "Az ${az}° ${dir} · Alt ${alt}° ${trend}"
      skyPreviewHeader: dur => "SKY MAP · +${dur}"
      skyNowHeader: n => "LIVE SKY MAP · ${n}/15 ABOVE HORIZON"
      targetsUpHeader: n => "CATALOGUE (${n}/15 ABOVE HORIZON)"
      rankedHeader: n => "TONIGHT'S TARGETS (${n})"
      showAllTargets: n => "Show all ${n} targets"
      peakBest: alt => "peak ${alt}°"
      bestWindowRange: (s, e, mag) => "Window ~${s}–${e} · mag ${mag}"
      windowPeakRange: (s, e, alt) => "~${s}–${e} · peak ${alt}°"
      atTime: t => "${t}"
      darkUntil: e => "Astronomical darkness until ~${e}"
      darkFrom: s => "Astronomical darkness from ~${s}"
      darkRange: (s, e) => "Astronomical darkness ~${s}–${e}"
      moonNow: (lit, alt) => "Moon ${lit}% illuminated · " + (alt >= 0 ? "Alt ${alt}°" : "below horizon")
      moonPhaseLabel: (lit, waxing) => lit >= 97 ? "Full Moon" : lit <= 3 ? "New Moon" : lit >= 45 && lit <= 55 ? (waxing ? "First Quarter" : "Last Quarter") : lit > 55 ? (waxing ? "Waxing Gibbous" : "Waning Gibbous") : (waxing ? "Waxing Crescent" : "Waning Crescent")
      sunStatusLine: (alt, cond) => "Sun altitude ${alt}° · ${cond}"
      planMoonStatus: (cond, lit, alt) => "${cond} · Moon ${lit}% (" + (alt >= 0 ? "Alt ${alt}°" : "down") + ")"
      cloudForecast: (enabled, pct, hr) => !enabled ? "Cloud forecast off (enable in ⚙)" : pct == null ? "Cloud forecast unavailable" : "Clouds ~${pct}% (${hr})"
      journalCounts: (obs, found) => "${obs} " + (obs == 1 ? "entry" : "entries") + " · ${found}/15 objects observed"
      compass: idx => ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"][idx]
      directionName: idx => ["North", "NNE", "Northeast", "ENE", "East", "ESE", "Southeast", "SSE", "South", "SSW", "Southwest", "WSW", "West", "WNW", "Northwest", "NNW"][idx]
      lookGuide: (az, dir, alt, rising) => "Az ${az}° (${dir}) · Alt ${alt}° " + (rising ? "↑ rising" : "↓ setting") + " (~" + str(max(1, round(alt / 10))) + (max(1, round(alt / 10)) == 1 ? " fist up)" : " fists up)")
      belowGuide: (alt, peakTime, peakAlt) => "Below horizon (${alt}°) · Peaks at ${peakTime} (${peakAlt}°)"
      scheduleLine: (rise, peak, peakAlt, set) => (rise != "" ? "Rise ${rise} · " : "") + "Peak ${peak} (${peakAlt}°)" + (set != "" ? " · Set ${set}" : "")
      conditionsSummary: (preview, sunAlt, wEnabled, clouds) => (preview ? "Preview · " : "") + (sunAlt >= 0 ? "Daylight (Sun +${round(sunAlt)}°)" : sunAlt > -6 ? "Civil twilight (Sun ${round(sunAlt)}°)" : sunAlt > -12 ? "Nautical twilight (Sun ${round(sunAlt)}°)" : sunAlt > -18 ? "Astro twilight (Sun ${round(sunAlt)}°)" : "Dark sky (Sun ${round(sunAlt)}°)") + (preview || !wEnabled || clouds == null ? "" : " · Clouds ${round(clouds)}%")
      bestToast: (ready, sunAlt, idx, name, clouds) => !ready ? "Computing sky…" : sunAlt == null || sunAlt >= 0 ? "Daytime · Showing tonight's planner" : idx == null ? "No bright target ≥20° right now" : "Selected ${name}" + (clouds != null && clouds >= 70 ? " · ${round(clouds)}% cloud" : "")
      loggedToast: name => "✓ Logged ${name}"
      aboutHeader: name => "REFERENCE · ${upper(name)}"
      brightnessLine: (az, alt, mag) => "Azimuth ${az}° · Altitude ${alt}° · Apparent mag ${mag}"
      hourStatus: (sunAlt, alt) => sunAlt >= 0 ? "Day" : alt < 0 ? "Down" : alt < 20 ? "Low" : sunAlt > -18 ? "Twil" : "Dark"
      skyCondDetail: sunAlt => sunAlt == null ? "—" : sunAlt >= 0 ? "Daylight" : sunAlt > -6 ? "Civil twilight" : sunAlt > -12 ? "Nautical twilight" : sunAlt > -18 ? "Astro twilight" : "Astronomical night"
      skyQuality: (sunAlt, moonAlt, moonLit, cloud) => sunAlt >= 0 ? "Daylight" : sunAlt > -18 ? "Twilight" : cloud != null && cloud >= 75 ? "Overcast (${cloud}%)" : cloud != null && cloud >= 40 ? "Partly cloudy (${cloud}%)" : moonAlt > 5 && moonLit >= 60 ? "Moonlit sky" : cloud == null ? "Dark sky · clouds unknown" : "Dark sky · low cloud forecast"
      eventName: label => get({"Sunset": "Sunset (0°)", "Sunrise": "Sunrise (0°)", "Civil dusk": "Civil dusk (−6°)", "Civil dawn": "Civil dawn (−6°)", "Nautical dusk": "Nautical dusk (−12°)", "Nautical dawn": "Nautical dawn (−12°)", "Astronomical dusk": "Astro night starts (−18°)", "Astronomical dawn": "Astro night ends (−18°)", "Moonrise": "Moonrise", "Moonset": "Moonset"}, label, label)
      resultsFor: q => "Results for \"${q}\""
      questName: id => get({"alnilam": "Orion's Belt", "sirius": "Sirius", "canopus": "Canopus", "betelgeuse": "Betelgeuse", "rigel": "Rigel", "aldebaran": "Aldebaran", "antares": "Antares", "vega": "Vega", "altair": "Altair", "arcturus": "Arcturus", "spica": "Spica", "regulus": "Regulus", "jupiter": "Jupiter", "saturn": "Saturn", "moon": "Moon"}, id, id)
      questGroup: id => get({"alnilam": "Orion · ε Ori", "sirius": "Canis Major · α CMa", "canopus": "Carina · α Car", "betelgeuse": "Orion · α Ori", "rigel": "Orion · β Ori", "aldebaran": "Taurus · α Tau", "antares": "Scorpius · α Sco", "vega": "Lyra · α Lyr", "altair": "Aquila · α Aql", "arcturus": "Boötes · α Boo", "spica": "Virgo · α Vir", "regulus": "Leo · α Leo", "jupiter": "Planet", "saturn": "Planet", "moon": "Earth's Moon"}, id, "")
      questHop: id => get({
        "alnilam": "Finder: 3 bright stars in a tight straight line; Alnilam is the center star.",
        "sirius": "Finder: Brightest star in the sky (−1.46 mag). Follow Orion's Belt down-left.",
        "canopus": "Finder: 2nd brightest star (−0.74 mag), ~36° south of Sirius.",
        "betelgeuse": "Finder: Bright orange-red star above Orion's three belt stars.",
        "rigel": "Finder: Blue-white star below Orion's Belt, opposite orange Betelgeuse.",
        "aldebaran": "Finder: Orange star in a V-shaped cluster; follow Orion's Belt up-right.",
        "antares": "Finder: Deep red star at the heart of Scorpius' curving J-hook.",
        "vega": "Finder: Brilliant blue-white vertex of the Summer Triangle.",
        "altair": "Finder: White star closely flanked by two dimmer stars in a short line.",
        "arcturus": "Finder: Golden-orange giant; follow the curve of the Big Dipper's handle.",
        "spica": "Finder: Blue-white star south of Arcturus along the Big Dipper handle arc.",
        "regulus": "Finder: Brightest star at the base of Leo's backwards question-mark.",
        "jupiter": "Finder: Steady, non-twinkling golden-white planet—brighter than any star.",
        "saturn": "Finder: Steady, non-twinkling cream-yellow planet along the ecliptic.",
        "moon": "Finder: Observe craters along the terminator (day/night shadow boundary)."
      }, id, "")
      questLore: id => get({
        "alnilam": "Blue supergiant ~1,340 ly away; luminosity ~375,000 Suns.",
        "sirius": "Binary system (A1V + white dwarf Sirius B) at 8.6 ly distance.",
        "canopus": "F0Ia supergiant at ~310 ly; primary attitude reference for spacecraft.",
        "betelgeuse": "Red supergiant (M1–M2 Ia) ~500–650 ly away; radius ~760 solar radii.",
        "rigel": "Blue supergiant quadruple system ~860 ly away; ~120,000 solar luminosities.",
        "aldebaran": "K5III orange giant at 65 ly, foreground to the Hyades cluster.",
        "antares": "M1.5Iab red supergiant ~550 ly away; radius ~680 solar radii.",
        "vega": "Rapidly rotating A0V star at 25 ly; standard zero-point of the magnitude scale.",
        "altair": "A7V star at 16.7 ly rotating in 8.9 hours (equatorial velocity ~286 km/s).",
        "arcturus": "K1.5III red giant at 36.7 ly moving at 122 km/s relative to the Sun.",
        "spica": "Close spectroscopic binary (B1III + B2V) at 250 ly with 4.01-day period.",
        "regulus": "Quadruple star system at 79 ly; primary rotates in 15.9 hours.",
        "jupiter": "Gas giant; 7x–10x binoculars resolve the four Galilean moons (Io, Europa, Ganymede, Callisto).",
        "saturn": "Ringed gas giant; rings span 282,000 km with ~10 m vertical thickness.",
        "moon": "Mean distance 384,400 km (1.28 light-seconds); synodic period 29.53 days."
      }, id, "")
    }
    id {
      subtitle: "INSTRUMEN LANGIT"
      whereObserving: "Atur lokasi pengamatan Anda"
      setLocationBtn: "◎ Atur lokasi"
      chooseSite: "Lokasi pengamatan"
      siteIntro: "Posisi bintang, planet, Matahari, dan Bulan dihitung secara lokal sesuai koordinat dan waktu Anda."
      usePhoneLoc: "◎ Gunakan lokasi ponsel (GPS/jaringan)"
      applyPhoneLoc: (lat, lon) => "◎ Pakai lokasi ponsel (${lat}°, ${lon}°)"
      phoneLocName: "Lokasi ponsel"
      privacyNote: "Efemeris dihitung offline dengan Astropy. Pencarian kota mengirim nama kota ke Open-Meteo. Prakiraan awan opsional memakai Open-Meteo (koordinat dibulatkan 2 desimal)."
      cityPlaceholder: "Cari nama kota"
      searchCities: "Cari kota"
      searching: "Mencari…"
      searchOffline: "Pencarian offline. Gunakan lokasi ponsel atau koordinat di bawah."
      noCityMatch: "Kota tidak ditemukan. Coba nama lain atau masukkan koordinat."
      orCoords: "Koordinat manual (bisa offline)"
      coordsHint: "Derajat desimal: Lintang (−90 s/d 90), Bujur (−180 s/d 180). Selatan & Barat bernilai negatif."
      latPlaceholder: "Lintang / Lat"
      lonPlaceholder: "Bujur / Lon"
      useCoords: "Terapkan koordinat"
      cityErr: "Masukkan nama kota antara 2 hingga 80 karakter"
      coordsErr: "Masukkan angka lintang (−90..90) dan bujur (−180..180) yang valid"
      keepLocation: "Batal"
      forgetLocation: "Hapus lokasi tersimpan"
      selectedCoords: "Koordinat"
      settingsTitle: "SETELAN INSTRUMEN"
      changeSite: "Ubah"
      cloudWeatherOn: "Prakiraan awan Open-Meteo · AKTIF"
      cloudWeatherOff: "Prakiraan awan Open-Meteo · MATI"
      refreshBtn: "↻ Hitung ulang"
      closeSettings: "Selesai"
      redBtn: "☾ Merah"
      cosmicBtn: "✦ Kosmik"
      torchOn: "☼ Nyala"
      torchOff: "☼ Senter"
      tabObserve: "Peta Langit"
      tabTonight: "Jadwal 24j"
      tabAlmanac: "Almanak"
      tabJournal: "Catatan"
      tileObserve: "◎ Peta Langit"
      tileTonight: "☾ Jadwal 24j"
      tileAlmanac: "☼ Almanak"
      autoOn: "Otomatis ✓"
      bestNow: "Target terbaik"
      loadingSky: "Menghitung efemeris…"
      checkLocationHint: "Cek lokasi atau ketuk untuk segarkan"
      lookLater: "Siang hari · Tunggu senja"
      belowHorizonShort: "Di bawah cakrawala"
      daylight: "Siang"
      twilight: "Senja/Fajar"
      darkSky: "Langit gelap"
      cloudsOff: "awan mati"
      cloudsNA: "awan n/a"
      skyUnavailable: "Data langit belum siap"
      tapRefresh: "Ketuk untuk hitung ulang"
      chartCaption: "Proyeksi zenit · Tengah = 90° tepat di atas · Lingkaran luar = 0° cakrawala"
      nowLabel: "Kini"
      waitingSky: "Menghitung…"
      noneUp: "Tidak ada target di atas cakrawala"
      directionsUnavailable: "Data arah belum tersedia"
      notePlaceholder: "Catatan lapangan (kecerahan, kondisi langit, alat bantu…)"
      journalFullBtn: "Catatan penuh (500) · Ekspor di Catatan"
      justLoggedBtn: "✓ Baru dicatat <1m lalu"
      previewOnlyBtn: "Mode pratinjau waktu · Ketuk untuk kembali ke Kini"
      daylightWaitBtn: "☀ Matahari di atas cakrawala · Lihat jadwal puncak malam ini →"
      unavailableLogBtn: "Di bawah cakrawala atau <30° dari Matahari"
      logAgainBtn: "✓ Catat pengamatan"
      logFirstBtn: "+ Catat pengamatan"
      moreOpen: "− Tutup tabel 4 jam & detail"
      moreClosed: "+ Tabel 4 jam & info fisik"
      planLink: "Kurva 24j →"
      jumpPeakBtn: "Lihat saat puncak →"
      nextHoursTitle: "4 JAM KE DEPAN (INTERVAL 1 JAM)"
      safetyNote: "Kunci keamanan Matahari: objek dalam jarak 30° dari Matahari tidak dapat dicatat."
      tonightTitle: "PERENCANA PENGAMATAN 24 JAM"
      noDarkness: "Tidak ada gelap astronomis (Matahari > −18°) dalam 24 jam ini"
      noDarknessHint: "Planet terang dan bintang utama tetap dapat diamati saat senja."
      darkAllPeriod: "Gelap astronomis sepanjang 24 jam ini"
      noMoonCross: "Bulan tidak melintasi cakrawala dalam 24 jam ini"
      altitudeHeader: "KURVA KETINGGIAN 24 JAM (0°–90°) · ketuk grafik atau geser"
      goodWindow: "Jendela optimal ✓"
      outsideWindow: "Rendah / langit terang"
      moonWashHint: "Cahaya Bulan >50% di atas cakrawala menurunkan kontras bintang redup."
      bestWindowsHeader: "JENDELA PENGAMATAN OPTIMAL (Matahari ≤ −6°, Alt ≥ 20°)"
      noWindowTarget: "Tidak mencapai ketinggian ≥20° saat langit gelap dalam 24 jam ke depan."
      observeNowBtn: "Buka di Peta Langit (Kini) →"
      previewObserveBtn: "Pratinjau waktu ini di Peta Langit →"
      newOnlyOn: "Belum dicatat ✓"
      allTargetsBtn: "Semua 15"
      rankedSub: "Diurutkan menurut tinggi puncak, magnitudo, dan durasi langit gelap."
      noRankedNew: "Semua target optimal malam ini sudah pernah dicatat. Ketuk Semua 15."
      noRankedAny: "Tidak ada target yang memenuhi kriteria (Alt ≥20°, Matahari ≤−6°) dalam 24 jam."
      showTop6: "Tampilkan 6 teratas"
      almanacMoonTitle: "FASE & POSISI BULAN"
      almanacSunTitle: "ALMANAK MATAHARI & SENJA (24 JAM)"
      almanacHourlyTitle: "KONDISI LANGIT & AWAN PER JAM"
      almanacRulerTitle: "PENGUKUR SUDUT TANGAN (LENGAN LURUS)"
      ruler1: "1° · Lebar ujung jari kelingking (~2x diameter Bulan)"
      ruler5: "5° · Tiga jari tengah dirapatkan"
      ruler10: "10° · Satu kepalan tangan tertutup (1 kepalan = 10° tinggi)"
      ruler20: "20° · Satu jengkal penuh (ujung jempol ke kelingking)"
      noSunMoonEvents: "Tidak ada perlintasan cakrawala/senja dalam 24 jam ke depan."
      enableCloudsPrompt: "Aktifkan prakiraan awan Open-Meteo di ⚙ untuk melihat persentase awan per jam"
      journalTitle: "LOG PENGAMATAN LAPANGAN"
      emptyJournalTitle: "Belum ada pengamatan tercatat."
      emptyJournalSub: "Pilih objek yang berada di atas cakrawala pada Peta Langit, amati langsung di langit, lalu catat untuk menyimpan waktu, azimut, ketinggian, dan kondisi awan."
      findTargetLink: "Buka Peta Langit →"
      saveNote: "Simpan"
      cancelBtn: "Batal"
      addNote: "+ Catatan"
      editNoteBtn: "Ubah catatan"
      removeBtn: "Hapus"
      confirmRemovePrompt: "Hapus data pengamatan ini?"
      confirmRemoveBtn: "Hapus"
      keepEntryBtn: "Batal"
      newerBtn: "‹ Terbaru"
      olderBtn: "Lama ›"
      exportTitle: "EKSPOR DATA (JSON)"
      exportLocOn: "Sertakan koordinat lokasi · AKTIF"
      exportLocOff: "Sertakan koordinat lokasi · MATI"
      copyJson: "Salin JSON"
      shareJson: "Bagikan JSON"
      copiedNotice: "JSON disalin ke papan klip ✓"
      foundBadge: done => "${done}/15 tercatat"
      cloudPct: pct => "${pct}% awan"
      nextWindowAt: (time, name, alt) => "Berikutnya: ${name} ~${time} (puncak ${alt}°)"
      upSummary: (az, dir, alt, trend) => "Az ${az}° ${dir} · Alt ${alt}° ${trend}"
      skyPreviewHeader: dur => "PETA LANGIT · +${dur}"
      skyNowHeader: n => "PETA LANGIT LANGSUNG · ${n}/15 DI ATAS"
      targetsUpHeader: n => "KATALOG OBJEK (${n}/15 DI ATAS CAKRAWALA)"
      rankedHeader: n => "TARGET MALAM INI (${n})"
      showAllTargets: n => "Tampilkan semua ${n} objek"
      peakBest: alt => "puncak ${alt}°"
      bestWindowRange: (s, e, mag) => "Jendela ~${s}–${e} · mag ${mag}"
      windowPeakRange: (s, e, alt) => "~${s}–${e} · puncak ${alt}°"
      atTime: t => "${t}"
      darkUntil: e => "Gelap astronomis hingga ~${e}"
      darkFrom: s => "Gelap astronomis mulai ~${s}"
      darkRange: (s, e) => "Gelap astronomis ~${s}–${e}"
      moonNow: (lit, alt) => "Bulan ${lit}% terang · " + (alt >= 0 ? "Alt ${alt}°" : "di bawah cakrawala")
      moonPhaseLabel: (lit, waxing) => lit >= 97 ? "Bulan Purnama" : lit <= 3 ? "Bulan Baru" : lit >= 45 && lit <= 55 ? (waxing ? "Perbani Awal" : "Perbani Akhir") : lit > 55 ? (waxing ? "Cembung Awal" : "Cembung Akhir") : (waxing ? "Sabit Awal" : "Sabit Akhir")
      sunStatusLine: (alt, cond) => "Tinggi Matahari ${alt}° · ${cond}"
      planMoonStatus: (cond, lit, alt) => "${cond} · Bulan ${lit}% (" + (alt >= 0 ? "Alt ${alt}°" : "terbenam") + ")"
      cloudForecast: (enabled, pct, hr) => !enabled ? "Prakiraan awan mati (aktifkan di ⚙)" : pct == null ? "Prakiraan awan tidak tersedia" : "Awan ~${pct}% (${hr})"
      journalCounts: (obs, found) => "${obs} catatan · ${found}/15 objek telah diamati"
      compass: idx => ["U", "UTL", "TL", "TTL", "T", "TMG", "TG", "STG", "S", "SBD", "BD", "BBD", "B", "BBL", "BL", "UBL"][idx]
      directionName: idx => ["Utara", "UTL", "Timur Laut", "TTL", "Timur", "TMG", "Tenggara", "STG", "Selatan", "SBD", "Barat Daya", "BBD", "Barat", "BBL", "Barat Laut", "UBL"][idx]
      lookGuide: (az, dir, alt, rising) => "Az ${az}° (${dir}) · Alt ${alt}° " + (rising ? "↑ naik" : "↓ turun") + " (~" + str(max(1, round(alt / 10))) + " kepalan tangan)"
      belowGuide: (alt, peakTime, peakAlt) => "Di bawah cakrawala (${alt}°) · Puncak pukul ${peakTime} (${peakAlt}°)"
      scheduleLine: (rise, peak, peakAlt, set) => (rise != "" ? "Terbit ${rise} · " : "") + "Puncak ${peak} (${peakAlt}°)" + (set != "" ? " · Terbenam ${set}" : "")
      conditionsSummary: (preview, sunAlt, wEnabled, clouds) => (preview ? "Pratinjau · " : "") + (sunAlt >= 0 ? "Siang (Matahari +${round(sunAlt)}°)" : sunAlt > -6 ? "Senja sipil (Matahari ${round(sunAlt)}°)" : sunAlt > -12 ? "Senja nautika (Matahari ${round(sunAlt)}°)" : sunAlt > -18 ? "Senja astronomis (Matahari ${round(sunAlt)}°)" : "Langit gelap (Matahari ${round(sunAlt)}°)") + (preview || !wEnabled || clouds == null ? "" : " · Awan ${round(clouds)}%")
      bestToast: (ready, sunAlt, idx, name, clouds) => !ready ? "Menghitung posisi langit…" : sunAlt == null || sunAlt >= 0 ? "Siang hari · Menampilkan jadwal malam ini" : idx == null ? "Belum ada target terang ≥20° saat ini" : "Target aktif: ${name}" + (clouds != null && clouds >= 70 ? " · awan ${round(clouds)}%" : "")
      loggedToast: name => "✓ Pengamatan ${name} tersimpan"
      aboutHeader: name => "DATA FISIK · ${upper(name)}"
      brightnessLine: (az, alt, mag) => "Azimut ${az}° · Ketinggian ${alt}° · Magnitudo semu ${mag}"
      hourStatus: (sunAlt, alt) => sunAlt >= 0 ? "Siang" : alt < 0 ? "Bawah" : alt < 20 ? "Rendah" : sunAlt > -18 ? "Senja" : "Gelap"
      skyCondDetail: sunAlt => sunAlt == null ? "—" : sunAlt >= 0 ? "Siang hari" : sunAlt > -6 ? "Senja sipil" : sunAlt > -12 ? "Senja nautika" : sunAlt > -18 ? "Senja astronomis" : "Malam astronomis"
      skyQuality: (sunAlt, moonAlt, moonLit, cloud) => sunAlt >= 0 ? "Siang hari" : sunAlt > -18 ? "Senja" : cloud != null && cloud >= 75 ? "Mendung (${cloud}%)" : cloud != null && cloud >= 40 ? "Berawan (${cloud}%)" : moonAlt > 5 && moonLit >= 60 ? "Terang Bulan" : cloud == null ? "Langit gelap · awan tidak diketahui" : "Langit gelap · prakiraan sedikit awan"
      eventName: label => get({"Sunset": "Matahari terbenam (0°)", "Sunrise": "Matahari terbit (0°)", "Civil dusk": "Akhir senja sipil (−6°)", "Civil dawn": "Awal fajar sipil (−6°)", "Nautical dusk": "Akhir senja nautika (−12°)", "Nautical dawn": "Awal fajar nautika (−12°)", "Astronomical dusk": "Awal malam astronomis (−18°)", "Astronomical dawn": "Akhir malam astronomis (−18°)", "Moonrise": "Bulan terbit", "Moonset": "Bulan terbenam"}, label, label)
      resultsFor: q => "Hasil untuk \"${q}\""
      questName: id => get({"alnilam": "Sabuk Orion", "sirius": "Sirius", "canopus": "Canopus", "betelgeuse": "Betelgeuse", "rigel": "Rigel", "aldebaran": "Aldebaran", "antares": "Antares", "vega": "Vega", "altair": "Altair", "arcturus": "Arcturus", "spica": "Spica", "regulus": "Regulus", "jupiter": "Jupiter", "saturn": "Saturnus", "moon": "Bulan"}, id, id)
      questGroup: id => get({"alnilam": "Orion · ε Ori", "sirius": "Canis Major · α CMa", "canopus": "Carina · α Car", "betelgeuse": "Orion · α Ori", "rigel": "Orion · β Ori", "aldebaran": "Taurus · α Tau", "antares": "Scorpius · α Sco", "vega": "Lyra · α Lyr", "altair": "Aquila · α Aql", "arcturus": "Boötes · α Boo", "spica": "Virgo · α Vir", "regulus": "Leo · α Leo", "jupiter": "Planet", "saturn": "Planet", "moon": "Satelit Bumi"}, id, "")
      questHop: id => get({
        "alnilam": "Identifikasi: 3 bintang terang berjejer lurus; Alnilam adalah bintang tengahnya.",
        "sirius": "Identifikasi: Bintang paling terang di langit (−1,46 mag). Ikuti garis Sabuk Orion ke kiri bawah.",
        "canopus": "Identifikasi: Bintang paling terang ke-2 (−0,74 mag), ~36° di selatan Sirius.",
        "betelgeuse": "Identifikasi: Bintang jingga-merah terang di atas tiga bintang Sabuk Orion.",
        "rigel": "Identifikasi: Bintang biru-putih terang di bawah Sabuk Orion, berseberangan dengan Betelgeuse.",
        "aldebaran": "Identifikasi: Bintang jingga di gugus huruf V; ikuti garis Sabuk Orion ke kanan atas.",
        "antares": "Identifikasi: Bintang merah delima di jantung pola kail (J) rasi Scorpius.",
        "vega": "Identifikasi: Bintang biru-putih cemerlang di sudut Segitiga Musim Panas.",
        "altair": "Identifikasi: Bintang putih terang diapit dekat oleh dua bintang lebih redup di kiri-kanannya.",
        "arcturus": "Identifikasi: Raksasa kuning-jingga; ikuti lengkungan gagang rasi Biduk.",
        "spica": "Identifikasi: Bintang biru-putih di selatan Arcturus mengikuti lengkungan gagang Biduk.",
        "regulus": "Identifikasi: Bintang paling terang di titik bawah tanda tanya terbalik rasi Leo.",
        "jupiter": "Identifikasi: Cahaya putih-emas sangat terang dan stabil (tidak berkedip seperti bintang).",
        "saturn": "Identifikasi: Cahaya kuning-krem yang bersinar tenang tanpa berkedip di jalur ekliptika.",
        "moon": "Identifikasi: Amati kawah di sepanjang garis terminator (batas siang dan malam Bulan)."
      }, id, "")
      questLore: id => get({
        "alnilam": "Maharaksasa biru (B0Ia) berjarak ~1.340 tahun cahaya; luminositas ~375.000 Matahari.",
        "sirius": "Sistem bintang ganda (A1V + katai putih Sirius B) pada jarak 8,6 tahun cahaya.",
        "canopus": "Maharaksasa F0Ia berjarak ~310 tahun cahaya; acuan utama sensor navigasi wahana antariksa.",
        "betelgeuse": "Maharaksasa merah (M1–M2 Ia) berjarak ~500–650 tahun cahaya; radius ~760 kali Matahari.",
        "rigel": "Sistem empat bintang maharaksasa biru ~860 tahun cahaya; luminositas ~120.000 Matahari.",
        "aldebaran": "Raksasa jingga K5III berjarak 65 tahun cahaya di depan gugus bintang Hyades.",
        "antares": "Maharaksasa merah M1.5Iab berjarak ~550 tahun cahaya; radius ~680 kali Matahari.",
        "vega": "Bintang A0V berotasi cepat pada jarak 25 tahun cahaya; titik nol standar skala magnitudo.",
        "altair": "Bintang A7V berjarak 16,7 tahun cahaya dengan periode rotasi 8,9 jam (~286 km/dtk).",
        "arcturus": "Raksasa jingga K1.5III berjarak 36,7 tahun cahaya dengan kecepatan gerak 122 km/dtk.",
        "spica": "Bintang ganda dekat (B1III + B2V) berjarak 250 tahun cahaya dengan periode orbit 4,01 hari.",
        "regulus": "Sistem empat bintang berjarak 79 tahun cahaya; bintang utamanya berotasi setiap 15,9 jam.",
        "jupiter": "Planet raksasa gas; binokular 7x–10x dapat memisahkan 4 bulan Galilean (Io, Europa, Ganymede, Callisto).",
        "saturn": "Planet raksasa bercincin; rentang cincin 282.000 km dengan ketebalan vertikal hanya ~10 m.",
        "moon": "Jarak rata-rata 384.400 km (1,28 detik cahaya); periode sinodis 29,53 hari."
      }, id, "")
    }
