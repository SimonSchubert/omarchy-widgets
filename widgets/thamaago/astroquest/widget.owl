widget "AstroQuest" {
  page: 1
  order: 4
  size: 6x3
  minSize: 3x2
  padding: 10
  background: theme_mode == "cosmic" ? #080D20 : #000000

  meta {
    description: "Location-based sky explorer with manual aiming, Cosmic/Red modes, time preview, discovery logbook, and astronomy quiz"
    version: "3.3"
    license: "MIT"
    category: "world"
    owl: 13
  }

  // [1. LINUX DEPENDENCIES & SETUP]
  requires {
    pacman: ["python", "python-astropy"]
  }

  // [2. STATE DECLARATIONS (OWL REACTIVITY)]
  // Persistent states
  state streak_days = 0 persist
  state total_found = 0 persist
  state last_found_date = "" persist
  state found_quests = [] persist
  state quest_idx = 0 persist
  state theme_mode = "cosmic" persist
  state bonus_xp = 0 persist
  state quiz_idx = 0 persist
  state quiz_streak = 0 persist

  // 15 Naked-Eye Stargazing Quests with Constellation, Spectral Color, Star-Hopping Guide, and Lore
  let quests = [
    { id: "alnilam",    name: "Orion's Belt", body: "Alnilam",    kind: "star",   con: "Orion",      mag: "1.69", color: #93C5FD, hop: "Look for 3 bright stars in a tight straight line; Alnilam is the middle jewel.", lore: "A blue supergiant ~1,340 light-years away shining 375,000x brighter than the Sun." },
    { id: "sirius",     name: "Sirius",       body: "Sirius",     kind: "star",   con: "Canis Major", mag: "-1.46", color: #E0F2FE, hop: "Follow Orion's Belt downward to the left (southeast) to the brightest star in the sky.", lore: "The Dog Star is just 8.6 light-years away and has a hidden white-dwarf companion, Sirius B." },
    { id: "canopus",    name: "Canopus",      body: "Canopus",    kind: "star",   con: "Carina",     mag: "-0.74", color: #FEF08A, hop: "Look ~36° south of Sirius toward the southern horizon.", lore: "Second-brightest star in the night sky, used by deep-space probes for attitude navigation." },
    { id: "betelgeuse", name: "Betelgeuse",   body: "Betelgeuse", kind: "star",   con: "Orion",      mag: "0.50", color: #FCA5A5, hop: "Spot the unmistakable orange-red shoulder above Orion's Belt.", lore: "A colossal red supergiant so wide that if placed at our Sun, it would engulf Mars!" },
    { id: "rigel",      name: "Rigel",        body: "Rigel",      kind: "star",   con: "Orion",      mag: "0.13", color: #BFDBFE, hop: "Opposite Betelgeuse below Orion's Belt — the bright blue-white knee of Orion.", lore: "A scorching blue-white supergiant system radiating ~120,000 solar luminosities." },
    { id: "aldebaran",  name: "Aldebaran",    body: "Aldebaran",  kind: "star",   con: "Taurus",     mag: "0.86", color: #FDBA74, hop: "Follow Orion's Belt upward to the right (northwest) to a fiery orange eye in a V-shaped cluster.", lore: "The fiery 'Eye of the Bull' sitting in front of the Hyades star cluster, 65 light-years away." },
    { id: "antares",    name: "Antares",      body: "Antares",    kind: "star",   con: "Scorpius",   mag: "1.06", color: #F87171, hop: "Find the J-shaped fishhook of Scorpius; Antares glows ruby-red at its heart.", lore: "Its name means 'Rival of Mars' because its deep red hue rivals the red planet along the ecliptic." },
    { id: "vega",       name: "Vega",         body: "Vega",       kind: "star",   con: "Lyra",       mag: "0.03", color: #BAE6FD, hop: "Brightest icy-blue vertex of the Summer Triangle high in the northern/zenith sky.", lore: "Spins so rapidly it bulges at the equator, and was Earth's North Star 14,000 years ago." },
    { id: "altair",     name: "Altair",       body: "Altair",     kind: "star",   con: "Aquila",     mag: "0.76", color: #E2E8F0, hop: "Southern tip of the Summer Triangle, flanked by two dimmer guardian stars.", lore: "Only 16.7 light-years away, completing a full rotation in under 9 hours!" },
    { id: "arcturus",   name: "Arcturus",     body: "Arcturus",   kind: "star",   con: "Boötes",     mag: "-0.05", color: #FCD34D, hop: "Follow the curve of the Big Dipper's handle: 'Arc to Arcturus'!", lore: "An ancient orange giant passing fast through the Milky Way disk from an old halo stream." },
    { id: "spica",      name: "Spica",        body: "Spica",      kind: "star",   con: "Virgo",      mag: "0.97", color: #93C5FD, hop: "After 'Arc to Arcturus', continue the curve south to 'Speed on to Spica'.", lore: "A tight pair of blue giant stars orbiting so close their gravity stretches them into egg shapes." },
    { id: "regulus",    name: "Regulus",      body: "Regulus",    kind: "star",   con: "Leo",        mag: "1.36", color: #DBEAFE, hop: "Look for the backwards question-mark ('The Sickle') of Leo; Regulus is the dot at the bottom.", lore: "The 'Little King' at the heart of Leo, a quadruple star system 79 light-years from Earth." },
    { id: "jupiter",    name: "Jupiter",      body: "Jupiter",    kind: "planet", con: "Ecliptic",   mag: "-2.4", color: #FDE68A, hop: "Shines with a steady, non-twinkling golden-white glow along the zodiac band.", lore: "King of Planets — even steady 7x binoculars can reveal its four Galilean moons in a line!" },
    { id: "saturn",     name: "Saturn",       body: "Saturn",     kind: "planet", con: "Ecliptic",   mag: "0.6",  color: #FDE047, hop: "Look for a calm, creamy-yellow 'star' that does not twinkle like background stars.", lore: "Famed for its icy rings spanning 282,000 km across yet only ~10 meters thick." },
    { id: "moon",       name: "Moon",         body: "Moon",       kind: "planet", con: "Ecliptic",   mag: "-12.6", color: #F8FAFC, hop: "Follow the terminator line (day/night boundary) where craters cast dramatic shadows.", lore: "Drifting 3.8 cm away from Earth every year; look for dark volcanic plains ('maria') with the naked eye." }
  ]

  // Stargazer trivia questions
  let quiz_bank = [
    { q: "Which star sits right in the middle of Orion's Belt?", opts: ["Alnilam", "Betelgeuse", "Rigel", "Aldebaran"], ans: 0, tip: "Alnilam ('String of Pearls') is the bright blue supergiant in the center of the three belt stars." },
    { q: "How many degrees of sky does one clenched fist at arm's length cover?", opts: ["~2 degrees", "~10 degrees", "~25 degrees", "~45 degrees"], ans: 1, tip: "A clenched fist held at arm's length spans roughly 10° of altitude — the classic stargazer's ruler!" },
    { q: "Following Orion's Belt down and left points directly to which star?", opts: ["Vega", "Antares", "Sirius", "Arcturus"], ans: 2, tip: "Orion's Belt points straight to Sirius, the brightest star in Earth's night sky (-1.46 mag)." },
    { q: "How can you tell a planet (like Jupiter or Saturn) apart from a star with the naked eye?", opts: ["Planets twinkle rapidly", "Planets shine steadily without twinkling", "Planets only appear in the north", "Planets are always green"], ans: 1, tip: "Stars are point sources that twinkle in atmospheric turbulence; planets have tiny disks that shine steadily!" },
    { q: "Why do astronomers use deep red light (#FF3333) at night?", opts: ["It attracts meteors", "It preserves dark-adapted rod cells (rhodopsin)", "It warms the phone screen", "It blocks clouds"], ans: 1, tip: "Red wavelengths barely bleach rhodopsin in your retina's rod cells, saving 30 minutes of dark adaptation." },
    { q: "Complete the classic star-hopping phrase: 'Arc to Arcturus, and...'", opts: ["Leap to Leo", "Speed on to Spica", "Run to Rigel", "Sail to Sirius"], ans: 1, tip: "Follow the Big Dipper's handle curve to orange Arcturus, then continue the arc to blue Spica!" }
  ]

  // Local states
  state screen_tab = "radar"
  state quest_filter = "all"
  state confirm_reset = false
  state reset_ends_at = 0
  state compass_active = false
  state phone_az = 0.0
  state phone_alt = 25.0
  state time_offset_hrs = 0
  state compass_ends_at = 0
  state celebrate_msg = ""
  state quiz_feedback = ""
  state quiz_picked = -1
  state quiz_solved = [] persist
  state show_guides = true
  state show_labels = true
  state observing_site = null persist
  state editing_location = false
  state city_draft = ""
  state city_query = ""
  state latitude_draft = ""
  state longitude_draft = ""
  state location_error = ""


  onTap: {
    haptic()
    screen()
  }

  source now = clock every 1s

  let safe_idx = clamp(int(quest_idx), 0, len(quests) - 1)
  let safe_quiz_idx = clamp(int(quiz_idx), 0, len(quiz_bank) - 1)
  let current_quest = quests[safe_idx]

  // Theme palette expressions (Cosmic Mode vs Strict Red Night-Vision Mode)
  let is_cosmic = theme_mode == "cosmic"
  let c_bg = is_cosmic ? #080D20 : #000000
  let c_card = is_cosmic ? #111B32 : #000000
  let c_pri = is_cosmic ? #79D9ED : #FF3333
  let c_sec = is_cosmic ? #E9C58B : #FF3333
  let c_ok = is_cosmic ? #34D399 : #FF3333
  let c_text = is_cosmic ? #E2E8F0 : #FF3333
  let c_muted = is_cosmic ? #94A3B8 : alpha(#FF3333, 0.72)
  let c_border = is_cosmic ? #293C59 : #FF3333
  let c_accent_border = is_cosmic ? #79D9ED : #FF3333

  // Location is chosen by the user; no default city or IP-based guessing.
  // OWL 13 has no GPS-coordinate/permission API. Exact coordinates may be entered.
  let site_lat = num(observing_site.lat)
  let site_lon = num(observing_site.lon)
  let location_ready = site_lat != null && site_lon != null && site_lat >= -90 && site_lat <= 90 && site_lon >= -180 && site_lon <= 180
  let site_label = location_ready ? (observing_site.name ?? "Selected coordinates") : "Choose observing location"
  let location_open = !location_ready || editing_location
  let draft_lat = num(trim(latitude_draft))
  let draft_lon = num(trim(longitude_draft))
  let coordinates_valid = len(trim(latitude_draft)) > 0 && len(trim(longitude_draft)) > 0 && draft_lat != null && draft_lon != null && draft_lat >= -90 && draft_lat <= 90 && draft_lon >= -180 && draft_lon <= 180
  source places = http(len(trim(city_query)) >= 2 ? "https://geocoding-api.open-meteo.com/v1/search?name=${enc(city_query)}&count=5&language=en&format=json" : null) every 1h json status timeout 10s

  // Offline Astropy; user coordinates are shell-quoted arguments, never code.
  let site_lat_arg = location_ready ? str(site_lat) : ""
  let site_lon_arg = location_ready ? str(site_lon) : ""
  source astro_weather = cmd("python -I -c 'import json, sys, time, math\ntry:\n    latitude, longitude = map(float, sys.argv[1:3])\n    if not (math.isfinite(latitude) and math.isfinite(longitude) and -90 <= latitude <= 90 and -180 <= longitude <= 180):\n        raise ValueError(\"Coordinates out of range\")\nexcept (ValueError, TypeError):\n    print(json.dumps({\"ok\": False, \"error\": \"Choose your observing location\"}))\n    sys.exit(0)\nfrom astropy import units as u\nfrom astropy.coordinates import AltAz, EarthLocation, SkyCoord, get_body, solar_system_ephemeris\nfrom astropy.time import Time\nfrom astropy.utils import iers\niers.conf.auto_download = False\n# Use bundled Earth rotation tables without downloading data.\niers.conf.auto_max_age = None\nsolar_system_ephemeris.set(\"builtin\")\nsite = EarthLocation.from_geodetic(longitude * u.deg, latitude * u.deg)\ngenerated_at = time.time()\ntimes = Time(generated_at, format=\"unix\") + list(range(13)) * u.hour\nframe = AltAz(obstime=times, location=site, pressure=1010 * u.hPa, temperature=15 * u.deg_C)\n# Fixed J2000 catalogue coordinates of the twelve quest stars.\nstars = [[\"Alnilam\", 84.05338935, -1.20191983], [\"Sirius\", 101.28715455, -16.71611569], [\"Canopus\", 95.9879577, -52.69566045], [\"Betelgeuse\", 88.7929386, 7.40706274], [\"Rigel\", 78.63446805, -8.20164055], [\"Aldebaran\", 68.980161, 16.50930138], [\"Antares\", 247.35192045, -26.4320025], [\"Vega\", 279.23473545, 38.78369185], [\"Altair\", 297.6958296, 8.86832203], [\"Arcturus\", 213.91530015, 19.18241038], [\"Spica\", 201.29824695, -11.16132203], [\"Regulus\", 152.0929611, 11.96720709]]\npositions = []\nfor name, ra, dec in stars:\n    positions.append(SkyCoord(ra=ra * u.deg, dec=dec * u.deg, frame=\"icrs\").transform_to(frame))\nfor name in (\"jupiter\", \"saturn\", \"moon\"):\n    positions.append(get_body(name, times, site).transform_to(frame))\nhours = [[{\"az\": round(float(p.az.deg[h]), 2) % 360, \"alt\": round(float(p.alt.deg[h]), 2)} for p in positions] for h in range(13)]\nprint(json.dumps({\"ok\": True, \"generated_at\": int(generated_at), \"latitude\": latitude, \"longitude\": longitude, \"hours\": hours}))\n' ${sh(site_lat_arg)} ${sh(site_lon_arg)}") every 1m json timeout 30s

  // Send selected coordinates to Open-Meteo only after the user chooses a site.
  source weather = http(location_ready ? "https://api.open-meteo.com/v1/forecast?latitude=${enc(site_lat)}&longitude=${enc(site_lon)}&current=cloud_cover&timezone=auto&timeformat=unixtime" : null) every 15m json status timeout 10s
  let weather_matches = location_ready && weather.ok && weather.out.latitude != null && weather.out.longitude != null && abs(num(weather.out.latitude) - site_lat) < 0.3 && abs((num(weather.out.longitude) - site_lon + 540) % 360 - 180) < 0.3
  let weather_time = num(weather.out.current.time)
  let cloud_cover = weather_matches && weather_time != null && abs(now - weather_time) < 3600 && weather.out.current.cloud_cover != null ? clamp(num(weather.out.current.cloud_cover), 0, 100) : null
  let cloud_label = cloud_cover == null ? "unavailable" : str(round(cloud_cover)) + "%"
  let site_zone = observing_site.timezone ?? (weather_matches ? weather.out.timezone : null) ?? "UTC"

  let safe_hr = clamp(int(time_offset_hrs), 0, 12)
  let sky_ready = location_ready && astro_weather.latitude == site_lat && astro_weather.longitude == site_lon && astro_weather.ok == true && astro_weather.generated_at != null && abs(now - astro_weather.generated_at) <= 180 && len(astro_weather.hours) == 13
  let active_targets = sky_ready ? (astro_weather.hours[safe_hr] ?? []) : []
  let live_q_pos = active_targets[safe_idx]
  let eff_az = num(live_q_pos.az)
  let eff_alt = num(live_q_pos.alt)
  let visible_count = count(active_targets, t => num(t.alt ?? -90) >= 0)
  let sky_time = sky_ready ? fmtTime(astro_weather.generated_at + safe_hr * 3600, "EEE HH:mm", site_zone) + " " + site_zone : "unavailable"

  // Heading and elevation are manually simulated; there is no calibrated sensor API.
  // Scanning only animates the radar and expires after 30 seconds.
  on compass_active {
    compass_ends_at = value ? int((now ?? 0) + 30) : 0
  }
  at compass_ends_at { compass_active = false; compass_ends_at = 0 }
  at reset_ends_at { confirm_reset = false; reset_ends_at = 0 }
  on observing_site { time_offset_hrs = 0; compass_active = false; celebrate_msg = "" }
  on quiz_idx { quiz_picked = -1; quiz_feedback = "" }
  on screen_tab { confirm_reset = false; reset_ends_at = 0 }

  // [4. COMPASS MATH & GAMIFICATION STATS]
  // Strictly handle the 360-degree wrap: diff = (target_az - phone_az + 540) % 360 - 180
  let diff = (eff_az - phone_az + 540) % 360 - 180
  let alt_diff = eff_alt - phone_alt
  let is_locked = sky_ready && eff_alt >= 0 && abs(diff) <= 10 && abs(alt_diff) <= 10

  // ASCII progress bar helper for 15 targets: build_ascii_progress_bar(total_found, 15)
  let clamped_found = count(quests, q => contains(found_quests, q.id))
  let build_ascii_progress_bar = join(range(15).map(i => i < clamped_found ? "#" : "-"), "")

  // XP & Rank progression
  let total_xp = clamped_found * 100 + max(0, int(streak_days)) * 50 + max(0, int(bonus_xp))
  let rank_title = total_xp >= 1800 ? "COSMIC MASTER" : total_xp >= 1200 ? "ASTRONOMER" : total_xp >= 600 ? "NAVIGATOR" : total_xp >= 200 ? "STAR SCOUT" : "CADET"
  let rank_lvl = clamp(int(floor(total_xp / 300)) + 1, 1, 10)

  let target_tint = is_cosmic ? current_quest.color : c_pri
  let target_done = contains(found_quests, current_quest.id)
  let up_indices = range(len(quests)).filter(i => num(active_targets[i].alt ?? -90) >= 0)

  // [5. UI TREE LAYOUT (HOME-SCREEN TILE)]
  if location_open {
    Column {
      fill: true
      justify: spaceBetween
      gap: 4
      onTap: screen()
      Text { text: "✦ ASTROQUEST"; color: c_pri; fontSize: 12; bold: true; letterSpacing: 1.5 }
      Text { text: "Where are you observing?"; font: sans; fontSize: 18; bold: true; color: c_text }
      Text { text: "Choose a city or enter exact coordinates"; fontSize: 10; color: c_muted }
      Text { text: "◎ Set observing location"; color: c_bg; background: c_pri; padding: [8, 6]; fontSize: 12; align: center; bold: true; onTap: screen() }
    }
  } else {
  Column {
    fill: true
    gap: 5
    justify: spaceBetween
    Row {
      fill: width
      align: center
      Text { text: "✦ ASTROQUEST"; font: sans; fontSize: 12; letterSpacing: 1.5; bold: true; color: c_pri; weight: 1; onTap: screen() }
      Text { text: "L" + str(rank_lvl) + " · " + str(total_xp) + " XP"; fontSize: 10; color: c_sec; onTap: { screen_tab = "quests"; screen() } }
      Text { text: is_cosmic ? "☾" : "☀"; fontSize: 16; color: c_pri; padding: [6, 0]; onTap: { haptic(); theme_mode = is_cosmic ? "red" : "cosmic" } }
    }
    Row {
      fill: width
      align: center
      gap: 10
      Box {
        width: 54
        height: 54
        onTap: { haptic(); screen_tab = "radar"; screen() }
        Canvas {
          fill: true
          circle(width / 2, height / 2, 24, stroke: alpha(c_pri, 0.22), width: 1)
          circle(width / 2, height / 2, 17, stroke: alpha(c_pri, 0.12), width: 1)
          line(3, height / 2, width - 3, height / 2, stroke: alpha(c_pri, 0.15))
          circle(width / 2, height / 2, 14, fill: alpha(target_tint, 0.09))
          circle(width / 2, height / 2, 10, fill: alpha(target_tint, 0.2))
          circle(width / 2, height / 2, 7, fill: target_tint)
          arc(width / 2, height / 2, 24, 0, clamped_found / 15 * 360, stroke: c_pri, width: 2, cap: round)
          circle(width / 2 + sin(rad(eff_az)) * 24, height / 2 - cos(rad(eff_az)) * 24, 3, fill: c_sec)
        }
      }
      Column {
        weight: 1
        gap: 0
        onTap: { haptic(); quest_idx = (safe_idx + 1) % len(quests) }
        Text { text: current_quest.name; font: sans; fontSize: 22; bold: true; color: target_tint; maxLines: 1 }
        Text { text: !sky_ready ? "SKY DATA UNAVAILABLE" : (eff_alt >= 0 ? "● ABOVE HORIZON" : "○ BELOW HORIZON") + " · " + str(round(eff_alt)) + "°"; fontSize: 9; letterSpacing: 0.5; color: eff_alt >= 0 ? c_ok : c_muted; maxLines: 1 }
      }
      Text { text: "›"; fontSize: 26; color: c_pri; padding: [5, 0]; onTap: { haptic(); quest_idx = (safe_idx + 1) % len(quests) } }
    }
    Row {
      fill: width
      gap: 6
      Text { text: "◎ Explore sky"; fontSize: 11; bold: true; color: c_bg; background: c_pri; align: center; padding: [6, 6]; radius: 10 * corners; weight: 1; onTap: { haptic(); screen_tab = "radar"; screen() } }
      Text {
        text: "✧ Pick visible"
        fontSize: 11
        color: c_sec
        background: c_card
        align: center
        padding: [6, 6]
        radius: 10 * corners
        weight: 1
        onTap: { haptic(); if len(up_indices) > 0 { quest_idx = up_indices[random(len(up_indices))] } else { celebrate_msg = sky_ready ? "No targets above the horizon at this time" : "Sky data unavailable; try refresh"; screen_tab = "radar"; screen() } }
      }
    }
  }

  }

  // [6. INTERACTIVE FULL-SCREEN SKY DOME, QUEST LOGBOOK & STAR QUIZ]
  screen {
    title: "AstroQuest · Observatory"

    Column {
      scroll: true
      gap: 10
      padding: 12
      fill: width
      background: c_bg

      if location_open {
        Column {
          fill: width
          gap: 10
          padding: 12
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners
          Text { text: "Choose your observing location"; font: sans; fontSize: 20; bold: true; color: c_pri }
          Text { text: "Sky positions use this location and the current time. There is no preset city."; fontSize: 12; color: c_text }
          Text { text: "This launcher cannot read GPS coordinates. Enter coordinates from your maps app for a precise site, or choose a city center. Update the site when you move."; fontSize: 11; color: c_muted }
          Text { text: "City searches and selected coordinates are sent to Open-Meteo for search and weather. Your selected site is saved on this phone."; fontSize: 10; color: c_muted }
          Input { text: city_draft; placeholder: "City name (at least 2 letters)"; color: c_text; fontSize: 13; onChange: city_draft = value; onSubmit: { if len(trim(value)) >= 2 { city_query = trim(value); location_error = "" } else { location_error = "Enter at least two letters" } } }
          Text { text: "Search cities"; color: c_bg; background: c_pri; padding: [10, 8]; align: center; bold: true; onTap: { if len(trim(city_draft)) >= 2 { city_query = trim(city_draft); location_error = ""; refresh() } else { location_error = "Enter at least two letters" } } }
          if len(city_query) >= 2 {
            Text { text: "Results for " + city_query; fontSize: 11; color: c_sec }
            if places == null { Text { text: "Searching…"; color: c_muted } }
            else if !places.ok { Text { text: "Search unavailable. Retry or enter coordinates below."; color: c_sec } }
            else if len(places.out.results ?? []) == 0 { Text { text: "No matching city. Try another name or exact coordinates."; color: c_sec } }
            for place in places.out.results ?? [] key place.id {
              Column {
                fill: width
                padding: [10, 8]
                gap: 3
                background: c_bg
                border: 1
                borderColor: c_border
                radius: 10 * corners
                Text { text: place.name + ", " + (place.admin1 ?? place.country ?? ""); fontSize: 13; bold: true; color: c_text }
                Text { text: (place.country ?? "") + " · " + str(round(num(place.latitude), 4)) + ", " + str(round(num(place.longitude), 4)) + " · city center"; fontSize: 10; color: c_muted }
                onTap: {
                  let chosen_lat = num(place.latitude)
                  let chosen_lon = num(place.longitude)
                  if chosen_lat != null && chosen_lon != null && chosen_lat >= -90 && chosen_lat <= 90 && chosen_lon >= -180 && chosen_lon <= 180 {
                    observing_site = {lat: chosen_lat, lon: chosen_lon, name: place.name + ", " + (place.country ?? ""), timezone: place.timezone, method: "city center", confirmed_at: now}
                    editing_location = false
                    screen_tab = "radar"
                    location_error = ""
                    haptic()
                  }
                }
              }
            }
          }
          Text { text: "Or use exact coordinates"; fontSize: 14; bold: true; color: c_sec }
          Text { text: "Decimal degrees: latitude −90 to 90, longitude −180 to 180. South and west are negative."; fontSize: 11; color: c_muted }
          Input { text: latitude_draft; placeholder: "Latitude"; color: c_text; onChange: latitude_draft = value }
          Input { text: longitude_draft; placeholder: "Longitude"; color: c_text; onChange: longitude_draft = value }
          Text {
            text: "Use these coordinates"
            color: coordinates_valid ? c_bg : c_muted
            background: coordinates_valid ? c_pri : c_bg
            padding: [10, 8]
            align: center
            bold: true
            onTap: {
              if coordinates_valid {
                let selected_lat = draft_lat
                let selected_lon = draft_lon
                observing_site = {lat: selected_lat, lon: selected_lon, name: "Selected coordinates", method: "coordinates", confirmed_at: now}
                editing_location = false
                screen_tab = "radar"
                location_error = ""
                haptic()
              } else { location_error = "Enter valid decimal latitude and longitude within the ranges above" }
            }
          }
          if location_error != "" { Text { text: location_error; fontSize: 11; color: c_sec } }
          if location_ready {
            Text { text: "Keep current location"; align: center; padding: 8; color: c_pri; onTap: editing_location = false }
            Text { text: "Forget saved location"; align: center; padding: 8; color: #FF3333; onTap: { observing_site = null; latitude_draft = ""; longitude_draft = ""; city_draft = ""; city_query = ""; location_error = ""; editing_location = false } }
          }
        }
      } else {
        Column {
          fill: width
          gap: 3
          padding: [10, 8]
          background: c_card
          radius: 10 * corners
          Text { text: "◎ " + site_label + " · Change"; fontSize: 12; bold: true; color: c_pri }
          Text { text: str(round(site_lat, 4)) + ", " + str(round(site_lon, 4)) + " · " + (observing_site.method ?? "selected site"); fontSize: 10; color: c_muted }
          onTap: { latitude_draft = str(site_lat); longitude_draft = str(site_lon); location_error = ""; city_query = ""; editing_location = true }
        }
      }
      if !location_open {
      // Top Stargazer Status & Theme Toggle Bar
      Row {
        gap: 8
        fill: width
        align: center
        padding: [10, 8]
        background: c_card
        border: 1
        borderColor: c_accent_border
        radius: 16 * corners

        Column {
          gap: 2
          weight: 1

          Text {
            text: "★ LVL " + str(rank_lvl) + " " + rank_title + " · " + str(total_xp) + " XP"
            font: sans
            fontSize: 13
            bold: true
            color: c_sec
          }

          Text {
            text: str(streak_days) + "d streak · " + str(clamped_found) + "/15 found · " + (sky_ready ? str(visible_count) + " visible" : "sky unavailable")
            font: sans
            fontSize: 11
            color: c_muted
          }
        }

        Text {
          text: is_cosmic ? "Cosmic" : "Night red"
          font: sans
          fontSize: 11
          bold: true
          color: c_pri
          background: is_cosmic ? alpha(#79D9ED, 0.15) : alpha(#FF3333, 0.18)
          border: 1
          borderColor: c_accent_border
          padding: [8, 6]
          radius: 10 * corners
          onTap: {
            haptic()
            theme_mode = is_cosmic ? "red" : "cosmic"
          }
        }
      }

      // 3-Way Navigation Tabs: Sky Radar | 15 Quests | Star Quiz
      Row {
        gap: 6
        fill: width

        Text {
          text: "◎ Sky"
          font: sans
          fontSize: 11
          bold: true
          color: screen_tab == "radar" ? c_pri : c_text
          align: center
          background: screen_tab == "radar" ? alpha(c_pri, 0.2) : c_card
          border: 1
          borderColor: screen_tab == "radar" ? c_accent_border : c_border
          padding: [6, 8]
          radius: 10 * corners
          maxLines: 1
          weight: 1
          onTap: {
            haptic()
            screen_tab = "radar"
          }
        }

        Text {
          text: "✦ Quests"
          font: sans
          fontSize: 11
          bold: true
          color: screen_tab == "quests" ? c_sec : c_text
          align: center
          background: screen_tab == "quests" ? alpha(c_sec, 0.2) : c_card
          border: 1
          borderColor: screen_tab == "quests" ? c_sec : c_border
          padding: [6, 8]
          radius: 10 * corners
          maxLines: 1
          weight: 1
          onTap: {
            haptic()
            screen_tab = "quests"
          }
        }

        Text {
          text: "✧ Quiz"
          font: sans
          fontSize: 11
          bold: true
          color: screen_tab == "quiz" ? c_ok : c_text
          align: center
          background: screen_tab == "quiz" ? alpha(c_ok, 0.2) : c_card
          border: 1
          borderColor: screen_tab == "quiz" ? c_ok : c_border
          padding: [6, 8]
          radius: 10 * corners
          maxLines: 1
          weight: 1
          onTap: {
            haptic()
            screen_tab = "quiz"
          }
        }
      }

      if celebrate_msg != "" {
        Row {
          gap: 8
          fill: width
          align: center
          padding: [10, 6]
          background: alpha(c_ok, 0.18)
          border: 1
          borderColor: c_ok
          radius: 10 * corners
          onTap: {
            celebrate_msg = ""
          }

          Text {
            text: celebrate_msg
            font: sans
            fontSize: 12
            bold: true
            color: c_ok
            weight: 1
          }

          Text {
            text: "✕"
            font: sans
            fontSize: 12
            bold: true
            color: c_ok
          }
        }
      }

      if screen_tab == "radar" {
        Text { text: "Selected observing site · manual heading"; fontSize: 10; color: c_muted; align: center }
        // Target & Telemetry Banner
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners

          Row {
            fill: width
            align: center
            gap: 6

            Text {
              text: "‹"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [8, 4]
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = (safe_idx + len(quests) - 1) % len(quests)
              }
            }

            Text {
              text: current_quest.name + (contains(found_quests, current_quest.id) ? " ✓" : "")
              font: sans
              fontSize: 14
              bold: true
              color: is_cosmic ? current_quest.color : #FF3333
              align: center
              weight: 1
            }

            Text {
              text: "↻"
              font: sans
              fontSize: 11
              bold: true
              color: c_sec
              border: 1
              borderColor: c_sec
              padding: [6, 4]
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = random(len(quests))
              }
            }

            Text {
              text: "›"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [8, 4]
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = (safe_idx + 1) % len(quests)
              }
            }
          }

          Text {
            text: current_quest.con + " · Mag " + current_quest.mag + " · Clouds: " + cloud_label
            font: sans
            fontSize: 11
            color: c_muted
            align: center
            fill: width
          }

          Text {
            text: !sky_ready ? (astro_weather.error ?? "Sky data unavailable · refresh to retry") : "Az " + str(round(eff_az, 1)) + "° · Alt " + str(round(eff_alt, 1)) + "° · " + sky_time
            font: sans
            fontSize: 12
            bold: true
            color: c_text
            align: center
            fill: width
          }

          Text {
            text: !sky_ready ? "Positions are hidden until fresh data is available" : eff_alt >= 0 ? "Above horizon · elevation " + str(round(eff_alt)) + "°" : "Below horizon · choose another target or explore a later time"
            font: sans
            fontSize: 11
            bold: true
            color: eff_alt >= 0 ? c_ok : c_sec
            align: center
            fill: width
          }
        }

        // Horizontal drags rotate manual heading while vertical gestures scroll.
        Box {
          height: 280
          fill: width
          background: is_cosmic ? radial(0.5, 0.5, 0.7, [#111C38, #060914]) : #000000
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners

          Canvas {
            fill: true
            onTap: {
              haptic()
              quest_idx = (safe_idx + 1) % len(quests)
            }
            drag: horizontal
            onDrag: {
              phone_az = round((phone_az + dx * 0.5 + 360) % 360, 1)
            }

            let cx = width / 2
            let cy = height / 2
            let max_r = min(width, height) / 2 - 22

            // Starfield background dots in Cosmic Mode
            if is_cosmic {
              for s in range(36) {
                let sx = hash(s, 1) * width
                let sy = hash(s, 2) * height
                let sr = 0.8 + hash(s, 3) * 1.2
                circle(sx, sy, sr, fill: alpha(#E2E8F0, 0.18 + hash(s, 4) * 0.25))
              }
            }

            // Altitude rings: 0° (horizon), 30°, 60°
            circle(cx, cy, max_r, stroke: c_pri, width: 1.5)
            circle(cx, cy, max_r * 0.66, stroke: alpha(c_pri, 0.4), width: 1)
            circle(cx, cy, max_r * 0.33, stroke: alpha(c_pri, 0.25), width: 1)

            // Crosshairs
            line(cx - max_r, cy, cx + max_r, cy, stroke: alpha(c_pri, 0.25), width: 1)
            line(cx, cy - max_r, cx, cy + max_r, stroke: alpha(c_pri, 0.25), width: 1)

            // Cardinal labels (N=0°, E=90°, S=180°, W=270°)
            text("N", cx, cy - max_r - 11, size: 11, color: c_pri, align: center, bold: true, font: sans)
            text("S", cx, cy + max_r + 11, size: 11, color: c_pri, align: center, bold: true, font: sans)
            text("E", cx + max_r + 11, cy, size: 11, color: c_pri, align: center, bold: true, font: sans)
            text("W", cx - max_r - 11, cy, size: 11, color: c_pri, align: center, bold: true, font: sans)

            // Constellation guide lines connecting Orion (Betelgeuse 3 - Alnilam 0 - Rigel 4) & Aldebaran (5) & Sirius (1)
            if show_guides && len(active_targets) >= 12 {
              let p0 = active_targets[0]
              let p1 = active_targets[1]
              let p3 = active_targets[3]
              let p4 = active_targets[4]
              let p5 = active_targets[5]
              let r0 = max_r * clamp((90 - clamp(num(p0.alt ?? 0), 0, 90)) / 90, 0, 1)
              let r1 = max_r * clamp((90 - clamp(num(p1.alt ?? 0), 0, 90)) / 90, 0, 1)
              let r3 = max_r * clamp((90 - clamp(num(p3.alt ?? 0), 0, 90)) / 90, 0, 1)
              let r4 = max_r * clamp((90 - clamp(num(p4.alt ?? 0), 0, 90)) / 90, 0, 1)
              let r5 = max_r * clamp((90 - clamp(num(p5.alt ?? 0), 0, 90)) / 90, 0, 1)
              let x0 = cx + cos(rad(num(p0.az ?? 0) - 90)) * r0
              let y0 = cy + sin(rad(num(p0.az ?? 0) - 90)) * r0
              let x1 = cx + cos(rad(num(p1.az ?? 0) - 90)) * r1
              let y1 = cy + sin(rad(num(p1.az ?? 0) - 90)) * r1
              let x3 = cx + cos(rad(num(p3.az ?? 0) - 90)) * r3
              let y3 = cy + sin(rad(num(p3.az ?? 0) - 90)) * r3
              let x4 = cx + cos(rad(num(p4.az ?? 0) - 90)) * r4
              let y4 = cy + sin(rad(num(p4.az ?? 0) - 90)) * r4
              let x5 = cx + cos(rad(num(p5.az ?? 0) - 90)) * r5
              let y5 = cy + sin(rad(num(p5.az ?? 0) - 90)) * r5
              if p3.alt >= 0 && p0.alt >= 0 { line(x3, y3, x0, y0, stroke: alpha(c_pri, 0.35), width: 1) }
              if p0.alt >= 0 && p4.alt >= 0 { line(x0, y0, x4, y4, stroke: alpha(c_pri, 0.35), width: 1) }
              if p0.alt >= 0 && p1.alt >= 0 { line(x0, y0, x1, y1, stroke: alpha(c_sec, 0.25), width: 1) }
              if p0.alt >= 0 && p5.alt >= 0 { line(x0, y0, x5, y5, stroke: alpha(c_sec, 0.25), width: 1) }
            }

            if compass_active {
              arc(cx, cy, max_r, time * 35 % 360, 35, fill: alpha(c_pri, 0.09))
              let sweep_angle = rad(time * 35 % 360 + 35)
              line(cx, cy, cx + sin(sweep_angle) * max_r, cy - cos(sweep_angle) * max_r, stroke: alpha(c_pri, 0.5), width: 1)
            }

            // Phone heading sweep line, FOV cone & 2D pitch reticle
            let head_rad = rad(phone_az - 90)
            let hx = cx + cos(head_rad) * max_r
            let hy = cy + sin(head_rad) * max_r
            let aim_r = max_r * clamp((90 - clamp(phone_alt, 0, 90)) / 90, 0, 1)
            let ax = cx + cos(head_rad) * aim_r
            let ay = cy + sin(head_rad) * aim_r

            arc(cx, cy, max_r, phone_az - 12, 24, fill: alpha(is_locked ? c_ok : c_pri, 0.16))
            line(cx, cy, hx, hy, stroke: is_locked ? c_ok : c_pri, width: 2)
            circle(ax, ay, 5, stroke: is_locked ? c_ok : c_sec, width: 1.5)

            // Plot all 15 celestial objects from active_targets
            for t, i in active_targets {
              if num(t.alt ?? -90) >= 0 {
              let t_alt = num(t.alt ?? 0)
              let t_az = num(t.az ?? 0)
              let r_frac = clamp((90 - clamp(t_alt, 0, 90)) / 90, 0, 1)
              let pr = max_r * r_frac
              let prad = rad(t_az - 90)
              let px = cx + cos(prad) * pr
              let py = cy + sin(prad) * pr
              let q_item = quests[i]
              let obj_col = is_cosmic ? (q_item.color ?? #79D9ED) : #FF3333
              if i == safe_idx {
                circle(px, py, 10, stroke: is_locked ? c_ok : c_sec, width: 2)
                circle(px, py, 4, fill: obj_col)
                if show_labels { text(q_item.name, px, py - 14, size: 10, color: is_locked ? c_ok : c_sec, align: center, bold: true, font: sans) }
              } else {
                circle(px, py, 3, fill: alpha(obj_col, 0.85))
                if show_labels { text(q_item.body, px, py - 9, size: 8, color: alpha(obj_col, 0.8), align: center, font: sans) }
              }
              }
            }
          }
        }

        Text { text: "Tap to switch target · drag to turn your heading"; fontSize: 10; color: c_muted; align: center }
        Row {
          fill: width
          gap: 6
          Text { text: show_guides ? "✓ Star paths" : "+ Star paths"; fontSize: 11; color: c_pri; background: c_card; padding: [8, 7]; radius: 10 * corners; weight: 1; align: center; onTap: { haptic(); show_guides = !show_guides } }
          Text { text: show_labels ? "✓ Labels" : "+ Labels"; fontSize: 11; color: c_pri; background: c_card; padding: [8, 7]; radius: 10 * corners; weight: 1; align: center; onTap: { haptic(); show_labels = !show_labels } }
        }

        // Guidance Banner (360-wrap logic + lock-on indicator)
        Text {
          text: !sky_ready ? "Manual simulator · sky data unavailable" : eff_alt < 0 ? "Target is below the horizon" : is_locked ? "✓ Simulated aim aligned in heading and elevation" : "Manual aim · " + (diff > 0 ? "right " : "left ") + str(round(abs(diff))) + "° · " + (alt_diff > 0 ? "up " : "down ") + str(round(abs(alt_diff))) + "°"
          font: sans
          fontSize: 13
          bold: true
          color: is_locked ? c_ok : c_sec
          align: center
          background: is_locked ? alpha(c_ok, 0.18) : c_card
          border: 1
          borderColor: is_locked ? c_ok : c_accent_border
          padding: [10, 8]
          radius: 10 * corners
          fill: width
        }

        // Star-Hopping & Cosmic Lore Card
        Column {
          gap: 5
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_border
          radius: 16 * corners

          Text {
            text: "✧ HOW TO SPOT " + upper(current_quest.name) + " (" + current_quest.con + ")"
            font: sans
            fontSize: 11
            bold: true
            color: c_sec
          }

          Text {
            text: "▸ Hop: " + current_quest.hop
            font: sans
            fontSize: 11
            color: c_text
          }

          Text {
            text: "✦ Lore: " + current_quest.lore
            font: sans
            fontSize: 11
            color: c_muted
          }
        }

        // Sky Time-Machine & Heading Simulator Controls
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_border
          radius: 16 * corners

          Row {
            fill: width
            align: center
            gap: 6

            Text {
              text: "Sky time · " + sky_time + (safe_hr == 0 ? "" : " (+" + str(safe_hr) + "h)")
              font: sans
              fontSize: 11
              bold: true
              color: c_sec
              weight: 1
            }

            Text {
              text: "NOW"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [6, 3]
              radius: 10 * corners
              onTap: {
                haptic()
                time_offset_hrs = 0
              }
            }

            Text {
              text: "+3h"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [6, 3]
              radius: 10 * corners
              onTap: {
                haptic()
                time_offset_hrs = safe_hr >= 12 ? 0 : min(12, safe_hr + 3)
              }
            }
          }

          Slider {
            value: time_offset_hrs
            min: 0
            max: 12
            step: 1
            live: true
            color: c_sec
            track: alpha(c_sec, 0.25)
            onChange: {
              time_offset_hrs = int(round(value))
            }
          }

          Row {
            fill: width
            align: center
            gap: 6

            Text {
              text: "Manual heading: " + str(round(phone_az, 1)) + "°"
              font: sans
              fontSize: 11
              color: c_text
              weight: 1
            }

            Text {
              text: "-10°"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [6, 3]
              radius: 10 * corners
              onTap: {
                haptic()
                phone_az = round((phone_az - 10 + 360) % 360, 1)
              }
            }

            Text {
              text: "+10°"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [6, 3]
              radius: 10 * corners
              onTap: {
                haptic()
                phone_az = round((phone_az + 10) % 360, 1)
              }
            }

            Text {
              text: "Aim here"
              font: sans
              fontSize: 11
              bold: true
              color: c_ok
              border: 1
              borderColor: c_ok
              padding: [6, 3]
              radius: 10 * corners
              onTap: {
                haptic()
                if sky_ready && eff_alt >= 0 {
                  phone_az = round(eff_az, 1)
                  phone_alt = clamp(round(eff_alt, 1), 0, 90)
                }
              }
            }
          }

          Slider {
            value: phone_az
            min: 0
            max: 360
            step: 1
            live: true
            color: c_pri
            track: alpha(c_pri, 0.25)
            onChange: {
              phone_az = round(value, 1)
            }
          }
          Text { text: "Manual elevation: " + str(round(phone_alt)) + "°"; fontSize: 11; color: c_text }
          Slider { value: phone_alt; min: 0; max: 90; step: 1; live: true; color: c_sec; track: alpha(c_sec, 0.25); onChange: phone_alt = round(value, 1) }

        }

        // Action Buttons Row
        Row {
          gap: 8
          fill: width

          Text {
            text: compass_active ? "◼ Stop scan" : "◎ Start scan"
            font: sans
            fontSize: 13
            bold: true
            color: c_pri
            align: center
            background: compass_active ? alpha(c_pri, 0.18) : c_card
            border: 1
            borderColor: c_accent_border
            padding: [10, 8]
            radius: 10 * corners
            weight: 1
            onTap: {
              haptic()
              compass_active = !compass_active
            }
          }

          Text {
            text: safe_hr > 0 ? "Preview only" : !sky_ready || eff_alt < 0 ? "Target unavailable" : target_done ? "✓ Log observation" : "✦ Log discovery · +100 XP"
            font: sans
            fontSize: 13
            bold: true
            color: c_ok
            align: center
            background: c_card
            border: 1
            borderColor: c_ok
            padding: [10, 8]
            radius: 10 * corners
            weight: 1
            onTap: {
              haptic()
              if safe_hr == 0 && sky_ready && eff_alt >= 0 {
                let logged_id = current_quest.id
                let logged_name = current_quest.name
                let was_found = contains(found_quests, logged_id)
                let today = fmtTime(now, "yyyy-MM-dd")
                let midnight = parseTime(today)
                let yesterday = fmtTime(midnight - 1, "yyyy-MM-dd")
                if today != null && midnight != null && last_found_date != today {
                  streak_days = last_found_date == yesterday ? max(0, int(streak_days)) + 1 : 1
                  last_found_date = today
                }
                if !was_found {
                  found_quests = unique(flatten([found_quests, [logged_id]]))
                  total_found = count(quests, q => contains(found_quests, q.id))
                  bonus_xp = max(0, int(bonus_xp)) + 25
                }
                celebrate_msg = was_found ? "✓ Observation logged · " + logged_name : "✦ Discovered " + logged_name + " · +100 XP +25 horizon bonus"
                quest_idx = (safe_idx + 1) % len(quests)
                compass_active = false
              } else {
                celebrate_msg = safe_hr > 0 ? "Return to NOW to log a real observation" : "Choose a target currently above the horizon with fresh sky data"
              }
            }
          }
        }

        // Quick 3-Column Target Grid on Radar Tab
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_border
          radius: 16 * corners

          Text {
            text: "Targets · green = above horizon at " + sky_time
            font: sans
            fontSize: 11
            bold: true
            color: c_sec
            align: center
            fill: width
          }

          Grid {
            columns: 3
            gap: 6
            fill: width

            for q, i in quests key q.id {
              let is_sel = i == safe_idx
              let is_done = contains(found_quests, q.id)
              let q_pos = active_targets[i]
              let is_up = num(q_pos.alt ?? -10) >= 0
              Text {
                text: (is_done ? "✓ " : is_up ? "● " : "") + q.name
                font: sans
                fontSize: 11
                bold: is_sel
                color: is_sel ? c_pri : is_done ? c_ok : c_text
                align: center
                background: is_sel ? alpha(c_pri, 0.22) : c_bg
                border: 1
                borderColor: is_sel ? c_accent_border : alpha(c_pri, 0.35)
                padding: [4, 6]
                radius: 10 * corners
                maxLines: 1
                onTap: {
                  haptic()
                  quest_idx = i
                }
              }
            }
          }
        }
      }

      if screen_tab == "quests" {
        Text { text: "Visibility at " + sky_time; fontSize: 10; color: c_muted; align: center }
        // Logbook & Badges Summary Card
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners

          Text {
            text: "Streak: " + str(streak_days) + " Nights  | Found: [" + build_ascii_progress_bar + "] " + str(clamped_found) + "/15"
            font: sans
            fontSize: 12
            bold: true
            color: c_sec
          }

          // Unlockable Badges Row
          Row {
            gap: 6
            fill: width

            Text {
              text: (clamped_found >= 1 ? "✦" : "○") + " First Light"
              font: sans
              fontSize: 10
              bold: clamped_found >= 1
              color: clamped_found >= 1 ? c_ok : c_muted
              align: center
              border: 1
              borderColor: clamped_found >= 1 ? c_ok : c_border
              padding: [4, 4]
              radius: 10 * corners
              weight: 1
            }

            Text {
              text: (clamped_found >= 5 ? "✦" : "○") + " Hunter (5)"
              font: sans
              fontSize: 10
              bold: clamped_found >= 5
              color: clamped_found >= 5 ? c_ok : c_muted
              align: center
              border: 1
              borderColor: clamped_found >= 5 ? c_ok : c_border
              padding: [4, 4]
              radius: 10 * corners
              weight: 1
            }

            Text {
              text: (clamped_found >= 15 ? "✦" : "○") + " Master (15)"
              font: sans
              fontSize: 10
              bold: clamped_found >= 15
              color: clamped_found >= 15 ? c_sec : c_muted
              align: center
              border: 1
              borderColor: clamped_found >= 15 ? c_sec : c_border
              padding: [4, 4]
              radius: 10 * corners
              weight: 1
            }
          }

          // Filter Chips Row
          Row {
            gap: 6
            fill: width

            Text {
              text: "ALL (15)"
              font: sans
              fontSize: 11
              bold: quest_filter == "all"
              color: quest_filter == "all" ? c_pri : c_muted
              align: center
              background: quest_filter == "all" ? alpha(c_pri, 0.18) : c_bg
              border: 1
              borderColor: quest_filter == "all" ? c_accent_border : c_border
              padding: [6, 4]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quest_filter = "all"
              }
            }

            Text {
              text: "UP (" + str(visible_count) + ")"
              font: sans
              fontSize: 11
              bold: quest_filter == "up"
              color: quest_filter == "up" ? c_ok : c_muted
              align: center
              background: quest_filter == "up" ? alpha(c_ok, 0.18) : c_bg
              border: 1
              borderColor: quest_filter == "up" ? c_ok : c_border
              padding: [6, 4]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quest_filter = "up"
              }
            }

            Text {
              text: "UNFOUND"
              font: sans
              fontSize: 11
              bold: quest_filter == "todo"
              color: quest_filter == "todo" ? c_sec : c_muted
              align: center
              background: quest_filter == "todo" ? alpha(c_sec, 0.18) : c_bg
              border: 1
              borderColor: quest_filter == "todo" ? c_sec : c_border
              padding: [6, 4]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quest_filter = "todo"
              }
            }
          }

          Row {
            gap: 8
            fill: width

            Text {
              text: "[ ↻ REFRESH TELEMETRY ]"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              align: center
              border: 1
              borderColor: c_accent_border
              padding: [8, 5]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                refresh()
              }
            }

            Text {
              text: confirm_reset ? "[ ! TAP TO CONFIRM RESET ]" : "[ ✕ RESET LOGBOOK ]"
              font: sans
              fontSize: 11
              bold: true
              color: #FF3333
              align: center
              background: confirm_reset ? alpha(#FF3333, 0.2) : c_bg
              border: 1
              borderColor: #FF3333
              padding: [8, 5]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                if confirm_reset && reset_ends_at > now {
                  found_quests = []
                  total_found = 0
                  streak_days = 0
                  bonus_xp = 0
                  quiz_solved = []
                  quiz_idx = 0
                  quiz_streak = 0
                  quiz_picked = -1
                  quiz_feedback = ""
                  celebrate_msg = ""
                  time_offset_hrs = 0
                  compass_active = false
                  reset_ends_at = 0
                  last_found_date = ""
                  quest_idx = 0
                  confirm_reset = false
                } else {
                  confirm_reset = true
                  reset_ends_at = int(now + 5)
                }
              }
            }
          }
        }

        // Interactive 15-Quest Selector List with Star-Hopping Hints
        for q, i in quests key q.id {
          let is_found = contains(found_quests, q.id)
          let is_selected = i == safe_idx
          let q_coords = active_targets[i]
          let q_az = round(num(q_coords.az), 1)
          let q_alt = round(num(q_coords.alt ?? -90), 1)
          let show_row = quest_filter == "all" || (quest_filter == "up" && q_alt >= 0) || (quest_filter == "todo" && !is_found)

          if show_row {
            Column {
              gap: 4
              fill: width
              padding: [10, 8]
              background: is_selected ? alpha(c_pri, 0.16) : c_card
              border: 1
              borderColor: is_selected ? c_accent_border : c_border
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = i
                screen_tab = "radar"
              }

              Row {
                gap: 8
                align: center
                fill: width

                Text {
                  text: (is_found ? "[✓] " : "[ ] ") + pad(str(i + 1), 2, "0") + ". " + q.name + " (" + q.con + ")"
                  font: sans
                  fontSize: 13
                  bold: true
                  color: is_found ? c_ok : (is_cosmic ? q.color : #FF3333)
                  weight: 1
                }

                Text {
                  text: !sky_ready ? "Unavailable" : (q_alt >= 0 ? "● " : "○ ") + "Az " + str(q_az) + "° · Alt " + str(q_alt) + "°"
                  font: sans
                  fontSize: 11
                  color: q_alt >= 0 ? c_ok : c_muted
                }
              }

              Text {
                text: "↳ " + q.hop
                font: sans
                fontSize: 11
                color: c_muted
              }
            }
          }
        }
      }

      if screen_tab == "quiz" {
        let cur_q = quiz_bank[safe_quiz_idx]

        Column {
          gap: 10
          padding: 12
          fill: width
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners

          Row {
            fill: width
            align: center

            Text {
              text: "✧ STARGAZER ACADEMY QUIZ (" + str(clamp(int(quiz_idx), 0, len(quiz_bank) - 1) + 1) + "/" + str(len(quiz_bank)) + ")"
              font: sans
              fontSize: 12
              bold: true
              color: c_sec
              weight: 1
            }

            Text {
              text: "Streak: " + str(quiz_streak) + " "
              font: sans
              fontSize: 12
              bold: true
              color: c_ok
            }
          }

          Text {
            text: cur_q.q
            font: sans
            fontSize: 14
            bold: true
            color: c_text
          }

          for opt, oi in cur_q.opts {
            let is_correct = oi == cur_q.ans
            let is_picked = quiz_picked == oi
            Text {
              text: (is_picked ? (is_correct ? "[ ✓ ] " : "[ ✕ ] ") : "[ " + str(oi + 1) + " ] ") + opt
              font: sans
              fontSize: 13
              bold: is_picked
              color: is_picked ? (is_correct ? c_ok : #FF3333) : c_text
              background: is_picked ? alpha(is_correct ? c_ok : #FF3333, 0.18) : c_bg
              border: 1
              borderColor: is_picked ? (is_correct ? c_ok : #FF3333) : c_border
              padding: [10, 8]
              radius: 10 * corners
              fill: width
              onTap: {
                haptic()
                if quiz_picked == -1 {
                quiz_picked = oi
                if oi == cur_q.ans {
                  if !contains(quiz_solved, safe_quiz_idx) {
                    bonus_xp = max(0, int(bonus_xp)) + 50
                    quiz_streak = max(0, int(quiz_streak)) + 1
                    quiz_solved = unique(flatten([quiz_solved, [safe_quiz_idx]]))
                    quiz_feedback = "✓ Correct! +50 XP · " + cur_q.tip
                  } else {
                    quiz_feedback = "✓ Correct! Already mastered · " + cur_q.tip
                  }
                } else {
                  quiz_streak = 0
                  quiz_feedback = "✕ Not quite! Hint: " + cur_q.tip
                }
                }
              }
            }
          }

          if quiz_feedback != "" {
            Text {
              text: quiz_feedback
              font: sans
              fontSize: 12
              color: quiz_picked == cur_q.ans ? c_ok : c_sec
              background: alpha(c_pri, 0.12)
              border: 1
              borderColor: c_accent_border
              padding: 8
              radius: 10 * corners
              fill: width
            }
          }

          Row {
            gap: 8
            fill: width

            Text {
              text: "↻ Random"
              font: sans
              fontSize: 12
              bold: true
              color: c_pri
              align: center
              border: 1
              borderColor: c_accent_border
              padding: [10, 8]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quiz_idx = random(len(quiz_bank))
                quiz_picked = -1
                quiz_feedback = ""
              }
            }

            Text {
              text: "Next question ›"
              font: sans
              fontSize: 12
              bold: true
              color: c_sec
              align: center
              border: 1
              borderColor: c_sec
              padding: [10, 8]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quiz_idx = (safe_quiz_idx + 1) % len(quiz_bank)
                quiz_picked = -1
                quiz_feedback = ""
              }
            }
          }
        }
      }
      }
    }
  }
}
