      conditionsSummary: (preview, sunAlt, wEnabled, clouds) => (preview ? "Vista previa · " : "") + (sunAlt >= 0 ? "De día (Sol +${round(sunAlt)}°)" : sunAlt > -6 ? "Crepúsculo civil (Sol ${round(sunAlt)}°)" : sunAlt > -12 ? "Crepúsculo náutico (Sol ${round(sunAlt)}°)" : sunAlt > -18 ? "Crepúsculo astro (Sol ${round(sunAlt)}°)" : "Noche oscura (Sol ${round(sunAlt)}°)") + (preview || !wEnabled || clouds == null ? "" : " · Nubes ${round(clouds)}%")
      bestToast: (ready, sunAlt, idx, name, clouds) => !ready ? "Calculando cielo…" : sunAlt == null || sunAlt >= 0 ? "De día · Mostrando planificador nocturno" : idx == null ? "Sin objeto brillante ≥20° ahora" : "Activo: ${name}" + (clouds != null && clouds >= 70 ? " · ${round(clouds)}% nubes" : "")
      loggedToast: name => "✓ Observación de ${name} guardada"
