widget "spacex" {
  size: 3x4
  minSize: 3x3
  meta {
    description: "Upcoming SpaceX launches, booster landings, dockings and splashdowns, with the X live feed when a webcast is on."
    version: "1.0"
    license: "MIT"
    category: "world"
    owl: 5
  }

  // Launch Library 2. Detailed launches include the official X broadcast link (list mode leaves it out).
  // No shell tools: http only, so the tile also works before Linux is installed.
  source now = clock every 1s
  source launches = http("https://ll.thespacedevs.com/2.2.0/launch/upcoming/?search=SpaceX&limit=5&mode=detailed&format=json") every 20m json timeout 20s status
  source events = http("https://ll.thespacedevs.com/2.2.0/event/upcoming/?search=SpaceX&limit=8&format=json") every 20m json timeout 20s status

  // ISO-8601 UTC to Unix seconds. The launcher has fmtTime but no parser.
  let unix = iso => iso == null || iso == "" ? null : [match(str(iso), "(\\d+)-(\\d+)-(\\d+)T(\\d+):(\\d+):(\\d+)")].map(g => g == null ? null : {
    y: floor(num(g[0])) - (floor(num(g[1])) <= 2 ? 1 : 0),
    m: floor(num(g[1])),
    d: floor(num(g[2])),
    h: floor(num(g[3])),
    mi: floor(num(g[4])),
    s: floor(num(g[5]))
  }).map(p => p == null ? null : {
    era: floor((p.y >= 0 ? p.y : p.y - 399) / 400),
    y: p.y, m: p.m, d: p.d, h: p.h, mi: p.mi, s: p.s
  }).map(p => p == null ? null : {
    yoe: p.y - p.era * 400,
    doy: floor((153 * (p.m + (p.m > 2 ? -3 : 9)) + 2) / 5) + p.d - 1,
    era: p.era, h: p.h, mi: p.mi, s: p.s
  }).map(p => p == null ? null : {
    days: p.era * 146097 + (p.yoe * 365 + floor(p.yoe / 4) - floor(p.yoe / 100) + p.doy) - 719468,
    h: p.h, mi: p.mi, s: p.s
  }).map(p => p == null ? null : p.days * 86400 + p.h * 3600 + p.mi * 60 + p.s)[0]

  // Timeline offsets look like PT8M23S, PT1H1M57S, -PT35M or P0D.
  let dur = rel => rel == null || rel == "P0D" ? 0 : [rel].map(rel => {
    sign: startsWith(rel, "-") ? -1 : 1,
    body: startsWith(rel, "-PT") ? sub(rel, 3, len(rel)) : startsWith(rel, "PT") ? sub(rel, 2, len(rel)) : rel
  }).map(p => p.sign * (
    (match(p.body, "(\\d+)H") != null ? num(match(p.body, "(\\d+)H")[0]) * 3600 : 0) +
    (match(p.body, "(\\d+)M") != null ? num(match(p.body, "(\\d+)M")[0]) * 60 : 0) +
    (match(p.body, "(\\d+)S") != null ? num(match(p.body, "(\\d+)S")[0]) : 0)
  ))[0]

  let xCast = urls => ((urls ?? []).filter(v => contains(v.url ?? "", "x.com/") || contains(v.url ?? "", "twitter.com/")))
    .sortBy(v => v.type.name == "Official Webcast" ? 0 : 1).first()
  let preciseOf = n => n == "Second" || n == "Minute" || n == "Hour"
  let missionOf = name => split(split(name ?? "", " | ").last() ?? "", " (")[0]
  let kindOf = n => n == "Press Event" ? "briefing" : n == "Static Fire" ? "static fire" : lower(n ?? "event")
  let leadOf = k => k == "docking" || k == "undocking" ? 90 * 60 : k == "splashdown" || k == "reentry" || k == "landing" ? 60 * 60 : k == "return" ? 5 * 60 : k == "briefing" ? 20 * 60 : 30 * 60
  let tailOf = k => k == "launch" ? 20 * 60 : k == "return" ? 8 * 60 : k == "docking" || k == "undocking" ? 40 * 60 : k == "splashdown" || k == "landing" || k == "reentry" ? 30 * 60 : k == "briefing" ? 70 * 60 : 30 * 60
  let tone = s => s == "Go" || s == "Success" ? green : s == "TBD" || s == "TBC" ? yellow : s == "Failure" || s == "Hold" ? red : s == "In Flight" ? orange : muted
  let away = s => s >= 86400 ? "${floor(s / 86400)}d ${floor((s % 86400) / 3600)}h" : s >= 3600 ? "${floor(s / 3600)}h ${pad(floor((s % 3600) / 60), 2, "0")}m" : s >= 600 ? "${floor(s / 60)}m" : s >= 60 ? "${floor(s / 60)}m ${pad(floor(s % 60), 2, "0")}s" : "${max(floor(s), 0)}s"
  let placeOf = s => trim(replace(replace(replace(split(s ?? "", ",")[0] ?? "", " SFB", ""), " SFS", ""), " AFB", ""))

  let ready = launches != null && events != null
  let launchRows = ready && launches.ok ? launches.out.results ?? [] : []
  let eventRows = ready && events.ok ? events.out.results ?? [] : []

  // One launch, plus a booster-return row when a landing is planned (about T+8m).
  let fromLaunch = launch => [launch].map(launch => {
    cast: [launch.vidURLs ?? launch.vid_urls].map(xCast)[0],
    at: [launch.net].map(unix)[0],
    prec: launch.net_precision.name ?? "",
    land: (launch.timeline ?? []).filter(t => contains(t.type.abbrev ?? "", "Landing") && !contains(t.type.abbrev ?? "", "Burn")).last().relative_time,
    vehicle: launch.rocket.configuration.name ?? "",
    place: [launch.pad.location.name ?? ""].map(placeOf)[0],
    mission: [launch.name].map(missionOf)[0],
    status: launch.status.abbrev ?? "",
    id: launch.id,
    webcast: launch.webcast_live == true,
    stages: launch.rocket.launcher_stage ?? []
  }).map(f => {
    precise: [f.prec].map(preciseOf)[0],
    off: f.land != null ? [f.land].map(dur)[0] : 510,
    x: f.cast.url,
    xStart: [f.cast.start_time].map(unix)[0],
    xEnd: [f.cast.end_time].map(unix)[0],
    at: f.at, prec: f.prec, vehicle: f.vehicle, place: f.place, mission: f.mission,
    status: f.status, id: f.id, webcast: f.webcast, stages: f.stages
  }).map(f => [{
    id: f.id,
    kind: "launch",
    title: f.mission ?? "launch",
    vehicle: f.vehicle,
    place: f.place,
    status: f.status,
    at: f.at,
    precise: f.precise,
    prec: f.prec,
    lead: ["launch"].map(leadOf)[0],
    tail: ["launch"].map(tailOf)[0],
    x: f.x,
    xStart: f.xStart,
    xEnd: f.xEnd,
    webcast: f.webcast
  }] + f.stages.filter(s => f.precise && s.landing.attempt == true && f.off > 60 && !contains(lower(s.launcher.serial_number ?? "unknown"), "unknown")).map(s => {
    id: "${f.id}-${s.launcher.serial_number ?? s.id}",
    kind: "return",
    title: s.launcher.serial_number ?? "booster",
    vehicle: s.landing.type.abbrev ?? "booster",
    place: s.landing.location.abbrev ?? s.landing.location.name ?? "landing zone",
    status: f.status,
    at: f.at + f.off,
    precise: f.precise,
    prec: f.prec,
    lead: ["return"].map(leadOf)[0],
    tail: ["return"].map(tailOf)[0],
    x: f.x,
    xStart: null,
    xEnd: null,
    webcast: false
  }))[0]

  let fromEvent = ev => [ev].map(ev => {
    cast: [ev.vid_urls ?? ev.vidURLs].map(xCast)[0],
    kind: [ev.type.name].map(kindOf)[0],
    at: [ev.date].map(unix)[0],
    precise: [ev.date_precision.name ?? ""].map(preciseOf)[0],
    prec: ev.date_precision.name ?? ""
  }).map(f => {
    id: "event-${ev.id}",
    kind: f.kind,
    title: replace(ev.name ?? "event", "SpaceX ", ""),
    vehicle: "",
    place: [ev.location ?? ""].map(placeOf)[0],
    status: f.precise ? "Set" : "TBD",
    at: f.at,
    precise: f.precise,
    prec: f.prec,
    lead: [f.kind].map(leadOf)[0],
    tail: [f.kind].map(tailOf)[0],
    x: f.cast.url,
    xStart: [f.cast.start_time].map(unix)[0],
    xEnd: [f.cast.end_time].map(unix)[0],
    webcast: ev.webcast_live == true
  })[0]

  let raw = flatten((launchRows ?? []).filter(l => l.launch_service_provider.name == "SpaceX").map(fromLaunch))
    + (eventRows ?? []).filter(ev => contains(lower(ev.name ?? ""), "spacex") || contains(lower(ev.name ?? ""), "starship") || contains(lower(ev.name ?? ""), "falcon") || contains(lower(ev.name ?? ""), "dragon")).map(fromEvent)

  // The watch window opens when SpaceX's X broadcast does, otherwise a few minutes before the event.
  let items = raw.filter(e => e.at != null).map(e => [e].map(e => {
    announced: e.xStart != null && e.precise && e.xStart <= e.at && e.at - e.xStart < 3 * 3600 ? e.xStart : null
  }).map(w => {
    id: e.id, kind: e.kind, title: e.title, vehicle: e.vehicle, place: e.place, status: e.status,
    at: e.at, precise: e.precise, prec: e.prec, x: e.x, webcast: e.webcast,
    open: w.announced != null ? w.announced : e.at - e.lead,
    close: e.at + e.tail,
    link: e.x ?? "https://x.com/SpaceX"
  }).map(e => {
    id: e.id, kind: e.kind, title: e.title, vehicle: e.vehicle, place: e.place, status: e.status,
    at: e.at, precise: e.precise, prec: e.prec, open: e.open, close: e.close, link: e.link,
    live: e.precise && ((now >= e.open && now <= e.close) || (e.webcast && now >= e.open - 600 && now <= e.close)),
    detail: join([e.vehicle, e.place].filter(s => s != null && s != ""), " · "),
    when: !e.precise ? "tbd" : now >= e.at && now <= e.close ? "live" : e.at > now ? [e.at - now].map(away)[0] : "T+${[now - e.at].map(away)[0]}",
    clock: !e.precise ? (e.prec == "Month" || e.prec == "Quarter" || e.prec == "Year" ? lower(fmtTime(e.at, "MMMM yyyy")) : "no earlier than ${lower(fmtTime(e.at, "d MMM yyyy"))}") : lower(fmtTime(e.at, "EEE d MMM · HH:mm")),
    feed: e.precise && e.x != null ? lower(fmtTime(e.open, "HH:mm")) : "",
    hint: !e.precise ? "live on X once a time is set" : now >= e.open && now <= e.close ? "live on X" : "on X from ${lower(fmtTime(e.open, "EEE HH:mm"))}",
    urgency: !e.precise ? muted : now >= e.at && now <= e.close ? red : e.at - now < 3600 ? orange : e.at - now < 6 * 3600 ? accent : foreground
  })[0]).filter(e => e.precise ? e.close >= now : e.at >= now - 86400).sortBy(e => e.at)

  let hero = items.first()
  let extraN = rows != null && rows < 4 ? 0 : clamp(rows == null ? 2 : rows - 2, 1, 4)
  let upcoming = items.drop(1).take(extraN)
  let offline = ready && launches.ok != true && events.ok != true

  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Activity(kind, title, when, detail, clock, live, link, tint) {
    Column {
      gap: 1
      padding: [0, 8]
      Row {
        gap: 8
        align: center
        Text { text: kind; style: label; color: accent; width: 78; maxLines: 1 }
        Column {
          gap: 0
          weight: 1
          Text { text: title; maxLines: 2 }
          Text { text: detail; style: small; color: muted; maxLines: 1 }
        }
        Text { text: when; style: small; color: tint; width: 72; align: end; maxLines: 1 }
      }
      Text { text: clock; style: small; color: muted; maxLines: 1 }
      if live {
        Button { text: "watch on X"; fill: width; onTap: url(link) }
      }
    }
  }

  Column {
    gap: 2
    if !ready {
      Text { text: "spacex"; style: label; color: accent }
      Spacer { weight: 1 }
      Text { text: "…"; style: title }
      Spacer { weight: 1 }
    } else if hero == null {
      Text { text: "spacex"; style: label; color: accent }
      Spacer { weight: 1 }
      Text { text: offline ? "schedule offline" : "nothing scheduled"; style: body; color: muted }
      Spacer { weight: 1 }
    } else {
      Row {
        align: center
        Text { text: "spacex"; style: label; color: accent; weight: 1; maxLines: 1 }
        Text { text: lower(hero.status); style: label; color: [hero.status].map(tone)[0]; width: 64; align: end; maxLines: 1 }
      }
      Text { text: hero.when; fontSize: 30; color: hero.urgency; maxLines: 1 }
      Text { text: hero.title; style: title; maxLines: 2 }
      Text { text: "${hero.kind}${hero.place != "" ? " · " + hero.place : ""}"; style: small; color: muted; maxLines: 1 }
      Text { text: hero.clock; style: small; color: muted; maxLines: 1 }
      if hero.live {
        Spacer { height: 4 }
        Button { text: "watch on X"; fill: width; onTap: url(hero.link) }
      } else {
        Text { text: hero.hint; style: small; color: muted; maxLines: 1 }
      }
      Spacer { weight: 1 }
      if len(upcoming) > 0 {
        Rule { }
        Spacer { height: 6 }
        for e in upcoming key e.id {
          Column {
            gap: 0
            padding: [0, 2]
            Row {
              align: center
              Text { text: e.kind; style: label; color: muted; weight: 1; maxLines: 1 }
              Text { text: e.when; style: small; color: e.urgency; width: 68; align: end; maxLines: 1 }
            }
            Text { text: e.kind == "return" ? "${e.title} · ${e.place}" : e.title; style: small; maxLines: 1 }
          }
        }
      }
    }
  }

  screen {
    title: "spacex"
    Column {
      scroll: true
      gap: 0
      Text { text: "launches, landings and returns"; style: label; color: muted }
      Spacer { height: 8 }
      if !ready {
        Text { text: "…"; style: title }
      } else if hero == null {
        Text { text: offline ? "schedule offline" : "nothing scheduled"; color: muted }
      } else {
        if items.any(e => e.live) {
          let on = items.find(e => e.live)
          Button { text: "watch ${on.kind} on X"; fill: width; onTap: url(on.link) }
          Text { text: on.title; style: small; color: muted; maxLines: 1 }
          Spacer { height: 8 }
        }
        for e, i in items.take(12) key e.id {
          if i > 0 { Rule { } }
          Activity {
            kind: e.kind
            title: e.title
            when: e.when
            detail: e.detail
            clock: e.feed != "" ? "${e.clock} · X ${e.feed}" : e.clock
            live: e.live
            link: e.link
            tint: e.urgency
          }
        }
        Spacer { height: 12 }
        Text { text: "times are local · launch library · webcasts on X"; style: small; color: muted; maxLines: 2 }
      }
    }
  }
}
