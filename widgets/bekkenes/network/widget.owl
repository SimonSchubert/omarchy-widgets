widget "network" {
  size: 3x4
  minSize: 3x3
  padding: 12

  meta {
    description: "Live connection type (wifi, mobile, VPN) and internet latency to 1.1.1.1, with a sparkline and today's loss and round-trip stats"
    version: "1.1"
    license: "MIT"
    category: "system"
    owl: 10
  }

  requires { pacman: ["iproute2", "iputils"] }

  // One line per sample: "<unix time> <rtt in ms, or -1>". The epoch changes
  // every sample, so `on probe` runs even when two pings fail in a row.
  source probe = cmd('t=$(date +%s); r=$(ping -c 1 -W 1 1.1.1.1 2>/dev/null | sed -n "s/.*time=\([0-9.]*\) ms.*/\1/p"); echo "$t ${r:--1}"') every 10s
  source links = cmd("ip -j link") every 10s json

  state todayKey = "" persist
  state todaySamples = 0 persist
  state todayFails = 0 persist
  state todaySum = 0 persist

  let ifaces = links ?? []
  let wifiUp = any(ifaces, i => startsWith(i.ifname, "wlan") && indexOf(i.flags, "LOWER_UP") >= 0)
  let mobileUp = any(ifaces, i => (startsWith(i.ifname, "rmnet") || startsWith(i.ifname, "ccmni")) && indexOf(i.flags, "LOWER_UP") >= 0)
  let vpnUp = any(ifaces, i => (startsWith(i.ifname, "tun") || startsWith(i.ifname, "wg")) && indexOf(i.flags, "LOWER_UP") >= 0)
  let netType = wifiUp ? "wifi" : mobileUp ? "mobile" : vpnUp ? "vpn" : "offline"

  let rtt = probe == null ? null : num(words(probe)[1])
  let online = rtt != null && rtt > 0
  let connLabel = netType == "offline" ? (online ? "online" : "offline") : netType
  let statusLabel = probe == null ? "checking" : online ? connLabel : netType == "offline" ? "offline" : "${netType} · no net"

  let tint = probe == null ? muted : online ? (rtt < 60 ? green : rtt < 150 ? yellow : red) : red
  let iconTint = probe == null ? muted : online ? tint : red
  let rttText = probe == null ? "…" : online ? "${round(rtt)}" : "off"

  let chartRtt = online ? rtt : 0
  let hist = history(chartRtt, 90)
  let histMax = reduce(hist, (acc, v) => max(acc, v), 0)
  let histMin = reduce(hist, (acc, v) => v > 0 ? (acc == 0 ? v : min(acc, v)) : acc, 0)
  let scaleMax = max(40, histMax * 1.2)

  let dayOk = todaySamples - todayFails
  let upPct = todaySamples > 0 ? dayOk / todaySamples * 100 : null
  let avgRtt = dayOk > 0 ? todaySum / dayOk : null
  let lossPct = todaySamples > 0 ? todayFails / todaySamples * 100 : null
  let upText = upPct == null ? "—" : "${round(upPct)}%"
  let avgText = avgRtt == null ? "—" : "${round(avgRtt)} ms"
  let lossText = lossPct == null ? "—" : "${fixed(lossPct, 1)}%"
  let rangeText = histMax > 0 ? "${round(histMin)}–${round(histMax)} ms" : "—"
  let sampleText = todaySamples == 0 ? "0" : fmtNum(todaySamples, {compact: true})
  let upColor = upPct == null ? muted : upPct >= 99 ? green : upPct >= 95 ? yellow : red
  let lossColor = lossPct == null ? muted : lossPct < 1 ? green : lossPct < 5 ? yellow : red
  // A wide, short tile (the landscape home screen) puts the sparkline beside the number instead of below it.
  let wide = tileWidth != null && tileHeight != null && tileWidth > tileHeight * 1.3
  let shownIfaces = ifaces.filter(i => i.ifname != "lo" && i.ifname != "dummy0" && !startsWith(i.ifname, "epdg") && indexOf(i.flags, "LOWER_UP") >= 0)

  // Everything is kept per local date; the first sample after midnight starts over.
  on probe first {
    if probe != null {
      let stamp = num(words(probe)[0])
      let val = num(words(probe)[1])
      let dat = fmtTime(stamp, "yyyy-MM-dd")
      if todayKey != dat {
        todayKey = dat
        todaySamples = 0
        todayFails = 0
        todaySum = 0
      }
      todaySamples = todaySamples + 1
      if val > 0 {
        todaySum = todaySum + val
      } else {
        todayFails = todayFails + 1
      }
    }
  }

  onTap: screen()

  component Stat(label, value, tint = foreground) {
    Column {
      gap: 1
      Text { text: label; style: label; color: muted }
      Text { text: value; style: title; color: tint; maxLines: 1 }
    }
  }

  component NetIcon(kind, tint, size = 24) {
    Box {
      width: size
      height: size
      Canvas {
        visible: kind == "wifi"
        width: size
        height: size
        let c = size / 2
        let b = size - size * 0.16
        arc(c, b, size * 0.15, 315, 90, stroke: tint, width: max(1.5, size / 12), cap: round)
        arc(c, b, size * 0.30, 315, 90, stroke: tint, width: max(1.5, size / 12), cap: round)
        arc(c, b, size * 0.45, 315, 90, stroke: tint, width: max(1.5, size / 12), cap: round)
        circle(c, b, max(1.2, size / 16), fill: tint)
      }
      Canvas {
        visible: kind == "mobile"
        width: size
        height: size
        for i in range(4) {
          rect(size * (0.08 + i * 0.24), size * 0.68 - i * size * 0.14, size * 0.13, size * 0.14 + i * size * 0.14, radius: size * 0.04, fill: tint)
        }
      }
      Canvas {
        visible: kind == "vpn"
        width: size
        height: size
        rect(size * 0.20, size * 0.44, size * 0.60, size * 0.40, radius: size * 0.12, stroke: tint, width: max(1.5, size / 12))
        arc(size * 0.5, size * 0.44, size * 0.18, 270, 180, stroke: tint, width: max(1.5, size / 12), cap: round)
        circle(size * 0.5, size * 0.64, size * 0.06, fill: tint)
      }
      Canvas {
        visible: kind == "offline"
        width: size
        height: size
        let c = size / 2
        let b = size - size * 0.16
        arc(c, b, size * 0.15, 315, 90, stroke: muted, width: max(1.5, size / 12), cap: round)
        arc(c, b, size * 0.30, 315, 90, stroke: muted, width: max(1.5, size / 12), cap: round)
        arc(c, b, size * 0.45, 315, 90, stroke: muted, width: max(1.5, size / 12), cap: round)
        circle(c, b, max(1.2, size / 16), fill: muted)
        line(size * 0.16, size * 0.16, size * 0.84, size * 0.84, stroke: red, width: max(1.5, size / 12), cap: round)
      }
    }
  }

  Column {
    gap: 6
    if wide {
      Row {
        gap: 10
        weight: 1
        Column {
          gap: 6
          width: 112
          Row {
            gap: 6
            align: center
            NetIcon { kind: netType; tint: iconTint; size: 22 }
            Text { text: statusLabel; style: small; color: iconTint; weight: 1; maxLines: 1 }
          }
          Row {
            gap: 4
            align: bottom
            Text { text: rttText; fontSize: online ? 46 : 34; fontWeight: 300; color: tint; maxLines: 1; animate color: tween(250ms) }
            Text { text: online ? "ms" : ""; style: muted; padding: [2, 0, 0, 8] }
          }
        }
        Sparkline {
          values: hist
          min: 0
          max: scaleMax
          color: tint
          area: alpha(tint, 0.18)
          thickness: 2
          fill: height
          weight: 1
        }
      }
    } else {
      Row {
        gap: 6
        align: center
        NetIcon { kind: netType; tint: iconTint; size: 22 }
        Text { text: statusLabel; style: small; color: iconTint; weight: 1; maxLines: 1 }
      }
      Row {
        gap: 4
        align: bottom
        Text { text: rttText; fontSize: online ? 46 : 34; fontWeight: 300; color: tint; maxLines: 1; animate color: tween(250ms) }
        Text { text: online ? "ms" : ""; style: muted; padding: [2, 0, 0, 8] }
      }
      Sparkline {
        values: hist
        min: 0
        max: scaleMax
        color: tint
        area: alpha(tint, 0.18)
        thickness: 2
        fill: width
        weight: 1
      }
    }
    Row {
      Text { text: "today"; style: label; color: muted; weight: 1 }
      Text { text: "loss ${lossText}"; style: label; color: lossColor }
    }
    Row {
      Text { text: "up ${upText}"; style: label; color: upColor; weight: 1 }
      Text { text: "avg ${avgText}"; style: label; color: muted }
    }
  }

  screen {
    title: "network"
    Column {
      scroll: true
      gap: 12
      padding: 16

      Row {
        gap: 12
        align: center
        NetIcon { kind: netType; tint: iconTint; size: 40 }
        Column {
          gap: 2
          weight: 1
          Text { text: statusLabel; style: title; color: iconTint; maxLines: 1 }
          Text { text: online ? "1.1.1.1 responds" : "no response from 1.1.1.1"; style: small; color: muted; maxLines: 1 }
        }
        Column {
          gap: 0
          align: end
          width: 132
          Text { text: rttText; fontSize: online ? 48 : 34; fontWeight: 300; color: tint; maxLines: 1; animate color: tween(250ms) }
          Text { text: online ? "ms now" : "offline"; style: label; color: muted; align: end }
        }
      }

      Column {
        gap: 6
        padding: 12
        background: alpha(surface, 0.55)
        border: 1
        borderColor: alpha(border, 0.8)
        radius: 14 * corners
        Row {
          Text { text: "latency"; style: small; color: muted; weight: 1 }
          Text { text: "recent samples · one ping every 10 s"; style: label; color: muted }
        }
        Sparkline {
          values: hist
          min: 0
          max: scaleMax
          color: tint
          area: alpha(tint, 0.20)
          thickness: 2
          fill: width
          height: 120
        }
        Row {
          Text { text: "0 ms"; style: label; color: muted; weight: 1 }
          Text { text: "${round(scaleMax)} ms"; style: label; color: muted }
        }
      }

      Column {
        gap: 10
        padding: 12
        background: alpha(surface, 0.55)
        border: 1
        borderColor: alpha(border, 0.8)
        radius: 14 * corners
        Row {
          gap: 8
          align: center
          Text { text: "today"; style: title; weight: 1 }
          Text { text: "resets at midnight"; style: label; color: muted }
          Button {
            text: "reset"
            onTap: {
              todayKey = online ? fmtTime(num(words(probe)[0]), "yyyy-MM-dd") : todayKey
              todaySamples = 0
              todayFails = 0
              todaySum = 0
            }
          }
        }
        Grid {
          columns: 2
          gap: 10
          Stat { label: "online"; value: upText; tint: upColor }
          Stat { label: "loss"; value: lossText; tint: lossColor }
          Stat { label: "average"; value: avgText }
          Stat { label: "recent min / max"; value: rangeText }
          Stat { label: "samples"; value: sampleText }
          Stat { label: "day"; value: todayKey == "" ? "—" : todayKey }
        }
      }

      Column {
        gap: 6
        padding: 12
        background: alpha(surface, 0.55)
        border: 1
        borderColor: alpha(border, 0.8)
        radius: 14 * corners
        Text { text: "interfaces"; style: small; color: muted }
        for i in shownIfaces key i.ifname {
          Row {
            gap: 8
            Text { text: i.ifname; style: small; weight: 1; maxLines: 1 }
            Text { text: i.operstate; style: label; color: indexOf(i.flags, "LOWER_UP") >= 0 ? green : muted }
            Text {
              text: startsWith(i.ifname, "wlan") ? "wifi" : startsWith(i.ifname, "rmnet") || startsWith(i.ifname, "ccmni") ? "mobile" : startsWith(i.ifname, "tun") || startsWith(i.ifname, "wg") ? "vpn" : "other"
              style: label
              color: muted
              width: 52
              align: end
            }
          }
        }
        if len(shownIfaces) == 0 {
          Text { text: "none up"; style: label; color: muted }
        }
      }

      Row {
        gap: 8
        Button { text: "refresh"; onTap: refresh() }
        Button { text: "close"; onTap: close() }
      }

      Text { text: "Daily stats are sampled every 10 s only while the tile is on screen or next to it."; style: label; color: muted }
    }
  }
}
