widget "verse" {
  size: 4x4
  minSize: 3x3

  meta {
    owl: 10
    description: "Now playing with synchronized lyrics from lrclib.net: cover art, track, artist, progress, controls, the line being sung, and a full-screen player."
    version: "1.11"
    license: "MIT"
    category: "media"
  }
  requires { pacman: [] }

  // {available, playing, title, artist, album, app, package, position, duration, art}
  // Android only shares other apps' sessions with notification access, so `available`
  // is false until the user grants it; `allowed` keeps the first frames quiet about that.
  source m = android.media

  // Android shares no embedded lyrics with the launcher, so they are looked up by artist
  // and title on lrclib.net (free, no account). A null URL pauses the lookup when idle.
  source lr = http(m.title != null && m.artist != null ? "https://lrclib.net/api/get?artist_name=${enc(m.artist)}&track_name=${enc(m.title)}" : null) every 30m json status

  let allowed = m == null || m.available != false
  let has = m != null && m.title != null
  let playing = m.playing == true
  let dur = num(m.duration, 0)
  let pos = dur > 0 ? clamp(num(m.position, 0), 0, dur) : num(m.position, 0)

  // The source app's icon sits in the artwork's top-right corner: small, on a translucent
  // plate so it reads against any cover.
  let chip = clamp((tileWidth ?? 232) * 0.11, 22, 32)

  // Room inside the tile's 12 dp padding. A tall tile has more height than width, so the
  // cover can show whole (square) and still leave a band above the controls. A tile wider
  // than tall instead puts the whole cover on the left and the words beside it.
  let innerW = (tileWidth ?? 232) - 24
  let innerH = (tileHeight ?? 232) - 24
  let controlsH = clamp(innerH * 0.2, 54, 200)
  let artMax = max(innerH - controlsH, 40)
  let fullArt = artMax >= innerW
  let artH = fullArt ? innerW : artMax
  let spare = fullArt ? artMax - innerW : 0
  let wide = tileWidth != null && tileHeight != null && tileWidth > tileHeight * 1.2
  // How many lines fit above and below the sung one in a tall tile's band.
  let around = spare >= 280 ? 4 : spare >= 150 ? 3 : spare >= 80 ? 2 : spare >= 50 ? 1 : 0
  // The same beside a wide tile's cover, where the room is the cover's height.
  let waround = artMax >= 340 ? 3 : artMax >= 230 ? 2 : artMax >= 100 ? 1 : 0
  // The buttons take more of their fifth when the tile has the room.
  let ctl = clamp(controlsH * 0.36, 30, 46)
  let ctlBig = ctl * 1.4
  let ctlGap = clamp(controlsH * 0.16, 8, 22)

  // LRC lines ("[mm:ss.xx] words"): every cue for the screen, the timed non-blank ones
  // for the tile, where the current line holds until the next one starts.
  let sync = lr != null && lr.ok ? lr.out.syncedLyrics : null
  let plain = lr != null && lr.ok ? lr.out.plainLyrics : null
  let gs = lines(sync ?? "").map(l => match(l, '^\[(\d+):(\d+)\.?(\d*)\]\s*(.*)$')).filter(g => g != null)
  let keep = gs.filter(g => trim(g[3]) != "")
  let kts = keep.map(g => num(g[0]) * 60 + num(g[1]) + (len(g[2]) == 0 ? 0 : num("0." + g[2])))
  let kls = keep.map(g => trim(g[3]))
  let ki = len(kts.filter(t => t <= pos)) - 1
  let lineNow = ki >= 0 ? kls[ki] : null
  // The line to keep in view before the first cue: the song's first words.
  let bi = max(ki, 0)

  // With no lyrics to fill a tall tile's band, the words move down there instead of
  // sitting on the cover and leaving the band empty. Waiting for the lookup avoids
  // a jump while lyrics are still on their way.
  let bareArt = fullArt && spare > 0 && len(kls) == 0 && lr != null

  // The screen's lyrics follow the song: a window with the sung line at its center.
  let winLines = 11
  let winFirst = clamp(bi - 5, 0, max(len(kls) - winLines, 0))


  component Time(s) {
    Text {
      // m:ss drops the hour: a 1:17:47 podcast showed as 17:47.
      text: s == null ? "" : fmtTime(round(s), round(s) >= 3600 ? "H:mm:ss" : "m:ss", "UTC")
      style: label
      color: muted
      font: mono
      maxLines: 1
    }
  }

  // The cover, or a soft gradient with a note when nothing is playing yet.
  // It fills the box it is put in, which decides how big the artwork is.
  component Cover(fit = "cover") {
    Box {
      fill: true
      if m.art != null {
        Image { src: m.art; fit: fit; fill: true }
      } else {
        Canvas {
          let s = min(width, height)
          rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(accent, 0.5), alpha(magenta, 0.28)]))
          text("♪", width / 2, height / 2, size: s * 0.3, align: center, color: alpha(foreground, 0.9))
        }
      }
    }
  }

  // A little record drawn over the cover's corner: it turns only while music plays.
  component Spin(d) {
    Box {
      size: d
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let r = min(width, height) / 2
        circle(cx, cy, r, fill: color0)
        circle(cx, cy, r, stroke: alpha(foreground, 0.22), width: 1)
        for i in range(3) { circle(cx, cy, r * (0.6 + i * 0.13), stroke: alpha(foreground, 0.1), width: 1) }
        if playing {
          rotate(time * 90, cx, cy) {
            arc(cx, cy, r * 0.86, 0, 55, stroke: alpha(accent, 0.95), width: max(1.5, r * 0.1), cap: round)
          }
        } else {
          arc(cx, cy, r * 0.86, 0, 55, stroke: alpha(muted, 0.7), width: max(1.5, r * 0.1), cap: round)
        }
        circle(cx, cy, r * 0.34, fill: alpha(accent, 0.9))
        circle(cx, cy, r * 0.08, fill: background)
      }
    }
  }

  // Drawn rather than glyphs: the launcher's icon font only carries weather symbols.
  component Control(kind, d = 30) {
    Box {
      size: d
      onTap: media(kind)
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let s = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, s / 2, fill: foreground)
          if playing {
            rect(cx - s * 0.16, cy - s * 0.19, s * 0.12, s * 0.38, radius: s * 0.04, fill: background)
            rect(cx + s * 0.04, cy - s * 0.19, s * 0.12, s * 0.38, radius: s * 0.04, fill: background)
          } else {
            // The triangle's centroid sits right of its box: nudge it so it looks centered.
            path([[cx - s * 0.13, cy - s * 0.21], [cx + s * 0.22, cy], [cx - s * 0.13, cy + s * 0.21]], closed: true, fill: background)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - s * 0.2 * dir, cy - s * 0.21], [cx + s * 0.09 * dir, cy], [cx - s * 0.2 * dir, cy + s * 0.21]], closed: true, fill: foreground)
          rect(dir > 0 ? cx + s * 0.09 : cx - s * 0.17, cy - s * 0.21, s * 0.08, s * 0.42, radius: s * 0.04, fill: foreground)
        }
      }
    }
  }

  // Three bars that dance with the music; they hold still when it's paused.
  component Bars() {
    Canvas {
      width: 14
      height: 12
      for i in range(3) {
        let h = playing ? 3 + (sin(time * (4.5 + i * 1.7) + i * 2.1) * 0.5 + 0.5) * (height - 3) : 3
        rect(i * 5, height - h, 3, h, radius: 1, color: playing ? accent : muted)
      }
    }
  }

  // The scrim, the source app's icon and the track's words, over the cover's bottom.
  // withWords: false leaves just the icon on a bare cover.
  component ArtInfo(withWords = true) {
    Box {
      fill: true
      if withWords {
        Box {
          fill: true
          background: linear(0, 0, 0, 1, [alpha(background, 0), alpha(background, 0.1), alpha(background, 0.9)])
        }
      }
      Box {
        fill: true
        align: topEnd
        if has && m.package != null {
          // Just the icon, no plate: it floats over the cover.
          Image { src: "app:${m.package}"; fit: contain; size: chip; offset: [-10, 10] }
        }
      }
      if withWords {
        Box {
          fill: true
          align: bottomStart
          Column {
            fill: width
            padding: [10, 9]
            gap: 1
            if has && m.app != null {
              Row {
                align: center
                gap: 6
                if playing { Bars { } }
                Text { text: upper(m.app); style: label; color: playing ? accent : foreground; maxLines: 1 }
              }
            }
            Text { text: has ? m.title : (allowed ? "nothing playing" : "no media access"); style: body; bold: true; maxLines: 2 }
            Text {
              text: has ? (m.artist ?? "") : (allowed ? "start music in any app" : "allow notifications to see what's playing")
              style: small
              color: alpha(foreground, 0.72)
              maxLines: 1
            }
          }
        }
      }
    }
  }

  Column {
    gap: 0

    if wide {
      // Wider than tall: the whole square cover on the left, the track and the sung line
      // on the right, rather than cropping the cover to fill the width.
      Row {
        gap: 10
        // The cover, with the source app's icon always in its top-right corner.
        Box {
          size: artMax
          radius: 10 * corners
          clip: true
          onTap: media("open")
          Cover { fit: "contain" }
          Box {
            fill: true
            align: topEnd
            if has && m.package != null {
              Image { src: "app:${m.package}"; fit: contain; size: clamp(artMax * 0.14, 20, 32); offset: [-8, 8] }
            }
          }
        }
        // The words fill the room above the track and center in it; the track sits at
        // the bottom left of the cover's right side.
        Column {
          weight: 1
          onTap: screen()
          height: artMax
          gap: 4
          Box {
            weight: 1
            fill: width
            Column {
              fill: true
              justify: center
              align: start
              gap: 3
              if len(kls) > 0 {
                for j in range(2 * waround + 1) {
                  let idx = bi - waround + j
                  if idx >= 0 && idx < len(kls) {
                    if idx == ki {
                      Text { text: kls[idx]; style: body; bold: true; color: accent; maxLines: 3 }
                    } else {
                      Text { text: kls[idx]; style: small; color: alpha(muted, idx < ki ? 0.5 : 0.7); maxLines: 2 }
                    }
                  }
                }
              } else if has && m.album != null {
                Text { text: m.album; style: small; color: alpha(muted, 0.9); maxLines: 2 }
              }
            }
          }
          Column {
            gap: 2
            onTap: media("open")
            if has && m.app != null && artMax >= 150 {
              Row {
                align: center
                gap: 6
                if playing { Bars { } }
                Text { text: upper(m.app); style: label; color: playing ? accent : foreground; maxLines: 1 }
              }
            }
            Text { text: has ? m.title : (allowed ? "nothing playing" : "no media access"); style: body; bold: true; maxLines: 2 }
            if has && m.artist != null && artMax >= 90 {
              Text { text: m.artist; style: small; color: alpha(foreground, 0.72); maxLines: 1 }
            }
          }
        }
      }
      Spacer { height: 6 }
    } else {
      // The artwork: whole (aspect kept), never trimmed. A tall tile has room for a
      // full-width square; a squarer one, with no room for words beside it, shrinks
      // the cover to fit and centers it. Tapping the cover opens the music app.
      Box {
        height: artH
        fill: width
        align: center
        if fullArt {
          Box {
            fill: true
            radius: 10 * corners
            clip: true
            onTap: media("open")
            Cover { fit: "contain" }
            ArtInfo { withWords: !bareArt }
          }
        } else {
          Box {
            size: artMax
            radius: 10 * corners
            clip: true
            onTap: media("open")
            Cover { fit: "contain" }
            ArtInfo { }
          }
        }
      }

      // The space a tall cover frees up: the sung line, larger, with those around it.
      if spare > 0 {
        Box {
          height: spare
          fill: width
          clip: true
          align: center
          onTap: screen()
          Column {
            fill: width
            padding: [12, 8]
            align: center
            gap: 3
            if len(kls) > 0 {
              for j in range(2 * around + 1) {
                let idx = bi - around + j
                if idx >= 0 && idx < len(kls) {
                  if idx == ki {
                    Text { text: kls[idx]; style: body; bold: true; align: center; maxLines: 2 }
                  } else {
                    Text { text: kls[idx]; style: small; color: alpha(muted, idx < ki ? 0.5 : 0.7); align: center; maxLines: 1 }
                  }
                }
              }
            } else if bareArt {
              if has {
                Column {
                  align: center
                  gap: 3
                  onTap: media("open")
                  if m.app != null {
                    Row {
                      align: center
                      gap: 6
                      if playing { Bars { } }
                      Text { text: upper(m.app); style: label; color: playing ? accent : foreground; maxLines: 1 }
                    }
                  }
                  Text { text: m.title; style: body; bold: true; align: center; maxLines: 2 }
                  if m.artist != null {
                    Text { text: m.artist; style: small; color: alpha(foreground, 0.72); align: center; maxLines: 1 }
                  }
                  if m.album != null {
                    Text { text: m.album; style: small; color: alpha(muted, 0.9); align: center; maxLines: 1 }
                  }
                }
              } else {
                Text { text: allowed ? "nothing playing" : "no media access"; style: body; bold: true; align: center; maxLines: 2 }
                Text {
                  text: allowed ? "start music in any app" : "allow notifications to see what's playing"
                  style: small
                  color: alpha(foreground, 0.72)
                  align: center
                  maxLines: 2
                }
              }
            } else if has && m.album != null {
              Text { text: m.album; style: small; color: alpha(muted, 0.9); align: center; maxLines: 2 }
            }
          }
        }
      }
    }

    // The controls' fifth: progress, times, and previous / play / next.
    Column {
      height: controlsH
      justify: center
      gap: 5
      if has && dur > 0 {
        Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.22); animate value: tween(900ms, "linear") }
        Row {
          align: center
          gap: 6
          Time { s: pos }
          Spacer { weight: 1 }
          Time { s: dur }
        }
      }
      if !allowed {
        Button { text: "allow access"; color: accent; onTap: media("toggle") }
      } else if has {
        Row {
          align: center
          gap: ctlGap
          Spacer { weight: 1 }
          Control { kind: "previous"; d: ctl }
          Control { kind: "toggle"; d: ctlBig }
          Control { kind: "next"; d: ctl }
          Spacer { weight: 1 }
        }
      } else {
        Button { text: "open player"; color: muted; onTap: media("open") }
      }
    }
  }

  screen {
    title: "now playing"
    Column {
      scroll: len(kls) == 0
      height: screenHeight ?? 800
      fill: width
      align: center
      gap: 10
      padding: [20, 12]

      let big = clamp(min((screenWidth ?? 360) * 0.6, (screenHeight ?? 640) * 0.3), 120, 300)
      let bigBadge = big * 0.36
      let bigX = (bigBadge - big) / 2 + 5
      let bigY = (big - bigBadge) / 2 - 5

      Box {
        size: big
        align: center
        radius: 18 * corners
        clip: true
        Cover { }
        if has {
          Spin { d: bigBadge; offset: [bigX, bigY] }
        }
      }

      Column {
        gap: 3
        align: center
        Text { text: has ? m.title : "nothing playing"; style: title; align: center; maxLines: 3 }
        if has && m.artist != null {
          Text { text: m.artist; style: body; color: muted; align: center; maxLines: 2 }
        }
        if has && m.album != null {
          Text { text: m.album; style: small; color: alpha(muted, 0.8); align: center; maxLines: 2 }
        }
        if !allowed {
          Text { text: "Allow notification access so the launcher can see what's playing in other apps."; style: small; color: muted; align: center; maxLines: 3 }
        } else if !has {
          Text { text: "Start music or a podcast in any app and it shows up here."; style: small; color: muted; align: center; maxLines: 3 }
        }
      }

      if has && dur > 0 {
        Column {
          gap: 4
          Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.22); animate value: tween(900ms, "linear") }
          Row {
            align: center
            gap: 6
            Time { s: pos }
            Spacer { weight: 1 }
            Time { s: dur }
          }
        }
      }

      if allowed && has {
        Row {
          align: center
          justify: center
          gap: 22
          Control { kind: "previous"; d: 38 }
          Control { kind: "toggle"; d: 62 }
          Control { kind: "next"; d: 38 }
        }
      }

      Row {
        justify: center
        gap: 10
        if !allowed {
          Button { text: "allow access"; color: accent; onTap: media("toggle") }
        } else if has {
          Button { text: "open player"; color: accent; onTap: media("open") }
        }
        Button { text: "close"; color: muted; onTap: close() }
      }

      Spacer { weight: 1 }

      // The words: a window around the line being sung, which moves with the song.
      if len(kls) > 0 {
        Text { text: "lyrics · lrclib.net"; style: label; color: muted; align: center }
        Box {
          height: clamp((screenHeight ?? 640) * 0.42, 150, 380)
          fill: width
          clip: true
          Column {
            fill: true
            align: center
            justify: center
            gap: 5
            for j in range(winLines) {
              let idx = winFirst + j
              if idx < len(kls) {
                if idx == ki {
                  Text { text: kls[idx]; style: body; bold: true; color: accent; align: center; maxLines: 2 }
                } else {
                  Text { text: kls[idx]; style: small; color: alpha(foreground, 0.72); align: center; maxLines: 2 }
                }
              }
            }
          }
        }
      } else if plain != null {
        Column {
          gap: 3
          width: 320
          Text { text: "lyrics · lrclib.net"; style: label; color: muted; align: center }
          Text { text: plain; style: small; color: alpha(foreground, 0.72); align: center }
        }
      }

      Spacer { weight: 1 }
    }
  }
}
