widget "knob" {
  meta { description: "A draggable gauge knob: a playground for gestures and springs"; version: "1.0"; license: "MIT" }
  size: 3x3
  state level = 0.4
  // Drag up/down: state -> spring-animated gauge, color mixed per update.
  Box {
    fill: true
    align: center
    onDrag: level = clamp(level - dy / 200, 0, 1)
    Ring { fill: true; value: level; start: 225; sweep: 270; thickness: 10; color: mix(green, red, level); animate value: spring(0.8, 600) }
    Text { text: "${round(level * 100)}%"; style: title; align: center }
  }
}
