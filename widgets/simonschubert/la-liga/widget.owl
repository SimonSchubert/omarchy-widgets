widget "la-liga" {
  meta {
    owl: 17
    description: "LaLiga results, live scores and kick-offs from ESPN with club crests, and the table with European and relegation places. Tap for every match"
    version: "1.7"
    license: "MIT"
    category: "sport"
  }
  // What it says, in the phone's language where it has a set. Club names and ESPN's match minute
  // (45', HT, FT) come as ESPN writes them.
  strings {
    en { matches: "matches"; table: "table"; loading: "loading…"; none: "no matches this week"; close: "close"; live: n => "${n} live" }
    id { matches: "laga"; table: "klasemen"; loading: "memuat…"; none: "tidak ada laga minggu ini"; close: "tutup"; live: n => "${n} live" }
    es { matches: "partidos"; table: "tabla"; loading: "cargando…"; none: "no hay partidos esta semana"; close: "cerrar"; live: n => "${n} en vivo" }
    pt { matches: "jogos"; table: "tabela"; loading: "carregando…"; none: "nenhum jogo nesta semana"; close: "fechar"; live: n => "${n} ao vivo" }
    de { matches: "spiele"; table: "tabelle"; loading: "lädt…"; none: "diese woche keine spiele"; close: "schließen"; live: n => "${n} live" }
    zh { matches: "比赛"; table: "积分榜"; loading: "正在加载…"; none: "本周没有比赛"; close: "关闭"; live: n => "${n} 场进行中" }
    ru { matches: "матчи"; table: "таблица"; loading: "загрузка…"; none: "на этой неделе матчей нет"; close: "закрыть"; live: n => "идут: ${n}" }
  }
  size: 6x4
  minSize: 3x3

  source now = clock every 1m

  // ESPN's scoreboard answers one day at a time (it turns ranges down), so each day from three back
  // to six ahead is its own request, straight from Android. Today and the days either side, where
  // scores move, are asked for every 5 minutes; the rest, settled or still to come, every 30. The
  // URLs move on at midnight, so a day that becomes today is fetched again then.
  let api = "https://site.api.espn.com/apis/site/v2/sports/soccer/esp.1/scoreboard?dates="
  source d0 = http("${api}${enc(fmtTime(now - 3 * 86400, "yyyyMMdd"))}") every 30m json timeout 15s
  source d1 = http("${api}${enc(fmtTime(now - 2 * 86400, "yyyyMMdd"))}") every 30m json timeout 15s
  source d2 = http("${api}${enc(fmtTime(now - 86400, "yyyyMMdd"))}") every 5m json timeout 15s
  source d3 = http("${api}${enc(fmtTime(now, "yyyyMMdd"))}") every 5m json timeout 15s
  source d4 = http("${api}${enc(fmtTime(now + 86400, "yyyyMMdd"))}") every 5m json timeout 15s
  source d5 = http("${api}${enc(fmtTime(now + 2 * 86400, "yyyyMMdd"))}") every 30m json timeout 15s
  source d6 = http("${api}${enc(fmtTime(now + 3 * 86400, "yyyyMMdd"))}") every 30m json timeout 15s
  source d7 = http("${api}${enc(fmtTime(now + 4 * 86400, "yyyyMMdd"))}") every 30m json timeout 15s
  source d8 = http("${api}${enc(fmtTime(now + 5 * 86400, "yyyyMMdd"))}") every 30m json timeout 15s
  source d9 = http("${api}${enc(fmtTime(now + 6 * 86400, "yyyyMMdd"))}") every 30m json timeout 15s

  // The table. Zones come from ESPN's notes (Champions League, relegation...).
  source table = http("https://site.api.espn.com/apis/v2/sports/soccer/esp.1/standings") every 30m json timeout 20s

  state view = "matches"

  // A match late at night can be on two days' lists, so each is kept once.
  let events = flatten([d0, d1, d2, d3, d4, d5, d6, d7, d8, d9].map(d => d.events ?? []))
  let all = values(groupBy(events.map(e => {
    id: e.id, at: parseTime(e.date),
    state: e.competitions[0].status.type.state, detail: e.competitions[0].status.type.shortDetail,
    teams: e.competitions[0].competitors.map(c => {
      side: c.homeAway, abbr: c.team.abbreviation, name: c.team.shortDisplayName, score: c.score,
      winner: c.winner ?? false, logo: last(split(c.team.logo ?? "", "/"))
    })
  }), g => g.id)).map(l => l[0]).sortBy(g => g.at)
  let live = all.filter(g => g.state == 'in')
  let done = all.filter(g => g.state == 'post').reverse()
  let next = all.filter(g => g.state == 'pre')
  let cap = clamp((rows ?? 4) * 3 - 2, 5, 14)
  let picked = flatten([live, done.take(ceil(cap / 2)), next]).take(cap)
  let groups = (table.children ?? []).map(c => {
    name: c.name,
    teams: (c.standings.entries ?? []).map(e => {
      e: e, n: lower(e.note.description ?? ""),
      st: reduce(e.stats ?? [], (m, s) => set(m, s.name, floor(s.value ?? 0)), {})
    }).map(x => {
      id: x.e.team.id, abbr: x.e.team.abbreviation, name: x.e.team.shortDisplayName,
      logo: last(split(x.e.team.logos[0].href ?? "", "/")),
      rank: x.st.rank, played: x.st.gamesPlayed, won: x.st.wins, drawn: x.st.ties, lost: x.st.losses,
      gd: x.st.pointDifferential, pts: x.st.points,
      zone: x.n == "" ? null
        : contains(x.n, "relegat") && contains(x.n, "playoff") ? "orange"
        : contains(x.n, "relegat") || contains(x.n, "eliminat") ? "red"
        : endsWith(x.n, "champions league") || contains(x.n, "round of 16") ? "green"
        : "blue"
    }).sortBy(t => t.rank)
  })
  // Full club names need room: the tile decides from its own width (the landscape tile, ~290dp,
  // gets abbreviations), the full screen from the screen's.
  let tileWide = (tileWidth ?? 0) >= 360
  let screenWide = max(max(screenWidth ?? 0, tileWidth ?? 0), 240) >= 280

  // Crests at 96 px from ESPN's resizer; the launcher keeps each one, so they show offline too.
  component Crest(logo, px = 18) {
    if logo {
      Image { src: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/${enc(logo)}&w=96&h=96"; size: px; fit: contain }
    } else {
      Box { size: px }
    }
  }

  component GameRow(g, wide = false) {
    let away = g.teams.find(t => t.side == 'away') ?? g.teams[1]
    let home = g.teams.find(t => t.side == 'home') ?? g.teams[0]
    let live = g.state == 'in'
    let final = g.state == 'post'
    let px = wide ? 18 : 14
    let scW = wide ? 24 : 18
    let dotW = wide ? 8 : 6
    let stW = wide ? 72 : 34
    let ctrW = 2 * scW + 2 * dotW + stW

    // Home on the left, as football lists it; the centre keeps one width so the
    // crests and names line up down the list.
    Row {
      gap: wide ? 8 : 4
      Crest { logo: home.logo; px: px }
      Text { text: wide ? home.name : home.abbr; style: small; weight: 1; maxLines: 1; color: final && away.winner ? muted : foreground }
      if g.state == 'pre' {
        Text { text: fmtTime(g.at, "EEE HH:mm"); style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: home.score ?? '–'; style: small; width: scW; align: end; bold: final && home.winner; color: live ? accent : final && away.winner ? muted : foreground }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : rgb(0, 0, 0, 0) }
          Text { text: g.detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: away.score ?? '–'; style: small; width: scW; align: start; bold: final && away.winner; color: live ? accent : final && home.winner ? muted : foreground }
        }
      }
      Text { text: wide ? away.name : away.abbr; style: small; weight: 1; maxLines: 1; align: end; color: final && home.winner ? muted : foreground }
      Crest { logo: away.logo; px: px }
    }
  }

  component TeamRow(t, full = false, wide = false) {
    let zc = t.zone == 'green' ? green : t.zone == 'blue' ? blue : t.zone == 'orange' ? orange : t.zone == 'red' ? red : rgb(0, 0, 0, 0)
    Row {
      gap: 6
      Box { width: 3; height: 14; radius: 1.5; background: zc }
      Text { text: t.rank; width: 20; style: small; color: muted; align: end }
      Crest { logo: t.logo; px: 16 }
      Text { text: wide ? t.name : t.abbr; weight: 1; style: small; maxLines: 1 }
      if full {
        Text { text: "${t.won}-${t.drawn}-${t.lost}"; width: 56; style: small; color: muted; align: end }
      } else if wide {
        Text { text: t.played; width: 24; style: small; color: muted; align: end }
      }
      Text { text: t.gd > 0 ? "+${t.gd}" : t.gd; width: 32; style: small; align: end; color: t.gd > 0 ? green : t.gd < 0 ? red : muted }
      Text { text: t.pts; width: 28; style: small; bold: true; align: end }
    }
  }

  onTap: screen()

  Column {
    Row {
      Text { text: "LaLiga"; style: title; weight: 1; maxLines: 1 }
      if count(live) > 0 {
        Text { text: str.live(count(live)); style: small; color: accent; width: 72; align: end; bold: true }
      } else {
        Text { text: fmtTime(now, "EEE d"); style: small; color: muted; width: 72; align: end }
      }
    }
    Row {
      Button { text: str.matches; weight: 1; color: view == "matches" ? accent : muted; onTap: view = "matches" }
      Button { text: str.table; weight: 1; color: view == "table" ? accent : muted; onTap: view = "table" }
    }
    Column {
      weight: 1
      scroll: true
      if view == "matches" {
        if count(picked) == 0 {
          Text { text: d3 == null ? str.loading : str.none; style: small; color: muted }
        } else {
          for g in picked key g.id { GameRow { g: g; wide: tileWide } }
        }
      } else {
        for grp in groups {
          for t in grp.teams key t.id { TeamRow { t: t; wide: tileWide } }
        }
      }
    }
  }

  screen {
    title: "LaLiga"
    Column {
      scroll: true
      onPull: refresh()
      Text { text: str.matches; style: title }
      if count(all) == 0 { Text { text: str.none; style: small; color: muted } }
      for g in all key g.id { GameRow { g: g; wide: screenWide } }
      Text { text: str.table; style: title }
      for grp in groups {
        for t in grp.teams key t.id { TeamRow { t: t; full: true; wide: screenWide } }
      }
      Button { text: str.close; onTap: close() }
    }
  }
}
