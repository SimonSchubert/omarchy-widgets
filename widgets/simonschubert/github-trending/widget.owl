widget "github trending" {
  meta { description: "The most-starred GitHub repositories created in the last week; tap one to open it"; version: "1.6"; license: "MIT"; category: "dev"; owl: 16 }

  // What it says, in the phone's language where it has a set.
  strings {
    en { title: "github trending · this week" }
    id { title: "github trending · minggu ini" }
    es { title: "tendencias de github · esta semana" }
    pt { title: "em alta no github · esta semana" }
    de { title: "github trending · diese woche" }
    zh { title: "github 热门 · 本周" }
    ru { title: "github trending · за неделю" }
  }
  size: 6x4
  minSize: 4x3



  // GitHub has no trending API; new repos sorted by stars come closest. No token needed. The
  // date moves on once a day, and the search is asked for again then.
  source now = clock every 1h
  source feed = http("https://api.github.com/search/repositories?q=created:>${enc(fmtTime(now - 7 * 86400, "yyyy-MM-dd"))}&sort=stars&order=desc&per_page=15", {Accept: "application/vnd.github+json"}) every 1h json timeout 15s
  let repos = (feed.items ?? []).map(r => {
    name: r.full_name, url: r.html_url, stars: r.stargazers_count, lang: r.language ?? "", desc: r.description ?? ""
  })

  onTap: url("https://github.com/trending")

  Column {
    gap: 4
    Text { text: str.title; style: muted }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for r in repos key r.url {
        Column {
          gap: 0
          onTap: url(r.url)
          Row {
            Text { text: r.name; fontSize: 13; bold: true; maxLines: 1; weight: 1 }
            Text { text: r.stars >= 1000 ? "★ ${fixed(r.stars / 1000, 1)}k" : "★ ${r.stars}"; fontSize: 11; color: yellow; width: 64; align: end }
          }
          if r.desc != "" { Text { text: r.desc; fontSize: 11; color: muted; maxLines: 2 } }
          if r.lang != "" { Text { text: r.lang; fontSize: 10; color: accent } }
        }
      }
    }
  }
}
