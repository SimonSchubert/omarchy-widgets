widget "forecast" {
  meta { description: "Three-day weather forecast with an hourly temperature curve, located by IP via wttr.in"; version: "1.0"; license: "MIT" }
  size: 6x3
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  // wttr.in picks the location from the IP address. Only what's drawn is kept from its ~50 KB.
  source w = cmd("""
    curl -fsm 12 'https://wttr.in/?format=j1' | jq -c '{
      place: .nearest_area[0].areaName[0].value,
      now: .current_condition[0] | {temp: .temp_C, desc: .weatherDesc[0].value},
      days: [.weather[] | {date, day: (.date | strptime("%Y-%m-%d") | strftime("%a")), max: .maxtempC, min: .mintempC, hours: [.hourly[].tempC | tonumber]}]
    }'
  """) every 30m json timeout 20s
  let hours = flatten(w.days.map(d => d.hours))
  let lo = min(hours) - 2
  let hi = max(hours) + 2

  onTap: url("https://wttr.in")

  Column {
    gap: 4
    Row {
      align: center
      Text { text: "${w.now.temp}°"; style: title; width: 56 }
      Column {
        gap: 0
        weight: 1
        Text { text: w.now.desc; style: small; maxLines: 1 }
        Text { text: w.place; style: small; color: muted; maxLines: 1 }
      }
    }
    Row {
      for d, i in w.days key d.date {
        Column {
          weight: 1
          gap: 0
          Text { text: i == 0 ? "today" : lower(d.day); fontSize: 10; color: muted }
          Text { text: "${d.max}° / ${d.min}°"; fontSize: 12 }
        }
      }
    }
    // 8 readings a day, every 3 hours; the dots mark noon.
    Canvas {
      weight: 1
      fill: width
      let pts = hours.map((t, i) => [i / max(len(hours) - 1, 1) * width, height - 4 - (t - lo) / (hi - lo) * (height - 8)])
      path(pts, stroke: accent, width: 2)
      for p, i in pts {
        if i % 8 == 4 { circle(p[0], p[1], 3, color: accent) }
      }
    }
  }
}
