widget "binary clock" {
  size: 3x2
  minSize: 2x2
  meta { description: "The time as six columns of LEDs: hours, minutes and seconds in binary. Tap for a bigger clock with the date and a switch to blank leading zeros"; version: "1.0.1"; license: "MIT"; category: "time"; owl: 5 }

  requires { pacman: [] }

  source now = clock every 1s
  state blank = false persist

  let hh = num(fmtTime(now, "H"), 0)
  let mm = num(fmtTime(now, "m"), 0)
  let ss = num(fmtTime(now, "s"), 0)
  // The six binary digits, most significant first: the two of the hours, then minutes, then seconds.
  let digits = [floor(hh / 10), hh % 10, floor(mm / 10), mm % 10, floor(ss / 10), ss % 10]
  // A group only ever has one leading zero; hide it when asked, like the old LED clocks did.
  let blanks = [hh < 10, false, mm < 10, false, ss < 10, false]

  onTap: screen()

  component Binary() {
    Canvas {
      let weights = [8, 4, 2, 1]
      let labelH = 15
      let pitch = min(width / 7.1, (height - labelH) / 4.3)
      let gap = pitch * 0.5
      // A narrow tile (landscape) shrinks the pitch until the labels touch the bottom row's glow, but leaves
      // room to spare below: use up to 8dp of it to drop the labels clear. A full tile has none, so it is unchanged.
      let drop = min(max(0, height - labelH - 4.3 * pitch), 8)
      let x0 = (width - 6 * pitch - 2 * gap) / 2 + pitch / 2
      let y0 = (height - labelH - drop - 4 * pitch) / 2 + pitch / 2
      for i in range(6) {
        let cx = x0 + (i % 2) * pitch + floor(i / 2) * (2 * pitch + gap)
        let tint = i >= 4 ? accent : foreground
        for r in range(4) {
          let cy = y0 + r * pitch
          // Every LED just shows its bit, so the seconds' lowest one ticks over every second.
          if floor(digits[i] / weights[r]) % 2 == 1 {
            circle(cx, cy, pitch * 0.46, fill: alpha(tint, 0.13))
            circle(cx, cy, pitch * 0.3, fill: tint)
          } else {
            circle(cx, cy, pitch * 0.17, fill: blank && blanks[i] ? alpha(muted, 0.08) : alpha(muted, 0.26))
          }
        }
        if i % 2 == 0 {
          text(["h", "m", "s"][i / 2], x0 + pitch / 2 + floor(i / 2) * (2 * pitch + gap), y0 + 3.5 * pitch + drop, size: 10, align: center, color: muted)
        }
      }
    }
  }

  Column {
    align: center
    Binary { weight: 1 }
  }

  screen {
    title: "binary clock"
    // The grid is as big as the screen is wide, so give it exactly that much room and centre the rest.
    let gridH = (screenWidth ?? 400) / 7.1 * 4 + 16
    Column {
      gap: 14
      fill: true
      justify: center
      Binary { height: gridH }
      Text { text: fmtTime(now, "HH:mm:ss") ?? "--:--:--"; style: huge; align: center }
      Text { text: lower(fmtTime(now, "EEEE d MMMM")); style: small; color: muted; align: center; maxLines: 1 }
      Row {
        gap: 10
        justify: center
        Button { text: blank ? "show zeros" : "blank zeros"; color: muted; onTap: blank = !blank }
        Button { text: "close"; color: muted; onTap: close() }
      }
    }
  }
}