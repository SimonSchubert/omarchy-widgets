widget "sintonizador" {
  size: 3x2
  minSize: 3x2
  meta {
    owl: 13
    description: "Control remoto de cliamp: radios del mundo por país con un dial para sintonizar, favoritas y búsqueda en YouTube"
    version: "1.9"
    license: "MIT"
    category: "media"
  }

  // cliamp no está en los repos de Arch (solo AUR): el widget lo baja de su release en GitHub a
  // ~/.cache/cliamp-sintonizador/bin, verificado con checksums.txt (o usa uno ya instalado en el PATH).
  // Declaramos todos los paquetes que usan los comandos, el binario de cliamp (alsa-lib, glibc) y el audio.
  requires { pacman: ["bash", "coreutils", "findutils", "procps-ng", "util-linux", "curl", "jq", "python", "quickjs-ng", "yt-dlp", "ffmpeg", "libpulse", "sed", "grep", "gawk", "glibc", "alsa-lib", "alsa-plugins", "pulseaudio-alsa"] }

  let pathFix = 'export PATH="$HOME/.cache/cliamp-sintonizador/bin:/usr/local/bin:/usr/bin:/bin:$PATH"; '

  source sys = android.system every 1h
  source op = file("~/.cache/cliamp-sintonizador/state.json") json
  source st = cmd('export PATH="$HOME/.cache/cliamp-sintonizador/bin:/usr/local/bin:/usr/bin:/bin:$PATH"; o=$(cliamp status --json 2>/dev/null) && printf "%s" "$o" || echo {}') every 5s json
  // ¿Hay cliamp? "v2.3.0 propio" (bajado por el widget), "v2.3.0 sistema" o "none".
  source clv = cmd('export PATH="$HOME/.cache/cliamp-sintonizador/bin:/usr/local/bin:/usr/bin:/bin:$PATH"; if p=$(command -v cliamp) && v=$(cliamp --version 2>/dev/null); then case "$p" in "$HOME"/.cache/*) o=propio;; *) o=sistema;; esac; echo "${v##* } $o"; else echo none; fi') every 1h timeout 15s
  source ytv = cmd("""
mkdir -p "$HOME/.cache/cliamp-sintonizador"
f="$HOME/.cache/cliamp-sintonizador/ctl.sh"
if ! grep -q "^# v2.5" "$f" 2>/dev/null; then
cat > "$f.tmp" <<'SH'
#!/usr/bin/env bash
# v2.5
export PATH="$HOME/.cache/cliamp-sintonizador/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
D="$HOME/.cache/cliamp-sintonizador"
mkdir -p "$D"
SF="$D/state.json"
RF="$D/req.id"

ACT="${1:-play}"
URL="${2:-}"
NAME="${3:-}"
KIND="${4:-radio}"
NONCE="${5:-0}"

PF="$D/pause.id"
AUTO_OFF=300

# Apaga el motor del todo (lo mismo que el botón ⏹).
kill_engine() {
  printf 'stop-%s' "$(date +%s%N)" > "$RF"
  rm -f "$PF"
  pkill -x cliamp 2>/dev/null
  sleep 0.3
  pkill -9 -x cliamp 2>/dev/null
  rm -f ~/.config/cliamp/cliamp.sock ~/.config/cliamp/cliamp.sock.pid
}

# Lo lanza la pausa: si a los 5 min sigue en pausa (y nadie volvió a tocar), apaga el motor.
if [ "$ACT" = "autooff" ]; then
  TOK="$URL"
  sleep "$AUTO_OFF"
  [ "$(cat "$PF" 2>/dev/null)" = "$TOK" ] || exit 0
  ST=$(cliamp status --json 2>/dev/null | jq -r '.state // "stopped"')
  [ "$ST" = "paused" ] || exit 0
  OLD=$(cat "$SF" 2>/dev/null)
  kill_engine
  printf '%s' "$OLD" | jq -c '. + {nonce:0, phase:"stopped", msg:"Motor apagado solo tras 5 min en pausa · tocá ▶ para escuchar", err:""}' > "$SF.tmp" 2>/dev/null \
    || printf '%s' '{"nonce":0,"phase":"stopped","url":"","name":"","kind":"","msg":"Motor apagado solo tras 5 min en pausa","err":""}' > "$SF.tmp"
  mv -f "$SF.tmp" "$SF"
  exit 0
fi

if [ "$ACT" = "toggle" ]; then
  if cliamp status --json >/dev/null 2>&1; then
    cliamp toggle >/dev/null 2>&1
    sleep 0.15
    ST=$(cliamp status --json 2>/dev/null | jq -r '.state // "stopped"')
    if [ "$ST" = "playing" ]; then
      rm -f "$PF"
      jq -nc --arg url "$URL" --arg name "$NAME" --arg kind "$KIND" --argjson nonce "$NONCE" \
        '{nonce:$nonce, phase:"playing", url:$url, name:$name, kind:$kind, msg:"Reproduciendo ahora", err:""}' > "$SF.tmp" && mv -f "$SF.tmp" "$SF"
    else
      jq -nc --arg url "$URL" --arg name "$NAME" --arg kind "$KIND" --argjson nonce "$NONCE" \
        '{nonce:$nonce, phase:"paused", url:$url, name:$name, kind:$kind, msg:"En pausa · se apaga solo en 5 min si no tocás ▶", err:""}' > "$SF.tmp" && mv -f "$SF.tmp" "$SF"
      TOK="p-$(date +%s%N)"
      printf '%s' "$TOK" > "$PF"
      (
        exec 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- 2>/dev/null || true
        setsid -f bash "$D/ctl.sh" autooff "$TOK" >/dev/null 2>&1 </dev/null
      )
    fi
  fi
  exit 0
fi

REQ="$$-$(date +%s%N)"
printf '%s' "$REQ" > "$RF"
rm -f "$PF"

set_state() {
  [ "$(cat "$RF" 2>/dev/null)" = "$REQ" ] || exit 0
  jq -nc --arg phase "$1" --arg url "$URL" --arg name "$NAME" --arg kind "$KIND" --arg msg "$2" --arg err "$3" --argjson nonce "$NONCE" \
    '{nonce:$nonce, phase:$phase, url:$url, name:$name, kind:$kind, msg:$msg, err:$err}' > "$SF.tmp" && mv -f "$SF.tmp" "$SF"
}

if ! command -v cliamp >/dev/null 2>&1; then
  set_state "error" "" "Falta cliamp, el reproductor: tocá «⬇ instalar cliamp» para bajarlo."
  exit 0
fi

if [ "$ACT" = "queue" ]; then
  set_state "loading" "Espere, agregando a la cola: ${NAME}…" ""
elif [ "$KIND" = "yt" ]; then
  set_state "loading" "Espere, cargando audio de YouTube…" ""
else
  set_state "loading" "Espere, sintonizando ${NAME:-emisora}…" ""
fi

pactl set-sink-mute @DEFAULT_SINK@ 0 >/dev/null 2>&1 || true

is_live() {
  cliamp status --json >/dev/null 2>&1
}

if [ "$ACT" = "fresh" ]; then
  pkill -x cliamp 2>/dev/null
  sleep 0.25
  rm -f ~/.config/cliamp/cliamp.sock ~/.config/cliamp/cliamp.sock.pid
  ACT="play"
fi

PLAY_URL="$URL"
case "$URL" in
  *opml.radiotime.com/Tune.ashx*)
    TJ=$(curl -fsSL -m 8 "${URL}&render=json" 2>/dev/null)
    if [ -n "$TJ" ]; then
      TD=$(printf '%s' "$TJ" | jq -r '[.body[]? | select(.is_direct == true and (.media_type != "hls"))] | .[0].url // empty' 2>/dev/null)
      if [ -n "$TD" ] && ! printf '%s' "$TD" | grep -qiE '\.(asx|pls|m3u)(\?|$)'; then
        PLAY_URL="$TD"
      else
        for TP in $(printf '%s' "$TJ" | jq -r '.body[]?.url // empty' 2>/dev/null); do
          if printf '%s' "$TP" | grep -qiE '\.(m3u|pls)(\?|$)'; then
            TS=$(curl -fsSL -m 6 "$TP" 2>/dev/null | tr '\r' '\n' | sed -nE 's/^File[0-9]+= *//ip; /^https?:\/\//p' | head -n 1)
            [ -n "$TS" ] && { PLAY_URL="$TS"; break; }
          elif ! printf '%s' "$TP" | grep -qiE '\.asx(\?|$)'; then
            PLAY_URL="$TP"; break
          fi
        done
      fi
    fi
    ;;
esac

ENC_URL=$(printf '%s' "$PLAY_URL" | jq -sRr @uri)
ERR_OUT=""
RC=1

start_daemon() {
  local target="$1"
  pkill -x cliamp 2>/dev/null
  sleep 0.15
  rm -f ~/.config/cliamp/cliamp.sock ~/.config/cliamp/cliamp.sock.pid
  (
    exec 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- 2>/dev/null || true
    setsid -f cliamp --daemon --auto-play "$target" >"$D/daemon.log" 2>&1 </dev/null
  )
  for _ in $(seq 1 36); do
    [ "$(cat "$RF" 2>/dev/null)" = "$REQ" ] || exit 0
    [ -S ~/.config/cliamp/cliamp.sock ] && return 0
    pgrep -x cliamp >/dev/null 2>&1 || break
    sleep 0.25
  done
  [ -S ~/.config/cliamp/cliamp.sock ]
}

if is_live; then
  ERR_OUT=$(cliamp open "cliamp://${ACT}?url=${ENC_URL}" 2>&1)
  RC=$?
  if [ $RC -ne 0 ] && printf '%s' "$ERR_OUT" | grep -qiE 'not running|no socket|no listener|connection refused'; then
    if start_daemon "$PLAY_URL"; then
      RC=0
      ERR_OUT=""
    else
      ERR_OUT=$(cat "$D/daemon.log" 2>/dev/null)
      RC=1
    fi
  fi
else
  if start_daemon "$PLAY_URL"; then
    RC=0
  else
    ERR_OUT=$(cat "$D/daemon.log" 2>/dev/null)
    RC=1
  fi
fi

if [ $RC -ne 0 ] && [ "$KIND" = "yt" ]; then
  set_state "loading" "Espere, extrayendo audio con yt-dlp…" ""
  QJS=$(command -v qjs 2>/dev/null)
  DIRECT=$(yt-dlp --no-playlist ${QJS:+--js-runtimes "quickjs:$QJS"} -f "ba[ext=m4a]/ba/b" -g "$URL" 2>"$D/yt.err" | head -n 1)
  if [ -n "$DIRECT" ]; then
    if is_live; then
      ENC_D=$(printf '%s' "$DIRECT" | jq -sRr @uri)
      ERR_OUT=$(cliamp open "cliamp://${ACT}?url=${ENC_D}" 2>&1)
      RC=$?
    else
      if start_daemon "$DIRECT"; then
        RC=0
      else
        ERR_OUT=$(cat "$D/daemon.log" 2>/dev/null)
        RC=1
      fi
    fi
  else
    YT_ERR=$(tail -n 1 "$D/yt.err" 2>/dev/null)
    [ -n "$YT_ERR" ] && ERR_OUT="$YT_ERR"
  fi
fi

format_err() {
  local raw="$1"
  if printf '%s' "$raw" | grep -qi '429'; then
    echo "No se puede reproducir: YouTube limitó las conexiones temporalmente (HTTP 429). Intentá de nuevo en unos segundos."
  elif printf '%s' "$raw" | grep -qiE 'no está disponible|not available|unavailable|private video|video privado'; then
    echo "No se puede reproducir: este video o audio no está disponible o es privado."
  elif printf '%s' "$raw" | grep -qiE 'sign in|age|confirm your age|iniciar sesión'; then
    echo "No se puede reproducir: el video requiere iniciar sesión o verificación de edad."
  elif printf '%s' "$raw" | grep -qiE 'connection refused|no route|timeout|timed out|network|lookup|resolve host'; then
    echo "No se puede reproducir: error de red al conectar con el servidor de audio."
  else
    local clean
    clean=$(printf '%s' "$raw" | tr '\n' ' ' | sed -E 's/.*reason: //I; s/.*operation failed \((.*)\)/\1/; s/^[[:space:]]+//; s/[[:space:]]+$//' | cut -c1-140)
    if [ -n "$clean" ]; then
      echo "No se puede reproducir: $clean"
    else
      echo "No se puede reproducir: el servidor de audio no respondió."
    fi
  fi
}

if [ $RC -ne 0 ]; then
  set_state "error" "" "$(format_err "$ERR_OUT")"
  exit 0
fi

if [ "$ACT" = "queue" ]; then
  set_state "playing" "Agregado a la cola: ${NAME}" ""
  exit 0
fi

STOP_COUNT=0
for _ in $(seq 1 28); do
  [ "$(cat "$RF" 2>/dev/null)" = "$REQ" ] || exit 0
  RS=$(cliamp remote state 2>/dev/null)
  ST=$(printf '%s' "$RS" | jq -r '.snapshot.state // empty' 2>/dev/null)
  HAS_TR=$(printf '%s' "$RS" | jq -r 'if .snapshot.track != null then "1" else "0" end' 2>/dev/null)
  if [ "$ST" = "playing" ] && [ "$HAS_TR" = "1" ]; then
    set_state "playing" "Reproduciendo ahora" ""
    exit 0
  elif [ "$ST" = "paused" ] && [ "$HAS_TR" = "1" ]; then
    cliamp play >/dev/null 2>&1
    set_state "playing" "Reproduciendo ahora" ""
    exit 0
  elif [ "$ST" = "stopped" ]; then
    STOP_COUNT=$((STOP_COUNT + 1))
    if [ "$STOP_COUNT" -ge 4 ]; then
      break
    fi
  fi
  sleep 0.3
done

HTTP_CODE=$(curl -s -L -I -m 4 -o /dev/null -w '%{http_code}' "$PLAY_URL" 2>/dev/null)
if [ "$HTTP_CODE" = "000" ]; then
  REASON="No se puede reproducir: la emisora no responde o está fuera de línea."
elif [ "$HTTP_CODE" = "404" ] || [ "$HTTP_CODE" = "410" ]; then
  REASON="No se puede reproducir: transmisión no encontrada (HTTP $HTTP_CODE)."
elif [ "$HTTP_CODE" = "403" ] || [ "$HTTP_CODE" = "401" ]; then
  REASON="No se puede reproducir: acceso denegado por la emisora (HTTP $HTTP_CODE)."
elif [ "${HTTP_CODE#5}" != "$HTTP_CODE" ]; then
  REASON="No se puede reproducir: error en el servidor de la emisora (HTTP $HTTP_CODE)."
else
  REASON="No se puede reproducir: la emisora cortó la conexión o su formato no es compatible."
fi
set_state "error" "" "$REASON"
SH
chmod 755 "$f.tmp" && mv -f "$f.tmp" "$f"
fi
cf="$HOME/.cache/cliamp-sintonizador/countries.json"
if [ ! -s "$cf" ]; then
cat > "$cf.tmp" <<'JSON'
[{"code":"AF","rid":"r100287","name":"Afganistán","en":"Afghanistan"},{"code":"AL","rid":"r100288","name":"Albania","en":"Albania"},{"code":"DE","rid":"r100346","name":"Alemania","en":"Germany"},{"code":"AD","rid":"r100290","name":"Andorra","en":"Andorra"},{"code":"AO","rid":"r101220","name":"Angola","en":"Angola"},{"code":"AI","rid":"r100291","name":"Anguila","en":"Anguilla"},{"code":"AG","rid":"r100293","name":"Antigua y Barbuda","en":"Antigua-Barbuda"},{"code":"SA","rid":"r101291","name":"Arabia Saudita","en":"Saudi Arabia"},{"code":"DZ","rid":"r100289","name":"Argelia","en":"Algeria"},{"code":"AR","rid":"r100294","name":"Argentina","en":"Argentina"},{"code":"AM","rid":"r100295","name":"Armenia","en":"Armenia"},{"code":"AW","rid":"r100296","name":"Aruba","en":"Aruba"},{"code":"AU","rid":"r101356","name":"Australia","en":"Australia"},{"code":"AT","rid":"r101221","name":"Austria","en":"Austria"},{"code":"AZ","rid":"r101222","name":"Azerbaiyán","en":"Azerbaijan"},{"code":"BS","rid":"r100299","name":"Bahamas","en":"Bahamas"},{"code":"BD","rid":"r100301","name":"Bangladesh","en":"Bangladesh"},{"code":"BB","rid":"r100302","name":"Barbados","en":"Barbados"},{"code":"BH","rid":"r100300","name":"Baréin","en":"Bahrain"},{"code":"BZ","rid":"r100305","name":"Belice","en":"Belize"},{"code":"BJ","rid":"r100997","name":"Benín","en":"Benin"},{"code":"BM","rid":"r100306","name":"Bermudas","en":"Bermuda"},{"code":"BY","rid":"r100303","name":"Bielorrusia","en":"Belarus"},{"code":"BO","rid":"r100308","name":"Bolivia","en":"Bolivia"},{"code":"BA","rid":"r100309","name":"Bosnia y Herzegovina","en":"Bosnia and Herzegovina"},{"code":"BW","rid":"r100310","name":"Botsuana","en":"Botswana"},{"code":"BR","rid":"r101223","name":"Brasil","en":"Brazil"},{"code":"BN","rid":"r100313","name":"Brunéi","en":"Brunei Darussalam"},{"code":"BG","rid":"r101225","name":"Bulgaria","en":"Bulgaria"},{"code":"BF","rid":"r100314","name":"Burkina Faso","en":"Burkina Faso"},{"code":"BI","rid":"r100316","name":"Burundi","en":"Burundi"},{"code":"BE","rid":"r100304","name":"Bélgica","en":"Belgium"},{"code":"CV","rid":"r101228","name":"Cabo Verde","en":"Cape Verde"},{"code":"KH","rid":"r100317","name":"Camboya","en":"Cambodia"},{"code":"CM","rid":"r101226","name":"Camerún","en":"Cameroon"},{"code":"CA","rid":"r101227","name":"Canadá","en":"Canada"},{"code":"QA","rid":"r100399","name":"Catar","en":"Qatar"},{"code":"TD","rid":"r100321","name":"Chad","en":"Chad"},{"code":"CL","rid":"r101229","name":"Chile","en":"Chile"},{"code":"CN","rid":"r100322","name":"China","en":"China"},{"code":"CY","rid":"r101231","name":"Chipre","en":"Cyprus"},{"code":"VA","rid":"r101312","name":"Ciudad del Vaticano","en":"Vatican City"},{"code":"CO","rid":"r100325","name":"Colombia","en":"Colombia"},{"code":"KM","rid":"r100326","name":"Comoras","en":"Comoros"},{"code":"CG","rid":"r100327","name":"Congo","en":"Congo"},{"code":"CD","rid":"r101627","name":"Congo (Rep. Dem.)","en":"DR Congo"},{"code":"KR","rid":"r100367","name":"Corea del Sur","en":"South Korea"},{"code":"CI","rid":"r100330","name":"Costa de Marfil","en":"Cote D'ivoire"},{"code":"CR","rid":"r101230","name":"Costa Rica","en":"Costa Rica"},{"code":"HR","rid":"r100331","name":"Croacia","en":"Croatia"},{"code":"CU","rid":"r100332","name":"Cuba","en":"Cuba"},{"code":"CW","rid":"r100386","name":"Curazao","en":"Netherlands Antilles"},{"code":"DK","rid":"r101233","name":"Dinamarca","en":"Denmark"},{"code":"DM","rid":"r101235","name":"Dominica","en":"Dominica"},{"code":"EC","rid":"r100335","name":"Ecuador","en":"Ecuador"},{"code":"EG","rid":"r101236","name":"Egipto","en":"Egypt"},{"code":"SV","rid":"r100336","name":"El Salvador","en":"El Salvador"},{"code":"AE","rid":"r100435","name":"Emiratos Árabes Unidos","en":"United Arab Emirates"},{"code":"SK","rid":"r100410","name":"Eslovaquia","en":"Slovakia"},{"code":"SI","rid":"r100411","name":"Eslovenia","en":"Slovenia"},{"code":"ES","rid":"r100416","name":"España","en":"Spain"},{"code":"US","rid":"r100436","name":"Estados Unidos","en":"United States"},{"code":"EE","rid":"r101237","name":"Estonia","en":"Estonia"},{"code":"ET","rid":"r100339","name":"Etiopía","en":"Ethiopia"},{"code":"PH","rid":"r100396","name":"Filipinas","en":"Philippines"},{"code":"FI","rid":"r101239","name":"Finlandia","en":"Finland"},{"code":"FJ","rid":"r101238","name":"Fiyi","en":"Fiji"},{"code":"FR","rid":"r101240","name":"Francia","en":"France"},{"code":"GA","rid":"r101241","name":"Gabón","en":"Gabon"},{"code":"GM","rid":"r101242","name":"Gambia","en":"Gambia"},{"code":"GE","rid":"r101435","name":"Georgia","en":"Georgia"},{"code":"GH","rid":"r101243","name":"Ghana","en":"Ghana"},{"code":"GD","rid":"r101245","name":"Granada","en":"Grenada"},{"code":"GR","rid":"r101244","name":"Grecia","en":"Greece"},{"code":"GL","rid":"r100348","name":"Groenlandia","en":"Greenland"},{"code":"GP","rid":"r100349","name":"Guadalupe","en":"Guadeloupe"},{"code":"GU","rid":"r100465","name":"Guam","en":"Guam"},{"code":"GT","rid":"r100350","name":"Guatemala","en":"Guatemala"},{"code":"GF","rid":"r100343","name":"Guayana Francesa","en":"French Guiana"},{"code":"GN","rid":"r100351","name":"Guinea","en":"Guinea"},{"code":"GQ","rid":"r100337","name":"Guinea Ecuatorial","en":"Equatorial Guinea"},{"code":"GW","rid":"r101246","name":"Guinea-Bisáu","en":"Guinea-Bissau"},{"code":"GY","rid":"r101247","name":"Guyana","en":"Guyana"},{"code":"HT","rid":"r101248","name":"Haití","en":"Haiti"},{"code":"HN","rid":"r100353","name":"Honduras","en":"Honduras"},{"code":"HK","rid":"r100354","name":"Hong Kong","en":"Hong Kong"},{"code":"HU","rid":"r101249","name":"Hungría","en":"Hungary"},{"code":"IN","rid":"r100355","name":"India","en":"India"},{"code":"ID","rid":"r100356","name":"Indonesia","en":"Indonesia"},{"code":"IQ","rid":"r101251","name":"Irak","en":"Iraq"},{"code":"IE","rid":"r101252","name":"Irlanda","en":"Ireland"},{"code":"IR","rid":"r100357","name":"Irán","en":"Iran"},{"code":"IS","rid":"r101250","name":"Islandia","en":"Iceland"},{"code":"KY","rid":"r100319","name":"Islas Caimán","en":"Cayman Island"},{"code":"CK","rid":"r100329","name":"Islas Cook","en":"Cook Islands"},{"code":"FK","rid":"r100340","name":"Islas Malvinas","en":"Falkland Islands"},{"code":"MP","rid":"r100481","name":"Islas Marianas del Norte","en":"Northern Mariana Islands"},{"code":"SB","rid":"r100413","name":"Islas Salomón","en":"Solomon Islands"},{"code":"TC","rid":"r100431","name":"Islas Turcas y Caicos","en":"Turks-Caicos Islands"},{"code":"VG","rid":"r100441","name":"Islas Vírgenes Británicas","en":"Virgin Islands (British)"},{"code":"VI","rid":"r100442","name":"Islas Vírgenes de los Estados Unidos","en":"Virgin Islands (U.S.)"},{"code":"IL","rid":"r100358","name":"Israel","en":"Israel"},{"code":"IT","rid":"r100359","name":"Italia","en":"Italy"},{"code":"JM","rid":"r101254","name":"Jamaica","en":"Jamaica"},{"code":"JP","rid":"r101255","name":"Japón","en":"Japan"},{"code":"JO","rid":"r100361","name":"Jordania","en":"Jordan"},{"code":"KZ","rid":"r100362","name":"Kazajistán","en":"Kazakhstan"},{"code":"KE","rid":"r100363","name":"Kenia","en":"Kenya"},{"code":"KG","rid":"r101257","name":"Kirguistán","en":"Kyrgyzstan"},{"code":"XK","rid":"r102406","name":"Kosovo","en":"Kosovo"},{"code":"KW","rid":"r101256","name":"Kuwait","en":"Kuwait"},{"code":"LV","rid":"r101259","name":"Letonia","en":"Latvia"},{"code":"LR","rid":"r100371","name":"Liberia","en":"Liberia"},{"code":"LY","rid":"r101261","name":"Libia","en":"Libya"},{"code":"LI","rid":"r100373","name":"Liechtenstein","en":"Liechtenstein"},{"code":"LT","rid":"r100374","name":"Lituania","en":"Lithuania"},{"code":"LU","rid":"r101262","name":"Luxemburgo","en":"Luxembourg"},{"code":"LB","rid":"r100370","name":"Líbano","en":"Lebanon"},{"code":"MK","rid":"r101263","name":"Macedonia del Norte","en":"Macedonia"},{"code":"MG","rid":"r101264","name":"Madagascar","en":"Madagascar"},{"code":"MY","rid":"r101265","name":"Malasia","en":"Malaysia"},{"code":"MW","rid":"r100376","name":"Malawi","en":"Malawi"},{"code":"MT","rid":"r101268","name":"Malta","en":"Malta"},{"code":"ML","rid":"r101267","name":"Malí","en":"Mali"},{"code":"MA","rid":"r101276","name":"Marruecos","en":"Morocco"},{"code":"MQ","rid":"r100378","name":"Martinica","en":"Martinique"},{"code":"MU","rid":"r101270","name":"Mauricio","en":"Mauritius"},{"code":"YT","rid":"r100379","name":"Mayotte","en":"Mayotte"},{"code":"MD","rid":"r101273","name":"Moldavia","en":"Moldova"},{"code":"MN","rid":"r101275","name":"Mongolia","en":"Mongolia"},{"code":"ME","rid":"r101358","name":"Montenegro","en":"Montenegro"},{"code":"MS","rid":"r100381","name":"Montserrat","en":"Montserrat"},{"code":"MZ","rid":"r101277","name":"Mozambique","en":"Mozambique"},{"code":"MM","rid":"r100382","name":"Myanmar","en":"Myanmar (Burma)"},{"code":"MX","rid":"r101271","name":"México","en":"Mexico"},{"code":"MC","rid":"r101274","name":"Mónaco","en":"Monaco"},{"code":"NA","rid":"r100383","name":"Namibia","en":"Namibia"},{"code":"NP","rid":"r101278","name":"Nepal","en":"Nepal"},{"code":"NI","rid":"r100388","name":"Nicaragua","en":"Nicaragua"},{"code":"NG","rid":"r101281","name":"Nigeria","en":"Nigeria"},{"code":"NO","rid":"r100392","name":"Noruega","en":"Norway"},{"code":"NC","rid":"r100387","name":"Nueva Caledonia","en":"New Caledonia"},{"code":"NZ","rid":"r101279","name":"Nueva Zelanda","en":"New Zealand"},{"code":"NE","rid":"r101280","name":"Níger","en":"Niger"},{"code":"OM","rid":"r101282","name":"Omán","en":"Oman"},{"code":"PK","rid":"r101283","name":"Pakistán","en":"Pakistan"},{"code":"PS","rid":"r100393","name":"Palestina","en":"Palestine"},{"code":"PA","rid":"r101284","name":"Panamá","en":"Panama"},{"code":"PY","rid":"r100395","name":"Paraguay","en":"Paraguay"},{"code":"NL","rid":"r100385","name":"Países Bajos","en":"Netherlands"},{"code":"PE","rid":"r101285","name":"Perú","en":"Peru"},{"code":"PF","rid":"r100344","name":"Polinesia Francesa","en":"French Polynesia"},{"code":"PL","rid":"r100398","name":"Polonia","en":"Poland"},{"code":"PT","rid":"r101286","name":"Portugal","en":"Portugal"},{"code":"PR","rid":"r100013","name":"Puerto Rico","en":"Puerto Rico"},{"code":"GB","rid":"r101309","name":"Reino Unido","en":"United Kingdom"},{"code":"CF","rid":"r100320","name":"República Centroafricana","en":"Central African Republic"},{"code":"CZ","rid":"r101232","name":"República Checa","en":"Czech Republic"},{"code":"DO","rid":"r100333","name":"República Dominicana","en":"Dominican Republic"},{"code":"RE","rid":"r100400","name":"Reunión","en":"Reunion"},{"code":"RW","rid":"r101288","name":"Ruanda","en":"Rwanda"},{"code":"RO","rid":"r101287","name":"Rumania","en":"Romania"},{"code":"RU","rid":"r100401","name":"Rusia","en":"Russia"},{"code":"AS","rid":"r101565","name":"Samoa Americana","en":"American Samoa"},{"code":"BL","rid":"r101753","name":"San Bartolomé","en":"Saint Barthélemy"},{"code":"KN","rid":"r100402","name":"San Cristóbal y Nieves","en":"Saint Kitts-Nevis"},{"code":"MF","rid":"r101754","name":"San Martín (Francia)","en":"St. Martin"},{"code":"PM","rid":"r100419","name":"San Pedro y Miquelón","en":"St. Pierre-Miquelon"},{"code":"VC","rid":"r100404","name":"San Vicente y las Granadinas","en":"Saint Vincent-The Grenadines"},{"code":"SH","rid":"r100417","name":"Santa Elena, Ascensión y Tristán de Acuña","en":"St. Helena"},{"code":"LC","rid":"r100403","name":"Santa Lucía","en":"Saint Lucia"},{"code":"ST","rid":"r100406","name":"Santo Tomé y Príncipe","en":"Sao Tome-Principe"},{"code":"SN","rid":"r101292","name":"Senegal","en":"Senegal"},{"code":"RS","rid":"r101357","name":"Serbia","en":"Serbia"},{"code":"SC","rid":"r100408","name":"Seychelles","en":"Seychelles"},{"code":"SL","rid":"r100409","name":"Sierra Leona","en":"Sierra Leone"},{"code":"SG","rid":"r101293","name":"Singapur","en":"Singapore"},{"code":"SY","rid":"r101301","name":"Siria","en":"Syria"},{"code":"SO","rid":"r101294","name":"Somalia","en":"Somalia"},{"code":"LK","rid":"r101296","name":"Sri Lanka","en":"Sri Lanka"},{"code":"SZ","rid":"r100421","name":"Suazilandia","en":"Swaziland"},{"code":"ZA","rid":"r101295","name":"Sudáfrica","en":"South Africa"},{"code":"SD","rid":"r101298","name":"Sudán","en":"Sudan"},{"code":"SS","rid":"r102407","name":"Sudán del Sur","en":"South Sudan"},{"code":"SE","rid":"r101300","name":"Suecia","en":"Sweden"},{"code":"CH","rid":"r100422","name":"Suiza","en":"Switzerland"},{"code":"SR","rid":"r101299","name":"Surinam","en":"Suriname"},{"code":"TH","rid":"r101304","name":"Tailandia","en":"Thailand"},{"code":"TW","rid":"r101302","name":"Taiwán","en":"Taiwan"},{"code":"TZ","rid":"r101303","name":"Tanzania","en":"Tanzania"},{"code":"TL","rid":"r100334","name":"Timor Oriental","en":"East Timor"},{"code":"TG","rid":"r101305","name":"Togo","en":"Togo"},{"code":"TK","rid":"r100427","name":"Tokelau","en":"Tokelau"},{"code":"TO","rid":"r100428","name":"Tonga","en":"Tonga"},{"code":"TT","rid":"r100429","name":"Trinidad y Tobago","en":"Trinidad-Tobago"},{"code":"TR","rid":"r101308","name":"Turquía","en":"Turkey"},{"code":"TN","rid":"r101307","name":"Túnez","en":"Tunisia"},{"code":"UA","rid":"r100434","name":"Ucrania","en":"Ukraine"},{"code":"UG","rid":"r100433","name":"Uganda","en":"Uganda"},{"code":"UY","rid":"r101310","name":"Uruguay","en":"Uruguay"},{"code":"UZ","rid":"r101311","name":"Uzbekistán","en":"Uzbekistan"},{"code":"VE","rid":"r101313","name":"Venezuela","en":"Venezuela"},{"code":"VN","rid":"r101314","name":"Vietnam","en":"Vietnam"},{"code":"WF","rid":"r100443","name":"Wallis y Futuna","en":"Wallis-Futuna Islands"},{"code":"YE","rid":"r101315","name":"Yemen","en":"Yemen"},{"code":"ZM","rid":"r101316","name":"Zambia","en":"Zambia"},{"code":"ZW","rid":"r101317","name":"Zimbabue","en":"Zimbabwe"}]
