widget "red" {
  size: 3x3
  minSize: 3x2
  meta { owl: 5; description: "IP local, IP externa y nombre de la red. Toca una IP para copiarla; abre la pantalla para ver más y poner el nombre de la red."; version: "1.0"; license: "MIT"; category: "system" }

  requires { pacman: ["iproute2"] }

  // Interfaz e IPv4 local: "wlan0 192.168.1.178/24"
  source loc = cmd("ip -4 -o addr show scope global | awk '{print $2, $4}' | head -n1") every 30s
  // IP pública, proveedor y ubicación, pedidos desde Android
  source ext = http("https://ipinfo.io/json") every 10m timeout 10s json status

  // Android no deja que Linux lea el SSID: se escribe en la pantalla o con
  // owl-send 30-network.owl set ssid "MiWifi"
  state ssid = "" persist

  let iface = words(loc)[0]
  let cidr = words(loc)[1]
  let localIp = cidr == null ? null : split(cidr, "/")[0]
  let pub = ext == null ? null : ext.ok ? ext.out.ip : "sin conexión"
  let isp = ext.out.org == null ? null : trim(replace(ext.out.org, match(ext.out.org, "^(AS\\d+ )")[0] ?? "", ""))
  let netName = ssid != "" ? ssid : (isp ?? "…")

  onTap: screen()

  component Field(label, value, tint = foreground) {
    Column {
      gap: 0
      Text { text: label; style: label; color: muted; maxLines: 1 }
      Text { text: value; style: body; color: tint; font: mono; bold: true; maxLines: 1 }
    }
  }

  Column {
    gap: 8
    fill: true
    Row {
      align: center
      gap: 6
      Text { text: "red"; style: muted; weight: 1 }
      Text { text: iface ?? "sin red"; style: small; color: iface == null ? red : green; width: 60; align: end }
    }
    Column {
      gap: 0
      Text { text: ssid != "" ? "wi-fi" : "proveedor"; style: label; color: muted }
      Text { text: netName; fontSize: len(netName) > 14 ? 17 : 24; bold: true; color: accent; maxLines: 2 }
    }
    Box { onTap: copy(localIp); Field { label: "ip local"; value: localIp ?? "—" } }
    Box { onTap: copy(pub); Field { label: "ip externa"; value: pub ?? "…"; tint: ext.ok == false ? red : foreground } }
  }

  screen {
    title: "red"
    Column {
      gap: 14
      padding: 16
      scroll: true
      Column {
        gap: 4
        Text { text: "nombre de la red (wi-fi)"; style: label; color: muted }
        Input { text: ssid; placeholder: "escribe el nombre de tu wi-fi"; onSubmit: ssid = trim(value) }
        Text { text: "Android no deja que Linux lea el SSID; queda guardado aquí."; style: small; color: muted }
      }
      Field { label: "interfaz"; value: iface ?? "—" }
      Box { onTap: copy(localIp); Field { label: "ip local"; value: cidr ?? "—" } }
      Box { onTap: copy(pub); Field { label: "ip externa"; value: pub ?? "…" } }
      Field { label: "proveedor"; value: isp ?? "…" }
      Field { label: "ubicación"; value: ext.out.city == null ? "…" : "${ext.out.city}, ${ext.out.region}, ${ext.out.country}" }
      Row {
        Button { text: "copiar ip externa"; onTap: copy(pub) }
        Button { text: "actualizar"; onTap: refresh() }
      }
    }
  }
}
