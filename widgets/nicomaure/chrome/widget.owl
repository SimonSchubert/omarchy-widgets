widget "chrome" {
  size: 6x1
  minSize: 6x1
  padding: 10
  background: background

  meta { owl: 7; description: "Google search bar for Chrome: search, open URLs, Lens and AI Mode. Shortcuts like \"yt cats\"; type ? for the list."; version: "1.1.1"; license: "MIT"; category: "productivity" }

  state q = ""
  state tip = 0
  state go = ""
  // Which page screen() shows: the shortcut list, or (on a tall tile) the search field.
  state view = "help"

  // A tile taller than wide (the landscape home screen) has no room for a text
  // field, so the buttons stack and a search button opens the field in a screen.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3

  // Shortcuts: type "yt cats" to search YouTube, "m coffee" for Maps, and so on.
  // Add your own here; they show up in the help screen (type ? and enter) too.
  let shortcuts = [
    { key: "yt",  name: "YouTube",   example: "lofi music",     url: "https://www.youtube.com/results?search_query=" },
    { key: "m",   name: "Maps",      example: "coffee near me", url: "https://www.google.com/maps/search/?api=1&query=" },
    { key: "tr",  name: "Translate", example: "good morning",   url: "https://translate.google.com/?sl=auto&op=translate&text=" },
    { key: "w",   name: "Wikipedia", example: "Buenos Aires",   url: "https://en.wikipedia.org/wiki/Special:Search?search=" },
    { key: "img", name: "Images",    example: "aurora borealis", url: "https://www.google.com/search?udm=2&q=" },
    { key: "ai",  name: "AI Mode",   example: "plan a weekend trip", url: "https://www.google.com/search?udm=50&q=" }
  ]

  // The empty bar cycles through tips, so the shortcuts teach themselves.
  let tips = ["search or type a URL…", "try:  yt lofi music", "try:  m coffee near me", "try:  tr good morning", "type ?  to see all shortcuts"]
  every 4s { tip = (tip + 1) % 5 }

  let t = trim(q)
  let pm = match(t, "^([A-Za-z]+)\\s+(.+)$")
  let engine = pm == null ? null : shortcuts.find(e => e.key == lower(pm[0]))
  let body = engine == null ? t : trim(pm[1])
  let wantsHelp = t == "?" || lower(t) == "help"

  // Something like "github.com" or "https://x.org/path" opens directly.
  let isUrl = engine == null && match(t, "^(https?://)?[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}(:[0-9]+)?(/\\S*)?$") != null
  let site = startsWith(lower(t), "http") ? t : "https://" + t

  // url() takes the query as typed, so encode what a query string can't carry.
  let enc = replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(body, "%", "%25"), "&", "%26"), "#", "%23"), "?", "%3F"), "+", "%2B"), " ", "+"), "\"", "%22"), "<", "%3C"), ">", "%3E"), "^", "%5E"), "|", "%7C")

  let target = wantsHelp ? "help" : t == "" ? "https://www.google.com/" : isUrl ? site : (engine == null ? "https://www.google.com/search?q=" : engine.url) + enc

  // Handlers can't branch, so submitting parks the target in `go` and these act on it.
  when go == "help" { view = "help"; screen(); go = "" }
  when go != "" && go != "help" && go != "pick" { url(go); go = "" }
  // Picking a shortcut drops back to the tile's field, or on a tall tile (no field)
  // switches the screen to its search page.
  when go == "pick" && !tall { close(); go = "" }
  when go == "pick" && tall { go = "" }

  component LensIcon() {
    Canvas {
      size: 28
      path([[3, 12], [3, 8], [3.6, 5.6], [5.6, 3.6], [8, 3], [12, 3]], stroke: "#4285F4", width: 2.6, cap: round)
      path([[16, 3], [20, 3], [22.4, 3.6], [24.4, 5.6], [25, 8], [25, 12]], stroke: "#EA4335", width: 2.6, cap: round)
      path([[3, 16], [3, 20], [3.6, 22.4], [5.6, 24.4], [8, 25], [12, 25]], stroke: "#FBBC04", width: 2.6, cap: round)
      circle(14, 14, 4.6, stroke: "#4285F4", width: 2.6)
      circle(21.5, 21.5, 2.8, fill: "#34A853")
    }
  }

  component AiIcon() {
    Canvas {
      size: 28
      path([[13, 3], [15.2, 10.8], [23, 13], [15.2, 15.2], [13, 23], [10.8, 15.2], [3, 13], [10.8, 10.8]], closed: true, fill: linear(3, 3, 23, 23, ["#4285F4", "#9B72CB", "#D96570"]))
      path([[22, 18], [23, 21], [26, 22], [23, 23], [22, 26], [21, 23], [18, 22], [21, 21]], closed: true, fill: "#9B72CB")
    }
  }

  component Chip(label) {
    Box {
      width: len(label) * 7.5 + 16
      height: 24
      align: center
      radius: 3 * corners
      background: alpha(accent, 0.18)
      Text { text: label; fontSize: 12; bold: true; color: accent; maxLines: 1; align: center; fill: width }
    }
  }

  component SearchIcon() {
    Canvas {
      size: 28
      circle(12, 12, 7.5, stroke: foreground, width: 2.6)
      path([[17.5, 17.5], [24, 24]], stroke: foreground, width: 2.6, cap: round)
    }
  }

  if tall {
    Column {
      fill: true
      align: center
      justify: spaceEvenly

      Box {
        size: 46
        align: center
        onTap: { haptic(); androidApp("com.android.chrome") }
        Image { src: "app:com.android.chrome"; size: 32 }
      }

      Box {
        size: 46
        align: center
        onTap: { haptic(); view = "search"; screen() }
        SearchIcon {}
      }

      Box {
        size: 46
        align: center
        onTap: { haptic(); androidApp("com.google.android.googlequicksearchbox") }
        LensIcon {}
      }

      Box {
        size: 46
        align: center
        onTap: { haptic(); url("https://www.google.com/search?udm=50"); q = "" }
        AiIcon {}
      }
    }
  } else {
  Row {
    gap: 6
    align: center
    fill: true

    Box {
      size: 50
      align: center
      onTap: { haptic(); androidApp("com.android.chrome") }
      Image { src: "app:com.android.chrome"; size: 32 }
    }

    if engine != null {
      Chip { label: engine.name }
    } else if isUrl {
      Chip { label: "Go ↗" }
    }

    Box {
      weight: 1
      height: 54
      align: bottomStart
      Input {
        text: q
        placeholder: tips[tip]
        color: foreground
        fill: width
        height: 54
        fontSize: 16
        offset: [0, 5]
        onChange: q = value
        onSubmit: { go = target; q = "" }
      }
      // Input draws a hairline under itself and won't take a border of 0, so the
      // strip below covers it in the tile's own color.
      Box { height: 6; fill: width; offset: [0, 7]; background: background }
    }

    // Google Lens lives inside the Google app; tap its Lens icon there.
    Box {
      size: 46
      align: center
      onTap: { haptic(); androidApp("com.google.android.googlequicksearchbox") }
      LensIcon {}
    }

    // AI Mode, with whatever is typed (minus any shortcut) as the question.
    Box {
      size: 46
      align: center
      onTap: { haptic(); url("https://www.google.com/search?udm=50" + (body == "" ? "" : "&q=" + enc)); q = "" }
      AiIcon {}
    }
  }
  }

  component HelpRow(icon, title, hint) {
    Row {
      gap: 14
      align: center
      Box { width: 56; height: 30; align: center; radius: 3 * corners; background: alpha(accent, 0.18)
        Text { text: icon; font: mono; bold: true; color: accent; fontSize: 14; align: center; fill: width }
      }
      Column {
        weight: 1
        gap: 2
        Text { text: title; bold: true; fontSize: 15; color: foreground }
        Text { text: hint; fontSize: 13; color: muted; maxLines: 1 }
      }
    }
  }

  screen {
    title: view == "search" ? "search" : "shortcuts"
    if view == "search" {
      Column {
        gap: 14
        padding: 18

        Row {
          gap: 10
          align: center
          if engine != null {
            Chip { label: engine.name }
          } else if isUrl {
            Chip { label: "Go ↗" }
          }
          Input {
            text: q
            placeholder: "search or type a URL…"
            focus: true
            weight: 1
            fontSize: 16
            onChange: q = value
            onSubmit: { close(); go = target; q = "" }
          }
        }

        Row {
          gap: 10
          align: center
          Box {
            size: 46
            align: center
            onTap: { haptic(); androidApp("com.google.android.googlequicksearchbox") }
            LensIcon {}
          }
          Box {
            size: 46
            align: center
            onTap: { haptic(); url("https://www.google.com/search?udm=50" + (body == "" ? "" : "&q=" + enc)); q = "" }
            AiIcon {}
          }
          Spacer { weight: 1 }
          Box {
            height: 34
            padding: [12, 0]
            align: center
            radius: 3 * corners
            background: alpha(accent, 0.18)
            onTap: { haptic(); view = "help" }
            Text { text: "shortcuts"; bold: true; fontSize: 13; color: accent }
          }
        }
      }
    } else {
    Column {
      scroll: true
      gap: 18
      padding: 18

      Text { text: "Type a shortcut, a space, then what you're looking for. Tap one to try it."; color: muted; fontSize: 14 }

      for s in shortcuts key s.key {
        Box {
          fill: width
          onTap: { haptic(); q = s.key + " "; view = "search"; go = "pick" }
          HelpRow { icon: s.key; title: s.name; hint: "${s.key} ${s.example}" }
        }
      }

      Box { height: 1; fill: width; background: border }

      HelpRow { icon: "↗"; title: "Open a site"; hint: "github.com, then enter" }

      Row {
        gap: 14
        align: center
        Box { width: 56; height: 30; align: center; LensIcon {} }
        Column {
          weight: 1
          gap: 2
          Text { text: "Lens button"; bold: true; fontSize: 15; color: foreground }
          Text { text: "opens Google, then tap Lens"; fontSize: 13; color: muted; maxLines: 1 }
        }
      }

      Row {
        gap: 14
        align: center
        Box { width: 56; height: 30; align: center; AiIcon {} }
        Column {
          weight: 1
          gap: 2
          Text { text: "AI button"; bold: true; fontSize: 15; color: foreground }
          Text { text: "asks Google AI what you typed"; fontSize: 13; color: muted; maxLines: 1 }
        }
      }
    }
    }
  }
}
