widget "transcrivoz" {
  size: 6x3
  minSize: 3x3
  meta {
    owl: 7
    description: "One-tap controller for TranscriVoz AI transcription. Runs on 127.0.0.1:5050 in desktop mode without a password, so other apps on the phone could use the saved API key."
    version: "3.1"
    license: "MIT"
    category: "productivity"
  }
  requires { pacman: ["python", "jq", "git", "ffmpeg"] }
  source live = file("~/.cache/omalauncher-transcrivoz/state.json") json
  source probe = cmd("""f=~/.cache/omalauncher-transcrivoz/ctl.sh
if ! grep -q "^# v3.0" "$f" 2>/dev/null; then
mkdir -p ~/.cache/omalauncher-transcrivoz
cat > "$f.tmp" <<'SH'
#!/bin/bash
# v3.0
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
C="$HOME/.cache/omalauncher-transcrivoz"
R="$HOME/TranscriVoz"
V="$R/venv"
SF="$C/state.json"
LF="$C/busy.pid"
SHA="f0d2119aebd49e7db92b06e52f919fe98f0d0111"
DEPS="Flask==3.1.3 gunicorn==26.2.0 gevent==26.9.0 groq==1.7.0 openai==3.33.0 python-dotenv==1.2.4 yt-dlp==2026.8.19 gdown==5.2.2"

emit() {
  local ph="${1:-idle}" pr="${2:-0}" msg="${3:-}" err="${4:-}"
  if [ "$ph" = auto ] && [ -s "$SF" ]; then
    local bp=$(cat "$LF" 2>/dev/null)
    if [ -n "$bp" ] && kill -0 "$bp" 2>/dev/null; then cat "$SF"; return; fi
    err=$(jq -r '.error//empty' "$SF" 2>/dev/null)
    ph=idle; pr=100; msg=""
  fi
  local hr=false hv=false hf=false ok=false run=false hk=false pv=groq md=whisper-large-v3-turbo
  [ -f "$R/app.py" ] && [ -f "$R/templates/index.html" ] && hr=true
  [ -x "$V/bin/flask" ] && [ -x "$V/bin/yt-dlp" ] && hv=true
  command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null && hf=true
  $hr && $hv && $hf && ok=true
  [ "$ph" = idle ] && { $ok && pr=100 || pr=0; }
  (exec 3<>/dev/tcp/127.0.0.1/5050) 2>/dev/null && run=true
  local cfg="$HOME/.config/transcrivoz/config.json"
  if [ -s "$cfg" ]; then
    pv=$(jq -r '.provider//"groq"' "$cfg" 2>/dev/null)
    md=$(jq -r '.model//"whisper-large-v3-turbo"' "$cfg" 2>/dev/null)
    jq -e '(.api_keys.groq//"")!="" or (.api_keys.openai//"")!=""' "$cfg" >/dev/null 2>&1 && hk=true
  fi
  grep -qE '^(GROQ|OPENAI)_API_KEY=.+' "$R/.env" 2>/dev/null && hk=true
  local js
  js=$(jq -nc --arg ph "$ph" --arg msg "$msg" --arg err "$err" --arg pv "$pv" --arg md "$md" \
    --argjson ok $ok --argjson hr $hr --argjson hv $hv --argjson hf $hf --argjson rn $run --argjson hk $hk --argjson pr $pr \
    '{installed:$ok,has_repo:$hr,has_venv:$hv,has_ffmpeg:$hf,running:$rn,url:"http://127.0.0.1:5050",provider:$pv,model:$md,has_key:$hk,phase:$ph,progress:$pr,step_msg:$msg,error:$err}')
  if [ "$js" != "$(cat "$SF" 2>/dev/null)" ]; then
    printf '%s\n' "$js" > "$SF.$$" && mv "$SF.$$" "$SF"
  fi
  printf '%s\n' "$js"
}

srv() {
  pkill -f "TranscriVoz/app.py" 2>/dev/null || true; sleep 0.2
  TRANSCRIVOZ_DESKTOP=1 PYTHONUNBUFFERED=1 nohup "$V/bin/python3" -u "$R/app.py" </dev/null >"$C/server.log" 2>&1 &
  for _ in $(seq 1 40); do (exec 3<>/dev/tcp/127.0.0.1/5050) 2>/dev/null && return 0; sleep 0.2; done
  return 1
}

inst() {
  echo $$ > "$LF"; trap 'rm -f "$LF"' EXIT
  emit installing 10 "Step 1/4 · Checking FFmpeg & Git…" "" >/dev/null
  command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null && command -v git >/dev/null || {
    emit idle 0 "" "Missing FFmpeg or Git. Install required packages first." >/dev/null; exit 1
  }
  emit installing 35 "Step 2/4 · Fetching TranscriVoz (${SHA:0:7})…" "" >/dev/null
  if [ ! -d "$R/.git" ]; then
    rm -rf "$R"
    git clone https://github.com/nicomaure/TranscriVoz.git "$R" >/dev/null 2>&1 || { emit idle 0 "" "Failed to clone repository." >/dev/null; exit 1; }
  fi
  if [ "$(git -C "$R" rev-parse HEAD 2>/dev/null)" != "$SHA" ]; then
    git -C "$R" fetch origin "$SHA" >/dev/null 2>&1 || git -C "$R" fetch --all >/dev/null 2>&1 || true
    git -C "$R" checkout -f "$SHA" >/dev/null 2>&1 || { emit idle 0 "" "Failed to checkout pinned commit." >/dev/null; exit 1; }
  fi
  emit installing 60 "Step 3/4 · Creating Python virtual environment…" "" >/dev/null
  [ -x "$V/bin/pip" ] || { rm -rf "$V"; python3 -m venv "$V" >/dev/null 2>&1 || { emit idle 0 "" "Failed to create venv." >/dev/null; exit 1; }; }
  emit installing 80 "Step 4/4 · Installing pinned Python packages…" "" >/dev/null
  "$V/bin/pip" install --no-input -q $DEPS >/dev/null 2>&1 || { emit idle 0 "" "Failed installing Python packages." >/dev/null; exit 1; }
  emit starting 95 "Starting TranscriVoz server on port 5050…" "" >/dev/null
  rm -f "$LF"
  srv && emit idle 100 "" "" >/dev/null || emit idle 0 "" "Server failed to start on port 5050." >/dev/null
  owl-send ~/.config/omalauncher/widgets/transcrivoz.owl refresh >/dev/null 2>&1 || true
}

case "${1:-status}" in
  _i) inst ;;
  _s) [ -x "$V/bin/flask" ] && command -v ffmpeg >/dev/null || { inst; exit 0; }
      echo $$ > "$LF"; emit starting 50 "Activating venv & starting server…" "" >/dev/null; rm -f "$LF"
      srv && emit idle 100 "" "" >/dev/null || emit idle 0 "" "Server failed to start." >/dev/null
      owl-send ~/.config/omalauncher/widgets/transcrivoz.owl refresh >/dev/null 2>&1 || true ;;
  install) nohup "$0" _i </dev/null >/dev/null 2>&1 & emit installing 6 "Step 1/4 · Preparing installation…" "" ;;
  start|restart) nohup "$0" _s </dev/null >/dev/null 2>&1 & emit starting 40 "Activating venv & starting server…" "" ;;
  stop) pkill -f "TranscriVoz/app.py" 2>/dev/null || true; sleep 0.2; emit idle 100 "" "" ;;
  clean) rm -rf /tmp/transcriptor-* 2>/dev/null || true; emit idle 100 "" "" ;;
  link) python3 -c 'import zlib,base64,pathlib;w= sorted(pathlib.Path.home().glob(".config/omalauncher/widgets/*transcrivoz*.owl"))[0];print("https://simonschubert.github.io/omarchy-widgets/w#owl1."+base64.urlsafe_b64encode(zlib.compress(w.read_bytes(),9)[2:-4]).decode().rstrip("="))' ;;
  reset) rm -f "$LF"; emit idle 100 "" "" ;;
  *) emit auto 0 "" "" ;;
esac
SH
chmod +x "$f.tmp" && mv "$f.tmp" "$f"
bash "$f" reset
else
bash "$f" status
fi""") every 5s json timeout 15s

  let info = (live.installed != null) ? live : probe
  let isInstalled = info.installed ?? false
  let hasRepo = info.has_repo ?? false
  let hasVenv = info.has_venv ?? false
  let hasFfmpeg = info.has_ffmpeg ?? false
  let isRunning = info.running ?? false
  let hasKey = info.has_key ?? false
  let provider = info.provider ?? "groq"
  let model = info.model ?? "whisper-large-v3-turbo"
  let phase = info.phase ?? "idle"
  let isBusy = phase != "idle"
  let progress = info.progress ?? 0
  let stepMsg = info.step_msg ?? ""
  let errMsg = info.error ?? ""
  let appUrl = "http://127.0.0.1:5050"

  state openWhenReady = false
  when isRunning && openWhenReady { openWhenReady = false; url(appUrl) }
  when errMsg != "" && openWhenReady { openWhenReady = false }

  state shareLink = ""
  when shareLink != "" {
    share(shareLink)
    shareLink = ""
  }

  let compact = (tileWidth ?? 400) < 300
  let tall = (tileHeight ?? 0) > (tileWidth ?? 400) * 1.3
  let statusText = isBusy ? "◌ ${phase}…" : !isInstalled ? "○ not installed" : isRunning ? "● active :5050" : "○ venv stopped"
  let statusColor = isBusy ? cyan : !isInstalled ? yellow : isRunning ? green : muted

  component CheckBadge(label, ok, warn = false) {
    Box {
      weight: 1; padding: [6, 4]; radius: 4 * corners
      background: alpha(ok ? green : warn ? yellow : muted, 0.14)
      border: 1; borderColor: alpha(ok ? green : warn ? yellow : border, 0.4)
      align: center
      Text { text: "${ok ? "✓" : warn ? "⚙" : "○"} ${label}"; fontSize: 11; color: ok ? green : warn ? yellow : muted; align: center; maxLines: 1; fill: width }
    }
  }

  component Badges(grid = false) {
    if grid {
      Column {
        gap: 6
        Row {
          gap: 6
          CheckBadge { label: "FFmpeg"; ok: hasFfmpeg }
          CheckBadge { label: "Repo"; ok: hasRepo }
        }
        Row {
          gap: 6
          CheckBadge { label: "Venv"; ok: hasVenv }
          CheckBadge { label: hasKey ? "API Key" : "Web Key"; ok: hasKey; warn: isInstalled && !hasKey }
        }
      }
    } else {
    Row {
      gap: 6
      CheckBadge { label: "FFmpeg"; ok: hasFfmpeg }
      CheckBadge { label: "Repo"; ok: hasRepo }
      CheckBadge { label: "Venv"; ok: hasVenv }
      CheckBadge { label: hasKey ? "API Key" : "Web Key"; ok: hasKey; warn: isInstalled && !hasKey }
    }
    }
  }

  onTap: screen()

  Column {
    gap: 6; fill: true
    if compact {
      Text { text: "TranscriVoz"; style: title; color: accent; maxLines: 1 }
      Text { text: statusText; style: small; color: statusColor; maxLines: 1 }
    } else {
      Row {
        align: center
        Text { text: "TranscriVoz"; style: title; color: accent; weight: 1 }
        Text { text: statusText; style: small; color: statusColor; width: 145; maxLines: 1; align: end }
      }
    }
    Text {
      text: isBusy ? (stepMsg != "" ? stepMsg : "Working, please wait…")
        : errMsg != "" ? errMsg
        : !isInstalled ? "First time? Tap Install for automatic setup (repo + venv + deps)."
        : isRunning ? (hasKey ? "Server ready · ${upper(provider)} (${model})" : "Server ready · Open web app & tap ⚙️ to paste your API key")
        : "Ready · Activate venv or tap Open Browser to launch"
      style: small
      color: errMsg != "" ? red : (isRunning && !hasKey) ? yellow : isBusy ? foreground : muted
      maxLines: tall ? 4 : errMsg != "" ? 2 : 1
    }
    Spacer { weight: 1 }
    if isBusy {
      Progress { value: progress; max: 100; color: accent; animate value: spring() }
    } else if !compact {
      Badges {}
    } else if tall {
      Badges { grid: true }
    }
    Spacer { weight: 1 }
    Row {
      gap: 6
      if isBusy {
        Button { text: "Working, please wait… (Tap for progress)"; color: muted; fill: width; onTap: screen() }
      } else if !isInstalled {
        Button { text: compact ? "Install" : (errMsg != "" ? "Retry Install (Auto)" : "1. Install (Auto Setup)"); color: accent; weight: 2; onTap: { haptic(); openWhenReady = true; run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh install") } }
        Button { text: "Guide"; color: muted; weight: 1; onTap: screen() }
      } else {
        if !compact { Button { text: "Install / Fix"; color: muted; weight: 1; onTap: { haptic(); run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh install") } } }
        if isRunning {
          Button { text: "Deactivate"; color: red; weight: 1; onTap: { haptic(); openWhenReady = false; run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh stop") } }
          Button { text: compact ? "Open" : "Open Browser ↗"; color: accent; weight: 2; onTap: { haptic(); url(appUrl) } }
        } else {
          Button { text: "Activate"; color: green; weight: 1; onTap: { haptic(); run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh start") } }
          Button { text: compact ? "Open" : "Open Browser ↗"; color: accent; weight: 2; onTap: { haptic(); openWhenReady = true; run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh start") } }
        }
      }
    }
  }

  screen {
    title: "TranscriVoz"
    Column {
      gap: 14; padding: 16; scroll: true
      Column {
        gap: 6
        Text { text: "SERVICE & VENV STATUS"; style: label; color: muted }
        Text { text: statusText; style: title; color: statusColor }
        Badges {}
        if isRunning { Text { text: "Local URL: ${appUrl}"; style: small; color: muted } }
        if isInstalled {
          Text {
            text: hasKey ? "API Key: Configured (${upper(provider)} · ${model})" : "API Key: Set it directly inside the web app's ⚙️ Settings menu"
            style: small; color: hasKey ? green : yellow
          }
        }
        if isBusy {
          Text { text: stepMsg; style: small; color: foreground }
          Progress { value: progress; max: 100; color: accent; animate value: spring() }
        }
        if errMsg != "" { Text { text: errMsg; style: small; color: red } }
      }
      Column {
        gap: 8
        Text { text: "MAIN ACTIONS"; style: label; color: muted }
        if isBusy {
          Button { text: "Operation in progress — please wait…"; color: muted; fill: width; onTap: haptic() }
        } else {
          if isRunning {
            Button { text: "Open TranscriVoz in Browser ↗"; color: accent; fill: width; onTap: { haptic(); url(appUrl) } }
            Row {
              gap: 8
              Button { text: "Deactivate (Stop venv)"; color: red; weight: 1; onTap: { haptic(); openWhenReady = false; run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh stop") } }
              Button { text: "Restart Server"; weight: 1; onTap: { haptic(); run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh restart") } }
            }
          } else {
            Button { text: "Activate & Open in Browser ↗"; color: accent; fill: width; onTap: { haptic(); openWhenReady = true; run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh start") } }
            Button { text: "Activate Server (Start venv)"; color: green; fill: width; onTap: { haptic(); run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh start") } }
          }
          Button { text: isInstalled ? "First-Time Install / Repair Setup (Auto)" : "First-Time Install (Automated Setup)"; color: isInstalled ? muted : accent; fill: width; onTap: { haptic(); run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh install") } }
        }
      }
      Column {
        gap: 6
        Text { text: "HOW IT WORKS (FOR BEGINNERS)"; style: label; color: muted }
        Text {
          text: "1. Install (First Time): Clones TranscriVoz at pinned commit f0d2119, creates the Python venv, and installs pinned packages.\n2. Activate / Deactivate: Starts or stops the local Python server on 127.0.0.1:5050 in Desktop Mode (no password, so other local apps on the phone could use the saved API key while running).\n3. Open Browser & Set API Key: Opens http://127.0.0.1:5050. Tap the ⚙️ icon in the web app to paste your free Groq or OpenAI API key."
          style: small; color: muted
        }
        Button { text: "Get a Free Groq API Key (console.groq.com) ↗"; fill: width; onTap: url("https://console.groq.com/keys") }
      }
      Column {
        gap: 6
        Text { text: "MAINTENANCE & SHARING"; style: label; color: muted }
        Button { text: "Share Widget Link (Omalauncher) ↗"; color: accent; fill: width; onTap: { haptic(); shareLink = run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh link") } }
        Button { text: "Clear Temporary Audio Cache"; fill: width; onTap: { haptic(); run("bash ~/.cache/omalauncher-transcrivoz/ctl.sh clean") } }
        Button { text: "GitHub Repository (nicomaure/TranscriVoz) ↗"; fill: width; onTap: url("https://github.com/nicomaure/TranscriVoz") }
      }
      Spacer { height: 8 }
      Button { text: "Close"; fill: width; onTap: close() }
    }
  }
}
