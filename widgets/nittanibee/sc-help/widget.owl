  size: 3x4
  minSize: 3x4
  onTap: screen()

  // One tappable resource: a glyph, what it is, and what you can do there.
  component Card(glyph, name, note, href, tint = accent) {
    Row {
      gap: 10
      padding: [12, 9]
      background: alpha(surface, 0.5)
      border: 1
      borderColor: alpha(foreground, 0.07)
      radius: 10 * corners
      onTap: url(href)
      Box {
        width: 38
        height: 38
        background: alpha(tint, 0.16)
        radius: 9 * corners
        align: center
        Text { text: glyph; fontSize: 10; bold: true; color: tint; align: center; maxLines: 1 }
      }
      Column {
        weight: 1
        gap: 2
        Text { text: name; bold: true; maxLines: 2 }
        Text { text: note; style: small; color: muted; maxLines: 3 }
      }
      Text { text: "›"; fontSize: 22; color: alpha(foreground, 0.35) }
    }
  }

  // A smaller link on the tile itself.
  component Mini(glyph, name, note, href, tint = accent) {
    Row {
      gap: 9
      padding: [10, 7]
      background: alpha(surface, 0.5)
      border: 1
      borderColor: alpha(foreground, 0.07)
      radius: 9 * corners
      onTap: url(href)
      Box {
        width: 28
        height: 28
        background: alpha(tint, 0.16)
        radius: 7 * corners
        align: center
        Text { text: glyph; fontSize: 8; bold: true; color: tint; align: center; maxLines: 1 }
      }
      Column {
        weight: 1
        gap: 1
        Text { text: name; bold: true; style: small; maxLines: 1 }
        Text { text: note; style: small; color: muted; maxLines: 1 }
      }
      Text { text: "›"; fontSize: 18; color: alpha(foreground, 0.35) }
    }
  }

  // A heading in the full-screen list.
  component Section(title, note = "") {
    Row {
      gap: 8
      align: bottom
      padding: [2, 10]
      Text { text: title; bold: true; fontSize: 17; color: accent; weight: 1; maxLines: 1 }
      Text { text: note; style: small; color: muted; maxLines: 1; align: end }
    }
  }

  Column {
    gap: 6

    Row {
      align: center
      gap: 8
      Column {
        weight: 1
        gap: 1
        Text { text: str.title; style: title; maxLines: 1 }
        Text { text: str.tagline; style: small; color: muted; maxLines: 1 }
      }
      Box {
        width: 38
        height: 38
        background: alpha(accent, 0.18)
        radius: 10 * corners
        align: center
        Text { text: "SC"; fontSize: 12; bold: true; color: accent; align: center }
      }
    }

    Column {
      gap: 2
      padding: [12, 9]
      background: alpha(red, 0.16)
      border: 1
      borderColor: alpha(red, 0.35)
      radius: 12 * corners
      onTap: url("tel:8668929211")
      Text { text: str.call211; fontSize: 19; bold: true; color: red; maxLines: 1 }
      Text { text: str.call211Note; style: small; maxLines: 1 }
      Text { text: str.call211Text; style: small; color: muted; maxLines: 1 }
    }

    Row {
      gap: 8
      Column {
        weight: 1
        gap: 1
        padding: [10, 7]
        background: alpha(magenta, 0.13)
        radius: 9 * corners
        onTap: url("tel:988")
        Text { text: "988"; bold: true; fontSize: 16; color: magenta }
        Text { text: str.crisisLine; style: small; color: muted; maxLines: 1 }
      }
      Column {
        weight: 1
        gap: 1
        padding: [10, 7]
        background: alpha(red, 0.13)
        radius: 9 * corners
        onTap: url("tel:18007997233")
        Text { text: "DV"; bold: true; fontSize: 16; color: red }
        Text { text: str.safetyLine; style: small; color: muted; maxLines: 1 }
      }
    }

    Mini { glyph: "$$"; name: str.snapMedicaid; note: str.applyOrLogIn; href: "https://benefitsportal.dss.sc.gov/#/login"; tint: green }

    Spacer { weight: 1 }

    Row {
      align: center
      gap: 6
      Text { text: str.tapForShelters; style: small; color: accent; weight: 1; maxLines: 1 }
      Text { text: "›"; fontSize: 20; color: accent }
    }
  }

  screen {
    title: str.screenTitle
    Column {
      scroll: true
      gap: 14
      padding: [16, 10]

      Column {
        gap: 3
        Text { text: str.screenTitle; style: title }
        Text { text: str.intro; style: small; color: muted; maxLines: 3 }
      }

      Row {
        gap: 10
        Column {
          weight: 1
          gap: 2
          padding: [12, 10]
          background: alpha(red, 0.16)
          border: 1
          borderColor: alpha(red, 0.35)
          radius: 12 * corners
          onTap: url("tel:8668929211")
          Text { text: str.call211; bold: true; fontSize: 17; color: red }
          Text { text: str.statewideReferrals; style: small; color: muted; maxLines: 1 }
        }
        Column {
          weight: 1
          gap: 2
          padding: [12, 10]
          background: alpha(magenta, 0.14)
          border: 1
          borderColor: alpha(magenta, 0.3)
          radius: 12 * corners
          onTap: url("tel:988")
          Text { text: "988"; bold: true; fontSize: 17; color: magenta }
          Text { text: str.crisisLifeline; style: small; color: muted; maxLines: 1 }
        }
      }

      Section { title: str.urgent; note: str.urgentNote }
      Card { glyph: "211"; name: str.sc211; note: str.sc211Note; href: "https://resources.sc211.org/#/"; tint: red }
      Card { glyph: "988"; name: str.lifeline988; note: str.lifeline988Note; href: "tel:988"; tint: magenta }
      Card { glyph: "DV"; name: str.dvHotline; note: str.dvHotlineNote; href: "https://www.thehotline.org/"; tint: red }
      Card { glyph: "SC"; name: str.sistercare; note: str.sistercareNote; href: "https://www.sistercare.org/"; tint: red }
      Card { glyph: "VET"; name: str.vetCrisis; note: str.vetCrisisNote; href: "https://www.veteranscrisisline.net/"; tint: blue }
      Card { glyph: "MED"; name: str.mobileCrisis; note: str.mobileCrisisNote; href: "tel:18333642274"; tint: cyan }
      Card { glyph: "RX"; name: str.findTreatment; note: str.findTreatmentNote; href: "https://findtreatment.gov/"; tint: cyan }

      Section { title: str.coordinatedEntry; note: str.coordinatedEntryNote }
      Card { glyph: "CE"; name: str.ceUpstate; note: str.ceUpstateNote; href: "https://www.upstatecoc.org/coordinated-entry"; tint: green }
      Card { glyph: "CE"; name: str.ceMidlands; note: str.ceMidlandsNote; href: "https://www.midlandshomeless.com/find-help"; tint: green }
      Card { glyph: "CE"; name: str.cePeeDee; note: str.cePeeDeeNote; href: "https://gethelp.tchcsc.org"; tint: green }
      Card { glyph: "CE"; name: str.ceLowcountry; note: str.ceLowcountryNote; href: "https://lowcountrycoc.org/gethelp"; tint: green }

      Section { title: str.shelterTonight; note: str.shelterTonightNote }
      Card { glyph: "BED"; name: str.one80; note: str.one80Note; href: "https://one80place.org/gethelp"; tint: orange }
      Card { glyph: "BED"; name: str.oliverGospel; note: str.oliverGospelNote; href: "https://www.olivergospel.org/"; tint: orange }
      Card { glyph: "BED"; name: str.transitions; note: str.transitionsNote; href: "https://www.transitionssc.org/"; tint: orange }
      Card { glyph: "FAM"; name: str.homelessNoMore; note: str.homelessNoMoreNote; href: "https://www.homelessnomoresc.org/"; tint: orange }
      Card { glyph: "WOM"; name: str.womensShelter; note: str.womensShelterNote; href: "https://www.womenshelter.org/"; tint: orange }
      Card { glyph: "YTH"; name: str.palmettoPlace; note: str.palmettoPlaceNote; href: "https://www.palmettoplace.org/"; tint: orange }
      Card { glyph: "BED"; name: str.miracleHill; note: str.miracleHillNote; href: "https://miraclehill.org/"; tint: orange }
      Card { glyph: "BED"; name: str.salvationArmy; note: str.salvationArmyNote; href: "https://www.salvationarmyusa.org/usa-southern-territory/north-and-south-carolina/greenville-sc-area-command/homelessness/"; tint: orange }
      Card { glyph: "FAM"; name: str.familyPromise; note: str.familyPromiseNote; href: "https://www.familypromisemidlands.org/"; tint: orange }
      Card { glyph: "SC"; name: str.greenvilleGuide; note: str.greenvilleGuideNote; href: "https://www.greenvillesc.gov/homeless-services-resource-guide"; tint: orange }

      Section { title: str.applyLogIn; note: str.applyLogInNote }
      Card { glyph: "DSS"; name: str.dssBenefits; note: str.dssBenefitsNote; href: "https://benefitsportal.dss.sc.gov/#/login"; tint: green }
      Card { glyph: "DSS"; name: str.dssTrack; note: str.dssTrackNote; href: "https://benefitsportal.dss.sc.gov/#/benefits/track"; tint: green }
      Card { glyph: "DSS"; name: str.dssSignIn; note: str.dssSignInNote; href: "https://portal.dss.sc.gov/login.aspx"; tint: green }
      Card { glyph: "MED"; name: str.medicaidApply; note: str.medicaidApplyNote; href: "https://apply.scdhhs.gov/"; tint: cyan }
      Card { glyph: "MED"; name: str.medicaidPortal; note: str.medicaidPortalNote; href: "https://apply.scdhhs.gov/CitizenPortal/"; tint: cyan }
      Card { glyph: "MED"; name: str.medicaidStart; note: str.medicaidStartNote; href: "https://www.scdhhs.gov/members/getting-started"; tint: cyan }
      Card { glyph: "$$"; name: str.scThrive; note: str.scThriveNote; href: "https://scthrive.org/for-you/apply-for-benefits/"; tint: green }
      Card { glyph: "$$"; name: str.thriveHub; note: str.thriveHubNote; href: "https://scthrive.goodgrid.com/"; tint: green }
      Card { glyph: "EBT"; name: str.ebt; note: str.ebtNote; href: "https://www.connectebt.com/ebtconnect/recipient/SC/"; tint: yellow }
      Card { glyph: "SSA"; name: str.ssaAccount; note: str.ssaAccountNote; href: "https://www.ssa.gov/myaccount/"; tint: blue }
      Card { glyph: "SSA"; name: str.ssaSsi; note: str.ssaSsiNote; href: "https://www.ssa.gov/apply/ssi"; tint: blue }
      Card { glyph: "JOB"; name: str.scWorksJobSeeker; note: str.scWorksJobSeekerNote; href: "https://jobs.scworks.org/"; tint: yellow }
      Card { glyph: "WIC"; name: str.wicApply; note: str.wicApplyNote; href: "https://apps.dhec.sc.gov/Health/WIC"; tint: yellow }

      Section { title: str.housingRent; note: str.housingRentNote }
      Card { glyph: "HUD"; name: str.hcv; note: str.hcvNote; href: "https://www.schousing.com/Home/RentersHousingChoiceVoucher"; tint: blue }
      Card { glyph: "HUD"; name: str.scHousing; note: str.scHousingNote; href: "https://www.schousing.com/"; tint: blue }
      Card { glyph: "HUD"; name: str.columbiaApply; note: str.columbiaApplyNote; href: "https://www.columbiahousingsc.org/apply-for-housing"; tint: blue }
      Card { glyph: "HUD"; name: str.charlestonCity; note: str.charlestonCityNote; href: "https://housing-chacity.securecafe.com/onlineleasing/housing-authority-of-the-city-of-charleston/guestlogin.aspx"; tint: blue }
      Card { glyph: "HUD"; name: str.charlestonCounty; note: str.charlestonCountyNote; href: "https://apps.cchra.net/apply/ApplIntro.aspx"; tint: blue }
      Card { glyph: "HUD"; name: str.greenvilleHa; note: str.greenvilleHaNote; href: "https://www.tgha.net/"; tint: blue }
      Card { glyph: "HUD"; name: str.rha1; note: str.rha1Note; href: "https://www.scrha.net/"; tint: blue }
      Card { glyph: "HUD"; name: str.rha3; note: str.rha3Note; href: "https://scrha3.org/public-housing/application/"; tint: blue }
      Card { glyph: "HUD"; name: str.hudSc; note: str.hudScNote; href: "https://www.hud.gov/states/south-carolina"; tint: blue }
      Card { glyph: "HUD"; name: str.housingSearch; note: str.housingSearchNote; href: "https://schousingsearch.com/"; tint: blue }

      Section { title: str.food; note: str.foodNote }
      Card { glyph: "FOOD"; name: str.harvestHope; note: str.harvestHopeNote; href: "https://harvesthope.org/"; tint: yellow }
