widget "SC help" {
  meta {
    owl: 18
    description: "South Carolina help for people who are homeless or about to be: 2-1-1, coordinated entry by region, shelters, housing and benefit applications, IDs, health, food, legal aid, veterans and youth."
    version: "1.0"
    license: "MIT"
    category: "home"
  }

