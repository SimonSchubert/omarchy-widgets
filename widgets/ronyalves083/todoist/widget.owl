widget "Todoist" {
  meta { owl: 17; description: "Beta community Todoist list: filters, priorities, due dates, adding and completing tasks."; version: "0.7.0"; license: "MIT"; category: "productivity" }
  size: 6x5
  minSize: 4x4
  // Native Android HTTP only: no shell commands or pacman packages required.
  asset addIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMiA0NCI+PHBhdGggZD0iTTExIDIyaDEwTTE2IDE3djEwIiBzdHJva2U9ImN1cnJlbnRDb2xvciIgc3Ryb2tlLXdpZHRoPSIxLjUiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIvPjwvc3ZnPg=="
  asset menuIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMiA0NCI+PGcgZmlsbD0iY3VycmVudENvbG9yIj48Y2lyY2xlIGN4PSIxNiIgY3k9IjE4IiByPSIxLjEiLz48Y2lyY2xlIGN4PSIxNiIgY3k9IjIyIiByPSIxLjEiLz48Y2lyY2xlIGN4PSIxNiIgY3k9IjI2IiByPSIxLjEiLz48L2c+PC9zdmc+"
  asset checkIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzNiAzNiI+PGNpcmNsZSBjeD0iMTgiIGN5PSIxOCIgcj0iOS41IiBzdHJva2U9ImN1cnJlbnRDb2xvciIgc3Ryb2tlLXdpZHRoPSIxLjUiIGZpbGw9Im5vbmUiLz48L3N2Zz4="
  asset removeShortcutIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyOCAyOCI+PHBhdGggZD0iTTEwIDEwTDE4IDE4TTE4IDEwTDEwIDE4IiBmaWxsPSJub25lIiBzdHJva2U9ImN1cnJlbnRDb2xvciIgc3Ryb2tlLXdpZHRoPSIxLjMiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIvPjwvc3ZnPg=="
  state token = null secret
  state query = "today | overdue" persist
  // Existing queries were parsed in English. Never reinterpret them on a UI language change.
  state queryLanguage = "en" persist
  state compact = true persist
  state customTitle = "" persist
  state textScale = 0 persist
  state showDates = true persist
  state showProjects = false persist
  state showLabels = false persist
  state showTimes = true persist
  // Session-only name cache; fetch only projects needed by the visible list/details.
  state projectCache = {}
  state projectRequest = null
  state projectDeadline = 0

  // Local shortcuts only; these never create or delete Todoist account filters.
  state savedFilters = [] persist
  state shortcutName = ""
  state removedFilter = null
  state removedFilterIndex = 0
  state settingsSection = "list"
  state editingToken = false
  state tab = "settings"
  state demo = false
  // One complete API response (up to 200), then local pages of 30.
  state pageIndex = 0
  state busy = false
  state completed = []
  state pendingTask = null
  state result = 0
  // An operation identity distinguishes equal responses even if snapshots coalesce.
  state writeGeneration = 0
  state message = ""
  state draft = ""
  state draftRevision = 0
  state pendingDraftRevision = null
  // Public local revision, never a copy or hash of the secret token.
  state accountRevision = 0
  state pendingAccount = null
  state menuOpen = false
  state selected = null
  source installedApps = android.apps

  source now = clock every 1m
  // Resolve Inbox by its ID, independent of the Todoist account language.
  source account = http(token == null || query != "#Inbox" ? null : "https://api.todoist.com/api/v1/user", {Authorization: "Bearer ${token}"}) every 10m timeout 20s json status
  source taskFetch = http(token == null ? null : query == "#Inbox" ? (account.out.inbox_project_id == null ? null : "https://api.todoist.com/api/v1/tasks?project_id=${enc(account.out.inbox_project_id)}&limit=200") : "https://api.todoist.com/api/v1/tasks/filter?query=${enc(query == "all" ? "view all" : query)}&lang=${enc(query == "all" ? "en" : queryLanguage)}&limit=200", {Authorization: "Bearer ${token}"}) every 1m timeout 20s json status
  let tasks = query == "#Inbox" && account.ok == false ? account : query == "#Inbox" && account.out.inbox_project_id == null ? null : taskFetch
  // Native OWL localization; user content and stored filter languages remain untouched.
  strings {
    pt {
      cancel: "Cancelar",
      removeShortcut: "Remover atalho",
      appTitle: "Todoist",
      todayOverdue: "Hoje e atrasadas",
      inbox: "Caixa de entrada",
      next7: "Próximos 7 dias",
      all: "Todas as tarefas",
      noDate: "Sem data",
      overdue: "Atrasadas",
      today: "Hoje",
      upcoming: "Próximas",
      yesterday: "Ontem",
      tomorrow: "Amanhã",
      late: " · atrasada",
      saved: "Salvo no Todoist.",
      saveError: code => "Não foi possível confirmar a gravação (${code}). Confira no Todoist antes de repetir.",
      saving: "Salvando…",
      demo: "DEMONSTRAÇÃO · dados fictícios",
      loading: "Carregando…",
      reconnect: "Conecte sua conta novamente pelo menu ⋮.",
      rateLimit: "O Todoist limitou as requisições. Aguarde um pouco antes de atualizar novamente.",
      fetchError: code => "Não foi possível atualizar (${code}). Veja o menu ⋮.",
      empty: "Tudo em dia.",
      previous: "‹ Anteriores",
      more: "Mais tarefas ›",
      refresh: "Atualizar",
      settings: "Configurações",
      openApp: "Abrir Todoist",
      welcome: "Suas tarefas, aqui.",
      connectHint: "Conecte sua conta para começar.",
      connect: "Conectar",
      showDemo: "Ver demonstração",
      list: "Lista",
      appearance: "Aparência",
      account: "Conta",
      connectAccount: "Conectar sua conta",
      tokenHelp: "No Todoist, copie seu token em Configurações → Integrações → Desenvolvedor. Cole abaixo e envie pelo teclado. Ele fica criptografado neste celular.",
      tokenSettings: "Abrir configurações do Todoist",
      token: "Token da API do Todoist",
      replaceToken: "Substituir token",
      notConnected: "Conta ainda não conectada",
      tokenSaved: "Token salvo · confira a lista na tela inicial",
      apiResponse: code => "Resposta do Todoist (${code})",
      noDetails: "Sem detalhes",
      disconnect: "Desconectar conta",
      unofficial: "Beta · use uma conta fixa. Se não houver confirmação ao salvar, confira no Todoist antes de repetir. Integração comunitária, sem vínculo oficial.",
      view: "Visualização",
      currentFilter: filter => "Filtro atual: ${filter}",
      filterHint: "Filtro: #Projeto, @etiqueta, p1…",
      filterHelp: "Combine com | ou &. Listas separadas por vírgula não são aceitas.",
      listName: "Nome da lista",
      autoName: name => "Automático: ${name}",
      currentName: name => "Nome: ${name}",
      nameHint: "Ex.: Trabalho · envie para salvar",
      resetName: "Usar nome automático",
      density: "Densidade",
      compactHelp: "Compacta: menos espaço entre tarefas.",
      comfortableHelp: "Confortável: mais espaço e títulos maiores.",
      compact: "Compacta",
      comfortable: "Confortável",
      textSize: "Tamanho do texto",
      small: "Pequeno",
      standard: "Padrão",
      large: "Grande",
      sizeHelp: " · aplicado à lista e ao cabeçalho",
      datesOn: "Datas: visíveis",
      datesOff: "Datas: ocultas",
      projectsOn: "Projetos: visíveis",
      projectsOff: "Projetos: ocultos",
      labelsOn: "Etiquetas: visíveis",
      labelsOff: "Etiquetas: ocultas",
      timesOn: "Horários: visíveis",
      timesOff: "Horários: ocultos",
      project: "Projeto",
      projectUnavailable: "Nome do projeto indisponível",
      sampleProject: "Projeto de exemplo",
      sampleLabel: "leitura",
      appearanceHelp: "Idioma, fonte e cores acompanham o Omalauncher.",
      exitDemo: "Sair da demonstração",
      openTask: "Abrir no Todoist",
      complete: "Concluir tarefa",
      add: "Adicionar tarefa",
      connectToAdd: "Conecte a conta e saia da demonstração para adicionar tarefas.",
      addHelp: "A tarefa será criada na Caixa de entrada. O título é enviado como texto, sem interpretar datas ou #projetos.",
      taskName: "Nome da tarefa",
      addInbox: "Adicionar à Caixa de entrada",
      backHome: "Voltar à tela inicial",
      samplePlan: "Planejar a semana",
      sampleRead: "Ler um capítulo",
      sampleIdeas: "Organizar ideias para o projeto",
      languageHelp: "O idioma acompanha o Omalauncher; na ausência de tradução, usamos inglês.",
      menu: "Menu de ações",
      filterLanguageHelp: "Escreva novos filtros em português, como hoje | atrasadas.",
      filterDocumentation: "Ajuda sobre filtros ↗",
      priority: "Prioridade",
      shortcutNameHint: "Nome do atalho (opcional)",
      saveShortcut: "Salvar atalho",
      shortcutRemoved: "Atalho removido.",
      undo: "Desfazer",
      tooManyTasks: "Este filtro tem mais de 200 tarefas. Restrinja o filtro para mostrar todas em ordem. A lista parcial foi ocultada.",
      pageSummary: (page, pages, total) => "Página ${page} de ${pages} · ${total} tarefas no filtro"
    },
    en {
      cancel: "Cancel",
      removeShortcut: "Remove shortcut",
