      view: "视图",
      currentFilter: filter => "当前过滤器：${filter}",
      filterHint: "过滤器：#项目, @标签, p1…",
      filterHelp: "使用 | 或 & 组合。不接受逗号分隔的列表。",
      listName: "列表名称",
      autoName: name => "自动：${name}",
      currentName: name => "名称：${name}",
      nameHint: "例如：工作 · 提交即可保存",
      resetName: "使用自动名称",
      density: "间距",
      compactHelp: "紧凑：缩小任务间距。",
      comfortableHelp: "宽松：增大空间与标题字号。",
      compact: "紧凑",
      comfortable: "宽松",
      textSize: "字号",
      small: "小",
      standard: "标准",
      large: "大",
      sizeHelp: " · 适用于列表和顶部标题",
      datesOn: "日期：显示",
      datesOff: "日期：隐藏",
      projectsOn: "项目：显示",
      projectsOff: "项目：隐藏",
      labelsOn: "标签：显示",
      labelsOff: "标签：隐藏",
      timesOn: "时间：显示",
      timesOff: "时间：隐藏",
      project: "项目",
      projectUnavailable: "项目名称不可用",
      sampleProject: "示例项目",
      sampleLabel: "阅读",
      appearanceHelp: "语言、字体和颜色跟随 Omalauncher。",
      exitDemo: "退出演示",
      openTask: "在 Todoist 中打开",
      complete: "完成任务",
      add: "添加任务",
      connectToAdd: "连接账户并退出演示模式以添加任务。",
      addHelp: "任务将在收件箱中创建。标题按纯文本发送，不会解析日期或 #项目。",
      taskName: "任务名称",
      addInbox: "添加至收件箱",
      backHome: "返回主屏幕",
      samplePlan: "规划本周",
      sampleRead: "阅读一章内容",
      sampleIdeas: "整理项目构思",
      languageHelp: "语言跟随 Omalauncher；若无翻译，则使用英语。",
      menu: "操作菜单",
      filterLanguageHelp: "使用中文编写新过滤器，例如 今天 | 过期。",
      filterDocumentation: "过滤器帮助 ↗",
      priority: "优先级",
      shortcutNameHint: "快捷方式名称（可选）",
      saveShortcut: "保存快捷方式",
      shortcutRemoved: "快捷方式已移除。",
      undo: "撤销",
      tooManyTasks: "此过滤器包含超过 200 个任务。请缩小过滤范围，以按顺序显示全部结果。不完整的列表已隐藏。",
      pageSummary: (page, pages, total) => "第 ${page} 页，共 ${pages} 页 · 过滤器中有 ${total} 个任务"
    }
  }
  // Use the supported display language, not an unsupported launcher's language, for new filters.
  let uiLanguage = contains(["pt", "es", "de", "zh", "id"], lang()) ? lang() : "en"
  // Todoist requires zh-CN for the documented Simplified Chinese filter keywords.
  let filterLanguage = uiLanguage == "id" ? "en" : uiLanguage == "zh" ? "zh-CN" : uiLanguage
  let dateLocale = uiLanguage == "pt" ? "pt-BR" : uiLanguage == "zh" ? "zh-CN" : uiLanguage
  // Alias for plain native strings; parameterized strings are called directly through str.
  let tr = str
  let samples = [{id: "demo1", content: tr.samplePlan, priority: 4, project_id: "demo-project", labels: [], due: {date: fmtTime(now, "yyyy-MM-dd") + "T14:00:00"}}, {id: "demo2", content: tr.sampleRead, priority: 2, project_id: "demo-project", labels: [tr.sampleLabel], due: {date: fmtTime(now, "yyyy-MM-dd")}}, {id: "demo3", content: tr.sampleIdeas, priority: 1, project_id: "demo-project", labels: []}]
  let todoistApp = find(installedApps ?? [], a => a.package == "com.todoist" && a.profile == null) ?? find(installedApps ?? [], a => a.package == "com.todoist")
  // Never imply global ordering if the server reports an incomplete result set.
  let tooManyTasks = tasks.ok == true && ((tasks.out.next_cursor != null && tasks.out.next_cursor != "") || len(tasks.out.results ?? []) > 200)
  let items = (demo ? samples : tasks.ok == true && !tooManyTasks ? (tasks.out.results ?? []) : []).filter(t => !contains(completed, t.id + toJson(t.due)))
  // Selection is only an ID anchor; render the task from the current local list.
  let detailTask = selected == null ? null : find(items, task => task.id == selected.id)

  let automaticHeading = query == "today | overdue" ? tr.todayOverdue : query == "#Inbox" ? tr.inbox : query == "7 days" ? tr.next7 : query == "all" ? tr.all : query
  let heading = customTitle != "" ? customTitle : automaticHeading
  // Readable secondary and warning colors derived from the active theme.
  let secondaryText = mix(background, foreground, 0.85)
  let warningText = mix(red, foreground, 0.5)
  let actionColor = mix(accent, foreground, 0.5)
  let today = fmtTime(now, "yyyy-MM-dd")
  let yesterday = fmtTime(parseTime(today) - 1, "yyyy-MM-dd")
  let tomorrow = fmtTime(parseTime(today) + 129600, "yyyy-MM-dd")
  // Fixed-zone timestamps may fall on a different date in the phone's timezone.
  let datedItems = items.map(t => merge(t, {localDay: t.due == null ? null : contains(t.due.date, "T") ? fmtTime(parseTime(t.due.date), "yyyy-MM-dd") : sub(t.due.date, 0, 10)}))
  let ordered = datedItems.sortBy(t => t.localDay ?? "9999")
  let pageCount = max(1, ceil(len(ordered) / 30))
  let currentPage = clamp(pageIndex, 0, pageCount - 1)
  let pageItems = take(drop(ordered, currentPage * 30), 30)
  let sections = groupBy(pageItems, t => t.localDay == null ? tr.noDate : t.localDay < today ? tr.overdue : t.localDay == today ? tr.today : tr.upcoming)
  on pageCount { pageIndex = clamp(pageIndex, 0, value - 1) }
  // Resolve names only for tasks currently visible, not all 200 results.
  let neededProjects = demo || token == null ? [] : unique((showProjects ? pageItems.map(t => t.project_id) : []) + (tab == "detail" && detailTask != null ? [detailTask.project_id] : [])).filter(id => id != null)
  // One lookup per project per widget session. No TTL: unchanged bodies are not events.
  let pendingProject = find(neededProjects, id => get(projectCache, id) == null)
  // Explicit refresh retries unavailable names without discarding equal successful bodies.
  let knownProjectNames = reduce(keys(projectCache), (cache, id) => get(projectCache, id).name != null ? set(cache, id, get(projectCache, id)) : cache, {})
  source projectFetch = http(token == null || demo || projectRequest == null ? null : "https://api.todoist.com/api/v1/projects/${enc(projectRequest)}", {Authorization: "Bearer ${token}"}) every 10m timeout 20s json status
  // Observe the pair, not a boolean edge that can be coalesced between fast requests.
  on [pendingProject, projectRequest] first {
    if projectRequest == null && pendingProject != null {
      projectRequest = pendingProject
      projectDeadline = now + 120
    }
  }
  on projectFetch first {
    // Only the response's own ID proves which name it contains. Never assign errors
    // to a reactive pendingProject: a source status has no request identity.
    if projectRequest != null && value.ok && value.out.id == projectRequest && value.out.name != null {
      projectCache = set(projectCache, projectRequest, {name: value.out.name})
      projectRequest = null
    }
  }
  on now {
    if projectRequest != null && value >= projectDeadline {
      // Deadline means failure/unavailable, NEVER fresh data or successful completion.
      // Also advances after identical errors, malformed bodies or a missed callback.
      projectCache = set(projectCache, projectRequest, {name: null})
      projectRequest = null
    }
  }
  on [writeGeneration, result] {
    let response = value[1]
    // The synchronous reset is not a completed request. Keep busy until a reply.
    if response != 0 && busy {
      busy = false
      if pendingAccount == accountRevision && token != null {
        message = response.ok ? tr.saved : response.code == 429 ? tr.rateLimit : str.saveError(response.code)
        if response.ok {
          if pendingTask == null && pendingDraftRevision == draftRevision {
            draft = ""
            draftRevision = draftRevision + 1
          }
          if pendingTask != null {
            completed = take([pendingTask] + completed, 60)
            if selected != null && selected.id + toJson(selected.due) == pendingTask {
              selected = null
              if tab == "detail" { close(); tab = "settings" }
            }
          }
          refresh()
        }
      } else {
        // The old operation terminates, but cannot modify the next account UI.
        result = 0
      }
      pendingTask = null
      pendingDraftRevision = null
      pendingAccount = null
    }
  }

  // Render Markdown link labels without displaying their raw URLs.
  component TaskTitle(content, textSize = 13, linesLimit = 3) {
    Column {
      let links = matchAll(content, "\\[([^\\]]+)\\]\\(([^)]+)\\)")
      let clean = reduce(links, (textValue, link) => replace(textValue, "[" + link[0] + "](" + link[1] + ")", link[0]), content)
      Text { text: clean; fontSize: textSize; maxLines: linesLimit; color: foreground }
    }
  }

  component DueDate(task, includeTime = true, includeDate = true) {
    Column {
      let hasTime = contains(task.due.date ?? "", "T")
      let day = hasTime ? fmtTime(parseTime(task.due.date), "yyyy-MM-dd") : sub(task.due.date, 0, 10)
      let late = day < today
      let dateLabel = day == today ? tr.today : day == yesterday ? tr.yesterday : day == tomorrow ? tr.tomorrow : fmtTime(parseTime(day), uiLanguage == "zh" ? "M月d日" : uiLanguage == "de" ? "d. MMM" : uiLanguage == "en" ? "MMM d" : "d MMM", null, dateLocale)
      if task.due != null && (includeDate || (includeTime && hasTime)) {
        Text { text: "${includeDate ? dateLabel : ""}${includeDate && task.due.is_recurring == true ? " ⟳" : ""}${includeTime && hasTime ? (includeDate ? " · " : "") + fmtTime(parseTime(task.due.date), "HH:mm") + (!includeDate && task.due.is_recurring == true ? " ⟳" : "") : ""}${includeDate && late ? tr.late : ""}"; fontSize: 9 + textScale; color: late ? warningText : secondaryText }
      }
    }
  }

  component TaskContext(task, includeProject = true, includeLabels = true, full = false) {
    Column {
      gap: 3
      if includeProject && task.project_id != null {
        let cached = get(projectCache, task.project_id)
        Text { text: "${tr.project}: ${demo ? tr.sampleProject : cached == null ? tr.loading : cached.name ?? tr.projectUnavailable}"; fontSize: 9 + textScale; color: secondaryText; maxLines: full ? 100 : 2 }
      }
      if includeLabels && len(task.labels ?? []) > 0 {
        Text { text: join(map(task.labels, name => "@" + name), " · "); fontSize: 9 + textScale; color: secondaryText; maxLines: full ? 100 : 2 }
      }
    }
  }

  // List-only presentation: one line, preserving existing visibility and date formatting.
  component TaskMetadata(task) {
    Column {
      let hasTime = contains(task.due.date ?? "", "T")
      let day = hasTime ? fmtTime(parseTime(task.due.date), "yyyy-MM-dd") : sub(task.due.date, 0, 10)
      let late = day < today
      let dateLabel = day == today ? tr.today : day == yesterday ? tr.yesterday : day == tomorrow ? tr.tomorrow : fmtTime(parseTime(day), uiLanguage == "zh" ? "M月d日" : uiLanguage == "de" ? "d. MMM" : uiLanguage == "en" ? "MMM d" : "d MMM", null, dateLocale)
      let datePart = task.due != null && (showDates || (showTimes && hasTime)) ? "${showDates ? dateLabel : ""}${showDates && task.due.is_recurring == true ? " ⟳" : ""}${showTimes && hasTime ? (showDates ? " · " : "") + fmtTime(parseTime(task.due.date), "HH:mm") + (!showDates && task.due.is_recurring == true ? " ⟳" : "") : ""}${showDates && late ? tr.late : ""}" : ""
      let cached = get(projectCache, task.project_id)
      let projectPart = showProjects && task.project_id != null ? "#" + (demo ? tr.sampleProject : cached == null ? tr.loading : cached.name ?? tr.projectUnavailable) : ""
      let labelParts = showLabels ? map(task.labels ?? [], name => "@" + name) : []
      let metadataText = join(([datePart, projectPart] + labelParts).filter(part => part != ""), " · ")
      if metadataText != "" {
        Text { text: metadataText; fontSize: 9 + textScale; color: datePart != "" && late ? warningText : secondaryText; maxLines: 1 }
      }
    }
  }

  component TaskRow(task) {
    Row {
      align: top
      padding: [0, compact ? 7 : 10]
      gap: 8
      Image {
        src: checkIcon
        width: 36
        height: 36
        // Semantic priority colors must stay distinct even with a muted theme.
        tint: task.priority == 4 ? #ff5252 : task.priority == 3 ? #ff9800 : task.priority == 2 ? #448aff : secondaryText
        label: "${tr.complete}: ${task.content}. ${tr.priority} ${5 - task.priority}"
        onTap: {
          let currentTask = find(items, current => current.id == task.id)
          if !demo && !busy && token != null && currentTask != null && currentTask.due == task.due {
            busy = true
            message = tr.saving
            pendingTask = task.id + toJson(task.due)
            pendingDraftRevision = null
            pendingAccount = accountRevision
            writeGeneration = writeGeneration + 1
            result = 0
            result = post("https://api.todoist.com/api/v1/tasks/${enc(task.id)}/close", null, {Authorization: "Bearer ${token}"})
          }
        }
      }
      Column {
        weight: 1
        gap: 4
        padding: [0, 6, 0, 0]
        onTap: { selected = task; tab = "detail"; screen() }
        TaskTitle { content: task.content; textSize: (compact ? 11 : 13) + textScale }
        if showDates || showTimes || showProjects || showLabels { TaskMetadata { task: task } }
      }
    }
  }

  component TaskList() {
    Column {
      gap: 4
      if demo { Text { text: tr.demo; fontSize: 8; color: secondaryText } }
      if !demo && tasks == null { Text { text: tr.loading; color: secondaryText } }
      if !demo && tasks != null && tasks.ok != true {
        Text { text: tasks.code == 401 ? tr.reconnect : tasks.code == 429 ? tr.rateLimit : str.fetchError(tasks.code); fontSize: 10; color: warningText }
      }
      if !demo && tooManyTasks { Text { text: tr.tooManyTasks; fontSize: 12; color: warningText; padding: [0, 20] } }
      if !demo && tasks.ok == true && !tooManyTasks && len(items) == 0 { Text { text: tr.empty; fontSize: 14; color: secondaryText; padding: [0, 20] } }
      if !demo && tasks.ok == true && !tooManyTasks && len(items) > 0 { Text { text: str.pageSummary(currentPage + 1, pageCount, len(ordered)); fontSize: 9; color: secondaryText } }
      Column {
        weight: 1
        scroll: true
        gap: 8
        onPull: { if !demo && !busy && token != null { result = 0; message = ""; projectCache = knownProjectNames; refresh() } }
        for section in keys(sections) {
          Column {
            gap: 0
            Row {
              padding: [8, 10]
              Text { text: section; fontSize: 10 + textScale; bold: true; color: section == tr.overdue ? warningText : secondaryText; weight: 1 }
              Text { text: "${len(get(sections, section))}"; fontSize: 9; color: secondaryText }
            }
            Box { height: 1; fill: width; background: alpha(muted, 0.15) }
            for task in get(sections, section) key task.id { TaskRow { task: task } }
          }
        }
      }
      if !demo && tasks.ok == true && !tooManyTasks && pageCount > 1 {
        Row {
          if currentPage > 0 { Text { text: tr.previous; fontSize: 10; color: actionColor; padding: 8; onTap: pageIndex = currentPage - 1 } }
          Spacer { weight: 1 }
          if currentPage < pageCount - 1 { Text { text: tr.more; fontSize: 10; color: actionColor; padding: 8; onTap: pageIndex = currentPage + 1 } }
        }
      }
    }
  }

  Column {
    gap: 4
    padding: [8, 0]
    Row {
      align: center
      gap: 4
      Text { text: "${heading} ▾"; fontSize: 16 + textScale; bold: true; weight: 1; maxLines: 1; padding: [4, 12]; onTap: { tab = "settings"; screen() } }
      Image { src: addIcon; width: 32; height: 44; tint: foreground; label: tr.add; onTap: { tab = "add"; screen() } }
      Box {
        width: 32
        height: 44
        Image { src: menuIcon; width: 32; height: 44; tint: foreground; label: tr.menu; onTap: menuOpen = true }
        Popup {
          width: 152
          align: end
          visible: menuOpen
          onDismiss: menuOpen = false
          Column {
            Text { text: tr.refresh; fontSize: 13; padding: [12, 10]; onTap: { menuOpen = false; if !busy { result = 0; message = ""; projectCache = knownProjectNames; refresh() } } }
            Text { text: tr.settings; fontSize: 13; padding: [12, 10]; onTap: { menuOpen = false; tab = "settings"; screen() } }
            Text { text: tr.openApp; fontSize: 13; padding: [12, 10]; onTap: { menuOpen = false; if todoistApp != null { androidApp(todoistApp.key) } else { url("https://app.todoist.com") } } }
          }
        }
      }
    }
    if token == null && !demo {
      Column {
        weight: 1
        justify: center
        gap: 12
        Text { text: tr.welcome; fontSize: 20; bold: true }
        Text { text: tr.connectHint; fontSize: 12; color: secondaryText }
        Button { text: tr.connect; onTap: { settingsSection = "account"; tab = "settings"; screen() } }
        Text { text: tr.showDemo; fontSize: 10; color: actionColor; padding: 8; onTap: demo = true }
      }
    } else { TaskList { weight: 1 } }
    if busy || (result != 0 && result.ok == false && !(tasks.ok == false && result.code == tasks.code)) { Text { text: message; fontSize: 9; color: busy ? secondaryText : warningText; maxLines: 3 } }
  }

  screen {
    title: tr.appTitle
    Column {
      padding: 16
      gap: 14
      Column {
        scroll: true
        weight: 1
        gap: 14
        if tab == "settings" {
          Flow {
            gap: 6
            Button { text: settingsSection == "list" ? "• ${tr.list}" : tr.list; onTap: settingsSection = "list" }
            Button { text: settingsSection == "appearance" ? "• ${tr.appearance}" : tr.appearance; onTap: settingsSection = "appearance" }
            Button { text: settingsSection == "account" ? "• ${tr.account}" : tr.account; onTap: settingsSection = "account" }
          }
          if settingsSection == "account" {
          Text { text: token == null ? tr.connectAccount : tr.account; style: title }
          if token == null || editingToken {
          Text { text: tr.tokenHelp; style: muted; color: secondaryText }
          Button { text: tr.tokenSettings; onTap: url("https://app.todoist.com/app/settings/integrations/developer") }
          Text { text: tr.token; style: small; color: secondaryText }
          Input { placeholder: token == null ? tr.token : tr.replaceToken; password: true; clear: true; onSubmit: { if trim(value) != "" { accountRevision = accountRevision + 1; token = trim(value); editingToken = false; projectCache = {}; projectRequest = null; projectDeadline = 0; demo = false; selected = null; completed = []; pageIndex = 0; message = ""; refresh() } } }
          if token != null { Button { text: tr.cancel; onTap: editingToken = false } }
          } else { Button { text: tr.replaceToken; onTap: editingToken = true } }
          Text { text: token == null ? tr.notConnected : tr.tokenSaved; style: small; color: secondaryText }
          if tasks.ok == false {
            if tasks.code == 429 { Text { text: tr.rateLimit; color: warningText; fontSize: 12 } }
            Text { text: str.apiResponse(tasks.code); color: warningText; style: small }
            Text { text: str(tasks.out ?? tasks.err ?? tr.noDetails); style: small; maxLines: 8 }
          }
            if token != null { Button { text: tr.disconnect; onTap: { accountRevision = accountRevision + 1; token = null; editingToken = false; projectCache = {}; projectRequest = null; projectDeadline = 0; demo = false; selected = null; completed = []; pageIndex = 0; message = ""; draft = ""; draftRevision = draftRevision + 1 } } }
            Text { text: tr.unofficial; style: muted; color: secondaryText }
          } else if settingsSection == "list" {
          Text { text: tr.view; style: title }
          Flow {
            gap: 8
            // Built-ins keep their canonical expressions, independent of interface language.
            Button { text: tr.todayOverdue; onTap: { query = "today | overdue"; queryLanguage = "en"; pageIndex = 0; shortcutName = "" } }
            Button { text: tr.inbox; onTap: { query = "#Inbox"; queryLanguage = "en"; pageIndex = 0; shortcutName = "" } }
            Button { text: tr.next7; onTap: { query = "7 days"; queryLanguage = "en"; pageIndex = 0; shortcutName = "" } }
            for shortcut, shortcutIndex in savedFilters key shortcut.query {
              // One native-style outline, content width, and independent sibling tap targets.
              let maxShortcutChars = max(12, floor((screenWidth - 108) / 13))
              let shortcutTitle = len(shortcut.name) > maxShortcutChars ? sub(shortcut.name, 0, maxShortcutChars - 1) + "…" : shortcut.name
              Row {
                align: center
                gap: 0
                border: 1
                borderColor: accent
                Text {
                  text: shortcutTitle
                  maxLines: 1
                  fontSize: 13
                  color: accent
                  padding: [10, 6]
                  onTap: { query = shortcut.query; queryLanguage = shortcut.lang ?? "en"; pageIndex = 0; shortcutName = "" }
                }
                Image {
                  src: removeShortcutIcon
                  label: "${tr.removeShortcut}: ${shortcut.name}"
                  width: 28
                  height: 28
                  tint: accent
                  onTap: {
                    removedFilter = shortcut
                    removedFilterIndex = shortcutIndex
                    savedFilters = remove(savedFilters, shortcutIndex)
                  }
                }
              }
            }
          }
          if removedFilter != null {
            Row {
              align: center
              Text { text: tr.shortcutRemoved; style: small; weight: 1 }
              Button {
                text: tr.undo
                onTap: {
                  if !any(savedFilters, f => f.query == removedFilter.query) {
                    savedFilters = take(savedFilters, removedFilterIndex) + [removedFilter] + drop(savedFilters, removedFilterIndex)
                  }
                  removedFilter = null
                }
              }
            }
          }
          Text { text: str.currentFilter(query); style: small; color: secondaryText }
          Input { placeholder: tr.filterHint; clear: true; onSubmit: { if trim(value) != "" { query = trim(value); queryLanguage = filterLanguage; pageIndex = 0; shortcutName = "" } } }
          if trim(query) != "" && !contains(["today | overdue", "#Inbox", "7 days"], trim(query)) && !any(savedFilters, f => f.query == trim(query)) {
            Input { text: shortcutName; placeholder: tr.shortcutNameHint; onChange: shortcutName = value }
            Button {
              text: tr.saveShortcut
              onTap: {
                if trim(query) != "" && !contains(["today | overdue", "#Inbox", "7 days"], trim(query)) && !any(savedFilters, f => f.query == trim(query)) {
                  savedFilters = savedFilters + [{query: trim(query), name: trim(shortcutName) == "" ? trim(query) : trim(shortcutName), lang: queryLanguage}]
                  shortcutName = ""
                  removedFilter = null
                }
              }
            }
          }
          Text { text: "${tr.filterLanguageHelp} ${tr.filterHelp}"; style: muted; color: secondaryText }
          Text {
            text: tr.filterDocumentation
            color: actionColor
            padding: [0, 12]
            onTap: url(uiLanguage == "pt" ? "https://www.todoist.com/pt-BR/help/todoist/features/introduction-to-filters-V98wIH" : uiLanguage == "es" ? "https://www.todoist.com/es/help/todoist/features/introduction-to-filters-V98wIH" : uiLanguage == "de" ? "https://www.todoist.com/de/help/todoist/features/introduction-to-filters-V98wIH" : uiLanguage == "zh" ? "https://www.todoist.com/zh-CN/help/todoist/features/introduction-to-filters-V98wIH" : "https://www.todoist.com/help/todoist/features/introduction-to-filters-V98wIH")
          }
          Text { text: tr.listName; style: title }
          Text { text: customTitle == "" ? str.autoName(automaticHeading) : str.currentName(customTitle); style: small; color: secondaryText }
          Input { placeholder: tr.nameHint; clear: true; onSubmit: customTitle = trim(value) }
          if customTitle != "" { Button { text: tr.resetName; onTap: customTitle = "" } }
          } else {

            Text { text: tr.density; style: title }
            Text { text: compact ? tr.compactHelp : tr.comfortableHelp; style: small; color: secondaryText }
            Flow {
              gap: 8
              Button { text: compact ? "• ${tr.compact}" : tr.compact; onTap: compact = true }
              Button { text: compact ? tr.comfortable : "• ${tr.comfortable}"; onTap: compact = false }
            }
            Text { text: tr.textSize; style: title }
            Text { text: "${textScale == 0 ? tr.small : textScale == 2 ? tr.standard : tr.large}${tr.sizeHelp}"; style: small; color: secondaryText }
            Flow {
              gap: 8
              Button { text: textScale == 0 ? "• ${tr.small}" : tr.small; onTap: textScale = 0 }
              Button { text: textScale == 2 ? "• ${tr.standard}" : tr.standard; onTap: textScale = 2 }
              Button { text: textScale == 4 ? "• ${tr.large}" : tr.large; onTap: textScale = 4 }
            }
            Button { text: showDates ? tr.datesOn : tr.datesOff; onTap: showDates = !showDates }
            Button { text: showTimes ? tr.timesOn : tr.timesOff; onTap: showTimes = !showTimes }
            Button { text: showProjects ? tr.projectsOn : tr.projectsOff; onTap: showProjects = !showProjects }
            Button { text: showLabels ? tr.labelsOn : tr.labelsOff; onTap: showLabels = !showLabels }
            Text { text: tr.appearanceHelp; style: muted; color: secondaryText }
            Button { text: demo ? tr.exitDemo : tr.showDemo; onTap: demo = !demo }
          }
        } else if tab == "detail" {
          if detailTask != null {
            let shownTask = detailTask
            TaskTitle { content: shownTask.content; textSize: 20; linesLimit: 100 }
            DueDate { task: shownTask }
            TaskContext { task: shownTask; full: true }
            Text { text: "${tr.priority} ${5 - shownTask.priority}"; style: small; color: secondaryText }
            if shownTask.description != null && shownTask.description != "" { Text { text: shownTask.description; fontSize: 12 } }
            for link in matchAll(shownTask.content, "\\[([^\\]]+)\\]\\((https://[^)]+)\\)") {
              Text { text: "↗ ${link[0]}"; color: actionColor; padding: 12; onTap: url(link[1]) }
            }
            if !demo {
              Button { text: tr.openTask; onTap: url("https://app.todoist.com/app/task/${enc(shownTask.id)}") }
              Button { text: busy ? tr.saving : tr.complete; onTap: { if !busy && token != null && detailTask != null && shownTask.id == detailTask.id && shownTask.due == detailTask.due { busy = true; message = tr.saving; pendingTask = shownTask.id + toJson(shownTask.due); pendingDraftRevision = null; pendingAccount = accountRevision; writeGeneration = writeGeneration + 1; result = 0; result = post("https://api.todoist.com/api/v1/tasks/${enc(shownTask.id)}/close", null, {Authorization: "Bearer ${token}"}) } } }
            }
          }
        } else {
          Text { text: tr.add; style: title }
          if token == null || demo {
            Text { text: tr.connectToAdd; style: muted; color: secondaryText }
          } else {
            Text { text: tr.addHelp; style: muted; color: secondaryText }
            Input { text: draft; placeholder: tr.taskName; onChange: { draft = value; draftRevision = draftRevision + 1 } }
            Button { text: busy ? tr.saving : tr.addInbox; onTap: { if !busy && token != null && trim(draft) != "" { busy = true; pendingTask = null; pendingDraftRevision = draftRevision; pendingAccount = accountRevision; message = tr.saving; writeGeneration = writeGeneration + 1; result = 0; result = post("https://api.todoist.com/api/v1/tasks", {content: trim(draft)}, {Authorization: "Bearer ${token}"}) } } }
          }
        }
        if message != "" { Text { text: message; style: small; color: secondaryText } }
      }
      Button { text: tr.backHome; onTap: close() }
    }
  }
}
