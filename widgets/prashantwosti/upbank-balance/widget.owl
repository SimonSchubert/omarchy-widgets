widget "upbank-balance" {
  size: 3x2
  minSize: 3x2
  padding: 0
  meta {
    owl: 11
    description: "Your balance at Up Bank Australia (up.com.au) on a tile: spending, savers, joint 2up or all, split across accounts underneath. Tap ⚙ for the token, colour, interval and if all counts 2up"
    version: "1.0"
    license: "MIT"
    category: "finance"
  }

  // Personal access token from https://api.up.com.au/getting_started, typed in with the gear and
  // kept in this widget's settings on this phone, never in this file or a command. Up is asked every `interval`
  // seconds, set in settings; while offline the last answer still shows, marked offline.
  state interval = 60 persist        // seconds between calls to Up, set in settings
  state token = "" persist
  source now = clock every 30s
  // `every` takes a fixed interval, so the source starts when the token arrives and refresh() asks
  // again when `interval` is up (below); a null URL waits for the token.
  source acc = http(token == "" ? null : "https://api.up.com.au/api/v1/accounts?page[size]=100", {Authorization: "Bearer ${token}"}) every 1h timeout 20s json status

  state mode = "spending" persist   // spending, savers, 2up or all; spending until one is picked
  state allJoint = false persist    // "all" counts the joint accounts too; only offered when there are any
  state colour = "up" persist      // key into palette below
  state last = null                 // the last answer that worked, shown while offline
  state fetchedAt = 0               // when Up was last asked
  state nextAt = 0                  // when to ask again
  // Ask Up when the interval is up. A source keeps its value when the answer repeats, so the clock,
  // not a trigger on the answer, decides when to ask again.
  every 30s {
    if token != "" && now >= nextAt { fetchedAt = now; nextAt = now + interval; refresh() }
  }
  on acc first {
    if value.ok && value.out.data != null { last = value.out }
    if value.ok || value.code == 401 { fetchedAt = now }
    if nextAt == 0 { nextAt = now + interval }
  }
  on interval {
    fetchedAt = now
    nextAt = now + interval
    refresh()
  }

  let palette = [
    {id: "up", name: "up orange", c: #ff7a64},
    {id: "yellow", name: "sunshine", c: #ffe066},
    {id: "mint", name: "mint", c: #5ee2a0},
    {id: "sky", name: "sky", c: #64b5ff},
    {id: "accent", name: "theme", c: accent}
  ]
  let brand = (find(palette, p => p.id == colour) ?? palette[0]).c

  let res = acc != null && acc.ok && acc.out.data != null ? acc.out : last
  let all = res.data ?? []
  let age = fetchedAt == 0 ? 0 : now - fetchedAt
  let ago = age < 90 ? "just now" : "${fmtDuration(age)} ago"
  let stale = fetchedAt > 0 && age > interval * 2 + 120
  let own = all.filter(a => a.attributes.ownershipType != "JOINT")
  let spendSum = sum(own.filter(a => a.attributes.accountType == "TRANSACTIONAL").map(a => num(a.attributes.balance.value, 0)))
  let saverSum = sum(own.filter(a => a.attributes.accountType == "SAVER").map(a => num(a.attributes.balance.value, 0)))
  let jointSum = sum(all.filter(a => a.attributes.ownershipType == "JOINT").map(a => num(a.attributes.balance.value, 0)))
  let hasJoint = len(all) - len(own) > 0
  // 2up shows the joint accounts; "all" is your own ones, plus the joint ones when allJoint is on
  let total = mode == "spending" ? spendSum : mode == "savers" ? saverSum : mode == "2up" ? jointSum : spendSum + saverSum + (allJoint && hasJoint ? jointSum : 0)
  let nAcc = mode == "spending" ? count(own, a => a.attributes.accountType == "TRANSACTIONAL")
    : mode == "savers" ? count(own, a => a.attributes.accountType == "SAVER")
    : mode == "2up" ? len(all) - len(own) : len(own) + (allJoint && hasJoint ? len(all) - len(own) : 0)

  // $7,527.27 split into dollars and cents
  let cents = int(round(abs(total) * 100))
  let whole = floor(cents / 100)
  let dollars = whole >= 1000000 ? "${floor(whole / 1000000)},${pad(floor(whole / 1000) % 1000, 3, "0")},${pad(whole % 1000, 3, "0")}"
    : whole >= 1000 ? "${floor(whole / 1000)},${pad(whole % 1000, 3, "0")}" : str(whole)
  let centStr = pad(cents % 100, 2, "0")
  let ready = token != "" && res.data != null

  onTap: androidApp("au.com.up.money")

  component Chip(label, value) {
    Text {
      text: label; style: small; align: center; fill: width; maxLines: 1
      padding: [2, 3]; radius: 20 * corners
      background: mode == value ? brand : alpha(foreground, 0.06)
      color: mode == value ? background : muted
      bold: mode == value
      animate background: tween(200ms, "ease")
      animate color: tween(200ms, "ease")
      onTap: mode = value
    }
  }

  Box {
    fill: true
    // soft glow in the brand colour from the top right
    Canvas {
      rect(0, 0, width, height, fill: radial(width * 0.95, 0, max(width, height) * 0.9, [alpha(brand, 0.3), alpha(brand, 0.08), alpha(brand, 0)]))
    }
    Column {
      fill: true
      padding: [12, 10]
      gap: 0
      Row {
        align: center
        gap: 6
        Text { text: "up"; style: small; bold: true; color: background; background: brand; padding: [5, 0]; radius: 4 * corners; width: 26; align: center }
        Text { text: mode == "2up" ? "2up · joint" : mode; style: small; color: muted; weight: 1; maxLines: 1 }
        Text { text: "⚙"; color: alpha(foreground, 0.75); align: center; width: 26; onTap: screen() }
      }
      Spacer { weight: 1 }
      if token == "" {
        Text { text: "tap ⚙ to add your token"; style: small; color: yellow; maxLines: 2; onTap: screen() }
      } else if acc == null {
        Text { text: "…"; style: title; color: muted }
      } else if acc.code == 401 {
        Text { text: "invalid token · tap ⚙"; style: small; color: red; maxLines: 2 }
      } else if !ready {
        Text { text: "offline"; style: small; color: red; maxLines: 2 }
      } else {
        Row {
          align: bottom
          gap: 1
          Text { text: total < 0 ? "-$" : "$"; fontSize: 18; color: brand; width: total < 0 ? 22 : 12; padding: [0, 0, 0, 5] }
          Text { text: dollars; fontSize: 30; bold: true; maxLines: 1; width: len(dollars) * 18 + 1 }
          Text { text: ".${centStr}"; fontSize: 16; color: muted; weight: 1; padding: [0, 0, 0, 5] }
        }
        // tap to ask Up now
        Text {
          text: "${nAcc} account${nAcc == 1 ? "" : "s"} · ${acc.ok ? "" : "offline · "}${ago}"; style: small; maxLines: 1
          color: acc.ok ? stale ? yellow : alpha(muted, 0.8) : red
          onTap: { fetchedAt = now; nextAt = now + interval; refresh() }
        }
      }
      Spacer { weight: 1 }
      // how the money splits: spending | savers | 2up, with the picked part lit
      if ready && spendSum + saverSum + jointSum > 0 {
        Canvas {
          height: 5
          fill: width
          let t = spendSum + saverSum + jointSum
          let gap = 3
          let w = width - gap * 2
          // a part with money stays visible however small
          let ws = spendSum > 0 ? max(6, w * spendSum / t) : 0
          let wj = jointSum > 0 ? max(6, w * jointSum / t) : 0
          let wv = w - ws - wj
          let dim = alpha(muted, 0.3)
          rect(0, 0, ws, height, radius: 3 * corners, fill: mode == "spending" || mode == "all" ? brand : dim)
          rect(ws + gap, 0, wv, height, radius: 3 * corners, fill: mode == "savers" || mode == "all" ? brand : dim)
          rect(ws + wv + gap * 2, 0, wj, height, radius: 3 * corners, fill: mode == "2up" || (mode == "all" && allJoint && hasJoint) ? brand : dim)
        }
        Spacer { height: 8 }
      }
      Row {
        gap: 4
        Chip { label: "spend"; value: "spending"; weight: 1 }
        Chip { label: "save"; value: "savers"; weight: 1 }
        Chip { label: "2up"; value: "2up"; weight: 1 }
        Chip { label: "all"; value: "all"; weight: 1 }
      }
    }
  }

  screen {
    title: "upbank balance widget settings"
    Column {
      padding: 16
      gap: 12
      Text { text: "personal access token"; style: label }
      Text {
        text: token == "" ? "no token saved yet"
          : acc == null ? "checking…"
          : acc.code == 401 ? "saved token was rejected by Up"
          : !acc.ok ? "can't reach Up right now"
          : ready ? "saved token works" : "checking…"
        style: small
        color: token == "" ? muted : acc != null && acc.ok && ready ? green : acc == null ? muted : red
      }
      if token == "" {
        Input {
          placeholder: "up:yeah:…"
          focus: true
          onSubmit: { token = trim(value); last = null; fetchedAt = 0; nextAt = 0; close() }
        }
        Text { text: "Up tokens start with up:yeah: — pasting works; it's kept in this widget's settings on this phone."; style: small; color: yellow }
      } else {
        Row {
          align: center
          gap: 8
          Text { text: "token saved on this phone, unencrypted"; style: small; color: muted; weight: 1 }
          Button { text: "clear token"; onTap: { token = ""; last = null; fetchedAt = 0; nextAt = 0 } }
        }
      }
      Spacer { height: 8 }
      Text { text: "colour"; style: label }
      Row {
        gap: 14
        for p in palette key p.id {
          Column {
            align: center
            gap: 6
            onTap: colour = p.id
            Box {
              size: 40
              radius: 20
              border: colour == p.id ? 2 : 0
              borderColor: foreground
              padding: 4
              Box { fill: true; radius: 16; background: p.c }
            }
            Text { text: p.name; style: small; align: center; color: colour == p.id ? foreground : muted; width: 64; maxLines: 1 }
          }
        }
      }
      Spacer { height: 8 }
      Text { text: "update every"; style: label }
      Row {
        gap: 8
        for o in [{s: 60, l: "1 min"}, {s: 300, l: "5 min"}, {s: 900, l: "15 min"}, {s: 1800, l: "30 min"}] key o.s {
          Text {
            text: o.l; align: center; weight: 1; maxLines: 1; padding: [4, 8]; radius: 20 * corners
            background: interval == o.s ? brand : alpha(foreground, 0.06)
            color: interval == o.s ? background : muted
            bold: interval == o.s
            onTap: interval = o.s
          }
        }
      }
      if hasJoint {
        Spacer { height: 8 }
        Row {
          align: center
          gap: 8
          Column {
            weight: 1
            gap: 2
            Text { text: "count 2up balance in \"all\""; style: small }
            Text {
              text: allJoint ? "\"all\" adds the joint accounts to yours" : "\"all\" counts your own accounts only"
              style: small; color: muted; maxLines: 2
            }
          }
          Text {
            text: allJoint ? "on" : "off"; style: small; align: center; width: 44; padding: [4, 8]; radius: 20 * corners
            background: allJoint ? brand : alpha(foreground, 0.06)
            color: allJoint ? background : muted
            bold: allJoint
            onTap: allJoint = !allJoint
          }
        }
      }
      Row {
        align: center
        gap: 8
        Text { text: fetchedAt > 0 ? "last checked ${ago}" : "not checked yet"; style: small; color: muted; weight: 1 }
        Button { text: "refresh now"; onTap: { fetchedAt = now; nextAt = now + interval; refresh() } }
      }
      Spacer { height: 8 }
      Text { text: "⚠️ Get personal access token in the Up app under Data sharing, or at api.up.com.au. It's kept locally on this phone, unencrypted."; style: small; color: muted; maxLines: 4 }
      Button { text: "open api.up.com.au"; onTap: url("https://api.up.com.au/getting_started") }
    }
  }
}

