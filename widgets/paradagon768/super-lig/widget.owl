widget "süper lig" {
  meta {
    owl: 10
    description: "Trendyol Süper Lig puan durumu, canlı skorlar ve fikstür; dokun, tam tabloyu ve haftanın maçlarını gör."
    version: "1.0"
    license: "MIT"
    category: "sport"
  }
  size: 3x5
  minSize: 3x3

  source now = clock every 1m

  // ESPN'in açık API'si: anahtar gerekmez. Maçlar ay adıyla istenir; bu ayın
  // isteği canlı skorları ve sonuçları taşır, gelecek ayınki fikstürü, ay
  // bitince diye. İki küçük istek, haftanın bütün maçları.
  source tbl = http("https://site.api.espn.com/apis/v2/sports/soccer/tur.1/standings") json every 10m timeout 15s
  source mon = http("https://site.api.espn.com/apis/site/v2/sports/soccer/tur.1/scoreboard?dates=${enc(fmtTime(now, "yyyyMM"))}") json every 3m timeout 15s
  source nxt = http("https://site.api.espn.com/apis/site/v2/sports/soccer/tur.1/scoreboard?dates=${enc(fmtTime(now + 32 * 86400, "yyyyMM"))}") json every 30m timeout 15s

  let logo = "https://a.espncdn.com/i/leaguelogos/soccer/500/18.png"

  // ESPN İngilizce yazıyor; alıştığımız adları yazalım.
  let tr = {
    "Fenerbahce": "Fenerbahçe",
    "Besiktas": "Beşiktaş",
    "Istanbul Basaksehir": "Başakşehir",
    "Caykur Rizespor": "Çaykur Rizespor",
    "Genclerbirligi": "Gençlerbirliği",
    "Goztepe": "Göztepe",
    "Kasimpasa": "Kasımpaşa",
    "Eyupspor": "Eyüpspor"
  }
  let notesTr = {
    "Champions League": "Şampiyonlar Ligi",
    "Champions League qualifying": "Şampiyonlar Ligi elemesi",
    "Europa League qualifying": "Avrupa Ligi elemesi",
    "Conference League qualifying": "Konferans Ligi elemesi",
    "Relegated": "küme düşer"
  }

  // --- puan durumu: takımı ve rakamları tek satırda topla
  let entries = tbl.children[0].standings.entries ?? []
  let table = map(entries, e => ({
    id: e.team.id,
    team: e.team.displayName,
    logo: e.team.logos[0].href,
    mark: e.team.abbreviation,
    note: e.note,
    pos: find(e.stats, s => s.name == "rank").value,
    gp: find(e.stats, s => s.name == "gamesPlayed").value,
    w: find(e.stats, s => s.name == "wins").value,
    d: find(e.stats, s => s.name == "ties").value,
    l: find(e.stats, s => s.name == "losses").value,
    gd: find(e.stats, s => s.name == "pointDifferential").value,
    pts: find(e.stats, s => s.name == "points").value
  })).sortBy(r => r.pos)
  let yil = tbl.children[0].standings.season
  let season = yil == null ? "" : "${yil}-${(yil + 1) % 100}"

  // --- maçlar, bu ay ve gelecek ay, tarihe göre sıralı
  let matches = ((mon.events ?? []) + (nxt.events ?? [])).sortBy(m => m.date)
  let groups = groupBy(matches, m => sub(m.date, 0, 10))
  let days = keys(groups)
  let live = matches.find(m => m.competitions[0].status.type.state == "in")
  let next = matches.find(m => m.competitions[0].status.type.state == "pre")
  let focus = live ?? next
  let fc = focus == null ? null : focus.competitions[0]
  let fh = fc == null ? null : fc.competitors.find(x => x.homeAway == "home")
  let fa = fc == null ? null : fc.competitors.find(x => x.homeAway == "away")

  // Karonun altına gelen satır: canlıysa skor, değilse sıradaki maçın günü ve saati.
  let mark = focus == null ? "" : live != null ? fc.status.displayClock : fmtTime(parseTime(focus.date), "EEE HH:mm")
  let line = fc == null ? "" : live == null
    ? "${fh.team.abbreviation} - ${fa.team.abbreviation}"
    : "${fh.team.abbreviation} ${fh.score}-${fa.score} ${fa.team.abbreviation}"

  // Karoya sığdığı kadar sıralama satırı.
  let shown = clamp(floor(((tileHeight ?? 300) - 130) / 21), 3, 18)
  let bugun = fmtTime(now, "yyyy-MM-dd")
  let dun = fmtTime(now - 86400, "yyyy-MM-dd")
  let noteRows = unique(map(filter(table, r => r.note != null), r => {d: r.note.description, c: r.note.color}))

  component MiniRow(r) {
    Row {
      gap: 6
      align: center
      Text { text: "${r.pos}"; width: 18; align: center; fontSize: 12; font: mono; bold: true; color: r.note == null ? muted : r.note.color }
      Text { text: get(tr, r.team, r.team); weight: 1; fontSize: 13; maxLines: 1 }
      Text { text: "${r.pts}"; width: 26; align: end; fontSize: 13; font: mono; bold: true }
    }
  }

  component FullRow(r) {
    Row {
      gap: 4
      align: center
      Image { src: r.logo; width: 20; height: 20; fit: contain }
      Text { text: "${r.pos}"; width: 20; align: center; fontSize: 11; font: mono; bold: true; color: r.note == null ? muted : r.note.color }
      Text { text: get(tr, r.team, r.team); weight: 1; fontSize: 12; maxLines: 1 }
      Text { text: "${r.gp}"; width: 22; align: center; fontSize: 11; font: mono; color: muted }
      Text { text: "${r.w}"; width: 22; align: center; fontSize: 11; font: mono }
      Text { text: "${r.d}"; width: 22; align: center; fontSize: 11; font: mono }
      Text { text: "${r.l}"; width: 22; align: center; fontSize: 11; font: mono }
      Text { text: r.gd > 0 ? "+${r.gd}" : "${r.gd}"; width: 28; align: center; fontSize: 11; font: mono; color: r.gd > 0 ? green : r.gd < 0 ? red : muted }
      Text { text: "${r.pts}"; width: 28; align: end; fontSize: 13; font: mono; bold: true }
    }
  }

  component MatchRow(m) {
    let c = m.competitions[0]
    let phase = c.status.type.state
    let isLive = phase == "in"
    let done = phase == "post"
    let h = c.competitors.find(x => x.homeAway == "home")
    let a = c.competitors.find(x => x.homeAway == "away")
    Row {
      gap: 8
      align: center
      Text {
        text: isLive ? c.status.displayClock : done ? "MS" : fmtTime(parseTime(m.date), "HH:mm")
        width: 44; fontSize: 10; font: mono; bold: isLive; color: isLive ? red : muted
      }
      Text { text: get(tr, h.team.displayName, h.team.displayName); weight: 1; align: end; fontSize: 12; maxLines: 1; color: done && h.winner == false ? muted : foreground }
      Text {
        text: isLive || done ? "${h.score}-${a.score}" : "-"
        width: 50; align: center; fontSize: 13; font: mono; bold: true; color: isLive ? red : foreground
      }
      Text { text: get(tr, a.team.displayName, a.team.displayName); weight: 1; fontSize: 12; maxLines: 1; color: done && a.winner == false ? muted : foreground }
    }
  }

  state tab = "table" persist

  onTap: screen()

  Column {
    gap: 6
    fill: true
    Row {
      gap: 6
      align: center
      Image { src: logo; width: 18; height: 18; fit: contain }
      Text { text: "süper lig"; style: label; color: accent; weight: 1; maxLines: 1 }
      Text { text: season; style: small; color: muted; font: mono }
    }
    Column {
      gap: 3
      weight: 1
      if len(table) == 0 {
        Text { text: "puan durumu yükleniyor…"; style: small; color: muted }
      }
      for r, i in table key r.id {
        if i < shown { MiniRow { r: r } }
      }
    }
    if focus != null {
      Column {
        gap: 6
        Box { height: 1; fill: width; background: alpha(muted, 0.3) }
        Row {
          gap: 8
          align: center
          Text {
            text: mark
            width: 52; fontSize: 10; font: mono; bold: live != null; color: live != null ? red : muted
          }
          Text { text: line; weight: 1; fontSize: 13; font: mono; bold: true; maxLines: 1 }
        }
      }
    }
  }

  screen {
    title: "süper lig"
    Column {
      scroll: true
      gap: 12

      Row {
        gap: 10
        align: center
        Image { src: logo; width: 40; height: 40; fit: contain }
        Column {
          gap: 2
          weight: 1
          Text { text: "Süper Lig"; fontSize: 17; bold: true }
          Text { text: season; style: small; color: muted; font: mono }
        }
        Text { text: fmtTime(now, "d MMM HH:mm"); style: small; color: muted; align: end }
      }

      Row {
        gap: 8
        Button { text: "puan durumu"; color: tab == "table" ? accent : muted; onTap: { haptic(); tab = "table" } }
        Button { text: "fikstür"; color: tab == "fxt" ? accent : muted; onTap: { haptic(); tab = "fxt" } }
      }

      if tab == "table" {
        Column {
          gap: 6
          Row {
            gap: 4
            align: center
            Text { text: ""; width: 44 }
            Text { text: "TAKIM"; style: label; color: muted; weight: 1 }
            Text { text: "O"; style: label; color: muted; width: 22; align: center }
            Text { text: "G"; style: label; color: muted; width: 22; align: center }
            Text { text: "B"; style: label; color: muted; width: 22; align: center }
            Text { text: "M"; style: label; color: muted; width: 22; align: center }
            Text { text: "AV"; style: label; color: muted; width: 28; align: center }
            Text { text: "P"; style: label; color: muted; width: 28; align: end }
          }
          for r in table key r.id { FullRow { r: r } }
        }
        if len(noteRows) > 0 {
          Column {
            gap: 4
            for n in noteRows key n.d {
              Row {
                gap: 6
                align: center
                Text { text: "●"; color: n.c; fontSize: 10 }
                Text { text: get(notesTr, n.d, n.d); style: small; color: muted }
              }
            }
          }
        }
      } else {
        if len(matches) == 0 {
          Text { text: "yaklaşan maç yok"; style: small; color: muted }
        }
        for day in days key day {
          Column {
            gap: 6
            Row {
              align: center
              Text { text: day == bugun ? "bugün" : day == dun ? "dün" : fmtTime(parseTime(day), "EEEE d MMMM"); style: label; color: day == bugun ? accent : muted; weight: 1 }
              Text { text: "${len(get(groups, day))} maç"; style: small; color: muted }
            }
            for m in get(groups, day) key m.id { MatchRow { m: m } }
          }
        }
      }

      Text { text: "veri: ESPN · puan durumu 10, canlı skorlar 3 dakikada bir tazelenir"; style: muted; fontSize: 10; align: center }
      Row {
        justify: end
        Button { text: "kapat"; color: muted; onTap: close() }
      }
    }
  }
}
