app "koffan" {
  meta { owl: 9; description: "A shopping list for a self-hosted Koffan server: the lists, their sections and products, ticking things off in the shop and adding new ones, over Koffan's REST API"; version: "1.0"; license: "MIT"; category: "productivity" }
  title: open == 0 ? "koffan" : listName
  back: open != 0
  onBack: { open = 0; adding = false }
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="48" height="48">
    <rect x="2" y="2" width="44" height="44" rx="12" ry="12" fill="#F2A33C"/>
    <polygon points="14.6,19.4 14.6,9.8 21.6,19.8" fill="#FFFFFF"/>
    <polygon points="31,19.4 31,9.8 24,19.8" fill="#FFFFFF"/>
    <path d="M10.4 19.6 L14.1 19.6 L17.9 37 L32.9 37 L36.2 23.6 L15.2 23.6" fill="none" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>"""

  // Where the server is, and the token from its API_TOKEN setting; kept on this phone.
  state url = "" persist
  state token = "" persist
  state setup = true persist

  // The list open (0 for the list of lists), and whether new products are being added.
  state listId = 0 persist
  state open = 0
  state adding = false
  state newName = ""
  state sectionId = 0
  // Products already in the cart are left out of the list (see showTicked below), and each
  // section's counts and ticked products are kept here, so they stay right.
  state showTicked = false persist
  state secCounts = {}
  state secDone = {}
  state secTicked = {}
  state loadSec = 0
  // The list whose sections the counts belong to.
  state seenFor = 0
  // A new list starts with nothing known about its sections.
  when listId != seenFor { secCounts = {}; secDone = {}; secTicked = {}; loadSec = 0; seenFor = listId }

  // What was last loaded from the server, kept so the app opens at once and reads offline.
  state savedLists = [] persist
  state savedHistory = [] persist

  // The last write the server didn't take: its status and what was being done, never the
  // answer itself.
  state err = 0
  state errWhat = ""
  // The token the fields hold when save was tapped, so a refused one is only reported for it.
  state tried = ""

  // Accept what people type: "koffan.local:8080", a trailing slash, or the whole REST base.
  let bare = replace(replace(trim(url), "https://", ""), "http://", "")
  let host = replace(replace(replace(replace(bare, "/api/v1", ""), " ", ""), "/", ""), "\\", "")
  let server = startsWith(trim(url), "https://") ? "https://${host}" : "http://${host}"
  let auth = {Authorization: "Bearer ${token}", Accept: "application/json"}
  let ready = !setup && host != "" && token != ""

  // Only the list on show is asked for. Going back runs refresh(), so the
  // sections and history of the list just opened are read straight away.
  source lists = http(ready ? "${server}/api/v1/lists" : null, auth) every 15s json timeout 15s status
  source sections = http(ready && open == 1 ? "${server}/api/v1/lists/" + int(listId) + "/sections" : null, auth) every 15s json timeout 15s status
  source history = http(ready && open == 1 ? "${server}/api/v1/history" : null, auth) every 5m json timeout 15s status
  // All of one section, to count it and to show its ticked products.
  source sectionItems = http(ready && loadSec != 0 ? "${server}/api/v1/sections/" + int(loadSec) + "/items" : null, auth) every 1m json timeout 15s status
  let liveLists = lists != null && lists.ok ? [(lists.out.lists ?? [])].flatten() : null
  let liveHistory = history != null && history.ok ? ((history.out.items ?? [])).take(60) : null
  when liveLists != null && liveLists != savedLists { savedLists = liveLists }
  when liveHistory != null { savedHistory = liveHistory }
  // A token the server refuses, for the one the fields hold now, is said under them.
  let badToken = lists != null && !lists.ok && lists.code == 401 && token == tried

  let allLists = lists != null ? (liveLists ?? []) : savedLists
  let secs = sections != null && sections.ok ? [(sections.out.sections ?? [])].flatten() : []
  let hist = history != null ? (liveHistory ?? savedHistory) : savedHistory

  // The list only sends a section's products still to get; what is already in the cart is
  // missing from it. So each section's counts are kept here, and a section is read in full
  // (one per tap) to fill them: the section's own line does that.
  let fetched = sectionItems != null && sectionItems.ok && any(sectionItems.out.items ?? [], i => i.section_id == loadSec)
  // What a section read gave: its size and how much of it is in the cart, and, while ticked
  // ones are on show, those products (the list itself leaves them out).
  when fetched {
    let all = sectionItems.out.items
    if any(all, i => i.section_id == loadSec) {
      secCounts = set(secCounts, loadSec, len(all))
      secDone = set(secDone, loadSec, count(all, i => i.completed))
      if showTicked { secTicked = set(secTicked, loadSec, all.filter(i => i.completed)) }
      loadSec = 0
    }
  }

  let cur = first(allLists.filter(l => l.id == listId))
  let listName = cur == null ? "koffan" : cur.name

  let offline = lists != null && !lists.ok
  let failMsg = lists != null && !lists.ok ? (lists.code == 401 ? "the token was refused" : lists.code == 503 ? "the server's API is off: set API_TOKEN there and restart it" : "can't read the lists: ${lists.code ?? "no answer"}") : null

  // A write to the server: handlers put its answer ({code, ok, out}) here, and only a failed
  // one is said, as its status and what was being done — never the answer itself.
  state asked = null
  on asked { if value != null { if !value.ok { err = value.code == 0 ? -1 : value.code } } }

  // The last write the server didn't take, said in one line.
  let why = err == -1 ? "no answer from the server" : err == 401 ? "the token was refused" : err == 404 ? "that isn't on the server any more" : err == 503 ? "the server's API is off" : err >= 500 ? "the server had a problem (${err})" : "the server said ${err}"
  component ErrBar() {
    if err != 0 {
      Row {
        gap: 8
        align: center
        padding: [12, 8]
        background: surface
        Text { text: "✕ couldn't ${errWhat}: ${why}"; style: small; color: red; weight: 1 }
        Button { text: "ok"; onTap: { err = 0; errWhat = "" } }
      }
    }
  }

  // One line in the list of lists: its icon, name, and how much is left.
  component ListRow(l) {
    let total = (l.stats != null && l.stats.total_items != null) ? l.stats.total_items : 0
    let done = (l.stats != null && l.stats.completed_items != null) ? l.stats.completed_items : 0
    let pct = total > 0 ? floor(100 * done / total) : 0
    Row {
      gap: 10
      align: center
      padding: [12, 4]
      background: surface
      onTap: { listId = l.id; open = 1; adding = false; sectionId = 0; err = 0; errWhat = ""; refresh(); haptic() }
      Text { text: (l.icon ?? "") == "" ? "🛒" : l.icon; fontSize: 22; width: 34 }
      Column {
        gap: 1
        weight: 1
        Text { text: l.name; bold: true; maxLines: 1 }
        Text { text: total == 0 ? "nothing on it" : done == total ? "all ${total} bought" : "${total - done} of ${total} to get"; style: small; color: done == total && total > 0 ? green : muted }
      }
      if pct > 0 {
        Text { text: "${pct}%"; style: small; color: done >= total ? green : accent; width: 44; align: end }
      }
    }
  }

  // The list of lists.
  component Lists() {
    Column {
      gap: 6
      padding: [12, 0]
      if failMsg != null {
        Text { text: failMsg; style: small; color: red; padding: [0, 4] }
      }
      if lists == null {
        Text { text: "reading the lists…"; style: muted; padding: [0, 4] }
      } else if len(allLists) == 0 && !offline {
        Text { text: "no lists yet — make one on the koffan web page"; style: muted; padding: [0, 4] }
      }
      for l in allLists key l.id { ListRow { l: l } }
      ErrBar {}
      Spacer { height: 8 + screenInset }
    }
  }

  // One product: a box to tap, its name and note, and −/+ for how many.
  component Line(i) {
    let qty = (num(i.quantity) ?? 0)
    Row {
      gap: 8
      align: center
      padding: [12, 2]
      onTap: { errWhat = "change ${i.name}"; asked = post("${server}/api/v1/items/" + int(i.id) + "/toggle", {}, auth) }
      Text { text: i.completed ? "󰄬" : (i.uncertain ? "?" : "□"); font: icon; fontSize: 20; color: i.completed ? green : i.uncertain ? yellow : muted; width: 26 }
      Column {
        gap: 0
        weight: 1
        Text { text: i.name; color: i.completed ? muted : foreground; maxLines: 2 }
        if (i.description ?? "") != "" || qty > 1 {
          Text { text: [qty > 1 ? "× ${qty}" : "", i.description ?? ""].filter(x => x != "").join(" · "); style: small; color: muted; maxLines: 1 }
        }
      }
      if qty > 1 {
        Button { text: "−"; onTap: { errWhat = "change the number of ${i.name}"; asked = post("${server}/api/v1/items/" + int(i.id) + "/quantity", {delta: -1}, auth) } }
      }
      Button { text: "+"; onTap: { errWhat = "change the number of ${i.name}"; asked = post("${server}/api/v1/items/" + int(i.id) + "/quantity", {delta: 1}, auth) } }
    }
  }

  // Tapping a section's line ticks all of it or takes every tick off; that gives the whole
  // section back, so its counts are known after it.
  component SectionHead(s) {
    let done = secDone[s.id] ?? 0
    let total = max(secCounts[s.id] ?? 0, len(s.items ?? []))
    let full = total > 0 && done >= total
    Row {
      gap: 8
      align: center
      padding: [10, 4]
      onTap: {
        errWhat = (full ? "untick" : "tick") + " all of ${s.name}"
        asked = post("${server}/api/v1/sections/" + int(s.id) + "/" + (full ? "uncheck-all" : "check-all"), {}, auth)
        loadSec = s.id
        refresh()
        haptic()
      }
      Text { text: "${s.name}  ${done}/${total}"; style: label; color: full ? green : muted; weight: 1; maxLines: 1 }
      Text { text: full ? "untick all" : "tick all"; style: small; color: accent; width: 110; align: end }
    }
  }

  // One list, section by section. With ticked ones hidden, a section with nothing left to get
  // becomes one green line, whose button puts the products back.
  component ListView() {
    Column {
      gap: 2
      padding: [12, 0]
      if sections == null {
        Text { text: "reading the list…"; style: muted; padding: [0, 4] }
      } else if !sections.ok {
        Text { text: "can't read this list: ${sections.code ?? "no answer"}"; style: small; color: red; padding: [0, 4] }
      } else if len(secs) == 0 {
        Text { text: "no sections in this list — make one on the koffan web page"; style: muted; padding: [0, 4] }
      }
      for s in secs key s.id {
        if showTicked || len(s.items ?? []) > 0 || (secCounts[s.id] ?? 0) == 0 {
          SectionHead { s: s }
          for i in (showTicked ? (s.items ?? []) : (s.items ?? []).filter(x => !x.completed)) key i.id { Line { i: i } }
          if showTicked {
            for i in (secTicked[s.id] ?? []) key i.id { Line { i: i } }
          }
          if (secCounts[s.id] ?? 0) == 0 && len(s.items ?? []) == 0 {
            Text { text: "nothing here yet"; style: small; color: muted; padding: [0, 30] }
          }
        } else {
          Row {
            gap: 8
            align: center
            padding: [10, 4]
            onTap: {
              errWhat = "untick all of ${s.name}"
              asked = post("${server}/api/v1/sections/" + int(s.id) + "/uncheck-all", {}, auth)
              loadSec = s.id
              refresh()
              haptic()
            }
            Text { text: "✓ ${s.name}"; style: label; color: green; weight: 1; maxLines: 1 }
            Text { text: "all ${secCounts[s.id] ?? 0} in the cart"; style: small; color: green; width: 170 }
            Text { text: "untick all"; style: small; color: accent; width: 110; align: end }
          }
        }
        Spacer { height: 8 }
      }
      if len(secs) > 0 && len(secs.filter(s => len((s.items ?? []).filter(i => !i.completed)) > 0)) == 0 && len(secs.filter(s => (secCounts[s.id] ?? 0) > 0 && (secDone[s.id] ?? 0) < (secCounts[s.id] ?? 0))) == 0 {
        Text { text: "everything is in the cart"; style: muted; padding: [10, 4] }
      }
      Row {
        gap: 8
        align: center
        padding: [12, 8, 12, 4]
        Text { text: showTicked ? "ticked ones are shown" : "ticked ones are hidden"; style: small; color: muted; weight: 1 }
        Button { text: showTicked ? "hide ticked" : "show ticked"; onTap: { showTicked = !showTicked; loadSec = showTicked ? (first(secs.map(s => s.id)) ?? 0) : 0; refresh(); haptic() } }
      }
      ErrBar {}
      Spacer { height: 8 + screenInset }
    }
  }

  // Adding a product: a name, a section, and the usual ones under it.
  component AddView() {
    let low = lower(trim(newName))
    let chosen = sectionId == 0 ? (first(secs.map(s => s.id)) ?? 0) : sectionId
    let sugg = low == "" ? hist.take(25) : hist.filter(h => startsWith(lower(h.name), low)).take(20)
    Column {
      gap: 8
      padding: [12, 0]
      Row {
        gap: 8
        align: center
        Input { text: newName; placeholder: "product…"; focus: true; weight: 1; onChange: newName = value }
        Button {
          text: "add"
          color: low == "" ? muted : accent
          onTap: {
            if low != "" {
              if chosen == 0 {
                err = 0
              } else {
                errWhat = "add ${trim(newName)}"
                asked = post("${server}/api/v1/items", {section_id: int(chosen), name: trim(newName)}, auth)
                newName = ""
              }
            }
          }
        }
      }
      if len(secs) > 0 {
        Text { text: "section"; style: small; color: muted }
        Flow {
          gap: 6
          for s in secs key s.id {
            Button { text: s.name; color: chosen == s.id ? accent : muted; onTap: { sectionId = s.id; haptic() } }
          }
        }
      }
      if len(sugg) > 0 {
        Text { text: low == "" ? "from your history" : "matching"; style: label; color: muted; padding: [4, 0, 0, 0] }
        Flow {
          gap: 6
          for h in sugg key h.id {
            Button {
              text: h.name
              onTap: {
                let sec = sectionId == 0 ? (h.last_section_id ?? 0) : sectionId
                let to = any(secs, s => s.id == sec) ? sec : chosen
                if to != 0 {
                  errWhat = "add ${h.name}"
                  asked = post("${server}/api/v1/items", {section_id: int(to), name: h.name}, auth)
                  haptic()
                }
              }
            }
          }
        }
      }
      if len(hist) == 0 {
        Text { text: "nothing in your history yet; what you add turns up here next time"; style: small; color: muted }
      }
      ErrBar {}
      Spacer { height: 8 + screenInset }
    }
  }

  // Where the server and the token go, from the gear in the header.
  component Settings() {
    Column {
      gap: 10
      padding: [12, 0]
      Text { text: "server"; style: label; color: muted }
      Input { text: url; placeholder: "koffan.local:8080"; onChange: url = value }
      Text { text: "token"; style: label; color: muted }
      Input { text: token; placeholder: "the server's API_TOKEN"; onChange: token = value }
      Text { text: "Set API_TOKEN to a long secret in the Koffan server's settings and restart it; it works on the workspace in API_WORKSPACE_ID. The server's address and this token are kept on this phone, in the app's own storage."; style: small; color: muted }
      Row {
        gap: 8
        Button { text: "save"; color: accent; onTap: { setup = false; err = 0; errWhat = ""; tried = token; refresh(); haptic() } }
        Button { text: "cancel"; onTap: setup = false }
      }
      if badToken {
        Text { text: "the server answered 401: the token doesn't match its API_TOKEN"; style: small; color: red }
      }
      Spacer { height: 8 + screenInset }
    }
  }

  // The header: back, the name, and the way into adding and into settings.
  Row {
    gap: 4
    align: center
    padding: [12, 4, 12, 8]
    if open == 1 || setup {
      Text { text: "‹"; fontSize: 26; color: accent; width: 30; onTap: { if setup { setup = false } else { open = 0; adding = false; haptic() } } }
    }
    Text { text: open == 0 ? (setup ? "koffan setup" : "koffan") : listName; style: title; weight: 1; maxLines: 1 }
    if offline {
      Text { text: "offline"; style: small; color: yellow; width: 60; align: center }
    }
    if !setup {
      if open == 1 {
        Text { text: adding ? "✕" : "+"; fontSize: 24; color: accent; width: 44; align: center; onTap: { adding = !adding; if adding { refresh() }; haptic() } }
      }
      if open == 0 {
        Text { text: "⚙"; fontSize: 18; color: muted; width: 44; align: center; onTap: setup = true }
      }
    }
  }

  if setup {
    Settings {}
  } else if open == 0 {
    Column {
      scroll: true
      gap: 0
      Lists {}
    }
  } else {
    Column {
      scroll: true
      gap: 0
      if adding {
        AddView {}
      }
      ListView {}
    }
  }
}
