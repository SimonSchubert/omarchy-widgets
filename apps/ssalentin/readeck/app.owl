app "readeck" {
  edge: true
  statusBar: true

  meta { owl: 18; description: "A Readeck client for a server or an export: lists, labels, search, a reader with pictures, notes and bulk changes. Summary and tidy-up use Claude Code, which sends the text to Anthropic"; version: "2.4"; license: "MIT"; category: "news" }

  title: ""
  back: readId != "" || showMenu || showSearch || showAdd || picking || view == "setup" || view == "all" || label != ""
  onBack: {
    notice = ""
    said = ""
    if showMenu {
      showMenu = false
    } else if readId != "" {
      if showTypo {
        showTypo = false
      } else if editing {
        editing = false
        confirmId = ""
      } else if !reading && fromReader {
        fromReader = false
        reading = true
        confirmId = ""
      } else {
        // Leaving keeps what was actually read in Readeck, not an instant "read": the
        // last page counts as finished. It goes in the same queue as every other tap.
        if reading && len(para) > 0 && item.prog != 100 && int(readPct) != (item.prog ?? -1) {
          wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":" + "${int(readPct)}" + "}", patch: {read_progress: int(readPct)}})]
        }
        fromReader = false
        readId = ""
        confirmId = ""
      }
    } else if showSearch {
      showSearch = false
      typed = ""
      query = ""
    } else if showAdd {
      showAdd = false
    } else if picking {
      picking = false
      picked = []
    } else if view == "setup" {
      view = "unread"
      connectMsg = ""
    } else if label != "" {
      // A label's bookmarks go back to the list of labels they came from.
      label = ""
      view = "labels"
    } else if view == "all" {
      view = "unread"
    } else {
      view = "unread"
    }
  }
  // Readeck's own mark, on a deep sea-blue tile of its own as the launcher's apps.md asks:
  // a 256 canvas with the rounded plate the drawer draws no frame around. The arrow takes
  // the theme's accent (currentColor); the rest keep Readeck's yellow, blue and teal.
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#0e2b38"/>
    <g transform="translate(24.9 29.4) scale(0.842)">
      <path fill="#ffcb5c" d="m191.012 69.77-99.82 46.539V187.8l127.203-59.309Z"/>
      <path fill="#37bed9" d="M91.191 117.809v71.496l105.887 49.367-6.348-38.711 33.73-20.012Z"/>
      <path fill="#2c93b6" d="M26.387 38.969H91.19v191.98H26.387Z"/>
      <path fill="#37bed9" d="M91.191 3.223 26.387 38.969l192.008 89.523V57Z"/>
      <path fill="currentColor" d="M91.191 69.188v47.12l50.536-23.558Z"/>
    </g>
  </svg>"""

  // Monochrome 24x24 white SVG icons tinted via Image { tint: ... }.
  asset icUnread = base64""
  asset icFav = base64""
  asset icFavFill = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZmZmZiIgc3Ryb2tlPSIjZmZmZmZmIiBzdHJva2Utd2lkdGg9IjEuNiIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIgZD0iTTEyIDMuNWwyLjcgNS41IDYgLjktNC4zIDQuMiAxIDYtNS40LTIuOC01LjQgMi44IDEtNkwzLjMgOS45bDYtLjl6Ii8+PC9zdmc+"
  asset icArchive = base64""
  asset icLabels = base64""
  asset icSearch = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjZmZmZmZmIiBzdHJva2Utd2lkdGg9IjEuOSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48Y2lyY2xlIGN4PSIxMSIgY3k9IjExIiByPSI3Ii8+PHBhdGggZD0iTTIwIDIwbC0zLjUtMy41Ii8+PC9zdmc+"
  asset icPlus = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjZmZmZmZmIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTEyIDV2MTRNNSAxMmgxNCIvPjwvc3ZnPg=="
  asset icMore = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGNpcmNsZSBjeD0iMTIiIGN5PSI1LjUiIHI9IjEuNiIgZmlsbD0iI2ZmZmZmZiIvPjxjaXJjbGUgY3g9IjEyIiBjeT0iMTIiIHI9IjEuNiIgZmlsbD0iI2ZmZmZmZiIvPjxjaXJjbGUgY3g9IjEyIiBjeT0iMTguNSIgcj0iMS42IiBmaWxsPSIjZmZmZmZmIi8+PC9zdmc+"
  asset icBack = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjZmZmZmZmIiBzdHJva2Utd2lkdGg9IjIuMSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNMTUgMThsLTYtNiA2LTYiLz48L3N2Zz4="
  asset icInfo = base64""
  asset icSync = base64""
  asset icSelect = base64""
  asset icSettings = base64""
  asset icRead = base64""
  asset icOpen = base64""
  asset icCopy = base64""
  asset icShare = base64""
  asset icEdit = base64""
  asset icTrash = base64""
  asset icSparkle = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjZmZmZmZmIiBzdHJva2Utd2lkdGg9IjEuOCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTEyIDJsMi40IDcuNkwyMiAxMmwtNy42IDIuNEwxMiAyMmwtMi40LTcuNkwyIDEybDcuNi0yLjRMMTIgMnoiLz48L3N2Zz4="
  asset icDownload = base64""
  asset icServer = base64""

  // The library, from the server or from an export of it, as the app's own helper
  // (owl-readeck, installed above) fetches it: one bookmark a line.
  requires { pacman: ["bash", "coreutils", "curl", "findutils", "grep", "jq", "python", "sed", "unzip", "util-linux"] }

  // The app's helpers: owl-readeck talks to the server and keeps the library on disk,
  // owl-readeck-read turns an article's HTML into the text the reader draws. They are
  // in this file as plaintext, and are written to ~/.local/bin on first run, so the
  // app is one self-contained file. Nothing is downloaded, decoded or installed from
  // anywhere else; the only network traffic is to the Readeck server the user names.
  source installer = cmd("""# Installs the app's own helpers from this file into ~/.local/bin, and only when
# their version marker is missing: owl-readeck talks to the Readeck server, and
# owl-readeck-read turns an article's HTML into the text the reader draws. Both are
# plaintext in this file, written by cat with a quoted heredoc, so nothing is decoded
# or fetched; they live beside the app's cache, not on a command line.
set -uo pipefail
umask 077
bin="$HOME/.local/bin"
mkdir -p "$bin" || exit 1
if ! grep -qF '# owl-readeck 1.18' "$bin/owl-readeck" 2>/dev/null; then
  cat > "$bin/owl-readeck" << 'READECK_LIB_END'
#!/bin/bash
# owl-readeck 1.18: the script side of the Readeck app (readeck.owl).
# Fetches a Readeck server's bookmarks into the export the app reads, imports
# a Readeck export without a server, and saves changes to bookmarks.
# Every run says what it is doing in readeck-sync.json or readeck-op.err, so the
# app can show a sync or a failed change instead of guessing.
set -u
umask 077
cache="$HOME/.cache/omalauncher"
out="$cache/readeck.jsonl"
status="$cache/readeck-sync.json"
journal="$cache/readeck-ops.jsonl"
opfail="$cache/readeck-op-failed.txt"
mode="${1:-}"
mkdir -p "$HOME/.cache/omalauncher" 2>/dev/null || true
# Ops and syncs keep their errors apart: a fetch can't make a change look failed.
errfile="$cache/readeck-other.err"
case "$mode" in
  fetch | reload) errfile="$cache/readeck-sync.err" ;;
  change | bulk | add | delete | labelrm | import | import-file)
    errfile="$cache/readeck-op.err" ;;
esac
: > "$errfile" 2>/dev/null || true
case "$mode" in
  bulk | change) : > "$opfail" 2>/dev/null || true ;;
esac

# sync_state STATE [MESSAGE] [ITEMS]: the one line the app reads to show whether
# the library is being fetched, when it last worked, and why it didn't.
sync_state() {
  s="$1" m="${2:-}" n="${3:-0}" at=$(date +%s)
  # Keep the last time a fetch worked when this one is still running or failed, so the
  # app can say both "synced 5m ago" and "the last try failed".
  ok=$(jq -r '.lastOk // (if .state == "ok" then .at else 0 end)' "$status" 2>/dev/null || echo 0)
  case "$ok" in ''|*[!0-9]*) ok=0 ;; esac
  [ "$s" = ok ] && ok="$at"
  jq -cn --arg s "$s" --arg m "$m" --argjson at "$at" --argjson n "$n" --argjson ok "$ok" \
    '{state: $s, msg: $m, at: $at, items: $n, lastOk: $ok}' > "$status.tmp" 2>/dev/null \
    && mv "$status.tmp" "$status"
}

# journal_pending ID JSON: a change the app's copy has already taken, written before
# the server is asked, so a fetch that replaces the list while it is in flight can
# still replay it. Prints the entry's token; journal_drop takes it back when the
# server refuses the change and the copy is restored.
journal_pending() {
  [ -n "${journal:-}" ] || return 0
  t="$(date +%s).$$.$RANDOM"
  (
    flock 7
    jq -cn --arg id "$1" --argjson p "$2" --argjson at "$(date +%s)" --arg t "$t" \
      '{id: $id, p: $p, at: $at, t: $t}' >> "$journal" 2>/dev/null
  ) 7> "$journal.lock"
  printf '%s' "$t"
}
journal_drop() {
  [ -n "${1:-}" ] && [ -f "$journal" ] || return 0
  (
    flock 7
    jq -c --arg t "$1" 'select(.t != $t)' "$journal" > "$journal.tmp" 2>/dev/null \
      && mv "$journal.tmp" "$journal"
  ) 7> "$journal.lock"
  return 0
}

die() {
  echo "$*" >> "$errfile" 2>/dev/null || true
  if [ "${mode:-}" = fetch ] || [ "${mode:-}" = reload ]; then
    sync_state failed "$*"
  fi
  echo "readeck: $*" >&2
  exit 1
}

# One bookmark, as the app reads it: the server's own fields (lower case) under the
# names the app uses, in the shape it expects. Reading time is worked out from the
# word count when the server doesn't say (200 words a minute).
normalise='
  map(select(type == "object" and .id != null))
  | sort_by([ .id, -(tostring | length) ])
  | unique_by(.id)
  | sort_by(-((.published // .created // "0") | tostring | .[0:19] | gsub("[^0-9]"; "") | tonumber? // 0))
  | map({
      id: (.id | tostring),
      title: (.title // ""),
      url: (.url // ""),
      site_name: (.site_name // .site // ""),
      is_marked: (.is_marked == true),
      is_archived: (.is_archived == true),
      is_deleted: (.is_deleted == true),
      read_progress: (.read_progress | tonumber? // null),
      note: (.note // ""),
      labels: ((.labels // []) | if type == "array" then map(tostring) else [tostring] end),
      description: (.description // ""),
      authors: ((.authors // []) | if type == "array" then map(tostring) else [tostring] end),
      lang: (.lang // ""),
      word_count: ((.word_count | tonumber?) // null),
      reading_time: ((.reading_time | tonumber?) // ((.word_count | tonumber? // 0) / 200 | ceil | if . > 0 then . else null end)),
      published: ((.published // .created // null) | if . == null then null else tostring end),
      created: ((.created // null) | if . == null then null else tostring end),
      document_type: (.document_type // .type // ""),
      has_article: (.has_article == true),
      site_icon: (.resources.icon.src // ""),
      image: (.resources.image.src // ""),
      thumbnail: (.resources.thumbnail.src // "")
    })
  | .[]
'
command -v jq >/dev/null || die "jq is missing (pacman -S jq)"

# A Readeck export (the zip its profile's export button makes: data.json and a
# bookmarks/<id>/info.json each) to the app's list: one line per bookmark, only
# what the app shows. A data.jsonl, from other exports, is read too.
import_from() {
  [ -f "$1" ] || die "no such file: $1"
  mkdir -p "$cache"
  # One library writer at a time: an import waits for a fetch to finish, and no fetch
  # starts under it, so neither can replace the other's result.
  exec 8> "$cache/readeck-fetch.lock"
  flock 8
  work=$(mktemp -d "$cache/readeck-import.XXXXXX") || die "couldn't make a temporary folder"
  trap 'rm -rf "$work"' EXIT

  case "$1" in
    *.zip) unzip -q -o "$1" -d "$work" || die "couldn't open $1" ;;
    *.jsonl) cp "$1" "$work/data.jsonl" || die "couldn't read $1" ;;
    *) cp "$1" "$work/data.json" || die "couldn't read $1" ;;
  esac

  # Every bookmark's info.json (capitalised fields), or a data.jsonl (lower case).
  files=$(find "$work" -name info.json; [ -f "$work/data.jsonl" ] && echo "$work/data.jsonl")
  [ -n "$files" ] || die "no bookmarks in $1"
  # shellcheck disable=SC2086
  # shellcheck disable=SC2086
  jq -c -s '
    [ .[] | select(type == "object") ]
    | map(select((.UID // .id) != null))
    | map({
        id: (.UID // .id),
        title: (.Title // .title // ""),
        url: (.URL // .url // ""),
        site_name: (.SiteName // .site_name // .Site // .site // ""),
        is_marked: ((.IsMarked // .is_marked) == true or (.IsMarked // .is_marked) == "true"),
        is_archived: ((.IsArchived // .is_archived) == true or (.IsArchived // .is_archived) == "true"),
        read_progress: (if (.ReadProgress // .read_progress) == null then null else ((.ReadProgress // .read_progress) | tonumber? // null) end),
        note: (.Note // .note // ""),
        labels: (((.Labels // .labels) // []) | if type == "array" then map(tostring) else [tostring] end),
        description: (.Description // .description // ""),
        authors: (((.Authors // .authors) // []) | if type == "array" then map(tostring) else [tostring] end),
        lang: (.Lang // .lang // ""),
        word_count: (((.WordCount // .word_count) | tonumber?) // null),
        published: (.Published // .published // .Date // .created // null),
        created: (.Created // .created // null),
        document_type: (.DocumentType // .document_type // ""),
        has_article: ((.HasArticle // .has_article) == true or (.DocumentType // .document_type // "") == "article")
      })
    | '"$normalise"'
' $files > "$out.tmp" 2>/dev/null || die "couldn't read the bookmarks in $1"
  ( flock 9; mv "$out.tmp" "$out" ) 9> "$out.lock"

  # The articles' text and pictures too, so the export reads without the
  # server: each bookmark's container/index.html, and the files its info.json
  # names (img/icon.png, img/thumbnail.jpeg, ...), copied to img/<id>-<name>.
  mkdir -p "$img_dir" || die "couldn't make the pictures' folder"
  : > "$work/paths.tmp"
  for info in "$work"/bookmarks/*/info.json; do
    [ -f "$info" ] || continue
    box=$(dirname "$info")
    id=$(basename "$box")
    [ -f "$box/container/index.html" ] && { extract "$id" "$box/container/index.html" || true; localize_images "$id" "" "" || true; }
    for name in $(jq -r '(.Files // {}) | to_entries[]
                          | select(.key as $k | ["article", "log", "props"] | index($k) | not)
                          | .value.name' "$info" 2>/dev/null); do
      [ -f "$box/container/$name" ] || continue
      copy="$img_dir/$id-$(basename "$name")"
      cp "$box/container/$name" "$copy" 2>/dev/null || continue
      case "$name" in
        img/icon.*) key=site_icon ;;
        img/thumbnail.*) key=thumbnail ;;
        img/image.*) key=image ;;
        *) continue ;;
      esac
      jq -cn --arg id "$id" --arg k "$key" --arg f "$copy" '{id: $id, k: $k, f: $f}' \
        >> "$work/paths.tmp"
    done
    # The article's own pictures (_resources/) too, so its img lines localise.
    for res in "$box/container/_resources/"*; do
      [ -f "$res" ] || continue
      cp "$res" "$img_dir/$id-$(basename "$res")" 2>/dev/null || continue
    done
  done
  # Point each bookmark's pictures at their copies, in one pass over the list.
  if [ -s "$work/paths.tmp" ]; then
    jq -s -c '.' "$work/paths.tmp" > "$work/paths.json" 2>/dev/null \
      && jq -c -s --slurpfile idx "$work/paths.json" '
        $idx[0] as $ix
        | . as $list
        | map(. as $b | reduce ($ix[] | select(.id == $b.id)) as $e
              ($b; .[$e.k] = $e.f))
        | .[]
      ' "$out" > "$out.img" 2>/dev/null \
      && mv "$out.img" "$out" || true
  fi
  # An import is the whole library now; changes from before it must not replay over it.
  ( flock 7; : > "$journal" ) 7> "$journal.lock"
}
# The AI harness, Claude Code: a prompt in, text out, with no tools and no session, so
# it only writes an answer. It is not local: Claude Code sends the prompt and the
# article's text to Anthropic, on the user's own Claude account. Finds it even when
# mise has no version set for the shim, which is how it is on this phone.
ai_bin() {
  if [ -n "${OWL_READECK_AI:-}" ] && [ -x "${OWL_READECK_AI}" ]; then
    echo "$OWL_READECK_AI"
    return 0
  fi
  if command -v mise >/dev/null 2>&1; then
    dir=$(mise where claude 2>/dev/null) && [ -x "$dir/claude" ] && { echo "$dir/claude"; return 0; }
  fi
  for dir in "$HOME"/.local/share/mise/installs/claude/*/; do
    [ -x "$dir/claude" ] && { echo "${dir}claude"; return 0; }
  done
  return 1
}

# ai "$PROMPT" < input: the harness's answer, or nothing when it isn't there.
ai() {
  bin=$(ai_bin) || { echo "readeck: the AI harness (claude) isn't installed" >&2; return 1; }
  # --tools "" so it can run nothing; --print for one answer; a long timeout for a
  # long article. stderr is dropped: its chatter isn't the answer.
  timeout 300 "$bin" --print --tools "" \
    --system-prompt "You are a text transformation function. You never chat, never ask questions, never offer choices, and never comment on the input. You output only the requested result, nothing else." \
    "$1" <&0
}

# http METHOD URL TOKEN BODY ERROR: send a change to the server and die with the
# server's own words when it refuses, so the app can say why ("401 the token isn't
# accepted", "409 a bookmark with this URL is already there") instead of "failed".
http() {
  method="$1" url="$2" token="$3" body="$4" what="$5"
  if [ -n "$body" ]; then
    resp=$(curl -sS --max-time 25 -X "$method" -H 'Content-Type: application/json' \
      -H 'Accept: application/json' -H "Authorization: Bearer $token" \
      --data-binary "$body" -w '\n%{http_code}' "$url" 2>&1) \
      || die "$what: couldn't reach the server"
  else
    resp=$(curl -sS --max-time 25 -X "$method" -H 'Accept: application/json' \
      -H "Authorization: Bearer $token" -w '\n%{http_code}' "$url" 2>&1) \
      || die "$what: couldn't reach the server"
  fi
  code=$(printf '%s' "$resp" | tail -1)
  text=$(printf '%s' "$resp" | sed '$d')
  case "$code" in
    2*) return 0 ;;
    401 | 403) die "$what: the token isn't accepted ($code)" ;;
    *) msg=$(printf '%s' "$text" | jq -r '.message // .error // empty' 2>/dev/null | head -1)
       die "$what: ${msg:-$code}" ;;
  esac
}

# urienc VALUE: one path or query component, escaped, for a bookmark's id.
urienc() {
  jq -rn --arg v "$1" '$v|@uri'
}
# jid VALUE: VALUE as a one-item JSON array, as apply() takes it.
jid() {
  jq -cn --arg v "$1" '[$v]'
}

# apply JSON IDSJSON: what the app's own copy of these bookmarks should say from now
# on, so a change shows in the list at once instead of after a whole library fetch.
# IDSJSON is a JSON array of ids; the change's fields are merged into their lines.
apply() {
  [ -f "$out" ] || return 0
  json="$1" ids="$2"
  # One patch at a time, and a temp name of its own, so a change can't collide with
  # a fetch writing the list at the same moment.
  (
    flock 9
    jq -c --argjson j "$json" --argjson ids "$ids" \
      '. as $b | if ($ids | index($b.id | tostring)) then . * $j else . end' \
      "$out" > "$out.patch.tmp" 2>/dev/null \
      && mv "$out.patch.tmp" "$out" || rm -f "$out.patch.tmp"
  ) 9> "$out.lock"
  return 0
}

# restore ID FILE: the bookmark's line as FILE had it, putting back a change the
# server refused after the app's own copy had already been patched.
restore() {
  id="$1" from="$2"
  [ -f "$from" ] || return 0
  (
    flock 9
    jq -c --arg id "$id" --slurpfile old "$from" '
      . as $cur
      | ($old | map(select((.id | tostring) == $id)) | first) as $o
      | if ($cur.id | tostring) == $id and $o != null then $o else $cur end
    ' "$out" > "$out.patch.tmp" 2>/dev/null && mv "$out.patch.tmp" "$out" || rm -f "$out.patch.tmp"
  ) 9> "$out.lock"
  return 0
}

# The reader: one article as the light text the app draws, in
# $cache/readeck-read/<id>.jsonl (owl-readeck-read does the HTML).
read_dir="$cache/readeck-read"
img_dir="$cache/readeck-images"
ai_dir="$cache/readeck-ai"
extract() {
  # extract ID SOURCE: SOURCE is an HTML file, or - for stdin.
  mkdir -p "$read_dir" || die "couldn't make the reader's folder"
  "$(dirname "$0")/owl-readeck-read" "$2" "$read_dir/$1.jsonl.tmp" || die "couldn't read the article"
  mv "$read_dir/$1.jsonl.tmp" "$read_dir/$1.jsonl"
}

# localize_images ID BASE TOKEN: point the article's img lines at files on disk,
# so the reader draws them without the server and without a token in a URL.
# Server-relative srcs are downloaded with the token; an export's relative srcs
# already have their copies in img_dir; external http srcs are left for the
# Image node to fetch. One jq pass in, one out, so long articles stay fast.
localize_images() {
  id="$1" base="$2" token="$3"
  f="$read_dir/$id.jsonl"
  [ -f "$f" ] || return 0
  mkdir -p "$img_dir" 2>/dev/null || return 0
  work=$(mktemp -d "$cache/readeck-img.XXXXXX") || return 0
  jq -s -r 'to_entries[] | select(.value.k == "img") | "\(.key)\t\(.value.t // "")"' \
    "$f" > "$work/list" 2>/dev/null || { rm -rf "$work"; return 0; }
  [ -s "$work/list" ] || { rm -rf "$work"; return 0; }
  : > "$work/map"
  while IFS=$'\t' read -r i t; do
    [ -n "$t" ] || continue
    new=""; url=""
    case "$t" in
      http://* | https://*)
        [ -n "$base" ] && [ "${t#"$base"/}" != "$t" ] && url="$t" ;;
      /*) [ -n "$base" ] && url="$base$t" ;;
      *) cand="$img_dir/$id-$(basename "$t")"; [ -f "$cand" ] && new="$cand" ;;
    esac
    if [ -n "$url" ]; then
      ext="${t##*.}"
      case "$ext" in jpg | jpeg | png | gif | webp | svg | avif) ;; *) ext=jpg ;; esac
      dest="$img_dir/$id-img$i.$ext"
      curl -fsS --max-time 30 -H "Authorization: Bearer $token" -o "$dest" "$url" 2>/dev/null \
        && new="$dest"
    fi
    [ -n "$new" ] && jq -cn --argjson i "$i" --arg f "$new" '{i: $i, f: $f}' >> "$work/map"
  done < "$work/list"
  if [ -s "$work/map" ]; then
    jq -c -s --slurpfile m "$work/map" '
      $m as $ix
      | to_entries
      | map(.key as $k | .value
            | if .k == "img" then
                (first($ix[] | select(.i == $k)) // null) as $e
                | if $e != null then .t = $e.f else . end
              else . end)
      | .[]
    ' "$f" > "$f.img" 2>/dev/null && mv "$f.img" "$f"
  fi
  rm -rf "$work"
}

case "$mode" in
add)
  # add BASE TOKEN URL: save a link to read.
  [ $# -eq 4 ] || die "usage: $0 add BASE TOKEN URL"
  http POST "$2/api/bookmarks" "$3" "$(jq -cn --arg u "$4" '{url: $u}')" \
    "couldn't save the link"
  ;;
change)
  # change BASE TOKEN ID JSON: one change to a bookmark. The app's own copy is patched
  # first, so the row shows it at once, without waiting for the server; with a server it
  # then goes there, and is put back if the server refuses it. An imported library is
  # changed on disk alone.
  [ $# -eq 5 ] || die "usage: $0 change BASE TOKEN ID '{json}'"
  # With a server, journal the local change before it is made: a fetch replacing the
  # list while the request is in flight can then replay it, not put the old value back.
  token=""
  if [ -n "$2" ] && [ -n "$3" ]; then
    token=$(journal_pending "$4" "$5")
  fi
  prev=$(mktemp "$out.before.XXXXXX") || die "couldn't make a temporary file"
  ( flock 9; cp -f "$out" "$prev" 2>/dev/null ) 9> "$out.lock"
  apply "$5" "$(jq -cn --arg v "$4" '[$v]')"
  if [ -n "$2" ] && [ -n "$3" ]; then
    # In a subshell, so http's die only ends it: the change can be put back first.
    if ! ( http PATCH "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')" "$3" "$5" \
             "couldn't save the change" ); then
      # Drop the replay first: a fetch that already saw the pending entry must not put
      # the refused value back after the restore.
      journal_drop "$token"
      restore "$4" "$prev"
      echo "$4" >> "$opfail" 2>/dev/null || true
      rm -f "$prev"
      exit 1
    fi
  fi
  rm -f "$prev"
  ;;
bulk)
  # bulk BASE TOKEN JSON IDSJSON: the same change to several bookmarks. IDSJSON is a
  # JSON array of their ids, so the app can pass them as one quoted word. Requests go
  # four at a time (a slow server doesn't make a long queue take minutes), each is
  # patched in the app's copy as it lands, and the ids the server refused go to
  # readeck-op-failed.txt so the app can show and retry only those.
  [ $# -eq 5 ] || die "usage: $0 bulk BASE TOKEN JSON IDSJSON"
  base="$2" token="$3" json="$4"; ok=0
  total=$(printf '%s' "$5" | jq -r 'if type == "array" then length else 0 end' 2>/dev/null || echo 0)
  if [ -n "$base" ] && [ -n "$token" ]; then
    work=$(mktemp -d "$cache/readeck-bulk.XXXXXX") || die "couldn't make a temporary folder"
    trap 'rm -rf "$work"' EXIT
    printf '%s' "$5" | jq -r '.[] | tostring' > "$work/ids" 2>/dev/null || : > "$work/ids"
    export base token json errfile opfail out journal mode
    export -f http apply journal_pending journal_drop die urienc jid
    xargs -P 4 -n 1 bash -c '
      id="$1"
      if ( http PATCH "$base/api/bookmarks/$(urienc "$id")" "$token" "$json" \
               "couldn'"'"'t change $id" ); then
        journal_pending "$id" "$json" >/dev/null
        apply "$json" "$(jid "$id")"
      else
        printf "%s\n" "$id" >> "$opfail"
      fi
    ' _ < "$work/ids" 2>/dev/null
    # wc -l, not grep -c: grep -c prints 0 but exits 1 on an empty file, and the
    # "|| echo 0" then made nfail "0\n0", killing the script after every all-ok bulk.
    nfail=$(wc -l < "$opfail" 2>/dev/null || echo 0)
    case "$nfail" in ''|*[!0-9]*) nfail=0 ;; esac
    ok=$((total - nfail))
  else
    apply "$json" "$5"
    ok="$total"
  fi
  echo "changed $ok/$total"
  [ "$ok" -eq "$total" ] || exit 1
  ;;
delete)
  # delete BASE TOKEN ID: delete a bookmark for good (the app's "delete" only marks it).
  [ $# -eq 4 ] || die "usage: $0 delete BASE TOKEN ID"
  http DELETE "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')" "$3" "" \
    "couldn't delete the bookmark"
  ;;
ai-check)
  # ai-check: "ok" when Claude Code is there to use, "no" when it isn't.
  if bin=$(ai_bin); then
    echo "ok $("$bin" --version 2>/dev/null | head -1)"
  else
    echo "no"
  fi
  ;;
find)
  # find WORDS: the ids of the articles whose saved text holds all the words, one a
  # line, for the app's search to look past titles. Local: no server, no network.
  [ $# -ge 2 ] || die "usage: $0 find WORDS"
  shift
  [ -d "$read_dir" ] || exit 0
  # Each word must be in a file; words with a quote or a dash first are left out.
  for f in "$read_dir"/*.jsonl; do
    [ -f "$f" ] || continue
    hit=1
    for w in "$@"; do
      grep -qiF -- "$w" "$f" || { hit=0; break; }
    done
    [ "$hit" = 1 ] && basename "$f" .jsonl
  done
  ;;
labels)
  # labels BASE TOKEN: the server's labels and their counts, one a line.
  [ $# -eq 3 ] || die "usage: $0 labels BASE TOKEN"
  curl -fsS --max-time 20 -H 'Accept: application/json' -H "Authorization: Bearer $3" \
    "$2/api/bookmarks/labels" > "$cache/readeck-labels.json" || die "couldn't fetch the labels"
  jq -r 'if type == "array" then .[] | "\(.name)\t\(.bookmark_count // .count // 0)" else empty end' \
    "$cache/readeck-labels.json" 2>/dev/null || true
  ;;
labelrm)
  # labelrm BASE TOKEN NAME: delete a label. Readeck has no API to make one; a label
  # comes with the first bookmark given it.
  [ $# -eq 4 ] || die "usage: $0 labelrm BASE TOKEN NAME"
  http DELETE "$2/api/bookmarks/labels?name=$(jq -rn --arg v "$4" '$v|@uri')" "$3" "" "couldn't delete the label"
  ;;
status)
  # status BASE TOKEN: what the server says about the token, for "connect".
  # Prints "ok <count>" or "error <the status and its message>".
  [ $# -eq 3 ] || die "usage: $0 status BASE TOKEN"
  resp=$(curl -sS --max-time 15 -H 'Accept: application/json' -H "Authorization: Bearer $3" \
    -w '\n%{http_code}' "$2/api/bookmarks?limit=1" 2>&1) || { echo "error couldn't reach $2"; exit 0; }
  code=$(printf '%s' "$resp" | tail -1)
  body=$(printf '%s' "$resp" | sed '$d')
  case "$code" in
    2*) echo "ok $(printf '%s' "$body" | jq -r 'if type == "array" then length else 0 end' 2>/dev/null || echo 0)" ;;
    401 | 403) echo "error ${code} the token isn't accepted" ;;
    *) echo "error ${code} $(printf '%s' "$body" | jq -r '.message // .error // empty' 2>/dev/null | head -1)" ;;
  esac
  ;;
summary)
  # summary ID: a short summary of the article, from Claude Code (which sends the text
  # to Anthropic), kept in
  # $cache/readeck-ai/<id>.summary so it's made once.
  [ $# -eq 2 ] || die "usage: $0 summary ID"
  id="$2"
  src="$read_dir/$id.jsonl"
  [ -f "$src" ] || die "the article's text isn't saved yet"
  out_file="$ai_dir/$id.summary"
  [ -s "$out_file" ] && { cat "$out_file"; exit 0; }
  mkdir -p "$ai_dir" || die "couldn't make the AI folder"
  body=$(jq -r 'select(.k != "img") | .t' "$src" 2>/dev/null | head -c 12000) || die "couldn't read the article"
  [ -n "$body" ] || die "the article's text is empty"
  ans=$(printf '%s' "$body" | ai 'You are a summariser. The text given to you is one article. Write a summary of it in at most 3 sentences and no more than 70 words: plain prose, no headings, no bullet points, no commentary about the text, no questions, no preamble. Reply with the summary alone.') \
    || die "the AI harness couldn't summarise it"
  ans=$(printf '%s' "$ans" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  [ -n "$ans" ] || die "the AI harness gave nothing back"
  printf '%s\n' "$ans" > "$out_file.tmp" && mv "$out_file.tmp" "$out_file"
  cat "$out_file"
  ;;
pretty)
  # pretty ID: the article's text tidied by Claude Code (sent to Anthropic) — same words, same
  # paragraphs, cast to well-formed sentences — kept in $ai_dir/<id>.pretty as the
  # same JSON lines the reader draws.
  [ $# -eq 2 ] || die "usage: $0 pretty ID"
  id="$2"
  src="$read_dir/$id.jsonl"
  [ -f "$src" ] || die "the article's text isn't saved yet"
  out_file="$ai_dir/$id.pretty"
  [ -s "$out_file" ] && exit 0
  mkdir -p "$ai_dir" || die "couldn't make the AI folder"
  # Long articles go a batch at a time (about 6000 characters), so the answer fits.
  : > "$out_file.tmp"
  batch=; size=0
  tidy() {
    [ -n "$batch" ] || return 0
    ans=$(printf '%s' "$batch" | ai 'You tidy extracted web article text. The input is JSON lines: {"k": kind, "t": text}, where kind is h (heading), p (paragraph), q (quote), li (list item), fig (caption) or img (an image path). Keep img lines exactly as they are, path included.

Rewrite each "t" so it reads cleanly: mend sentences broken by extraction, fix stray spaces, doubled punctuation and hyphenation, and use typographic quotes and dashes. Keep the same words and the same meaning: do not summarise, shorten, add or reorder anything. Keep the same kinds and exactly one output line for each input line.

Reply with those JSON lines only, no code fence, no comment.') || return 1
    printf '%s\n' "$ans" | grep -E '^\s*\{' >> "$out_file.tmp"
    batch=; size=0
  }
  while IFS= read -r line; do
    n=${#line}
    if [ $((size + n)) -gt 6000 ] && [ -n "$batch" ]; then
      tidy || { rm -f "$out_file.tmp"; die "the AI harness couldn't tidy the article"; }
    fi
    batch="$batch$line
"
    size=$((size + n))
  done < "$src"
  tidy || { rm -f "$out_file.tmp"; die "the AI harness couldn't tidy the article"; }
  # Only trust a tidy that kept the article's shape; otherwise keep the plain text.
  want=$(wc -l < "$src")
  got=$(wc -l < "$out_file.tmp")
  if [ "$got" -lt $((want * 9 / 10)) ]; then
    rm -f "$out_file.tmp"
    die "the AI harness lost lines while tidying ($got of $want)"
  fi
  mv "$out_file.tmp" "$out_file"
  ;;
import-file)
  # import-file FILE: a data.jsonl from a Readeck export, no server needed.
  [ $# -eq 2 ] || die "usage: $0 import-file FILE"
  import_from "$2"
  ;;
read)
  # read BASE TOKEN ID: one article's text, from the server.
  [ $# -eq 4 ] || die "usage: $0 read BASE TOKEN ID"
  body=$(curl -fsS --max-time 30 -H 'Accept: text/html' -H "Authorization: Bearer $3" \
    "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')/article") \
    || die "couldn't fetch the article"
  printf '%s' "$body" | extract "$4" -
  localize_images "$4" "$2" "$3"
  ;;
import)
  # import BASE TOKEN: the server's export, made now, read here.
  [ $# -eq 3 ] || die "usage: $0 import BASE TOKEN"
  mkdir -p "$cache"
  curl -fsS --max-time 600 -X POST -H 'Accept: application/zip' \
    -H "Authorization: Bearer $3" -o "$cache/readeck-export.zip" "$2/profile/export" \
    || die "couldn't download the export"
  import_from "$cache/readeck-export.zip"
  ;;
fetch | reload)
  # fetch BASE TOKEN [PAGES]: the library as the server has it now. Two lists (not
  # archived and archived) hold every tab and label; pages of 100 are fetched in
  # parallel, and the labels at the same time. A change accepted while this ran is
  # replayed from the journal, so a sync can't put an old value back. Progress and
  # errors go to readeck-sync.json, which the app shows as its syncing line.
  [ $# -ge 3 ] || die "usage: $0 fetch|reload BASE TOKEN [PAGES]"
  pages="${4:-10}"
  case "$pages" in ''|*[!0-9]*) die "PAGES must be a number" ;; esac
  [ "$pages" -ge 1 ] || pages=1
  mkdir -p "$cache"
  # One fetch at a time: a second tap waits for the first rather than corrupting it.
  exec 8> "$cache/readeck-fetch.lock"
  flock 8
  base="$2" token="$3"
  start=$(date +%s)
  sync_state running "" 0
  work=$(mktemp -d "$cache/readeck-fetch.XXXXXX") || die "couldn't make a temporary folder"
  trap 'rm -rf "$work"; rm -f "$out.tmp" "$out.merge.tmp" "$journal.tmp"' EXIT
  : > "$work/fail"

  # get_page QUERY TAG PAGE: one page, in the background; a failed one is named.
  # A page past the end (404) is empty, not an error.
  get_page() {
    q="$1" tag="$2" page="$3"
    code=$(curl -sS --compressed --max-time 25 -H 'Accept: application/json' \
      -H "Authorization: Bearer $token" -w '%{http_code}' \
      "$base/api/bookmarks?$q&limit=100&offset=$(( (page - 1) * 100 ))&sort=-created" \
      -o "$work/$tag-$page.json" 2>/dev/null) || {
      echo "$q page $page" >> "$work/fail"; return 1; }
    case "$code" in
      2*) ;;
      404) printf '[]\n' > "$work/$tag-$page.json" ;;
      *) echo "$q page $page ($code)" >> "$work/fail"; return 1 ;;
    esac
    jq -r 'if type == "array" then length else 0 end' "$work/$tag-$page.json" \
      > "$work/$tag-$page.n" 2>/dev/null || echo 0 > "$work/$tag-$page.n"
  }

  # Page one of both lists, and the labels, together.
  get_page "is_archived=false" unarch 1 &
  p1=$!
  get_page "is_archived=true" arch 1 &
  p2=$!
  curl -sS --compressed --max-time 20 -H 'Accept: application/json' \
    -H "Authorization: Bearer $token" -o "$work/labels.json" \
    "$base/api/bookmarks/labels" 2>/dev/null &
  pl=$!
  wait "$p1" "$p2" "$pl" || true
  if [ -s "$work/fail" ]; then
    die "couldn't reach the server"
  fi
  # Keep the labels only when the answer is valid JSON; their counts are a nicety.
  if jq -e . "$work/labels.json" >/dev/null 2>&1; then
    cp "$work/labels.json" "$cache/readeck-labels.json" 2>/dev/null || true
  fi
  # What the server keeps beside labels, if anything: collections or saved filters,
  # as the official app organises bookmarks in collections too. Only the answer is
  # kept, for the app to read; a server without them leaves the old file alone.
  for ep in collections filters; do
    pcode=$(curl -sS --compressed --max-time 15 -H 'Accept: application/json' \
      -H "Authorization: Bearer $token" -w '%{http_code}' \
      -o "$work/probe-$ep.json" "$base/api/$ep" 2>/dev/null) || pcode=000
    if [ "$pcode" = 200 ] && jq -e . "$work/probe-$ep.json" >/dev/null 2>&1; then
      cp "$work/probe-$ep.json" "$cache/readeck-$ep.json" 2>/dev/null || true
    fi
  done

  # More pages only where page one was full, six requests at a time.
  for spec in "unarch:is_archived=false" "arch:is_archived=true"; do
    tag=${spec%%:*}; q=${spec#*:}
    n=$(cat "$work/$tag-1.n" 2>/dev/null || echo 0)
    [ "$n" -ge 100 ] || continue
    page=2
    while [ "$page" -le "$pages" ]; do
      # Six at a time, then wait for the batch: under proot `jobs -rp`/`wait -n`
      # can spin forever on unreaped children and stall the whole sync.
      n=0
      while [ "$n" -lt 6 ] && [ "$page" -le "$pages" ]; do
        get_page "$q" "$tag" "$page" &
        page=$((page + 1)); n=$((n + 1))
      done
      wait
    done
  done
  wait
  if [ -s "$work/fail" ]; then
    die "couldn't reach the server"
  fi

  # Every page as one list of bookmarks.
  jq -c 'if type == "array" then .[] else empty end' \
    "$work"/unarch-*.json "$work"/arch-*.json > "$work/raw.jsonl" 2>/dev/null \
    || die "couldn't read the server's answer"
  jq -c -s "$normalise" "$work/raw.jsonl" > "$out.tmp" 2>/dev/null \
    || die "couldn't merge the list"

  # Replay changes made since this fetch began, so its older answer can't undo them in
  # the app's copy.
  [ -f "$journal" ] || : > "$journal" 2>/dev/null || true
  # The journal snapshot and the replacement happen under the library's lock: a change
  # whose local copy is written before this replace is replayed, and one written after
  # it runs on the new list. Taking the snapshot earlier let a change that landed in
  # between be overwritten by the server's older answer.
  (
    flock 9
    ( flock 7; cp "$journal" "$work/ops.jsonl" 2>/dev/null || : > "$work/ops.jsonl" ) \
      7> "$journal.lock"
    jq -c -s --argjson since "$((start - 10))" --slurpfile log "$work/ops.jsonl" '
      . as $list
      | reduce (($log // [])[] | select((.at // 0) >= $since)) as $o
          ($list; map(if (.id | tostring) == ($o.id | tostring) then . * $o.p else . end))
      | .[]
    ' "$out.tmp" > "$out.merge.tmp" 2>/dev/null || exit 1
    mv "$out.merge.tmp" "$out"
  ) 9> "$out.lock" || die "couldn't merge the list"
  rm -f "$out.tmp"
  # Keep a short history of accepted changes; older ones are on both sides already.
  ( flock 7
    if [ -s "$journal" ]; then
      jq -c --argjson cut "$((start - 3600))" 'select((.at // 0) >= $cut)' "$journal" \
        > "$journal.tmp" 2>/dev/null && mv "$journal.tmp" "$journal"
    fi
  ) 7> "$journal.lock"
  n=$(wc -l < "$out" 2>/dev/null || echo 0)
  sync_state ok "" "$n"
  ;;
*)
  die "usage: $0 fetch|reload|import BASE TOKEN [PAGES] | read BASE TOKEN ID |
       import-file FILE | add BASE TOKEN URL | change BASE TOKEN ID JSON | delete BASE TOKEN ID |
       labels BASE TOKEN | labelrm BASE TOKEN NAME | status BASE TOKEN | find WORDS |
       bulk BASE TOKEN JSON IDSJSON | summary ID | pretty ID | ai-check"
  ;;
esac
READECK_LIB_END
fi
if ! grep -qF '# owl-readeck-read 1.3' "$bin/owl-readeck-read" 2>/dev/null; then
  cat > "$bin/owl-readeck-read" << 'READECK_READ_END'
#!/usr/bin/env python3
# owl-readeck-read 1.3: the reader side of the launcher's Readeck app (readeck.owl).
# Turns a Readeck article's HTML (its export's container/index.html, or the
# server's /article endpoint) into the light text the app draws: one element a
# line, "heading: ", "quote: " and "list: " marking what isn't a paragraph, so
# the app needs no HTML of its own.
#
#   owl-readeck-read HTMLFILE OUT    write OUT (JSON lines: {"k": kind, "t": text})
#   owl-readeck-read - OUT           read the HTML from stdin
#
# Kinds: h (heading), p (paragraph), q (quote), li (list item), pre (code), fig,
# img (an image's src, drawn by the reader; the helper localises it).
import json
import re
import sys
from html.parser import HTMLParser

# Elements that end the block being gathered.
BLOCK = {"p", "h1", "h2", "h3", "h4", "h5", "h6", "li", "blockquote", "pre",
         "figure", "figcaption", "dt", "dd", "summary", "tr", "div", "section",
         "article", "header", "footer", "ul", "ol", "dl", "table", "br", "hr"}
# Never show these, or their text.
SKIP = {"script", "style", "nav", "aside", "form", "iframe", "svg", "noscript",
        "button", "select", "textarea", "head", "meta", "link", "title"}


class Reader(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.blocks = []
        self.buf = []
        self.want = "p"     # the kind the text being gathered gets
        self.skip = 0       # inside an element we drop
        self.pre = 0        # inside <pre>

    def flush(self):
        text = "".join(self.buf)
        self.buf = []
        if self.pre:
            text = "\n".join(line.rstrip() for line in text.split("\n")).strip("\n")
        else:
            text = re.sub(r"[ \t\r\f\v]+", " ", text)
            text = re.sub(r" *\n *", " ", text)
            text = text.strip()
        if text:
            self.blocks.append({"k": self.want, "t": text})

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if self.skip:
            if tag in SKIP:
                self.skip += 1
            return
        if tag in SKIP:
            self.flush()
            self.skip = 1
            return
        if tag == "img":
            at = dict(attrs)
            self.flush()
            if at.get("src"):
                self.blocks.append({"k": "img", "t": at["src"]})
            if at.get("alt"):
                self.blocks.append({"k": "fig", "t": at["alt"]})
            return
        if tag in BLOCK:
            self.flush()
            if tag in ("h1", "h2", "h3", "h4", "h5", "h6"):
                self.want = "h"
            elif tag == "li":
                self.want = "li"
            elif tag == "blockquote":
                self.want = "q"
            elif tag in ("figcaption", "dt", "dd", "summary"):
                self.want = "fig"
            elif tag == "pre":
                self.want = "pre"
            elif tag in ("p", "td", "th"):
                self.want = "p"
        if tag == "pre":
            self.pre += 1

    def handle_startendtag(self, tag, attrs):
        if tag.lower() == "img":
            self.handle_starttag(tag, attrs)
            return
        if tag.lower() in BLOCK and not self.skip:
            self.flush()

    def handle_endtag(self, tag):
        tag = tag.lower()
        if self.skip:
            if tag in SKIP:
                self.skip -= 1
            return
        if tag in ("h1", "h2", "h3", "h4", "h5", "h6", "li", "blockquote",
                   "figcaption", "dt", "dd", "summary", "pre"):
            self.flush()
            if tag == "pre":
                self.pre = max(0, self.pre - 1)
            self.want = "p"
        elif tag in BLOCK:
            self.flush()

    def handle_data(self, data):
        if not self.skip:
            self.buf.append(data)

    def close(self):
        super().close()
        self.flush()


def main(argv):
    if len(argv) != 3:
        print("usage: owl-readeck-read HTMLFILE|'' OUT", file=sys.stderr)
        return 2
    src, out = argv[1], argv[2]
    try:
        if src in ("", "-"):
            html = sys.stdin.read()
        else:
            with open(src, encoding="utf-8", errors="replace") as f:
                html = f.read()
    except OSError as e:
        print(f"readeck: couldn't read {src}: {e}", file=sys.stderr)
        return 1

    # The article element when there is one, so a page's chrome is left out.
    m = re.search(r"<article\b.*?</article>", html, re.S | re.I)
    if m:
        html = m.group(0)

    reader = Reader()
    reader.feed(html)
    reader.close()
    with open(out, "w", encoding="utf-8") as f:
        for b in reader.blocks:
            f.write(json.dumps(b, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
READECK_READ_END
fi
chmod 755 "$bin/owl-readeck" "$bin/owl-readeck-read"
echo ready""") every 1h

  // Whether the helpers are in place, so nothing else runs until they are.
  source ready = cmd("""test -x "$HOME/.local/bin/owl-readeck" && test -x "$HOME/.local/bin/owl-readeck-read" && echo yes || echo no""") every 10s
  let helpers = trim(ready ?? "") == "yes"

  // Theme-adaptive surface & typography tokens.
  let cardBg = mix(background, foreground, 0.04)
  let surfaceBg = mix(background, foreground, 0.08)
  let subFg = mix(foreground, muted, 0.45)
  let bodyFg = mix(foreground, background, 0.08)
  let hairline = alpha(border, 0.45)
  let chipBg = alpha(accent, 0.13)
  let scrim = alpha(background, 0.12)

  // The server and an API token from its settings (made in its profile page). Either
  // "readeck.example.org" or "https://readeck.example.org" will do. The setup page
  // edits drafts, so typing an address or a token doesn't start a fetch per letter.
  state base = "" persist
  state token = "" persist
  state draftBase = ""
  state draftToken = ""
  // As the server is written: the scheme added when it's missing, a trailing / dropped.
  let raw = base == "" ? "" : (contains(base, "://") ? base : "https://" + base)
  let server = endsWith(raw, "/") ? sub(raw, 0, len(raw) - 1) : raw
  let draftRaw = draftBase == "" ? "" : (contains(draftBase, "://") ? trim(draftBase) : "https://" + trim(draftBase))
  let draftServer = endsWith(draftRaw, "/") ? sub(draftRaw, 0, len(draftRaw) - 1) : draftRaw
  // What's on show: a list tab ("unread", "favorite", "archived", "all"), the labels
  // screen, the bookmarks of one label (view "label" with `label` set), the server
  // setup, or one bookmark.
  state view = "unread" persist
  state label = "" persist
  state query = ""
  state typed = ""
  // A successful change's answer; shown until the next tap.
  state notice = ""
  state readId = ""
  state editing = false
  // Whether the article's text is on show, mutually exclusive with Article Info.
  state reading = false persist
  // Whether the reader shows the tidied text and the summary (both made by Claude Code,
  // which sends the text to Anthropic, once each), and whether those are being made now.
  state pretty = true persist
  state aiWant = ""
  state newUrl = ""
  // Changes are queued, one at a time, instead of one command being rewritten under
  // the last: a tap never cancels or loses the change before it. `override` shows a
  // change at once; `saving`, `okIds` and `failed` say what each bookmark is doing.
  // The queue and its statuses persist, so a reload or a closed app resumes the change
  // instead of leaving it stuck on "saving" or failing it with no answer.
  state wants = []
  state current = null persist
  state pending = [] persist
  state opSeq = 0 persist
  // Every queued op by its number, so an answer that lands after the queue has
  // moved on (a retry, a restarted command) still finds its op and its row.
  state sent = {} persist
  state override = {} persist
  state saving = {} persist
  state okIds = {} persist
  state failed = {} persist
  state retry = {} persist
  state lastOpAt = 0 persist
  // The row under a sideways swipe: its id and how far it moved (negative is left).
  state swipeId = ""
  state swipeX = 0
  // Bumped by connect, "sync now" and pull-to-refresh; the fetch below reads it, so
  // each tap runs the fetch at once instead of waiting for the minute to pass. A tap
  // during a fetch asks for one more instead of cancelling this one.
  state fetchN = 0 persist
  state syncAgain = false
  state syncAsk = 0
  // The script's own words when a change failed, so a tap that didn't work says why.
  state lastErr = ""
  // How the list is ordered and grouped: "-created" (newest), "created", "title",
  // "length" (longest read) or "shortest"; and "", "day", "site" or "label".
  state sort = "-created" persist
  state group = "" persist
  // The reader's text size, in points, and where you got to in each article (a map
  // from its id to a paragraph number), kept so an article opens where you left it.
  state textSize = 17 persist
  // [{id, i}] — how far into each article you got, so it opens where you left it.
  state where = [] persist
  // Whether taps pick bookmarks for a bulk change, and which are picked.
  state picking = false
  state picked = []
  // A "delete" waiting for a second tap, by id; a label's delete that needs one too.
  state confirmId = ""
  state confirmLabel = ""
  state connectMsg = ""
  // Copied or shared, to say so.
  state said = ""
  // Whether "test the token" is asking now, so the command runs once and says its answer.
  state connectCheck = false
  // The server's answer to the change last sent from the phone: {code, ok, out, err}.
  state opResult = null
  // Whether the "save a link" bar is open: it stays out of the way until asked for.
  state showAdd = false
  // The reader's typography, as the official app's: a font and a spacing, kept per phone.
  state readFont = "serif" persist
  state readGap = 1 persist
  // Paragraphs kept highlighted in the reader, by article id: the official app's
  // highlights, kept on this phone since the server's API has no word for them.
  state hl = {} persist
  // Non-persisted v2.4 UI & navigation states.
  state showSearch = false
  state showMenu = false
  state showTypo = false
  state fromReader = false
  state labelMenu = ""
  state importPath = ""
  state draftTitle = ""
  state draftLabels = ""
  state draftNote = ""

  // The library the helper writes: one bookmark per line.
  source lib = file("~/.cache/omalauncher/readeck.jsonl")
  // For "3d" beside a date.
  source now = clock every 1m

  // The fetch's own status: running, the last success and its item count, or why it
  // failed. The app reads it instead of guessing from a command's output, so an
  // automatic sync says it is syncing too, and a killed one doesn't stay "syncing".
  source syncFile = file("~/.cache/omalauncher/readeck-sync.json") json
  let syncState = syncFile ?? {}
  let syncing = syncState.state == "running" && now - (syncState.at ?? 0) < 300
  let syncStalled = syncState.state == "running" && !syncing
  let syncFailed = syncState.state == "failed"
  let syncMsg = syncState.state == "failed" ? (syncState.msg ?? "couldn't reach the server") : syncStalled ? "sync timed out" : ""
  let lastSync = syncState.lastOk ?? 0

  // Fetches the server's list whenever `fetchN` goes up (owl runs a command again as soon
  // as what it reads changes), so "sync now", pull-to-refresh and connect act at once
  // instead of on the next minute. The helper does the pages in parallel and writes
  // readeck-sync.json, which says when it began and how it ended.
  source fetched = cmd(!helpers || server == "" || token == "" ? "echo waiting ${sh(fetchN)}" : "owl-readeck fetch ${sh(server)} ${sh(token)} 10 >/dev/null 2>&1 && echo done ${sh(fetchN)} || echo failed ${sh(fetchN)}") every 15m timeout 240s
  // One change at a time: `current` is sent, `pending` waits behind it. The command
  // depends on `current` alone, so a second tap can't rewrite or cancel the first; its
  // answer carries the op's own number, so identical answers still count.
  // The changes that need the Linux side: bulk (many requests at once), import
  // (a file on disk), and every change while offline (the imported library is
  // edited on disk alone). The single changes with a server go from the phone,
  // in the trigger below, so nothing here can come between a tap and the server.
  source ran = cmd(
    !helpers || current == null || (server != "" && token != "" && (current.mode == "change" || current.mode == "add")) ? "echo idle"
    : current.mode == "change" ? "owl-readeck change ${sh(server)} ${sh(token)} ${sh(current.id)} ${sh(current.json)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@; cat \"$HOME/.cache/omalauncher/readeck-op-failed.txt\" 2>/dev/null"
    : current.mode == "bulk" ? "owl-readeck bulk ${sh(server)} ${sh(token)} ${sh(current.json)} ${sh(toJson(current.ids ?? []))} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@; cat \"$HOME/.cache/omalauncher/readeck-op-failed.txt\" 2>/dev/null"
    : current.mode == "add" ? "owl-readeck add ${sh(server)} ${sh(token)} ${sh(current.id)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@"
    : current.mode == "labelrm" ? "owl-readeck labelrm ${sh(server)} ${sh(token)} ${sh(current.id)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@"
    : current.mode == "import" ? "owl-readeck import-file ${sh(current.id)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@"
    : "echo ${int(current.n)} 1; echo @@IDS@@") every 12h timeout 900s
  // "test the token" on the setup page: the script asks the server what it makes of it.
  // It uses the drafts, so the test doesn't start a fetch with half-typed values.
  source checked = cmd(!helpers || !connectCheck ? "echo" : "set -o pipefail; owl-readeck status ${sh(draftServer)} ${sh(draftToken)} 2>/dev/null | sed -e 's/^ok .*/ok/' -e 's/^error /error: /' || echo \"error: couldn't reach the server\"") every 1m
  on checked first {
    if value != "" && value != "checking…" {
      connectMsg = value == "ok" ? "the token works" : sub(value, 0, 70)
      connectCheck = false
    }
  }

  // A sync's end: with no change left in the queue, the fetched list is the truth, so
  // the optimistic overlay and "saved" ticks can go. A tap during the fetch asks for
  // one more run instead of cancelling it.
  on syncFile first {
    if value != null {
      let st = value.state ?? ""
      // A change that landed during this fetch may be newer than its answer, so its
      // overlay stays until a quiet sync (no change in the last half-minute) proves it.
      if st == "ok" && current == null && len(pending) == 0 && now - lastOpAt > 300 {
        override = {}
        okIds = {}
        saving = {}
      }
      if (st == "ok" || st == "failed") && syncAgain {
        syncAgain = false
        fetchN = fetchN + 1
      }
    }
  }
  // Every "sync now", pull and connect is one ask; while a fetch runs it becomes a
  // follow-up, never a second process over the same file.
  on syncAsk first {
    if value > 0 {
      if syncing { syncAgain = true } else { fetchN = fetchN + 1 }
    }
  }

  // `wants` is a list of changes as JSON: a tap appends one, and this queues the
  // first. A list, not one value, so two taps in a row can't overwrite each other.
  on wants first {
    if len(wants) > 0 {
      let want = first(wants) ?? ""
      let o = parseJson(want)
      if o != null && o.mode != null && (o.mode != "bulk" || len(o.ids ?? []) > 0) {
        opSeq = opSeq + 1
        let ids = o.mode == "bulk" ? (o.ids ?? []) : o.mode == "change" && o.id != null ? [o.id] : []
        saving = reduce(ids, (acc, id) => set(acc, id, get(acc, id, 0) + 1), saving)
        okIds = reduce(ids, (acc, id) => remove(acc, id), okIds)
        failed = reduce(ids, (acc, id) => remove(acc, id), failed)
        retry = reduce(ids, (acc, id) => remove(acc, id), retry)
        if o.patch != null {
          override = reduce(ids, (acc, id) => set(acc, id, merge(get(acc, id, {}), o.patch)), override)
        }
        let op = merge(o, {n: opSeq})
        sent = set(sent, "${opSeq}", op)
        if current == null { current = op } else { pending = pending + [op] }
        if o.mode == "bulk" { picked = []; picking = false }
        notice = ""
        lastErr = ""
      }
      wants = drop(wants, 1)
    }
  }

  // A change's end: a success marks the bookmark saved; a refusal says the server's
  // own words, puts the old value back, and offers a retry. Bulk failures name only
  // the ids the server refused, so the rest stay changed.
  on ran first {
    let out = trim(value ?? "")
    if out != "" && out != "idle" {
      // The command prints "number exit-code", the server's first error line, then
      // "@@IDS@@" and the ids it refused: all in one value, so the handler never
      // reads a file the helper may not have finished writing.
      let parts = split(out, "@@IDS@@")
      let head = trim(parts[0] ?? "")
      let tail = len(parts) > 1 ? parts[1] : ""
      let w = words(head)
      let n = num(w[0] ?? "0")
      let code = w[1] ?? ""
      let op = current != null && n == current.n ? current : get(sent, "${n}", null)
      if op != null {
        sent = remove(sent, "${n}")
        let ids = op.mode == "bulk" ? (op.ids ?? []) : op.mode == "change" ? [op.id] : []
        if code == "0" {
          saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
          okIds = reduce(ids, (acc, id) => set(acc, id, true), okIds)
          failed = reduce(ids, (acc, id) => remove(acc, id), failed)
          retry = reduce(ids, (acc, id) => remove(acc, id), retry)
          notice = op.mode == "bulk" ? "changed" : op.mode == "import" ? "imported" : op.mode == "add" ? "link saved" : op.mode == "labelrm" ? "label deleted" : "saved"
          lastErr = ""
          lastOpAt = now
          if op.mode == "import" {
            // An import is the whole library: no old optimistic value may hide it.
            override = {}
            okIds = {}
            saving = {}
            failed = {}
            retry = {}
          }
          if op.mode == "add" || op.mode == "labelrm" {
            if syncing { syncAgain = true } else { fetchN = fetchN + 1 }
          }
        } else {
          // Everything after the number and the exit code is the server's answer;
          // the ids, if any, come after @@IDS@@.
          let rawMsg = trim(join(drop(lines(head), 1), " "))
          if rawMsg == "" && (op.mode == "change" || op.mode == "bulk") && (op.tries ?? 0) < 2 {
            // No words from the script means it was killed or timed out, not refused:
            // whether the server took the change is unknown, so queue it again (the
            // same PATCH twice is harmless, and the journal replays it either way)
            // and keep showing "saving", instead of calling it failed and putting
            // the old value back over a change the server may well have kept.
            saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
            wants = wants + [toJson(merge(op, {tries: (op.tries ?? 0) + 1}))]
            if current != null && n == current.n {
              current = len(pending) > 0 ? first(pending) : null
              pending = drop(pending, 1)
            }
          } else {
            let msg = rawMsg == "" ? "interrupted; tap retry" : replace(rawMsg, "readeck: ", "")
            let bad = lines(tail).filter(l => l != "" && l != "@@IDS@@")
            let badIds = len(bad) > 0 ? bad : ids
            saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
            okIds = reduce(badIds, (acc, id) => remove(acc, id), okIds)
            failed = reduce(badIds, (acc, id) => set(acc, id, msg), failed)
            override = reduce(badIds, (acc, id) => remove(acc, id), override)
            retry = reduce(badIds, (acc, id) => op.mode == "bulk" || op.mode == "change" ? set(acc, id, {mode: "change", id: id, json: op.json, patch: op.patch}) : remove(acc, id), retry)
            lastErr = msg
            notice = ""
            if op.mode == "import" {
              // It may have replaced the library before failing on a picture.
              override = {}
              okIds = {}
              saving = {}
              failed = {}
              retry = {}
            }
          }
        }
        if current != null && n == current.n {
          current = len(pending) > 0 ? first(pending) : null
          pending = drop(pending, 1)
        }
      }
    }
  }

  // A single change with a server goes out from the phone itself, so no process on
  // the Linux side can die between the tap and the server: the queue's `current`
  // says what to send, and the answer lands in `opResult`.
  on current first {
    if current != null && !offline {
      if current.mode == "change" {
        opResult = post(server + "/api/bookmarks/" + enc(current.id), parseJson(current.json), {Authorization: "Bearer ${token}"}, method: "PATCH")
      } else if current.mode == "add" {
        opResult = post(server + "/api/bookmarks", {url: current.id}, {Authorization: "Bearer ${token}"}, method: "POST")
      }
    }
  }
  // The server's answer: the row's tick or its reason, then the queue moves on.
  // The optimistic value stays until a quiet sync proves it, as before.
  on opResult first {
    if opResult != null && current != null {
      let op = current
      sent = remove(sent, "${op.n}")
      let ids = op.mode == "change" ? [op.id] : []
      if opResult.ok {
        saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
        okIds = reduce(ids, (acc, id) => set(acc, id, true), okIds)
        failed = reduce(ids, (acc, id) => remove(acc, id), failed)
        retry = reduce(ids, (acc, id) => remove(acc, id), retry)
        notice = op.mode == "add" ? "link saved" : op.mode == "labelrm" ? "label deleted" : "saved"
        lastErr = ""
        lastOpAt = now
        if op.mode == "add" || op.mode == "labelrm" {
          if syncing { syncAgain = true } else { fetchN = fetchN + 1 }
        }
      } else {
        let msg = opResult.code == -1 ? "no answer from the server; tap retry" : opResult.code == 401 || opResult.code == 403 ? "the token isn't accepted (${opResult.code})" : opResult.out != null && opResult.out.message != null ? opResult.out.message : opResult.err != null && opResult.err != "" ? opResult.err : "the server answered ${opResult.code}"
        saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
        okIds = reduce(ids, (acc, id) => remove(acc, id), okIds)
        failed = reduce(ids, (acc, id) => set(acc, id, msg), failed)
        override = reduce(ids, (acc, id) => remove(acc, id), override)
        retry = reduce(ids, (acc, id) => op.mode == "change" ? set(acc, id, {mode: "change", id: id, json: op.json, patch: op.patch}) : remove(acc, id), retry)
        lastErr = msg
        notice = ""
      }
      current = len(pending) > 0 ? first(pending) : null
      pending = drop(pending, 1)
      opResult = null
    }
  }

  // The article's text, as the reader draws it (owl-readeck-read, through the script):
  // one element a line, {k, t}. Opening an article fetches it once (from the server, or
  // from an imported export) and keeps it on disk, so it reads offline afterwards.
  source article = file("~/.cache/omalauncher/readeck-read/${readId}.jsonl")
  let plain = lines(article).map(l => parseJson(l)).filter(p => p != null)

  // Claude Code, when it's installed, for a summary and for tidying the text. It is not
  // local: it sends the article's text to Anthropic, on the user's Claude account, and
  // only when a button asks. Both are made once per article and kept, and neither is
  // needed to read.
  source aiCheck = cmd(!helpers ? "echo no" : "owl-readeck ai-check 2>/dev/null || echo no") every 15m
  let aiOk = startsWith(aiCheck ?? "", "ok")
  // The harness's name, for the buttons: Claude Code, which sends the text to Anthropic.
  let aiName = "Claude Code"
  // What the harness made of this article: a summary, and the tidied text.
  source madeSummary = file("~/.cache/omalauncher/readeck-ai/${readId}.summary")
  source madePretty = file("~/.cache/omalauncher/readeck-ai/${readId}.pretty")
  let summary = trim(madeSummary ?? "")
  let prettied = lines(madePretty).map(l => parseJson(l)).filter(p => p != null)
  let para = pretty && len(prettied) > 0 ? prettied : plain
  // The reader is paged: `where` keeps the paragraph each article was left at, and a
  // page is `pageLen` of them. A long piece opens where it was left, and the pager
  // moves a page at a time instead of leaving the whole article to scroll from the top.
  let pageLen = 12
  let atNow = find(where, w => w.id == readId) ?? {id: readId, i: 0}
  let pageStart = clamp(pageLen * floor(atNow.i / pageLen), 0, max(0, len(para) - 1))
  let pageCount = max(1, ceil(len(para) / pageLen))
  let pageNo = floor(pageStart / pageLen) + 1
  // The detail column is keyed by this: a new page, a new article or switching to or
  // from reading builds it again, which starts its scroll at the top of the reader.
  let viewKey = readId + ":" + (reading ? "read:" : "details:") + "${pageNo}"
  let shown = drop(para, pageStart).take(pageLen)
  let readPct = len(para) == 0 ? 0 : (pageStart + len(shown)) / len(para) * 100
  let needle = lower(trim(query))
  // What's typed but not sent yet: the list narrows on titles, sites and labels as you
  // type (no command runs), and only Enter looks through the articles' own text.
  let typedNeedle = lower(trim(typed))
  // The articles whose own text holds the search's words: the script looks through the
  // text it saved (no shell tools beyond grep), and says which ids match.
  source textHits = cmd(!helpers || needle == "" ? "echo" : "owl-readeck find ${sh(needle)}") every 1m
  let hits = lines(textHits).filter(l => l != "")

  // The AI work runs when a button asks for it ("summary ID", "pretty ID"), not on its
  // own: a shell command that only becomes real once the article's text is there.
  // Two values, each its own shell word: "summary" or "pretty", and the article's id.
  let aiMode = first(split(aiWant, " "))
  let aiId = last(split(aiWant, " "))
  source aiRan = cmd(!helpers || trim(aiWant ?? "") == "" ? "echo idle" : "owl-readeck ${sh(aiMode)} ${sh(aiId)} >/dev/null 2>&1 && echo ok || echo failed") every 1m timeout 300s
  // A run cut off by its timeout comes back empty: dropped too, so it isn't sent again every minute.
  on aiRan {
    if value == "ok" || value == "failed" || value == "" { aiWant = "" }
  }

  // Off the server, or from the export (importing one writes its articles' text too).
  source got = cmd(!helpers || readId == "" ? "echo idle" : "owl-readeck read ${sh(server)} ${sh(token)} ${sh(readId)} >/dev/null 2>&1; echo done") every 5m timeout 60s

  // Each bookmark as one text line, so a broken one can't hide the rest: id, title, url,
  // site, favorite, archived, progress (null without it in the export), labels, and what
  // its page shows: description, authors, language, length, date, pictures.
  let parsed = lines(lib).map(l => parseJson(l)).filter(b => b != null && b.id != null)
  let all = parsed.map(b => merge(b, get(override, "${b.id}", {}))).filter(b => b.is_deleted != true).map(b => {id: "${b.id}", title: b.title ?? "", url: b.url ?? "", site: b.site_name ?? "", fav: b.is_marked == true, arch: b.is_archived == true, prog: b.read_progress, labels: join(b.labels ?? [], ", "), note: b.note ?? "", desc: b.description ?? "", authors: join(b.authors ?? [], ", "), lang: b.lang ?? "", mins: b.reading_time, words: b.word_count, when: b.published ?? b.created, added: b.created, icon: b.site_icon ?? "", thumb: b.thumbnail ?? b.image ?? "", dtype: b.document_type ?? ""})

  let item = all.find(b => b.id == readId) ?? {}
  // The label picked (every bookmark with it, archived or not), else the tab's bookmarks;
  // then the words searched for, in the page's facts and in the articles' own text.
  let tabbed = label != "" ? all.filter(b => contains(lower(", " + b.labels + ","), ", " + lower(label) + ","))
    : all.filter(b => view == "favorite" ? b.fav : view == "archived" ? b.arch : view == "unread" ? b.prog != 100 && !b.arch : !b.arch)
  let filtered = tabbed.filter(b =>
    (typedNeedle == "" || contains(lower(b.title + " " + b.site + " " + b.labels + " " + b.url + " " + b.desc + " " + b.authors), typedNeedle)) &&
    (needle == "" || contains(lower(b.title + " " + b.site + " " + b.labels + " " + b.url + " " + b.desc + " " + b.authors), needle) || hits.any(id => id == b.id)))
  let sorted = sort == "title" ? filtered.sortBy(b => lower(b.title))
    : sort == "length" ? filtered.sortBy(b => -(b.mins ?? -1))
    : sort == "shortest" ? filtered.sortBy(b => b.mins ?? 999999)
    : sort == "created" ? filtered.sortBy(b => parseTime(b.added ?? b.when) ?? 9999999999)
    : filtered.sortBy(b => -(parseTime(b.when ?? b.added) ?? 0))
  // Pre-sort by group key when grouped so headers never fragment across non-adjacent rows.
  let seen = group == "site" ? sorted.sortBy(b => b.site == "" ? "\uffff" : lower(b.site))
    : group == "label" ? sorted.sortBy(b => b.labels == "" ? "\uffff" : lower(first(split(b.labels, ", ")) ?? ""))
    : group == "day" ? sorted.sortBy(b => sort == "created" ? (num(fmtTime(parseTime(b.when ?? b.added), "yyyyMMdd")) ?? 99999999) : -(num(fmtTime(parseTime(b.when ?? b.added), "yyyyMMdd")) ?? 0))
    : sorted
  // The rows to draw: a header when grouped, then the items under it.
  let rows = seen.map(b => {h: group == "day" ? (fmtTime(parseTime(b.when ?? b.added), "d MMM yyyy") ?? "Undated")
    : group == "site" ? (b.site == "" ? "No Site" : b.site)
    : group == "label" ? (b.labels == "" ? "No Label" : first(split(b.labels, ", ")) ?? "No Label")
    : "", b: b})
  let counted = {unread: all.count(b => b.prog != 100 && !b.arch), favorite: all.count(b => b.fav), archived: all.count(b => b.arch), all: all.count(b => !b.arch)}
  // How long the queue is to read, in minutes, said as "2h 5m" or "39m".
  let queue = all.filter(b => b.prog != 100 && !b.arch).map(b => b.mins ?? 0)
  let queueMin = sum(queue)
  let queueText = queueMin >= 60 ? "${floor(queueMin / 60)}h ${round(queueMin % 60)}m" : "${round(queueMin)}m"
  // Every label: the bookmarks' own, and the server's list (so unused ones show too).
  source serverLabels = file("~/.cache/omalauncher/readeck-labels.json")
  let labelNames = unique((flatten(all.map(b => split(b.labels, ", "))) + (parseJson(serverLabels) ?? []).map(l => l.name ?? "")).filter(l => l != "")).sortBy(l => lower(l))
  let labels = labelNames.map(l => {name: l, count: all.count(b => contains(lower(", " + b.labels + ","), ", " + lower(l) + ","))})
  let offline = server == "" || token == ""
  let showStatus = notice != "" || lastErr != "" || syncMsg != "" || syncing || syncStalled || (current != null && current.mode == "add")

  component NavTab(name, title, icon, activeIcon, badge = 0) {
    let active = name == "labels" ? (view == "labels" || label != "") : (view == name && label == "")
    Column {
      weight: 1
      gap: 4
      padding: [4, 6]
      align: center
      onTap: {
        view = name
        label = ""
        typed = ""
        query = ""
        notice = ""
        showSearch = false
        showAdd = false
        showMenu = false
        labelMenu = ""
        confirmLabel = ""
        picking = false
        picked = []
        haptic()
      }
      Box {
        width: 58
        height: 28
        radius: 14
        align: center
        background: active ? chipBg : null
        Image { src: active ? activeIcon : icon; size: 22; tint: active ? accent : subFg }
        if badge > 0 {
          Box {
            align: topEnd
            fill: true
            Box {
              padding: [5, 1]
              radius: 999
              background: accent
              border: 1
              borderColor: background
              Text { text: badge > 999 ? "${floor(badge / 1000)}k" : "${badge}"; font: sans; fontSize: 9; fontWeight: 700; color: background; maxLines: 1 }
            }
          }
        }
      }
      Text { text: title; font: sans; fontSize: 11; fontWeight: active ? 700 : 400; letterSpacing: 0.1; align: center; maxLines: 1; color: active ? foreground : subFg }
    }
  }

  // A change the server refused: one tap queues the same change again, now that the
  // old value is back on show.
  component Retry(id) {
    Text {
      text: "Retry"
      font: sans
      fontSize: 11.5
      fontWeight: 600
      color: red
      padding: [4, 2]
      maxLines: 1
      onTap: {
        let op = get(retry, id, null)
        if op != null {
          wants = wants + [toJson(op)]
          haptic()
        }
      }
    }
  }

  component ActionTile(title, icon, active = false, tintCol = null) {
    let fg = tintCol != null ? tintCol : active ? accent : foreground
    let bg = tintCol != null && active ? alpha(tintCol, 0.13) : active ? chipBg : cardBg
    let bd = tintCol != null && active ? alpha(tintCol, 0.38) : active ? alpha(accent, 0.38) : border
    Column {
      fill: width
      align: center
      gap: 5
      padding: [4, 9]
      radius: 10 * corners
      background: bg
      border: 1
      borderColor: bd
      Image { src: icon; size: 19; tint: fg }
      Text { text: title; font: sans; fontSize: 11.5; fontWeight: active ? 600 : 500; color: fg; maxLines: 1; align: center }
    }
  }

  component UtilPill(title, icon, danger = false) {
    Row {
      fill: width
      height: 34
      align: center
      justify: center
      gap: 5
      padding: [6, 0]
      radius: 8 * corners
      background: danger ? alpha(red, 0.10) : cardBg
      border: 1
      borderColor: danger ? alpha(red, 0.36) : border
      Image { src: icon; size: 14; tint: danger ? red : subFg }
      Text { text: title; font: sans; fontSize: 11.5; fontWeight: danger ? 600 : 500; color: danger ? red : foreground; maxLines: 1 }
    }
  }

  component SegOpt(title, active, previewFont = "") {
    Row {
      fill: width
      align: center
      justify: center
      gap: 5
      padding: [8, 7]
      radius: 6 * corners
      background: active ? chipBg : null
      border: active ? 1 : 0
      borderColor: alpha(accent, 0.4)
      if previewFont != "" {
        Text { text: "Aa"; font: previewFont; fontSize: 14; fontWeight: 700; color: active ? foreground : subFg; maxLines: 1 }
      }
      Text { text: title; font: sans; fontSize: 12.5; fontWeight: active ? 600 : 500; color: active ? foreground : subFg; maxLines: 1 }
    }
  }

  // An entry in the list: the story's picture or the site's icon (never both, so a
  // long list stays under the image limit), its title, the site, authors and up to 3
  // label pills, reading time and age, progress bar, and swipe-left/right reveal.
  component Entry(b) {
    let lbls = split(b.labels, ", ").filter(l => l != "").take(3)
    let isPicked = picked.any(id => id == b.id)
    Box {
      fill: width
      radius: 10 * corners
      clip: true
      border: 1
      borderColor: swipeId == b.id && swipeX < 0 ? alpha(red, 0.35) : swipeId == b.id && swipeX > 0 ? alpha(accent, 0.35) : hairline
      background: swipeId == b.id && swipeX > 0
        ? linear(0, 0, 1, 0, range(31).map(i => i / 30 <= 0.28 ? mix(background, accent, 0.14 + 0.26 * min(1, abs(swipeX) / 88)) : cardBg))
        : swipeId == b.id && swipeX < 0
        ? linear(0, 0, 1, 0, range(31).map(i => i / 30 >= 0.72 ? mix(background, red, 0.14 + 0.26 * min(1, abs(swipeX) / 88)) : cardBg))
        : cardBg
      Row {
        fill: width
        align: center
        Column {
          width: 96
          height: 64
          align: center
          justify: center
          gap: 4
          offset: [swipeId == b.id && swipeX > 0 ? swipeX - 96 : -96, 0]
          animate offset: spring(0.85, 500)
          onTap: {
            wants = wants + [toJson({mode: "change", id: b.id, json: b.prog == 100 ? "{\"read_progress\":0}" : "{\"read_progress\":100}", patch: {read_progress: b.prog == 100 ? 0 : 100}})]
            swipeId = ""
            swipeX = 0
            haptic()
          }
          Image { src: icRead; size: 18; tint: foreground }
          Text { text: b.prog == 100 ? "Unread" : "Read"; font: sans; fontSize: 12; fontWeight: 700; color: foreground; maxLines: 1; align: center }
        }
        Spacer { weight: 1 }
        Column {
          width: 96
          height: 64
          align: center
          justify: center
          gap: 4
          offset: [swipeId == b.id && swipeX < 0 ? swipeX + 96 : 96, 0]
          animate offset: spring(0.85, 500)
          onTap: {
            wants = wants + [toJson({mode: "change", id: b.id, json: b.arch ? "{\"is_archived\":false}" : "{\"is_archived\":true}", patch: {is_archived: !b.arch}})]
            swipeId = ""
            swipeX = 0
            haptic()
          }
          Image { src: icArchive; size: 18; tint: foreground }
          Text { text: b.arch ? "Restore" : "Archive"; font: sans; fontSize: 12; fontWeight: 700; color: foreground; maxLines: 1; align: center }
        }
      }
      Row {
        let st = get(saving, b.id, 0) > 0 ? "saving" : get(failed, b.id, "") != "" ? "failed" : get(okIds, b.id, false) ? "saved" : ""
        fill: width
        gap: 12
        align: top
        padding: [12, 10]
        radius: 10 * corners
        background: isPicked ? mix(background, accent, 0.14) : cardBg
        offset: [swipeId == b.id ? swipeX : 0, 0]
        animate offset: spring(0.85, 500)
        drag: horizontal
        onDrag: {
          if !picking {
            if swipeId != b.id {
              swipeId = b.id
              swipeX = 0
            }
            let was = abs(swipeX)
            swipeX = clamp(swipeX + dx, -96, 96)
            if was < 88 && abs(swipeX) >= 88 { haptic() }
          }
        }
        onDragEnd: {
          if swipeId == b.id {
            let archive = swipeX <= -88 || (vx < -500 && swipeX < -24)
            let mark = swipeX >= 88 || (vx > 500 && swipeX > 24)
            if archive {
              wants = wants + [toJson({mode: "change", id: b.id, json: b.arch ? "{\"is_archived\":false}" : "{\"is_archived\":true}", patch: {is_archived: !b.arch}})]
              swipeId = ""
              swipeX = 0
              haptic()
            } else if mark {
              wants = wants + [toJson({mode: "change", id: b.id, json: b.prog == 100 ? "{\"read_progress\":0}" : "{\"read_progress\":100}", patch: {read_progress: b.prog == 100 ? 0 : 100}})]
              swipeId = ""
              swipeX = 0
              haptic()
            } else if swipeX < -24 {
              swipeX = -96
            } else if swipeX > 24 {
              swipeX = 96
            } else {
              swipeId = ""
              swipeX = 0
            }
          }
        }
        onLongPress: {
          picking = true
          picked = isPicked ? picked.filter(id => id != b.id) : picked + [b.id]
          haptic()
        }
        onTap: {
          if swipeId == b.id && swipeX != 0 {
            swipeId = ""
            swipeX = 0
          } else if picking {
            picked = isPicked ? picked.filter(id => id != b.id) : picked + [b.id]
          } else {
            notice = ""
            lastErr = ""
            said = ""
            readId = b.id
            editing = false
            confirmId = ""
            showTypo = false
            fromReader = false
            reading = true
            swipeId = ""
            swipeX = 0
            haptic()
          }
        }
        if picking {
          Box {
            width: 20
            height: 20
            radius: 5 * corners
            align: center
            border: 1.5
            borderColor: isPicked ? accent : border
            background: isPicked ? accent : null
            if isPicked {
              Text { text: "✓"; font: sans; fontSize: 12; fontWeight: 700; color: background; maxLines: 1 }
            }
          }
        }
        Column {
          weight: 1
          gap: 5
          Text { text: b.title; font: sans; fontSize: 15.5; fontWeight: b.prog == 100 ? 400 : 600; color: b.prog == 100 ? subFg : foreground; maxLines: 3 }
          Row {
            gap: 5
            align: center
            if b.icon != "" && b.thumb == "" {
              Box { width: 14; height: 14; radius: 3 * corners; clip: true; Image { src: b.icon; fill: true; fit: contain } }
            }
            if b.dtype == "video" {
              Text { text: "▶"; font: sans; fontSize: 11; color: accent; maxLines: 1 }
            } else if b.dtype == "image" {
              Text { text: "▣"; font: sans; fontSize: 11; color: accent; maxLines: 1 }
            }
            Text { text: b.site; font: sans; fontSize: 12; fontWeight: 600; color: subFg; maxLines: 1; weight: 1 }
            if b.note != "" {
              Text { text: "✎"; font: sans; fontSize: 11.5; color: subFg; maxLines: 1 }
            }
            if b.mins != null || b.when != null {
              Text {
                text: "${b.mins != null ? "${b.mins}m" : ""}${b.mins != null && b.when != null ? " · " : ""}${b.when != null ? fmtAgo(parseTime(b.when), now) : ""}"
                font: sans
                fontSize: 12
                color: subFg
                maxLines: 1
              }
            }
            if b.fav {
              Text { text: "★"; font: sans; fontSize: 12; color: orange; maxLines: 1 }
            }
          }
          if (b.authors != "" && b.authors != b.site) || len(lbls) > 0 {
            Flow {
              gap: 5
              fill: width
              if b.authors != "" && b.authors != b.site {
                Text { text: "by ${b.authors}"; font: sans; fontSize: 12; color: subFg; maxLines: 1 }
              }
              for l in lbls key l {
                Text { text: l; font: sans; fontSize: 11; fontWeight: 600; letterSpacing: 0.1; color: accent; background: chipBg; padding: [6, 2]; radius: 4 * corners; maxLines: 1 }
              }
            }
          }
          if b.prog > 0 && b.prog < 100 {
            Row {
              gap: 8
              align: center
              fill: width
              Progress { value: b.prog; weight: 1; height: 2; color: accent; track: hairline; radius: 1 }
              Text { text: "${int(b.prog)}%"; font: sans; fontSize: 10.5; fontWeight: 600; color: accent; maxLines: 1 }
            }
          }
          if st == "saving" {
            Text { text: "saving…"; font: sans; fontSize: 11.5; color: accent; maxLines: 1 }
          } else if st == "failed" {
            Row {
              gap: 6
              align: center
              Text { text: get(failed, b.id, "couldn't save"); font: sans; fontSize: 11.5; color: red; maxLines: 3; weight: 1 }
              Retry { id: b.id }
            }
          } else if st == "saved" {
            Text { text: "✓ saved"; font: sans; fontSize: 11.5; color: green; maxLines: 1 }
          }
        }
        if b.thumb != "" {
          Box {
            width: 72
            height: 56
            radius: 8 * corners
            clip: true
            background: surfaceBg
            border: 1
            borderColor: hairline
            Image { src: b.thumb; fill: true; fit: cover }
            Box { fill: true; background: scrim }
          }
        }
      }
    }
  }

  component List(rows, loading) {
    Column {
      lazy: true
      weight: 1
      gap: 6
      padding: [12, 8, 12, 10]
      onPull: {
        notice = ""
        lastErr = ""
        syncAsk = syncAsk + 1
        haptic()
      }
      if loading {
        Column {
          gap: 10
          padding: [16, 14]
          radius: 10 * corners
          background: cardBg
          border: 1
          borderColor: hairline
          Text { text: offline ? "Nothing to read yet." : "Fetching your bookmarks…"; font: sans; fontSize: 16; fontWeight: 600; color: foreground }
          if offline {
            Text { text: "Point the app at your Readeck server, and its API token, to fetch your library. Or import an export of it, to read offline."; font: sans; fontSize: 13; color: subFg }
            Box {
              padding: [14, 9]
              radius: 8 * corners
              background: accent
              onTap: { draftBase = base; draftToken = token; view = "setup"; haptic() }
              Text { text: "Connect Server"; font: sans; fontSize: 13; fontWeight: 700; color: background; maxLines: 1 }
            }
          } else {
            Text { text: "The app's library is empty. Fetch the list, or import an export of yours."; font: sans; fontSize: 13; color: subFg }
            Box {
              padding: [14, 9]
              radius: 8 * corners
              background: surfaceBg
              border: 1
              borderColor: border
              onTap: { notice = ""; syncAsk = syncAsk + 1; haptic() }
              Text { text: "Fetch Now"; font: sans; fontSize: 13; fontWeight: 600; color: foreground; maxLines: 1 }
            }
          }
          Text { text: "Import an export (.zip, data.json or .jsonl)"; font: sans; fontSize: 12; fontWeight: 600; color: subFg }
          Input {
            placeholder: "/path/to/data.json or .zip"
            clear: true
            fill: width
            onSubmit: {
              let f = trim(value)
              if f != "" {
                notice = ""
                wants = wants + [toJson({mode: "import", id: f})]
                haptic()
              }
            }
          }
          if current != null && current.mode == "import" {
            Text { text: "importing…"; font: sans; fontSize: 12; color: accent }
          }
        }
      }
      if !loading && len(rows) == 0 {
        Column {
          gap: 8
          padding: [16, 18]
          Text { text: typed != "" || query != "" ? "Nothing found for “${trim(typed != "" ? typed : query)}”" : label != "" ? "Nothing under this label" : "Nothing here"; font: sans; fontSize: 14; color: subFg }
          if typed != "" || query != "" {
            Text { text: "Press Enter to search inside saved article text too."; font: sans; fontSize: 12; color: muted; visible: query == "" }
            Box {
              padding: [12, 7]
              radius: 8 * corners
              background: chipBg
              onTap: { typed = ""; query = ""; haptic() }
              Text { text: "Clear Search"; font: sans; fontSize: 12.5; fontWeight: 600; color: accent; maxLines: 1 }
            }
          }
        }
      }
      for r, i in rows key r.b.id {
        if r.h != "" && (i == 0 || lower(rows[i - 1].h) != lower(r.h)) {
          Text { text: upper(r.h); font: sans; fontSize: 11; fontWeight: 600; letterSpacing: 1.0; color: subFg; padding: [4, 10, 4, 2]; maxLines: 1 }
        }
        Entry { b: r.b }
      }
      Spacer { height: 4 }
    }
  }

  Column {
    fill: true
    gap: 0
    background: background

    if readId != "" && len(all) > 0 {
      let hlList = get(hl, readId, [])
      let pgap = readGap == 0 ? 4 : readGap == 1 ? 8 : 14

      if reading {
        // Distraction-Free Reader (strictly mutually exclusive with Article Info).
        Column {
          fill: true
          gap: 0

          // 44dp top bar + Aa Popup.
          Row {
            fill: width
            height: 44
            padding: [10, 0]
            align: center
            gap: 8
            Box {
              size: 36
              align: center
              radius: 8 * corners
              onTap: {
                if len(para) > 0 && item.prog != 100 && int(readPct) != (item.prog ?? -1) {
                  wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":" + "${int(readPct)}" + "}", patch: {read_progress: int(readPct)}})]
                }
                showTypo = false
                fromReader = false
                readId = ""
                confirmId = ""
                haptic()
              }
              Image { src: icBack; size: 20; tint: foreground }
            }
            Text {
              text: len(para) > 0 ? "${pageNo} / ${pageCount} · ${round(readPct)}%" : item.site
              font: sans
              fontSize: 12.5
              fontWeight: 500
              letterSpacing: 0.2
              color: subFg
              weight: 1
              align: center
              maxLines: 1
            }
            Box {
              padding: [10, 5]
              radius: 7 * corners
              background: showTypo ? chipBg : surfaceBg
              border: 1
              borderColor: showTypo ? alpha(accent, 0.42) : border
              onTap: { showTypo = !showTypo; haptic() }
              Text { text: "Aa"; font: sans; fontSize: 13; fontWeight: 600; color: showTypo ? accent : foreground; maxLines: 1 }
              Popup {
                visible: showTypo
                onDismiss: showTypo = false
                position: below
                align: end
                width: min(320, (screenWidth ?? 400) - 24)
                padding: 0
                background: surfaceBg
                border: 1
                borderColor: border
                radius: 10 * corners
                Column {
                  fill: width
                  padding: 14
                  gap: 12
                  background: surfaceBg
                  radius: 10 * corners
                  Column {
                    fill: width
                    gap: 6
                    Text { text: "TYPEFACE"; font: sans; fontSize: 10.5; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
                    Row {
                      fill: width
                      padding: 3
                      gap: 4
                      radius: 8 * corners
                      background: background
                      border: 1
                      borderColor: border
                      Box { weight: 1; onTap: { readFont = "serif"; haptic() }; SegOpt { title: "Serif"; active: readFont == "serif"; previewFont: "serif" } }
                      Box { weight: 1; onTap: { readFont = "sans"; haptic() }; SegOpt { title: "Sans"; active: readFont == "sans"; previewFont: "sans" } }
                    }
                  }
                  Row {
                    fill: width
                    align: center
                    gap: 12
                    Text { text: "TEXT SIZE"; font: sans; fontSize: 10.5; fontWeight: 700; letterSpacing: 0.8; color: subFg; weight: 1; maxLines: 1 }
                    Row {
                      align: center
                      gap: 0
                      radius: 8 * corners
                      background: background
                      border: 1
                      borderColor: border
                      Text { text: "A−"; font: sans; fontSize: 12.5; fontWeight: 600; color: foreground; padding: [14, 7]; maxLines: 1; onTap: { textSize = clamp(textSize - 2, 12, 26); haptic() } }
                      Box { width: 1; height: 22; background: border }
                      Text { text: "${textSize}"; font: sans; fontSize: 13; fontWeight: 700; color: accent; padding: [14, 7]; maxLines: 1 }
                      Box { width: 1; height: 22; background: border }
                      Text { text: "A+"; font: sans; fontSize: 15.5; fontWeight: 600; color: foreground; padding: [14, 7]; maxLines: 1; onTap: { textSize = clamp(textSize + 2, 12, 26); haptic() } }
                    }
                  }
                  Column {
                    fill: width
                    gap: 6
                    Text { text: "PARAGRAPH SPACING"; font: sans; fontSize: 10.5; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
                    Row {
                      fill: width
                      padding: 3
                      gap: 4
                      radius: 8 * corners
                      background: background
                      border: 1
                      borderColor: border
                      Box { weight: 1; onTap: { readGap = 0; haptic() }; SegOpt { title: "Compact"; active: readGap == 0 } }
                      Box { weight: 1; onTap: { readGap = 1; haptic() }; SegOpt { title: "Cozy"; active: readGap == 1 } }
                      Box { weight: 1; onTap: { readGap = 2; haptic() }; SegOpt { title: "Wide"; active: readGap == 2 } }
                    }
                  }
                  if len(prettied) > 0 || (aiOk && len(plain) > 0) {
                    Box { height: 1; fill: width; background: hairline }
                    Column {
                      fill: width
                      gap: 6
                      Row {
                        fill: width
                        align: center
                        Text { text: "ARTICLE TEXT"; font: sans; fontSize: 10.5; fontWeight: 700; letterSpacing: 0.8; color: subFg; weight: 1; maxLines: 1 }
                        Text { text: aiName; font: sans; fontSize: 10.5; color: subFg; maxLines: 1 }
                      }
                      if len(prettied) > 0 {
                        Row {
                          fill: width
                          padding: 3
                          gap: 4
                          radius: 8 * corners
                          background: background
                          border: 1
                          borderColor: border
                          Box { weight: 1; onTap: { pretty = false; haptic() }; SegOpt { title: "Original"; active: !pretty } }
                          Row {
                            weight: 1
                            align: center
                            justify: center
                            gap: 5
                            padding: [6, 7]
                            radius: 6 * corners
                            background: pretty ? chipBg : null
                            border: pretty ? 1 : 0
                            borderColor: alpha(accent, 0.4)
                            onTap: { pretty = true; haptic() }
                            Image { src: icSparkle; size: 13; tint: accent }
                            Text { text: "AI Tidied"; font: sans; fontSize: 12.5; fontWeight: pretty ? 600 : 500; color: pretty ? foreground : subFg; maxLines: 1 }
                          }
                        }
                      } else {
                        Row {
                          fill: width
                          align: center
                          justify: center
                          gap: 6
                          padding: [10, 8]
                          radius: 8 * corners
                          background: chipBg
                          border: 1
                          borderColor: alpha(accent, 0.38)
                          onTap: { if aiWant == "" { aiWant = "pretty " + item.id }; haptic() }
                          Image { src: icSparkle; size: 14; tint: accent }
                          Text { text: aiWant == "pretty " + item.id ? "Tidying with ${aiName}…" : "Tidy Text with Claude"; font: sans; fontSize: 12.5; fontWeight: 600; color: accent; maxLines: 1 }
                        }
                      }
                    }
                  }
                }
              }
            }
            Box {
              size: 34
              align: center
              radius: 8 * corners
              onTap: { showTypo = false; fromReader = true; reading = false; confirmId = ""; haptic() }
              Image { src: icInfo; size: 19; tint: subFg }
            }
          }
          Progress { value: readPct; fill: width; height: 2; color: accent; track: surfaceBg; radius: 0 }

          for k in [viewKey] key k {
            Column {
              scroll: true
              weight: 1
              fill: width
              padding: [18, 14]
              gap: pgap + 6
              if len(para) == 0 {
                Column {
                  gap: 12
                  padding: [4, 10]
                  Text { text: item.dtype == "video" ? "A video, saved for later: watch it in the browser." : item.dtype == "image" ? "A picture, saved for later: see it in the browser." : offline ? "This article's text isn't saved. Import an export of your library to read it here." : article != null && trim(article) == "" ? "This page has no readable text: open it in the browser." : "Fetching the article…"; font: sans; fontSize: 14; color: subFg }
                  if item.dtype == "video" || item.dtype == "image" || (article != null && trim(article) == "") {
                    Box {
                      padding: [14, 9]
                      radius: 8 * corners
                      background: chipBg
                      border: 1
                      borderColor: alpha(accent, 0.35)
                      onTap: url(item.url)
                      Text { text: "Open in Browser ↗"; font: sans; fontSize: 13; fontWeight: 600; color: accent; maxLines: 1 }
                    }
                  }
                }
              } else {
                if pageNo == 1 {
                  Column {
                    fill: width
                    gap: 8
                    Text {
                      text: "${item.site}${item.mins != null ? " · ${item.mins} min" : ""}${item.when != null ? " · ${fmtTime(parseTime(item.when), "d MMM")}" : ""}"
                      font: sans
                      fontSize: 12
                      fontWeight: 600
                      letterSpacing: 0.2
                      color: accent
                      maxLines: 1
                    }
                    Text { text: item.title; font: readFont; fontSize: 24; fontWeight: 700; letterSpacing: -0.3; color: foreground }
                    if item.authors != "" || item.words != null {
                      Text {
                        text: "${item.authors != "" ? "By ${item.authors}" : ""}${item.authors != "" && item.words != null ? " · " : ""}${item.words != null ? "${fmtNum(item.words)} words" : ""}"
                        font: sans
                        fontSize: 12.5
                        color: subFg
                      }
                    }
                    if item.desc != "" {
                      Text { text: item.desc; font: readFont; fontSize: 15; italic: true; color: subFg }
                    }
                    Box { height: 1; fill: width; background: hairline }
                  }
                }

                for p, i in shown key pageStart + i {
                  let pidx = pageStart + i
                  let isHl = hlList.any(x => x == pidx)
                  if p.k == "h" {
                    Text {
                      text: p.t
                      font: readFont
                      fontSize: textSize + 4
                      fontWeight: 700
                      letterSpacing: -0.1
                      color: foreground
                      padding: [isHl ? 10 : 2, pgap + 6, isHl ? 10 : 2, 2]
                      radius: 6 * corners
                      background: isHl ? alpha(accent, 0.16) : null
                      onLongPress: { hl = set(hl, readId, isHl ? hlList.filter(x => x != pidx) : hlList + [pidx]); haptic() }
                    }
                  } else if p.k == "q" {
                    Box {
                      fill: width
                      radius: 6 * corners
                      clip: true
                      background: accent
                      padding: [3, 0, 0, 0]
                      onLongPress: { hl = set(hl, readId, isHl ? hlList.filter(x => x != pidx) : hlList + [pidx]); haptic() }
                      Box {
                        fill: width
                        background: isHl ? mix(background, accent, 0.14) : mix(background, foreground, 0.05)
                        padding: [12, 8]
                        Text { text: p.t; font: readFont; fontSize: textSize; italic: true; color: isHl ? foreground : subFg; fill: width }
                      }
                    }
                  } else if p.k == "li" {
                    Row {
                      fill: width
                      gap: 8
                      align: top
                      padding: [isHl ? 10 : 2, 3]
                      radius: 6 * corners
                      background: isHl ? alpha(accent, 0.16) : null
                      onLongPress: { hl = set(hl, readId, isHl ? hlList.filter(x => x != pidx) : hlList + [pidx]); haptic() }
                      Text { text: "•"; font: readFont; fontSize: textSize; fontWeight: 700; color: accent; width: max(18, textSize); align: center }
                      Text { text: p.t; font: readFont; fontSize: textSize; color: isHl ? foreground : bodyFg; weight: 1 }
                    }
                  } else if p.k == "pre" {
                    Box {
                      fill: width
                      padding: [12, 10]
                      radius: 8 * corners
                      background: isHl ? mix(background, accent, 0.14) : surfaceBg
                      border: 1
                      borderColor: isHl ? alpha(accent, 0.45) : hairline
                      onLongPress: { hl = set(hl, readId, isHl ? hlList.filter(x => x != pidx) : hlList + [pidx]); haptic() }
                      Text { text: p.t; font: mono; fontSize: max(12, textSize - 4); color: foreground; fill: width }
                    }
                  } else if p.k == "img" {
                    Box {
                      fill: width
                      height: 220
                      radius: 8 * corners
                      clip: true
                      background: cardBg
                      border: 1
                      borderColor: isHl ? accent : hairline
                      onLongPress: { hl = set(hl, readId, isHl ? hlList.filter(x => x != pidx) : hlList + [pidx]); haptic() }
                      Image { src: p.t; fill: true; fit: contain }
                    }
                  } else if p.k == "fig" {
                    Text {
                      text: p.t
                      font: sans
                      fontSize: 12
                      italic: true
                      letterSpacing: 0.1
                      color: subFg
                      padding: [isHl ? 8 : 2, 2]
                      radius: 6 * corners
                      background: isHl ? alpha(accent, 0.16) : null
                      onLongPress: { hl = set(hl, readId, isHl ? hlList.filter(x => x != pidx) : hlList + [pidx]); haptic() }
                    }
                  } else if isHl {
                    Box {
                      fill: width
                      radius: 6 * corners
                      clip: true
                      background: accent
                      padding: [3, 0, 0, 0]
                      onLongPress: { hl = set(hl, readId, hlList.filter(x => x != pidx)); haptic() }
                      Box {
                        fill: width
                        background: mix(background, accent, 0.14)
                        padding: [12, 8]
                        Text { text: p.t; font: readFont; fontSize: textSize; color: foreground; fill: width }
                      }
                    }
                  } else {
                    Text {
                      text: p.t
                      font: readFont
                      fontSize: textSize
                      color: bodyFg
                      fill: width
                      padding: [2, 2]
                      onLongPress: { hl = set(hl, readId, hlList + [pidx]); haptic() }
                    }
                  }
                }

                if len(hlList) == 0 && pageNo == 1 {
                  Text { text: "Tip: long-press any paragraph to highlight"; font: sans; fontSize: 11; color: muted; align: center; fill: width; padding: [0, 4] }
                }
              }
            }
          }

          // Calm Bottom Paging Bar.
          Box { height: 1; fill: width; background: hairline }
          Row {
            fill: width
            height: 52
            padding: [16, 0]
            align: center
            justify: spaceBetween
            background: background
            Box {
              padding: [12, 7]
              radius: 8 * corners
              background: pageNo > 1 ? surfaceBg : null
              border: pageNo > 1 ? 1 : 0
              borderColor: border
              onTap: {
                if pageNo > 1 {
                  where = where.filter(w => w.id != readId) + [{id: readId, i: max(0, pageStart - pageLen)}]
                  haptic()
                }
              }
              Text { text: "‹ Prev"; font: sans; fontSize: 13.5; fontWeight: pageNo > 1 ? 600 : 500; color: pageNo > 1 ? foreground : muted; maxLines: 1 }
            }
            Text { text: "Page ${pageNo} of ${pageCount}"; font: sans; fontSize: 12; fontWeight: 500; color: subFg; maxLines: 1 }
            if pageNo < pageCount {
              Box {
                padding: [14, 7]
                radius: 8 * corners
                background: chipBg
                border: 1
                borderColor: alpha(accent, 0.4)
                onTap: {
                  where = where.filter(w => w.id != readId) + [{id: readId, i: pageStart + pageLen}]
                  haptic()
                }
                Text { text: "Next ›"; font: sans; fontSize: 13.5; fontWeight: 600; color: accent; maxLines: 1 }
              }
            } else if item.prog != 100 {
              Box {
                padding: [12, 7]
                radius: 8 * corners
                background: alpha(green, 0.14)
                border: 1
                borderColor: alpha(green, 0.4)
                onTap: {
                  wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":100}", patch: {read_progress: 100}})]
                  haptic()
                }
                Text { text: "✓ Finish & Mark Read"; font: sans; fontSize: 12.5; fontWeight: 600; color: green; maxLines: 1 }
              }
            } else {
              Text { text: "✓ Read"; font: sans; fontSize: 13; fontWeight: 600; color: green; padding: [10, 7]; maxLines: 1 }
            }
          }
          Spacer { height: screenInset }
        }
      } else {
        // Article Info & Inline Edit (mutually exclusive from Reader).
        Column {
          fill: true
          gap: 0

          Row {
            fill: width
            height: 48
            padding: [12, 0]
            align: center
            gap: 8
            Box {
              size: 34
              align: center
              radius: 8 * corners
              onTap: {
                if editing {
                  editing = false
                  confirmId = ""
                } else if fromReader {
                  fromReader = false
                  reading = true
                  confirmId = ""
                } else {
                  readId = ""
                  confirmId = ""
                }
                haptic()
              }
              Image { src: icBack; size: 20; tint: foreground }
            }
            Text { text: editing ? "Edit Details" : "Article Info"; font: sans; fontSize: 20; fontWeight: 700; letterSpacing: -0.2; color: foreground; weight: 1; maxLines: 1 }
            if editing {
              Box {
                padding: [12, 5]
                radius: 7 * corners
                background: chipBg
                border: 1
                borderColor: alpha(accent, 0.38)
                onTap: {
                  if trim(draftTitle) != item.title && trim(draftTitle) != "" {
                    wants = wants + [toJson({mode: "change", id: item.id, json: "{\"title\":" + toJson(draftTitle) + "}", patch: {title: draftTitle}})]
                  }
                  if draftLabels != item.labels {
                    let ls = split(draftLabels, ",").map(s => trim(s)).filter(s => s != "")
                    wants = wants + [toJson({mode: "change", id: item.id, json: "{\"labels\":" + toJson(ls) + "}", patch: {labels: ls}})]
                  }
                  if draftNote != item.note {
                    wants = wants + [toJson({mode: "change", id: item.id, json: "{\"note\":" + toJson(draftNote) + "}", patch: {note: draftNote}})]
                  }
                  editing = false
                  confirmId = ""
                  haptic()
                }
                Text { text: "Done"; font: sans; fontSize: 13; fontWeight: 600; color: accent; maxLines: 1 }
              }
            } else {
              Box {
                padding: [10, 4]
                radius: 6 * corners
                background: chipBg
                border: 1
                borderColor: alpha(accent, 0.35)
                Text { text: "${int(item.prog ?? 0)}% read"; font: sans; fontSize: 12; fontWeight: 600; color: accent; maxLines: 1 }
              }
            }
          }
          Box { height: 1; fill: width; background: hairline }

          if editing {
            Column {
              scroll: true
              weight: 1
              fill: width
              padding: [16, 14]
              gap: 13
              Row {
                fill: width
                gap: 10
                align: center
                padding: [12, 10]
                radius: 10 * corners
                background: cardBg
                border: 1
                borderColor: border
                if item.thumb != "" {
                  Box {
                    width: 44
                    height: 44
                    radius: 6 * corners
                    clip: true
                    background: surfaceBg
                    Image { src: item.thumb; fill: true; fit: cover }
                    Box { fill: true; background: scrim }
                  }
                }
                Column {
                  weight: 1
                  gap: 3
                  Text { text: item.title; font: readFont; fontSize: 13.5; fontWeight: 700; color: foreground; maxLines: 1 }
                  Text {
                    text: "${item.site}${item.authors != "" ? " · By ${item.authors}" : ""}${item.mins != null ? " · ${item.mins} min" : ""}"
                    font: sans
                    fontSize: 11.5
                    color: subFg
                    maxLines: 1
                  }
                }
              }

              Column {
                fill: width
                gap: 6
                Text { text: "TITLE"; font: sans; fontSize: 11; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
                Input {
                  text: draftTitle
                  fill: width
                  onChange: draftTitle = value
                  onSubmit: {
                    draftTitle = value
                    wants = wants + [toJson({mode: "change", id: item.id, json: "{\"title\":" + toJson(value) + "}", patch: {title: value}})]
                    haptic()
                  }
                }
              }

              Column {
                fill: width
                gap: 6
                Text { text: "LABELS (COMMA SEPARATED)"; font: sans; fontSize: 11; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
                Input {
                  text: draftLabels
                  fill: width
                  onChange: draftLabels = value
                  onSubmit: {
                    draftLabels = value
                    let ls = split(value, ",").map(s => trim(s)).filter(s => s != "")
                    wants = wants + [toJson({mode: "change", id: item.id, json: "{\"labels\":" + toJson(ls) + "}", patch: {labels: ls}})]
                    haptic()
                  }
                }
                let editLbls = split(draftLabels, ",").map(s => trim(s)).filter(s => s != "")
                if len(editLbls) > 0 {
                  Flow {
                    gap: 6
                    fill: width
                    for l in editLbls key l {
                      Text { text: l; font: sans; fontSize: 11; fontWeight: 600; color: accent; background: chipBg; padding: [7, 3]; radius: 4 * corners; maxLines: 1 }
                    }
                  }
                }
              }

              Column {
                fill: width
                gap: 6
                Row {
                  fill: width
                  align: center
                  Text { text: "NOTE"; font: sans; fontSize: 11; fontWeight: 700; letterSpacing: 0.8; color: subFg; weight: 1; maxLines: 1 }
                  Text { text: "Enter saves"; font: sans; fontSize: 11; color: subFg; maxLines: 1 }
                }
                Input {
                  text: draftNote
                  lines: 4
                  fill: width
                  placeholder: "Write a note about this bookmark…"
                  onChange: draftNote = value
                  onSubmit: {
                    draftNote = value
                    wants = wants + [toJson({mode: "change", id: item.id, json: "{\"note\":" + toJson(value) + "}", patch: {note: value}})]
                    haptic()
                  }
                }
              }

              Column {
                fill: width
                padding: [14, 12]
                gap: 10
                radius: 10 * corners
                background: cardBg
                border: 1
                borderColor: border
                Row {
                  fill: width
                  align: center
                  Text { text: "READING PROGRESS"; font: sans; fontSize: 11; fontWeight: 700; letterSpacing: 0.8; color: subFg; weight: 1; maxLines: 1 }
                  Text { text: "${int(item.prog ?? 0)}%${len(para) > 0 ? " · Page ${pageNo} of ${pageCount}" : ""}"; font: sans; fontSize: 13; fontWeight: 700; color: accent; maxLines: 1 }
                }
                Slider {
                  value: item.prog ?? 0
                  max: 100
                  step: 5
                  color: accent
                  fill: width
                  onChange: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":" + "${int(value)}" + "}", patch: {read_progress: int(value)}})] }
                }
                Row {
                  fill: width
                  gap: 8
                  for pr in [{v: 0, t: "0% Unread"}, {v: 50, t: "50%"}, {v: 100, t: "100% Read"}] key pr.v {
                    let on = int(item.prog ?? 0) == pr.v
                    Box {
                      weight: 1
                      align: center
                      padding: [6, 6]
                      radius: 6 * corners
                      background: on ? chipBg : surfaceBg
                      border: 1
                      borderColor: on ? alpha(accent, 0.45) : border
                      onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":" + "${pr.v}" + "}", patch: {read_progress: pr.v}})]; haptic() }
                      Text { text: pr.t; font: sans; fontSize: 11; fontWeight: on ? 600 : 500; color: on ? accent : foreground; maxLines: 1 }
                    }
                  }
                }
              }

              Box { height: 1; fill: width; background: hairline }
              Column {
                fill: width
                gap: 7
                Text { text: "DANGER ZONE"; font: sans; fontSize: 10.5; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
                Row {
                  fill: width
                  gap: 10
                  align: center
                  padding: [14, 11]
                  radius: 10 * corners
                  background: alpha(red, 0.10)
                  border: 1
                  borderColor: alpha(red, 0.42)
                  onTap: {
                    if confirmId == item.id {
                      confirmId = ""
                      editing = false
                      fromReader = false
                      wants = wants + [toJson({mode: "change", id: item.id, json: "{\"is_deleted\":true}", patch: {is_deleted: true}})]
                      if readId == item.id { readId = "" }
                      haptic()
                    } else {
                      confirmId = item.id
                      haptic()
                    }
                  }
                  Image { src: icTrash; size: 16; tint: red }
                  Column {
                    weight: 1
                    gap: 2
                    Text { text: confirmId == item.id ? "Really delete bookmark?" : "Delete Bookmark"; font: sans; fontSize: 13.5; fontWeight: 700; color: red; maxLines: 1 }
                    Text { text: confirmId == item.id ? "2-tap confirm · removes from server" : "Tap twice to delete"; font: sans; fontSize: 11; color: subFg; maxLines: 1 }
                  }
                  Box {
                    padding: [11, 6]
                    radius: 6 * corners
                    background: confirmId == item.id ? red : alpha(red, 0.16)
                    Text { text: confirmId == item.id ? "Confirm" : "Delete"; font: sans; fontSize: 12; fontWeight: 700; color: confirmId == item.id ? "#ffffff" : red; maxLines: 1 }
                  }
                }
              }
              Spacer { height: screenInset }
            }
          } else {
            for k in [viewKey] key k {
              Column {
                scroll: true
                weight: 1
                fill: width
                padding: [16, 12]
                gap: 12

                if item.thumb != "" {
                  Box {
                    fill: width
                    height: 150
                    radius: 10 * corners
                    clip: true
                    background: cardBg
                    border: 1
                    borderColor: hairline
                    Image { src: item.thumb; fill: true; fit: cover }
                    Box { fill: true; background: scrim }
                  }
                }

                Column {
                  fill: width
                  gap: 6
                  Text { text: item.title; font: readFont; fontSize: 22; fontWeight: 700; letterSpacing: -0.25; color: foreground }
                  Row {
                    fill: width
                    gap: 6
                    align: center
                    if item.icon != "" {
                      Box { width: 14; height: 14; radius: 3 * corners; clip: true; Image { src: item.icon; fill: true; fit: contain } }
                    }
                    if item.dtype == "video" {
                      Text { text: "▶"; font: sans; fontSize: 11; color: accent; maxLines: 1 }
                    } else if item.dtype == "image" {
                      Text { text: "▣"; font: sans; fontSize: 11; color: accent; maxLines: 1 }
                    }
                    Text { text: item.site; font: sans; fontSize: 13; fontWeight: 600; color: foreground; weight: 1; maxLines: 1 }
                    if item.when != null {
                      Text { text: fmtTime(parseTime(item.when), "d MMM yyyy"); font: sans; fontSize: 12; color: subFg; maxLines: 1 }
                    }
                  }
                  if item.authors != "" || item.mins != null || item.words != null {
                    Text {
                      text: "${item.authors != "" ? "By ${item.authors}" : ""}${item.authors != "" && item.mins != null ? " · " : ""}${item.mins != null ? "${item.mins} min read" : ""}${item.words != null ? " · ${fmtNum(item.words)} words" : ""}${item.lang != "" ? " · ${upper(item.lang)}" : ""}"
                      font: sans
                      fontSize: 12.5
                      color: subFg
                    }
                  }
                  Text { text: item.url; font: mono; fontSize: 11; color: muted; maxLines: 2; onTap: url(item.url) }
                  let detLbls = split(item.labels, ", ").filter(l => l != "")
                  if len(detLbls) > 0 {
                    Flow {
                      gap: 6
                      fill: width
                      for l in detLbls key l {
                        Text { text: l; font: sans; fontSize: 11.5; fontWeight: 500; color: accent; background: chipBg; padding: [8, 4]; radius: 5 * corners; maxLines: 1 }
                      }
                    }
                  }
                }

                // Primary 4-tile strip: Read, Open, Favorite, Archive.
                Row {
                  fill: width
                  gap: 8
                  Box {
                    weight: 1
                    onTap: { fromReader = false; reading = true; confirmId = ""; haptic() }
                    ActionTile { title: item.dtype == "video" || item.dtype == "image" ? "View" : "Read"; icon: icRead; active: true }
                  }
                  Box {
                    weight: 1
                    onTap: url(item.url)
                    ActionTile { title: "Open ↗"; icon: icOpen }
                  }
                  Box {
                    weight: 1
                    onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"is_marked\":" + toJson(!item.fav) + "}", patch: {is_marked: !item.fav}})]; haptic() }
                    ActionTile { title: "Favorite"; icon: item.fav ? icFavFill : icFav; active: item.fav; tintCol: item.fav ? orange : null }
                  }
                  Box {
                    weight: 1
                    onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"is_archived\":" + toJson(!item.arch) + "}", patch: {is_archived: !item.arch}})]; haptic() }
                    ActionTile { title: item.arch ? "Restore" : "Archive"; icon: icArchive; active: item.arch }
                  }
                }

                // Secondary utility strip: Mark Read/Unread, Copy, Share, Edit.
                Row {
                  fill: width
                  gap: 8
                  Box {
                    weight: 1
                    onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: item.prog == 100 ? "{\"read_progress\":0}" : "{\"read_progress\":100}", patch: {read_progress: item.prog == 100 ? 0 : 100}})]; haptic() }
                    UtilPill { title: item.prog == 100 ? "Unread" : "Mark Read"; icon: icSelect }
                  }
                  Box {
                    weight: 1
                    onTap: { copy(item.url); said = "Link copied"; haptic() }
                    UtilPill { title: "Copy"; icon: icCopy }
                  }
                  Box {
                    weight: 1
                    onTap: { share(item.title + " " + item.url); haptic() }
                    UtilPill { title: "Share"; icon: icShare }
                  }
                  Box {
                    weight: 1
                    onTap: { draftTitle = item.title; draftLabels = item.labels; draftNote = item.note; editing = true; confirmId = ""; haptic() }
                    UtilPill { title: "Edit"; icon: icEdit }
                  }
                }

                if said != "" {
                  Text { text: "✓ ${said}"; font: sans; fontSize: 12; color: green; maxLines: 1 }
                }
                if get(saving, item.id, 0) > 0 {
                  Text { text: "saving…"; font: sans; fontSize: 12; color: accent; maxLines: 1 }
                } else if get(failed, item.id, "") != "" {
                  Row {
                    fill: width
                    gap: 8
                    align: center
                    Text { text: "couldn't save: ${get(failed, item.id, "")}"; font: sans; fontSize: 12; color: red; weight: 1; maxLines: 3 }
                    Retry { id: item.id }
                  }
                } else if get(okIds, item.id, false) {
                  Text { text: "✓ saved"; font: sans; fontSize: 12; color: green; maxLines: 1 }
                }

                // Elevated Claude Summary card (with Anthropic disclosure) or standfirst.
                if summary != "" || (aiOk && len(plain) > 0) || len(prettied) > 0 {
                  Column {
                    fill: width
                    padding: [13, 11]
                    gap: 8
                    radius: 10 * corners
                    background: alpha(accent, 0.08)
                    border: 1
                    borderColor: alpha(accent, 0.30)
                    Row {
                      fill: width
                      gap: 6
                      align: center
                      Image { src: icSparkle; size: 14; tint: accent }
                      Text { text: "Claude Summary"; font: sans; fontSize: 12.5; fontWeight: 700; color: accent; weight: 1; maxLines: 1 }
                      Text { text: "Sent to Anthropic · ${aiName}"; font: sans; fontSize: 10.5; color: subFg; maxLines: 1 }
                    }
                    if summary != "" {
                      Text { text: summary; font: readFont; fontSize: max(14, textSize - 2); color: bodyFg }
                    } else if aiOk && len(plain) > 0 {
                      Box {
                        padding: [12, 7]
                        radius: 7 * corners
                        background: chipBg
                        border: 1
                        borderColor: alpha(accent, 0.35)
                        onTap: { if aiWant == "" { aiWant = "summary " + item.id }; haptic() }
                        Text { text: aiWant == "summary " + item.id ? "Summarising…" : "Generate Summary"; font: sans; fontSize: 12.5; fontWeight: 600; color: accent; maxLines: 1 }
                      }
                    }
                    if (aiOk && len(plain) > 0) || len(prettied) > 0 {
                      Box { height: 1; fill: width; background: hairline }
                      Row {
                        fill: width
                        align: center
                        gap: 8
                        Text {
                          text: len(prettied) > 0 ? "✓ Tidied text cached" : aiWant == "pretty " + item.id ? "Tidying with ${aiName}…" : "Original extracted text"
                          font: sans
                          fontSize: 11.5
                          fontWeight: 500
                          color: len(prettied) > 0 ? green : subFg
                          weight: 1
                          maxLines: 1
                        }
                        if len(prettied) > 0 {
                          Text {
                            text: "Read Tidied Text →"
                            font: sans
                            fontSize: 11.5
                            fontWeight: 600
                            color: accent
                            maxLines: 1
                            onTap: { pretty = true; fromReader = false; reading = true; haptic() }
                          }
                        } else if aiOk && len(plain) > 0 {
                          Text {
                            text: aiWant == "pretty " + item.id ? "Tidying…" : "Tidy Text"
                            font: sans
                            fontSize: 11.5
                            fontWeight: 600
                            color: accent
                            maxLines: 1
                            onTap: { if aiWant == "" { aiWant = "pretty " + item.id }; haptic() }
                          }
                        }
                      }
                    }
                  }
                } else if item.desc != "" {
                  Text { text: item.desc; font: readFont; fontSize: 14.5; italic: true; color: subFg }
                }

                // Personal Note card.
                if item.note != "" || len(hlList) > 0 {
                  Column {
                    fill: width
                    padding: [13, 10]
                    gap: 5
                    radius: 10 * corners
                    background: cardBg
                    border: 1
                    borderColor: border
                    Row {
                      fill: width
                      align: center
                      Text { text: "YOUR NOTE"; font: sans; fontSize: 10.5; fontWeight: 700; letterSpacing: 0.8; color: subFg; weight: 1; maxLines: 1 }
                      if len(hlList) > 0 {
                        Text { text: len(hlList) == 1 ? "1 highlight" : "${len(hlList)} highlights"; font: sans; fontSize: 11; color: accent; maxLines: 1 }
                      }
                    }
                    Text { text: item.note != "" ? item.note : "No note yet — tap Edit to add one."; font: sans; fontSize: 13; color: item.note != "" ? bodyFg : muted }
                  }
                }

                // Bottom Danger Zone 2-tap Delete.
                Box { height: 1; fill: width; background: hairline }
                Row {
                  fill: width
                  gap: 10
                  align: center
                  padding: [12, 9]
                  radius: 10 * corners
                  background: alpha(red, 0.08)
                  border: 1
                  borderColor: alpha(red, 0.35)
                  onTap: {
                    if confirmId == item.id {
                      confirmId = ""
                      fromReader = false
                      wants = wants + [toJson({mode: "change", id: item.id, json: "{\"is_deleted\":true}", patch: {is_deleted: true}})]
                      if readId == item.id { readId = "" }
                      haptic()
                    } else {
                      confirmId = item.id
                      haptic()
                    }
                  }
                  Image { src: icTrash; size: 15; tint: red }
                  Text { text: confirmId == item.id ? "Really delete bookmark?" : "Delete Bookmark"; font: sans; fontSize: 12.5; fontWeight: 600; color: red; weight: 1; maxLines: 1 }
                  if confirmId == item.id {
                    Box {
                      padding: [10, 4]
                      radius: 6 * corners
                      background: red
                      Text { text: "Confirm"; font: sans; fontSize: 11.5; fontWeight: 700; color: "#ffffff"; maxLines: 1 }
                    }
                  }
                }
                Spacer { height: screenInset }
              }
            }
          }
        }
      }
    } else if view == "setup" {
      // Server Setup & Offline Export Import.
      Column {
        fill: true
        gap: 0

        Row {
          fill: width
          height: 48
          padding: [12, 0]
          align: center
          gap: 8
          Box {
            size: 34
            align: center
            radius: 8 * corners
            onTap: { view = "unread"; connectMsg = ""; haptic() }
            Image { src: icBack; size: 20; tint: foreground }
          }
          Text { text: "Server & Import"; font: sans; fontSize: 20; fontWeight: 700; letterSpacing: -0.2; color: foreground; weight: 1; maxLines: 1 }
        }
        Box { height: 1; fill: width; background: hairline }

        Column {
          scroll: true
          weight: 1
          fill: width
          padding: [14, 16]
          gap: 16

          Column {
            fill: width
            padding: 16
            gap: 12
            radius: 10 * corners
            background: cardBg
            border: 1
            borderColor: hairline
            Row {
              fill: width
              align: center
              gap: 7
              Image { src: icServer; size: 16; tint: accent }
              Text { text: "READECK SERVER"; font: sans; fontSize: 11; fontWeight: 700; letterSpacing: 0.8; color: subFg; weight: 1; maxLines: 1 }
              Box {
                padding: [8, 2]
                radius: 999
                background: !offline ? alpha(green, 0.14) : alpha(subFg, 0.14)
                border: 1
                borderColor: !offline ? alpha(green, 0.35) : hairline
                Text { text: !offline ? "Connected" : "Offline"; font: sans; fontSize: 11; fontWeight: 600; color: !offline ? green : subFg; maxLines: 1 }
              }
            }

            Column {
              fill: width
              gap: 5
              Text { text: "Server URL"; font: sans; fontSize: 12; fontWeight: 600; color: foreground; maxLines: 1 }
              Input { text: draftBase; placeholder: "readeck.example.org"; fill: width; onChange: draftBase = trim(value); onSubmit: draftBase = trim(value) }
            }

            Column {
              fill: width
              gap: 5
              Text { text: "API Token"; font: sans; fontSize: 12; fontWeight: 600; color: foreground; maxLines: 1 }
              Text { text: "In Readeck web, open Settings → API tokens"; font: sans; fontSize: 11.5; color: subFg }
              Input { text: draftToken; placeholder: "API token"; password: true; fill: width; onChange: draftToken = trim(value); onSubmit: draftToken = trim(value) }
            }

            if connectMsg != "" {
              let msgOk = startsWith(connectMsg, "the token") || startsWith(connectMsg, "ok")
              Row {
                fill: width
                padding: [10, 8]
                radius: 8 * corners
                background: msgOk ? alpha(green, 0.14) : connectMsg == "checking…" ? chipBg : alpha(red, 0.12)
                border: 1
                borderColor: msgOk ? alpha(green, 0.35) : connectMsg == "checking…" ? alpha(accent, 0.35) : alpha(red, 0.35)
                Text { text: msgOk ? "✓ ${connectMsg}" : connectMsg; font: sans; fontSize: 12; fontWeight: 600; color: msgOk ? green : connectMsg == "checking…" ? accent : red }
              }
            }
            if notice != "" {
              Text { text: "✓ ${notice}"; font: sans; fontSize: 12; color: green }
            }

            Row {
              fill: width
              gap: 8
              Box {
                weight: 1
                align: center
                padding: [12, 10]
                radius: 8 * corners
                background: accent
                onTap: {
                  base = trim(draftBase)
                  token = trim(draftToken)
                  view = "unread"
                  notice = ""
                  lastErr = ""
                  syncAsk = syncAsk + 1
                  haptic()
                }
                Text { text: "Connect & Sync"; font: sans; fontSize: 13; fontWeight: 700; color: background; maxLines: 1 }
              }
              Box {
                align: center
                padding: [14, 10]
                radius: 8 * corners
                background: surfaceBg
                border: 1
                borderColor: border
                onTap: {
                  draftBase = trim(draftBase)
                  draftToken = trim(draftToken)
                  connectMsg = "checking…"
                  connectCheck = true
                  haptic()
                }
                Text { text: "Test Token"; font: sans; fontSize: 13; fontWeight: 600; color: foreground; maxLines: 1 }
              }
            }

            if token != "" {
              Box { height: 1; fill: width; background: hairline }
              Row {
                fill: width
                align: center
                gap: 8
                Text { text: "Credentials stored locally on device"; font: sans; fontSize: 11.5; color: subFg; weight: 1 }
                Box {
                  padding: [12, 7]
                  radius: 8 * corners
                  background: alpha(red, 0.12)
                  border: 1
                  borderColor: alpha(red, 0.32)
                  onTap: { token = ""; draftToken = ""; connectMsg = ""; haptic() }
                  Text { text: "Forget Token"; font: sans; fontSize: 12; fontWeight: 600; color: red; maxLines: 1 }
                }
              }
            }
          }

          Column {
            fill: width
            padding: 16
            gap: 12
            radius: 10 * corners
            background: cardBg
            border: 1
            borderColor: hairline
            Row {
              fill: width
              align: center
              gap: 7
              Image { src: icDownload; size: 16; tint: accent }
              Text { text: "OFFLINE EXPORT IMPORT"; font: sans; fontSize: 11; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
            }
            Text { text: "Use an export without a server: export from Readeck web (Settings → Export) as a .zip or data.json / .jsonl file to read and search offline."; font: sans; fontSize: 12.5; color: subFg }
            Column {
              fill: width
              gap: 5
              Text { text: "Export File Path"; font: sans; fontSize: 12; fontWeight: 600; color: foreground; maxLines: 1 }
              Input {
                text: importPath
                placeholder: "/path/to/data.json or .zip"
                clear: true
                fill: width
                onChange: importPath = value
                onSubmit: {
                  let f = trim(value)
                  if f != "" {
                    notice = ""
                    importPath = ""
                    wants = wants + [toJson({mode: "import", id: f})]
                    haptic()
                  }
                }
              }
            }
            Row {
              fill: width
              align: center
              gap: 10
              Box {
                padding: [14, 9]
                radius: 8 * corners
                background: chipBg
                border: 1
                borderColor: alpha(accent, 0.35)
                onTap: {
                  let f = trim(importPath)
                  if f != "" {
                    notice = ""
                    importPath = ""
                    wants = wants + [toJson({mode: "import", id: f})]
                    haptic()
                  }
                }
                Text { text: "Import Archive"; font: sans; fontSize: 13; fontWeight: 600; color: accent; maxLines: 1 }
              }
              Text { text: "Extracts HTML & local images"; font: sans; fontSize: 11.5; color: subFg; weight: 1; align: end; maxLines: 1 }
            }
            if current != null && current.mode == "import" {
              Text { text: "importing…"; font: sans; fontSize: 12; color: accent; maxLines: 1 }
            }
          }
          Spacer { height: screenInset }
        }
      }
    } else {
      // Library & Labels (shared 48dp header + overflow Popup + transient status + bottom nav).
      Column {
        fill: true
        gap: 0

        Row {
          fill: width
          height: 48
          padding: [14, 0, 10, 0]
          align: center
          gap: 8
          if view == "all" || label != "" {
            Box {
              size: 32
              align: center
              radius: 8 * corners
              onTap: {
                if label != "" {
                  label = ""
                  view = "labels"
                } else {
                  view = "unread"
                }
                notice = ""
                haptic()
              }
              Image { src: icBack; size: 20; tint: foreground }
            }
          }
          Row {
            weight: 1
            align: center
            gap: 8
            Text {
              text: view == "labels" && label == "" ? "Labels" : label != "" ? label : view == "favorite" ? "Favorites" : view == "archived" ? "Archive" : view == "all" ? "All" : "Unread"
              font: sans
              fontSize: 20
              fontWeight: 700
              letterSpacing: -0.2
              color: foreground
              maxLines: 1
            }
            Text {
              text: picking ? "${len(picked)} selected"
                : view == "labels" && label == "" ? "${len(labels)} labels"
                : typed != "" || query != "" ? "${len(seen)} found"
                : view == "unread" && label == "" ? (queue == [] ? "0 unread" : "${len(queue)} · ${queueText}")
                : "${len(seen)} items"
              font: sans
              fontSize: 12
              fontWeight: 500
              letterSpacing: 0.2
              color: picking ? orange : subFg
              maxLines: 1
              weight: 1
            }
          }
          Row {
            gap: 2
            align: center
            Box {
              size: 36
              align: center
              radius: 8 * corners
              background: showSearch ? chipBg : null
              onTap: {
                if view == "labels" && label == "" { view = "unread" }
                showSearch = !showSearch
                showMenu = false
                if !showSearch { typed = ""; query = "" }
                haptic()
              }
              Image { src: icSearch; size: 20; tint: showSearch ? accent : foreground }
            }
            if view != "labels" || label != "" {
              Box {
                size: 36
                align: center
                radius: 8 * corners
                background: showAdd ? chipBg : null
                onTap: { showAdd = !showAdd; showMenu = false; haptic() }
                Image { src: icPlus; size: 20; tint: showAdd ? accent : foreground }
              }
            }
            Box {
              size: 36
              align: center
              radius: 8 * corners
              background: showMenu ? chipBg : null
              onTap: { showMenu = !showMenu; haptic() }
              Image { src: icMore; size: 20; tint: showMenu ? accent : foreground }
              Popup {
                visible: showMenu
                onDismiss: showMenu = false
                position: below
                align: end
                width: min(240, (screenWidth ?? 400) - 24)
                padding: 0
                background: surfaceBg
                border: 1
                borderColor: border
                radius: 10 * corners
                Column {
                  fill: width
                  padding: 11
                  gap: 8
                  background: surfaceBg
                  radius: 10 * corners
                  Text { text: "SORT BY"; font: sans; fontSize: 10; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
                  Flow {
                    gap: 5
                    fill: width
                    for s in [{k: "-created", t: "Newest"}, {k: "created", t: "Oldest"}, {k: "title", t: "Title"}, {k: "length", t: "Longest"}, {k: "shortest", t: "Shortest"}] key s.k {
                      let on = sort == s.k
                      Text {
                        text: on ? "${s.t} ✓" : s.t
                        font: sans
                        fontSize: 11.5
                        fontWeight: on ? 600 : 500
                        color: on ? accent : foreground
                        background: on ? chipBg : alpha(subFg, 0.14)
                        border: 1
                        borderColor: on ? alpha(accent, 0.35) : alpha(border, 0.25)
                        radius: 6 * corners
                        padding: [7, 4]
                        maxLines: 1
                        onTap: { sort = s.k; showMenu = false; haptic() }
                      }
                    }
                  }
                  Text { text: "GROUP BY"; font: sans; fontSize: 10; fontWeight: 700; letterSpacing: 0.8; color: subFg; maxLines: 1 }
                  Flow {
                    gap: 5
                    fill: width
                    for g in [{k: "", t: "None"}, {k: "day", t: "Day"}, {k: "site", t: "Site"}, {k: "label", t: "Label"}] key g.k {
                      let on = group == g.k
                      Text {
                        text: on ? "${g.t} ✓" : g.t
                        font: sans
                        fontSize: 11.5
                        fontWeight: on ? 600 : 500
                        color: on ? accent : foreground
                        background: on ? chipBg : alpha(subFg, 0.14)
                        border: 1
                        borderColor: on ? alpha(accent, 0.35) : alpha(border, 0.25)
                        radius: 6 * corners
                        padding: [7, 4]
                        maxLines: 1
                        onTap: { group = g.k; showMenu = false; haptic() }
                      }
                    }
                  }
                  Box { height: 1; fill: width; background: hairline }
                  Row {
                    fill: width
                    align: center
                    padding: [4, 5]
                    radius: 6 * corners
                    background: view == "all" && label == "" ? chipBg : null
                    onTap: { view = view == "all" ? "unread" : "all"; label = ""; showMenu = false; haptic() }
                    Text { text: "Show All Unarchived"; font: sans; fontSize: 12.5; fontWeight: 500; color: view == "all" && label == "" ? accent : foreground; weight: 1; maxLines: 1 }
                    Text { text: "${counted.all}"; font: sans; fontSize: 11.5; color: subFg; maxLines: 1 }
                  }
                  Row {
                    fill: width
                    align: center
                    gap: 8
                    padding: [4, 5]
                    radius: 6 * corners
                    onTap: {
                      picking = !picking
                      if !picking { picked = [] }
                      if view == "labels" && label == "" { view = "unread" }
                      showMenu = false
                      notice = ""
                      haptic()
                    }
                    Image { src: icSelect; size: 15; tint: picking ? accent : foreground }
                    Text { text: picking ? "Cancel Selection" : "Select Multiple"; font: sans; fontSize: 12.5; fontWeight: 500; color: picking ? accent : foreground; weight: 1; maxLines: 1 }
                  }
                  Row {
                    fill: width
                    align: center
                    gap: 8
                    padding: [4, 5]
                    radius: 6 * corners
                    onTap: {
                      showMenu = false
                      if !offline && !syncing { notice = ""; lastErr = ""; syncAsk = syncAsk + 1 }
                      haptic()
                    }
                    Image { src: icSync; size: 15; tint: syncing ? muted : foreground }
                    Text { text: "Sync Now"; font: sans; fontSize: 12.5; fontWeight: 500; color: syncing ? muted : foreground; weight: 1; maxLines: 1 }
                    Text { text: offline ? "offline" : syncing ? "syncing…" : lastSync == 0 ? "never" : fmtAgo(lastSync, now) == "now" ? "just now" : "${fmtAgo(lastSync, now)} ago"; font: sans; fontSize: 11; color: subFg; maxLines: 1 }
                  }
                  Row {
                    fill: width
                    align: center
                    gap: 8
                    padding: [4, 5]
                    radius: 6 * corners
                    onTap: { showMenu = false; draftBase = base; draftToken = token; connectMsg = ""; view = "setup"; notice = ""; haptic() }
                    Image { src: icSettings; size: 15; tint: foreground }
                    Text { text: "Server & Import"; font: sans; fontSize: 12.5; fontWeight: 500; color: foreground; weight: 1; maxLines: 1 }
                  }
                }
              }
            }
          }
        }
        Box { height: 1; fill: width; background: hairline }

        if showStatus {
          Row {
            fill: width
            gap: 8
            align: center
            padding: [14, 5]
            background: notice != "" ? alpha(green, 0.10) : (lastErr != "" || syncMsg != "" || syncStalled) ? alpha(red, 0.10) : alpha(accent, 0.10)
            Text {
              text: current != null && current.mode == "add" ? "saving the link…" : notice != "" ? "✓ ${notice}" : lastErr != "" ? lastErr : syncMsg != "" ? syncMsg : syncing ? "syncing…" : "sync stalled"
              font: sans
              fontSize: 12
              fontWeight: 500
              color: notice != "" ? green : (lastErr != "" || syncMsg != "" || syncStalled) ? red : accent
              weight: 1
              maxLines: 2
            }
            if notice != "" || lastErr != "" {
              Text { text: "×"; font: sans; fontSize: 15; color: subFg; padding: [4, 2]; onTap: { notice = ""; lastErr = ""; haptic() } }
            }
          }
          Box { height: 1; fill: width; background: hairline }
        }

        if view == "labels" && label == "" {
          Column {
            scroll: true
            weight: 1
            fill: width
            padding: [12, 10]
            gap: 10
            onPull: {
              notice = ""
              lastErr = ""
              syncAsk = syncAsk + 1
              haptic()
            }
            Row {
              align: center
              gap: 6
              padding: [12, 6]
              radius: 999
              background: cardBg
              border: 1
              borderColor: hairline
              onTap: { if !offline && !syncing { notice = ""; lastErr = ""; syncAsk = syncAsk + 1 }; haptic() }
              Image { src: icSync; size: 13; tint: accent }
              Text {
                text: "${offline ? "Offline library" : lastSync == 0 ? "Not synced yet" : fmtAgo(lastSync, now) == "now" ? "Synced just now" : "Synced ${fmtAgo(lastSync, now)} ago"} · pull down to refresh"
                font: sans
                fontSize: 11.5
                fontWeight: 500
                color: subFg
                maxLines: 1
              }
            }
            if current != null && current.mode == "labelrm" {
              Text { text: "deleting label…"; font: sans; fontSize: 12; color: accent; maxLines: 1 }
            }
            if len(labels) == 0 {
              Text { text: "No labels yet. Add labels inside any article's details."; font: sans; fontSize: 13; color: subFg; padding: [4, 8] }
            } else {
              Column {
                fill: width
                gap: 0
                radius: 10 * corners
                clip: true
                background: cardBg
                border: 1
                borderColor: hairline
                for l, i in labels key l.name {
                  if i > 0 { Box { height: 1; fill: width; background: hairline } }
                  Row {
                    fill: width
                    gap: 10
                    align: center
                    padding: [12, 10]
                    background: label == l.name ? chipBg : null
                    Row {
                      weight: 1
                      gap: 11
                      align: center
                      onTap: { label = l.name; view = "label"; typed = ""; query = ""; notice = ""; labelMenu = ""; confirmLabel = ""; haptic() }
                      Image { src: icLabels; size: 17; tint: label == l.name ? accent : subFg }
                      Text { text: l.name; font: sans; fontSize: 14.5; fontWeight: 500; color: label == l.name ? accent : foreground; weight: 1; maxLines: 1 }
                    }
                    Text {
                      text: "${l.count}"
                      font: sans
                      fontSize: 12
                      fontWeight: 600
                      color: l.count > 0 ? subFg : muted
                      background: alpha(subFg, 0.14)
                      padding: [8, 2]
                      radius: 999
                      maxLines: 1
                    }
                    Box {
                      width: 32
                      height: 28
                      align: center
                      radius: 6 * corners
                      background: labelMenu == l.name ? alpha(foreground, 0.08) : null
                      onTap: {
                        labelMenu = labelMenu == l.name ? "" : l.name
                        confirmLabel = ""
                        haptic()
                      }
                      Text { text: "⋯"; font: sans; fontSize: 15; fontWeight: 700; color: subFg; maxLines: 1 }
                    }
                  }
                  if labelMenu == l.name {
                    Row {
                      fill: width
                      gap: 8
                      align: center
                      padding: [12, 8]
                      background: alpha(red, 0.08)
                      Text {
                        text: confirmLabel == l.name ? "Confirm permanent delete?" : "Delete label “${l.name}”?"
                        font: sans
                        fontSize: 12
                        fontWeight: 500
                        color: confirmLabel == l.name ? red : subFg
                        weight: 1
                        maxLines: 1
                      }
                      Box {
                        padding: [10, 5]
                        radius: 6 * corners
                        background: surfaceBg
                        border: 1
                        borderColor: border
                        onTap: { labelMenu = ""; confirmLabel = ""; haptic() }
                        Text { text: "Cancel"; font: sans; fontSize: 12; fontWeight: 600; color: foreground; maxLines: 1 }
                      }
                      Box {
                        padding: [10, 5]
                        radius: 6 * corners
                        background: confirmLabel == l.name ? red : alpha(red, 0.16)
                        border: 1
                        borderColor: alpha(red, 0.4)
                        onTap: {
                          if confirmLabel == l.name {
                            confirmLabel = ""
                            labelMenu = ""
                            wants = wants + [toJson({mode: "labelrm", id: l.name})]
                            haptic()
                          } else {
                            confirmLabel = l.name
                            haptic()
                          }
                        }
                        Text { text: confirmLabel == l.name ? "Confirm" : "Delete?"; font: sans; fontSize: 12; fontWeight: 600; color: confirmLabel == l.name ? "#ffffff" : red; maxLines: 1 }
                      }
                    }
                  }
                }
              }
            }
            Text { text: "Add or edit tags inside any article's details"; font: sans; fontSize: 11.5; color: subFg; align: center; fill: width; padding: [0, 4] }
          }
        } else {
          if showSearch {
            Box {
              fill: width
              padding: [12, 8, 12, 4]
              Row {
                fill: width
                gap: 8
                align: center
                padding: [10, 4]
                radius: 10 * corners
                background: alpha(foreground, 0.07)
                border: 1
                borderColor: alpha(accent, 0.38)
                Image { src: icSearch; size: 17; tint: accent }
                Input {
                  text: typed
                  placeholder: "Search library…"
                  weight: 1
                  fontSize: 14
                  underline: false
                  onChange: typed = value
                  onSubmit: { query = trim(value); typed = trim(value); haptic() }
                }
                if typed != "" && query == "" {
                  Text {
                    text: "Full text ↵"
                    font: sans
                    fontSize: 11
                    fontWeight: 600
                    color: accent
                    background: chipBg
                    padding: [7, 3]
                    radius: 6 * corners
                    maxLines: 1
                    onTap: { query = trim(typed); typed = trim(typed); haptic() }
                  }
                }
                if typed != "" || query != "" {
                  Text { text: "×"; font: sans; fontSize: 17; color: subFg; padding: [6, 3]; maxLines: 1; onTap: { typed = ""; query = ""; haptic() } }
                }
              }
            }
          }
          if showAdd {
            if offline {
              Row {
                fill: width
                gap: 8
                padding: [12, 6]
                align: center
                background: cardBg
                Text { text: token == "" ? "No API token set" : "No server URL set"; font: sans; fontSize: 13; color: subFg; weight: 1; maxLines: 1 }
                Box {
                  padding: [10, 5]
                  radius: 6 * corners
                  background: chipBg
                  onTap: { showAdd = false; draftBase = base; draftToken = token; view = "setup"; haptic() }
                  Text { text: "Connect"; font: sans; fontSize: 12; fontWeight: 600; color: accent; maxLines: 1 }
                }
              }
            } else {
              Row {
                fill: width
                gap: 8
                padding: [12, 6, 12, 4]
                align: center
                Input {
                  text: newUrl
                  placeholder: "https://… save a link"
                  weight: 1
                  onChange: newUrl = value
                  onSubmit: {
                    let u = trim(value)
                    if u != "" {
                      newUrl = ""
                      showAdd = false
                      notice = ""
                      wants = wants + [toJson({mode: "add", id: u})]
                      haptic()
                    }
                  }
                }
                Box {
                  padding: [14, 9]
                  radius: 8 * corners
                  background: accent
                  onTap: {
                    let u = trim(newUrl)
                    if u != "" {
                      newUrl = ""
                      showAdd = false
                      notice = ""
                      wants = wants + [toJson({mode: "add", id: u})]
                      haptic()
                    }
                  }
                  Text { text: "Save"; font: sans; fontSize: 13; fontWeight: 700; color: background; maxLines: 1 }
                }
              }
            }
          }
          List { rows: rows; loading: len(all) == 0 }
        }

        // Bottom Navigation Bar / Bulk Action Bar.
        Box { height: 1; fill: width; background: hairline }
        if picking {
          Column {
            fill: width
            padding: [12, 8]
            gap: 8
            background: background
            Row {
              fill: width
              align: center
              gap: 10
              Text { text: "${len(picked)} selected"; font: sans; fontSize: 12.5; fontWeight: 700; color: foreground; weight: 1; maxLines: 1 }
              Text { text: "Select All"; font: sans; fontSize: 12.5; fontWeight: 600; color: accent; padding: [6, 4]; maxLines: 1; onTap: { picked = seen.map(x => x.id); haptic() } }
              Text { text: "Done"; font: sans; fontSize: 12.5; fontWeight: 600; color: foreground; padding: [6, 4]; maxLines: 1; onTap: { picking = false; picked = []; haptic() } }
            }
            Flow {
              gap: 6
              fill: width
              for act in [
                {t: "Archive", c: foreground, bg: surfaceBg, j: "{\"is_archived\":true}", p: {is_archived: true}},
                {t: "Unarchive", c: foreground, bg: surfaceBg, j: "{\"is_archived\":false}", p: {is_archived: false}},
                {t: "Favorite", c: orange, bg: alpha(orange, 0.14), j: "{\"is_marked\":true}", p: {is_marked: true}},
                {t: "Read", c: accent, bg: chipBg, j: "{\"read_progress\":100}", p: {read_progress: 100}},
                {t: "Unread", c: foreground, bg: surfaceBg, j: "{\"read_progress\":0}", p: {read_progress: 0}},
                {t: "Delete", c: red, bg: alpha(red, 0.14), j: "{\"is_deleted\":true}", p: {is_deleted: true}}
              ] key act.t {
                Box {
                  padding: [10, 6]
                  radius: 7 * corners
                  background: act.bg
                  border: 1
                  borderColor: hairline
                  onTap: { wants = wants + [toJson({mode: "bulk", ids: picked, json: act.j, patch: act.p})]; haptic() }
                  Text { text: act.t; font: sans; fontSize: 12; fontWeight: 600; color: act.c; maxLines: 1 }
                }
              }
            }
            Spacer { height: screenInset }
          }
        } else {
          Column {
            fill: width
            gap: 0
            background: background
            Row {
              fill: width
              gap: 0
              padding: [4, 4]
              NavTab { name: "unread"; title: "Unread"; icon: icUnread; activeIcon: icUnread; badge: counted.unread }
              NavTab { name: "favorite"; title: "Favorites"; icon: icFav; activeIcon: icFavFill }
              NavTab { name: "archived"; title: "Archive"; icon: icArchive; activeIcon: icArchive }
              NavTab { name: "labels"; title: "Labels"; icon: icLabels; activeIcon: icLabels }
            }
            Spacer { height: screenInset }
          }
        }
      }
    }
  }
}

