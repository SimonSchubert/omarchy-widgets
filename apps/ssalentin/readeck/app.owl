app "readeck" {
  edge: true

  meta { owl: 18; description: "A Readeck client for a server or an exported library: unread, favorites and archive, labels and search, a reader, notes and bulk changes, plus saving a link"; version: "2.1"; license: "MIT"; category: "news" }

  title: readId != "" ? item.title ?? "reading" : view == "setup" ? "connect" : view == "labels" ? "labels" : label != "" ? label : capitalize(view)
  back: readId != "" || view == "labels" || view == "setup" || label != ""
  onBack: {
    notice = ""
    if readId != "" {
      if editing {
        editing = false
      } else {
        // Leaving keeps what was actually read in Readeck, not an instant "read": the
        // last page counts as finished. It goes in the same queue as every other tap.
        if reading && len(para) > 0 && item.prog != 100 {
          wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":" + "${int(readPct)}" + "}", patch: {read_progress: int(readPct)}})]
        }
        readId = ""
      }
    } else if view == "setup" {
      view = "unread"
    } else if label != "" {
      // A label's bookmarks go back to the list of labels they came from.
      label = ""
      view = "labels"
    } else {
      view = "unread"
    }
  }
  // Readeck's own mark, on a deep sea-blue tile of its own as the launcher's apps.md asks:
  // a 256 canvas with the rounded plate the drawer draws no frame around. The arrow takes
  // the theme's accent (currentColor); the rest keep Readeck's yellow, blue and teal.
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#0e2b38"/>
    <g transform="translate(24.9 29.4) scale(0.842)">
      <path fill="#ffcb5c" d="m191.012 69.77-99.82 46.539V187.8l127.203-59.309Z"/>
      <path fill="#37bed9" d="M91.191 117.809v71.496l105.887 49.367-6.348-38.711 33.73-20.012Z"/>
      <path fill="#2c93b6" d="M26.387 38.969H91.19v191.98H26.387Z"/>
      <path fill="#37bed9" d="M91.191 3.223 26.387 38.969l192.008 89.523V57Z"/>
      <path fill="currentColor" d="M91.191 69.188v47.12l50.536-23.558Z"/>
    </g>
  </svg>"""

  // The library, from the server or from an export of it, as the app's own helper
  // (owl-readeck, installed above) fetches it: one bookmark a line.
  requires { pacman: ["bash", "coreutils", "curl", "findutils", "grep", "jq", "python", "sed", "unzip", "util-linux"] }

  // The app's helpers: owl-readeck talks to the server and keeps the library on disk,
  // owl-readeck-read turns an article's HTML into the text the reader draws. They are
  // in this file as plaintext, and are written to ~/.local/bin on first run, so the
  // app is one self-contained file. Nothing is downloaded, decoded or installed from
  // anywhere else; the only network traffic is to the Readeck server the user names.
  source installer = cmd("""# Installs the app's own helpers from this file into ~/.local/bin, and only when
# their version marker is missing: owl-readeck talks to the Readeck server, and
# owl-readeck-read turns an article's HTML into the text the reader draws. Both are
# plaintext in this file, written by cat with a quoted heredoc, so nothing is decoded
# or fetched; they live beside the app's cache, not on a command line.
set -uo pipefail
umask 077
bin="$HOME/.local/bin"
mkdir -p "$bin" || exit 1
if ! grep -qxF '# owl-readeck 1.13' "$bin/owl-readeck" 2>/dev/null; then
  cat > "$bin/owl-readeck" << 'READECK_LIB_END'
#!/bin/bash
# owl-readeck 1.13: the script side of the Readeck app (readeck.owl).
# Fetches a Readeck server's bookmarks into the export the app reads, imports
# a Readeck export without a server, and saves changes to bookmarks.
# Every run says what it is doing in readeck-sync.json or readeck-op.err, so the
# app can show a sync or a failed change instead of guessing.
set -u
umask 077
cache="$HOME/.cache/omalauncher"
out="$cache/readeck.jsonl"
status="$cache/readeck-sync.json"
journal="$cache/readeck-ops.jsonl"
opfail="$cache/readeck-op-failed.txt"
mode="${1:-}"
mkdir -p "$HOME/.cache/omalauncher" 2>/dev/null || true
# Ops and syncs keep their errors apart: a fetch can't make a change look failed.
errfile="$cache/readeck-other.err"
case "$mode" in
  fetch | reload) errfile="$cache/readeck-sync.err" ;;
  change | bulk | add | delete | labeladd | labelrm | import | import-file)
    errfile="$cache/readeck-op.err" ;;
esac
: > "$errfile" 2>/dev/null || true
case "$mode" in
  bulk | change) : > "$opfail" 2>/dev/null || true ;;
esac

# sync_state STATE [MESSAGE] [ITEMS]: the one line the app reads to show whether
# the library is being fetched, when it last worked, and why it didn't.
sync_state() {
  s="$1" m="${2:-}" n="${3:-0}" at=$(date +%s)
  # Keep the last time a fetch worked when this one is still running or failed, so the
  # app can say both "synced 5m ago" and "the last try failed".
  ok=$(jq -r '.lastOk // (if .state == "ok" then .at else 0 end)' "$status" 2>/dev/null || echo 0)
  case "$ok" in ''|*[!0-9]*) ok=0 ;; esac
  [ "$s" = ok ] && ok="$at"
  jq -cn --arg s "$s" --arg m "$m" --argjson at "$at" --argjson n "$n" --argjson ok "$ok" \
    '{state: $s, msg: $m, at: $at, items: $n, lastOk: $ok}' > "$status.tmp" 2>/dev/null \
    && mv "$status.tmp" "$status"
}

# journal_pending ID JSON: a change the app's copy has already taken, written before
# the server is asked, so a fetch that replaces the list while it is in flight can
# still replay it. Prints the entry's token; journal_drop takes it back when the
# server refuses the change and the copy is restored.
journal_pending() {
  [ -n "${journal:-}" ] || return 0
  t="$(date +%s).$$.$RANDOM"
  (
    flock 7
    jq -cn --arg id "$1" --argjson p "$2" --argjson at "$(date +%s)" --arg t "$t" \
      '{id: $id, p: $p, at: $at, t: $t}' >> "$journal" 2>/dev/null
  ) 7> "$journal.lock"
  printf '%s' "$t"
}
journal_drop() {
  [ -n "${1:-}" ] && [ -f "$journal" ] || return 0
  (
    flock 7
    jq -c --arg t "$1" 'select(.t != $t)' "$journal" > "$journal.tmp" 2>/dev/null \
      && mv "$journal.tmp" "$journal"
  ) 7> "$journal.lock"
  return 0
}

die() {
  echo "$*" >> "$errfile" 2>/dev/null || true
  if [ "${mode:-}" = fetch ] || [ "${mode:-}" = reload ]; then
    sync_state failed "$*"
  fi
  echo "readeck: $*" >&2
  exit 1
}

# One bookmark, as the app reads it: the server's own fields (lower case) under the
# names the app uses, in the shape it expects. Reading time is worked out from the
# word count when the server doesn't say (200 words a minute).
normalise='
  map(select(type == "object" and .id != null))
  | sort_by([ .id, -(tostring | length) ])
  | unique_by(.id)
  | sort_by(-((.published // .created // "0") | tostring | .[0:19] | gsub("[^0-9]"; "") | tonumber? // 0))
  | map({
      id: (.id | tostring),
      title: (.title // ""),
      url: (.url // ""),
      site_name: (.site_name // .site // ""),
      is_marked: (.is_marked == true),
      is_archived: (.is_archived == true),
      is_deleted: (.is_deleted == true),
      read_progress: (.read_progress | tonumber? // null),
      note: (.note // ""),
      labels: ((.labels // []) | if type == "array" then map(tostring) else [tostring] end),
      description: (.description // ""),
      authors: ((.authors // []) | if type == "array" then map(tostring) else [tostring] end),
      lang: (.lang // ""),
      word_count: ((.word_count | tonumber?) // null),
      reading_time: ((.reading_time | tonumber?) // ((.word_count | tonumber? // 0) / 200 | ceil | if . > 0 then . else null end)),
      published: ((.published // .created // null) | if . == null then null else tostring end),
      created: ((.created // null) | if . == null then null else tostring end),
      document_type: (.document_type // .type // ""),
      has_article: (.has_article == true),
      site_icon: (.resources.icon.src // ""),
      image: (.resources.image.src // ""),
      thumbnail: (.resources.thumbnail.src // "")
    })
  | .[]
'
command -v jq >/dev/null || die "jq is missing (pacman -S jq)"

# A Readeck export (the zip its profile's export button makes: data.json and a
# bookmarks/<id>/info.json each) to the app's list: one line per bookmark, only
# what the app shows. A data.jsonl, from other exports, is read too.
import_from() {
  [ -f "$1" ] || die "no such file: $1"
  mkdir -p "$cache"
  # One library writer at a time: an import waits for a fetch to finish, and no fetch
  # starts under it, so neither can replace the other's result.
  exec 8> "$cache/readeck-fetch.lock"
  flock 8
  work=$(mktemp -d "$cache/readeck-import.XXXXXX") || die "couldn't make a temporary folder"
  trap 'rm -rf "$work"' EXIT

  case "$1" in
    *.zip) unzip -q -o "$1" -d "$work" || die "couldn't open $1" ;;
    *.jsonl) cp "$1" "$work/data.jsonl" || die "couldn't read $1" ;;
    *) cp "$1" "$work/data.json" || die "couldn't read $1" ;;
  esac

  # Every bookmark's info.json (capitalised fields), or a data.jsonl (lower case).
  files=$(find "$work" -name info.json; [ -f "$work/data.jsonl" ] && echo "$work/data.jsonl")
  [ -n "$files" ] || die "no bookmarks in $1"
  # shellcheck disable=SC2086
  # shellcheck disable=SC2086
  jq -c -s '
    [ .[] | select(type == "object") ]
    | map(select((.UID // .id) != null))
    | map({
        id: (.UID // .id),
        title: (.Title // .title // ""),
        url: (.URL // .url // ""),
        site_name: (.SiteName // .site_name // .Site // .site // ""),
        is_marked: ((.IsMarked // .is_marked) == true or (.IsMarked // .is_marked) == "true"),
        is_archived: ((.IsArchived // .is_archived) == true or (.IsArchived // .is_archived) == "true"),
        read_progress: (if (.ReadProgress // .read_progress) == null then null else ((.ReadProgress // .read_progress) | tonumber? // null) end),
        note: (.Note // .note // ""),
        labels: (((.Labels // .labels) // []) | if type == "array" then map(tostring) else [tostring] end),
        description: (.Description // .description // ""),
        authors: (((.Authors // .authors) // []) | if type == "array" then map(tostring) else [tostring] end),
        lang: (.Lang // .lang // ""),
        word_count: (((.WordCount // .word_count) | tonumber?) // null),
        published: (.Published // .published // .Date // .created // null),
        created: (.Created // .created // null),
        document_type: (.DocumentType // .document_type // ""),
        has_article: ((.HasArticle // .has_article) == true or (.DocumentType // .document_type // "") == "article")
      })
    | '"$normalise"'
' $files > "$out.tmp" 2>/dev/null || die "couldn't read the bookmarks in $1"
  ( flock 9; mv "$out.tmp" "$out" ) 9> "$out.lock"

  # The articles' text and pictures too, so the export reads without the
  # server: each bookmark's container/index.html, and the files its info.json
  # names (img/icon.png, img/thumbnail.jpeg, ...), copied to img/<id>-<name>.
  mkdir -p "$img_dir" || die "couldn't make the pictures' folder"
  : > "$work/paths.tmp"
  for info in "$work"/bookmarks/*/info.json; do
    [ -f "$info" ] || continue
    box=$(dirname "$info")
    id=$(basename "$box")
    [ -f "$box/container/index.html" ] && { extract "$id" "$box/container/index.html" || true; }
    for name in $(jq -r '(.Files // {}) | to_entries[]
                          | select(.key as $k | ["article", "log", "props"] | index($k) | not)
                          | .value.name' "$info" 2>/dev/null); do
      [ -f "$box/container/$name" ] || continue
      copy="$img_dir/$id-$(basename "$name")"
      cp "$box/container/$name" "$copy" 2>/dev/null || continue
      case "$name" in
        img/icon.*) key=site_icon ;;
        img/thumbnail.*) key=thumbnail ;;
        img/image.*) key=image ;;
        *) continue ;;
      esac
      jq -cn --arg id "$id" --arg k "$key" --arg f "$copy" '{id: $id, k: $k, f: $f}' \
        >> "$work/paths.tmp"
    done
  done
  # Point each bookmark's pictures at their copies, in one pass over the list.
  if [ -s "$work/paths.tmp" ]; then
    jq -s -c '.' "$work/paths.tmp" > "$work/paths.json" 2>/dev/null \
      && jq -c -s --slurpfile idx "$work/paths.json" '
        $idx[0] as $ix
        | . as $list
        | map(. as $b | reduce ($ix[] | select(.id == $b.id)) as $e
              ($b; .[$e.k] = $e.f))
        | .[]
      ' "$out" > "$out.img" 2>/dev/null \
      && mv "$out.img" "$out" || true
  fi
  # An import is the whole library now; changes from before it must not replay over it.
  ( flock 7; : > "$journal" ) 7> "$journal.lock"
}
# The local AI harness (Claude Code, from mise): a prompt in, text out, with no tools
# and no session, so it only writes an answer. Finds it even when mise has no version
# set for the shim, which is how it is on this phone.
ai_bin() {
  if [ -n "${OWL_READECK_AI:-}" ] && [ -x "${OWL_READECK_AI}" ]; then
    echo "$OWL_READECK_AI"
    return 0
  fi
  if command -v mise >/dev/null 2>&1; then
    dir=$(mise where claude 2>/dev/null) && [ -x "$dir/claude" ] && { echo "$dir/claude"; return 0; }
  fi
  for dir in "$HOME"/.local/share/mise/installs/claude/*/; do
    [ -x "$dir/claude" ] && { echo "${dir}claude"; return 0; }
  done
  return 1
}

# ai "$PROMPT" < input: the harness's answer, or nothing when it isn't there.
ai() {
  bin=$(ai_bin) || { echo "readeck: the AI harness (claude) isn't installed" >&2; return 1; }
  # --tools "" so it can run nothing; --print for one answer; a long timeout for a
  # long article. stderr is dropped: its chatter isn't the answer.
  timeout 300 "$bin" --print --tools "" \
    --system-prompt "You are a text transformation function. You never chat, never ask questions, never offer choices, and never comment on the input. You output only the requested result, nothing else." \
    "$1" <&0
}

# http METHOD URL TOKEN BODY ERROR: send a change to the server and die with the
# server's own words when it refuses, so the app can say why ("401 the token isn't
# accepted", "409 a bookmark with this URL is already there") instead of "failed".
http() {
  method="$1" url="$2" token="$3" body="$4" what="$5"
  if [ -n "$body" ]; then
    resp=$(curl -sS --max-time 25 -X "$method" -H 'Content-Type: application/json' \
      -H 'Accept: application/json' -H "Authorization: Bearer $token" \
      --data-binary "$body" -w '\n%{http_code}' "$url" 2>&1) \
      || die "$what: couldn't reach the server"
  else
    resp=$(curl -sS --max-time 25 -X "$method" -H 'Accept: application/json' \
      -H "Authorization: Bearer $token" -w '\n%{http_code}' "$url" 2>&1) \
      || die "$what: couldn't reach the server"
  fi
  code=$(printf '%s' "$resp" | tail -1)
  text=$(printf '%s' "$resp" | sed '$d')
  case "$code" in
    2*) return 0 ;;
    401 | 403) die "$what: the token isn't accepted ($code)" ;;
    *) msg=$(printf '%s' "$text" | jq -r '.message // .error // empty' 2>/dev/null | head -1)
       die "$what: ${msg:-$code}" ;;
  esac
}

# urienc VALUE: one path or query component, escaped, for a bookmark's id.
urienc() {
  jq -rn --arg v "$1" '$v|@uri'
}
# jid VALUE: VALUE as a one-item JSON array, as apply() takes it.
jid() {
  jq -cn --arg v "$1" '[$v]'
}

# apply JSON IDSJSON: what the app's own copy of these bookmarks should say from now
# on, so a change shows in the list at once instead of after a whole library fetch.
# IDSJSON is a JSON array of ids; the change's fields are merged into their lines.
apply() {
  [ -f "$out" ] || return 0
  json="$1" ids="$2"
  # One patch at a time, and a temp name of its own, so a change can't collide with
  # a fetch writing the list at the same moment.
  (
    flock 9
    jq -c --argjson j "$json" --argjson ids "$ids" \
      '. as $b | if ($ids | index($b.id | tostring)) then . * $j else . end' \
      "$out" > "$out.patch.tmp" 2>/dev/null \
      && mv "$out.patch.tmp" "$out" || rm -f "$out.patch.tmp"
  ) 9> "$out.lock"
  return 0
}

# restore ID FILE: the bookmark's line as FILE had it, putting back a change the
# server refused after the app's own copy had already been patched.
restore() {
  id="$1" from="$2"
  [ -f "$from" ] || return 0
  (
    flock 9
    jq -c --arg id "$id" --slurpfile old "$from" '
      . as $cur
      | ($old | map(select((.id | tostring) == $id)) | first) as $o
      | if ($cur.id | tostring) == $id and $o != null then $o else $cur end
    ' "$out" > "$out.patch.tmp" 2>/dev/null && mv "$out.patch.tmp" "$out" || rm -f "$out.patch.tmp"
  ) 9> "$out.lock"
  return 0
}

# The reader: one article as the light text the app draws, in
# $cache/readeck-read/<id>.jsonl (owl-readeck-read does the HTML).
read_dir="$cache/readeck-read"
img_dir="$cache/readeck-images"
ai_dir="$cache/readeck-ai"
extract() {
  # extract ID SOURCE: SOURCE is an HTML file, or - for stdin.
  mkdir -p "$read_dir" || die "couldn't make the reader's folder"
  "$(dirname "$0")/owl-readeck-read" "$2" "$read_dir/$1.jsonl.tmp" || die "couldn't read the article"
  mv "$read_dir/$1.jsonl.tmp" "$read_dir/$1.jsonl"
}

case "$mode" in
add)
  # add BASE TOKEN URL: save a link to read.
  [ $# -eq 4 ] || die "usage: $0 add BASE TOKEN URL"
  http POST "$2/api/bookmarks" "$3" "$(jq -cn --arg u "$4" '{url: $u}')" \
    "couldn't save the link"
  ;;
change)
  # change BASE TOKEN ID JSON: one change to a bookmark. The app's own copy is patched
  # first, so the row shows it at once, without waiting for the server; with a server it
  # then goes there, and is put back if the server refuses it. An imported library is
  # changed on disk alone.
  [ $# -eq 5 ] || die "usage: $0 change BASE TOKEN ID '{json}'"
  # With a server, journal the local change before it is made: a fetch replacing the
  # list while the request is in flight can then replay it, not put the old value back.
  token=""
  if [ -n "$2" ] && [ -n "$3" ]; then
    token=$(journal_pending "$4" "$5")
  fi
  prev=$(mktemp "$out.before.XXXXXX") || die "couldn't make a temporary file"
  ( flock 9; cp -f "$out" "$prev" 2>/dev/null ) 9> "$out.lock"
  apply "$5" "$(jq -cn --arg v "$4" '[$v]')"
  if [ -n "$2" ] && [ -n "$3" ]; then
    # In a subshell, so http's die only ends it: the change can be put back first.
    if ! ( http PATCH "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')" "$3" "$5" \
             "couldn't save the change" ); then
      # Drop the replay first: a fetch that already saw the pending entry must not put
      # the refused value back after the restore.
      journal_drop "$token"
      restore "$4" "$prev"
      echo "$4" >> "$opfail" 2>/dev/null || true
      rm -f "$prev"
      exit 1
    fi
  fi
  rm -f "$prev"
  ;;
bulk)
  # bulk BASE TOKEN JSON IDSJSON: the same change to several bookmarks. IDSJSON is a
  # JSON array of their ids, so the app can pass them as one quoted word. Requests go
  # four at a time (a slow server doesn't make a long queue take minutes), each is
  # patched in the app's copy as it lands, and the ids the server refused go to
  # readeck-op-failed.txt so the app can show and retry only those.
  [ $# -eq 5 ] || die "usage: $0 bulk BASE TOKEN JSON IDSJSON"
  base="$2" token="$3" json="$4"; ok=0
  total=$(printf '%s' "$5" | jq -r 'if type == "array" then length else 0 end' 2>/dev/null || echo 0)
  if [ -n "$base" ] && [ -n "$token" ]; then
    work=$(mktemp -d "$cache/readeck-bulk.XXXXXX") || die "couldn't make a temporary folder"
    trap 'rm -rf "$work"' EXIT
    printf '%s' "$5" | jq -r '.[] | tostring' > "$work/ids" 2>/dev/null || : > "$work/ids"
    export base token json errfile opfail out journal mode
    export -f http apply journal_pending journal_drop die urienc jid
    xargs -P 4 -n 1 bash -c '
      id="$1"
      if ( http PATCH "$base/api/bookmarks/$(urienc "$id")" "$token" "$json" \
               "couldn'"'"'t change $id" ); then
        journal_pending "$id" "$json" >/dev/null
        apply "$json" "$(jid "$id")"
      else
        printf "%s\n" "$id" >> "$opfail"
      fi
    ' _ < "$work/ids" 2>/dev/null
    nfail=$(grep -c '^' "$opfail" 2>/dev/null || echo 0)
    ok=$((total - nfail))
  else
    apply "$json" "$5"
    ok="$total"
  fi
  echo "changed $ok/$total"
  [ "$ok" -eq "$total" ] || exit 1
  ;;
delete)
  # delete BASE TOKEN ID: delete a bookmark for good (the app's "delete" only marks it).
  [ $# -eq 4 ] || die "usage: $0 delete BASE TOKEN ID"
  http DELETE "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')" "$3" "" \
    "couldn't delete the bookmark"
  ;;
ai-check)
  # ai-check: "ok" when the local AI harness can be used, "no" when it can't.
  if bin=$(ai_bin); then
    echo "ok $("$bin" --version 2>/dev/null | head -1)"
  else
    echo "no"
  fi
  ;;
find)
  # find WORDS: the ids of the articles whose saved text holds all the words, one a
  # line, for the app's search to look past titles. Local: no server, no network.
  [ $# -ge 2 ] || die "usage: $0 find WORDS"
  shift
  [ -d "$read_dir" ] || exit 0
  # Each word must be in a file; words with a quote or a dash first are left out.
  for f in "$read_dir"/*.jsonl; do
    [ -f "$f" ] || continue
    hit=1
    for w in "$@"; do
      grep -qiF -- "$w" "$f" || { hit=0; break; }
    done
    [ "$hit" = 1 ] && basename "$f" .jsonl
  done
  ;;
labels)
  # labels BASE TOKEN: the server's labels and their counts, one a line.
  [ $# -eq 3 ] || die "usage: $0 labels BASE TOKEN"
  curl -fsS --max-time 20 -H 'Accept: application/json' -H "Authorization: Bearer $3" \
    "$2/api/labels" > "$cache/readeck-labels.json" || die "couldn't fetch the labels"
  jq -r 'if type == "array" then .[] | "\(.name)\t\(.bookmark_count // .count // 0)" else empty end' \
    "$cache/readeck-labels.json" 2>/dev/null || true
  ;;
labeladd | labelrm)
  # labeladd BASE TOKEN NAME: make a label. labelrm ...: delete one.
  [ $# -eq 4 ] || die "usage: $0 labeladd|labelrm BASE TOKEN NAME"
  if [ "$mode" = labeladd ]; then
    http POST "$2/api/labels" "$3" "$(jq -cn --arg n "$4" '{name: $n}')" "couldn't add the label"
  else
    http DELETE "$2/api/labels/$(jq -rn --arg v "$4" '$v|@uri')" "$3" "" "couldn't delete the label"
  fi
  ;;
status)
  # status BASE TOKEN: what the server says about the token, for "connect".
  # Prints "ok <count>" or "error <the status and its message>".
  [ $# -eq 3 ] || die "usage: $0 status BASE TOKEN"
  resp=$(curl -sS --max-time 15 -H 'Accept: application/json' -H "Authorization: Bearer $3" \
    -w '\n%{http_code}' "$2/api/bookmarks?limit=1" 2>&1) || { echo "error couldn't reach $2"; exit 0; }
  code=$(printf '%s' "$resp" | tail -1)
  body=$(printf '%s' "$resp" | sed '$d')
  case "$code" in
    2*) echo "ok $(printf '%s' "$body" | jq -r 'if type == "array" then length else 0 end' 2>/dev/null || echo 0)" ;;
    401 | 403) echo "error ${code} the token isn't accepted" ;;
    *) echo "error ${code} $(printf '%s' "$body" | jq -r '.message // .error // empty' 2>/dev/null | head -1)" ;;
  esac
  ;;
summary)
  # summary ID: a short summary of the article, from the local AI harness, kept in
  # $cache/readeck-ai/<id>.summary so it's made once.
  [ $# -eq 2 ] || die "usage: $0 summary ID"
  id="$2"
  src="$read_dir/$id.jsonl"
  [ -f "$src" ] || die "the article's text isn't saved yet"
  out_file="$ai_dir/$id.summary"
  [ -s "$out_file" ] && { cat "$out_file"; exit 0; }
  mkdir -p "$ai_dir" || die "couldn't make the AI folder"
  body=$(jq -r '.t' "$src" 2>/dev/null | head -c 12000) || die "couldn't read the article"
  [ -n "$body" ] || die "the article's text is empty"
  ans=$(printf '%s' "$body" | ai 'You are a summariser. The text given to you is one article. Write a summary of it in at most 3 sentences and no more than 70 words: plain prose, no headings, no bullet points, no commentary about the text, no questions, no preamble. Reply with the summary alone.') \
    || die "the AI harness couldn't summarise it"
  ans=$(printf '%s' "$ans" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  [ -n "$ans" ] || die "the AI harness gave nothing back"
  printf '%s\n' "$ans" > "$out_file.tmp" && mv "$out_file.tmp" "$out_file"
  cat "$out_file"
  ;;
pretty)
  # pretty ID: the article's text tidied by the local AI harness — same words, same
  # paragraphs, cast to well-formed sentences — kept in $ai_dir/<id>.pretty as the
  # same JSON lines the reader draws.
  [ $# -eq 2 ] || die "usage: $0 pretty ID"
  id="$2"
  src="$read_dir/$id.jsonl"
  [ -f "$src" ] || die "the article's text isn't saved yet"
  out_file="$ai_dir/$id.pretty"
  [ -s "$out_file" ] && exit 0
  mkdir -p "$ai_dir" || die "couldn't make the AI folder"
  # Long articles go a batch at a time (about 6000 characters), so the answer fits.
  : > "$out_file.tmp"
  batch=; size=0
  tidy() {
    [ -n "$batch" ] || return 0
    ans=$(printf '%s' "$batch" | ai 'You tidy extracted web article text. The input is JSON lines: {"k": kind, "t": text}, where kind is h (heading), p (paragraph), q (quote), li (list item) or fig (caption).

Rewrite each "t" so it reads cleanly: mend sentences broken by extraction, fix stray spaces, doubled punctuation and hyphenation, and use typographic quotes and dashes. Keep the same words and the same meaning: do not summarise, shorten, add or reorder anything. Keep the same kinds and exactly one output line for each input line.

Reply with those JSON lines only, no code fence, no comment.') || return 1
    printf '%s\n' "$ans" | grep -E '^\s*\{' >> "$out_file.tmp"
    batch=; size=0
  }
  while IFS= read -r line; do
    n=${#line}
    if [ $((size + n)) -gt 6000 ] && [ -n "$batch" ]; then
      tidy || { rm -f "$out_file.tmp"; die "the AI harness couldn't tidy the article"; }
    fi
    batch="$batch$line
"
    size=$((size + n))
  done < "$src"
  tidy || { rm -f "$out_file.tmp"; die "the AI harness couldn't tidy the article"; }
  # Only trust a tidy that kept the article's shape; otherwise keep the plain text.
  want=$(wc -l < "$src")
  got=$(wc -l < "$out_file.tmp")
  if [ "$got" -lt $((want * 9 / 10)) ]; then
    rm -f "$out_file.tmp"
    die "the AI harness lost lines while tidying ($got of $want)"
  fi
  mv "$out_file.tmp" "$out_file"
  ;;
import-file)
  # import-file FILE: a data.jsonl from a Readeck export, no server needed.
  [ $# -eq 2 ] || die "usage: $0 import-file FILE"
  import_from "$2"
  ;;
read)
  # read BASE TOKEN ID: one article's text, from the server.
  [ $# -eq 4 ] || die "usage: $0 read BASE TOKEN ID"
  body=$(curl -fsS --max-time 30 -H 'Accept: text/html' -H "Authorization: Bearer $3" \
    "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')/article") \
    || die "couldn't fetch the article"
  printf '%s' "$body" | extract "$4" -
  ;;
import)
  # import BASE TOKEN: the server's export, made now, read here.
  [ $# -eq 3 ] || die "usage: $0 import BASE TOKEN"
  mkdir -p "$cache"
  curl -fsS --max-time 600 -X POST -H 'Accept: application/zip' \
    -H "Authorization: Bearer $3" -o "$cache/readeck-export.zip" "$2/profile/export" \
    || die "couldn't download the export"
  import_from "$cache/readeck-export.zip"
  ;;
fetch | reload)
  # fetch BASE TOKEN [PAGES]: the library as the server has it now. Two lists (not
  # archived and archived) hold every tab and label; pages of 100 are fetched in
  # parallel, and the labels at the same time. A change accepted while this ran is
  # replayed from the journal, so a sync can't put an old value back. Progress and
  # errors go to readeck-sync.json, which the app shows as its syncing line.
  [ $# -ge 3 ] || die "usage: $0 fetch|reload BASE TOKEN [PAGES]"
  pages="${4:-10}"
  case "$pages" in ''|*[!0-9]*) die "PAGES must be a number" ;; esac
  [ "$pages" -ge 1 ] || pages=1
  mkdir -p "$cache"
  # One fetch at a time: a second tap waits for the first rather than corrupting it.
  exec 8> "$cache/readeck-fetch.lock"
  flock 8
  base="$2" token="$3"
  start=$(date +%s)
  sync_state running "" 0
  work=$(mktemp -d "$cache/readeck-fetch.XXXXXX") || die "couldn't make a temporary folder"
  trap 'rm -rf "$work"; rm -f "$out.tmp" "$out.merge.tmp" "$journal.tmp"' EXIT
  : > "$work/fail"

  # get_page QUERY TAG PAGE: one page, in the background; a failed one is named.
  # A page past the end (404) is empty, not an error.
  get_page() {
    q="$1" tag="$2" page="$3"
    code=$(curl -sS --compressed --max-time 25 -H 'Accept: application/json' \
      -H "Authorization: Bearer $token" -w '%{http_code}' \
      "$base/api/bookmarks?$q&limit=100&page=$page&sort=-created" \
      -o "$work/$tag-$page.json" 2>/dev/null) || {
      echo "$q page $page" >> "$work/fail"; return 1; }
    case "$code" in
      2*) ;;
      404) printf '[]\n' > "$work/$tag-$page.json" ;;
      *) echo "$q page $page ($code)" >> "$work/fail"; return 1 ;;
    esac
    jq -r 'if type == "array" then length else 0 end' "$work/$tag-$page.json" \
      > "$work/$tag-$page.n" 2>/dev/null || echo 0 > "$work/$tag-$page.n"
  }

  # Page one of both lists, and the labels, together.
  get_page "is_archived=false" unarch 1 &
  p1=$!
  get_page "is_archived=true" arch 1 &
  p2=$!
  curl -sS --compressed --max-time 20 -H 'Accept: application/json' \
    -H "Authorization: Bearer $token" -o "$work/labels.json" \
    "$base/api/labels" 2>/dev/null &
  pl=$!
  wait "$p1" "$p2" "$pl" || true
  if [ -s "$work/fail" ]; then
    die "couldn't reach the server"
  fi
  # Keep the labels only when the answer is valid JSON; their counts are a nicety.
  if jq -e . "$work/labels.json" >/dev/null 2>&1; then
    cp "$work/labels.json" "$cache/readeck-labels.json" 2>/dev/null || true
  fi
  # What the server keeps beside labels, if anything: collections or saved filters,
  # as the official app organises bookmarks in collections too. Only the answer is
  # kept, for the app to read; a server without them leaves the old file alone.
  for ep in collections filters; do
    pcode=$(curl -sS --compressed --max-time 15 -H 'Accept: application/json' \
      -H "Authorization: Bearer $token" -w '%{http_code}' \
      -o "$work/probe-$ep.json" "$base/api/$ep" 2>/dev/null) || pcode=000
    if [ "$pcode" = 200 ] && jq -e . "$work/probe-$ep.json" >/dev/null 2>&1; then
      cp "$work/probe-$ep.json" "$cache/readeck-$ep.json" 2>/dev/null || true
    fi
  done

  # More pages only where page one was full, six requests at a time.
  for spec in "unarch:is_archived=false" "arch:is_archived=true"; do
    tag=${spec%%:*}; q=${spec#*:}
    n=$(cat "$work/$tag-1.n" 2>/dev/null || echo 0)
    [ "$n" -ge 100 ] || continue
    page=2
    while [ "$page" -le "$pages" ]; do
      while [ "$(jobs -rp | wc -l)" -ge 6 ]; do wait -n || true; done
      get_page "$q" "$tag" "$page" &
      page=$((page + 1))
    done
  done
  wait
  if [ -s "$work/fail" ]; then
    die "couldn't reach the server"
  fi

  # Every page as one list of bookmarks.
  jq -c 'if type == "array" then .[] else empty end' \
    "$work"/unarch-*.json "$work"/arch-*.json > "$work/raw.jsonl" 2>/dev/null \
    || die "couldn't read the server's answer"
  jq -c -s "$normalise" "$work/raw.jsonl" > "$out.tmp" 2>/dev/null \
    || die "couldn't merge the list"

  # Replay changes made since this fetch began, so its older answer can't undo them in
  # the app's copy.
  [ -f "$journal" ] || : > "$journal" 2>/dev/null || true
  # The journal snapshot and the replacement happen under the library's lock: a change
  # whose local copy is written before this replace is replayed, and one written after
  # it runs on the new list. Taking the snapshot earlier let a change that landed in
  # between be overwritten by the server's older answer.
  (
    flock 9
    ( flock 7; cp "$journal" "$work/ops.jsonl" 2>/dev/null || : > "$work/ops.jsonl" ) \
      7> "$journal.lock"
    jq -c -s --argjson since "$((start - 10))" --slurpfile log "$work/ops.jsonl" '
      . as $list
      | reduce (($log // [])[] | select((.at // 0) >= $since)) as $o
          ($list; map(if (.id | tostring) == ($o.id | tostring) then . * $o.p else . end))
      | .[]
    ' "$out.tmp" > "$out.merge.tmp" 2>/dev/null || exit 1
    mv "$out.merge.tmp" "$out"
  ) 9> "$out.lock" || die "couldn't merge the list"
  rm -f "$out.tmp"
  # Keep a short history of accepted changes; older ones are on both sides already.
  ( flock 7
    if [ -s "$journal" ]; then
      jq -c --argjson cut "$((start - 3600))" 'select((.at // 0) >= $cut)' "$journal" \
        > "$journal.tmp" 2>/dev/null && mv "$journal.tmp" "$journal"
    fi
  ) 7> "$journal.lock"
  n=$(wc -l < "$out" 2>/dev/null || echo 0)
  sync_state ok "" "$n"
  ;;
*)
  die "usage: $0 fetch|reload|import BASE TOKEN [PAGES] | read BASE TOKEN ID |
       import-file FILE | add BASE TOKEN URL | change BASE TOKEN ID JSON | delete BASE TOKEN ID |
       labels BASE TOKEN | labeladd|labelrm BASE TOKEN NAME | status BASE TOKEN | find WORDS |
       bulk BASE TOKEN JSON IDSJSON | summary ID | pretty ID | ai-check"
  ;;
esac
READECK_LIB_END
fi
if ! grep -qxF '# owl-readeck-read 1.0' "$bin/owl-readeck-read" 2>/dev/null; then
  cat > "$bin/owl-readeck-read" << 'READECK_READ_END'
#!/usr/bin/env python3
# owl-readeck-read 1.0: the reader side of the launcher's Readeck app (readeck.owl).
# Turns a Readeck article's HTML (its export's container/index.html, or the
# server's /article endpoint) into the light text the app draws: one element a
# line, "heading: ", "quote: " and "list: " marking what isn't a paragraph, so
# the app needs no HTML of its own.
#
#   owl-readeck-read HTMLFILE OUT    write OUT (JSON lines: {"k": kind, "t": text})
#   owl-readeck-read - OUT           read the HTML from stdin
#
# Kinds: h (heading), p (paragraph), q (quote), li (list item), pre (code), fig.
import json
import re
import sys
from html.parser import HTMLParser

# Elements that end the block being gathered.
BLOCK = {"p", "h1", "h2", "h3", "h4", "h5", "h6", "li", "blockquote", "pre",
         "figure", "figcaption", "dt", "dd", "summary", "tr", "div", "section",
         "article", "header", "footer", "ul", "ol", "dl", "table", "br", "hr"}
# Never show these, or their text.
SKIP = {"script", "style", "nav", "aside", "form", "iframe", "svg", "noscript",
        "button", "select", "textarea", "head", "meta", "link", "title"}


class Reader(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.blocks = []
        self.buf = []
        self.want = "p"     # the kind the text being gathered gets
        self.skip = 0       # inside an element we drop
        self.pre = 0        # inside <pre>

    def flush(self):
        text = "".join(self.buf)
        self.buf = []
        if self.pre:
            text = "\n".join(line.rstrip() for line in text.split("\n")).strip("\n")
        else:
            text = re.sub(r"[ \t\r\f\v]+", " ", text)
            text = re.sub(r" *\n *", " ", text)
            text = text.strip()
        if text:
            self.blocks.append({"k": self.want, "t": text})

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if self.skip:
            if tag in SKIP:
                self.skip += 1
            return
        if tag in SKIP:
            self.flush()
            self.skip = 1
            return
        if tag in BLOCK:
            self.flush()
            if tag in ("h1", "h2", "h3", "h4", "h5", "h6"):
                self.want = "h"
            elif tag == "li":
                self.want = "li"
            elif tag == "blockquote":
                self.want = "q"
            elif tag in ("figcaption", "dt", "dd", "summary", "pre"):
                self.want = "fig"
            elif tag in ("p", "td", "th"):
                self.want = "p"
        if tag == "pre":
            self.pre += 1

    def handle_startendtag(self, tag, attrs):
        if tag.lower() in BLOCK and not self.skip:
            self.flush()

    def handle_endtag(self, tag):
        tag = tag.lower()
        if self.skip:
            if tag in SKIP:
                self.skip -= 1
            return
        if tag == "pre":
            self.pre = max(0, self.pre - 1)
        if tag in ("h1", "h2", "h3", "h4", "h5", "h6", "li", "blockquote",
                   "figcaption", "dt", "dd", "summary"):
            self.flush()
            self.want = "p"
        elif tag in BLOCK:
            self.flush()

    def handle_data(self, data):
        if not self.skip:
            self.buf.append(data)

    def close(self):
        super().close()
        self.flush()


def main(argv):
    if len(argv) != 3:
        print("usage: owl-readeck-read HTMLFILE|'' OUT", file=sys.stderr)
        return 2
    src, out = argv[1], argv[2]
    try:
        if src in ("", "-"):
            html = sys.stdin.read()
        else:
            with open(src, encoding="utf-8", errors="replace") as f:
                html = f.read()
    except OSError as e:
        print(f"readeck: couldn't read {src}: {e}", file=sys.stderr)
        return 1

    # The article element when there is one, so a page's chrome is left out.
    m = re.search(r"<article\b.*?</article>", html, re.S | re.I)
    if m:
        html = m.group(0)

    reader = Reader()
    reader.feed(html)
    reader.close()
    with open(out, "w", encoding="utf-8") as f:
        for b in reader.blocks:
            f.write(json.dumps(b, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
READECK_READ_END
fi
chmod 755 "$bin/owl-readeck" "$bin/owl-readeck-read"
echo ready""") every 1h

  // Whether the helpers are in place, so nothing else runs until they are.
  source ready = cmd("""test -x "$HOME/.local/bin/owl-readeck" && test -x "$HOME/.local/bin/owl-readeck-read" && echo yes || echo no""") every 10s
  let helpers = trim(ready ?? "") == "yes"

  // The server and an API token from its settings (made in its profile page). Either
  // "readeck.example.org" or "https://readeck.example.org" will do. The setup page
  // edits drafts, so typing an address or a token doesn't start a fetch per letter.
  state base = "" persist
  state token = "" persist
  state draftBase = ""
  state draftToken = ""
  // As the server is written: the scheme added when it's missing, a trailing / dropped.
  let raw = base == "" ? "" : (contains(base, "://") ? base : "https://" + base)
  let server = endsWith(raw, "/") ? sub(raw, 0, len(raw) - 1) : raw
  let draftRaw = draftBase == "" ? "" : (contains(draftBase, "://") ? trim(draftBase) : "https://" + trim(draftBase))
  let draftServer = endsWith(draftRaw, "/") ? sub(draftRaw, 0, len(draftRaw) - 1) : draftRaw
  // What's on show: a list tab ("unread", "favorite", "archived", "all"), the labels
  // screen, the bookmarks of one label (view "label" with `label` set), the server
  // setup, or one bookmark.
  state view = "unread" persist
  state label = "" persist
  state query = ""
  state typed = ""
  // A successful change's answer; shown until the next tap.
  state notice = ""
  state readId = ""
  state editing = false
  // Whether the article's text is on show under its details, and not only the page's link.
  state reading = false persist
  // Whether the reader shows the tidied text and the summary (both made by the local AI
  // harness, once each), and whether those are being made now.
  state pretty = true persist
  state aiWant = ""
  state newUrl = ""
  // Changes are queued, one at a time, instead of one command being rewritten under
  // the last: a tap never cancels or loses the change before it. `override` shows a
  // change at once; `saving`, `okIds` and `failed` say what each bookmark is doing.
  // The queue and its statuses persist, so a reload or a closed app resumes the change
  // instead of leaving it stuck on "saving" or failing it with no answer.
  state wants = []
  state current = null persist
  state pending = [] persist
  state opSeq = 0 persist
  state override = {} persist
  state saving = {} persist
  state okIds = {} persist
  state failed = {} persist
  state retry = {} persist
  state lastOpAt = 0 persist
  // The row under a sideways swipe: its id and how far it moved (negative is left).
  state swipeId = ""
  state swipeX = 0
  // Bumped by connect, "sync now" and pull-to-refresh; the fetch below reads it, so
  // each tap runs the fetch at once instead of waiting for the minute to pass. A tap
  // during a fetch asks for one more instead of cancelling this one.
  state fetchN = 0 persist
  state syncAgain = false
  state syncAsk = 0
  // The script's own words when a change failed, so a tap that didn't work says why.
  state lastErr = ""
  // How the list is ordered and grouped: "-created" (newest), "created", "title",
  // "length" (longest read) or "shortest"; and "", "day", "site" or "label".
  state sort = "-created" persist
  state group = "" persist
  // The reader's text size, in points, and where you got to in each article (a map
  // from its id to a paragraph number), kept so an article opens where you left it.
  state textSize = 16 persist
  // [{id, i}] — how far into each article you got, so it opens where you left it.
  state where = [] persist
  // Whether taps pick bookmarks for a bulk change, and which are picked.
  state picking = false
  state picked = []
  // A "delete" waiting for a second tap, by id; a label's × that needs one too.
  state confirmId = ""
  state confirmLabel = ""
  state connectMsg = ""
  // Copied or shared, to say so.
  state said = ""
  // Whether "test the token" is asking now, so the command runs once and says its answer.
  state connectCheck = false
  // The server's answer to the change last sent from the phone: {code, ok, out, err}.
  state opResult = null
  // Whether the "save a link" bar is open: it stays out of the way until asked for.
  state showAdd = false
  // The reader's typography, as the official app's: a font and a spacing, kept per phone.
  state readFont = "sans" persist
  state readGap = 1 persist
  // Paragraphs kept highlighted in the reader, by article id: the official app's
  // highlights, kept on this phone since the server's API has no word for them.
  state hl = {} persist

  // The library the helper writes: one bookmark per line.
  source lib = file("~/.cache/omalauncher/readeck.jsonl")
  // For "3d" beside a date.
  source now = clock every 1m

  // The fetch's own status: running, the last success and its item count, or why it
  // failed. The app reads it instead of guessing from a command's output, so an
  // automatic sync says it is syncing too, and a killed one doesn't stay "syncing".
  source syncFile = file("~/.cache/omalauncher/readeck-sync.json") json
  let syncState = syncFile ?? {}
  let syncing = syncState.state == "running" && now - (syncState.at ?? 0) < 300
  let syncStalled = syncState.state == "running" && !syncing
  let syncFailed = syncState.state == "failed"
  let syncMsg = syncState.state == "failed" ? (syncState.msg ?? "couldn't reach the server") : syncStalled ? "sync timed out" : ""
  let lastSync = syncState.lastOk ?? 0

  // Fetches the server's list whenever `fetchN` goes up (owl runs a command again as soon
  // as what it reads changes), so "sync now", pull-to-refresh and connect act at once
  // instead of on the next minute. The helper does the pages in parallel and writes
  // readeck-sync.json, which says when it began and how it ended.
  source fetched = cmd(!helpers || server == "" || token == "" ? "echo waiting ${sh(fetchN)}" : "owl-readeck fetch ${sh(server)} ${sh(token)} 10 >/dev/null 2>&1 && echo done ${sh(fetchN)} || echo failed ${sh(fetchN)}") every 5m timeout 240s
  // One change at a time: `current` is sent, `pending` waits behind it. The command
  // depends on `current` alone, so a second tap can't rewrite or cancel the first; its
  // answer carries the op's own number, so identical answers still count.
  // The changes that need the Linux side: bulk (many requests at once), import
  // (a file on disk), and every change while offline (the imported library is
  // edited on disk alone). The single changes with a server go from the phone,
  // in the trigger below, so nothing here can come between a tap and the server.
  source ran = cmd(
    !helpers || current == null || (server != "" && token != "" && (current.mode == "change" || current.mode == "add" || current.mode == "labeladd" || current.mode == "labelrm")) ? "echo idle"
    : current.mode == "change" ? "owl-readeck change ${sh(server)} ${sh(token)} ${sh(current.id)} ${sh(current.json)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@; cat \"$HOME/.cache/omalauncher/readeck-op-failed.txt\" 2>/dev/null"
    : current.mode == "bulk" ? "owl-readeck bulk ${sh(server)} ${sh(token)} ${sh(current.json)} ${sh(toJson(current.ids ?? []))} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@; cat \"$HOME/.cache/omalauncher/readeck-op-failed.txt\" 2>/dev/null"
    : current.mode == "add" ? "owl-readeck add ${sh(server)} ${sh(token)} ${sh(current.id)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@"
    : current.mode == "labeladd" ? "owl-readeck labeladd ${sh(server)} ${sh(token)} ${sh(current.id)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@"
    : current.mode == "labelrm" ? "owl-readeck labelrm ${sh(server)} ${sh(token)} ${sh(current.id)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@"
    : current.mode == "import" ? "owl-readeck import-file ${sh(current.id)} >/dev/null 2>&1; rc=$?; echo ${int(current.n)} $rc; head -1 \"$HOME/.cache/omalauncher/readeck-op.err\" 2>/dev/null; echo @@IDS@@"
    : "echo ${int(current.n)} 1; echo @@IDS@@") every 12h timeout 900s
  // "test the token" on the setup page: the script asks the server what it makes of it.
  // It uses the drafts, so the test doesn't start a fetch with half-typed values.
  source checked = cmd(!helpers || !connectCheck ? "echo" : "set -o pipefail; owl-readeck status ${sh(draftServer)} ${sh(draftToken)} 2>/dev/null | sed -e 's/^ok .*/ok/' -e 's/^error /error: /' || echo \"error: couldn't reach the server\"") every 1m
  on checked first {
    if value != "" && value != "checking…" {
      connectMsg = value == "ok" ? "the token works" : sub(value, 0, 70)
      connectCheck = false
    }
  }

  // A sync's end: with no change left in the queue, the fetched list is the truth, so
  // the optimistic overlay and "saved" ticks can go. A tap during the fetch asks for
  // one more run instead of cancelling it.
  on syncFile first {
    if value != null {
      let st = value.state ?? ""
      // A change that landed during this fetch may be newer than its answer, so its
      // overlay stays until a quiet sync (no change in the last half-minute) proves it.
      if st == "ok" && current == null && len(pending) == 0 && now - lastOpAt > 300 {
        override = {}
        okIds = {}
        saving = {}
      }
      if (st == "ok" || st == "failed") && syncAgain {
        syncAgain = false
        fetchN = fetchN + 1
      }
    }
  }
  // Every "sync now", pull and connect is one ask; while a fetch runs it becomes a
  // follow-up, never a second process over the same file.
  on syncAsk first {
    if value > 0 {
      if syncing { syncAgain = true } else { fetchN = fetchN + 1 }
    }
  }

  // `wants` is a list of changes as JSON: a tap appends one, and this queues the
  // first. A list, not one value, so two taps in a row can't overwrite each other.
  on wants first {
    if len(wants) > 0 {
      let want = first(wants) ?? ""
      let o = parseJson(want)
      if o != null && o.mode != null && (o.mode != "bulk" || len(o.ids ?? []) > 0) {
        opSeq = opSeq + 1
        let ids = o.mode == "bulk" ? (o.ids ?? []) : o.mode == "change" && o.id != null ? [o.id] : []
        saving = reduce(ids, (acc, id) => set(acc, id, get(acc, id, 0) + 1), saving)
        okIds = reduce(ids, (acc, id) => remove(acc, id), okIds)
        failed = reduce(ids, (acc, id) => remove(acc, id), failed)
        retry = reduce(ids, (acc, id) => remove(acc, id), retry)
        if o.patch != null {
          override = reduce(ids, (acc, id) => set(acc, id, merge(get(acc, id, {}), o.patch)), override)
        }
        let op = merge(o, {n: opSeq})
        if current == null { current = op } else { pending = pending + [op] }
        if o.mode == "bulk" { picked = []; picking = false }
        notice = ""
        lastErr = ""
      }
      wants = drop(wants, 1)
    }
  }

  // A change's end: a success marks the bookmark saved; a refusal says the server's
  // own words, puts the old value back, and offers a retry. Bulk failures name only
  // the ids the server refused, so the rest stay changed.
  on ran first {
    let out = trim(value ?? "")
    if out != "" && out != "idle" {
      // The command prints "number exit-code", the server's first error line, then
      // "@@IDS@@" and the ids it refused: all in one value, so the handler never
      // reads a file the helper may not have finished writing.
      let parts = split(out, "@@IDS@@")
      let head = trim(parts[0] ?? "")
      let tail = len(parts) > 1 ? parts[1] : ""
      let w = words(head)
      let n = num(w[0] ?? "0")
      let code = w[1] ?? ""
      if current != null && n == current.n {
        let op = current
        let ids = op.mode == "bulk" ? (op.ids ?? []) : op.mode == "change" ? [op.id] : []
        if code == "0" {
          saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
          okIds = reduce(ids, (acc, id) => set(acc, id, true), okIds)
          failed = reduce(ids, (acc, id) => remove(acc, id), failed)
          retry = reduce(ids, (acc, id) => remove(acc, id), retry)
          notice = op.mode == "bulk" ? "changed" : op.mode == "import" ? "imported" : op.mode == "add" ? "link saved" : op.mode == "labeladd" ? "label added" : op.mode == "labelrm" ? "label deleted" : "saved"
          lastErr = ""
          lastOpAt = now
          if op.mode == "import" {
            // An import is the whole library: no old optimistic value may hide it.
            override = {}
            okIds = {}
            saving = {}
            failed = {}
            retry = {}
          }
          if op.mode == "add" || op.mode == "labeladd" || op.mode == "labelrm" {
            if syncing { syncAgain = true } else { fetchN = fetchN + 1 }
          }
        } else {
          // Everything after the number and the exit code is the server's answer;
          // the ids, if any, come after @@IDS@@.
          let rawMsg = trim(join(drop(lines(head), 1), " "))
          if rawMsg == "" && (op.mode == "change" || op.mode == "bulk") && (op.tries ?? 0) < 2 {
            // No words from the script means it was killed or timed out, not refused:
            // whether the server took the change is unknown, so queue it again (the
            // same PATCH twice is harmless, and the journal replays it either way)
            // and keep showing "saving", instead of calling it failed and putting
            // the old value back over a change the server may well have kept.
            saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
            wants = wants + [toJson(merge(op, {tries: (op.tries ?? 0) + 1}))]
            current = len(pending) > 0 ? first(pending) : null
            pending = drop(pending, 1)
          } else {
            let msg = rawMsg == "" ? "interrupted; tap retry" : replace(rawMsg, "readeck: ", "")
            let bad = lines(tail).filter(l => l != "" && l != "@@IDS@@")
            let badIds = len(bad) > 0 ? bad : ids
            saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
            okIds = reduce(badIds, (acc, id) => remove(acc, id), okIds)
            failed = reduce(badIds, (acc, id) => set(acc, id, msg), failed)
            override = reduce(badIds, (acc, id) => remove(acc, id), override)
            retry = reduce(badIds, (acc, id) => op.mode == "bulk" || op.mode == "change" ? set(acc, id, {mode: "change", id: id, json: op.json, patch: op.patch}) : remove(acc, id), retry)
            lastErr = msg
            notice = ""
            if op.mode == "import" {
              // It may have replaced the library before failing on a picture.
              override = {}
              okIds = {}
              saving = {}
              failed = {}
              retry = {}
            }
          }
        }
        current = len(pending) > 0 ? first(pending) : null
        pending = drop(pending, 1)
      }
    }
  }

  // A single change with a server goes out from the phone itself, so no process on
  // the Linux side can die between the tap and the server: the queue's `current`
  // says what to send, and the answer lands in `opResult`.
  on current first {
    if current != null && !offline {
      if current.mode == "change" {
        opResult = post(server + "/api/bookmarks/" + enc(current.id), parseJson(current.json), {Authorization: "Bearer ${token}"}, method: "PATCH")
      } else if current.mode == "add" {
        opResult = post(server + "/api/bookmarks", {url: current.id}, {Authorization: "Bearer ${token}"}, method: "POST")
      } else if current.mode == "labeladd" {
        opResult = post(server + "/api/labels", {name: current.id}, {Authorization: "Bearer ${token}"}, method: "POST")
      } else if current.mode == "labelrm" {
        opResult = post(server + "/api/labels/" + enc(current.id), null, {Authorization: "Bearer ${token}"}, method: "DELETE")
      }
    }
  }
  // The server's answer: the row's tick or its reason, then the queue moves on.
  // The optimistic value stays until a quiet sync proves it, as before.
  on opResult first {
    if opResult != null && current != null {
      let op = current
      let ids = op.mode == "change" ? [op.id] : []
      if opResult.ok {
        saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
        okIds = reduce(ids, (acc, id) => set(acc, id, true), okIds)
        failed = reduce(ids, (acc, id) => remove(acc, id), failed)
        retry = reduce(ids, (acc, id) => remove(acc, id), retry)
        notice = op.mode == "add" ? "link saved" : op.mode == "labeladd" ? "label added" : op.mode == "labelrm" ? "label deleted" : "saved"
        lastErr = ""
        lastOpAt = now
        if op.mode == "add" || op.mode == "labeladd" || op.mode == "labelrm" {
          if syncing { syncAgain = true } else { fetchN = fetchN + 1 }
        }
      } else {
        let msg = opResult.code == -1 ? "no answer from the server; tap retry" : opResult.code == 401 || opResult.code == 403 ? "the token isn't accepted (${opResult.code})" : opResult.out != null && opResult.out.message != null ? opResult.out.message : opResult.err != null && opResult.err != "" ? opResult.err : "the server answered ${opResult.code}"
        saving = reduce(ids, (acc, id) => set(acc, id, max(0, get(acc, id, 0) - 1)), saving)
        okIds = reduce(ids, (acc, id) => remove(acc, id), okIds)
        failed = reduce(ids, (acc, id) => set(acc, id, msg), failed)
        override = reduce(ids, (acc, id) => remove(acc, id), override)
        retry = reduce(ids, (acc, id) => op.mode == "change" ? set(acc, id, {mode: "change", id: id, json: op.json, patch: op.patch}) : remove(acc, id), retry)
        lastErr = msg
        notice = ""
      }
      current = len(pending) > 0 ? first(pending) : null
      pending = drop(pending, 1)
      opResult = null
    }
  }

  // The article's text, as the reader draws it (owl-readeck-read, through the script):
  // one element a line, {k, t}. Opening an article fetches it once (from the server, or
  // from an imported export) and keeps it on disk, so it reads offline afterwards.
  source article = file("~/.cache/omalauncher/readeck-read/${readId}.jsonl")
  let plain = lines(article).map(l => parseJson(l)).filter(p => p != null)

  // The local AI harness (Claude Code, on this system), for a summary and for tidying
  // the text. Both are made once per article and kept, and neither is needed to read.
  source aiCheck = cmd(!helpers ? "echo no" : "owl-readeck ai-check 2>/dev/null || echo no") every 1m
  let aiOk = startsWith(aiCheck ?? "", "ok")
  // The harness's name, for the buttons: "local AI" says enough, "2.1.302 (Claude Code)" doesn't.
  let aiName = "local AI"
  // What the harness made of this article: a summary, and the tidied text.
  source madeSummary = file("~/.cache/omalauncher/readeck-ai/${readId}.summary")
  source madePretty = file("~/.cache/omalauncher/readeck-ai/${readId}.pretty")
  let summary = trim(madeSummary ?? "")
  let prettied = lines(madePretty).map(l => parseJson(l)).filter(p => p != null)
  let para = pretty && len(prettied) > 0 ? prettied : plain
  // The reader is paged: `where` keeps the paragraph each article was left at, and a
  // page is `pageLen` of them. A long piece opens where it was left, and the pager
  // moves a page at a time instead of leaving the whole article to scroll from the top.
  let pageLen = 12
  let atNow = find(where, w => w.id == readId) ?? {id: readId, i: 0}
  let pageStart = clamp(pageLen * floor(atNow.i / pageLen), 0, max(0, len(para) - 1))
  let pageCount = max(1, ceil(len(para) / pageLen))
  let pageNo = floor(pageStart / pageLen) + 1
  // The detail column is keyed by this: a new page, a new article or switching to or
  // from reading builds it again, which starts its scroll at the top of the reader.
  let viewKey = readId + ":" + (reading ? "read:" : "details:") + "${pageNo}"
  let shown = drop(para, pageStart).take(pageLen)
  let readPct = len(para) == 0 ? 0 : (pageStart + len(shown)) / len(para) * 100
  let needle = lower(trim(query))
  // What's typed but not sent yet: the list narrows on titles, sites and labels as you
  // type (no command runs), and only Enter looks through the articles' own text.
  let typedNeedle = lower(trim(typed))
  // The articles whose own text holds the search's words: the script looks through the
  // text it saved (no shell tools beyond grep), and says which ids match.
  source textHits = cmd(!helpers || needle == "" ? "echo" : "owl-readeck find ${sh(needle)}") every 1m
  let hits = lines(textHits).filter(l => l != "")

  // The AI work runs when a button asks for it ("summary ID", "pretty ID"), not on its
  // own: a shell command that only becomes real once the article's text is there.
  // Two values, each its own shell word: "summary" or "pretty", and the article's id.
  let aiMode = first(split(aiWant, " "))
  let aiId = last(split(aiWant, " "))
  source aiRan = cmd(!helpers || trim(aiWant ?? "") == "" ? "echo idle" : "owl-readeck ${sh(aiMode)} ${sh(aiId)} >/dev/null 2>&1 && echo ok || echo failed") every 1m
  on aiRan {
    if value == "ok" || value == "failed" { aiWant = "" }
  }

  // Off the server, or from the export (importing one writes its articles' text too).
  source got = cmd(!helpers || readId == "" ? "echo idle" : "owl-readeck read ${sh(server)} ${sh(token)} ${sh(readId)} >/dev/null 2>&1; echo done") every 5m timeout 60s

  // Each bookmark as one text line, so a broken one can't hide the rest: id, title, url,
  // site, favorite, archived, progress (null without it in the export), labels, and what
  // its page shows: description, authors, language, length, date, pictures.
  let parsed = lines(lib).map(l => parseJson(l)).filter(b => b != null && b.id != null)
  let all = parsed.map(b => merge(b, get(override, "${b.id}", {}))).filter(b => b.is_deleted != true).map(b => {id: "${b.id}", title: b.title ?? "", url: b.url ?? "", site: b.site_name ?? "", fav: b.is_marked == true, arch: b.is_archived == true, prog: b.read_progress, labels: join(b.labels ?? [], ", "), note: b.note ?? "", desc: b.description ?? "", authors: join(b.authors ?? [], ", "), lang: b.lang ?? "", mins: b.reading_time, words: b.word_count, when: b.published ?? b.created, added: b.created, icon: b.site_icon ?? "", thumb: b.thumbnail ?? b.image ?? "", dtype: b.document_type ?? ""})

  let item = all.find(b => b.id == readId) ?? {}
  // The label picked (every bookmark with it, archived or not), else the tab's bookmarks;
  // then the words searched for, in the page's facts and in the articles' own text.
  let tabbed = label != "" ? all.filter(b => contains(lower(", " + b.labels + ","), ", " + lower(label) + ","))
    : all.filter(b => view == "favorite" ? b.fav : view == "archived" ? b.arch : view == "unread" ? b.prog != 100 && !b.arch : !b.arch)
  let filtered = tabbed.filter(b =>
    (typedNeedle == "" || contains(lower(b.title + " " + b.site + " " + b.labels + " " + b.url + " " + b.desc + " " + b.authors), typedNeedle)) &&
    (needle == "" || contains(lower(b.title + " " + b.site + " " + b.labels + " " + b.url + " " + b.desc + " " + b.authors), needle) || hits.any(id => id == b.id)))
  let seen = (sort == "title" ? filtered.sortBy(b => lower(b.title))
    : sort == "length" ? filtered.sortBy(b => -(b.mins ?? 0))
    : sort == "shortest" ? filtered.sortBy(b => b.mins ?? 9999)
    : sort == "created" ? filtered.sortBy(b => b.added ?? "")
    : filtered.sortBy(b => "" + (b.when ?? "")))
    .reverse()
  // The rows to draw: a header when grouped, then the items under it.
  let rows = seen.map(b => {h: group == "day" ? fmtTime(parseTime(b.when ?? b.added), "d MMM yyyy")
    : group == "site" ? b.site
    : group == "label" ? (first(split(b.labels, ", ")) ?? "no label")
    : "", b: b})
  let counted = {unread: all.count(b => b.prog != 100 && !b.arch), favorite: all.count(b => b.fav && !b.arch), archived: all.count(b => b.arch), all: all.count(b => !b.arch)}
  // How long the queue is to read, in minutes, said as "2h 5m" or "39m".
  let queue = all.filter(b => b.prog != 100 && !b.arch).map(b => b.mins ?? 0)
  let queueMin = sum(queue)
  let queueText = queueMin >= 60 ? "${floor(queueMin / 60)}h ${round(queueMin % 60)}m" : "${round(queueMin)}m"
  // Every label: the bookmarks' own, and the server's list (so unused ones show too).
  source serverLabels = file("~/.cache/omalauncher/readeck-labels.json")
  let labelNames = unique((flatten(all.map(b => split(b.labels, ", "))) + (parseJson(serverLabels) ?? []).map(l => l.name ?? "")).filter(l => l != "")).sortBy(l => lower(l))
  let labels = labelNames.map(l => {name: l, count: all.count(b => contains(lower(", " + b.labels + ","), ", " + lower(l) + ","))})
  let offline = server == "" || token == ""

  component Tab(name, count) {
    Column {
      weight: 1
      gap: 3
      padding: [8, 9]
      radius: 10 * corners
      align: center
      background: view == name && label == "" ? alpha(foreground, 0.10) : null
      onTap: { view = name; label = ""; typed = ""; query = ""; notice = ""; haptic() }
      Text { text: name; style: body; fontSize: 15; align: center; maxLines: 1; bold: view == name && label == ""; color: view == name && label == "" ? foreground : muted }
      Text { text: count > 999 ? "${floor(count / 1000)}k" : "${count}"; style: label; fontSize: 12; align: center; color: muted }
    }
  }

  // A change the server refused: one tap queues the same change again, now that the
  // old value is back on show.
  component Retry(id) {
    Text {
      text: "retry"
      style: label
      color: red
      padding: [2, 4]
      maxLines: 1
      onTap: {
        let op = get(retry, id, null)
        if op != null {
          wants = wants + [toJson(op)]
          haptic()
        }
      }
    }
  }

  // An entry in the list: the story's picture or the site's icon (never both, so a
  // long list stays under the image limit), its title, the site and labels, how long a
  // read it is and how old, what its change is doing, and a tick when it's picked for a
  // bulk change. Tapping opens it; a left swipe archives or restores it, a right swipe
  // marks it read or unread. The action's tab shows at the edge while the row moves.
  component Entry(b) {
    Box {
      fill: width
      radius: 8 * corners
      clip: true
      // The strip's colour is the row's own background: the content slides over it
      // and uncovers it at the edge the finger opens, deepening as the swipe nears
      // the point where letting go does the action.
      background: swipeId == b.id && swipeX > 0
        ? linear(0, 0, 1, 0, range(31).map(i => i / 30 <= 0.26 ? mix(background, accent, 0.14 + 0.30 * min(1, abs(swipeX) / 88)) : mix(background, foreground, 0.04)))
        : swipeId == b.id && swipeX < 0
        ? linear(0, 0, 1, 0, range(31).map(i => i / 30 >= 0.74 ? mix(background, red, 0.12 + 0.30 * min(1, abs(swipeX) / 88)) : mix(background, foreground, 0.04)))
        : mix(background, foreground, 0.04)
      // The action tabs ride in from the edges on the same spring as the content, so
      // each label arrives with the row it belongs to instead of sitting over it;
      // a row left open keeps its tab uncovered, to tap.
      Row {
        fill: width
        align: center
        Box {
          width: 96
          height: 56
          align: center
          offset: [swipeId == b.id && swipeX > 0 ? swipeX - 96 : -96, 0]
          animate offset: spring(0.85, 500)
          onTap: {
            wants = wants + [toJson({mode: "change", id: b.id, json: b.prog == 100 ? "{\"read_progress\":0}" : "{\"read_progress\":100}", patch: {read_progress: b.prog == 100 ? 0 : 100}})]
            swipeId = ""
            swipeX = 0
            haptic()
          }
          Text { text: b.prog == 100 ? "mark unread" : "mark read"; style: label; color: foreground; maxLines: 1 }
        }
        Spacer { weight: 1 }
        Box {
          width: 96
          height: 56
          align: center
          offset: [swipeId == b.id && swipeX < 0 ? swipeX + 96 : 96, 0]
          animate offset: spring(0.85, 500)
          onTap: {
            wants = wants + [toJson({mode: "change", id: b.id, json: b.arch ? "{\"is_archived\":false}" : "{\"is_archived\":true}", patch: {is_archived: !b.arch}})]
            swipeId = ""
            swipeX = 0
            haptic()
          }
          Text { text: b.arch ? "restore" : "archive"; style: label; color: foreground; maxLines: 1 }
        }
      }
      Row {
        let st = get(saving, b.id, 0) > 0 ? "saving" : get(failed, b.id, "") != "" ? "failed" : get(okIds, b.id, false) ? "saved" : ""
        fill: width
        gap: 10
        align: top
        padding: [10, 9]
        radius: 8 * corners
        // Opaque, so the content hides the tabs where it still covers them.
        background: picked.any(id => id == b.id) ? mix(background, accent, 0.12) : mix(background, foreground, 0.04)
        // Sideways only: the list still scrolls up and down under a finger on a row.
        offset: [swipeId == b.id ? swipeX : 0, 0]
        animate offset: spring(0.85, 500)
        drag: horizontal
        onDrag: {
          if !picking {
            if swipeId != b.id {
              swipeId = b.id
              swipeX = 0
            }
            let was = abs(swipeX)
            swipeX = clamp(swipeX + dx, -96, 96)
            // A tick when the swipe reaches "let go and it happens", so the thumb
            // knows the difference between opening the row and doing the action.
            if was < 88 && abs(swipeX) >= 88 { haptic() }
          }
        }
        onDragEnd: {
          if swipeId == b.id {
            // Past the mark (or flung) the action runs at once; a shorter swipe leaves
            // the row open on its actions, to tap or to drag back.
            let archive = swipeX <= -88 || (vx < -500 && swipeX < -24)
            let mark = swipeX >= 88 || (vx > 500 && swipeX > 24)
            if archive {
              wants = wants + [toJson({mode: "change", id: b.id, json: b.arch ? "{\"is_archived\":false}" : "{\"is_archived\":true}", patch: {is_archived: !b.arch}})]
              swipeId = ""
              swipeX = 0
              haptic()
            } else if mark {
              wants = wants + [toJson({mode: "change", id: b.id, json: b.prog == 100 ? "{\"read_progress\":0}" : "{\"read_progress\":100}", patch: {read_progress: b.prog == 100 ? 0 : 100}})]
              swipeId = ""
              swipeX = 0
              haptic()
            } else if swipeX < -24 {
              swipeX = -96
            } else if swipeX > 24 {
              swipeX = 96
            } else {
              swipeId = ""
              swipeX = 0
            }
          }
        }
        // A long press picks without leaving the list; a tap opens, or picks while picking.
        onLongPress: {
          picking = true
          picked = picked.any(id => id == b.id) ? picked.filter(id => id != b.id) : picked + [b.id]
          haptic()
        }
        onTap: {
          if swipeId == b.id && swipeX != 0 {
            // A tap on an open row closes its actions before it opens the bookmark.
            swipeId = ""
            swipeX = 0
          } else if picking {
            picked = picked.any(id => id == b.id) ? picked.filter(id => id != b.id) : picked + [b.id]
          } else {
            notice = ""
            lastErr = ""
            readId = b.id
            editing = false
            confirmId = ""
            reading = true
            swipeId = ""
            swipeX = 0
            haptic()
          }
        }
      Box {
        width: 6
        height: 52
        radius: 3
        background: b.fav ? orange : b.prog == 100 ? alpha(muted, 0.4) : accent
      }
      Column {
        weight: 1
        gap: 4
        Text { text: b.title; maxLines: 3 }
        Row {
          gap: 6
          align: center
          if b.icon != "" && b.thumb == "" {
            Box { width: 14; height: 14; Image { src: b.icon; fill: true; fit: contain } }
          }
          // What kind of thing was saved: the official app keeps videos and pictures
          // beside articles, and says so on the row.
          if b.dtype == "video" {
            Text { text: "▶"; style: small; color: accent; maxLines: 1 }
          } else if b.dtype == "image" {
            Text { text: "▣"; style: small; color: accent; maxLines: 1 }
          }
          // The site takes the free width; length and age share one label at the end.
          Text { text: b.site; style: small; color: muted; maxLines: 1; weight: 1 }
          if b.note != "" {
            Text { text: "✎"; style: small; color: muted; maxLines: 1 }
          }
          // One right-aligned label for both, so the site keeps the width it can.
          Text {
            text: "${b.mins != null ? "${b.mins}m" : ""}${b.mins != null && b.when != null ? " · " : ""}${b.when != null ? fmtAgo(parseTime(b.when), now) : ""}"
            style: label
            color: muted
            maxLines: 1
            width: 66
            align: end
            visible: b.mins != null || b.when != null
          }
        }
        // The authors when they're not just the site's name; else the labels.
        if b.authors != "" && b.authors != b.site {
          Text { text: b.authors; style: label; color: muted; maxLines: 1 }
        } else if b.labels != "" {
          Text { text: b.labels; style: label; color: accent; maxLines: 1 }
        }
        // How far into a piece you got, for one you started and didn't finish.
        if b.prog > 0 && b.prog < 100 {
          Progress { value: b.prog; height: 2; color: accent; radius: 1 }
        }
        // What the last change to this bookmark is doing.
        if st == "saving" {
          Text { text: "saving…"; style: label; color: accent; maxLines: 1 }
        } else if st == "failed" {
          Row {
            gap: 6
            Text { text: get(failed, b.id, "couldn't save"); style: label; color: red; maxLines: 3; weight: 1 }
            Retry { id: b.id }
          }
        } else if st == "saved" {
          Text { text: "✓ saved"; style: label; color: green; maxLines: 1 }
        }
      }
      if b.thumb != "" {
        Box { width: 76; height: 52; radius: 6 * corners; clip: true; Image { src: b.thumb; fill: true; fit: cover } }
      } else if b.fav {
        Text { text: "★"; color: orange; width: 20; align: end; maxLines: 1 }
      }
      if picked.any(id => id == b.id) {
        Text { text: "✓"; color: accent; width: 20; align: end; maxLines: 1 }
      } else if b.thumb != "" && b.fav {
        Text { text: "★"; color: orange; width: 16; align: end; maxLines: 1 }
      }
      }
    }
  }

  component List(rows, loading) {
    Column {
      // lazy: only the rows in view are built, so a library of a thousand opens at the
      // same speed as a short one; a pull at the top fetches it again.
      lazy: true
      weight: 1
      gap: 6
      padding: [12, 4, 12, 12]
      onPull: {
        notice = ""
        lastErr = ""
        syncAsk = syncAsk + 1
        haptic()
      }
      if loading {
        // The first run, and until something is there: both ways in, whichever fits.
        Column {
          gap: 8
          padding: [8, 4]
          Text { text: offline ? "Nothing to read yet." : "Fetching your bookmarks…"; style: body; color: muted }
          if offline {
            Text { text: "Point the app at your Readeck server, and its API token, to fetch your library. Or import an export of it, to read offline."; style: small; color: muted }
            Button { text: "connect a server"; color: accent; onTap: { draftBase = base; draftToken = token; view = "setup"; haptic() } }
          } else {
            Text { text: "The app's library is empty. Fetch the list, or import an export of yours."; style: small; color: muted }
            Button { text: "fetch now"; color: muted; onTap: { notice = ""; syncAsk = syncAsk + 1; haptic() } }
          }
          Text { text: "Import an export (its data.json, or the zip)"; style: label; color: muted }
          Input { placeholder: "/path/to/data.json or .zip"; clear: true; onSubmit: { notice = ""; wants = wants + [toJson({mode: "import", id: trim(value)})] } }
          if current != null && current.mode == "import" {
            Text { text: "importing…"; style: label; color: accent }
          }
        }
      }
      if !loading && len(rows) == 0 {
        Column {
          gap: 6
          padding: [12, 18]
          Text { text: typed != "" || query != "" ? "nothing found for “${trim(typed != "" ? typed : query)}”" : label != "" ? "nothing under this label" : "nothing here"; color: muted; style: small }
          if typed != "" || query != "" {
            Text { text: "enter searches the articles' own text too, not just titles"; color: muted; style: label; visible: query == "" }
            Text { text: "clear the search"; style: label; color: accent; padding: [4, 0]; onTap: { typed = ""; query = ""; haptic() } }
          }
        }
      }
      for r, i in rows key r.b.id {
        if r.h != "" && (i == 0 || rows[i - 1].h != r.h) {
          Text { text: r.h; style: label; color: muted; padding: [10, 4, 2, 4] }
        }
        Entry { b: r.b }
      }
      Spacer { height: screenInset }
    }
  }

  Column {
    fill: true
    gap: 0

    if readId != "" && len(all) > 0 {
      // One bookmark.
      for k in [viewKey] key k {
      Column {
        scroll: true
        fill: true
        gap: readGap == 0 ? 8 : readGap == 1 ? 12 : 16
        padding: [12, 8]
        // The paragraphs kept highlighted here, and the space between them the
        // spacing control asks for.
        let hlList = get(hl, readId, [])
        let pgap = readGap == 0 ? 2 : readGap == 1 ? 6 : 12
        // The reader: the article's text, as the script pulled it out of its page, at the
        // size chosen, opened where you stopped last time.
        if reading {
          Column {
            gap: 10
            padding: [4, 0]
            if len(para) == 0 {
              // A video or a picture has no text to draw: the official app saves them
              // to open in their own place, and says what they are.
              Text { text: item.dtype == "video" ? "A video, saved for later: watch it in the browser." : item.dtype == "image" ? "A picture, saved for later: see it in the browser." : offline ? "This article's text isn't saved. Import an export of your library to read it here." : article != null && trim(article) == "" ? "This page has no readable text: open it in the browser." : "Fetching the article…"; style: small; color: muted }
              if item.dtype == "video" || item.dtype == "image" {
                Button { text: "open it"; color: accent; onTap: url(item.url) }
              }
            } else {
              // How the text is set: the page, its size, its font and its spacing,
              // as the official app's typography controls, and the way back to the
              // article's details.
              Row {
                gap: 6
                align: center
                wrap: true
                Text { text: "page ${pageNo} of ${pageCount}"; style: label; color: muted; weight: 1; maxLines: 1 }
                Text { text: "A−"; style: small; color: muted; padding: [4, 8]; onTap: { textSize = clamp(textSize - 2, 12, 26); haptic() } }
                Text { text: "${textSize}"; style: label; color: muted; width: 30; align: center }
                Text { text: "A+"; style: body; color: muted; padding: [4, 8]; onTap: { textSize = clamp(textSize + 2, 12, 26); haptic() } }
                Text { text: readFont == "serif" ? "serif" : "sans"; style: label; color: muted; padding: [4, 8]; onTap: { readFont = readFont == "serif" ? "sans" : "serif"; haptic() } }
                Text { text: readGap == 0 ? "compact" : readGap == 1 ? "cozy" : "wide"; style: label; color: muted; padding: [4, 8]; onTap: { readGap = (readGap + 1) % 3; haptic() } }
                // The reader is first while reading; this gets back to the article's details.
                Text { text: "details"; style: label; color: muted; padding: [4, 6]; onTap: { reading = false; haptic() } }
              }
              Progress { value: readPct; height: 3; color: accent; radius: 2 }
              if len(hlList) == 0 {
                Text { text: "long-press a paragraph to highlight it"; style: label; color: muted; maxLines: 1 }
              }
              for p, i in shown key i {
                if p.k == "h" {
                  // a section heading: larger than the text, but not a page title
                  Text { text: p.t; style: body; bold: true; fontSize: textSize + 3; font: readFont; padding: [pgap + 8, 2, 2, 2]; radius: 4 * corners; background: hlList.any(x => x == i) ? alpha(accent, 0.16) : null; onLongPress: { hl = set(hl, readId, hlList.any(x => x == i) ? hlList.filter(x => x != i) : hlList + [i]); haptic() } }
                } else if p.k == "q" {
                  Text { text: p.t; style: body; fontSize: textSize; font: readFont; italic: true; color: muted; padding: [pgap + 2, 10]; radius: 4 * corners; background: hlList.any(x => x == i) ? alpha(accent, 0.16) : alpha(foreground, 0.05); onLongPress: { hl = set(hl, readId, hlList.any(x => x == i) ? hlList.filter(x => x != i) : hlList + [i]); haptic() } }
                } else if p.k == "li" {
                  Row {
                    gap: 6
                    padding: [pgap, 2]
                    radius: 4 * corners
                    background: hlList.any(x => x == i) ? alpha(accent, 0.16) : null
                    onLongPress: { hl = set(hl, readId, hlList.any(x => x == i) ? hlList.filter(x => x != i) : hlList + [i]); haptic() }
                    Text { text: "•"; style: body; fontSize: textSize; font: readFont; color: muted; width: 10 }
                    Text { text: p.t; style: body; fontSize: textSize; font: readFont; weight: 1 }
                  }
                } else if p.k == "fig" {
                  Text { text: p.t; style: small; color: muted; padding: [pgap, 2]; radius: 4 * corners; background: hlList.any(x => x == i) ? alpha(accent, 0.16) : null; onLongPress: { hl = set(hl, readId, hlList.any(x => x == i) ? hlList.filter(x => x != i) : hlList + [i]); haptic() } }
                } else {
                  Text { text: p.t; style: body; fontSize: textSize; font: readFont; padding: [pgap, 2]; radius: 4 * corners; background: hlList.any(x => x == i) ? alpha(accent, 0.16) : null; onLongPress: { hl = set(hl, readId, hlList.any(x => x == i) ? hlList.filter(x => x != i) : hlList + [i]); haptic() } }
                }
              }
              // A page at a time, the position kept per article so the next open starts
              // here. At the last page, the way on is to finish it: mark it read.
              Row {
                gap: 8
                align: center
                Button {
                  text: "‹ back"
                  color: pageNo > 1 ? foreground : muted
                  onTap: {
                    if pageNo > 1 {
                      where = where.filter(w => w.id != readId) + [{id: readId, i: max(0, pageStart - pageLen)}]
                      haptic()
                    }
                  }
                }
                Spacer { weight: 1 }
                Button {
                  text: "next ›"
                  color: pageNo < pageCount ? accent : muted
                  onTap: {
                    if pageNo < pageCount {
                      where = where.filter(w => w.id != readId) + [{id: readId, i: pageStart + pageLen}]
                      haptic()
                    }
                  }
                }
              }
              if pageNo == pageCount && item.prog != 100 {
                Button {
                  text: "finish: mark read"
                  color: accent
                  onTap: {
                    wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":100}", patch: {read_progress: 100}})]
                    haptic()
                  }
                }
              }
              Spacer { height: 8 }
            }
          }
        }
        // The story's own picture, full width, when its page has one.
        if item.thumb != "" {
          Box { fill: width; height: 190; radius: 8 * corners; clip: true; Image { src: item.thumb; fill: true; fit: cover } }
        }
        Text { text: item.title; style: title; maxLines: 4 }
        // Who wrote it, where, when, and how long a read: the page's own facts.
        Row {
          gap: 6
          align: center
          if item.icon != "" {
            Box { width: 14; height: 14; Image { src: item.icon; fill: true; fit: contain } }
          }
          if item.dtype == "video" {
            Text { text: "▶"; style: small; color: accent; maxLines: 1 }
          } else if item.dtype == "image" {
            Text { text: "▣"; style: small; color: accent; maxLines: 1 }
          }
          Text { text: item.site; style: small; color: muted; maxLines: 1; width: 130 }
          Spacer { weight: 1 }
          if item.when != null {
            Text { text: fmtTime(parseTime(item.when), "d MMM yyyy"); style: label; color: muted; maxLines: 1 }
          }
        }
        Text { text: "${item.authors}${item.authors != "" && item.mins != null ? " · " : ""}${item.mins != null ? "${item.mins} min" : ""}${item.words != null ? " · ${fmtNum(item.words)} words" : ""}${item.lang != "" ? " · ${upper(item.lang)}" : ""}"; style: label; color: muted; maxLines: 2; visible: item.authors != "" || item.mins != null || item.words != null }
        // A summary by the phone's own AI: made once, kept beside the article.
        if summary != "" {
          Column {
            gap: 4
            padding: [8, 10]
            radius: 6 * corners
            background: alpha(accent, 0.09)
            Row {
              gap: 6
              align: center
              Text { text: "summary"; style: label; color: accent; width: 80 }
              Text { text: "made on this phone by ${aiName}"; style: label; color: muted; maxLines: 1 }
            }
            Text { text: summary; style: body; fontSize: textSize; font: readFont }
          }
        } else if item.desc != "" {
          // The page's own summary, in italic, like a standfirst.
          Text { text: item.desc; style: body; italic: true; color: muted; padding: [2, 0] }
        }
        // The AI's buttons: a summary if there isn't one, and the text tidied or plain.
        if aiOk && len(plain) > 0 {
          Row {
            gap: 6
            wrap: true
            if summary == "" {
              Button { text: aiWant == "summary " + item.id ? "summarising…" : "summarise"; color: accent; onTap: { aiWant = "summary " + item.id; haptic() } }
            }
            // Tidied (the AI's) or as it came (the page's own words).
            Button {
              text: len(prettied) == 0 ? (aiWant == "pretty " + item.id ? "tidying…" : "tidy the text") : pretty ? "tidied text" : "tidy the text"
              color: pretty && len(prettied) > 0 ? foreground : muted
              onTap: {
                if len(prettied) > 0 {
                  pretty = !pretty
                } else if aiWant == "" {
                  aiWant = "pretty " + item.id
                }
                haptic()
              }
            }
            if len(prettied) > 0 {
              Button { text: "as it came"; color: pretty ? muted : foreground; onTap: { pretty = false; haptic() } }
            }
          }
          if aiWant == "pretty " + item.id {
            Text { text: "tidying the text with ${aiName}…"; style: small; color: muted }
          }
        }
        Text { text: "${item.url}"; style: small; color: muted; maxLines: 2 }
        Flow {
          gap: 6
          for l in split(item.labels, ", ").filter(l => l != "" ) key l {
            Text { text: l; style: label; color: accent; padding: [4, 6]; width: null; radius: 4 * corners; background: alpha(accent, 0.14) }
          }
        }
        Row {
          gap: 6
          wrap: true
          if item.dtype != "video" && item.dtype != "image" {
            Button { text: reading ? "hide the text" : "read here"; color: reading ? muted : accent; onTap: { reading = !reading; haptic() } }
          }
          Button { text: item.dtype == "video" ? "open the video" : item.dtype == "image" ? "open the image" : "open the article"; onTap: url(item.url) }
        }
        if editing {
          Text { text: "title"; style: label; color: muted }
          Input { text: item.title; onSubmit: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"title\":" + toJson(value) + "}", patch: {title: value}})] } }
          Text { text: "labels, comma separated"; style: label; color: muted }
          Input { text: item.labels; onSubmit: {
            let ls = split(value, ",").map(s => trim(s)).filter(s => s != "")
            wants = wants + [toJson({mode: "change", id: item.id, json: "{\"labels\":" + toJson(ls) + "}", patch: {labels: ls}})]
          } }
          Text { text: "your note"; style: label; color: muted }
          Input { text: item.note; placeholder: "a note about this one…"; onSubmit: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"note\":" + toJson(value) + "}", patch: {note: value}})] } }
          // Where you are in it, by hand.
          Text { text: "read ${item.prog ?? 0}%"; style: label; color: muted }
          Slider {
            value: item.prog ?? 0
            max: 100
            step: 5
            color: accent
            onChange: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":" + "${int(value)}" + "}", patch: {read_progress: int(value)}})] }
          }
        }
        Row {
          gap: 8
          wrap: true
          Button { text: item.fav ? "★ favorite" : "☆ favorite"; color: item.fav ? orange : muted; onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"is_marked\":" + toJson(!item.fav) + "}", patch: {is_marked: !item.fav}})] } }
          Button { text: item.arch ? "unarchive" : "archive"; color: muted; onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"is_archived\":" + toJson(!item.arch) + "}", patch: {is_archived: !item.arch}})] } }
          if item.prog == 100 {
            Button { text: "mark unread"; color: muted; onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":0}", patch: {read_progress: 0}})] } }
          } else {
            Button { text: "mark read"; color: muted; onTap: { wants = wants + [toJson({mode: "change", id: item.id, json: "{\"read_progress\":100}", patch: {read_progress: 100}})] } }
          }
          Button { text: editing ? "close edit" : "edit"; color: muted; onTap: editing = !editing }
          // Delete asks once more, then goes.
          Button {
            text: confirmId == item.id ? "really delete?" : "delete"
            color: red
            onTap: {
              if confirmId == item.id {
                confirmId = ""
                wants = wants + [toJson({mode: "change", id: item.id, json: "{\"is_deleted\":true}", patch: {is_deleted: true}})]
                if readId == item.id { readId = "" }
              } else {
                confirmId = item.id
                haptic()
              }
            }
          }
        }
        // A link to keep: on the clipboard, or to another app.
        Row {
          gap: 8
          wrap: true
          Button { text: "copy link"; color: muted; onTap: { copy(item.url); said = "link copied"; haptic() } }
          Button { text: "share"; color: muted; onTap: { share(item.title + " " + item.url); haptic() } }
        }
        if said != "" {
          Text { text: said; style: label; color: green }
        }
        if get(saving, item.id, 0) > 0 {
          Text { text: "saving…"; style: small; color: accent }
        } else if get(failed, item.id, "") != "" {
          Row {
            gap: 8
            Text { text: "couldn't save: ${get(failed, item.id, "")}"; style: small; color: red; weight: 1; maxLines: 4 }
            Retry { id: item.id }
          }
        } else if get(okIds, item.id, false) {
          Text { text: "✓ saved"; style: label; color: green }
        }
        if item.note != "" {
          Text { text: "note"; style: label; color: muted }
          Text { text: item.note; style: body; padding: [4, 8]; radius: 6 * corners; background: alpha(foreground, 0.04) }
        }
        if item.prog == 100 { Text { text: "read"; style: small; color: muted } }
        if item.arch { Text { text: "archived"; style: small; color: muted } }
      }
      }
    } else {
      // The list: what's copied is a link to save.
      Column {
        fill: true
        gap: 0
        if view == "labels" {
          Column {
            scroll: true
            weight: 1
            padding: [8, 8]
            gap: 2
            onPull: {
              notice = ""
              lastErr = ""
              syncAsk = syncAsk + 1
              haptic()
            }
            Text { text: "${len(labels)} labels"; style: label; color: muted; padding: [0, 4] }
            // A label to make; the × deletes one (asks twice, since it's for good).
            Input { placeholder: "new label…"; clear: true; onSubmit: { if trim(value) != "" { wants = wants + [toJson({mode: "labeladd", id: trim(value)})]; haptic() } } }
            if current != null && (current.mode == "labeladd" || current.mode == "labelrm") {
              Text { text: current.mode == "labeladd" ? "adding the label…" : "deleting the label…"; style: label; color: accent; padding: [2, 4] }
            }
            if notice != "" {
              Text { text: "✓ ${notice}"; style: label; color: green; padding: [2, 4] }
            } else if lastErr != "" {
              Text { text: lastErr; style: label; color: red; padding: [2, 4]; maxLines: 2 }
            }
            for l in labels key l.name {
              Row {
                gap: 10
                padding: [12, 8]
                radius: 6 * corners
                background: label == l.name ? alpha(accent, 0.14) : null
                // A label opens its bookmarks; Back comes back here.
                onTap: { label = l.name; view = "label"; typed = ""; query = ""; notice = ""; confirmLabel = ""; haptic() }
                Text { text: l.name; maxLines: 1; weight: 1; color: label == l.name ? accent : foreground }
                Text { text: "${l.count}"; style: small; color: muted; width: 44; align: end; maxLines: 1 }
                Text {
                  text: confirmLabel == l.name ? "sure?" : "×"
                  style: small
                  color: red
                  padding: [2, 8]
                  onTap: {
                    if confirmLabel == l.name {
                      confirmLabel = ""
                      wants = wants + [toJson({mode: "labelrm", id: l.name})]
                    } else {
                      confirmLabel = l.name
                      haptic()
                    }
                  }
                }
              }
            }
            Spacer { height: screenInset }
          }
                } else if view == "setup" {
          // The server's address and a token from its Settings → API tokens.
          Column {
            scroll: true
            weight: 1
            padding: [12, 8]
            gap: 8
            Text { text: "Readeck server"; style: label; color: muted }
            Input { text: draftBase; placeholder: "readeck.example.org"; onChange: draftBase = trim(value); onSubmit: draftBase = trim(value) }
            Text { text: "In your Readeck, Settings → API tokens makes one for this app. Paste it here."; style: small; color: muted }
            Input { text: draftToken; placeholder: "API token"; password: true; onChange: draftToken = trim(value); onSubmit: draftToken = trim(value) }
            Row {
              gap: 8
              wrap: true
              Button { text: "connect"; color: accent; onTap: {
                // Only what is connected is fetched; drafts don't start a sync as they type.
                base = trim(draftBase)
                token = trim(draftToken)
                view = "unread"
                notice = ""
                lastErr = ""
                syncAsk = syncAsk + 1
                haptic()
              } }
              Button { text: "test the token"; color: muted; onTap: {
                draftBase = trim(draftBase)
                draftToken = trim(draftToken)
                connectMsg = "checking…"
                connectCheck = true
                haptic()
              } }
              if token != "" {
                Button { text: "forget it"; color: red; onTap: { token = ""; draftToken = ""; connectMsg = ""; haptic() } }
              }
            }
            if connectMsg != "" {
              Text { text: connectMsg; style: small; color: startsWith(connectMsg, "ok") ? green : red }
            }
            if notice != "" {
              Text { text: "✓ ${notice}"; style: label; color: green }
            }
            Spacer { height: 8 }
            // Without a server, an export works on its own; importing writes its text too,
            // so the reader and search work offline.
            Text { text: "Without a server, an export of your library works on its own: import it from the Readeck web app (Settings → Export), and the app reads it offline."; style: small; color: muted }
            Text { text: "Import an export (its data.json, or the zip)"; style: label; color: muted }
            Input {
              placeholder: "/path/to/data.json or .zip"
              clear: true
              onSubmit: {
                let f = trim(value)
                if f != "" {
                  notice = ""
                  wants = wants + [toJson({mode: "import", id: f})]
                  haptic()
                }
              }
            }
            if current != null && current.mode == "import" {
              Text { text: "importing…"; style: label; color: accent }
            }
            Button { text: "back"; color: muted; onTap: view = "unread" }
          }
        } else {
          // Unread, favorites, archive or everything: hidden while one label's bookmarks
          // are on show, since the label says what the list holds.
          if label == "" {
            Row {
              gap: 6
              padding: [12, 8, 12, 6]
              for t in ["unread", "favorite", "archived", "all"] key t {
                Tab { name: t; count: counted[t] ?? 0 }
              }
            }
          }
          // Search, labels and the server setup are always one tap away: the box narrows
          // the list as you type, and Enter also looks through the articles' own text.
          Row {
            gap: 8
            align: center
            padding: [12, 4, 12, 6]
            Input {
              text: typed
              placeholder: "search…"
              weight: 1
              fontSize: 15
              underline: false
              background: alpha(foreground, 0.06)
              radius: 8 * corners
              padding: [10, 4]
              onChange: typed = value
              onSubmit: { query = trim(value); typed = trim(value); haptic() }
            }
            if typed != "" || query != "" {
              Text { text: "×"; fontSize: 17; color: muted; padding: [10, 6]; onTap: { typed = ""; query = ""; haptic() } }
            }
            // The save-a-link bar, opened only when wanted: one less row between the
            // list and the top of the screen.
            Text { text: showAdd ? "−" : "+"; fontSize: 17; color: showAdd ? accent : muted; padding: [10, 6]; onTap: { showAdd = !showAdd; haptic() } }
            Text { text: "labels"; style: small; fontSize: 14; color: accent; padding: [7, 8]; onTap: { view = "labels"; label = ""; query = ""; typed = ""; notice = ""; haptic() } }
            Text { text: "setup"; style: small; fontSize: 14; color: muted; padding: [7, 8]; onTap: { draftBase = base; draftToken = token; view = "setup"; notice = ""; haptic() } }
          }
          // How fresh the list is, and the way to fetch it now. The last answer rides
          // on this one line too — green when it worked, red when it didn't — so the
          // list keeps the height a notice would have taken.
          Row {
            gap: 8
            align: center
            padding: [12, 2]
            Text {
              text: notice != "" ? "✓ ${notice}" : lastErr != "" ? lastErr : syncMsg != "" ? syncMsg : offline ? "reading an imported export" : syncing ? "syncing…" : syncStalled ? "sync stalled" : syncFailed ? "sync failed" : lastSync == 0 ? "not synced yet" : fmtAgo(lastSync, now) == "now" ? "synced just now" : "synced ${fmtAgo(lastSync, now)} ago"
              style: small
              fontSize: 13
              color: notice != "" ? green : lastErr != "" || syncMsg != "" ? red : syncing ? accent : muted
              weight: 1
              maxLines: 2
            }
            if !offline {
              Text {
                text: "sync now"
                style: small
                fontSize: 14
                color: syncing ? muted : accent
                padding: [4, 6]
                onTap: {
                  if !syncing { notice = ""; lastErr = ""; syncAsk = syncAsk + 1; haptic() }
                }
              }
            }
          }
          if current != null && current.mode == "add" {
            Text { text: "saving the link…"; style: label; color: accent; padding: [12, 2, 12, 4]; maxLines: 1 }
          }
          // What the queue amounts to (or how many matches), how the list is ordered and
          // grouped, and the way to pick several. The first takes the free width, so the
          // row always fits on one line.
          Row {
            gap: 6
            padding: [12, 2, 12, 6]
            Text { text: typed != "" || query != "" ? "${len(seen)} found" : queue == [] ? "nothing to read" : "${len(queue)} · ${queueText}"; style: small; fontSize: 13; color: muted; weight: 1; maxLines: 1 }
            Text { text: sort == "-created" ? "newest" : sort == "created" ? "oldest" : sort == "title" ? "title" : sort == "length" ? "longest" : "shortest"; style: small; fontSize: 13; color: accent; padding: [2, 6]; width: 76; maxLines: 1; align: end; onTap: { sort = sort == "-created" ? "created" : sort == "created" ? "title" : sort == "title" ? "length" : sort == "length" ? "shortest" : "-created"; haptic() } }
            Text { text: group == "" ? "no group" : group; style: small; fontSize: 13; color: group == "" ? muted : accent; padding: [2, 6]; width: 84; maxLines: 1; align: end; onTap: { group = group == "" ? "day" : group == "day" ? "site" : group == "site" ? "label" : ""; haptic() } }
            Text { text: picking ? (picked == [] ? "picking" : "${len(picked)} picked") : "select"; style: small; fontSize: 13; color: picking ? orange : muted; padding: [2, 6]; width: 80; maxLines: 1; align: end; onTap: { picking = !picking; picked = []; notice = ""; haptic() } }
          }
          // What's picked, acted on together. One tap queues it for every pick, so the
          // rows change at once and only the server's refusals come back to retry.
          if picking {
            Row {
              gap: 6
              wrap: true
              padding: [12, 0, 12, 8]
              Button { text: "pick all"; color: muted; onTap: { picked = seen.map(x => x.id); haptic() } }
              Button { text: "archive"; color: muted; onTap: wants = wants + [toJson({mode: "bulk", ids: picked, json: "{\"is_archived\":true}", patch: {is_archived: true}})] }
              Button { text: "unarchive"; color: muted; onTap: wants = wants + [toJson({mode: "bulk", ids: picked, json: "{\"is_archived\":false}", patch: {is_archived: false}})] }
              Button { text: "favorite"; color: orange; onTap: wants = wants + [toJson({mode: "bulk", ids: picked, json: "{\"is_marked\":true}", patch: {is_marked: true}})] }
              Button { text: "unread"; color: muted; onTap: wants = wants + [toJson({mode: "bulk", ids: picked, json: "{\"read_progress\":0}", patch: {read_progress: 0}})] }
              Button { text: "read"; color: muted; onTap: wants = wants + [toJson({mode: "bulk", ids: picked, json: "{\"read_progress\":100}", patch: {read_progress: 100}})] }
              Button { text: "delete"; color: red; onTap: wants = wants + [toJson({mode: "bulk", ids: picked, json: "{\"is_deleted\":true}", patch: {is_deleted: true}})] }
              Button { text: "done"; color: muted; onTap: { picking = false; picked = [] } }
            }
          }
          // A link to save; without a server, where to put one.
          if offline {
            Row {
              gap: 8
              padding: [2, 10, 8, 10]
              align: center
              // A tap text, not a Button: a Button makes its whole row tall.
              Text { text: token == "" ? "no token set" : server == "" ? "no server set" : ""; style: small; color: muted; width: 250 }
              Text { text: "connect"; style: label; color: accent; padding: [4, 4]; onTap: { draftBase = base; draftToken = token; view = "setup"; haptic() } }
            }
          } else if showAdd {
            Row {
              gap: 8
              padding: [12, 3, 12, 10]
              align: center
              Input {
                text: newUrl
                placeholder: "save a link…"
                weight: 1
                onSubmit: {
                  let u = trim(value)
                  if u != "" {
                    newUrl = ""
                    notice = ""
                    wants = wants + [toJson({mode: "add", id: u})]
                    haptic()
                  }
                }
              }
              Button {
                text: "save"
                color: accent
                onTap: {
                  let u = trim(newUrl)
                  if u != "" {
                    newUrl = ""
                    notice = ""
                    wants = wants + [toJson({mode: "add", id: u})]
                    haptic()
                  }
                }
              }
            }
          }
          // The label whose bookmarks are on show, and the way back to all of them.
          if label != "" {
            Row {
              padding: [12, 0, 12, 8]
              gap: 8
              align: center
              Text { text: "label: ${label}"; style: small; color: accent; maxLines: 1; weight: 1 }
              Text { text: "all labels"; style: label; color: muted; padding: [4, 6]; onTap: { label = ""; view = "labels"; haptic() } }
            }
          }
          List { rows: rows; loading: len(all) == 0 }
        }
      }
    }
  }
}

