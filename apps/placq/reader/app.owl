app "Reader" {
  meta { owl: 11; description: "A quiet EPUB, MOBI and TXT reader with quotes, offline dictionaries, reading stats, OPDS catalogs and backups"; version: "3.0"; license: "MIT AND GPL-3.0-only"; category: "productivity" }
  // Reader draws its own header, so the window has no title row, and the page runs to the screen's
  // edges: no status bar, and under the navigation bar, which screenInset measures.
  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M24 13c-4-3-10-4-18-4v28c8 0 14 1 18 4 4-3 10-4 18-4V9c-8 0-14 1-18 4z"/>
    <path d="M24 13v28"/>
  </svg>"""
  requires { pacman: ["bash", "python", "python-beautifulsoup4", "python-requests", "python-pillow", "ttf-dejavu", "python-cryptography"] }

  // Self-contained source bundle: base64 + XZ-compressed JSON, not downloaded code.
  // Includes the full GPL-3.0 KindleUnpack sources and license; see README.md.
  let readerBootstrap = "import base64,fcntl,hashlib,json,lzma,os,re,subprocess,sys,tempfile\nfrom pathlib import Path,PurePosixPath\ndigest = \"df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00\"\nmanifest_digest = \"a5aac654a9b4253a7f396b0cfc18cebb76824f2ba7c956a02bba5c2159327acc\"\n# The launcher runs a command as one shell argument, which Linux caps at 128 KiB, so the\n# bundle comes in parts: python -c <this> <part number> <parts> <base64 part>.\nindex,count,part = int(sys.argv[1]),int(sys.argv[2]),sys.argv[3]\nif not 1 <= index <= count <= 8 or not re.fullmatch(r\"[A-Za-z0-9+/=]+\",part):\n    raise ValueError(\"Invalid embedded Reader sources\")\nbase = Path.home()/\".local/share/owl-reader-store\"\nbase.mkdir(parents=True,exist_ok=True)\ndest = base/digest\nwith (base/\"install.lock\").open(\"w\") as lock:\n    fcntl.flock(lock,fcntl.LOCK_EX)\n    parts = [base/f\"{digest}.part{i}\" for i in range(1,count+1)]\n    if not dest.exists():\n        with tempfile.NamedTemporaryFile(\"w\",dir=base,delete=False) as handle:\n            handle.write(part)\n        os.replace(handle.name,parts[index-1])\n        if not all(p.exists() and not p.is_symlink() for p in parts):\n            print(json.dumps(dict(ok=True,installed=False)))\n            sys.exit()\n    encoded = \"\".join(p.read_text() for p in parts) if not dest.exists() else None\n    if encoded is not None:\n        decoder = lzma.LZMADecompressor(memlimit=64*1024*1024)\n        raw = decoder.decompress(base64.b64decode(encoded,validate=True),max_length=2*1024*1024)\n        if not decoder.eof or decoder.unused_data or hashlib.sha256(raw).hexdigest()!=digest:\n            for p in parts: p.unlink(missing_ok=True)\n            raise ValueError(\"Invalid embedded Reader sources\")\n        files = json.loads(raw)\n        with tempfile.TemporaryDirectory(prefix=\"install-\",dir=base) as temporary:\n            stage = Path(temporary)/\"sources\"\n            stage.mkdir()\n            for name,content in files.items():\n                relative = PurePosixPath(name)\n                if relative.is_absolute() or \"..\" in relative.parts or \"\\\\\" in name:\n                    raise ValueError(\"Invalid embedded source path\")\n                path = stage/name\n                path.parent.mkdir(parents=True,exist_ok=True)\n                path.write_text(content,encoding=\"utf-8\")\n            (stage/\"MANIFEST.json\").write_text(json.dumps({n:hashlib.sha256(c.encode()).hexdigest() for n,c in files.items()},sort_keys=True),encoding=\"utf-8\")\n            stage.rename(dest)\n        for p in parts: p.unlink(missing_ok=True)\n    # Every later start checks the installed sources against the manifest written from the verified bundle.\n    listed = (dest/\"MANIFEST.json\").read_text(encoding=\"utf-8\")\n    if (dest/\"MANIFEST.json\").is_symlink() or hashlib.sha256(listed.encode()).hexdigest()!=manifest_digest:\n        raise ValueError(\"Installed Reader sources were modified\")\n    manifest = json.loads(listed)\n    for name,sha in manifest.items():\n        path = dest/name\n        if path.is_symlink() or hashlib.sha256(path.read_text(encoding=\"utf-8\").encode()).hexdigest()!=sha:\n            raise ValueError(\"Installed Reader sources were modified\")\nsubprocess.run([sys.executable,str(dest/\"reader.py\"),\"snapshot\"],check=True,stdout=subprocess.DEVNULL)\nprint(json.dumps(dict(ok=True,installed=True)))\n"
  // Two halves, one run each: the launcher hands a command to the shell as one argument, which Linux caps at 128 KiB.
  let readerBundle = ""
  let readerBundleRest = ""
  // Installed by triggers, not a source: a source would run the bootstrap again after every run() below.
  // An update keeps state values, so the install is tied to the bundle's digest: a new one installs again.
  let readerDigest = "df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00"
  state installStep = null
  state installStarted = 0
  state installation = null
  state installedFor = ""
  let installed = installedFor == readerDigest && parseJson(installation).installed == true
  when installedFor != readerDigest {
    installStep = null
    installation = null
    installedFor = readerDigest
    installStarted = now ?? 0
    installStep = run("python -c ${sh(readerBootstrap)} 1 2 ${sh(readerBundle)}")
  }
  on installStep first { if parseJson(installStep).ok == true { installation = run("python -c ${sh(readerBootstrap)} 2 2 ${sh(readerBundleRest)}") } }
  // A failed or lost try (Linux still starting, say): try again after a minute.
  every 30s { if !installed && (now ?? 0) - installStarted > 60 { installedFor = "" } }

  // The backend publishes a bounded view; the complete journal stays local.
  source data = file("~/.local/state/owl-reader-store/view.json") json
  source operation = file("~/.local/state/owl-reader-store/job.json") json
  source now = clock every 1s
  state pane = "read"
  state showReadingClock = false persist
  state tab = "local"
  state settingsTab = "reading"
  state queryText = ""
  state folderText = ""
  state catalogName = ""
  state catalogUrl = ""
  state loginUrl = ""
  state task = null
  state viewTask = null
  state checkpointTask = null
  state busy = false
  state pageText = ""
  state readingPage = null persist
  state cursorLayout = "" persist
  state checkpointEvent = 0 persist
  state prefetching = false
  state prefetchTask = null
  state requestedAnchor = ""
  state preferredTheme = null
  state themeSaveAt = 0
  state deleteBook = ""
  state statusBook = ""
  state libraryFilter = "all"
  state typographyDraft = null
  state bookQuery = ""
  state noteBook = ""
  state noteText = ""
  state removeMark = ""
  state selectionAnchor = null
  state selectionEnd = null
  state selectionMenu = false
  state selectionExtending = false
  state quoteNote = ""
  state editingQuote = ""
  state removeQuote = ""
  state translateMenu = false
  state lookupText = ""
  state translationLanguage = "pl" persist
  state translationCode = ""
  state dictionaryQuery = ""
  state dictionaryPath = ""
  state removeDictionary = ""
  state dictionaryDownloadError = ""
  state uiError = ""
  state removeCatalog = ""
  state backupPath = ""
  state confirmRestore = false
  state confirmCache = false
  state confirmCredentialReset = false
  state viewEvent = 0
  state libraryQueryAt = 0
  state handledOperation = "" persist
  state goalDraft = null
  state goalSaveAt = 0
  let installingWordnet = operation.status == "running" && operation.action == "dictionary-install"
  let working = busy || operation.status == "running"
  let dictionaryReady = (data.dictionaries ?? []).any(d => d.id == (data.dictionaryId ?? "wordnet-en") && d.ready)
  let translationLanguages = [{code: "pl", name: "Polish"}, {code: "en", name: "English"}, {code: "de", name: "German"}, {code: "fr", name: "French"}, {code: "es", name: "Spanish"}, {code: "it", name: "Italian"}, {code: "pt", name: "Portuguese"}, {code: "uk", name: "Ukrainian"}, {code: "cs", name: "Czech"}, {code: "sk", name: "Slovak"}, {code: "ru", name: "Russian"}, {code: "nl", name: "Dutch"}, {code: "sv", name: "Swedish"}, {code: "tr", name: "Turkish"}, {code: "ar", name: "Arabic"}, {code: "ja", name: "Japanese"}, {code: "ko", name: "Korean"}, {code: "zh-CN", name: "Chinese (simplified)"}, {code: "zh-TW", name: "Chinese (traditional)"}]
  let translationName = translationLanguages.find(language => lower(language.code) == lower(translationLanguage)).name ?? translationLanguage
  let readingBook = pane == "read" ? data.current.id : null
  let currentPage = cursorLayout == data.layoutKey ? (readingPage ?? data.page ?? 0) : (data.page ?? 0)
  let windowEnd = (data.windowStart ?? 0) + len(data.pageWindow ?? [])
  let needsPages = data.current && ((currentPage < (data.windowStart ?? 0) + 8 && (data.windowStart ?? 0) > 0) || (currentPage >= windowEnd - 8 && windowEnd < data.total))
  let prefetchAnchor = "${data.layoutKey}:${floor(currentPage / 8)}"
  let pageLines = data.pageWindow[currentPage - (data.windowStart ?? 0)].lines ?? data.lines ?? []
  let pageInfo = data.pageWindow[currentPage - (data.windowStart ?? 0)]
  let selectionStart = min(selectionAnchor, selectionEnd)
  let selectionStop = max(selectionAnchor, selectionEnd)
  let selectedWords = selectionAnchor != null ? flatten(pageInfo.runs ?? []).filter(w => w[3] > selectionStart && w[2] <= selectionStop) : []
  let selectedFrom = selectedWords.first()[2]
  let selectedTo = selectedWords.last()[3]
  let selectedText = len(selectedWords) > 0 ? sub(pageInfo.text, selectedFrom - pageInfo.offset, selectedTo - pageInfo.offset) : ""
  let visibleQuotes = (data.quoteRanges ?? []).filter(q => q.offset < pageInfo.end && q.end > pageInfo.offset)
  let minutesLeft = data.paceLearned ? ceil((pageInfo.wordsRemaining ?? 0) / max(data.effectiveWpm, 1)) : null
  let timeLeft = !data.paceLearned ? "Learning your reading pace…" : pageInfo.wordsRemaining == null ? "Estimating reading time…" : minutesLeft >= 60 ? "~${floor(minutesLeft / 60)}h ${minutesLeft % 60}m left in book" : "~${minutesLeft} min left in book"
  let pageMarked = (data.bookmarkRanges ?? data.activeBookmarks ?? []).any(m => m.offset >= pageInfo.offset && m.offset < pageInfo.end)
  let libraryBooks = (data.books ?? []).filter(b => contains(lower(b.title + " " + b.author), lower(queryText)) && (libraryFilter == "all" || (data.statuses[b.id] ?? (b.id == data.current.id || num(data.positions[b.id], 0) > 0 ? "reading" : "new")) == libraryFilter)).sortBy(b => b.id == data.current.id ? 0 : 1)
  let typography = typographyDraft ?? {typeface: data.typeface ?? "serif", alignment: data.alignment ?? "left", paragraph: data.paragraph ?? 1, font: data.font ?? 20, spacing: data.spacing ?? 1.55, margin: data.margin ?? 24}
  let previewFont = typography.typeface == "sans" ? "/usr/share/fonts/TTF/DejaVuSans.ttf" : "/usr/share/fonts/TTF/DejaVuSerif.ttf"
  let activeTheme = preferredTheme ?? data.theme ?? "paper"
  let paper = activeTheme == "night" ? #171b20 : activeTheme == "sepia" ? #efe3cb : #f7f4ec
  let ink = activeTheme == "night" ? #e0dfd8 : #282c30
  let soft = activeTheme == "night" ? #929b9f : #7c7c72
  let tint = activeTheme == "night" ? #9bbdb4 : #45675d
  let card = activeTheme == "night" ? #22292e : activeTheme == "sepia" ? #e5d7bb : #eeece3
  // An app has no tile: screenWidth and screenHeight are its whole view, and the paginator leaves screenInset for the navigation bar.
  let pageHeight = int(screenHeight ?? 800)
  let geometry = "${int(screenWidth ?? 400)} ${int(pageHeight)} ${int(screenInset ?? 0)}"
  // The header also loads the local font for Canvas's line renderer.
  let readingFont = data.typeface == "sans" ? "/usr/share/fonts/TTF/DejaVuSans.ttf" : "/usr/share/fonts/TTF/DejaVuSerif.ttf"
  // Reading area geometry, shared by drawing and word hit-testing.
  let lineHeight = (data.font ?? 20) * (data.spacing ?? 1.55)
  let textLeft = ((screenWidth ?? 400) - min(screenWidth ?? 400, 760)) / 2 + (data.margin ?? 24) + 2
  // Panes reached from the library tabs; the book icon toggles them.
  let inLibrary = ["library", "bookmarks", "quotes", "dictionaries", "stats"].indexOf(pane) >= 0
  let stats = data.readingStats
  let goal = goalDraft ?? stats.goal ?? 20
  let paneTitles = {login: "Sign in", settings: "Settings", contents: "Contents", search: "Search book", progress: "Progress", "quote-note": "Quote note", dictionary: "Dictionary", stats: "Reading stats"}

  let readyGeometry = installed ? geometry : null
  on readyGeometry first {
    if installed && (screenInset ?? 0) < 120 {
      run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py layout ${int(screenWidth ?? 400)} ${int(pageHeight)} ${int(screenInset ?? 0)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}")
    }
  }
  on task first {
    busy = false
    if parseJson(task).ok == false { uiError = parseJson(task).error ?? "Operation failed. Please retry." }
    else { uiError = "" }
    if parseJson(task).authRequired != null {
      loginUrl = parseJson(task).authRequired
      pane = "login"
    } else if parseJson(task).ok == true && pane == "login" {
      pane = "library"
      tab = "catalogs"
    }
    if parseJson(task).ok == false && pane == "read" { pane = "library" }
    if parseJson(task).dictionaryRequired == true { pane = "dictionaries" }
  }
  on viewTask first { if parseJson(value).ok == false { uiError = parseJson(value).error ?? "Cannot load saved data." } }
  on checkpointTask first { if parseJson(value).ok == false { uiError = parseJson(value).error ?? "Reading position could not be saved." } }
  on operation first {
    if value.status != "running" && value.id != handledOperation {
      handledOperation = value.id
      if value.authRequired != null && value.status == "failed" { loginUrl = value.authRequired; pane = "login" }
      else if value.status == "failed" { uiError = value.error ?? value.label ?? "Operation failed. Please retry." }
    }
  }
  every 5s { if operation.status == "running" { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-status") } }
  // Waits for the install, so the first view is asked for once the backend is there.
  let readyPane = installed ? pane : null
  on readyPane first {
    viewEvent = max(viewEvent + 1, (data.viewEvent ?? 0) + 1, (now ?? 0) * 1000)
    viewTask = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py view ${sh(value)} ${int(viewEvent)}")
    run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-status")
    removeDictionary = ""
    translateMenu = false
    selectionMenu = false
    selectionExtending = false
    if value == "settings" { folderText = data.folder }
    if value != "settings" && typographyDraft != null {
      busy = true
      task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py typography ${sh(toJson(typographyDraft))} ${int(currentPage)} ${sh(data.layoutKey ?? "")}")
      typographyDraft = null
    }
  }
  when data.viewSection == null && data.revision != null {
    viewEvent = max(viewEvent + 1, (now ?? 0) * 1000)
    viewTask = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py view ${sh(pane)} ${int(viewEvent)}")
  }
  on queryText { libraryQueryAt = (now ?? 0) + 1 }
  on libraryFilter { libraryQueryAt = (now ?? 0) + 1 }
  at libraryQueryAt {
    libraryQueryAt = 0
    run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py library-query ${sh(queryText)} ${sh(libraryFilter)}")
  }
  on currentPage { selectionAnchor = null; selectionEnd = null; selectionMenu = false; selectionExtending = false }
  on data.layoutKey { selectionAnchor = null; selectionEnd = null; selectionMenu = false; selectionExtending = false }
  on data.navigation first {
    if data.navigation != null {
      readingPage = data.page ?? 0
      cursorLayout = data.layoutKey ?? ""
    }
  }
  // Every page turn immediately queues a durable, ordered checkpoint.
  when needsPages && !prefetching && requestedAnchor != prefetchAnchor {
    prefetching = true
    requestedAnchor = prefetchAnchor
    prefetchTask = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py prefetch")
  }
  on prefetchTask first { prefetching = false }
  on readingBook first {
    if readingBook != null {
      run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py begin-reading ${sh(readingBook)}")
    }
  }
  on data.theme { if data.theme == preferredTheme { preferredTheme = null } }
  // Goal taps settle for a second before one save; the view brings the new goal back.
  at goalSaveAt {
    goalSaveAt = 0
    if goalDraft != null { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py setting dailyGoal ${int(goalDraft)}") }
  }
  on stats.goal { if stats.goal == goalDraft { goalDraft = null } }
  at themeSaveAt {
    themeSaveAt = 0
    if preferredTheme != null {
      run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py setting theme ${sh(preferredTheme)}")
    }
  }

  component Label(label) {
    Text { text: label; font: sans; fontSize: 10; letterSpacing: 1.2; fontWeight: 500; color: soft }
  }

  // Fixed-width navigation buttons, shared by Library and Settings. Handlers
  // live on the enclosing Boxes so the entire button is a touch target.
  component NavTab(label, selected = false) {
    Column {
      fill: width
      gap: 0
      background: selected ? alpha(tint, 0.06) : alpha(paper, 0)
      Text {
        text: label
        font: sans
        fontSize: 13
        fontWeight: selected ? 500 : 400
        align: center
        fill: width
        minLines: 1
        padding: [6, 12]
        color: selected ? tint : ink
      }
      Box { fill: width; height: 2; background: selected ? tint : alpha(ink, 0.1) }
    }
  }

  component ListPager(cursor, offsetValue, totalCount, shown) {
    Row {
      visible: totalCount > shown
      gap: 8
      Button { text: "←"; color: tint; onTap: { if offsetValue > 0 { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py list-page ${sh(cursor)} ${max(0, offsetValue - max(shown, 1))}") } } }
      Text { text: "${offsetValue + 1}–${min(offsetValue + shown, totalCount)} / ${totalCount}"; font: sans; fontSize: 12; color: soft; weight: 1; align: center }
      Button { text: "→"; color: tint; onTap: { if offsetValue + shown < totalCount { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py list-page ${sh(cursor)} ${int(offsetValue + max(shown, 1))}") } } }
    }
  }

  component SettingsIcon() {
    Box {
      size: 44
      onTap: { pane = pane == "settings" ? "read" : "settings"; folderText = data.folder }
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let teeth = range(48).map(i => [cx + sin(rad(i * 7.5)) * (i % 6 == 0 || i % 6 == 5 ? 9 : 12), cy - cos(rad(i * 7.5)) * (i % 6 == 0 || i % 6 == 5 ? 9 : 12)])
        path(teeth, closed: true, stroke: pane == "settings" ? tint : soft, width: 1.8)
        circle(cx, cy, 3.5, stroke: pane == "settings" ? tint : soft, width: 1.8)
      }
    }
  }

  component ThemeIcon() {
    Box {
      size: 44
      onTap: {
        preferredTheme = activeTheme == "paper" ? "sepia" : activeTheme == "sepia" ? "night" : "paper"
        themeSaveAt = (now ?? 0) + 1
      }
      Canvas {
        let cx = width / 2
        let cy = height / 2
        if activeTheme == "night" {
          circle(cx, cy, 10, fill: tint)
          circle(cx + 5, cy - 4, 9, fill: paper)
        } else if activeTheme == "sepia" {
          circle(cx, cy, 10, stroke: tint, width: 1.8)
          line(cx - 6, cy - 4, cx + 6, cy - 4, stroke: tint, width: 1.5, cap: round)
          line(cx - 7, cy, cx + 7, cy, stroke: tint, width: 1.5, cap: round)
          line(cx - 6, cy + 4, cx + 6, cy + 4, stroke: tint, width: 1.5, cap: round)
        } else {
          circle(cx, cy, 6, stroke: tint, width: 1.8)
          for i in range(8) {
            rotate(i * 45, cx, cy) { line(cx, cy - 13, cx, cy - 10, stroke: tint, width: 1.8, cap: round) }
          }
        }
      }
    }
  }

  // An app takes no background of its own, so the whole view sits on the page colour.
  Column {
    fill: true
    background: paper
  if !installed {
    Column {
      fill: true
      justify: center
      padding: 32
      Text { text: "Preparing Reader…"; font: serif; fontSize: 30; color: ink }
      Text { text: "Installing the bundled offline reader and MOBI extractor. If this remains visible, check the launcher errors and required packages."; fontSize: 14; color: soft }
    }
  } else {
  Column {
    fill: true
    gap: 0
    if uiError != "" || (data.error ?? "") != "" {
      Text { text: "${uiError != "" ? uiError : data.error}\nTap to dismiss"; font: sans; fontSize: 12; color: red; background: card; padding: [24, 12]; maxLines: 5; onTap: { uiError = ""; run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dismiss") } }
    }
    if operation.status == "running" {
      Row {
        padding: [24, 8]
        Text { text: operation.total > 0 ? "${operation.label} · ${round(operation.done / operation.total * 100)}%" : operation.label; font: sans; fontSize: 12; color: tint; weight: 1 }
        Text { text: "Cancel"; font: sans; fontSize: 12; color: tint; padding: 8; onTap: task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-cancel") }
      }
    }
    if pane == "read" {
      Row {
        height: 44
        padding: [12, 0]
        align: center
        gap: 4
        Column {
          weight: 1
          gap: 2
          onTap: { if data.current { pane = "contents" } }
          Text { text: data.current ? data.current.title : "READER"; font: readingFont; fontSize: 11; letterSpacing: 1; color: soft; maxLines: 1 }
          if data.current { Text { text: selectionExtending ? "Extend: tap the last word" : pageInfo.chapterTitle ?? "Contents"; fontSize: 10; color: selectionExtending ? tint : soft; maxLines: 1 } }
          Popup {
            width: min(340, (screenWidth ?? 400) - 32)
            visible: selectionMenu && selectedText != ""
            onDismiss: { selectionMenu = false; selectionExtending = false }
            Column {
              background: card
              padding: 14
              gap: 8
              Text { text: selectedText; color: ink; font: serif; fontSize: 15; maxLines: 3 }
              Text { text: "Choose Extend, then tap the last word."; color: soft; fontSize: 11 }
              Flow {
                gap: 8
                Text { text: "Translate…"; color: tint; padding: [8, 12]; onTap: { lookupText = selectedText; selectionMenu = false; translateMenu = true } }
                Text { text: "Save quote"; color: tint; padding: [8, 12]; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py quote-save ${int(selectedFrom)} ${int(selectedTo)} '' ${sh(data.current.id)}"); selectionAnchor = null; selectionEnd = null; selectionMenu = false } }
                Text { text: "Note"; color: tint; padding: [8, 12]; onTap: { quoteNote = ""; editingQuote = ""; pane = "quote-note" } }
                Text { text: "Extend"; color: tint; padding: [8, 12]; onTap: { selectionMenu = false; selectionExtending = true } }
                Text { text: "Copy"; color: tint; padding: [8, 12]; onTap: { copy(selectedText); selectionMenu = false } }
                Text { text: "Clear"; color: soft; padding: [8, 12]; onTap: { selectionAnchor = null; selectionEnd = null; selectionMenu = false } }
              }
            }
          }
        }
        if data.current {
          Box {
            size: 44
            onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py bookmark-toggle _ ${int(currentPage)} ${sh(data.layoutKey ?? "")}")
            Canvas {
              path([[16, 12], [28, 12], [28, 32], [22, 27], [16, 32]], closed: true, stroke: tint, width: 1.6, fill: pageMarked ? tint : paper)
            }
          }
        }
      }
      if data.current {
        Canvas {
          weight: 1
          fill: width
          onLongPress: {
            let rowIndex = floor((y - 10) / lineHeight)
            let localX = x - textLeft
            let hit = (pageInfo.runs[rowIndex] ?? []).sortBy(w => abs(w[0] + w[1] / 2 - localX)).first()
            if hit != null {
              selectionAnchor = hit[2]
              selectionEnd = hit[2]
              selectionMenu = true
              selectionExtending = false
              run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py pause-reading")
              haptic()
            }
          }
          onTap: {
            if selectionAnchor != null {
              if selectionExtending {
              let rowIndex = floor((y - 10) / lineHeight)
              let localX = x - textLeft
              let hit = (pageInfo.runs[rowIndex] ?? []).sortBy(w => abs(w[0] + w[1] / 2 - localX)).first()
              if hit != null { selectionEnd = hit[2]; selectionMenu = true; selectionExtending = false }
              } else {
                selectionAnchor = null
                selectionEnd = null
                selectionMenu = false
              }
            } else {
            let next = clamp(currentPage + (x < (screenWidth ?? 400) / 2 ? -1 : 1), 0, max(data.total - 1, 0))
            if data.pageWindow[next - (data.windowStart ?? 0)] != null {
              readingPage = next
              cursorLayout = data.layoutKey
              checkpointEvent = max(checkpointEvent + 1, (data.lastCheckpointEvent ?? 0) + 1, (now ?? 0) * 1000)
              checkpointTask = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py checkpoint ${int(next)} ${sh(data.layoutKey ?? "")} ${int(checkpointEvent)}")
            }
            }
          }
          for line, i in pageLines {
            let runs = pageInfo.runs[i] ?? []
            if len(runs) > 0 {
              // A word is [x, width, offset, end]; its text comes from the page's text.
              for word in runs {
                let selected = selectionAnchor != null && word[3] > selectionStart && word[2] <= selectionStop
                if selected || visibleQuotes.any(q => q.offset < word[3] && q.end > word[2]) {
                  rect(textLeft + word[0] - 1, 10 + i * lineHeight, word[1] + 2, lineHeight, fill: alpha(tint, selected ? 0.35 : 0.15), radius: 2)
                }
                text(sub(pageInfo.text, word[2] - pageInfo.offset, word[3] - pageInfo.offset), textLeft + word[0], 10 + (i + 0.5) * lineHeight, size: data.font ?? 20, font: readingFont, color: ink)
              }
            } else {
              text(line, textLeft, 10 + (i + 0.5) * lineHeight, size: data.font ?? 20, font: readingFont, color: ink)
            }
          }
        }
      } else {
        Column {
          weight: 1
          padding: [32, 16]
          justify: center
          gap: 20
          Text { text: "A little space\nfor a good book."; font: serif; fontSize: 38; color: ink }
          Text { text: "Open an EPUB, MOBI or TXT from your library, or find your next read in a free catalog."; font: sans; fontSize: 15; color: soft }
          Button { text: "Choose a book"; color: tint; onTap: { pane = "library"; tab = "local" } }
          Text { text: "Your books folder\n${data.folder ?? "~/Books"}"; fontSize: 12; color: soft }
        }
      }
    } else {
      Row {
        padding: [24, 16]
        align: center
        Text { text: paneTitles[pane] ?? "Library"; font: serif; fontSize: 26; color: ink; weight: 1 }
        Text { text: "Done"; fontSize: 14; color: tint; padding: 10; onTap: pane = "read" }
      }
      if busy { Text { text: "Working…"; color: tint; fontSize: 12; padding: [24, 4] } }
      if data.message != "" && data.message != null {
        Text { text: data.message; fontSize: 13; color: ink; background: card; padding: [24, 12]; onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dismiss") }
      }
      if inLibrary {
        Column {
          padding: [24, 4, 24, 16]
          gap: 8
          Row {
            gap: 8
            Box { weight: 1; onTap: { pane = "library"; tab = "local"; queryText = "" }; NavTab { label: "Books"; selected: pane == "library" && tab == "local" } }
            Box { weight: 1; onTap: { pane = "library"; tab = "catalogs"; queryText = "" }; NavTab { label: "OPDS"; selected: pane == "library" && tab == "catalogs" } }
            Box { weight: 1; onTap: pane = "bookmarks"; NavTab { label: "Bookmarks"; selected: pane == "bookmarks" } }
          }
          Row {
            gap: 8
            Box { weight: 1; onTap: pane = "quotes"; NavTab { label: "Quotes"; selected: pane == "quotes" } }
            Box { weight: 1; onTap: pane = "dictionaries"; NavTab { label: "Dictionaries"; selected: pane == "dictionaries" } }
            Box { weight: 1; onTap: pane = "stats"; NavTab { label: "Stats"; selected: pane == "stats" } }
          }
        }
      }
      if pane == "dictionary" {
        Column {
          weight: 1
          gap: 12
          padding: [24, 12]
          Text { text: data.dictionaryName ?? "WordNet 3.0 · English"; color: soft; fontSize: 12 }
          Row {
            Input { text: dictionaryQuery; placeholder: "Word or short phrase"; color: ink; weight: 1; onChange: dictionaryQuery = value; onSubmit: { if !busy && trim(dictionaryQuery) != "" { lookupText = trim(dictionaryQuery); busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dictionary-lookup ${sh(lookupText)}") } } }
            Button { text: "Look up"; color: tint; onTap: { if !busy && trim(dictionaryQuery) != "" { lookupText = trim(dictionaryQuery); busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dictionary-lookup ${sh(lookupText)}") } } }
          }
          Flow {
            gap: 14
            Text { text: "Google Translate → ${translationName}"; color: tint; fontSize: 12; padding: [0, 10]; onTap: { if trim(dictionaryQuery) != "" { url("https://translate.google.com/?sl=auto&tl=${enc(translationLanguage)}&text=${enc(dictionaryQuery)}&op=translate") } } }
            Text { text: "Change dictionary"; color: tint; fontSize: 12; padding: [0, 10]; onTap: pane = "dictionaries" }
          }
          Column {
            weight: 1
            lazy: true
            gap: 14
            if !busy && data.dictionaryResult.query == lookupText {
              Text { text: data.dictionaryResult.word; font: serif; fontSize: 28; color: ink }
              if !data.dictionaryResult.found {
                Text { text: "No entry found. Try the base form of a word, choose another dictionary, or use Google for a longer passage."; color: soft; fontSize: 15 }
              }
              for entry, i in data.dictionaryResult.entries ?? [] {
                Column {
                  background: card
                  padding: 16
                  gap: 8
                  Text { text: "${i + 1}. ${entry.headword}${entry.pos != "" ? " · " + entry.pos : ""}"; color: tint; fontSize: 13; bold: true }
                  Text { text: entry.definition; color: ink; font: serif; fontSize: 17 }
                }
              }
              if data.dictionaryResult.truncated { Text { text: "Showing the first 30 definitions."; color: soft; fontSize: 12 } }
            } else if !busy {
              Text { text: "Look up a word offline. WordNet explains English words in English; use Google for translations to ${translationName} and whole passages."; color: soft; fontSize: 15 }
            }
          }
        }
      } else if pane == "dictionaries" {
        Column {
          weight: 1
          scroll: true
          gap: 14
          padding: [24, 12]
          Text { text: "Offline dictionaries"; font: serif; fontSize: 22; color: ink }
          Text { text: "Select the dictionary used by Translate → Dictionary. Download the free English–English WordNet dictionary, or import your own. Nothing is downloaded automatically."; font: sans; fontSize: 13; color: soft }
          if !dictionaryReady { Text { text: "No dictionary is ready to use. Download WordNet or import and select your own below."; color: tint; fontSize: 13 } }
          if dictionaryDownloadError != "" { Text { text: dictionaryDownloadError; color: red; fontSize: 13 } }
          for dictionary in data.dictionaries ?? [] key dictionary.name + dictionary.path {
            Column {
              padding: 16
              background: card
              border: dictionary.ready && dictionary.id != "" && dictionary.id == data.dictionaryId ? 1 : 0
              borderColor: alpha(tint, 0.35)
              gap: 8
              Text { text: dictionary.name; color: ink; font: serif; fontSize: 19 }
              Text { text: "${fmtNum(dictionary.count)} entries · ${!dictionary.ready ? (dictionary.id == "wordnet-en" ? "Not downloaded" : "Not imported") : dictionary.id != "" && dictionary.id == data.dictionaryId ? "Selected" : "Available offline"}"; font: sans; color: soft; fontSize: 12 }
              if dictionary.path != "" { Text { text: dictionary.path; font: sans; color: soft; fontSize: 11; maxLines: 3 } }
              if dictionary.ready {
                Text { text: dictionary.id == data.dictionaryId ? "Selected ✓" : "Use dictionary"; color: tint; padding: [0, 10]; onTap: { if !working { busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dictionary-select ${sh(dictionary.id)}") } } }
                if dictionary.id == "wordnet-en" { Text { text: "Verify / repair WordNet"; font: sans; fontSize: 12; color: tint; padding: [0, 10]; onTap: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start dictionary-install") } } } }
                Text { text: "Remove dictionary…"; font: sans; color: red; fontSize: 13; padding: [0, 10]; onTap: { if !working { removeDictionary = dictionary.id } } }
                if removeDictionary == dictionary.id {
                  Text { text: dictionary.id == "wordnet-en" ? "Remove the downloaded WordNet dictionary? You can download it again. Your books and reading progress will not be changed." : "Remove the imported dictionary copy? The original StarDict files, books and reading progress will not be changed."; color: ink; fontSize: 13 }
                  Flow {
                    gap: 12
                    Button { text: "Cancel"; color: tint; onTap: removeDictionary = "" }
                    Button { text: "Remove"; color: red; onTap: { if !working { busy = true; dictionaryDownloadError = ""; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dictionary-remove ${sh(dictionary.id)}"); removeDictionary = "" } } }
                  }
                }
              } else if dictionary.id == "wordnet-en" {
                Text { text: "Free · 10.8 MB download · works offline after installation"; color: soft; fontSize: 12 }
                Button { text: installingWordnet ? "Downloading and installing…" : "Download / repair WordNet"; color: tint; onTap: { if !working { dictionaryDownloadError = ""; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start dictionary-install") } } }
              } else if dictionary.path != "" {
                Text { text: "Import and use"; color: tint; padding: [0, 10]; onTap: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start dictionary-import ${sh(dictionary.path)}") } } }
              }
            }
          }
          if dictionaryReady { Button { text: "Open dictionary"; color: tint; onTap: { dictionaryQuery = ""; lookupText = ""; pane = "dictionary" } } }
          if dictionaryReady && trim(lookupText) != "" { Button { text: "Look up selected text →"; color: tint; onTap: { dictionaryQuery = lookupText; pane = "dictionary"; busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dictionary-lookup ${sh(lookupText)}") } } }
          Label { label: "ADD YOUR OWN" }
          Text { text: "Copy an unpacked StarDict dictionary into ${data.folder}/Dictionaries and refresh. Keep its .ifo, .idx (or .idx.gz), .dict (or .dict.dz), and optional .syn files together."; font: sans; color: soft; fontSize: 13 }
          Text { text: "Or enter the full path to a StarDict .ifo file:"; font: sans; color: soft; fontSize: 12 }
          Input { text: dictionaryPath; placeholder: "~/Books/Dictionaries/example.ifo"; color: ink; fontSize: 13; onChange: dictionaryPath = value }
          Flow {
            gap: 12
            Button { text: "Import and use"; color: tint; onTap: { if !working && trim(dictionaryPath) != "" { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start dictionary-import ${sh(trim(dictionaryPath))}") } } }
            Button { text: "Refresh"; color: tint; onTap: { if !busy { busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py scan") } } }
          }
          Text { text: "Text StarDict dictionaries only; no MDX, DRM or audio-only entries. Imported dictionaries are copied locally and remain available if the original files are moved."; font: sans; color: soft; fontSize: 12 }
          Text { text: "WordNet 3.0 © Princeton University · License"; color: tint; fontSize: 12; padding: [0, 10]; onTap: url("https://wordnet.princeton.edu/license-and-commercial-use") }
        }
      } else if pane == "quote-note" {
        Column {
          scroll: true
          weight: 1
          padding: 24
          gap: 16
          Text { text: editingQuote != "" ? (data.activeQuotes ?? []).find(q => q.id == editingQuote).text : selectedText; font: serif; fontSize: 18; color: ink }
          Input { text: quoteNote; placeholder: "Your note"; color: ink; onChange: quoteNote = value }
          Button { text: "Save"; color: tint; onTap: {
            if editingQuote != "" { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py quote-note ${sh(editingQuote)} ${sh(quoteNote)} ${sh(data.current.id)}") }
            else { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py quote-save ${int(selectedFrom)} ${int(selectedTo)} ${sh(quoteNote)} ${sh(data.current.id)}") }
            pane = "quotes"
            selectionAnchor = null
            selectionEnd = null
          } }
        }
      } else if pane == "quotes" {
        Column {
          lazy: true
          weight: 1
          padding: [24, 12]
          gap: 12
          Text { text: data.current ? "Quotes from ${data.current.title}" : "Open a book first."; color: soft; fontSize: 13 }
          if len(data.activeQuotes ?? []) > 0 {
            Flow {
              gap: 12
              Button { text: "Export .md"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py quote-export ${sh(data.current.id)}") }
            }
          }
          for quote in data.activeQuotes ?? [] key quote.id {
            Column {
              background: card
              padding: 16
              gap: 12
              Text { text: quote.text; font: serif; fontSize: 17; color: ink; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py goto-offset ${int(quote.offset)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}"); pane = "read" } }
              if quote.note != "" { Text { text: quote.note; color: soft; fontSize: 13 } }
              Flow {
                gap: 14
                Text { text: "Note"; color: tint; padding: [0, 10]; onTap: { editingQuote = quote.id; quoteNote = quote.note; pane = "quote-note" } }
                Text { text: "Translate…"; color: tint; padding: [0, 10]; onTap: { lookupText = quote.text; translateMenu = true } }
                Text { text: "Share"; color: tint; padding: [0, 10]; onTap: share("> " + replace(quote.text, "\n", "\n> ") + (quote.note != "" ? "\n\n" + quote.note : "")) }
                Text { text: "Delete"; color: soft; padding: [0, 10]; onTap: removeQuote = quote.id }
              }
              if removeQuote == quote.id {
                Text { text: "Delete this quote and its note?"; color: ink; fontSize: 13 }
                Row {
                  Button { text: "Cancel"; color: tint; onTap: removeQuote = "" }
                  Button { text: "Delete"; color: red; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py quote-delete ${sh(quote.id)} ${sh(data.current.id)}"); removeQuote = "" } }
                }
              }
            }
          }
          if (data.quoteCount ?? 0) > (data.quoteShown ?? 5) {
            Flow {
              gap: 12
              if data.quoteStart > 0 { Button { text: "← Previous"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py quote-page ${max(0, data.quoteStart - 5)}") } }
              Text { text: "${data.quoteStart + 1}–${int(data.quoteStart + data.quoteShown)} / ${data.quoteCount}"; color: soft; fontSize: 12; padding: [0, 12] }
              if data.quoteStart + data.quoteShown < data.quoteCount { Button { text: "Next →"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py quote-page ${int(data.quoteStart + data.quoteShown)}") } }
            }
          }
          if len(data.activeQuotes ?? []) == 0 { Text { text: "Hold a word while reading. Choose Extend to select a longer passage, then save a quote."; color: soft; fontSize: 14 } }
        }
      } else if pane == "contents" {
        Column {
          lazy: true
          weight: 1
          padding: [24, 12]
          gap: 6
          for chapter, i in data.contents ?? [] key chapter.offset {
            Text {
              text: chapter.title
              font: serif
              fontSize: 18
              padding: [16 + min(chapter.depth, 3) * 12, 14, 16, 14]
              background: i + (data.chapterStart ?? 0) == pageInfo.chapter ? card : paper
              color: i + (data.chapterStart ?? 0) == pageInfo.chapter ? tint : ink
              onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py goto-offset ${int(chapter.offset)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}"); pane = "read" }
            }
          }
          ListPager { cursor: "chapterStart"; offsetValue: data.chapterStart ?? 0; totalCount: data.chapterCount ?? 0; shown: len(data.contents ?? []) }
        }
      } else if pane == "bookmarks" {
        Column {
          lazy: true
          weight: 1
          gap: 12
          padding: [24, 12]
          Text { text: data.current ? "Bookmarks in ${data.current.title}" : "Open a book to use bookmarks."; fontSize: 13; color: soft }
          Text { text: "Save a place using the bookmark icon above the page."; fontSize: 12; color: soft }
          for mark in data.activeBookmarks ?? [] key mark.id {
            Column {
              background: card
              padding: 16
              gap: 10
              Text { text: "${round(mark.offset / max(data.bookStats[data.current.id].length, 1) * 100)}% · ${mark.chapterTitle ?? "Bookmark"}"; fontSize: 12; color: tint; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py goto-offset ${int(mark.offset)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}"); pane = "read" } }
              Text { text: mark.excerpt; font: serif; fontSize: 16; color: ink; maxLines: 4; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py goto-offset ${int(mark.offset)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}"); pane = "read" } }
              if noteBook == mark.id {
                Input { text: noteText; placeholder: "Your note"; color: ink; onChange: noteText = value }
                Button { text: "Save note"; color: tint; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py bookmark-note ${sh(mark.id)} ${sh(noteText)}"); noteBook = "" } }
              } else {
                if mark.note != "" { Text { text: mark.note; fontSize: 13; color: soft } }
                Row {
                  Text { text: "Note"; color: tint; fontSize: 13; padding: [0, 10]; onTap: { noteBook = mark.id; noteText = mark.note } }
                  Spacer { weight: 1 }
                  Text { text: "Delete"; color: soft; fontSize: 13; padding: [0, 10]; onTap: removeMark = mark.id }
                }
              }
              if removeMark == mark.id {
                Text { text: "Delete this bookmark?"; fontSize: 13; color: ink }
                Row {
                  Button { text: "Cancel"; color: tint; onTap: removeMark = "" }
                  Button { text: "Delete"; color: red; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py bookmark-note ${sh(mark.id)} __delete__"); removeMark = "" } }
                }
              }
            }
          }
          ListPager { cursor: "bookmarkStart"; offsetValue: data.bookmarkStart ?? 0; totalCount: data.bookmarkCount ?? 0; shown: len(data.activeBookmarks ?? []) }
          if len(data.activeBookmarks ?? []) == 0 { Text { text: "No bookmarks yet."; color: soft; padding: [0, 24] } }
        }
      } else if pane == "search" {
        Row {
          padding: [24, 4]
          Input { text: bookQuery; placeholder: "Word or phrase"; color: ink; weight: 1; onChange: bookQuery = value; onSubmit: { busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py book-search ${sh(bookQuery)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}") } }
          Button { text: "Search"; color: tint; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py book-search ${sh(bookQuery)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}") } }
        }
        Column {
          lazy: true
          weight: 1
          gap: 10
          padding: [24, 12]
          if (data.searchQuery ?? "") != "" { Text { text: "${data.searchCount ?? 0}${data.searchCount == 200 ? "+" : ""} results · ${data.searchQuery}"; color: soft; fontSize: 12 } }
          for result in data.searchResults ?? [] key result.offset {
            Column {
              background: card
              padding: 16
              gap: 8
              onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py goto-offset ${int(result.offset)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}"); pane = "read" }
              Text { text: result.chapter; color: tint; fontSize: 12 }
              Text { spans: ["…" + result.before, {text: result.match, bold: true, color: tint}, result.after + "…"]; color: ink; font: serif; fontSize: 16 }
            }
          }
          if (data.searchQuery ?? "") != "" && len(data.searchResults ?? []) == 0 { Text { text: "No matching passages found."; color: soft } }
          ListPager { cursor: "searchStart"; offsetValue: data.searchStart ?? 0; totalCount: data.searchCount ?? 0; shown: len(data.searchResults ?? []) }
        }
      } else if pane == "stats" {
        Column {
          scroll: true
          weight: 1
          padding: [24, 8, 24, 24]
          gap: 18
          if stats == null {
            Text { text: "Counting your reading…"; color: soft; fontSize: 13 }
          } else if stats.error != null {
            Text { text: stats.error; color: red; fontSize: 13 }
          } else {
            // Today against the daily goal.
            Column {
              gap: 8
              Label { label: "TODAY" }
              Row {
                align: end
                gap: 8
                Text { text: "${stats.today}"; font: serif; fontSize: 40; color: ink }
                Text { text: "of ${goal} min"; color: soft; fontSize: 14; padding: [0, 0, 0, 8] }
                Box { weight: 1 }
                Text { text: stats.today >= goal ? "Goal reached" : "${goal - stats.today} min to go"; color: tint; fontSize: 13; padding: [0, 0, 0, 8] }
              }
              Canvas {
                fill: width
                height: 6
                rect(0, 0, width, 6, fill: alpha(ink, 0.1), radius: 3)
                rect(0, 0, width * min(stats.today / max(goal, 1), 1), 6, fill: tint, radius: 3)
              }
              Text { text: stats.todayPages > 0 ? "${stats.todayPages} pages · ~${stats.todayWords} words" : "Nothing read yet today."; color: soft; fontSize: 12 }
            }
            Row {
              gap: 8
              for item in [{label: "STREAK", value: "${stats.streak}", unit: stats.streak == 1 ? "day" : "days"}, {label: "BEST", value: "${stats.bestStreak}", unit: stats.bestStreak == 1 ? "day" : "days"}, {label: "THIS WEEK", value: "${stats.week}", unit: "min"}] {
                Column {
                  weight: 1
                  gap: 2
                  padding: 12
                  background: card
                  Label { label: item.label }
                  Text { text: item.value; font: serif; fontSize: 24; color: ink }
                  Text { text: item.unit; color: soft; fontSize: 11 }
                }
              }
            }
            // The last two weeks, with the goal as a dashed line.
            Column {
              gap: 6
              Label { label: "LAST 14 DAYS · GOAL MET ${stats.goalDays}×" }
              Canvas {
                fill: width
                height: 150
                let top = max(goal, stats.days.map(d => d.minutes).sort().last() ?? 0, 1)
                let chartHeight = height - 22
                let slot = width / max(len(stats.days), 1)
                let goalY = chartHeight - goal / top * chartHeight
                for d, i in stats.days {
                  let barHeight = d.minutes > 0 ? max(3, d.minutes / top * chartHeight) : 0
                  if barHeight > 0 {
                    rect(i * slot + slot * 0.18, chartHeight - barHeight, slot * 0.64, barHeight, fill: d.minutes >= goal ? tint : alpha(tint, 0.45), radius: 3)
                  }
                  text(d.weekday, i * slot + slot / 2, height - 8, size: 11, color: d.today ? tint : soft, align: center)
                }
                for k in range(int(width / 8)) {
                  line(k * 8, goalY, k * 8 + 4, goalY, stroke: alpha(ink, 0.35), width: 1)
                }
              }
            }
            Column {
              gap: 8
              Label { label: "DAILY GOAL" }
              Row {
                gap: 12
                align: center
                Button { text: "−"; color: tint; onTap: { goalDraft = max(5, goal - 5); goalSaveAt = (now ?? 0) + 1 } }
                Text { text: "${goal} min a day"; color: ink; fontSize: 15; weight: 1; align: center }
                Button { text: "+"; color: tint; onTap: { goalDraft = min(240, goal + 5); goalSaveAt = (now ?? 0) + 1 } }
              }
            }
            Column {
              gap: 6
              Label { label: "ALL TIME" }
              Text { text: "${stats.totalHours} h over ${stats.readingDays} ${stats.readingDays == 1 ? "day" : "days"} · ${stats.dailyAverage} min on an average reading day"; color: ink; fontSize: 14 }
              Text { text: "~${stats.totalWords} words · this month ${stats.month} min · ${stats.finished} ${stats.finished == 1 ? "book" : "books"} finished${data.paceLearned ? " · ${data.effectiveWpm} words/min" : ""}"; color: soft; fontSize: 12 }
            }
            if len(stats.books) > 0 {
              Column {
                gap: 8
                Label { label: "MOST READ" }
                for b in stats.books {
                  Row {
                    gap: 8
                    Text { text: b.title; color: ink; fontSize: 14; weight: 1; maxLines: 1 }
                    Text { text: b.minutes >= 60 ? "${b.hours} h" : "${b.minutes} min"; color: soft; fontSize: 13 }
                  }
                }
              }
            }
            Text { text: "Counted from your page turns: pauses over 5 minutes, jumps, skimming and paging back don't count."; color: soft; fontSize: 11 }
          }
        }
      } else if pane == "progress" {
        Column {
          weight: 1
          padding: 24
          gap: 20
          Text { text: pageInfo.chapterTitle; font: serif; fontSize: 24; color: ink }
          Text { text: "${currentPage + 1} / ${data.total} · ${round((currentPage + 1) / max(data.total, 1) * 100)}%"; color: soft }
          Text { text: timeLeft; color: tint; fontSize: 18 }
          Text { text: data.paceLearned ? "Based on your reading · ${data.effectiveWpm} words/min" : "Read a few pages normally to estimate the time remaining."; color: soft; fontSize: 12 }
          Slider { value: currentPage + 1; min: 1; max: max(data.total, 2); step: 1; color: tint; onChange: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py jump ${int(value)}"); pane = "read" } }
          Row {
            Input { text: pageText; placeholder: "Page number"; color: ink; weight: 1; onChange: pageText = value }
            Button { text: "Go"; color: tint; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py jump ${int(num(pageText, 1))}"); pane = "read" } }
          }
          Text { text: "Page numbers depend on your font and spacing settings."; color: soft; fontSize: 13 }
          Text { text: "Reading stats →"; color: tint; fontSize: 14; padding: [0, 8]; onTap: pane = "stats" }
        }
      } else if pane == "login" {
        Column {
          scroll: true
          weight: 1
          gap: 16
          padding: [24, 12]
          Label { label: "OPDS ACCOUNT" }
          Text { text: loginUrl; fontSize: 12; color: soft }
          Text { text: "Sign in in a terminal with a hidden password prompt. Your password never enters this view or a shell command. Return here after saving and retry the catalog."; font: sans; fontSize: 14; color: ink }
          Button { text: "Secure sign-in →"; color: tint; onTap: terminal("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py login ${sh(loginUrl)}") }
          Text { text: "Credentials are encrypted locally; the separate key stays on this device. Other processes running as root can still access them. Use a dedicated OPDS account."; font: sans; fontSize: 12; color: soft }
          Button { text: "Retry catalog"; color: tint; onTap: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start catalog ${sh(loginUrl)}"); pane = "library"; tab = "catalogs" } } }
          Button { text: "Forget saved login"; color: tint; onTap: task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py credentials-remove ${sh(loginUrl)}") }
          Text { text: "Reset credential storage…"; font: sans; color: red; fontSize: 12; padding: [0, 10]; onTap: confirmCredentialReset = true }
          if confirmCredentialReset {
            Text { text: "Reset all saved catalog logins and the local key? Use this only if credentials cannot be decrypted. Original files are preserved privately; every private catalog will need sign-in again."; font: sans; fontSize: 12; color: ink }
            Row {
              Button { text: "Cancel"; color: tint; onTap: confirmCredentialReset = false }
              Button { text: "Reset logins"; color: red; onTap: { confirmCredentialReset = false; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py credentials-reset") } }
            }
          }
          Text { text: "Cancel"; color: tint; padding: [0, 12]; onTap: { settingsTab = "opds"; pane = "settings" } }
        }
      } else if pane == "settings" {
        Column {
          weight: 1
          gap: 0
          Column {
            padding: [24, 4, 24, 16]
            gap: 8
            Row {
              gap: 8
              Box { weight: 1; onTap: settingsTab = "reading"; NavTab { label: "Reading"; selected: settingsTab == "reading" } }
              Box { weight: 1; onTap: settingsTab = "files"; NavTab { label: "Files"; selected: settingsTab == "files" } }
              Box { weight: 1; onTap: settingsTab = "opds"; NavTab { label: "OPDS"; selected: settingsTab == "opds" } }
            }
            Box { fill: width; onTap: { settingsTab = "translation"; translationCode = translationLanguage }; NavTab { label: "Translation"; selected: settingsTab == "translation" } }
          }
          if settingsTab == "reading" {
          Column {
            scroll: true
            weight: 1
            gap: 16
            padding: [24, 12]
          Text { text: "Text appearance"; font: serif; fontSize: 22; color: ink }
          Text { text: "A little space for a good book. The quiet morning brings a new chapter."; font: previewFont; fontSize: typography.font; color: ink; background: card; padding: 16 }
          Text { text: "Preview changes instantly. Switch tabs freely; pages update once when you leave Settings."; font: sans; fontSize: 12; color: soft }
          Label { label: "TYPEFACE" }
          Row {
            gap: 8
            for faceName in ["serif", "sans"] {
              Box { weight: 1; onTap: typographyDraft = merge(typography, {typeface: faceName}); NavTab { label: faceName == "serif" ? "Serif" : "Sans serif"; selected: typography.typeface == faceName } }
            }
          }
          Label { label: "ALIGNMENT" }
          Row {
            gap: 8
            for alignmentName in ["left", "justify"] {
              Box { weight: 1; onTap: typographyDraft = merge(typography, {alignment: alignmentName}); NavTab { label: alignmentName == "left" ? "Left" : "Justified"; selected: typography.alignment == alignmentName } }
            }
          }
          Label { label: "PARAGRAPH SPACING" }
          Row {
            gap: 8
            for paragraphSize in [0, 1, 2] {
              Box { weight: 1; onTap: typographyDraft = merge(typography, {paragraph: paragraphSize}); NavTab { label: paragraphSize == 0 ? "Small" : paragraphSize == 1 ? "Medium" : "Large"; selected: typography.paragraph == paragraphSize } }
            }
          }
          Row {
            align: center
            Text { text: "Text size"; color: ink; weight: 1 }
            Button { text: "−"; color: tint; onTap: typographyDraft = merge(typography, {font: max(14, typography.font - 1)}) }
            Text { text: "${typography.font}"; color: ink }
            Button { text: "+"; color: tint; onTap: typographyDraft = merge(typography, {font: min(32, typography.font + 1)}) }
          }
          Text { text: "Line spacing · ${fixed(typography.spacing, 2)}"; color: soft; fontSize: 13 }
          Slider { value: typography.spacing; min: 1.2; max: 2; step: 0.05; color: tint; onChange: typographyDraft = merge(typography, {spacing: value}) }
          Text { text: "Margins · ${typography.margin}"; color: soft; fontSize: 13 }
          Slider { value: typography.margin; min: 12; max: 48; step: 4; color: tint; onChange: typographyDraft = merge(typography, {margin: value}) }
          Spacer { height: 12 }
          }
          } else if settingsTab == "translation" {
          Column {
            scroll: true
            weight: 1
            gap: 16
            padding: [24, 12]
            Text { text: "Google Translate"; font: serif; fontSize: 22; color: ink }
            Text { text: "Choose the target language for all Google Translate links. The source language is detected automatically. Offline dictionaries are not affected."; font: sans; fontSize: 13; color: soft }
            Text { text: "Translate to: ${translationName}"; font: sans; fontSize: 15; color: tint }
            Text { text: "Saved automatically · requires internet"; font: sans; fontSize: 12; color: soft }
            Flow {
              gap: 8
              for language in translationLanguages {
                Text {
                  text: language.name
                  font: sans
                  fontSize: 13
                  color: lower(translationLanguage) == lower(language.code) ? tint : ink
                  background: lower(translationLanguage) == lower(language.code) ? alpha(tint, 0.1) : card
                  padding: [12, 12]
                  onTap: { translationLanguage = language.code; translationCode = language.code }
                }
              }
            }
            Label { label: "ANOTHER LANGUAGE" }
            Text { text: "Enter a Google Translate language code, for example fi (Finnish), hi (Hindi) or pt-PT (European Portuguese)."; font: sans; fontSize: 12; color: soft }
            Row {
              gap: 8
              Input { text: translationCode; placeholder: "Language code"; color: ink; weight: 1; onChange: translationCode = value }
              Button { text: "Apply"; color: tint; onTap: { if match(trim(translationCode), "^[A-Za-z]{2,3}(-[A-Za-z]{2,4})?$") != null { translationLanguage = trim(translationCode) } } }
            }
            if trim(translationCode) != "" && match(trim(translationCode), "^[A-Za-z]{2,3}(-[A-Za-z]{2,4})?$") == null { Text { text: "Enter a language code such as pl, en or zh-CN."; font: sans; fontSize: 12; color: red } }
          }
          } else if settingsTab == "files" {
          Column {
            scroll: true
            weight: 1
            gap: 16
            padding: [24, 12]
          Text { text: "Local files"; font: serif; fontSize: 22; color: ink }
          Text { text: "Choose where Reader looks for books. This changes the library location; it does not move or delete your files."; font: sans; fontSize: 13; color: soft }
          Column {
            padding: 16
            background: card
            gap: 12
            Label { label: "BOOKS FOLDER" }
            Input { text: folderText; placeholder: "~/Books"; color: ink; fontSize: 14; onChange: folderText = value }
            Button { text: "Use folder"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py folder ${sh(folderText)}") }
          }
          Text { text: "Missing folders are created. EPUB, MOBI and TXT files directly inside this folder appear in your library."; font: sans; color: soft; fontSize: 12 }
          Label { label: "RELATED TOOLS" }
          Button { text: "Manage offline dictionaries →"; color: tint; onTap: pane = "dictionaries" }
          Text { text: "Dictionary downloads, imports and removal live in Library → Dictionaries."; font: sans; color: soft; fontSize: 12 }
          Label { label: "BACKUP & RECOVERY" }
          Text { text: "Back up positions, notes, quotes and settings. Backups do not contain books, passwords or encryption keys. Copy the saved file off this device."; font: sans; color: soft; fontSize: 12 }
          Button { text: "Create backup"; color: tint; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py backup-create") } }
          if (data.lastBackup ?? "") != "" { Text { text: data.lastBackup; font: sans; fontSize: 11; color: soft } }
          Input { text: backupPath; placeholder: "Full path to Reader backup.json"; color: ink; fontSize: 13; onChange: { backupPath = value; confirmRestore = false } }
          Button { text: "Restore backup…"; color: tint; onTap: { if trim(backupPath) != "" && !working { confirmRestore = true } } }
          if confirmRestore {
            Text { text: "Replace saved notes, positions and settings? A recovery copy of current data will be saved first. Books are not deleted."; font: sans; fontSize: 13; color: ink }
            Row {
              Button { text: "Cancel"; color: tint; onTap: confirmRestore = false }
              Button { text: "Restore"; color: red; onTap: { confirmRestore = false; busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py backup-restore ${sh(trim(backupPath))}") } }
            }
          }
          Label { label: "CACHE & APPLICATION" }
          Text { text: "Cache · ${fmtBytes(data.cacheBytes ?? 0)}"; font: sans; fontSize: 13; color: soft }
          Button { text: "Measure cache"; color: tint; onTap: task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py cache-info") }
          Button { text: "Clear unused cache…"; color: tint; onTap: confirmCache = true }
          if confirmCache {
            Text { text: "Remove unused layouts, feeds and thumbnails? Books, notes and the active page cache will be kept."; font: sans; fontSize: 13; color: ink }
            Row {
              Button { text: "Cancel"; color: tint; onTap: confirmCache = false }
              Button { text: "Clear"; color: red; onTap: { confirmCache = false; busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py cache-clear") } }
            }
          }
          }
          } else if settingsTab == "opds" {
          Column {
            scroll: true
            weight: 1
            gap: 16
            padding: [24, 12]
          Text { text: "OPDS catalogs"; font: serif; fontSize: 22; color: ink }
          Text { text: "Manage online book sources here. Browse and download books in Library → OPDS."; font: sans; fontSize: 13; color: soft }
          Button { text: "Browse catalogs →"; color: tint; onTap: { pane = "library"; tab = "catalogs" } }
          Label { label: "YOUR CATALOGS" }
          for c in data.catalogs ?? [] key c.url {
            Column {
              padding: 12
              background: card
              gap: 6
              Text { text: c.name; color: ink; font: sans; fontSize: 15; bold: true }
              Text { text: c.url; color: soft; font: sans; fontSize: 11 }
              Text { text: "Secure sign-in →"; color: tint; font: sans; fontSize: 12; padding: [0, 8]; onTap: { loginUrl = c.url; pane = "login" } }
              Text { text: "Remove catalog…"; color: red; font: sans; fontSize: 12; padding: [0, 8]; onTap: removeCatalog = c.url }
              if removeCatalog == c.url {
                Text { text: "Remove this catalog and its saved login? Downloaded books will be kept."; font: sans; fontSize: 13; color: ink }
                Row {
                  Button { text: "Cancel"; color: tint; onTap: removeCatalog = "" }
                  Button { text: "Remove"; color: red; onTap: { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py catalog-remove ${sh(c.url)}"); removeCatalog = "" } }
                }
              }
            }
          }
          Label { label: "ADD CATALOG" }
          Input { text: catalogName; placeholder: "Catalog name"; color: ink; fontSize: 14; onChange: catalogName = value }
          Input { text: catalogUrl; placeholder: "https://example.org/opds"; color: ink; fontSize: 14; onChange: catalogUrl = value }
          Button { text: working ? "Working…" : "Add catalog"; color: tint; onTap: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start catalog-add ${sh(catalogName)} ${sh(catalogUrl)}") } } }
          Text { text: "OPDS 1 and 2 catalogs. Sign-in appears only when the server requires it. Web sign-in, SSO and DRM are not supported."; font: sans; color: soft; fontSize: 12 }
          Spacer { height: 20 }
          }
          }
        }
      } else {
        if tab == "local" {
          Row {
            padding: [24, 4]
            align: center
            Input { text: queryText; placeholder: "Find a title or author"; fontSize: 14; color: ink; weight: 1; onChange: queryText = value }
            Text { text: "Refresh"; color: tint; fontSize: 12; padding: 10; onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py scan") }
          }
          Flow {
            padding: [24, 4]
            gap: 6
            for filterName in ["all", "reading", "new", "done"] {
              Text { text: filterName == "all" ? "All" : filterName == "reading" ? "Reading" : filterName == "new" ? "New" : "Finished"; font: sans; fontSize: 12; color: libraryFilter == filterName ? tint : ink; background: libraryFilter == filterName ? alpha(tint, 0.1) : alpha(paper, 0); border: 0; radius: 4 * corners; padding: [10, 8]; onTap: libraryFilter = filterName }
            }
          }
          Column {
            lazy: true
            weight: 1
            gap: 10
            padding: [24, 12]
            for b in libraryBooks key b.id {
              let status = data.statuses[b.id] ?? (b.id == data.current.id || num(data.positions[b.id], 0) > 0 ? "reading" : "new")
              Column {
                padding: 16
                background: b.id == data.current.id ? mix(card, tint, 0.08) : card
                border: b.id == data.current.id ? 1 : 0
                borderColor: alpha(tint, 0.3)
                radius: 8 * corners
                gap: 7
                Row {
                  gap: 14
                  onTap: { if deleteBook != b.id { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py open ${sh(b.id)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}"); busy = true; pane = "read" } }
                  Box {
                    width: 56
                    height: 84
                    Image { src: b.cover; width: 56; height: 84; visible: (b.cover ?? "") != ""; fit: cover; label: b.title }
                    Box { width: 56; height: 84; visible: (b.cover ?? "") == ""; background: mix(card, tint, 0.15); padding: 6; align: center; Text { text: b.title; font: serif; fontSize: 11; maxLines: 4; color: tint; align: center } }
                  }
                  Column {
                    weight: 1
                    gap: 7
                    Text { text: b.title; font: serif; fontSize: 19; color: ink; maxLines: 3 }
                    Text { text: b.author == "" ? b.format : "${b.author} · ${b.format}"; color: soft; fontSize: 12; maxLines: 2 }
                    if data.bookStats[b.id] != null {
                      Progress { value: data.bookStats[b.id].percent; fill: width; height: 2; color: tint; track: alpha(tint, 0.12) }
                      Text { text: "${data.bookStats[b.id].percent}%"; color: soft; fontSize: 10 }
                    }
                    if b.id == data.current.id { Text { text: "Continue →"; color: tint; fontSize: 12 } }
                  }
                }
                Row {
                  align: center
                  Text { text: status == "reading" ? "Reading" : status == "done" ? "Finished" : "New"; color: soft; fontSize: 11; weight: 1 }
                  Box {
                    width: 40
                    height: 40
                    Text { text: "⋮"; color: tint; fontSize: 20; align: center; padding: [0, 6]; onTap: { statusBook = b.id; deleteBook = "" } }
                    Popup {
                      width: 190
                      visible: statusBook == b.id
                      onDismiss: statusBook = ""
                      Column {
                        padding: 8
                        background: card
                        gap: 0
                        for choice in ["new", "reading", "done"] {
                          Text { text: "Mark as ${capitalize(choice)}"; color: choice == status ? tint : ink; fontSize: 14; padding: [16, 14]; onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py status ${sh(b.id)} ${sh(choice)}"); statusBook = "" } }
                        }
                        Text { text: "Delete book…"; color: red; fontSize: 14; padding: [16, 14]; onTap: { deleteBook = b.id; statusBook = "" } }
                      }
                    }
                  }
                }
                if deleteBook == b.id {
                  Column {
                    gap: 8
                    padding: 12
                    border: 1
                    borderColor: alpha(soft, 0.4)
                    Text { text: "Delete this book from your device? The file will be removed, but your saved bookmark will be kept."; color: ink; fontSize: 13 }
                    Row {
                      Text { text: "Cancel"; color: tint; fontSize: 13; padding: [12, 12]; onTap: deleteBook = "" }
                      Spacer { weight: 1 }
                      Text { text: "Delete file"; color: red; fontSize: 13; padding: [12, 12]; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py delete ${sh(b.id)}"); deleteBook = "" } }
                    }
                  }
                }
              }
            }
            // Until the backend answers for this screen, data.books isn't the library yet.
            if data.viewSection != "library" {
              Text { text: "Opening your library…"; color: soft; padding: [0, 20] }
            } else if len(data.books ?? []) == 0 {
              Text { text: "Your shelf is waiting."; font: serif; fontSize: 26; color: ink; padding: [0, 16] }
              Text { text: "Copy EPUB, MOBI or TXT files to ${data.folder}, or download a book from Catalogs."; fontSize: 14; color: soft }
            }
            if data.viewSection == "library" && len(data.books ?? []) > 0 && len(libraryBooks) == 0 { Text { text: "No books match these filters."; color: soft; padding: [0, 20] } }
            ListPager { cursor: "libraryStart"; offsetValue: data.libraryStart ?? 0; totalCount: data.libraryCount ?? 0; shown: len(data.books ?? []) }
          }
        } else {
          if data.feed {
            Row {
              align: center
              padding: [24, 4]
              Text { text: "‹ Back"; color: tint; padding: [0, 12]; onTap: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start feed-back") } } }
              Text { text: data.feed.title; fontSize: 14; color: ink; maxLines: 2; weight: 1 }
            }
            if data.feed.search != "" {
              Input { placeholder: "Search this catalog…"; color: ink; fontSize: 14; padding: [24, 4]; clear: true; onSubmit: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start search ${sh(value)}") } } }
            }
            Column {
              lazy: true
              weight: 1
              gap: 10
              padding: [24, 12]
              for e in data.feed.entries ?? [] key e.url {
                Column {
                  gap: 7
                  padding: 16
                  background: card
                  radius: 8 * corners
                  onTap: {
                    if !working {
                      if e.kind == "download" {
                        task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start download ${sh(e.url)} ${sh(e.title)} ${sh(e.format)}")
                      } else {
                        task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start browse ${sh(e.url)}")
                      }
                    }
                  }
                  Text { text: e.title; font: serif; fontSize: 19; color: ink }
                  if e.author != "" { Text { text: e.author; color: soft; fontSize: 12 } }
                  Text { text: e.kind == "download" ? "Download ${upper(e.format)}" : "Browse →"; color: tint; fontSize: 12 }
                }
              }
              if data.feed.next != "" {
                Button { text: "Next results"; color: tint; onTap: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start browse ${sh(data.feed.next)}") } } }
              }
              Text { text: "Public-domain rules vary by country. Check before downloading."; fontSize: 11; color: soft; padding: [0, 12] }
              ListPager { cursor: "feedStart"; offsetValue: data.feed.entryStart ?? 0; totalCount: data.feed.entryCount ?? 0; shown: len(data.feed.entries ?? []) }
            }
          } else {
            Column {
              scroll: true
              weight: 1
              gap: 12
              padding: [24, 16]
              Label { label: "FIND YOUR NEXT READ" }
              for c in data.catalogs ?? [] key c.url {
                Column {
                  gap: 10
                  padding: 20
                  background: card
                  radius: 8 * corners
                  onTap: { if !working { task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py job-start catalog ${sh(c.url)}") } }
                  Text { text: c.name; font: serif; fontSize: 24; color: ink }
                  // All five default sources include a short English description.
                  if (c.description ?? "") != "" { Text { text: c.description; color: soft; fontSize: 13 } }
                  Text { text: "Browse catalog →"; color: tint; fontSize: 13 }
                }
              }
              Button { text: "Manage catalogs →"; color: tint; onTap: { settingsTab = "opds"; pane = "settings" } }
              Text { text: "Add or remove sources in Settings → OPDS. Downloaded books stay in your local library and can be read offline."; font: sans; color: soft; fontSize: 13 }
            }
          }
        }
      }
    }

    if pane == "read" && data.current {
      if data.returnAnchor != null { Text { text: "← Return to previous place"; color: tint; fontSize: 12; padding: [24, 8]; onTap: run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py return-reading") } }
      Column {
        padding: [24, 0]
        gap: 4
        onTap: pane = "progress"
        Progress { value: (currentPage + 1) / max(data.total, 1) * 100; fill: width; height: 2; color: tint; track: alpha(tint, 0.15) }
        Row {
          Text { text: "${round((currentPage + 1) / max(data.total, 1) * 100)}%"; fontSize: 10; color: soft; weight: 1 }
          Text { text: timeLeft; fontSize: 10; color: soft }
        }
      }
    }
    Row {
      height: 56
      padding: [20, 0]
      align: center
      gap: 8
      Popup {
        width: min(340, (screenWidth ?? 400) - 32)
        position: above
        visible: translateMenu
        onDismiss: translateMenu = false
        Column {
          background: card
          padding: 18
          gap: 12
          Text { text: lookupText; color: ink; font: serif; fontSize: 17; maxLines: 3 }
          Text { text: "Translate with"; color: soft; fontSize: 12 }
          Column {
            padding: [8, 12]
            gap: 4
            onTap: {
              if !busy {
                translateMenu = false
                if dictionaryReady {
                  dictionaryQuery = lookupText
                  pane = "dictionary"
                  busy = true
                  task = run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py dictionary-lookup ${sh(lookupText)}")
                } else {
                  pane = "dictionaries"
                }
              }
            }
            Text { text: "Dictionary · offline"; color: tint; fontSize: 16; bold: true }
            Text { text: dictionaryReady ? (data.dictionaryName ?? "WordNet 3.0 · English") : "Set up an offline dictionary →"; color: soft; fontSize: 12 }
          }
          Column {
            padding: [8, 12]
            gap: 4
            onTap: { run("python ~/.local/share/owl-reader-store/df0ed84cd93f626345b1968cb78d9e76d720a96889f7eb88ef92c444ad1d7b00/reader.py pause-reading"); url("https://translate.google.com/?sl=auto&tl=${enc(translationLanguage)}&text=${enc(lookupText)}&op=translate"); translateMenu = false }
            Text { text: "Google Translate →"; color: tint; fontSize: 16; bold: true }
            Text { text: "Translate to ${translationName} · requires internet"; color: soft; fontSize: 12 }
          }
        }
      }
      Text {
        text: busy ? "Working…" : pane != "read" ? "Back to reading" : data.current ? (showReadingClock ? fmtTime(now, "HH:mm") : "${currentPage + 1}/${data.total}") : "READER"
        fontSize: 11
        letterSpacing: 0
        color: soft
        align: center
        weight: 1
        padding: [0, 12]
        onTap: { if pane == "read" && data.current && !busy { showReadingClock = !showReadingClock } else { pane = "read" } }
      }
      if data.current {
        Box {
          size: 44
          onTap: pane = "search"
          Canvas {
            circle(20, 19, 10, stroke: pane == "search" ? tint : soft, width: 2)
            line(27, 26, 35, 34, stroke: pane == "search" ? tint : soft, width: 2, cap: round)
          }
        }
      }
      SettingsIcon { }
      ThemeIcon { }
      Box {
        size: 48
        onTap: {
          if inLibrary {
            pane = "read"
          } else {
            pane = "library"
            queryText = ""
          }
        }
        Canvas {
          let cx = width / 2
          let cy = height / 2
          path([[cx, cy - 9], [cx - 6, cy - 12], [cx - 14, cy - 12], [cx - 14, cy + 9], [cx - 6, cy + 9], [cx, cy + 12], [cx + 6, cy + 9], [cx + 14, cy + 9], [cx + 14, cy - 12], [cx + 6, cy - 12], [cx, cy - 9]], stroke: pane == "library" || pane == "bookmarks" ? tint : soft, width: 2)
          line(cx, cy - 9, cx, cy + 12, stroke: pane == "library" || pane == "bookmarks" ? tint : soft, width: 2)
        }
      }
    }
    Spacer { height: screenInset }
  }
  }
  }
}
