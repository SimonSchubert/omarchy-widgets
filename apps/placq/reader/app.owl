app "Reader" {
  meta { owl: 14; description: "A quiet EPUB, MOBI and TXT reader with a local library, chapter navigation and OPDS catalogs"; version: "2.1"; license: "MIT AND GPL-3.0-only"; category: "productivity" }
  // Reader draws its own header, so the window has no title row, and the page runs to the screen's
  // edges: no status bar, and under the navigation bar, which screenInset measures.
  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M24 13c-4-3-10-4-18-4v28c8 0 14 1 18 4 4-3 10-4 18-4V9c-8 0-14 1-18 4z"/>
    <path d="M24 13v28"/>
  </svg>"""
  requires { pacman: ["bash", "python", "python-beautifulsoup4", "python-requests", "python-pillow", "ttf-dejavu"] }

  // Self-contained source bundle: base64 + XZ-compressed JSON, not downloaded code.
  // Includes the full GPL-3.0 KindleUnpack sources and license; see README.md.
  let readerBootstrap = "import base64,fcntl,hashlib,json,lzma,os,subprocess,sys,tempfile\nfrom pathlib import Path,PurePosixPath\ndigest = \"39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a\"\ndecoder = lzma.LZMADecompressor(memlimit=64*1024*1024)\nraw = decoder.decompress(base64.b64decode(sys.argv[1],validate=True),max_length=2*1024*1024)\nif not decoder.eof or decoder.unused_data or hashlib.sha256(raw).hexdigest()!=digest:\n    raise ValueError(\"Invalid embedded Reader sources\")\nfiles = json.loads(raw)\nbase = Path.home()/\".local/share/owl-reader-store\"\nbase.mkdir(parents=True,exist_ok=True)\ndest = base/digest\nwith (base/\"install.lock\").open(\"w\") as lock:\n    fcntl.flock(lock,fcntl.LOCK_EX)\n    if not dest.exists():\n        with tempfile.TemporaryDirectory(prefix=\"install-\",dir=base) as temporary:\n            stage = Path(temporary)/\"sources\"\n            stage.mkdir()\n            for name,content in files.items():\n                relative = PurePosixPath(name)\n                if relative.is_absolute() or \"..\" in relative.parts or \"\\\\\" in name:\n                    raise ValueError(\"Invalid embedded source path\")\n                path = stage/name\n                path.parent.mkdir(parents=True,exist_ok=True)\n                path.write_text(content,encoding=\"utf-8\")\n            stage.rename(dest)\n    for name,content in files.items():\n        path = dest/name\n        if path.is_symlink() or path.read_text(encoding=\"utf-8\")!=content:\n            raise ValueError(\"Installed Reader sources were modified\")\nsubprocess.run([sys.executable,str(dest/\"reader.py\"),\"snapshot\"],check=True,stdout=subprocess.DEVNULL)\nprint(json.dumps(dict(ok=True)))\n"
  let readerBundle = ""
  // Installed by a trigger, not a source: a source would run the bootstrap again after every run() below.
  // An update keeps state values, so the install is tied to the bundle's digest: a new one installs again.
  let readerDigest = "39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a"
  state installation = null
  state installedFor = ""
  let installed = installedFor == readerDigest && parseJson(installation).ok == true
  when installedFor != readerDigest {
    installation = null
    installedFor = readerDigest
    installation = run("python -c ${sh(readerBootstrap)} ${sh(readerBundle)}")
  }
  // A failed try (Linux still starting, say): try again in half a minute.
  every 30s { if installedFor == readerDigest && installation != null && !installed { installedFor = "" } }

  source data = file("~/.local/state/owl-reader-store/state.json") json
  source now = clock every 1s
  state pane = "read"
  state tab = "local"
  state queryText = ""
  state folderText = ""
  state catalogName = ""
  state catalogUrl = ""
  state task = null
  state busy = false
  state pageText = ""
  state readingPage = null
  state cursorLayout = ""
  state saveAt = 0
  state prefetching = false
  state prefetchTask = null
  state requestedAnchor = ""
  state preferredTheme = null
  state themeSaveAt = 0
  state deleteBook = ""
  state statusBook = ""
  let readingBook = pane == "read" ? data.current.id : null
  let currentPage = cursorLayout == data.layoutKey ? (readingPage ?? data.page ?? 0) : (data.page ?? 0)
  let windowEnd = (data.windowStart ?? 0) + len(data.pageWindow ?? [])
  let needsPages = data.current && ((currentPage < (data.windowStart ?? 0) + 8 && (data.windowStart ?? 0) > 0) || (currentPage >= windowEnd - 8 && windowEnd < data.total))
  let prefetchAnchor = "${data.layoutKey}:${floor(currentPage / 8)}"
  let pageLines = data.pageWindow[currentPage - (data.windowStart ?? 0)].lines ?? data.lines ?? []
  let chapters = data.chapters ?? []
  let chapterIndex = clamp(int(data.chapterIndex ?? 0), 0, max(len(chapters) - 1, 0))
  let chapterTitle = len(chapters) > 0 ? (chapters[chapterIndex].title ?? data.current.title) : data.current ? data.current.title : "READER"
  let activeTheme = preferredTheme ?? data.theme ?? "paper"
  let paper = activeTheme == "night" ? #171b20 : activeTheme == "sepia" ? #efe3cb : #f7f4ec
  let ink = activeTheme == "night" ? #e0dfd8 : #282c30
  let soft = activeTheme == "night" ? #929b9f : #7c7c72
  let tint = activeTheme == "night" ? #9bbdb4 : #45675d
  let card = activeTheme == "night" ? #22292e : activeTheme == "sepia" ? #e5d7bb : #eeece3
  // An app has no tile: screenWidth and screenHeight are its whole view, and the paginator leaves screenInset for the navigation bar.
  // statusBar: false runs the view to the top edge; keep the header clear of a cutout and the corner curve.
  let topGap = max(screenTop ?? 0, 16)
  let pageHeight = int(screenHeight ?? 800) - topGap
  let geometry = "${int(screenWidth ?? 400)} ${int(pageHeight)} ${int(screenInset ?? 0)}"
  // The header also loads the local font for Canvas's line renderer.
  let readingFont = "/usr/share/fonts/TTF/DejaVuSerif.ttf"

  let readyGeometry = installed ? geometry : null
  on readyGeometry first {
    if installed && (screenInset ?? 0) < 120 {
      run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py layout ${int(screenWidth ?? 400)} ${int(pageHeight)} ${int(screenInset ?? 0)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}")
    }
  }
  on task first {
    busy = false
    if parseJson(task).ok == false && pane == "read" { pane = "library" }
  }
  on data.navigation first {
    if data.navigation != null {
      readingPage = data.page ?? 0
      cursorLayout = data.layoutKey ?? ""
      saveAt = 0
    }
  }
  // Taps only change local state. Coalesce progress writes after a short pause.
  at saveAt {
    saveAt = 0
    run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py checkpoint ${int(currentPage)} ${sh(data.layoutKey ?? "")}")
  }
  when needsPages && !prefetching && requestedAnchor != prefetchAnchor {
    prefetching = true
    requestedAnchor = prefetchAnchor
    prefetchTask = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py checkpoint ${int(currentPage)} ${sh(data.layoutKey ?? "")}")
  }
  on prefetchTask first { prefetching = false }
  on readingBook first {
    if readingBook != null {
      run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py begin-reading ${sh(readingBook)}")
    }
  }
  on data.theme { if data.theme == preferredTheme { preferredTheme = null } }
  at themeSaveAt {
    themeSaveAt = 0
    if preferredTheme != null {
      run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py setting theme ${sh(preferredTheme)}")
    }
  }

  component Label(label) {
    Text { text: label; font: sans; fontSize: 11; letterSpacing: 1.5; bold: true; color: soft }
  }

  component SettingsIcon() {
    Box {
      size: 44
      onTap: { pane = pane == "settings" ? "read" : "settings"; folderText = data.folder }
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let teeth = range(48).map(i => [cx + sin(rad(i * 7.5)) * (i % 6 == 0 || i % 6 == 5 ? 9 : 12), cy - cos(rad(i * 7.5)) * (i % 6 == 0 || i % 6 == 5 ? 9 : 12)])
        path(teeth, closed: true, stroke: pane == "settings" ? tint : soft, width: 1.8)
        circle(cx, cy, 3.5, stroke: pane == "settings" ? tint : soft, width: 1.8)
      }
    }
  }

  component ThemeIcon() {
    Box {
      size: 44
      onTap: {
        preferredTheme = activeTheme == "paper" ? "sepia" : activeTheme == "sepia" ? "night" : "paper"
        themeSaveAt = (now ?? 0) + 1
      }
      Canvas {
        let cx = width / 2
        let cy = height / 2
        if activeTheme == "night" {
          circle(cx, cy, 10, fill: tint)
          circle(cx + 5, cy - 4, 9, fill: paper)
        } else if activeTheme == "sepia" {
          circle(cx, cy, 10, stroke: tint, width: 1.8)
          line(cx - 6, cy - 4, cx + 6, cy - 4, stroke: tint, width: 1.5, cap: round)
          line(cx - 7, cy, cx + 7, cy, stroke: tint, width: 1.5, cap: round)
          line(cx - 6, cy + 4, cx + 6, cy + 4, stroke: tint, width: 1.5, cap: round)
        } else {
          circle(cx, cy, 6, stroke: tint, width: 1.8)
          for i in range(8) {
            rotate(i * 45, cx, cy) { line(cx, cy - 13, cx, cy - 10, stroke: tint, width: 1.8, cap: round) }
          }
        }
      }
    }
  }

  // An app takes no background of its own, so the whole view sits on the page colour.
  Column {
    fill: true
    background: paper
    padding: [0, topGap, 0, 0]
  if !installed {
    Column {
      fill: true
      justify: center
      padding: 32
      Text { text: "Preparing Reader…"; font: serif; fontSize: 30; color: ink }
      Text { text: "Installing the bundled offline reader and MOBI extractor. If this remains visible, check the launcher errors and required packages."; fontSize: 14; color: soft }
    }
  } else {
  Column {
    fill: true
    gap: 0
    if pane == "read" {
      Row {
        height: 44
        padding: [24, 0]
        align: center
        gap: 4
        SettingsIcon { }
        if len(chapters) > 0 {
          Text { text: "‹"; fontSize: 20; color: soft; padding: [4, 8]; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py prev-chapter") } }
        }
        Text {
          text: chapterTitle
          font: readingFont
          fontSize: 11
          letterSpacing: 1.3
          color: soft
          maxLines: 1
          weight: 1
          onTap: { if len(chapters) > 0 { pane = "chapters" } }
        }
        if len(chapters) > 0 {
          Text { text: "›"; fontSize: 20; color: soft; padding: [4, 8]; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py next-chapter") } }
        }
        if data.current { Text { text: "${round((currentPage + 1) / max(data.total, 1) * 100)}%"; fontSize: 11; color: soft } }
        ThemeIcon { }
      }
      if data.current {
        Canvas {
          weight: 1
          fill: width
          // The whole page is a tap target: its ripple would wash over a night page on every turn.
          ripple: false
          onTap: {
            let next = clamp(currentPage + (x < (screenWidth ?? 400) / 2 ? -1 : 1), 0, max(data.total - 1, 0))
            if data.pageWindow[next - (data.windowStart ?? 0)] != null {
              readingPage = next
              cursorLayout = data.layoutKey
              saveAt = (now ?? 0) + 1
            }
          }
          let left = (width - min(width, 760)) / 2 + (data.margin ?? 24) + 2
          for line, i in pageLines {
            text(line, left, 10 + (i + 0.5) * (data.font ?? 20) * (data.spacing ?? 1.55), size: data.font ?? 20, font: readingFont, color: ink)
          }
        }
      } else {
        Column {
          weight: 1
          padding: [32, 16]
          justify: center
          gap: 20
          Text { text: "A little space\nfor a good book."; font: serif; fontSize: 38; color: ink }
          Text { text: "Open an EPUB, MOBI or TXT from your library, or find your next read in a free catalog."; font: sans; fontSize: 15; color: soft }
          Button { text: "Choose a book"; color: tint; onTap: { pane = "library"; tab = "local"; run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py scan") } }
          Text { text: "EPUB · MOBI · TXT\nOffline reading, saved progress"; fontSize: 12; color: soft }
        }
      }
    } else {
      Row {
        padding: [24, 16]
        align: center
        SettingsIcon { }
        Text { text: pane == "settings" ? "Settings" : pane == "chapters" ? "Contents" : "Library"; font: serif; fontSize: 30; color: ink; weight: 1 }
        Text { text: "Done"; fontSize: 14; color: tint; padding: 10; onTap: pane = "read" }
        ThemeIcon { }
      }
      if busy { Text { text: "Working…"; color: tint; fontSize: 12; padding: [24, 4] } }
      if data.message != "" && data.message != null {
        Text { text: data.message; fontSize: 13; color: ink; background: card; padding: [24, 12]; onTap: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py dismiss") }
      }
      if pane == "settings" {
        Column {
          scroll: true
          weight: 1
          gap: 16
          padding: [24, 12]
          Label { label: "READING" }
          Row {
            align: center
            Text { text: "Text size"; color: ink; weight: 1 }
            Button { text: "−"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py setting font ${int(data.font - 1)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}") }
            Text { text: "${data.font}"; color: ink }
            Button { text: "+"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py setting font ${int(data.font + 1)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}") }
          }
          Text { text: "Line spacing · ${fixed(data.spacing, 2)}"; color: soft; fontSize: 13 }
          Slider { value: data.spacing; min: 1.2; max: 2; step: 0.05; color: tint; onChange: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py setting spacing ${sh(value)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}") }
          Text { text: "Margins · ${data.margin}"; color: soft; fontSize: 13 }
          Slider { value: data.margin; min: 12; max: 48; step: 4; color: tint; onChange: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py setting margin ${int(value)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}") }
          Flow {
            gap: 8
            for themeName in ["paper", "sepia", "night"] {
              Text { text: themeName == "paper" ? "Day" : capitalize(themeName); color: activeTheme == themeName ? paper : ink; background: activeTheme == themeName ? tint : card; padding: [16, 12]; radius: 8 * corners; onTap: { preferredTheme = themeName; themeSaveAt = (now ?? 0) + 1 } }
            }
          }
          if data.current {
            Label { label: "GO TO PAGE" }
            Row {
              align: center
              Input { placeholder: "1–${data.total}"; text: pageText; color: ink; weight: 1; onChange: pageText = value }
              Button { text: "Go"; color: tint; onTap: { run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py jump ${int(num(pageText, 1))}"); pane = "read" } }
            }
          }
          Spacer { height: 8 }
          Label { label: "BOOKS FOLDER" }
          Text { text: data.folder; color: soft; fontSize: 12 }
          Input { text: folderText; placeholder: "~/Books"; color: ink; fontSize: 14; onChange: folderText = value }
          Button { text: "Use folder"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py folder ${sh(folderText)}") }
          Text { text: "Missing folders are created. EPUB, MOBI and TXT files directly inside this folder appear in your library."; color: soft; fontSize: 12 }
          Spacer { height: 8 }
          Label { label: "OPDS CATALOGS" }
          for c in data.catalogs ?? [] key c.url {
            Column {
              padding: 12
              background: card
              gap: 6
              Text { text: c.name; color: ink; fontSize: 15 }
              Text { text: c.url; color: soft; fontSize: 11 }
              Text { text: "Remove catalog"; color: tint; fontSize: 12; padding: [0, 8]; onTap: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py catalog-remove ${sh(c.url)}") }
            }
          }
          Input { text: catalogName; placeholder: "Catalog name"; color: ink; fontSize: 14; onChange: catalogName = value }
          Input { text: catalogUrl; placeholder: "https://example.org/opds"; color: ink; fontSize: 14; onChange: catalogUrl = value }
          Button { text: "Add catalog"; color: tint; onTap: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py catalog-add ${sh(catalogName)} ${sh(catalogUrl)}") }
          Text { text: "Public OPDS 1 and 2 feeds. Books and catalog titles keep their original language. Sign-in and DRM are not supported."; color: soft; fontSize: 12 }
          Spacer { height: 20 }
        }
      } else if pane == "chapters" {
        Column {
          lazy: true
          weight: 1
          gap: 0
          padding: [24, 8]
          if len(chapters) == 0 {
            Text { text: "This book has no chapter list."; color: soft; fontSize: 14; padding: [0, 16] }
          }
          for c, i in chapters {
            Row {
              padding: [12, 14]
              align: center
              gap: 12
              background: i == chapterIndex ? card : paper
              onTap: { pane = "read"; busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py chapter ${sh(i)}") }
              Text { text: c.title; color: i == chapterIndex ? tint : ink; fontSize: 15; weight: 1; maxLines: 2 }
              Text { text: "${c.page + 1}"; color: soft; fontSize: 12 }
            }
          }
        }
      } else {
        Row {
          padding: [24, 4]
          gap: 20
          Text { text: "On device"; color: tab == "local" ? tint : soft; bold: tab == "local"; padding: [0, 10]; onTap: { tab = "local"; queryText = ""; run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py scan") } }
          Text { text: "Catalogs"; color: tab == "catalogs" ? tint : soft; bold: tab == "catalogs"; padding: [0, 10]; onTap: { tab = "catalogs"; queryText = "" } }
        }
        if tab == "local" {
          Row {
            padding: [24, 4]
            align: center
            Input { text: queryText; placeholder: "Find a title or author"; fontSize: 14; color: ink; weight: 1; onChange: queryText = value }
            Text { text: "Refresh"; color: tint; fontSize: 12; padding: 10; onTap: run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py scan") }
          }
          Column {
            lazy: true
            weight: 1
            gap: 10
            padding: [24, 12]
            for b in (data.books ?? []).filter(b => contains(lower(b.title + " " + b.author), lower(queryText))) key b.id {
              let status = data.statuses[b.id] ?? (b.id == data.current.id || num(data.positions[b.id], 0) > 0 ? "reading" : "new")
              Column {
                padding: 16
                background: card
                radius: 8 * corners
                gap: 7
                Column {
                  gap: 7
                  onTap: { if deleteBook != b.id { task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py open ${sh(b.id)} ${int(currentPage)} ${sh(data.layoutKey ?? "")}"); busy = true; pane = "read" } }
                  Text { text: b.title; font: serif; fontSize: 20; color: ink }
                  Text { text: b.author == "" ? b.format : "${b.author} · ${b.format}"; color: soft; fontSize: 12 }
                  if b.id == data.current.id { Text { text: "Open now"; color: soft; fontSize: 11 } }
                }
                Row {
                  align: center
                  Box {
                    width: 120
                    height: 40
                    Text { text: "${capitalize(status)} ▾"; color: tint; fontSize: 12; padding: [10, 10]; background: alpha(tint, 0.1); radius: 6 * corners; onTap: { statusBook = b.id; deleteBook = "" } }
                    Popup {
                      width: 190
                      visible: statusBook == b.id
                      onDismiss: statusBook = ""
                      Column {
                        padding: 8
                        background: card
                        gap: 0
                        for choice in ["new", "reading", "done"] {
                          Text { text: "Mark as ${capitalize(choice)}"; color: choice == status ? tint : ink; fontSize: 14; padding: [16, 14]; onTap: { run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py status ${sh(b.id)} ${sh(choice)}"); statusBook = "" } }
                        }
                      }
                    }
                  }
                  Spacer { weight: 1 }
                  Text { text: "Delete"; color: soft; fontSize: 12; width: 76; maxLines: 1; align: end; padding: [12, 10]; onTap: { deleteBook = b.id; statusBook = "" } }
                }
                if deleteBook == b.id {
                  Column {
                    gap: 8
                    padding: 12
                    border: 1
                    borderColor: alpha(soft, 0.4)
                    Text { text: "Delete this book from your device? The file and saved reading progress will be removed."; color: ink; fontSize: 13 }
                    Row {
                      Text { text: "Cancel"; color: tint; fontSize: 13; padding: [12, 12]; onTap: deleteBook = "" }
                      Spacer { weight: 1 }
                      Text { text: "Delete file"; color: #b34b45; fontSize: 13; padding: [12, 12]; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py delete ${sh(b.id)}"); deleteBook = "" } }
                    }
                  }
                }
              }
            }
            if len(data.books ?? []) == 0 {
              Text { text: "Your shelf is waiting."; font: serif; fontSize: 26; color: ink; padding: [0, 16] }
              Text { text: "Copy EPUB, MOBI or TXT files to ${data.folder}, or download a book from Catalogs."; fontSize: 14; color: soft }
            }
          }
        } else {
          if data.feed {
            Row {
              align: center
              padding: [24, 4]
              Text { text: "‹ Back"; color: tint; padding: [0, 12]; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py feed-back") } }
              Text { text: data.feed.title; fontSize: 14; color: ink; maxLines: 2; weight: 1 }
            }
            if data.feed.search != "" {
              Input { placeholder: "Search this catalog…"; color: ink; fontSize: 14; padding: [24, 4]; clear: true; onSubmit: { busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py search ${sh(value)}") } }
            }
            Column {
              lazy: true
              weight: 1
              gap: 10
              padding: [24, 12]
              for e in data.feed.entries ?? [] key e.url {
                Column {
                  gap: 7
                  padding: 16
                  background: card
                  radius: 8 * corners
                  onTap: {
                    if !busy {
                      busy = true
                      if e.kind == "download" {
                        task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py download ${sh(e.url)} ${sh(e.title)} ${sh(e.format)}")
                      } else {
                        task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py browse ${sh(e.url)}")
                      }
                    }
                  }
                  Text { text: e.title; font: serif; fontSize: 19; color: ink }
                  if e.author != "" { Text { text: e.author; color: soft; fontSize: 12 } }
                  Text { text: e.kind == "download" ? "Download ${upper(e.format)}" : "Browse →"; color: tint; fontSize: 12 }
                }
              }
              if data.feed.next != "" {
                Button { text: "Next results"; color: tint; onTap: { busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py browse ${sh(data.feed.next)}") } }
              }
              Text { text: "Public-domain rules vary by country. Check before downloading."; fontSize: 11; color: soft; padding: [0, 12] }
            }
          } else {
            Column {
              scroll: true
              weight: 1
              gap: 12
              padding: [24, 16]
              Label { label: "FIND YOUR NEXT READ" }
              for c in data.catalogs ?? [] key c.url {
                Column {
                  gap: 10
                  padding: 20
                  background: card
                  radius: 8 * corners
                  onTap: { if !busy { busy = true; task = run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py catalog ${sh(c.url)}") } }
                  Text { text: c.name; font: serif; fontSize: 24; color: ink }
                  // All five default sources include a short English description.
                  if (c.description ?? "") != "" { Text { text: c.description; color: soft; fontSize: 13 } }
                  Text { text: "Browse catalog →"; color: tint; fontSize: 13 }
                }
              }
              Text { text: "Add your own OPDS server in Settings. Downloads are saved in your books folder and can be read offline."; color: soft; fontSize: 13 }
            }
          }
        }
      }
    }

    Row {
      height: 56
      padding: [20, 0]
      align: center
      gap: 8
      Spacer { width: 48 }
      Text {
        text: busy ? "Working…" : pane != "read" ? "Back to reading" : data.current ? "${currentPage + 1} / ${data.total}" : "YOUR QUIET CORNER"
        fontSize: 11
        letterSpacing: 1
        color: soft
        align: center
        weight: 1
        padding: [0, 16]
        onTap: pane = "read"
      }
      Box {
        size: 48
        onTap: {
          if pane == "library" {
            pane = "read"
          } else {
            pane = "library"
            queryText = ""
            run("python ~/.local/share/owl-reader-store/39cea1de87e77ebd83388ee1cfbdc8c7553d4e664a67398f2fbf6e5befa9448a/reader.py scan")
          }
        }
        Canvas {
          let cx = width / 2
          let cy = height / 2
          path([[cx, cy - 9], [cx - 6, cy - 12], [cx - 14, cy - 12], [cx - 14, cy + 9], [cx - 6, cy + 9], [cx, cy + 12], [cx + 6, cy + 9], [cx + 14, cy + 9], [cx + 14, cy - 12], [cx + 6, cy - 12], [cx, cy - 9]], stroke: pane == "library" ? tint : soft, width: 2)
          line(cx, cy - 9, cx, cy + 12, stroke: pane == "library" ? tint : soft, width: 2)
        }
      }
    }
    Spacer { height: screenInset }
  }
  }
  }
}
