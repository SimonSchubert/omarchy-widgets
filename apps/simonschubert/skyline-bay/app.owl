  let MSA = DES.map(D => [D.p + flatten((D.st ?? []).map(S => flatten(range(S.f).map(i => [
        {k: 0, x: 0, y: S.y + i * (S.s + S.b), z: 0, w: S.w, h: S.s, d: S.d, c: S.c},
        {k: 0, x: 0, y: S.y + i * (S.s + S.b) + S.s, z: 0, w: S.w - 0.04, h: S.b, d: S.d - 0.04, c: S.g, nt: true}
      ])) + [{k: 0, x: 0, y: S.y + S.f * (S.s + S.b), z: 0, w: S.w, h: S.s, d: S.d, c: S.c, t: S.t, nt: S.nt}]))]
    // (A box only gets the faces that show: a flat one its top, a thin one its two broad sides, a pole its four
    // sides; every face is triangles the scene works through on each frame the view moves.)
    .map(P => [P.map(q => q.k == 0 ? [q.h <= 0.03 ? [0] : q.w <= 0.05 && q.d <= 0.05 ? [1, 2, 3, 4] : q.d <= 0.03 ? [1, 2] : q.w <= 0.03 ? [3, 4] : q.nt ? [1, 2, 3, 4] : [0, 1, 2, 3, 4]].map(FI => {p: CORN.map(o => [q.x + o[0] * q.w, q.y + o[1] * q.h, q.z + o[2] * q.d]), f: FI.map(i => BF[i]), c: [q.cs ?? [q.t ?? q.c, q.c, q.c, q.c, q.c]].map(L => FI.map(i => L[i]))[0]})[0]
      : q.k == 1 ? {p: [[q.x - q.w / 2, q.y, q.z - q.d / 2], [q.x + q.w / 2, q.y, q.z - q.d / 2], [q.x + q.w / 2, q.y, q.z + q.d / 2], [q.x - q.w / 2, q.y, q.z + q.d / 2], [q.x - q.w / 2, q.y + q.h, q.z], [q.x + q.w / 2, q.y + q.h, q.z]], f: [[3, 2, 5, 4], [1, 0, 4, 5], [2, 1, 5], [0, 3, 4]], c: [q.c, q.c, q.e ?? q.c, q.e ?? q.c]}
      : q.k == 2 ? {p: [[q.x - q.w / 2, q.y, q.z - q.d / 2], [q.x + q.w / 2, q.y, q.z - q.d / 2], [q.x + q.w / 2, q.y, q.z + q.d / 2], [q.x - q.w / 2, q.y, q.z + q.d / 2], [q.x, q.y + q.h, q.z]], f: [[3, 2, 4], [1, 0, 4], [2, 1, 4], [0, 3, 4]], c: [q.c, q.c, q.c, q.c]}
      : q.k == 3 ? {p: range(q.n).map(i => [q.x + cos(2 * pi * i / q.n) * q.r, q.y, q.z + sin(2 * pi * i / q.n) * q.r]) + range(q.n).map(i => [q.x + cos(2 * pi * i / q.n) * (q.r2 ?? q.r), q.y + q.h, q.z + sin(2 * pi * i / q.n) * (q.r2 ?? q.r)]),
          f: range(q.n).map(i => [(i + 1) % q.n, i, q.n + i, q.n + (i + 1) % q.n]) + (q.nt ? [] : [reverse(range(q.n)).map(i => q.n + i)]), c: range(q.n).map(i => q.c) + (q.nt ? [] : [q.t ?? q.c])}
      : q.k == 4 ? {p: range(q.n).map(i => [q.x + cos(2 * pi * i / q.n) * q.r, q.y, q.z + sin(2 * pi * i / q.n) * q.r]) + [[q.x, q.y + q.h, q.z]], f: range(q.n).map(i => [(i + 1) % q.n, i, q.n]), c: range(q.n).map(i => q.c)}
      : {p: [[q.x - q.w / 2, q.y, q.z + q.d / 2], [q.x + q.w / 2, q.y, q.z + q.d / 2], [q.x + q.w / 2, q.y + q.h, q.z - q.d / 2], [q.x - q.w / 2, q.y + q.h, q.z - q.d / 2], [q.x - q.w / 2, q.y, q.z - q.d / 2], [q.x + q.w / 2, q.y, q.z - q.d / 2]], f: [[0, 1, 2, 3], [5, 4, 3, 2], [1, 5, 2], [4, 0, 3]], c: [q.c, q.e, q.e, q.e]})]
      // (joined in one pass: each part's corners numbered on from the parts before it)
      .map(R => [scan(R, (a, r) => a + len(r.p), 0)].map(O => {p: flatten(R.map(r => r.p)), f: flatten(range(len(R)).map(i => R[i].f.map(f => f.map(j => j + O[i] - len(R[i].p))))), c: flatten(R.map(r => r.c))})[0])[0])[0])
  let MS = MSA.map(A => mesh(A.p, A.f, A.c))
  // each model's triangles: a scene holds under 60,000, so a big city's buildings are split over several
  let MTRI = MSA.map(A => sum(A.f.map(f => len(f) - 2)))
  let RI = [[0, 1, 2, 3, 62, 63], [4, 5, 6, 64, 65], [7, 8, 9, 66, 67], [68, 69]]
  let CI = [[10, 11, 12, 70], [13, 14, 71], [15, 16, 72], [73, 74]]
  let II = [[17, 18, 75], [19, 20, 76], [21, 77], [21, 77]]
  let PLN = plane(1)
  let SUBQ = flatten(range(NN).filter(c => SUBL[c] == 1).map(c => [[WX[c] - 0.17, WZ[c] - 0.17, WX[c] + 0.17, WZ[c] + 0.17]]
    + (NB4[c][0] >= 0 && SUBT[NB4[c][0]] ? [[WX[c] - 0.12, WZ[c] - 0.5, WX[c] + 0.12, WZ[c] - 0.17]] : [])
    + (NB4[c][1] >= 0 && SUBT[NB4[c][1]] ? [[WX[c] - 0.12, WZ[c] + 0.17, WX[c] + 0.12, WZ[c] + 0.5]] : [])
    + (NB4[c][2] >= 0 && SUBT[NB4[c][2]] ? [[WX[c] - 0.5, WZ[c] - 0.12, WX[c] - 0.17, WZ[c] + 0.12]] : [])
    + (NB4[c][3] >= 0 && SUBT[NB4[c][3]] ? [[WX[c] + 0.17, WZ[c] - 0.12, WX[c] + 0.5, WZ[c] + 0.12]] : [])))
  let SUBM = chunk(SUBQ, 240).map(Q => mesh(flatten(Q.map(q => [[q[0], 0.07, q[1]], [q[0], 0.07, q[3]], [q[2], 0.07, q[3]], [q[2], 0.07, q[1]]])), range(len(Q)).map(i => [4 * i, 4 * i + 1, 4 * i + 2, 4 * i + 3])))
  // a flat disc one unit round, for a service's reach on the ground (its color comes from the model)
  let DISC = mesh([[0, 0, 0]] + range(32).map(i => [cos(2 * pi * i / 32), 0, sin(2 * pi * i / 32)]), range(32).map(i => [0, 1 + (i + 1) % 32, 1 + i]))
  let PUFF = sphere(6)

  // ---- the ground and what lies on it -------------------------------------------------------------------------
  // (While a service is being placed, the map shows that service.)
  let EOV = tool >= 13 && tool <= 16 ? tool - 13 : tool == 24 || tool == 25 ? 5 : tool == 8 || tool == 26 ? 6 : ov
  let HEAT = EOV < 0 ? [] : EOV == 4 ? range(NN).map(c => GG[c] >= 2 && GG[c] <= 4 ? clamp((LVAL[c] - 0.5) / 4, 0, 1) : -1)
    : EOV == 5 ? range(NN).map(c => GG[c] >= 2 && GG[c] <= 4 ? 1 - TRAF[c] : -1)
    : EOV == 6 ? range(NN).map(c => SUBC[c] ? 1 : any(STAS, s => CX[s] - CX[c] <= 4 && CX[c] - CX[s] <= 4 && CZ[s] - CZ[c] <= 4 && CZ[c] - CZ[s] <= 4) ? 0.5 : -1)
    : range(NN).map(c => len(SVP[EOV]) == 0 ? 0 : [sqrt(min(SVP[EOV].map(s => (CX[s] - CX[c]) * (CX[s] - CX[c]) + (CZ[s] - CZ[c]) * (CZ[s] - CZ[c]))))].map(d => d <= 3 ? 1 : max(0.2, 1 - (d - 3) * 0.08))[0])
  let HOT = [#e4574a, #f2c43a, #4cc76a]
  // Water tiles let the one sea below show through, so the bay, rivers and the open sea are all the same water; only
  // the shallows along a coast are tinted, and see-through too.
  let WCLEAR = alpha(#3f9fd8, 0)
  let WSHORE = alpha(#7fd6e6, 0.55)
  let GCOL0 = range(N).map(i => range(N).map(j => [i * N + j].map(c => [GG[c]].map(k => EOV >= 0 && k != 6 && k != 7 && k != 1 ? (HEAT[c] < 0 ? #d9dcd2 : HEAT[c] < 0.5 ? mix(HOT[0], HOT[1], HEAT[c] * 2) : mix(HOT[1], HOT[2], HEAT[c] * 2 - 1)) : k == 6 ? (SHORE[c] ? WSHORE : WCLEAR)
    : k == 7 ? MP.bc[(i + j) % 2]
    : k == 1 ? (TER[c] == 6 ? (SHORE[c] ? WSHORE : WCLEAR) : #5f6675)
    : k == 2 ? #bfeb98 : k == 3 ? #c4d6ea : k == 4 ? #ecdba4
    : k == 12 ? #74c95c : k == 18 ? #e7dfcf : k >= 10 ? #d4d9df
    : k == 5 ? MP.wc[(i + j) % 2]
    : MP.tc[(i + j) % 2])[0])[0]))
  let GCOL = range(N).map(i => range(N).map(j => [i * N + j].map(c => OWNED[c] || TER[c] == 6 ? GCOL0[i][j] : mix(GCOL0[i][j], #4d5866, 0.42))[0]))
  let GROUND = terrain(HT, GCOL)
  // road markings: a kerb where a road ends or runs past (and round the inside of a corner, so where roads meet the
  // kerbs join up), a dashed middle on straight runs, at bridge height on water
  let SIDE = #d2d6dd
  let DASHC = #f6efd8
  // the highway's height: a bridge over the sea when the coast doesn't reach the grid's edge
  let HWY = mapv >= 1 && TER[HC] == 6 ? 0.05 : 0
  let RDQ = flatten(range(NN).filter(c => GG[c] == 1).map(c => [{nb: [NB4[c][0], NB4[c][1], c == HC ? HC : NB4[c][2], NB4[c][3]].map(n => n >= 0 && GG[n] == 1), dg: [[-1, -1], [-1, 1], [1, -1], [1, 1]].map(o => CX[c] + o[1] >= 0 && CX[c] + o[1] < N && CZ[c] + o[0] >= 0 && CZ[c] + o[0] < N && GG[c + o[0] * N + o[1]] == 1), x: WX[c], z: WZ[c], y: TER[c] == 6 ? 0.062 : 0.012}].map(R =>
      (R.nb[0] ? [] : [[R.x - 0.5, R.z - 0.5, R.x + 0.5, R.z - 0.36, SIDE, R.y]])
    + (R.nb[1] ? [] : [[R.x - 0.5, R.z + 0.36, R.x + 0.5, R.z + 0.5, SIDE, R.y]])
    + (R.nb[2] ? [] : [[R.x - 0.5, R.z - 0.5, R.x - 0.36, R.z + 0.5, SIDE, R.y]])
    + (R.nb[3] ? [] : [[R.x + 0.36, R.z - 0.5, R.x + 0.5, R.z + 0.5, SIDE, R.y]])
    + (R.nb[0] && R.nb[2] && !R.dg[0] ? [[R.x - 0.5, R.z - 0.5, R.x - 0.36, R.z - 0.36, SIDE, R.y]] : [])
    + (R.nb[0] && R.nb[3] && !R.dg[1] ? [[R.x + 0.36, R.z - 0.5, R.x + 0.5, R.z - 0.36, SIDE, R.y]] : [])
    + (R.nb[1] && R.nb[2] && !R.dg[2] ? [[R.x - 0.5, R.z + 0.36, R.x - 0.36, R.z + 0.5, SIDE, R.y]] : [])
    + (R.nb[1] && R.nb[3] && !R.dg[3] ? [[R.x + 0.36, R.z + 0.36, R.x + 0.5, R.z + 0.5, SIDE, R.y]] : [])
    + ((R.nb[2] || R.nb[3]) && !R.nb[0] && !R.nb[1] ? [[R.x - 0.2, R.z - 0.03, R.x + 0.2, R.z + 0.03, DASHC, R.y]] : [])
    + ((R.nb[0] || R.nb[1]) && !R.nb[2] && !R.nb[3] ? [[R.x - 0.03, R.z - 0.2, R.x + 0.03, R.z + 0.2, DASHC, R.y]] : []))[0]))
    + range(15).map(i => [-25.8 + i, 0.47, -25.4 + i, 0.53, DASHC, HWY > 0 ? 0.062 : 0.012]) + [[-26, 0, -11, 0.09, SIDE, HWY > 0 ? 0.062 : 0.012], [-26, 0.91, -11, 1, SIDE, HWY > 0 ? 0.062 : 0.012]]
  let DECALS = chunk(RDQ, 240).map(Q => mesh(flatten(Q.map(q => [[q[0], q[5], q[1]], [q[0], q[5], q[3]], [q[2], q[5], q[3]], [q[2], q[5], q[1]]])), range(len(Q)).map(i => [4 * i, 4 * i + 1, 4 * i + 2, 4 * i + 3]), Q.map(q => q[4])))
  // bridge decks over water, and the highway's causeway in from the sea
  let ROADC = #5f6675
  let DECKC = #c9c3b6
  let DECKQ = [{p: [[-26, HWY, 0], [-26, HWY, 1], [-11, HWY, 1], [-11, HWY, 0]], c: ROADC}, {p: [[-11, -0.4, 0], [-26, -0.4, 0], [-26, HWY, 0], [-11, HWY, 0]], c: DECKC}, {p: [[-26, -0.4, 1], [-11, -0.4, 1], [-11, HWY, 1], [-26, HWY, 1]], c: DECKC}]
    + flatten(range(NN).filter(c => GG[c] == 1 && TER[c] == 6).map(c => [{x0: WX[c] - 0.5, x1: WX[c] + 0.5, z0: WZ[c] - 0.5, z1: WZ[c] + 0.5, nb: NB4[c].map(n => n >= 0 && GG[n] == 1)}].map(B => [{p: [[B.x0, 0.05, B.z0], [B.x0, 0.05, B.z1], [B.x1, 0.05, B.z1], [B.x1, 0.05, B.z0]], c: ROADC}]
      + (B.nb[0] ? [] : [{p: [[B.x1, -0.36, B.z0], [B.x0, -0.36, B.z0], [B.x0, 0.05, B.z0], [B.x1, 0.05, B.z0]], c: DECKC}])
      + (B.nb[1] ? [] : [{p: [[B.x0, -0.36, B.z1], [B.x1, -0.36, B.z1], [B.x1, 0.05, B.z1], [B.x0, 0.05, B.z1]], c: DECKC}])
      + (B.nb[2] ? [] : [{p: [[B.x0, -0.36, B.z0], [B.x0, -0.36, B.z1], [B.x0, 0.05, B.z1], [B.x0, 0.05, B.z0]], c: DECKC}])
      + (B.nb[3] ? [] : [{p: [[B.x1, -0.36, B.z1], [B.x1, -0.36, B.z0], [B.x1, 0.05, B.z0], [B.x1, 0.05, B.z1]], c: DECKC}]))[0]))
  let DECKS = chunk(DECKQ, 240).map(Q => mesh(flatten(Q.map(q => q.p)), range(len(Q)).map(i => [4 * i, 4 * i + 1, 4 * i + 2, 4 * i + 3]), Q.map(q => q.c)))

  // ---- what stands on the tiles ----------------------------------------------------------------------------------
  // a building faces its road; trees and lone buildings turn by chance
  let ROT = range(NN).map(c => [NB4[c]].map(q => q[1] >= 0 && GG[q[1]] == 1 ? 0 : q[3] >= 0 && GG[q[3]] == 1 ? 90 : q[0] >= 0 && GG[q[0]] == 1 ? 180 : q[2] >= 0 && GG[q[2]] == 1 ? 270 : floor(hash(c, 2) * 4) * 90)[0])
  let MIX = range(NN).map(c => [{k: GG[c], l: LV[c], h: hash(c, 8)}].map(q => q.k == 2 && q.l >= 2 && BEACH[c] ? 58 + q.l
    : q.k == 2 && q.l > 0 ? RI[q.l - 1][floor(q.h * len(RI[q.l - 1]))]
    : q.k == 3 && q.l > 0 ? CI[q.l - 1][floor(q.h * len(CI[q.l - 1]))]
    : q.k == 4 && q.l > 0 ? II[q.l - 1][floor(q.h * len(II[q.l - 1]))]
    : q.k >= 2 && q.k <= 4 ? 42 + q.k : q.k >= 24 ? 31 + q.k : q.k >= 21 ? 30 + q.k : q.k >= 10 ? 12 + q.k : q.k == 5 ? MP.tree[floor(q.h * 4)] : -1)[0])
  // where a sign says a parcel can be bought: its land tile nearest its middle
  let SALE = range(NPAR).filter(q => BUYABLE[q]).map(q => first(range(NN).filter(c => PAR[c] == q && TER[c] == 0 && GG[c] != 1).sortBy(c => (CX[c] + 0.5 - PMID[q % NPX]) * (CX[c] + 0.5 - PMID[q % NPX]) + (CZ[c] + 0.5 - PMID[floor(q / NPX)]) * (CZ[c] + 0.5 - PMID[floor(q / NPX)]))) ?? -1).filter(c => c >= 0)
  let FC = fresh.map(f => f.c)
  let OBJ = range(NN).filter(c => MIX[c] >= 0 && !any(FC, q => q == c)).map(c => {m: MS[MIX[c]], n: MTRI[MIX[c]], at: [WX[c], 0, WZ[c]], t: [0, ROT[c], 0]})
  // A scene draws at most 60,000 triangles, so a big city's buildings go into a few scenes, far to near, each drawn
  // over the one before. Under 52,000 they're one scene, as before, and stay put however the camera moves.
  let OTOT = sum(OBJ.map(o => o.n))
  let OGN = OTOT < 52000 ? 1 : ceil(OTOT / 45000)
  let OBJS = OGN == 1 ? OBJ : OBJ.sortBy(o => -((o.at[0] - EYE[0]) * (tx - EYE[0]) + (o.at[2] - EYE[2]) * (tz - EYE[2])))
  let OCUM = OGN == 1 ? [] : scan(OBJS, (a, o) => a + o.n, 0)
  let OBJG = OGN == 1 ? [OBJ] : range(OGN).map(k => range(len(OBJS)).filter(i => floor((OCUM[i] - 1) * OGN / OTOT) == k).map(i => OBJS[i]))
  let FRL = fresh.filter(f => MIX[f.c] >= 0).map(f => {m: MIX[f.c], at: [WX[f.c], 0, WZ[f.c]], r: ROT[f.c], t: f.t})
  // The lots round one that's rising, drawn again with it over the city, so the ones in front still hide it: what
  // rises is drawn in a scene of its own after the buildings, which stay still and cost nothing to draw again.
  let FNB = unique(flatten(FC.map(c => range(9).map(i => c + (floor(i / 3) - 1) * N + i % 3 - 1).filter(n => n >= 0 && n < NN && abs(CX[n] - CX[c]) <= 1))))
    .filter(n => MIX[n] >= 0 && !any(FC, q => q == n)).map(c => {m: MS[MIX[c]], at: [WX[c], 0, WZ[c]], t: [0, ROT[c], 0]})
  // chimney tops: [x, y, z, phase], turned with their building
  let STK = flatten(range(NN).filter(c => GG[c] == 4 && LV[c] >= 2).take(6).map(c => (LV[c] == 2 ? [[0.34, 0.58, -0.22]] : [[0.3, 0.76, 0.24]])
    .map(o => [rad(ROT[c])].map(a => [WX[c] + o[0] * cos(a) + o[2] * sin(a), o[1], WZ[c] - o[0] * sin(a) + o[2] * cos(a), hash(c, o[2])])[0])))
  // Cars: each walks the roads from a tile picked by hash, never turning straight back unless the road ends, and
  // drives there and back along it. A third come in off the highway.
  // (Routes for all 16 are walked when the roads change; how many drive grows with the city.)
  // launch pads, and their rockets: a launch costs fuel, the customer pays when the satellite is up, and the next
  // rocket stands ready 3 minutes after
  let PADS = SPOS.filter(c => GG[c] == 23)
  let LCOST = HAS[7] ? 4000 : 8000
  let LREW = round((12000 + 2000 * CL) * (HAS[7] ? 1.5 : 1))
  let LREADY = (now ?? 0) >= lastL + 180
  let NCAR = len(RR) < 3 ? 0 : min(16, 2 + floor((POP + JOBS) / 45))
  let CRP = (len(RR) < 3 ? [] : range(16)).map(k => [reduce(range(26), (A, s) => [NB4[last(A.p)].filter(n => n >= 0 && reach[n] && n != A.v)].map(op => len(op) == 0 ? {p: A.p + [A.v], v: last(A.p)} : {p: A.p + [op[floor(hash(k, s, 3) * len(op))]], v: last(A.p)})[0], {p: [k % 3 == 0 ? HC : RR[floor(hash(k, 9) * len(RR))]], v: -1}).p.filter(c => c >= 0)]
    .map(P => (k % 3 == 0 ? range(14).map(i => [-24.5 + i, HWY + 0.012, 0.5]) : []) + P.map(c => [WX[c], TER[c] == 6 ? 0.062 : 0.012, WZ[c]]))[0])
  // boats sail the deep water the same way
  let DEEP = WCELLS.filter(c => !SHORE[c])
  let BOATS = len(DEEP) < 4 ? [] : range(2).map(k => reduce(range(30), (A, s) => [NB4[last(A.p)].filter(n => n >= 0 && TER[n] == 6 && !SHORE[n] && n != A.v)].map(op => len(op) == 0 ? {p: A.p + [A.v], v: last(A.p)} : {p: A.p + [op[floor(hash(k, s, 13) * len(op))]], v: last(A.p)})[0], {p: [DEEP[floor(hash(k, 21) * len(DEEP))]], v: -1}).p.filter(c => c >= 0).map(c => [WX[c], -0.3, WZ[c]]))
  // warnings over lots that can't grow, at most a few of each
  // [tile, what's missing: 0 a road, 1 power, 2 water]
  let WARN = ZC.filter(c => !conn[c]).take(3).map(c => [c, 0]) + ZC.filter(c => conn[c] && !pw[c]).take(3).map(c => [c, 1]) + (CL >= 2 ? ZC.filter(c => conn[c] && pw[c] && LV[c] > 0 && !wt[c]).take(4).map(c => [c, 2]) : [])

  // ---- painting roads and zones -----------------------------------------------------------------------------------
  let PDX = pa >= 0 && pb >= 0 ? CX[pb] - CX[pa] : 0
  let PDZ = pa >= 0 && pb >= 0 ? CZ[pb] - CZ[pa] : 0
  let HFIRST = abs(PDX) >= abs(PDZ)
  // roads go along, then across; zones and the bulldozer take the rectangle
  let PCELLS = pa < 0 || pb < 0 ? [] : tool == 1 || tool == 8 ? (HFIRST ? range(abs(PDX) + 1).map(i => CZ[pa] * N + CX[pa] + i * sign(PDX)) + range(1, abs(PDZ) + 1).map(j => (CZ[pa] + j * sign(PDZ)) * N + CX[pb])
      : range(abs(PDZ) + 1).map(j => (CZ[pa] + j * sign(PDZ)) * N + CX[pa]) + range(1, abs(PDX) + 1).map(i => CZ[pb] * N + CX[pa] + i * sign(PDX)))
    : flatten(range(min(CZ[pa], CZ[pb]), max(CZ[pa], CZ[pb]) + 1).map(z => range(min(CX[pa], CX[pb]), max(CX[pa], CX[pb]) + 1).map(x => z * N + x)))
  let PRECT = pa < 0 || pb < 0 ? [] : tool == 1 || tool == 8 ? (HFIRST ? [[min(CX[pa], CX[pb]), CZ[pa], max(CX[pa], CX[pb]), CZ[pa]], [CX[pb], min(CZ[pa], CZ[pb]), CX[pb], max(CZ[pa], CZ[pb])]]
      : [[CX[pa], min(CZ[pa], CZ[pb]), CX[pa], max(CZ[pa], CZ[pb])], [min(CX[pa], CX[pb]), CZ[pb], max(CX[pa], CX[pb]), CZ[pb]]])
    : [[min(CX[pa], CX[pb]), min(CZ[pa], CZ[pb]), max(CX[pa], CX[pb]), max(CZ[pa], CZ[pb])]]
  // beach sand off the map's rim can be built on straight away, or bulldozed to grass
  let SANDOK = range(NN).map(c => GG[c] == 7 && CX[c] > 0 && CZ[c] > 0 && CX[c] < N - 1 && CZ[c] < N - 1)
  let PV = PCELLS.filter(c => OWNED[c] && (tool == 8 ? GG[c] != 7 && SUBL[c] == 0 : tool == 1 ? (GG[c] == 0 || GG[c] == 5 || GG[c] == 6 || SANDOK[c] || (GG[c] >= 2 && GG[c] <= 4 && LV[c] == 0))
    : tool <= 4 ? (GG[c] == 0 || GG[c] == 5 || SANDOK[c] || (GG[c] >= 2 && GG[c] <= 4 && GG[c] != tool && LV[c] == 0))
    : c != HC && GG[c] != 0 && GG[c] != 6 && (GG[c] != 7 || SANDOK[c])))
  // a tunnel tool dragged only over tunnels fills them in
  let PFILL = tool == 8 && len(PV) == 0 ? PCELLS.filter(c => SUBL[c] == 1) : []
  let PCOST = sum(PV.map(c => tool == 8 ? (GG[c] == 6 ? 80 : 40) : tool == 1 ? (GG[c] == 6 ? 60 : 10) + (GG[c] == 5 ? 3 : 0) : tool <= 4 ? 5 + (GG[c] == 5 ? 3 : 0) : GG[c] >= 10 ? 0 : 5))
  // bulldozing a building pays half its price back
  let PREF = tool == 9 ? sum(PV.map(c => GG[c] >= 11 ? floor(TCOST[GG[c]] / 2) : 0)) : 0
  let PNET = PCOST - PREF

  // ---- the tile looked at ---------------------------------------------------------------------------------------
  let SK = sel >= 0 ? GG[sel] : -1
  let SL = sel >= 0 ? LV[sel] : 0
  // the zones' buildings by level, and how high each zone grows
  let ZNAME = [["Home lot", "House", "Townhouses", "Apartments", "Residential Tower"], ["Shop lot", "Corner Shop", "Offices", "Skyscraper", "Supertall"], ["Industry lot", "Workshop", "Factory", "Plant", "Plant"]]
  let ZMAX = [4, 4, 3]
  let SNAME = sel >= 0 && !OWNED[sel] && TER[sel] != 6 ? "Land for sale" : SK == 2 ? (SL >= 2 && SL <= 3 && BEACH[sel] ? ["Beach Villa", "Seaside Mansion"][SL - 2] : ZNAME[0][SL]) : SK == 3 ? ZNAME[1][SL] : SK == 4 ? ["Industry lot", "Workshop", "Factory", "Plant"][SL] : SK == 0 ? ["Grass", "Meadow", "Grass", "Grass"][mapk] : SK >= 0 ? TNAME[SK] : ""
  // What a lot needs to grow a level, each [met, what]: so a tap says what's missing, with the numbers.
  let NREQ = sel < 0 || SK < 2 || SK > 4 || SL < 1 || SL >= ZMAX[SK - 2] ? [] : [[SK - 2, SL + 1]].map(q => [
      [[2, 4, 7], [2, 5, 7], [3, 5, 5]][q[0]][q[1] - 2]].map(CLN => [[CL >= CLN, "city level ${CLN} (now ${CL})"], [wt[sel], "water"]]
      + (q[0] == 2 ? [] : [[[[2, 3.5, LV[sel] >= 4 ? 3.6 : 4.2], [1.5, 3, LV[sel] >= 4 ? 3.4 : 4]][q[0]][q[1] - 2]].map(LN => [LVAL[sel] >= LN, "land value ${LN} (now ${fixed(floor(LVAL[sel] * 10 + 0.001) / 10, 1)})"])[0]])
      + (q[1] >= 3 && q[0] < 2 ? [[[[2.6, 3.2], [1.8, 2.6]][q[0]][q[1] - 3]].map(SN => [SVC[sel] >= SN, "services ${SN} (now ${fixed(floor(SVC[sel] * 10 + 0.001) / 10, 1)}): police, fire, clinic, school closer"])[0]] : [])
      + (q[1] == 4 ? [[BUSC[sel] || SUBC[sel], "a bus stop or subway station near"]] : [])
      + (q[0] == 2 && q[1] == 3 ? [[NLAB[sel], "a research lab within 6 tiles"]] : []))[0])[0]
  let NMISS = NREQ.filter(q => !q[0]).map(q => q[1])
  let SNEED = sel < 0 || SK < 2 || SK > 4 ? "" : !conn[sel] ? "Needs a road out to the highway" : !pw[sel] ? (SL > 0 ? "Dark: not enough power right now" : "Needs power to grow") : SL >= ZMAX[SK - 2] ? "Fully grown!"
    : SL == 0 ? [[DR, DC, DI][SK - 2]].map(d => d > 0 ? "Building soon: there's demand" : "Waiting for demand")[0]
    : len(NMISS) > 0 ? "To grow into ${ZNAME[SK - 2][SL + 1]} it wants " + join(NMISS, ", ")
    : [[DR, DC, DI][SK - 2]].map(d => d > 0 ? "Ready to grow into ${ZNAME[SK - 2][SL + 1]}: lots take turns, so soon" : "Ready to grow into ${ZNAME[SK - 2][SL + 1]} once there's demand")[0]
  // what makes up a lot's land value, the parts that count
  let LVPARTS = sel < 0 || SK < 2 || SK > 4 ? "" : join([[NPARK[sel], "park +1"], [NEARW[sel], "sea view +1"], [NPLZ[sel], "plaza +1"], [KC[20] > 0, "Bay Tower +0.5"], [SVC[sel] > 0, "services +${fixed(SVC[sel] * 0.5, 1)}"], [POLL[sel], "smog −2"], [TRAF[sel] >= 0.05, "traffic −${fixed(TRAF[sel] * 1.5, 1)}"]].filter(q => q[0]).map(q => q[1]), " · ")
  let SINFO = sel < 0 ? [] : !OWNED[sel] && TER[sel] != 6 ? [BUYABLE[PAR[sel]] ? "This parcel of the island is for sale" : "Buy the land beside your city first", "${count(range(NN), c => PAR[c] == PAR[sel] && TER[c] != 6)} tiles of land"] : SK >= 2 && SK <= 4 ? [
      SK == 2 ? "${CAPR[SL]} residents" : "${SK == 3 ? CAPC[SL] : CAPI[SL]} jobs",
      "Power ${pw[sel] ? "on" : "off"} · Water ${wt[sel] ? "on" : "off"} · Road ${conn[sel] ? "yes" : "no"}",
      "Land value ${fixed(floor(LVAL[sel] * 10 + 0.001) / 10, 1)}" + (LVPARTS == "" ? "" : ": 1 + " + LVPARTS),
      join(range(4).map(t => ["Police", "Fire", "Clinic", "School"][t] + " " + (COVD[sel][t] < 0 ? "none" : "${2 + round(COVD[sel][t] * 0.7)} min")), " · "),
      "Traffic ${TRWORD[sel]}" + (BUSC[sel] ? " · buses" : "") + (SUBC[sel] ? " · subway" : ""),
      SNEED]
    : SK == 17 ? ["Makes ${round(40 * SEFF)} power in full sun", HAS[8] ? "Space solar keeps a quarter of it going under clouds" : "A tenth under clouds: batteries carry the city", "Upkeep $12 /min"]
    : SK == 21 ? ["Stores ${fmtNum(BONE)} power for cloudy spells", "All batteries ${round(BPCT * 100)}% full", "Upkeep $9 /min"]
    : SK == 22 ? ["Researches new technology", "Factories within 6 tiles can grow into plants", "${len(tech)} of ${len(TECH)} researched · upkeep $60 /min"]
    : SK == 23 ? ["Sends satellites up for paying customers", LREADY ? "A rocket stands ready: $${fmtNum(LCOST)} fuel, pays $${fmtNum(LREW)}" : "Next rocket ready in ${lastL + 180 - (now ?? 0)}s", "Upkeep $120 /min"]
    : SK == 11 ? ["Pumps ${round(60 * (HAS[2] ? 1.5 : 1))} water for the city", "Upkeep $18 /min"]
    : SK == 12 ? ["Raises land value 3 tiles around", "Makes nearby homes happier"]
    : SK >= 13 && SK <= 16 ? ["Reaches the whole island: quickest within 3 tiles, slower further out", "Tall buildings want all four services close by", "Upkeep $${fmtNum(TUP[SK] * 60)} /min"]
    : SK == 18 ? ["Raises land value 4 tiles around", "Shops and homes love it"]
    : SK == 19 ? ["Makes the whole city happier", "Upkeep $72 /min"]
    : SK == 20 ? ["The city's landmark: land value up everywhere", "Upkeep $90 /min"]
    : SK == 1 ? (any(BSTOPS, c => c == sel) ? ["Bus stop: traffic eases by a third 3 tiles round", "Traffic ${TRWORD[sel]}", "Upkeep $2 /min"] : [reach[sel] ? "Reaches the highway" : "Doesn't reach the highway yet", "Traffic ${TRWORD[sel]}" + (SUBL[sel] == 1 ? " · a subway tunnel runs under it" : "")])
    : SK == 24 ? ["Runs the buses that stop at bus stops", "${len(BSTOPS)} bus stop${len(BSTOPS) == 1 ? "" : "s"} in the city", "Upkeep $30 /min"]
    : SK == 25 ? [KC[24] > 0 ? "Buses stop here: traffic eases by a third 3 tiles round" : "Needs a bus depot to run buses", "Upkeep $2 /min"]
    : SK == 26 ? [any(STON, s => s == sel) ? "Linked: traffic eases by 60% 4 tiles round" : "Dig a tunnel to another station to open it", "Upkeep $36 /min"]
    : SK == 6 ? ["Roads can bridge it ($60 a tile)"] : SK == 5 ? ["Clearing costs $5"] : SK == 7 ? (SANDOK[sel] ? ["Build on it straight away, or bulldoze it to grass ($5)"] : ["The island's rim: nothing can be built here"]) : ["Free to build on"]

  // ---- the look -------------------------------------------------------------------------------------------------
  let FONT = "https://raw.githubusercontent.com/google/fonts/main/ofl/lilitaone/LilitaOne-Regular.ttf"
  let SBUILD = "https://actions.google.com/sounds/v1/cartoon/wood_plank_flicks.ogg"
  let SCHIME = "https://actions.google.com/sounds/v1/cartoon/magic_chime.ogg"
  let INK = #22304d
  let INK2 = #141d33
  let CRM = #fff6e3
  let CRM2 = #d9c9a6
  let SUN = #ffc84a
  let SUN2 = #c98f16
  let TEAL = #2fd0b4
  let CORAL = #ff6b57
  let MUT = #9fb0d0

  // ---- the clock: settle the cash, grow the city -------------------------------------------------------------
  when now != null && since == 0 { since = now }
  // back after a while: a little cash (a tenth of the time away, up to an hour) and a few lots grew
  when now != null && since > 0 && !boot && len(g) == NN {
    boot = true
    let away = now - since
    if away > 60 {
      let earned = floor(RATE * (10 + AWAYF * (min(away, 3600) - 10)))
      let up = shuffle(CND[0] + CND[1] + CND[2]).take(min(5, floor(away / 120)))
      lv = reduce(up, (L, c) => set(L, c, L[c] + 1), lv)
      msg = earned > 0 ? "WELCOME BACK! +$${fmtNum(earned)}" : "WELCOME BACK, MAYOR!"
      msgT = now
    }
  }
  // Like other city builders: a drag pans, a tap places one tile, and a press held still for a moment (a buzz says
  // so) starts painting from that tile, so the city can always be moved around with a tool out.
  every frame {
    if gm == 1 && tool >= 1 && tool <= 9 && downC >= 0 && time - downT > 0.32 && time >= downT {
      gm = 3
      pa = downC
      pb = downC
      haptic()
    }
    // Lots that grew join the buildings' scene again once they're up. (Not on the frame after they grew: a scene
    // that changes three frames running is drawn afresh every frame for a while.)
    if len(fresh) > 0 && (time > fresh[0].t + 0.8 || time < fresh[0].t - 5) {
      fresh = []
    }
  }
  // research done, and a satellite's customer paying, even if the app was closed meanwhile
  at rEnd {
    if rk >= 0 {
      tech = tech + [rk]
      msg = "RESEARCH DONE: ${upper(TECH[rk].n)}"
      msgT = now ?? 0
      if snd { sound(SCHIME) }
    }
    // the next in the queue starts where this one ended, so a queue runs on while the app is closed too
    if len(rq) > 0 {
      rk = rq[0]
      rEnd = rEnd + round(TECH[rq[0]].m * 60)
      rq = rq.drop(1)
    } else {
      rk = -1
      rEnd = 0
    }
  }
  at payAt {
    bank = bank + rw
    msg = "SATELLITE IN ORBIT! +$${fmtNum(rw)}"
    msgT = now ?? 0
    payAt = 0
    if snd { sound(SCHIME) }
  }
  every 2s {
    if now != null && len(g) == NN {
      // the batteries take what the sun makes over what the city uses, and give the difference under clouds
      batt = clamp(batt + (SOLNOW - PUSE) * clamp(now - since, 0, 10), 0, BCAP)
      bank = coins
      since = now
      if wx0 == 0 && !CALM0 { wx0 = now }
      if POP > best { best = POP }
      let up = shuffle(CND[0]).take(DR > 0.05 ? ceil(DR * 1.2) : 0) + shuffle(CND[1]).take(DC > 0.05 ? ceil(DC * 1.0) : 0) + shuffle(CND[2]).take(DI > 0.05 ? ceil(DI * 1.0) : 0)
      let dn = shuffle(DECL).take(1)
      if len(up) + len(dn) > 0 {
        lv = reduce(dn, (L, c) => set(L, c, L[c] - 1), reduce(up, (L, c) => set(L, c, L[c] + 1), lv))
        pops = pops.filter(p => time - p.t < 1.6 && time >= p.t).take(5) + up.filter(c => GG[c] == 2).take(3).map(c => {c: c, s: "+${CAPR[LV[c]] - CAPR[LV[c] - 1]}", t: time, col: #ffffff, y: BHT[0][LV[c]] + 0.15})
      }
      fresh = up.map(c => {c: c, t: time})
      if CL > seen {
        bank = bank + 75 * CL
        msg = "LEVEL ${CL}: ${upper(LVN[CL - 1])}! +$${fmtNum(75 * CL)}"
        msgT = now
        seen = CL
        if snd { sound(SCHIME) }
      }
    }
  }

  Box {
    fill: true
    background: #3f9fd8

    // ---- the world ----
    Canvas {
      fill: true
      scene(CAM, light: LIGHT, ambient: 0.9, fog: #b9e4f5) {
        model(PLN, at: [0, -0.34, 0], scale: 340, color: #3f9fd8)
      }
      scene(CAM, light: LIGHT, ambient: 0.62) {
        model(GROUND, at: [0, 0, 0])
      }
      scene(CAM, light: LIGHT, ambient: 0.62) {
        for m in DECKS { model(m, at: [0, 0, 0]) }
      }
      scene(CAM, light: LIGHT, ambient: 0.75) {
        for m in DECALS { model(m, at: [0, 0, 0]) }
        for r in PRECT {
          model(PLN, at: [(r[0] + r[2] + 1) / 2 - 11, 0.04, (r[1] + r[3] + 1) / 2 - 11], scale: [r[2] - r[0] + 1, 1, r[3] - r[1] + 1], color: alpha(tool == 9 ? CORAL : TCOL[tool], 0.5), ambient: 1)
        }
        if sel >= 0 && (SK == 26 || (SK == 1 && any(BSTOPS, c => c == sel))) && EOV < 0 {
          model(DISC, at: [WX[sel], 0.03, WZ[sel]], scale: [SK == 1 ? 3.5 : 4.5, 1, SK == 1 ? 3.5 : 4.5], color: alpha(SK == 1 ? #f2b134 : #3d7fd0, 0.26), ambient: 1)
        }
        if sel >= 0 && !OWNED[sel] && TER[sel] != 6 {
          let q = PAR[sel]
          model(PLN, at: [PMID[q % NPX] - 11, 0.04, PMID[floor(q / NPX)] - 11], scale: [PSIZ[q % NPX], 1, PSIZ[floor(q / NPX)]], color: alpha(BUYABLE[q] ? SUN : #ffffff, 0.3), ambient: 1)
        }
        if sel >= 0 && SK == 22 && EOV < 0 {
          model(DISC, at: [WX[sel], 0.03, WZ[sel]], scale: [6, 1, 6], color: alpha(#9b7be0, 0.26), ambient: 1)
        }
        if sel >= 0 && SK >= 13 && SK <= 16 && EOV < 0 {
          for ring in [[13, 0.14], [8, 0.2], [3, 0.32]] {
            model(DISC, at: [WX[sel], 0.03, WZ[sel]], scale: [ring[0], 1, ring[0]], color: alpha([#2f6fe3, #e4574a, #ff6fa0, #f2a33a][SK - 13], ring[1]), ambient: 1)
          }
        }
      }
      // What moves goes in scenes of its own, so the launcher keeps the buildings' scene drawn as it is until the city
      // or the view changes. Cars and boats go under the buildings: they keep to the middle of their road or deep
      // water, so nothing beside them ever overlaps them on screen.
      scene(CAM, light: LIGHT, ambient: 0.6) {
        if sel >= 0 {
          for e in [[0, -0.47, 1, 0.06], [0, 0.47, 1, 0.06], [-0.47, 0, 0.06, 1], [0.47, 0, 0.06, 1]] {
            model(PLN, at: [WX[sel] + e[0], 0.05, WZ[sel] + e[1]], scale: [e[2], 1, e[3]], color: alpha(SUN, 0.75 + 0.25 * sin(time * 6)), ambient: 1)
          }
        }
        for R, k in CRP.take(NCAR) {
          let L = len(R)
          if L >= 2 {
            let u = (time * 1.25 + k * 5.3) % (2 * L - 2)
            let fw = u < L - 1
            let s = fw ? u : 2 * L - 2 - u
            let i = min(floor(s), L - 2)
            let f = s - i
            let dx = (R[i + 1][0] - R[i][0]) * (fw ? 1 : -1)
            let dz = (R[i + 1][2] - R[i][2]) * (fw ? 1 : -1)
            model(MS[KC[24] > 0 && len(BSTOPS) > 0 && k % 4 == 1 ? 58 : 37 + k % 5], at: [lerp(R[i][0], R[i + 1][0], f) - dz * 0.15, lerp(R[i][1], R[i + 1][1], f), lerp(R[i][2], R[i + 1][2], f) + dx * 0.15], turn: [0, deg(atan2(dx, dz)), 0])
          }
        }
        for R, k in BOATS {
          let L = len(R)
          if L >= 2 {
            let u = (time * 0.32 + k * 7.1) % (2 * L - 2)
            let fw = u < L - 1
            let s = fw ? u : 2 * L - 2 - u
            let i = min(floor(s), L - 2)
            let f = s - i
            model(MS[42], at: [lerp(R[i][0], R[i + 1][0], f), -0.3 + 0.015 * sin(time * 2 + k), lerp(R[i][2], R[i + 1][2], f)], turn: [0, deg(atan2((R[i + 1][0] - R[i][0]) * (fw ? 1 : -1), (R[i + 1][2] - R[i][2]) * (fw ? 1 : -1))), 0])
          }
        }
      }
      // the buildings: nothing here reads the clock
      for G, gk in OBJG {
        scene(CAM, light: LIGHT, ambient: 0.6) {
          for o in G { model(o.m, at: o.at, turn: o.t) }
        }
      }
      scene(CAM, light: LIGHT, ambient: 0.6) {
        // a rocket stands ready on its pad (one in the air is drawn below)
        if LREADY {
          for c in PADS { model(MS[54], at: [WX[c], 0.06, WZ[c]]) }
        }
        for c in SALE {
          model(MS[59], at: [WX[c], 0, WZ[c]], turn: [0, yaw, 0], scale: 1.6)
        }
        for c in BSTOPS {
          if SROT[c] >= 0 {
            model(MS[56], at: [WX[c], TER[c] == 6 ? 0.05 : 0, WZ[c]], turn: [0, SROT[c], 0])
          }
        }
      }
      // over them: lots rising out of the ground with a little bounce (and the lots round them), the rocket lifting
      // off, smoke from the chimneys
      scene(CAM, light: LIGHT, ambient: 0.6) {
        for f in FRL {
          let a = time >= f.t ? clamp((time - f.t) / 0.7, 0, 1) : 1
          model(MS[f.m], at: f.at, turn: [0, f.r, 0], scale: [1, max(0.05, (1 - pow(1 - a, 3)) * (1 + 0.18 * sin(a * pi))), 1])
        }
        for o in FNB { model(o.m, at: o.at, turn: o.t) }
        for c in PADS {
          let fa = c == lc && time >= lt && time - lt < 14 ? time - lt : -1
          if fa >= 0 {
            let ry = fa < 1.6 ? 0 : 0.7 * pow(fa - 1.6, 2)
            model(MS[54], at: [WX[c], 0.06 + ry, WZ[c]])
            model(PUFF, at: [WX[c], ry, WZ[c]], scale: [0.16 + 0.04 * sin(time * 40), 0.3, 0.16], color: #ffb43a, ambient: 1)
            for j in range(5) {
              let ph = (fa * 0.7 + j / 5) % 1
              model(PUFF, at: [WX[c] + cos(j * 1.3) * ph * 0.7, 0.08 + ph * 0.25, WZ[c] + sin(j * 1.3) * ph * 0.7], scale: 0.1 + ph * 0.35, color: alpha(#eeeeee, 0.9 - ph * 0.8), ambient: 0.95)
            }
          }
        }
        for S in STK {
          for j in range(3) {
            let ph = (time * 0.3 + j / 3 + S[3]) % 1
            model(PUFF, at: [S[0] + ph * 0.3, S[1] + 0.05 + ph * 0.8, S[2] - ph * 0.12], scale: 0.08 + 0.2 * sin(ph * pi), color: alpha(#f2f2f2, 0.9 - ph * 0.7), ambient: 0.95)
          }
        }
      }
      // the subway view: the tunnels over the city, as if seen through it
      if EOV == 6 {
        scene(CAM, light: LIGHT, ambient: 1) {
          for m in SUBM { model(m, at: [0, 0, 0], color: #2f6fe3, ambient: 1) }
        }
      }
      scene(CAM, light: LIGHT, ambient: 0.95) {
        for j in range(3) {
          let a = time * 0.015 + j * 1.57
          model(MS[43], at: [cos(a) * (19 + j), 4.5 + j * 0.4, sin(a) * (19 + j)], turn: [0, -deg(a), 0], scale: 1.3 + j * 0.25)
        }
      }

      // ---- clouds overhead: the light dims, just a little ----
      if DIMV > 0.002 {
        rect(0, 0, width, height, fill: alpha(#4a5568, DIMV))
      }

      // ---- numbers floating up from what grew or was collected ----
      for q in pops {
        let a = time - q.t
        if a >= 0 && a < 1.4 {
          let p = project([WX[q.c], q.y + a * 0.5, WZ[q.c]], CAM, width, height)
          if p != null {
            text(q.s, p.x + 1, p.y + 1, size: 16, font: FONT, align: center, color: #00000066)
            text(q.s, p.x, p.y, size: 16, font: FONT, align: center, color: q.col)
          }
        }
      }

      // One finger pans, or paints with a road, zone or bulldozer tool out; two pinch and turn; a tap acts.
      onTouch: {
        let T = touches
        if len(T) == 0 {
          if gm == 1 && len(fingers) > 0 {
            let sx = fingers[0].startX
            let sy = fingers[0].startY
            let hp = [[(2 * sx / SW - 1) * TH * SW / SH, (1 - 2 * sy / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
            let hx = floor(hp[0] + 11)
            let hz = floor(hp[1] + 11)
            let cell = hx >= 0 && hx < N && hz >= 0 && hz < N ? hz * N + hx : -1
            if cell < 0 {
              sel = -1
            } else if tool >= 10 {
              if !OWNED[cell] {
                msg = "BUY THIS LAND FIRST: TAP IT WITH NO TOOL"
                msgT = now
              } else if CL < TLV[tool] {
                msg = "UNLOCKS AT CITY LEVEL ${TLV[tool]}"
                msgT = now
              } else if tool == 25 {
                if KC[24] == 0 {
                  msg = "BUILD A BUS DEPOT FIRST"
                  msgT = now
                } else if GG[cell] != 1 {
                  msg = "BUS STOPS GO ON A ROAD"
                  msgT = now
                } else if any(BSTOPS, c => c == cell) {
                  stops = BSTOPS.filter(c => c != cell)
                  bank = coins + floor(TCOST[25] / 2)
                  since = tnow
                  msg = "BUS STOP REMOVED: +$${fmtNum(floor(TCOST[25] / 2))} BACK"
                  msgT = now
                } else if SROT[cell] < 0 {
                  msg = "NO SIDEWALK HERE: PICK A STRAIGHT ROAD OR A CORNER"
                  msgT = now
                } else if coins < TCOST[25] {
                  msg = "NOT ENOUGH MONEY"
                  msgT = now
                } else {
                  bank = coins - TCOST[25]
                  since = tnow
                  stops = BSTOPS + [cell]
                  haptic()
                  if snd { sound(SBUILD) }
                }
              } else if tool == 10 {
                if TER[cell] != 6 || GG[cell] != 6 {
                  msg = "LANDFILL GOES ON OPEN WATER"
                  msgT = now
                } else if CX[cell] == 0 || CZ[cell] == 0 || CX[cell] == N - 1 || CZ[cell] == N - 1 || !any(NB4[cell], n => n >= 0 && TER[n] != 6) {
                  msg = "FILL WATER RIGHT BESIDE THE LAND"
                  msgT = now
                } else if coins < FPRICE {
                  msg = "NOT ENOUGH MONEY"
                  msgT = now
                } else {
                  bank = coins - FPRICE
                  since = tnow
                  lf = FILL + [cell]
                  g = set(g, cell, 0)
                  lv = set(lv, cell, 0)
                  haptic()
                  if snd { sound(SBUILD) }
                }
              } else if tool == 24 && KC[24] >= 1 {
                msg = "ONE DEPOT RUNS ALL THE BUSES"
                msgT = now
              } else if tool == 20 && KC[20] >= 1 {
                msg = "A CITY HAS ONE BAY TOWER"
                msgT = now
              } else if tool == 23 && KC[23] >= 1 {
                msg = "A CITY HAS ONE LAUNCH PAD"
                msgT = now
              } else if tool == 23 && !HAS[6] {
                msg = "RESEARCH ROCKETRY FIRST"
                msgT = now
              } else if !(GG[cell] == 0 || GG[cell] == 5 || SANDOK[cell] || (GG[cell] >= 2 && GG[cell] <= 4 && LV[cell] == 0)) {
                msg = "PICK AN EMPTY TILE"
                msgT = now
              } else if coins < TCOST[tool] {
                msg = "NOT ENOUGH MONEY"
                msgT = now
              } else {
                bank = coins - TCOST[tool]
                since = tnow
                g = set(g, cell, tool)
                lv = set(lv, cell, 0)
                fresh = [{c: cell, t: time}]
                haptic()
                if snd { sound(SBUILD) }
              }
            } else if tool >= 1 {
              pa = cell
              pb = cell
            } else {
              // a lab opens its research list straight away
              sel = GG[cell] == 22 ? (sel == -6 ? -1 : -6) : sel == cell ? -1 : cell
              cat = -1
            }
          }
          if pa >= 0 && pb >= 0 && tool >= 1 && tool <= 9 {
            if len(PFILL) > 0 {
              let fill = PFILL
              sub = reduce(fill, (U, c) => set(U, c, 0), SUBL)
              msg = "TUNNEL FILLED IN"
              msgT = now
            } else if len(PV) == 0 {
              msg = any(PCELLS, c => !OWNED[c]) ? "BUY THIS LAND FIRST: TAP IT WITH NO TOOL" : tool == 9 ? "NOTHING TO CLEAR THERE" : "CAN'T BUILD THERE"
              msgT = now
            } else if coins < PNET {
              msg = "NOT ENOUGH MONEY"
              msgT = now
            } else {
              let done = PV
              bank = coins - PNET
              since = tnow
              if PREF > 0 {
                msg = "+$${fmtNum(PREF)} BACK FOR THE BUILDING${count(done, c => GG[c] >= 11) == 1 ? "" : "S"}"
                msgT = now
              }
              if tool == 8 {
                sub = reduce(done, (U, c) => set(U, c, 1), SUBL)
              } else {
                g = reduce(done, (G, c) => set(G, c, tool == 9 ? (TER[c] == 6 ? 6 : 0) : tool), g)
                lv = reduce(done, (L, c) => set(L, c, 0), lv)
              }
              if any(done, c => c == sel) { sel = -1 }
              haptic()
              if snd { sound(SBUILD) }
            }
          }
          gm = 0
          pa = -1
          pb = -1
        } else if len(T) == 1 {
          let t = T[0]
          if gm == 0 {
            gm = 1
            downT = time
            let hp = [[(2 * t.x / SW - 1) * TH * SW / SH, (1 - 2 * t.y / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
            let hx = floor(hp[0] + 11)
            let hz = floor(hp[1] + 11)
            downC = hx >= 0 && hx < N && hz >= 0 && hz < N ? hz * N + hx : -1
          }
          // moved before the hold: it's a pan, whatever tool is out
          if gm == 1 && abs(t.x - t.startX) + abs(t.y - t.startY) > 16 {
            gm = 2
          }
          if gm == 2 && len(fingers) == 1 && fingers[0].id == t.id {
            let w0 = [[(2 * (fingers[0].x) / SW - 1) * TH * SW / SH, (1 - 2 * (fingers[0].y) / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
            let w1 = [[(2 * (t.x) / SW - 1) * TH * SW / SH, (1 - 2 * (t.y) / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
            tx = clamp(tx + w0[0] - w1[0], -12, 12)
            tz = clamp(tz + w0[1] - w1[1], -12, 12)
          }
          if gm == 3 {
            let hp = [[(2 * t.x / SW - 1) * TH * SW / SH, (1 - 2 * t.y / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
            pb = clamp(floor(hp[1] + 11), 0, N - 1) * N + clamp(floor(hp[0] + 11), 0, N - 1)
          }
        } else {
          if gm == 3 {
            pa = -1
            pb = -1
          }
          gm = 4
          if len(fingers) >= 2 {
            let a = T[0]
            let b = T[1]
            let a0 = first(fingers.filter(f => f.id == a.id))
            let b0 = first(fingers.filter(f => f.id == b.id))
            if a0 != null && b0 != null {
              let d1 = sqrt(pow(a.x - b.x, 2) + pow(a.y - b.y, 2))
              let d0 = sqrt(pow(a0.x - b0.x, 2) + pow(a0.y - b0.y, 2))
              let w0 = [[(2 * ((a0.x + b0.x) / 2) / SW - 1) * TH * SW / SH, (1 - 2 * ((a0.y + b0.y) / 2) / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
              zoom = clamp(zoom * d0 / max(1, d1), 8, 48)
              yaw = yaw + ((deg(atan2(b.y - a.y, b.x - a.x) - atan2(b0.y - a0.y, b0.x - a0.x)) + 540) % 360 - 180)
              let w1 = [[(2 * ((a.x + b.x) / 2) / SW - 1) * TH * SW / SH, (1 - 2 * ((a.y + b.y) / 2) / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
              tx = clamp(tx + w0[0] - w1[0], -12, 12)
              tz = clamp(tz + w0[1] - w1[1], -12, 12)
            }
          }
        }
        fingers = T
      }
    }

    // ---- warnings over lots: they move only with the view, so this Canvas reads no time ----
    Canvas {
      fill: true
      for w in WARN {
        let p = project([WX[w[0]], 0.62, WZ[w[0]]], CAM, width, height)
        if p != null {
          // a badge in the color of what's missing, ringed in white: a no-entry bar (no road), a bolt (no power),
          // a drop (no water)
          circle(p.x, p.y + 2.5, 13, fill: #00000044)
          circle(p.x, p.y, 13, fill: #ffffff)
          circle(p.x, p.y, 10.5, fill: [CORAL, #ffc21a, #2f8fe8][w[1]])
          if w[1] == 0 {
            rect(p.x - 6.5, p.y - 2.2, 13, 4.4, fill: #ffffff)
          } else if w[1] == 1 {
            path([[p.x + 2, p.y - 8], [p.x - 5, p.y + 1], [p.x - 0.5, p.y + 1], [p.x - 2, p.y + 8], [p.x + 5, p.y - 1], [p.x + 0.5, p.y - 1]], closed: true, fill: INK)
          } else {
            circle(p.x, p.y + 2, 4.6, fill: #ffffff)
            path([[p.x, p.y - 7.5], [p.x - 4.3, p.y + 0.6], [p.x + 4.3, p.y + 0.6]], closed: true, fill: #ffffff)
          }
        }
      }
    }

    // ---- along the top: level, cash, people, happiness; the quest and the demand ----
    Column {
      fill: width
      gap: 8
      padding: [10, TOP, 10, 0]
      Row {
        fill: width
        gap: 6
        Column {
          gap: 0
          padding: [0, 0, 0, 4]
          background: INK2
          onTap: {
            sel = sel == -2 ? -1 : -2
            tool = 0
            cat = -1
          }
          Column {
            gap: 4
            width: 128
            height: 48
            justify: center
            padding: [10, 0]
            background: INK
            Text { text: "LV ${CL} ${upper(LVN[CL - 1])}"; font: FONT; fontSize: 12; color: SUN; maxLines: 1 }
            Box {
              width: 96
              height: 6
              background: #3a4870
              Spacer { width: 96 * XPF; height: 6; background: SUN }
            }
          }
        }
        Column {
          gap: 0
          weight: 1
          Column {
            gap: 1
            height: 48
            justify: center
            padding: [10, 0]
            fill: width
            background: INK
            Text { text: HMON; font: FONT; fontSize: 18; color: coins < 0 ? CORAL : CRM; maxLines: 1 }
            Text { text: HRATE; font: FONT; fontSize: 10; color: RATE * 60 > -0.5 ? TEAL : CORAL; maxLines: 1 }
          }
          Spacer { fill: width; height: 4; background: INK2 }
        }
        Column {
          gap: 0
          padding: [0, 0, 0, 4]
          background: INK2
          Column {
            gap: 1
            width: 84
            height: 48
            justify: center
            padding: [10, 0]
            background: INK
            Text { text: HPOP; font: FONT; fontSize: 18; color: CRM; maxLines: 1 }
            Text { text: "RESIDENTS"; font: FONT; fontSize: 9; color: MUT }
          }
        }
        Column {
          gap: 0
          padding: [0, 0, 0, 4]
          background: INK2
          onTap: {
            sel = sel == -2 ? -1 : -2
            tool = 0
            cat = -1
          }
          Column {
            gap: 1
            width: 66
            height: 48
            justify: center
            padding: [10, 0]
            background: INK
            Text { text: "${APR}%"; font: FONT; fontSize: 18; color: APR >= 70 ? TEAL : APR >= 45 ? SUN : CORAL; maxLines: 1 }
            Text { text: "HAPPY"; font: FONT; fontSize: 9; color: MUT }
          }
        }
      }
      Row {
        fill: width
        gap: 6
        align: top
        if Q != null {
          Column {
            gap: 0
            weight: 1
            onTap: {
              if QOK {
                bank = coins + Q.r
                since = tnow
                msg = "QUEST DONE! +$${fmtNum(Q.r)}"
                msgT = now
                qi = qi + 1
                haptic()
                if snd { sound(SCHIME) }
              }
            }
            Row {
              fill: width
              gap: 8
              height: 52
              align: center
              padding: [10, 0]
              background: QOK ? SUN : CRM
              Text { text: "★"; font: FONT; fontSize: 16; color: QOK ? INK : SUN2 }
              Column {
                gap: 0
                weight: 1
                Text { text: QOK ? "DONE! TAP FOR +$${fmtNum(Q.r)}" : "QUEST ${qi + 1} · ${fmtNum(min(QV, Q.g))}/${fmtNum(Q.g)}"; font: FONT; fontSize: 10; color: QOK ? INK : SUN2; maxLines: 1 }
                Text { text: Q.t; font: FONT; fontSize: 13; color: INK; maxLines: 2 }
              }
            }
            Spacer { fill: width; height: 4; background: QOK ? SUN2 : CRM2 }
          }
        } else {
          Spacer { weight: 1; height: 1 }
        }
        Column {
          gap: 0
          padding: [0, 0, 0, 4]
          background: INK2
          onTap: {
            ov = ov >= 0 ? -1 : 0
            sel = -1
          }
          // the map views: a little heat map
          Canvas {
            width: 50
            height: 52
            rect(0, 0, 50, 52, fill: ov >= 0 ? SUN : INK)
            rect(13, 8, 11, 11, fill: #4cc76a)
            rect(26, 8, 11, 11, fill: #f2c43a)
            rect(13, 21, 11, 11, fill: #f2c43a)
            rect(26, 21, 11, 11, fill: #e4574a)
            text("MAP", 25, 42, size: 10, font: FONT, align: center, color: ov >= 0 ? INK : MUT)
          }
        }
        Column {
          gap: 0
          padding: [0, 0, 0, 4]
          background: INK2
          onTap: {
            sel = sel == -7 ? -1 : -7
            tool = 0
            cat = -1
          }
          // the sun (behind a cloud while it's clouding over, or just a cloud) and how full the batteries are
          Canvas {
            width: 50
            height: 52
            rect(0, 0, 50, 52, fill: INK)
            if WX0 == 0 {
              for t in range(8) {
                rotate(t * 45, 25, 17) { rect(24, 5, 2, 4, fill: SUN) }
              }
              circle(25, 17, 6.5, fill: SUN)
            } else if WX0 == 1 {
              for t in range(8) {
                rotate(t * 45, 20, 14) { rect(19, 4, 2, 3, fill: SUN) }
              }
              circle(20, 14, 5.5, fill: SUN)
              circle(24, 21, 4.5, fill: CRM)
              circle(30, 18, 6, fill: CRM)
              circle(35, 21.5, 4, fill: CRM)
              rect(24, 21, 11, 4.5, fill: CRM)
            } else {
              circle(18, 20, 5, fill: MUT)
              circle(25, 16, 7, fill: MUT)
              circle(32, 20, 5.5, fill: MUT)
              rect(18, 20, 14, 5.5, fill: MUT)
            }
            rect(10.5, 31.5, 27, 11, stroke: DARK > 0 ? CORAL : CRM, width: 1.5)
            rect(38.5, 34.5, 2.5, 5, fill: DARK > 0 ? CORAL : CRM)
            rect(12.5, 33.5, 23 * BPCT, 7, fill: BPCT > 0.25 ? TEAL : CORAL)
          }
        }
        Column {
          gap: 0
          padding: [0, 0, 0, 4]
          background: INK2
          onTap: {
            sel = sel == -2 || sel == -3 || sel == -4 ? -1 : -2
            tool = 0
            cat = -1
          }
          // a gear: City Hall, with the taxes, sounds and cities
          Canvas {
            width: 50
            height: 52
            rect(0, 0, 50, 52, fill: INK)
            for t in range(8) {
              rotate(t * 45, 25, 21) { rect(22.5, 10, 5, 5, fill: CRM) }
            }
            circle(25, 21, 8, fill: CRM)
            circle(25, 21, 3.5, fill: INK)
            text("CITY", 25, 42, size: 10, font: FONT, align: center, color: MUT)
          }
        }
        Column {
          gap: 0
          padding: [0, 0, 0, 4]
          background: INK2
          onTap: {
            sel = sel == -5 ? -1 : -5
            tool = 0
            cat = -1
          }
          Row {
            gap: 5
            height: 52
            align: center
            padding: [9, 0]
            background: INK
            for d, i in [DR, DC, DI] {
              Column {
                gap: 2
                align: center
                Box {
                  width: 9
                  height: 28
                  align: bottom
                  background: #3a4870
                  Spacer { width: 9; height: 28 * max(0.08, (d + 1) / 2); background: d > 0 ? ZCOL[i] : #6b7894 }
                }
                Text { text: ["R", "C", "I"][i]; font: FONT; fontSize: 10; color: ZCOL[i] }
              }
            }
          }
        }
      }
    }

    // ---- along the bottom: messages, the tile looked at, the city hall, the tools ----
    Column {
      fill: true
      justify: end
      gap: 6
      padding: [10, 0, 10, INS + 10]
      if msg != "" && (now ?? 0) - msgT < 3 {
        Row {
          fill: width
          justify: center
          Text { text: msg; font: FONT; fontSize: 15; color: INK; background: SUN; padding: [16, 9]; align: center }
        }
      }
      if gm == 3 && pa >= 0 && pb >= 0 {
        Row {
          fill: width
          justify: center
          Text { text: "${len(PV)} TILE${len(PV) == 1 ? "" : "S"} · ${PNET < 0 ? "+$" + fmtNum(-PNET) + " BACK" : "$" + fmtNum(PNET)}"; font: FONT; fontSize: 15; color: PNET < 0 ? SUN : coins >= PNET ? CRM : CORAL; background: INK; padding: [16, 9] }
        }
      }
      if sel >= 0 && tool == 0 {
        Column {
          gap: 0
          fill: width
          Column {
            gap: 3
            fill: width
            padding: [12, 10]
            background: CRM
            Row {
              fill: width
              align: center
              Text { text: upper(SNAME); font: FONT; fontSize: 17; color: INK; weight: 1; maxLines: 1 }
              if SK >= 2 && SK <= 4 && SL > 0 { Text { text: ["", "★", "★★", "★★★", "★★★★"][SL]; font: FONT; fontSize: 16; color: SUN2 } }
              Text { text: "✕"; font: FONT; fontSize: 17; color: #8a7a5a; padding: [10, 0, 0, 0]; onTap: sel = -1 }
            }
            for line, i in SINFO {
              Text { text: line; font: FONT; fontSize: 12; color: SK >= 2 && SK <= 4 && i == 5 ? #b0661a : #4a5470; maxLines: SK >= 2 && SK <= 4 && i >= 2 ? 3 : 2 }
            }
            if SK >= 13 && SK <= 16 {
              Text { text: "SHOW ${upper(["police", "fire", "clinic", "school"][SK - 13])} ACROSS THE CITY"; font: FONT; fontSize: 13; color: CRM; background: INK; fill: width; align: center; padding: [0, 8]; onTap: {
                ov = SK - 13
                sel = -1
              } }
            }
            if sel >= 0 && !OWNED[sel] && TER[sel] != 6 && BUYABLE[PAR[sel]] {
              Text { text: "BUY THIS LAND · $${fmtNum(LPRICE)}"; font: FONT; fontSize: 14; color: INK; background: SUN; fill: width; align: center; padding: [0, 8]; onTap: {
                if coins < LPRICE {
                  msg = "NOT ENOUGH MONEY"
                  msgT = now
                } else {
                  bank = coins - LPRICE
                  since = tnow
                  own = set(OWNL, PAR[sel], 1)
                  sel = -1
                  msg = "LAND BOUGHT!"
                  msgT = now
                  haptic()
                  if snd { sound(SCHIME) }
                }
              } }
            }
            if SK == 22 {
              Text { text: "OPEN RESEARCH"; font: FONT; fontSize: 14; color: CRM; background: #9b7be0; fill: width; align: center; padding: [0, 8]; onTap: sel = -6 }
            }
            if SK == 23 {
              Text { text: LREADY ? "LAUNCH · $${fmtNum(LCOST)}" : "NEXT ROCKET IN ${lastL + 180 - (now ?? 0)}S"; font: FONT; fontSize: 14; color: LREADY ? CRM : #8a7a5a; background: LREADY ? CORAL : #eadfc4; fill: width; align: center; padding: [0, 8]; onTap: {
                if !LREADY {
                  msg = "THE NEXT ROCKET ISN'T READY YET"
                  msgT = now
                } else if coins < LCOST {
                  msg = "NOT ENOUGH MONEY FOR FUEL"
                  msgT = now
                } else {
                  bank = coins - LCOST
                  since = tnow
                  lastL = now
                  lc = sel
                  lt = time
                  rw = LREW
                  payAt = now + 9
                  nl = nl + 1
                  sel = -1
                  msg = "3, 2, 1... LIFTOFF!"
                  msgT = now
                  haptic()
                }
              } }
            }
          }
          Spacer { fill: width; height: 4; background: CRM2 }
        }
      }
      if sel == -2 {
        Column {
          gap: 0
          fill: width
          Column {
            gap: 4
            fill: width
            padding: [12, 10]
            background: CRM
            Row {
              fill: width
              align: center
              Text { text: "CITY HALL"; font: FONT; fontSize: 17; color: INK; weight: 1 }
              Text { text: "✕"; font: FONT; fontSize: 17; color: #8a7a5a; padding: [10, 0, 0, 0]; onTap: sel = -1 }
            }
            Row {
              fill: width
              gap: 6
              align: center
              Column {
                gap: 0
                weight: 1
                Text { text: upper(MP.n); font: FONT; fontSize: 13; color: INK; maxLines: 1 }
                Text { text: "${1 + len(saves)} of 4 cities"; font: FONT; fontSize: 10; color: #8a7a5a }
              }
              Text { text: "CITIES"; font: FONT; fontSize: 14; color: INK; background: SUN; width: 104; align: center; padding: [0, 5]; onTap: {
                sel = -3
                armDel = -1
              } }
            }
            Row {
              fill: width
              gap: 6
              align: center
              Column {
                gap: 0
                weight: 1
                Text { text: "TECHNOLOGY"; font: FONT; fontSize: 13; color: INK }
                Text { text: rk >= 0 ? "Researching ${TECH[rk].n}" + (len(rq) > 0 ? " · ${len(rq)} queued" : "") : "${len(tech)} of ${len(TECH)} researched"; font: FONT; fontSize: 10; color: #8a7a5a; maxLines: 1 }
              }
              Text { text: "RESEARCH"; font: FONT; fontSize: 14; color: CRM; background: #9b7be0; width: 104; align: center; padding: [0, 5]; onTap: sel = -6 }
            }
            Row {
              fill: width
              gap: 6
              align: center
              Column {
                gap: 0
                weight: 1
                Text { text: "TAX RATE"; font: FONT; fontSize: 13; color: INK }
                Text { text: tax > 11 ? "high: people grumble" : tax < 7 ? "low: people move in" : "fair"; font: FONT; fontSize: 10; color: #8a7a5a }
              }
              Text { text: "−"; font: FONT; fontSize: 18; color: CRM; background: INK; width: 40; align: center; padding: [0, 5]; onTap: {
                bank = coins
                since = tnow
                tax = max(4, tax - 1)
              } }
              Text { text: "${tax}%"; font: FONT; fontSize: 18; color: INK; width: 50; align: center }
              Text { text: "+"; font: FONT; fontSize: 18; color: CRM; background: INK; width: 40; align: center; padding: [0, 5]; onTap: {
                bank = coins
                since = tnow
                tax = min(16, tax + 1)
              } }
            }
            Row {
              fill: width
              align: center
              Text { text: "SOUNDS"; font: FONT; fontSize: 13; color: INK; weight: 1 }
              Text { text: snd ? "ON" : "OFF"; font: FONT; fontSize: 14; color: snd ? INK : CRM; background: snd ? TEAL : #8a7a5a; width: 70; align: center; padding: [0, 5]; onTap: snd = !snd }
            }
            Text { text: "Taxes +$${fmtNum(INC * 60)} · upkeep -$${fmtNum(UPK * 60)} a minute"; font: FONT; fontSize: 12; color: #4a5470 }
            Text { text: "Sun ${round(SOLNOW)} for ${round(PUSE)} used · batteries ${round(BPCT * 100)}% · water ${round(WUSE)}/${round(WSUP)}"; font: FONT; fontSize: 12; color: #4a5470 }
            Text { text: "Jobs ${fmtNum(JOBS)} for ${fmtNum(round(POP * 0.5))} workers"; font: FONT; fontSize: 12; color: #4a5470 }
            Text { text: CL >= 9 ? "Top level reached!" : "Next level at ${fmtNum(THR[CL])} residents"; font: FONT; fontSize: 12; color: #4a5470 }
            for a in ADV.take(3) {
              Text { text: "• " + a; font: FONT; fontSize: 12; color: #b0661a; maxLines: 2 }
            }
          }
          Spacer { fill: width; height: 4; background: CRM2 }
        }
      }
      if sel == -7 {
        Column {
          gap: 0
          fill: width
          Column {
            gap: 4
            fill: width
            padding: [12, 10]
            background: CRM
            Row {
              fill: width
              align: center
              Text { text: "POWER"; font: FONT; fontSize: 17; color: INK; weight: 1 }
              Text { text: WEATHER; font: FONT; fontSize: 13; color: SUN2; padding: [0, 0, 10, 0] }
              Text { text: "✕"; font: FONT; fontSize: 17; color: #8a7a5a; onTap: sel = -1 }
            }
            Text { text: "Solar makes ${round(SOLNOW)} now (${round(SUNV * 100)}% sun), ${round(SOLCAP)} at noon"; font: FONT; fontSize: 12; color: #4a5470 }
            Text { text: "The city uses ${round(PUSE)}"; font: FONT; fontSize: 12; color: #4a5470 }
            Canvas {
              fill: width
              height: 12
              rect(0, 0, width, 12, fill: #eadfc4)
              rect(0, 0, width * BPCT, 12, fill: BPCT > 0.25 ? TEAL : CORAL)
            }
            Text { text: BCAP == 0 ? "No batteries: the city goes dark whenever clouds come" : "Batteries ${fmtNum(round(batt))} of ${fmtNum(BCAP)} · " + (SOLNOW > PUSE ? "charging" : batt > 0 ? "running the city" : "empty"); font: FONT; fontSize: 12; color: #4a5470 }
            Text { text: "Cloudy spells last over a minute: storing ${fmtNum(round(PUSE * 96))} gets the city through"; font: FONT; fontSize: 11; color: #8a7a5a; maxLines: 2 }
            if DARK > 0 {
              Text { text: "${DARK} building${DARK == 1 ? " is" : "s are"} dark: no taxes, no growth"; font: FONT; fontSize: 12; color: CORAL; maxLines: 2 }
            }
            Text { text: "RESEARCH BETTER PANELS AND BATTERIES"; font: FONT; fontSize: 13; color: CRM; background: #9b7be0; fill: width; align: center; padding: [0, 7]; onTap: sel = -6 }
          }
          Spacer { fill: width; height: 4; background: CRM2 }
        }
      }
      if sel == -6 {
        Column {
          gap: 0
          fill: width
          Column {
            gap: 5
            fill: width
            padding: [12, 10]
            background: CRM
            Row {
              fill: width
              align: center
              Text { text: "RESEARCH LAB"; font: FONT; fontSize: 17; color: INK; weight: 1 }
              Text { text: "✕"; font: FONT; fontSize: 17; color: #8a7a5a; padding: [10, 0, 0, 0]; onTap: sel = -1 }
            }
            if KC[22] == 0 {
              Text { text: CL < 3 ? "Reach city level 3, then build a lab (Service) to research new technology" : "Build a lab (Service) to research new technology"; font: FONT; fontSize: 12; color: #b0661a; maxLines: 2 }
            }
            Column {
              gap: 4
              fill: width
              height: min(330, (screenHeight ?? 800) * 0.42)
              scroll: true
              for i, k in TORD {
                let t = TECH[i]
                if k == 0 || TECH[TORD[k - 1]].g != t.g {
                  Text { text: TGROUP[t.g] + " · ${count(range(len(TECH)), j => TECH[j].g == t.g && HAS[j])}/${count(TECH, x => x.g == t.g)}"; font: FONT; fontSize: 11; color: SUN2; padding: [2, 6, 0, 0] }
                }
                Row {
                  fill: width
                  gap: 8
                  align: center
                  padding: [8, 6]
                  background: HAS[i] ? #e3f3e6 : rk == i || any(rq, q => q == i) ? #efe6fb : #f9efd9
                  Column {
                    gap: 0
                    weight: 1
                    Text { text: upper(t.n); font: FONT; fontSize: 13; color: INK; maxLines: 1 }
                    Text { text: t.d; font: FONT; fontSize: 10; color: #8a7a5a; maxLines: 2 }
                  }
                  if HAS[i] {
                    Text { text: "DONE"; font: FONT; fontSize: 12; color: #2f9a5a }
                  } else if rk == i {
                    Text { text: "${max(0, rEnd - (now ?? 0))}S"; font: FONT; fontSize: 13; color: #9b7be0 }
                  } else if any(rq, q => q == i) {
                    Text { text: "QUEUED\n#${first(range(len(rq)).filter(j => rq[j] == i)) + 1}"; font: FONT; fontSize: 11; color: #9b7be0; width: 72; align: center }
                  } else if CL < t.lv {
                    Text { text: "LEVEL ${t.lv}"; font: FONT; fontSize: 11; color: #8a7a5a }
                  } else if t.req >= 0 && !HAS[t.req] && rk != t.req && !any(rq, q => q == t.req) {
                    Text { text: "AFTER ${upper(TECH[t.req].n)}"; font: FONT; fontSize: 9; color: #8a7a5a; width: 72; align: end; maxLines: 2 }
                  } else {
                    Text { text: "$${fmtNum(t.c)}\n${t.m} MIN"; font: FONT; fontSize: 11; color: CRM; background: KC[22] > 0 ? #9b7be0 : #c3b8d8; width: 72; align: center; padding: [0, 4]; onTap: {
                      if KC[22] == 0 {
                        msg = "BUILD A LAB FIRST"
                        msgT = now
                      } else if coins < t.c {
                        msg = "NOT ENOUGH MONEY"
                        msgT = now
                      } else if rk >= 0 {
                        // paid now, started when the research before it is done
                        bank = coins - t.c
                        since = tnow
                        rq = rq + [i]
                        msg = "QUEUED: ${upper(t.n)}"
                        msgT = now
                        haptic()
                      } else {
                        bank = coins - t.c
                        since = tnow
                        rk = i
                        rEnd = now + round(t.m * 60)
                        msg = "RESEARCHING ${upper(t.n)}"
                        msgT = now
                        haptic()
                      }
                    } }
                  }
                }
              }
            }
          }
          Spacer { fill: width; height: 4; background: CRM2 }
        }
      }
      if sel == -5 {
        Column {
          gap: 0
          fill: width
          Column {
            gap: 5
            fill: width
            padding: [12, 10]
            background: CRM
            Row {
              fill: width
              align: center
              Text { text: "DEMAND"; font: FONT; fontSize: 17; color: INK; weight: 1 }
              Text { text: "✕"; font: FONT; fontSize: 17; color: #8a7a5a; padding: [10, 0, 0, 0]; onTap: sel = -1 }
            }
            for r, i in RCIL {
              Column {
                gap: 3
                fill: width
                padding: [0, 4, 0, 4]
                Row {
                  fill: width
                  gap: 8
                  align: center
                  Spacer { size: 12; background: ZCOL[i] }
                  Text { text: r.n; font: FONT; fontSize: 14; color: INK; weight: 1 }
                  Text { text: DWORD[i]; font: FONT; fontSize: 13; color: r.d > 0.05 ? #2f9a5a : r.d > -0.3 ? #8a7a5a : CORAL }
                }
                // the bar runs from too many (left) to wanted (right), from the middle
                Canvas {
                  fill: width
                  height: 10
                  rect(0, 0, width, 10, fill: #eadfc4)
                  if r.d > 0 {
                    rect(width / 2, 0, width / 2 * r.d, 10, fill: ZCOL[i])
                  } else {
                    rect(width / 2 + width / 2 * r.d, 0, -width / 2 * r.d, 10, fill: #c0ae8c)
                  }
                  rect(width / 2 - 1, 0, 2, 10, fill: INK)
                }
                Text { text: r.a; font: FONT; fontSize: 11; color: #4a5470; maxLines: 2 }
                Text { text: r.b; font: FONT; fontSize: 11; color: #b0661a; maxLines: 2 }
              }
            }
          }
          Spacer { fill: width; height: 4; background: CRM2 }
        }
      }
      if sel == -3 {
        Column {
          gap: 0
          fill: width
          Column {
            gap: 6
            fill: width
            padding: [12, 10]
            background: CRM
            Row {
              fill: width
              align: center
              Text { text: "YOUR CITIES"; font: FONT; fontSize: 17; color: INK; weight: 1 }
              Text { text: "✕"; font: FONT; fontSize: 17; color: #8a7a5a; padding: [10, 0, 0, 0]; onTap: sel = -1 }
            }
            Row {
              fill: width
              gap: 10
              align: center
              padding: [10, 8]
              background: #f3e2bd
              Spacer { size: 14; background: MP.tc[0]; border: 2; borderColor: INK }
              Column {
                gap: 0
                weight: 1
                Text { text: upper(MP.n); font: FONT; fontSize: 14; color: INK; maxLines: 1 }
                Text { text: "LV ${CL} · ${fmtNum(POP)} residents · ${HMON}"; font: FONT; fontSize: 10; color: #8a7a5a; maxLines: 1 }
              }
              Text { text: "PLAYING"; font: FONT; fontSize: 11; color: SUN2 }
            }
            for sv, i in saves {
              Row {
                fill: width
                gap: 10
                align: center
                padding: [10, 8]
                background: #f9efd9
                Spacer { size: 14; background: MAPS[sv.m].tc[0]; border: 2; borderColor: INK }
                Column {
                  gap: 0
                  weight: 1
                  onTap: {
                    let nx = sv
                    saves = set(saves, i, {m: mapk, g: g, lv: lv, bank: coins, since: tnow, best: best, seen: seen, qi: qi, tax: tax, yaw: yaw, zoom: zoom, tx: tx, tz: tz, pop: POP, cl: CL, batt: batt, tech: tech, rk: rk, rEnd: rEnd, rq: rq, lf: FILL, nl: nl, lastL: lastL, wx0: wx0, sub: SUBL, stops: BSTOPS, mapv: mapv, own: OWNL})
                    mapk = nx.m
                    g = nx.g
                    lv = nx.lv
                    bank = nx.bank
                    since = nx.since
                    best = nx.best
                    seen = nx.seen
                    qi = nx.qi
                    tax = nx.tax
                    yaw = nx.yaw
                    zoom = nx.zoom
                    tx = nx.tx
                    tz = nx.tz
                    batt = nx.batt ?? 0
                    tech = nx.tech ?? []
                    rk = nx.rk ?? -1
                    rEnd = nx.rEnd ?? 0
                    rq = nx.rq ?? []
                    lf = nx.lf ?? []
                    nl = nx.nl ?? 0
                    lastL = nx.lastL ?? 0
                    wx0 = nx.wx0 ?? 0
                    sub = nx.sub ?? []
                    stops = nx.stops ?? []
                    mapv = nx.mapv ?? 0
                    own = nx.own ?? []
                    sel = -1
                    tool = 0
                    cat = -1
                    fresh = []
                    pops = []
                    armDel = -1
                    let gain = floor(coins - bank)
                    msg = gain > 0 ? "${upper(MP.n)} · +$${fmtNum(gain)} WHILE AWAY" : upper(MP.n)
                    msgT = now
                  }
                  Text { text: upper(MAPS[sv.m].n); font: FONT; fontSize: 14; color: INK; maxLines: 1 }
                  Text { text: "LV ${sv.cl} · ${fmtNum(sv.pop)} residents · TAP TO PLAY"; font: FONT; fontSize: 10; color: #8a7a5a; maxLines: 1 }
                }
                Text { text: armDel == i ? "DELETE" : "✕"; font: FONT; fontSize: armDel == i ? 12 : 16; color: armDel == i ? CRM : #8a7a5a; background: armDel == i ? CORAL : alpha(CRM, 0); padding: [10, 6]; onTap: {
                  if armDel == i {
                    saves = remove(saves, i)
                    armDel = -1
                  } else {
                    armDel = i
                  }
                } }
              }
            }
            if len(saves) < 3 {
              Column {
                gap: 0
                fill: width
                padding: [0, 0, 0, 4]
                background: SUN2
                onTap: sel = -4
                Text { text: "+ NEW CITY"; font: FONT; fontSize: 15; color: INK; background: SUN; fill: width; align: center; padding: [0, 10] }
              }
            } else {
              Text { text: "Four cities is the most: delete one to start another"; font: FONT; fontSize: 11; color: #b0661a }
            }
          }
          Spacer { fill: width; height: 4; background: CRM2 }
        }
      }
      if sel == -4 {
        Column {
          gap: 0
          fill: width
          Column {
            gap: 6
            fill: width
            padding: [12, 10]
            background: CRM
            Row {
              fill: width
              align: center
              Text { text: "NEW CITY"; font: FONT; fontSize: 17; color: INK; weight: 1 }
              Text { text: "BACK"; font: FONT; fontSize: 13; color: #8a7a5a; padding: [10, 0, 0, 0]; onTap: sel = -3 }
            }
            Text { text: "Pick a place to build. ${upper(MP.n)} is kept and earns a little while you play here."; font: FONT; fontSize: 11; color: #8a7a5a; maxLines: 2 }
            Text { text: "Easy: more taxes, cheaper upkeep and land. Hard: less cash, dearer upkeep and land, longer cloudy spells."; font: FONT; fontSize: 10; color: #8a7a5a; maxLines: 3 }
            for pair in [[0, 1], [2, 3]] {
              Row {
                fill: width
                gap: 6
                for k in pair {
                  Column {
                    gap: 0
                    weight: 1
                    padding: [0, 0, 0, 4]
                    background: INK2
                    onTap: {
                      if len(saves) >= 3 {
                        msg = "DELETE A CITY FIRST"
                        msgT = now
                      } else {
                        saves = saves + [{m: mapk, g: g, lv: lv, bank: coins, since: tnow, best: best, seen: seen, qi: qi, tax: tax, yaw: yaw, zoom: zoom, tx: tx, tz: tz, pop: POP, cl: CL, batt: batt, tech: tech, rk: rk, rEnd: rEnd, rq: rq, lf: FILL, nl: nl, lastL: lastL, wx0: wx0, sub: SUBL, stops: BSTOPS, mapv: mapv, own: OWNL}]
                        mapk = k
                        mapv = 2
                        own = []
                        g = G0S1[k]
                        lv = range(NN).map(c => 0)
                        bank = DIFF[MAPS[k].lvl].cash
                        since = tnow
                        best = 0
                        seen = 1
                        qi = 0
                        tax = 9
                        yaw = 35
                        zoom = 30
                        tx = -6
                        tz = 0.5
                        batt = 0
                        tech = []
                        rk = -1
                        rEnd = 0
                        rq = []
                        lf = []
                        nl = 0
                        lastL = 0
                        wx0 = 0
                        sub = []
                        stops = []
                        sel = -1
                        tool = 0
                        cat = -1
                        fresh = []
                        pops = []
                            msg = "WELCOME TO ${upper(MAPS[k].n)}!"
                        msgT = now
                        haptic()
                        if snd { sound(SCHIME) }
                      }
                    }
                    Column {
                      gap: 3
                      fill: width
                      padding: [8, 8]
                      background: INK
                      // the map from above, the highway coming in on the left
                      Canvas {
                        fill: width
                        height: 74
                        let cs = min(width, height) / 22
                        let ox = (width - cs * 22) / 2
                        rect(ox, 0, cs * 22, cs * 22, fill: MAPS[k].tc[0])
                        for q in MINI[k] {
                          rect(ox + q[0] * cs, q[1] * cs, cs + 0.4, cs + 0.4, fill: q[2])
                        }
                        rect(0, 11 * cs, ox, cs, fill: #5f6675)
                      }
                      Text { text: upper(MAPS[k].n); font: FONT; fontSize: 13; color: CRM; maxLines: 1 }
                      Text { text: "${DIFF[MAPS[k].lvl].n} · $${fmtNum(DIFF[MAPS[k].lvl].cash)}"; font: FONT; fontSize: 10; color: [TEAL, SUN, CORAL][MAPS[k].lvl]; maxLines: 1 }
                      Text { text: MAPS[k].d; font: FONT; fontSize: 10; color: MUT; maxLines: 2; minLines: 2 }
                    }
                  }
                }
              }
            }
          }
          Spacer { fill: width; height: 4; background: CRM2 }
        }
      }
      if EOV >= 0 {
        Column {
          gap: 0
          fill: width
          padding: [0, 0, 0, 4]
          background: INK2
          Column {
            gap: 6
            fill: width
            padding: [10, 8]
            background: INK
            Row {
              fill: width
              gap: 8
              align: center
              Text { text: EOV == 4 ? "LAND VALUE" : EOV == 5 ? "TRAFFIC" : EOV == 6 ? "SUBWAY · TUNNELS AND STATIONS' REACH" : "${upper(["police", "fire", "clinic", "school"][EOV])} · HOW FAST HELP COMES"; font: FONT; fontSize: 12; color: CRM; weight: 1; maxLines: 1 }
              if (tool < 13 || tool > 16) && tool != 8 && tool < 24 {
                Text { text: "✕"; font: FONT; fontSize: 15; color: MUT; padding: [8, 0, 0, 0]; onTap: ov = -1 }
              }
            }
            Row {
              fill: width
              gap: 8
              align: center
              Text { text: EOV == 4 ? "LOW" : EOV == 5 ? "JAMMED" : EOV == 6 ? "UNLINKED" : "SLOW"; font: FONT; fontSize: 10; color: MUT }
              Canvas {
                weight: 1
                height: 8
                for k in range(20) {
                  rect(width * k / 20, 0, width / 20 + 0.5, 8, fill: k < 10 ? mix(HOT[0], HOT[1], k / 10) : mix(HOT[1], HOT[2], (k - 10) / 10))
                }
              }
              Text { text: EOV == 4 ? "HIGH" : EOV == 5 ? "FREE" : EOV == 6 ? "LINKED" : "FAST"; font: FONT; fontSize: 10; color: MUT }
            }
            if EOV < 4 && len(SVP[EOV]) == 0 {
              Text { text: "No ${["police station", "fire station", "clinic", "school"][EOV]} yet: the whole city waits"; font: FONT; fontSize: 11; color: CORAL }
            }
            if (tool < 13 || tool > 16) && tool != 8 && tool < 24 {
              Row {
                fill: width
                gap: 4
                for v, i in ["POLICE", "FIRE", "CLINIC", "SCHOOL", "VALUE", "TRAFFIC", "SUBWAY"] {
                  Text { text: v; font: FONT; fontSize: 10; color: ov == i ? INK : CRM; background: ov == i ? SUN : #33405f; weight: 1; align: center; padding: [0, 6]; onTap: ov = i }
                }
              }
            }
          }
        }
      }
      if cat >= 0 && cat <= 5 {
        Row {
          fill: width
          gap: 5
          for id in CITEMS[cat] {
            Column {
              gap: 0
              weight: 1
              onTap: {
                if CL < TLV[id] {
                  msg = "UNLOCKS AT CITY LEVEL ${TLV[id]}"
                  msgT = now
                } else if id == 23 && !HAS[6] {
                  msg = "RESEARCH ROCKETRY AT THE LAB FIRST"
                  msgT = now
                } else if id == 25 && KC[24] == 0 {
                  msg = "BUILD A BUS DEPOT FIRST"
                  msgT = now
                } else {
                  tool = tool == id ? 0 : id
                  sel = -1
                  if tool > 0 {
                    msg = TTIP[tool]
                    msgT = now
                  }
                }
              }
              Column {
                gap: 3
                fill: width
                padding: [4, 8]
                align: center
                background: tool == id ? SUN : INK
                Row {
                  gap: 5
                  align: center
                  Spacer { size: 9; background: CL < TLV[id] ? #6b7894 : TCOL[id] }
                  Text { text: id == 14 ? "FIRE" : upper(TNAME[id]); font: FONT; fontSize: 11; color: tool == id ? INK : (CL < TLV[id] ? MUT : CRM); maxLines: 1 }
                }
                Text { text: CL < TLV[id] ? "LEVEL ${TLV[id]}" : id == 23 && !HAS[6] ? "ROCKETRY" : id == 25 && KC[24] == 0 ? "DEPOT FIRST" : (id == 24 || id == 20 || id == 23) && KC[id] > 0 ? "BUILT" : id == 10 ? "$${fmtNum(FPRICE)} A TILE" : TCOSTS[id] + (id < 10 ? " A TILE" : ""); font: FONT; fontSize: 10; align: center; color: tool == id ? INK : (CL < TLV[id] ? MUT : SUN); maxLines: 1 }
              }
              Spacer { fill: width; height: 4; background: tool == id ? SUN2 : INK2 }
            }
          }
        }
      }
      Row {
        fill: width
        gap: 5
        for c, i in CATS {
          Column {
            gap: 0
            weight: 1
            onTap: {
              let open = cat != i
              cat = open ? i : -1
              tool = !open ? 0 : i == 0 ? 1 : i == 5 ? 9 : 0
              sel = -1
              if tool > 0 {
                msg = TTIP[tool]
                msgT = now
              }
            }
            Spacer { fill: width; height: 3; background: CATC[i] }
            Text { text: c; fill: width; align: center; padding: [0, 11]; font: FONT; fontSize: 12; color: cat == i ? INK : CRM; background: cat == i ? SUN : INK; maxLines: 1 }
            Spacer { fill: width; height: 5; background: cat == i ? SUN2 : INK2 }
          }
        }
      }
    }
  }
}
