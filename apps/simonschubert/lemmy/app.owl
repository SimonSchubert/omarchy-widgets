app "lemmy" {
  meta { owl: 11; description: "A Lemmy reader: hot, new and top posts from across the fediverse or one community, community search, any instance, and every post's comments, threaded"; version: "1.2"; license: "MIT"; category: "news" }
  // A post's comments are a view of their own; Back returns to the list, and from a community's list to all of them.
  title: open != 0 ? (post.comments == 1 ? "1 comment" : "${post.comments ?? 0} comments") : community != "" ? communityTitle : "lemmy"
  back: open != 0 || community != ""
  onBack: { community = open == 0 ? "" : community; open = 0; expanded = []; replies = {} }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <clipPath id="tile"><rect width="256" height="256" rx="56"/></clipPath>
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <g clip-path="url(#tile)">
    <ellipse cx="64" cy="112" rx="18" ry="20" fill="#B07A4F"/>
    <ellipse cx="64" cy="114" rx="9" ry="11" fill="#E8A0A0"/>
    <ellipse cx="178" cy="124" rx="18" ry="20" fill="#B07A4F"/>
    <ellipse cx="178" cy="126" rx="9" ry="11" fill="#E8A0A0"/>
    <path d="M28 256c0-74 34-134 92-134s92 60 92 134z" fill="#C8915F"/>
    <ellipse cx="120" cy="186" rx="76" ry="68" fill="#C8915F"/>
    <path d="M78 206c0-24 18-38 42-38s42 14 42 38-18 44-42 44-42-20-42-44z" fill="#F2DEC4"/>
    <circle cx="92" cy="168" r="10" fill="#1A1B26"/>
    <circle cx="148" cy="168" r="10" fill="#1A1B26"/>
    <circle cx="95" cy="165" r="3.5" fill="#FFFFFF"/>
    <circle cx="151" cy="165" r="3.5" fill="#FFFFFF"/>
    <path d="M111 186h18l-9 10z" fill="#7A4A3A"/>
    <path d="M120 196v8" stroke="#7A4A3A" stroke-width="4" stroke-linecap="round"/>
    <rect x="111" y="204" width="8" height="11" rx="2" fill="#FFFFFF"/>
    <rect x="121" y="204" width="8" height="11" rx="2" fill="#FFFFFF"/>
    <circle cx="76" cy="190" r="9" fill="#F7768E" opacity="0.45"/>
    <circle cx="164" cy="190" r="9" fill="#F7768E" opacity="0.45"/>
    </g>
    <path d="M150 44h64a14 14 0 0 1 14 14v38a14 14 0 0 1-14 14h-30l-18 16v-16h-16a14 14 0 0 1-14-14V58a14 14 0 0 1 14-14z" fill="#9ECE6A"/>
    <path d="M182 58l20 24h-12v16h-16V82h-12z" fill="#1A1B26"/>
  </svg>"""

  // The bottom bar's icons, Material's whatshot, schedule, trending up and people (Apache 2.0).
  asset hotIcon = base64""
  asset newIcon = base64""
  asset topIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE2IDZsMi4yOSAyLjI5LTQuODggNC44OC00LTRMMiAxNi41OSAzLjQxIDE4bDYtNiA0IDQgNi4zLTYuMjlMMjIgMTJWNnoiLz48L3N2Zz4K"
  asset peopleIcon = base64""

  // The instance everything is read from, and the tab on show.
  state instance = "lemmy.world" persist
  state feed = "hot" persist
  // The community whose posts the lists show ("name@host", "" for all of them), and its title.
  state community = ""
  state communityTitle = ""
  state query = ""
  // The post whose comments are open (0 for the lists), its comment threads unfolded, the one whose
  // replies were asked for last, and the replies loaded so far, by top comment id.
  state open = 0
  state post = {}
  state expanded = []
  state unfold = 0
  state replies = {}
  // Posts read, so the lists show them dimmed; the last 500.
  state seen = [] persist
  // Each list of all communities as it last loaded, so a start shows it at once and the app reads offline.
  state savedHot = [] persist
  state savedNew = [] persist
  state savedTop = [] persist

  source now = clock every 1m
  // Only the list on show is asked for; the others wait with their saved lists.
  source hot = http(feed == "hot" && open == 0 ? (community == "" ? "https://${enc(instance)}/api/v3/post/list?type_=All&sort=Hot&limit=40" : "https://${enc(instance)}/api/v3/post/list?type_=All&sort=Hot&limit=40&community_name=${enc(community)}") : null) every 5m json timeout 20s status
  source fresh = http(feed == "new" && open == 0 ? (community == "" ? "https://${enc(instance)}/api/v3/post/list?type_=All&sort=New&limit=40" : "https://${enc(instance)}/api/v3/post/list?type_=All&sort=New&limit=40&community_name=${enc(community)}") : null) every 5m json timeout 20s status
  source top = http(feed == "top" && open == 0 ? (community == "" ? "https://${enc(instance)}/api/v3/post/list?type_=All&sort=TopDay&limit=40" : "https://${enc(instance)}/api/v3/post/list?type_=All&sort=TopDay&limit=40&community_name=${enc(community)}") : null) every 5m json timeout 20s status
  source comms = http(feed == "communities" && open == 0 ? (len(trim(query)) >= 2 ? "https://${enc(instance)}/api/v3/search?q=${enc(trim(query))}&type_=Communities&listing_type=All&sort=TopAll&limit=30" : "https://${enc(instance)}/api/v3/community/list?type_=All&sort=TopMonth&limit=40") : null) every 30m json timeout 20s status
  // The open post's top comments in Lemmy's hot order; a thread's replies only once it's unfolded,
  // since a whole tree can be more than a reply may hold.
  source thread = http(open == 0 ? null : "https://${enc(instance)}/api/v3/comment/list?post_id=${int(open)}&sort=Hot&type_=All&max_depth=1") every 5m json timeout 25s status
  source reply = http(open == 0 || unfold == 0 ? null : "https://${enc(instance)}/api/v3/comment/list?parent_id=${int(unfold)}&sort=Hot&type_=All&max_depth=8") every 5m json timeout 25s status

  // "lemmy.ml" from "https://lemmy.ml/c/linux".
  let cname = split(community, "@")[0]
  // Each list's posts, trimmed to what a row shows; one community's only once they're from it.
  let liveHot = hot != null && hot.ok && hot.out.posts != null && (community == "" || hot.out.posts.all(p => p.community.name == cname)) ? hot.out.posts.filter(p => !p.post.nsfw && !p.community.nsfw).map(p => {id: p.post.id, title: p.post.name, url: p.post.url ?? "", thumb: p.post.thumbnail_url ?? "", image: startsWith(p.post.url_content_type ?? "", "image/"), site: match(p.post.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", score: p.counts.score ?? 0, comments: p.counts.comments ?? 0, time: parseTime(p.post.published), author: p.creator.name ?? "", community: p.community.name, host: match(p.community.actor_id ?? "", '^https?://([^/]+)')[0] ?? "", text: p.post.body ?? "", pinned: p.post.featured_local || p.post.featured_community, link: p.post.ap_id}) : null
  let liveNew = fresh != null && fresh.ok && fresh.out.posts != null && (community == "" || fresh.out.posts.all(p => p.community.name == cname)) ? fresh.out.posts.filter(p => !p.post.nsfw && !p.community.nsfw).map(p => {id: p.post.id, title: p.post.name, url: p.post.url ?? "", thumb: p.post.thumbnail_url ?? "", image: startsWith(p.post.url_content_type ?? "", "image/"), site: match(p.post.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", score: p.counts.score ?? 0, comments: p.counts.comments ?? 0, time: parseTime(p.post.published), author: p.creator.name ?? "", community: p.community.name, host: match(p.community.actor_id ?? "", '^https?://([^/]+)')[0] ?? "", text: p.post.body ?? "", pinned: p.post.featured_local || p.post.featured_community, link: p.post.ap_id}) : null
  let liveTop = top != null && top.ok && top.out.posts != null && (community == "" || top.out.posts.all(p => p.community.name == cname)) ? top.out.posts.filter(p => !p.post.nsfw && !p.community.nsfw).map(p => {id: p.post.id, title: p.post.name, url: p.post.url ?? "", thumb: p.post.thumbnail_url ?? "", image: startsWith(p.post.url_content_type ?? "", "image/"), site: match(p.post.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", score: p.counts.score ?? 0, comments: p.counts.comments ?? 0, time: parseTime(p.post.published), author: p.creator.name ?? "", community: p.community.name, host: match(p.community.actor_id ?? "", '^https?://([^/]+)')[0] ?? "", text: p.post.body ?? "", pinned: p.post.featured_local || p.post.featured_community, link: p.post.ap_id}) : null
  when community == "" && liveHot != null && liveHot != savedHot { savedHot = liveHot }
  when community == "" && liveNew != null && liveNew != savedNew { savedNew = liveNew }
  when community == "" && liveTop != null && liveTop != savedTop { savedTop = liveTop }

  let src = feed == "new" ? fresh : feed == "top" ? top : hot
  let live = feed == "new" ? liveNew : feed == "top" ? liveTop : liveHot
  let posts = live ?? (community != "" ? [] : feed == "new" ? savedNew : feed == "top" ? savedTop : savedHot)
  let offline = src != null && !src.ok
  let communities = comms == null || !comms.ok ? [] : (comms.out.communities ?? []).filter(c => !c.community.nsfw).map(c => {name: c.community.name, title: c.community.title ?? c.community.name, icon: c.community.icon ?? "", host: match(c.community.actor_id ?? "", '^https?://([^/]+)')[0] ?? "", subs: c.counts.subscribers ?? 0, active: c.counts.users_active_month ?? 0})

  // A comment as a row shows it; its path ("0.12.34") places it in the thread.
  let tree = thread != null && thread.ok && thread.out.comments != null && (len(thread.out.comments) == 0 || thread.out.comments[0].comment.post_id == open) ? thread.out.comments.map(x => {id: x.comment.id, path: x.comment.path, parent: join(split(x.comment.path, ".").take(len(split(x.comment.path, ".")) - 1), "."), author: x.creator.name ?? "", gone: x.comment.deleted || x.comment.removed, text: x.comment.content ?? "", time: parseTime(x.comment.published), score: x.counts.score ?? 0, kids: x.counts.child_count ?? 0}) : null
  // An unfolded thread's replies, the top comment itself first, kept until the post closes.
  let liveReplies = reply != null && reply.ok && len(reply.out.comments ?? []) > 0 && reply.out.comments[0].comment.id == unfold ? reply.out.comments.map(x => {id: x.comment.id, path: x.comment.path, parent: join(split(x.comment.path, ".").take(len(split(x.comment.path, ".")) - 1), "."), author: x.creator.name ?? "", gone: x.comment.deleted || x.comment.removed, text: x.comment.content ?? "", time: parseTime(x.comment.published), score: x.counts.score ?? 0, kids: x.counts.child_count ?? 0}) : null
  when liveReplies != null && get(replies, "${unfold}") != liveReplies { replies = set(replies, "${unfold}", liveReplies) }

  // Lemmy's Markdown as text: a paragraph each, quotes set in, code in mono; the links listed under it.
  component Md(t, small = false) {
    let raw = replace(replace(replace(replace(replace(t ?? "", "&amp;", "&"), "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&#39;", "'")
    let paras = split(replace(raw, "\r", ""), "\n\n").map(p => trim(p)).filter(p => p != "")
    let links = unique(matchAll(raw, 'https?://[^\s)\]>"]+')).take(3)
    Column {
      gap: 6
      for p in paras.take(30) {
        let code = startsWith(p, "```") || startsWith(p, "    ")
        let quote = startsWith(p, ">")
        // Links read as their text, images as their alt text; emphasis, headings and list marks go.
        let body = code ? trim(replace(p, "```", "")) : join(lines(p).map(l => {s: trim(quote ? replace(l, ">", "") : l)}).map(l => startsWith(l.s, "- ") || startsWith(l.s, "* ") ? "• " + sub(l.s, 2) : startsWith(l.s, "#") ? trim(replace(l.s, "#", "")) : startsWith(l.s, ":::") ? "" : l.s).filter(l => l != ""), "\n")
        let plain = code ? body : replace(replace(replace(join(matchAll(body, '!?\[([^\]]*)\]\(([^)\s]*)[^)]*\)|([^!\[]+|[!\[])').map(x => x[2] != "" ? x[2] : x[0]), ""), "**", ""), "__", ""), "~~", "")
        if quote {
          Text { text: plain; style: small; color: muted; italic: true; padding: [10, 6]; radius: 4 * corners; background: alpha(muted, 0.1) }
        } else if trim(plain) != "" {
          Text { text: plain; style: small ? "small" : "body"; font: code ? "mono" : "sans" }
        }
      }
      for l in links {
        Text { text: "${match(l, '^https?://(?:www\.)?([^/]+)')[0] ?? l} ↗"; style: small; color: accent; maxLines: 1; onTap: url(l) }
      }
    }
  }

  // One comment: who, its score and when, and what they wrote.
  component Comment(c, depth = 0) {
    Row {
      gap: 8
      align: top
      // A reply sits in from its parent.
      if depth > 0 { Spacer { width: depth * 12 - 8 } }
      Column {
        gap: 3
        weight: 1
        Row {
          gap: 6
          Text { text: c.author; style: small; bold: true; color: c.author == post.author ? green : accent; weight: 1; maxLines: 1 }
          Text { text: "▲ ${c.score}"; style: small; color: muted; width: 52; align: end; maxLines: 1 }
          Text { text: fmtAgo(c.time, now); style: small; color: muted; width: 32; align: end; maxLines: 1 }
        }
        if c.gone {
          Text { text: "[deleted]"; style: small; color: muted }
        } else {
          Md { t: c.text; small: depth > 0 }
        }
      }
    }
  }

  // A tab of the bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, icon) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { feed = name; open = 0; expanded = []; replies = {}; haptic() }
      Box {
        align: center
        width: 56
        height: 32
        Image { src: icon; size: 24; tint: feed == name ? foreground : muted }
      }
      Text { text: name == "communities" ? "groups" : name; style: small; align: center; maxLines: 1; bold: feed == name; color: feed == name ? foreground : muted }
    }
  }

  // An instance to read from.
  component Pick(name) {
    Text {
      text: name
      style: small
      width: 7 * len(name) + 24
      align: center
      maxLines: 1
      padding: [6, 12]
      radius: 14 * corners
      color: instance == name ? background : foreground
      background: instance == name ? accent : alpha(foreground, 0.08)
      onTap: { instance = name; community = ""; query = ""; savedHot = []; savedNew = []; savedTop = []; haptic() }
    }
  }

  Column {
    fill: true
    gap: 0

    if open == 0 && feed == "communities" {
      Column {
        lazy: true
        weight: 1
        gap: 12
        padding: [12, 4, 12, 12]
        Input { text: query; placeholder: "search communities on ${instance}"; onChange: query = value; clear: true }
        if comms != null && !comms.ok {
          Text { text: "${instance} didn't answer"; color: muted }
          Button { text: "try again"; onTap: refresh() }
        } else {
          if comms == null || comms.out == null { Text { text: "loading…"; color: muted } }
          if comms != null && comms.ok && len(communities) == 0 { Text { text: "no communities found"; color: muted } }
        }
        for c in communities key "${c.name}@${c.host}" {
          Row {
            gap: 10
            align: center
            onTap: { community = "${c.name}@${c.host}"; communityTitle = c.title; feed = "hot"; haptic() }
            Box {
              width: 36
              height: 36
              radius: 18 * corners
              clip: true
              align: center
              background: alpha(accent, 0.18)
              if c.icon != "" {
                Image { src: c.icon; size: 36; fit: cover }
              } else {
                Text { text: upper(sub(c.name, 0, 1)); bold: true; color: accent; align: center }
              }
            }
            Column {
              gap: 2
              weight: 1
              Text { text: c.title; bold: true; maxLines: 1 }
              Text { text: "!${c.name}@${c.host}"; style: small; color: muted; maxLines: 1 }
            }
            Column {
              gap: 0
              width: 64
              align: end
              Text { text: fmtNum(c.subs, {compact: true}); bold: true; align: end; maxLines: 1 }
              Text { text: "members"; style: small; color: muted; align: end; maxLines: 1 }
            }
          }
        }
        Box { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: "instance"; style: label; color: muted }
        Flow {
          gap: 8
          Pick { name: "lemmy.world" }
          Pick { name: "lemmy.ml" }
          Pick { name: "sh.itjust.works" }
          Pick { name: "programming.dev" }
          Pick { name: "feddit.org" }
          Pick { name: "lemmy.zip" }
        }
        Input { text: instance; placeholder: "another instance, like lemmy.ca"; onSubmit: { instance = lower(trim(value)); community = ""; query = ""; savedHot = []; savedNew = []; savedTop = [] } }
      }
    } else if open == 0 {
      Column {
        lazy: true
        weight: 1
        gap: 14
        padding: [12, 4, 12, 12]
        if len(posts) == 0 {
          Text { text: offline ? "${instance} didn't answer" : live != null ? "no posts yet" : "loading…"; color: muted }
          if offline { Button { text: "try again"; onTap: refresh() } }
        }
        for s in posts key s.id {
          let read = contains(seen, s.id)
          Row {
            gap: 10
            align: top
            Column {
              gap: 3
              weight: 1
              // A post opens its link, or its comments when it has none.
              onTap: { seen = read ? seen : (seen + [s.id]).drop(max(0, len(seen) - 499)); post = s; open = s.url == "" ? s.id : 0; expanded = []; replies = {}; url(s.url == "" ? null : s.url) }
              Text { text: s.title; bold: !read; color: read ? muted : foreground; maxLines: 3 }
              Text { text: community != "" ? (s.site == "" ? s.author : s.site) : "c/${s.community}${s.host == instance ? "" : "@" + s.host}"; style: small; color: muted; maxLines: 1 }
              Text { text: "${s.pinned ? "pinned · " : ""}▲ ${s.score} · ${s.author}"; style: small; color: green; maxLines: 1 }
            }
            if s.thumb != "" {
              Image { src: s.thumb; width: 56; height: 56; fit: cover; radius: 6 * corners; onTap: { seen = read ? seen : (seen + [s.id]).drop(max(0, len(seen) - 499)); post = s; open = s.url == "" ? s.id : 0; expanded = []; replies = {}; url(s.url == "" ? null : s.url) } }
            }
            // The comments, in the app.
            Column {
              width: 44
              align: center
              gap: 0
              padding: [0, 2]
              radius: 6 * corners
              background: alpha(foreground, 0.06)
              onTap: { seen = read ? seen : (seen + [s.id]).drop(max(0, len(seen) - 499)); post = s; open = s.id; expanded = []; replies = {}; haptic() }
              Text { text: s.comments > 999 ? "${floor(s.comments / 1000)}k" : "${s.comments}"; bold: true; align: center; maxLines: 1 }
              Text { text: fmtAgo(s.time, now); style: small; color: muted; align: center; maxLines: 1 }
            }
          }
        }
        if offline && len(posts) > 0 {
          Text { text: "offline · showing the last list"; style: label; color: muted }
        }
      }
    } else {
      Column {
        lazy: true
        weight: 1
        gap: 12
        padding: [12, 4, 12, 12]
        // The post: its title opens the link, a picture shows here.
        Column {
          gap: 6
          Text { text: post.title; style: title; maxLines: 6; onTap: url(post.url == "" ? post.link : post.url) }
          Text { text: "▲ ${post.score} · ${post.author} · c/${post.community}${post.host == instance ? "" : "@" + post.host}"; style: small; color: green; maxLines: 1 }
          if post.image {
            Image { src: post.url; fill: width; height: 240; fit: contain; radius: 8 * corners; onTap: url(post.url) }
          } else if post.url != "" {
            Text { text: "${post.site} ↗"; color: accent; maxLines: 1; onTap: url(post.url) }
          }
          if post.text != "" {
            Md { t: post.text }
          }
        }
        Box { height: 1; fill: width; background: alpha(muted, 0.25) }
        if tree == null || len(tree) == 0 {
          Column {
            Text { text: tree != null || post.comments == 0 ? "no comments yet" : thread != null && !thread.ok ? "the comments didn't load" : "loading the comments…"; color: muted }
            if tree == null && thread != null && !thread.ok { Button { text: "try again"; onTap: refresh() } }
          }
        }
        for c in (tree ?? []).take(80) key c.id {
          let unfolded = contains(expanded, c.id)
          // The thread's replies in order, each under its parent, six deep.
          let g = groupBy(get(replies, "${c.id}", []), r => r.parent)
          let all = flatten(get(g, c.path, []).map(a => [{c: a, d: 1}] + flatten(get(g, a.path, []).map(b => [{c: b, d: 2}] + flatten(get(g, b.path, []).map(x => [{c: x, d: 3}] + flatten(get(g, x.path, []).map(y => [{c: y, d: 4}] + flatten(get(g, y.path, []).map(z => [{c: z, d: 5}] + get(g, z.path, []).map(w => {c: w, d: 6})))))))))))
          Column {
            gap: 8
            // A tap folds a thread's replies in or out.
            Column {
              onTap: { unfold = unfolded || c.kids == 0 ? unfold : c.id; expanded = unfolded ? expanded.filter(e => e != c.id) : expanded + [c.id] }
              Comment { c: c }
            }
            if c.kids > 0 {
              Text {
                text: unfolded ? "hide replies" : c.kids == 1 ? "1 reply" : "${c.kids} replies"
                style: small
                color: accent
                onTap: { unfold = unfolded ? unfold : c.id; expanded = unfolded ? expanded.filter(e => e != c.id) : expanded + [c.id] }
              }
            }
            if unfolded {
              if len(all) == 0 {
                Text { text: reply != null && !reply.ok && unfold == c.id ? "the replies didn't load" : "loading the replies…"; style: small; color: muted }
              }
              for r in all.take(120) key r.c.id { Comment { c: r.c; depth: r.d } }
            }
          }
        }
        if tree != null && len(tree) > 80 {
          Text { text: "more on ${instance} ↗"; color: accent; onTap: url("https://${instance}/post/${open}") }
        }
      }
    }

    if open == 0 {
      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "hot"; icon: hotIcon }
        Tab { name: "new"; icon: newIcon }
        Tab { name: "top"; icon: topIcon }
        Tab { name: "communities"; icon: peopleIcon }
      }
    }
  }
}
