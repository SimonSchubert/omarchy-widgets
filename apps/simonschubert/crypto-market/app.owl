app "crypto market" {
  meta { owl: 8; description: "CoinGecko prices: the top 250 coins, coin pages with charts, a watchlist, trending coins, gainers and losers, categories, a converter and a portfolio"; version: "1.1"; license: "MIT"; category: "finance" }
  // A coin's page and a search are a level of their own; Back returns to the tab.
  title: openId != "" ? cName : view == "markets" ? "crypto market" : view == "watch" ? "watchlist" : view
  back: openId != "" || len(typed) > 0
  onBack: { typed = openId != "" ? typed : ""; query = openId != "" ? query : ""; openId = ""; adding = false }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <circle cx="92" cy="92" r="44" fill="#E0AF68"/>
    <circle cx="92" cy="92" r="30" fill="none" stroke="#1A1B26" stroke-opacity="0.35" stroke-width="8"/>
    <path d="M44 206l56-46 40 26 76-72" fill="none" stroke="#9ECE6A" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M176 110h44v44" fill="none" stroke="#9ECE6A" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>"""

  // The bottom bar's and the search field's icons, Material's show chart, star border, explore, pie chart,
  // settings and search (Apache 2.0).
  asset marketsIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTMuNSAxOC40OWw2LTYuMDEgNCA0TDIyIDYuOTJsLTEuNDEtMS40MS03LjA5IDcuOTctNC00TDIgMTYuOTl6Ii8+PC9zdmc+Cg=="
  asset watchIcon = base64""
  asset discoverIcon = base64""
  asset portfolioIcon = base64""
  asset settingsIcon = base64""
  asset searchIcon = base64""
  // A port of Crypto Market for Omarchy (github.com/SimonSchubert/omarchy-crypto-market).
  // Every address it fetches is CoinGecko's public API; a source whose URL is null waits, so
  // only what's on screen is fetched (the free API allows about ten calls a minute).
  source now = clock every 1m

  state cur = "usd" persist
  state watch = ["bitcoin", "ethereum"] persist
  // Buys and sells: {id, symbol, name, side, amount, price, vs, time}; price in `vs` units.
  state txs = [] persist
  // The last markets list, slimmed, so the app opens with prices offline.
  state snap = [] persist
  state snapCur = "" persist

  state view = "markets"
  state openId = ""
  state range = 7
  state hx = -1
  state sortKey = "rank"
  state sortDir = 1
  state page = 0
  state typed = ""
  state query = ""
  state convIn = "1"
  state convFlip = false
  state adding = false
  state txSide = "buy"
  state txAmt = ""
  state txPrice = ""
  state descOpen = false

  let searching = view == "markets" && len(typed) > 0
  let vs = cur == "sats" ? "btc" : cur
  let mul = cur == "sats" ? 100000000 : 1

  source p1 = http("https://api.coingecko.com/api/v3/coins/markets?vs_currency=${enc(vs)}&order=market_cap_desc&per_page=250&sparkline=false&price_change_percentage=1h,24h,7d,30d,1y") every 5m json timeout 20s status
  source glob = http("https://api.coingecko.com/api/v3/global") every 10m json timeout 20s status
  source trend = http(view == "discover" && openId == "" ? "https://api.coingecko.com/api/v3/search/trending" : null) every 10m json timeout 20s status
  source cats = http(view == "discover" && openId == "" ? "https://api.coingecko.com/api/v3/coins/categories?order=market_cap_desc" : null) every 10m json timeout 20s status
  source rates = http(view == "portfolio" && openId == "" ? "https://api.coingecko.com/api/v3/exchange_rates" : null) every 10m json timeout 20s status
  source coin = http(openId != "" ? "https://api.coingecko.com/api/v3/coins/${enc(openId)}?localization=false&tickers=false&market_data=true&community_data=false&developer_data=false" : null) every 5m json timeout 20s status
  source chart = http(openId != "" ? "https://api.coingecko.com/api/v3/coins/${enc(openId)}/market_chart?vs_currency=${enc(vs)}&days=${int(range)}${range == 90 ? "&interval=daily" : ""}" : null) every 5m json timeout 20s status
  source found = http(searching && len(query) >= 2 && openId == "" ? "https://api.coingecko.com/api/v3/search?query=${enc(query)}" : null) every 30m json timeout 20s status

  let ok1 = p1 != null && p1.ok
  let live = ok1 ? p1.out : []
  let coins = len(live) > 0 ? live : snapCur == cur ? snap : []
  let offline = !ok1 && p1 != null
  let limited = p1 != null && p1.code == 429

  // `on` skips a source's first value, so `when` saves the first prices of a run and `on` the ones after.
  when len(live) > 0 {
    snapCur = cur
    snap = live.map(c => {id: c.id, symbol: c.symbol, name: c.name, market_cap_rank: c.market_cap_rank, current_price: c.current_price, price_change_percentage_24h: c.price_change_percentage_24h, market_cap: c.market_cap, total_volume: c.total_volume, image: c.image})
  }
  on p1 {
    snapCur = len(live) > 0 ? cur : snapCur
    snap = len(live) == 0 ? snap : live.map(c => {id: c.id, symbol: c.symbol, name: c.name, market_cap_rank: c.market_cap_rank, current_price: c.current_price, price_change_percentage_24h: c.price_change_percentage_24h, market_cap: c.market_cap, total_volume: c.total_volume, image: c.image})
  }

  // Coins on the watchlist or in the portfolio that aren't in the top 250.
  let held = unique(txs.map(t => t.id))
  let extra = unique(watch + held).filter(id => !any(coins, c => c.id == id))
  source more = http(len(live) > 0 && len(extra) > 0 && (view == "watch" || view == "portfolio") ? "https://api.coingecko.com/api/v3/coins/markets?vs_currency=${enc(vs)}&ids=${enc(join(extra, ","))}&price_change_percentage=1h,24h,7d" : null) every 5m json timeout 20s status
  let known = coins + (more != null && more.ok ? more.out : [])

  let curs = [
    {code: "usd", sym: "$", name: "US Dollar"}, {code: "eur", sym: "€", name: "Euro"}, {code: "gbp", sym: "£", name: "British Pound"},
    {code: "jpy", sym: "¥", name: "Japanese Yen"}, {code: "chf", sym: "CHF ", name: "Swiss Franc"}, {code: "cad", sym: "CA$", name: "Canadian Dollar"},
    {code: "aud", sym: "A$", name: "Australian Dollar"}, {code: "cny", sym: "CN¥", name: "Chinese Yuan"}, {code: "inr", sym: "₹", name: "Indian Rupee"},
    {code: "krw", sym: "₩", name: "South Korean Won"}, {code: "brl", sym: "R$", name: "Brazilian Real"}, {code: "sek", sym: "kr ", name: "Swedish Krona"},
    {code: "btc", sym: "₿", name: "Bitcoin"}, {code: "eth", sym: "Ξ", name: "Ether"}, {code: "sats", sym: "", name: "Satoshi"}
  ]
  let csym = (curs.find(c => c.code == cur) ?? curs[0]).sym

  // Markets: sorted, 50 rows a page.
  let sorted = sortKey == "rank" ? coins.sortBy(c => sortDir * (c.market_cap_rank ?? 99999)) : coins.sortBy(c => -sortDir * num(sortKey == "price" ? c.current_price : sortKey == "24h" ? c.price_change_percentage_24h_in_currency ?? c.price_change_percentage_24h : sortKey == "7d" ? c.price_change_percentage_7d_in_currency : c.total_volume, -1000000000000000))
  let pages = max(1, ceil(len(sorted) / 25))
  let shown = sorted.drop(page * 25).take(25)
  let g = glob != null && glob.ok ? glob.out.data : null
  // CoinGecko's global volume is sometimes off by orders of magnitude; then the top 250's volume stands in.
  let gVol = get(g.total_volume ?? {}, vs, null)
  let vol24 = gVol != null && gVol <= num(get(g.total_market_cap ?? {}, vs, null), 0) ? gVol : len(live) > 0 ? sum(live.map(c => num(c.total_volume, 0))) : null
  // At most 10 here and 15 from all of CoinGecko: with the bar's icons, a view holds 32 pictures.
  let matches = len(typed) == 0 ? [] : coins.filter(c => contains(lower(c.name), lower(typed)) || contains(lower(c.symbol), lower(typed))).take(10)

  // Discover: gainers and losers among the 250 with real volume.
  let traded = coins.filter(c => c.price_change_percentage_24h != null && (vs == "btc" || vs == "eth" || num(c.total_volume, 0) >= 50000))
  let gainers = traded.sortBy(c => -c.price_change_percentage_24h).take(8)
  let losers = traded.sortBy(c => c.price_change_percentage_24h).take(8)

  // The coin page: the markets row it was opened from at once, the full page when it arrives.
  let row = known.find(c => c.id == openId)
  let cd = coin != null && coin.ok && coin.out.id == openId ? coin.out : null
  let md = cd.market_data
  let cPrice = row.current_price ?? get(md.current_price ?? {}, vs, null)
  let cSym = upper(row.symbol ?? cd.symbol ?? "")
  let cName = row.name ?? cd.name ?? openId
  let pts = chart != null && chart.ok ? chart.out.prices ?? [] : []
  let n = len(pts)
  let lo = n > 0 ? min(pts.map(p => p[1])) : 0
  let hi = n > 0 ? max(pts.map(p => p[1])) : 1
  let cw = (screenWidth ?? 360) - 32
  let hi2 = n > 0 && hx >= 0 ? clamp(round(hx / cw * (n - 1)), 0, n - 1) : n - 1
  let hp = n > 0 ? pts[hi2] : null
  let chg = n > 1 ? (pts[n - 1][1] / pts[0][1] - 1) * 100 : null
  let desc = trim(first(split(replace(cd.description.en ?? "", "\r\n", "\n"), "\n\n")) ?? "")
  let descText = join(matchAll(desc, '([^<>]+)(?:<[^>]*>)?').map(m => m[0]), "")
  let links = [
    {label: "website", href: first((cd.links.homepage ?? []).filter(u => startsWith(u, "https://")))},
    {label: "whitepaper", href: startsWith(cd.links.whitepaper ?? "", "https://") ? cd.links.whitepaper : null},
    {label: "explorer", href: first((cd.links.blockchain_site ?? []).filter(u => startsWith(u, "https://")))},
    {label: "github", href: first((cd.links.repos_url.github ?? []).filter(u => startsWith(u, "https://")))},
    {label: "reddit", href: startsWith(cd.links.subreddit_url ?? "", "https://") ? cd.links.subreddit_url : null},
    {label: "X", href: len(cd.links.twitter_screen_name ?? "") > 0 ? "https://x.com/${cd.links.twitter_screen_name}" : null}
  ].filter(l => l.href != null)
  let convN = num(replace(convIn, ",", "."), 0)
  let mine = sum(txs.filter(t => t.id == openId).map(t => t.side == "buy" ? t.amount : -t.amount))

  // Portfolio, in the current currency. A transaction's price converts through CoinGecko's BTC rates.
  let rt = rates != null && rates.ok ? rates.out.rates : null
  let h1 = held.map(id => {id: id, ts: txs.filter(t => t.id == id), c: known.find(c => c.id == id)})
  let h2 = h1.map(h => {id: h.id, c: h.c, ts: h.ts, sym: upper(h.ts[0].symbol), name: h.ts[0].name, amt: sum(h.ts.map(t => t.side == "buy" ? t.amount : -t.amount)), net: sum(h.ts.map(t => (t.side == "buy" ? 1 : -1) * t.amount * t.price * (rt == null || t.vs == vs ? 1 : num(get(rt, vs, {}).value, 0) / num(get(rt, t.vs, {}).value, 1))))})
  let hold = h2.map(h => {id: h.id, img: h.c.image, sym: h.sym, name: h.name, amt: h.amt, value: h.amt * num(h.c.current_price, 0), day: h.amt * num(h.c.current_price, 0) * (1 - 1 / (1 + num(h.c.price_change_percentage_24h, 0) / 100)), pnl: h.amt * num(h.c.current_price, 0) - h.net, priced: h.c != null}).sortBy(h => -h.value)
  let total = sum(hold.map(h => h.value))
  let totalDay = sum(hold.map(h => h.day))
  let totalPnl = sum(hold.map(h => h.pnl))
  let palette = [blue, green, yellow, magenta, cyan, orange, red, accent]

  // A number as text: kind "price", "delta" (a price with its sign), "money" (compact, 1.23B), "chg" (▲ 1.2%), "pct" or "supply".
  component Amount(v, kind = "price", tint = null, sz = 14, heavy = false, sym = "", right = true) {
    let x = num(v, 0) * (kind == "price" || kind == "delta" || kind == "money" ? mul : 1)
    let a = abs(x)
    let compactK = kind == "money" || kind == "supply"
    let big = !compactK ? null : a >= 1000000000000 ? [1000000000000, "T", 2] : a >= 1000000000 ? [1000000000, "B", 2] : a >= 1000000 ? [1000000, "M", 2] : a >= 10000 ? [1000, "K", 1] : null
    let d = kind == "chg" || kind == "pct" ? (a >= 1000 ? 0 : kind == "pct" ? 1 : 1) : big != null ? big[2] : compactK || cur == "sats" ? (a >= 100 ? 0 : 2) : a >= 1 ? 2 : a >= 0.01 ? 4 : a >= 0.0001 ? 6 : a >= 0.000001 ? 8 : 10
    let raw = fixed(big != null ? a / big[0] : a, d)
    let trimmed = d > 2 && a < 1 ? match(raw, '^(.*?)0*$')[0] : raw
    let s = endsWith(trimmed, ".") ? trimmed + "00" : trimmed
    let ip = split(s, ".")[0]
    let fp = contains(s, ".") ? "." + split(s, ".")[1] : ""
    let grouped = join(range(len(ip)).map(i => (i > 0 && (len(ip) - i) % 3 == 0 ? "," : "") + sub(ip, i, i + 1)), "") + fp + (big != null ? big[1] : "")
    let txt = v == null ? "–" : kind == "chg" ? (x > 0.05 ? "▲ " : x < -0.05 ? "▼ " : "") + grouped + "%" : kind == "pct" ? (x < 0 ? "−" : "") + grouped + "%" : kind == "supply" ? (a <= 0 ? "∞" : grouped + (sym != "" ? " " + sym : "")) : (x < 0 ? "-" : kind == "delta" && x > 0 ? "+" : "") + (cur == "sats" ? grouped + " sats" : csym + grouped)
    let tone = tint ?? (kind == "chg" ? (v == null || abs(x) <= 0.05 ? muted : x > 0 ? green : red) : foreground)
    if right {
      Text { text: txt; fontSize: sz; bold: heavy; maxLines: 1; align: end; color: tone }
    } else {
      Text { text: txt; fontSize: sz; bold: heavy; maxLines: 1; color: tone }
    }
  }

  // The coin's logo from CoinGecko's image server, or its letters while it loads and past the
  // 32 pictures a view can hold.
  component Badge(sym, img = "") {
    let k = (indexOf(split("abcdefghijklmnopqrstuvwxyz", ""), lower(sub(sym ?? "?", 0, 1))) + len(sym ?? "")) % 8
    let path = replace(replace(replace(img ?? "", "https://coin-images.coingecko.com/", ""), "/large/", "/small/"), "/thumb/", "/small/")
    Box {
      width: 36
      height: 36
      radius: 18
      clip: true
      align: center
      background: path != "" ? null : alpha(palette[k < 0 ? 0 : k], 0.22)
      if path != "" && startsWith(img, "https://coin-images.coingecko.com/") {
        Image { src: "https://coin-images.coingecko.com/${path}"; width: 36; height: 36; fit: contain }
      } else {
        Text { text: upper(sub(sym ?? "?", 0, 3)); fontSize: len(sym ?? "") > 3 ? 9 : 11; bold: true; color: palette[k < 0 ? 0 : k]; width: 36; align: center; maxLines: 1 }
      }
    }
  }

  component Stat(label, v, kind = "money", sym = "") {
    Row {
      align: center
      Text { text: label; style: small; color: muted; weight: 1; maxLines: 1 }
      Amount { v: v; kind: kind; sym: sym; sz: 14; width: 170 }
    }
  }

  component CoinRow(c, logo = true) {
    let starred = indexOf(watch, c.id) >= 0
    Row {
      gap: 10
      align: center
      padding: [0, 6]
      onTap: { openId = c.id; hx = -1; descOpen = false; adding = false; convFlip = false; convIn = "1" }
      Text { text: starred ? "★" : "☆"; fontSize: 18; color: starred ? yellow : muted; width: 22; align: center; onTap: watch = starred ? watch.filter(w => w != c.id) : watch + [c.id] }
      Badge { sym: c.symbol; img: logo ? c.image : "" }
      Column {
        gap: 1
        weight: 1
        Text { text: upper(c.symbol); bold: true; maxLines: 1 }
        Text { text: c.market_cap_rank == null ? c.name : "${c.market_cap_rank} · ${c.name}"; style: small; color: muted; maxLines: 1 }
      }
      Column {
        gap: 1
        width: 130
        Amount { v: c.current_price; heavy: true; sz: 15 }
        Amount { v: c.price_change_percentage_24h_in_currency ?? c.price_change_percentage_24h; kind: "chg"; sz: 12 }
      }
    }
  }

  // A tab of the bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, label, icon) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { view = name; openId = ""; typed = ""; query = ""; haptic() }
      Box {
        align: center
        width: 56
        height: 32
        Image { src: icon; size: 24; tint: view == name ? foreground : muted }
      }
      Text { text: label; style: small; align: center; maxLines: 1; bold: view == name; color: view == name ? foreground : muted }
    }
  }

  component Head(t) {
    Text { text: t; style: label; color: muted; padding: [0, 8, 0, 2] }
  }

  Column {
    gap: 0
    fill: true

    Column {
      weight: 1
      scroll: true
      gap: 10
      padding: [16, 4, 16, 12]

      if openId != "" {
        // ---------------------------------------------------------------- coin page
        let starred = indexOf(watch, openId) >= 0
        Row {
          gap: 12
          align: center
          Badge { sym: row.symbol ?? cd.symbol; img: row.image ?? cd.image.large }
          Column {
            gap: 0
            weight: 1
            Amount { v: hp != null && hx >= 0 ? hp[1] / mul : cPrice; sz: 28; heavy: true; right: false; fill: width }
            Text { text: "${cSym}${(row.market_cap_rank ?? cd.market_cap_rank) == null ? "" : " · rank " + (row.market_cap_rank ?? cd.market_cap_rank)}"; style: small; color: muted; maxLines: 1 }
          }
          Text { text: starred ? "★" : "☆"; fontSize: 26; color: starred ? yellow : muted; width: 40; align: center; onTap: watch = starred ? watch.filter(w => w != openId) : watch + [openId] }
        }
        Row {
          gap: 10
          align: center
          Text {
            text: hp != null && hx >= 0 ? fmtTime(hp[0] / 1000, range == 1 ? "HH:mm" : range <= 30 ? "d MMM HH:mm" : "d MMM yyyy") : range == 1 ? "last 24 hours" : range == 7 ? "last 7 days" : range == 30 ? "last month" : range == 90 ? "last 3 months" : "last year"
            style: small
            color: muted
            weight: 1
          }
          Amount { v: hx >= 0 && hp != null ? (hp[1] / pts[0][1] - 1) * 100 : chg; kind: "chg"; sz: 14; width: 110 }
        }
        if (coin != null && !coin.ok) || (chart != null && !chart.ok) {
          Text { text: (coin != null && coin.code == 429) || (chart != null && chart.code == 429) ? "CoinGecko is busy; the rest comes back in a minute" : "couldn't load everything"; style: small; color: yellow }
        }
        Canvas {
          width: cw
          height: 190
          onTap: hx = x
          onDrag: hx = x
          let up = chg == null || chg >= 0
          let tone = up ? green : red
          let ys = hi - lo == 0 ? 1 : hi - lo
          let path0 = range(n).map(i => [i * width / max(1, n - 1), 8 + (1 - (pts[i][1] - lo) / ys) * (height - 16)])
          if n > 1 {
            path(path0 + [[width, height], [0, height]], closed: true, fill: linear(0, 0, 0, height, [alpha(tone, 0.28), alpha(tone, 0)]))
            path(path0, stroke: tone, width: 2, cap: round)
            if hx >= 0 {
              line(hi2 * width / (n - 1), 0, hi2 * width / (n - 1), height, stroke: alpha(foreground, 0.5), width: 1)
              circle(hi2 * width / (n - 1), 8 + (1 - (pts[hi2][1] - lo) / ys) * (height - 16), 4, fill: tone)
            }
          } else {
            text(chart == null || chart.ok ? "loading chart…" : "chart unavailable", width / 2, height / 2, size: 13, align: center, color: muted)
          }
        }
        Row {
          gap: 6
          for r in [{d: 1, l: "24h"}, {d: 7, l: "7d"}, {d: 30, l: "1M"}, {d: 90, l: "3M"}, {d: 365, l: "1Y"}] {
            Text { text: r.l; style: small; align: center; maxLines: 1; padding: [12, 6]; color: range == r.d ? foreground : muted; background: range == r.d ? alpha(foreground, 0.12) : null; border: 1; borderColor: range == r.d ? alpha(foreground, 0.7) : alpha(muted, 0.4); weight: 1; onTap: { range = r.d; hx = -1 } }
          }
        }

        Head { t: "change" }
        Row {
          gap: 4
          for p in [{l: "1h", v: row.price_change_percentage_1h_in_currency ?? get(md.price_change_percentage_1h_in_currency ?? {}, vs, null)}, {l: "24h", v: row.price_change_percentage_24h_in_currency ?? md.price_change_percentage_24h}, {l: "7d", v: row.price_change_percentage_7d_in_currency ?? md.price_change_percentage_7d}, {l: "30d", v: row.price_change_percentage_30d_in_currency ?? md.price_change_percentage_30d}, {l: "1y", v: row.price_change_percentage_1y_in_currency ?? md.price_change_percentage_1y}] {
            Column {
              weight: 1
              gap: 2
              padding: [4, 8]
              background: alpha(foreground, 0.05)
              radius: 6 * corners
              Text { text: p.l; style: small; color: muted; align: center }
              Amount { v: p.v; kind: "chg"; sz: 12; right: false; fill: width }
            }
          }
        }

        let dayLo = row.low_24h ?? get(md.low_24h ?? {}, vs, null)
        let dayHi = row.high_24h ?? get(md.high_24h ?? {}, vs, null)
        if dayLo != null && dayHi != null {
          Head { t: "24h range" }
          Box {
            height: 6
            fill: width
            radius: 3
            background: alpha(muted, 0.25)
            Canvas {
              let f = dayHi - dayLo == 0 ? 0.5 : clamp((cPrice - dayLo) / (dayHi - dayLo), 0, 1)
              rect(0, 0, width * f, height, radius: 3, fill: accent)
            }
          }
          Row {
            Amount { v: dayLo; sz: 12; right: false; weight: 1; tint: muted }
            Amount { v: dayHi; sz: 12; weight: 1; tint: muted }
          }
        }

        Head { t: "market" }
        Column {
          gap: 6
          Stat { label: "market cap"; v: row.market_cap ?? get(md.market_cap ?? {}, vs, null) }
          Stat { label: "fully diluted value"; v: row.fully_diluted_valuation ?? get(md.fully_diluted_valuation ?? {}, vs, null) }
          Stat { label: "24h volume"; v: row.total_volume ?? get(md.total_volume ?? {}, vs, null) }
          Stat { label: "circulating supply"; v: row.circulating_supply ?? md.circulating_supply; kind: "supply"; sym: cSym }
          Stat { label: "total supply"; v: row.total_supply ?? md.total_supply; kind: "supply"; sym: cSym }
          Stat { label: "max supply"; v: row.max_supply ?? md.max_supply ?? 0; kind: "supply"; sym: cSym }
        }

        let ath = row.ath ?? get(md.ath ?? {}, vs, null)
        let atl = row.atl ?? get(md.atl ?? {}, vs, null)
        if ath != null {
          Head { t: "all-time high and low" }
          Row {
            gap: 8
            Column {
              weight: 1
              gap: 2
              padding: [12, 10]
              background: alpha(foreground, 0.05)
              radius: 8 * corners
              Text { text: "high · ${sub(row.ath_date ?? get(md.ath_date ?? {}, vs, ""), 0, 10)}"; style: small; color: muted; maxLines: 1 }
              Amount { v: ath; heavy: true; right: false; fill: width }
              Amount { v: row.ath_change_percentage ?? get(md.ath_change_percentage ?? {}, vs, null); kind: "chg"; sz: 12; right: false; fill: width }
            }
            Column {
              weight: 1
              gap: 2
              padding: [12, 10]
              background: alpha(foreground, 0.05)
              radius: 8 * corners
              Text { text: "low · ${sub(row.atl_date ?? get(md.atl_date ?? {}, vs, ""), 0, 10)}"; style: small; color: muted; maxLines: 1 }
              Amount { v: atl; heavy: true; right: false; fill: width }
              Amount { v: row.atl_change_percentage ?? get(md.atl_change_percentage ?? {}, vs, null); kind: "chg"; sz: 12; right: false; fill: width }
            }
          }
        }

        Head { t: "converter" }
        Column {
          gap: 6
          padding: [12, 10]
          background: alpha(foreground, 0.05)
          radius: 8 * corners
          Row {
            gap: 8
            align: center
            Input { text: convIn; placeholder: "amount"; weight: 1; onChange: convIn = value }
            Text { text: convFlip ? (cur == "sats" ? "sats" : upper(cur)) : cSym; width: 56; color: muted; maxLines: 1 }
            Text { text: "⇄"; fontSize: 18; color: accent; width: 28; align: center; onTap: convFlip = !convFlip }
          }
          if convFlip {
            Text { text: cPrice == null ? "–" : "= ${fixed(convN / (cPrice * mul), 8)} ${cSym}"; bold: true; maxLines: 1 }
          } else {
            Row {
              Text { text: "="; bold: true; width: 18 }
              Amount { v: cPrice == null ? null : convN * cPrice; heavy: true; right: false; weight: 1 }
            }
          }
        }

        Head { t: mine != 0 ? "portfolio · you hold ${match(fixed(mine, 8), '^(-?[0-9]+(?:[.][0-9]*[1-9])?)')[0]} ${cSym}" : "portfolio" }
        if !adding {
          Button { text: "add a transaction"; onTap: { adding = true; txSide = "buy"; txAmt = ""; txPrice = cPrice == null ? "" : str(cPrice * mul) } }
        } else {
          Column {
            gap: 8
            padding: [12, 10]
            background: alpha(foreground, 0.05)
            radius: 8 * corners
            Row {
              gap: 6
              Text { text: "buy"; style: small; align: center; maxLines: 1; padding: [12, 6]; color: txSide == "buy" ? foreground : muted; background: txSide == "buy" ? alpha(foreground, 0.12) : null; border: 1; borderColor: txSide == "buy" ? alpha(foreground, 0.7) : alpha(muted, 0.4); weight: 1; onTap: txSide = "buy" }
              Text { text: "sell"; style: small; align: center; maxLines: 1; padding: [12, 6]; color: txSide == "sell" ? foreground : muted; background: txSide == "sell" ? alpha(foreground, 0.12) : null; border: 1; borderColor: txSide == "sell" ? alpha(foreground, 0.7) : alpha(muted, 0.4); weight: 1; onTap: txSide = "sell" }
            }
            Row {
              gap: 8
              align: center
              Text { text: "amount"; style: small; color: muted; width: 70 }
              Input { text: txAmt; placeholder: "0.5"; weight: 1; onChange: txAmt = value }
              Text { text: cSym; style: small; color: muted; width: 48; maxLines: 1 }
            }
            Row {
              gap: 8
              align: center
              Text { text: "price"; style: small; color: muted; width: 70 }
              Input { text: txPrice; placeholder: "per coin"; weight: 1; onChange: txPrice = value }
              Text { text: cur == "sats" ? "sats" : upper(cur); style: small; color: muted; width: 48; maxLines: 1 }
            }
            Row {
              gap: 8
              Button { text: "save"; color: accent; onTap: { txs = num(replace(txAmt, ",", "."), 0) > 0 && num(replace(txPrice, ",", "."), -1) >= 0 ? txs + [{id: openId, symbol: row.symbol ?? cd.symbol, name: cName, side: txSide, amount: num(replace(txAmt, ",", "."), 0), price: num(replace(txPrice, ",", "."), 0) / mul, vs: vs, time: now}] : txs; adding = num(replace(txAmt, ",", "."), 0) > 0 ? false : true } }
              Button { text: "cancel"; color: muted; onTap: adding = false }
            }
          }
        }

        if cd != null && len(cd.categories ?? []) > 0 {
          Head { t: "categories" }
          Flow {
            gap: 6
            for c in cd.categories.filter(c => c != null).take(8) {
              Text { text: c; style: small; color: muted; maxLines: 1; width: min(len(c) * 8 + 18, 300); padding: [8, 3]; border: 1; borderColor: alpha(muted, 0.4); radius: 3 * corners }
            }
          }
        }
        if len(descText) > 0 {
          Head { t: "about" }
          Text { text: descText; style: small; maxLines: descOpen ? 60 : 5; onTap: descOpen = !descOpen }
          Text { text: descOpen ? "less" : "more"; style: small; color: accent; onTap: descOpen = !descOpen }
        }
        if len(links) > 0 {
          Flow {
            gap: 6
            for l in links {
              Text { text: l.label; style: small; color: accent; align: center; width: len(l.label) * 8 + 24; padding: [0, 5]; border: 1; borderColor: alpha(accent, 0.5); radius: 3 * corners; onTap: url(l.href) }
            }
          }
        }
        Text { text: "data: CoinGecko"; style: small; color: muted; align: center; onTap: url("https://www.coingecko.com/en/coins/${openId}") }

      } else if view == "markets" {
        // ---------------------------------------------------------------- markets
        Row {
          gap: 10
          align: center
          padding: [4, 0]
          Image { src: searchIcon; size: 20; tint: muted }
          Input { text: typed; placeholder: "search coins"; weight: 1; onChange: { typed = value; query = len(value) == 0 ? "" : query }; onSubmit: query = value }
          if searching {
            Text { text: "✕"; color: muted; width: 28; align: center; onTap: { typed = ""; query = "" } }
          }
        }
        if searching {
          for c in matches key c.id {
            CoinRow { c: c }
          }
          if len(query) >= 2 {
            Head { t: "all of CoinGecko" }
            if found == null {
              Text { text: "searching…"; style: small; color: muted }
            } else if !found.ok {
              Text { text: found.code == 429 ? "CoinGecko is busy; try again in a minute" : "search failed"; style: small; color: muted }
            } else {
              for c in (found.out.coins ?? []).filter(c => !any(matches, m => m.id == c.id)).take(15) key c.id {
                Row {
                  gap: 10
                  align: center
                  padding: [0, 6]
                  onTap: { openId = c.id; hx = -1; descOpen = false; adding = false; convIn = "1" }
                  Badge { sym: c.symbol; img: c.large }
                  Column {
                    gap: 1
                    weight: 1
                    Text { text: upper(c.symbol); bold: true; maxLines: 1 }
                    Text { text: c.market_cap_rank == null ? c.name : "${c.market_cap_rank} · ${c.name}"; style: small; color: muted; maxLines: 1 }
                  }
                }
              }
            }
          } else {
            Text { text: len(matches) == 0 ? "not in the top 250; press send to search all of CoinGecko" : "press send to search all of CoinGecko"; style: small; color: muted; padding: [0, 6] }
          }
        } else {
          if g != null {
            Grid {
              columns: 2
              gap: 8
              Column {
                gap: 2
                padding: [12, 10]
                background: alpha(foreground, 0.05)
                radius: 8 * corners
                Text { text: "market cap"; style: small; color: muted }
                Row {
                  gap: 6
                  align: center
                  Amount { v: get(g.total_market_cap ?? {}, vs, null); kind: "money"; heavy: true; sz: 16; right: false; width: 92 }
                  Amount { v: g.market_cap_change_percentage_24h_usd; kind: "chg"; sz: 11; right: false; weight: 1 }
                }
              }
              Column {
                gap: 2
                padding: [12, 10]
                background: alpha(foreground, 0.05)
                radius: 8 * corners
                Text { text: "24h volume"; style: small; color: muted }
                Amount { v: vol24; kind: "money"; heavy: true; sz: 16; right: false; fill: width }
              }
              Column {
                gap: 2
                padding: [12, 10]
                background: alpha(foreground, 0.05)
                radius: 8 * corners
                Text { text: "BTC dominance"; style: small; color: muted }
                Amount { v: g.market_cap_percentage.btc; kind: "pct"; heavy: true; sz: 16; right: false; fill: width }
              }
              Column {
                gap: 2
                padding: [12, 10]
                background: alpha(foreground, 0.05)
                radius: 8 * corners
                Text { text: "ETH dominance"; style: small; color: muted }
                Amount { v: g.market_cap_percentage.eth; kind: "pct"; heavy: true; sz: 16; right: false; fill: width }
              }
            }
          }
          Row {
            gap: 6
            for s in [{k: "rank", l: "rank"}, {k: "price", l: "price"}, {k: "24h", l: "24h"}, {k: "7d", l: "7d"}, {k: "volume", l: "volume"}] {
              Text { text: sortKey == s.k ? s.l + (sortDir > 0 ? " ↓" : " ↑") : s.l; style: small; align: center; maxLines: 1; padding: [12, 6]; color: sortKey == s.k ? foreground : muted; background: sortKey == s.k ? alpha(foreground, 0.12) : null; border: 1; borderColor: sortKey == s.k ? alpha(foreground, 0.7) : alpha(muted, 0.4); weight: 1; onTap: { sortDir = sortKey == s.k ? -sortDir : 1; sortKey = s.k; page = 0 } }
            }
          }
          if len(coins) == 0 {
            Text { text: p1 == null ? "loading…" : limited ? "CoinGecko is busy; prices come back in a minute" : "offline"; color: muted; padding: [0, 24]; align: center }
            if p1 != null {
              Button { text: "try again"; onTap: refresh() }
            }
          } else {
            if offline {
              Text { text: limited ? "CoinGecko is busy: these are the last prices" : "offline: these are the last prices"; style: small; color: yellow }
            }
            for c in shown key c.id {
              CoinRow { c: c }
            }
            if pages > 1 {
              Row {
                gap: 8
                align: center
                Text { text: "‹ prev"; style: small; align: center; maxLines: 1; padding: [12, 6]; color: muted; border: 1; borderColor: alpha(muted, 0.4); width: 90; opacity: page > 0 ? 1 : 0.35; onTap: page = max(0, page - 1) }
                Text { text: "${page * 25 + 1}–${min(len(sorted), page * 25 + 25)} of ${len(sorted)}"; style: small; color: muted; weight: 1; align: center }
                Text { text: "next ›"; style: small; align: center; maxLines: 1; padding: [12, 6]; color: muted; border: 1; borderColor: alpha(muted, 0.4); width: 90; opacity: page < pages - 1 ? 1 : 0.35; onTap: page = min(pages - 1, page + 1) }
              }
            }
          }
        }

      } else if view == "watch" {
        // ---------------------------------------------------------------- watchlist
        if len(watch) == 0 {
          Text { text: "tap ☆ next to a coin to follow it here"; color: muted }
        }
        for id, i in watch key id {
          let c = known.find(k => k.id == id)
          if c != null {
            CoinRow { c: c; logo: i < 25 }
          } else {
            Row {
              gap: 10
              align: center
              padding: [0, 6]
              onTap: { openId = id; hx = -1 }
              Text { text: "★"; fontSize: 18; color: yellow; width: 22; align: center; onTap: watch = watch.filter(w => w != id) }
              Text { text: id; color: muted; weight: 1; maxLines: 1 }
              Text { text: "loading…"; style: small; color: muted; width: 80; align: end }
            }
          }
        }

      } else if view == "discover" {
        // ---------------------------------------------------------------- discover
        Head { t: "trending on CoinGecko" }
        if trend == null {
          Text { text: "loading…"; style: small; color: muted }
        } else if !trend.ok {
          Text { text: trend.code == 429 ? "CoinGecko is busy; try again in a minute" : "couldn't load trending coins"; style: small; color: muted }
        } else {
          for t in (trend.out.coins ?? []).take(10) key t.item.id {
            Row {
              gap: 10
              align: center
              padding: [0, 5]
              onTap: { openId = t.item.id; hx = -1; descOpen = false; adding = false; convIn = "1" }
              Badge { sym: t.item.symbol; img: t.item.small }
              Column {
                gap: 1
                weight: 1
                Text { text: upper(t.item.symbol); bold: true; maxLines: 1 }
                Text { text: t.item.market_cap_rank == null ? t.item.name : "${t.item.market_cap_rank} · ${t.item.name}"; style: small; color: muted; maxLines: 1 }
              }
              Amount { v: t.item.data.price_change_percentage_24h.usd; kind: "chg"; sz: 13; width: 110 }
            }
          }
        }
        if len(traded) > 0 {
          Head { t: "biggest gainers, 24h" }
          for c in gainers key c.id {
            CoinRow { c: c }
          }
          Head { t: "biggest losers, 24h" }
          for c in losers key c.id {
            CoinRow { c: c }
          }
        }
        Head { t: "categories by market cap" }
        if cats != null && cats.ok {
          for c in cats.out.filter(c => c.market_cap != null).take(30) key c.id {
            Row {
              gap: 8
              align: center
              padding: [0, 4]
              onTap: url("https://www.coingecko.com/en/categories/${c.id}")
              Text { text: c.name; style: small; weight: 1; maxLines: 1 }
              Amount { v: c.market_cap; kind: "supply"; sym: "USD"; sz: 12; width: 90; tint: muted }
              Amount { v: c.market_cap_change_24h; kind: "chg"; sz: 12; width: 70 }
            }
          }
        } else {
          Text { text: cats == null ? "loading…" : "couldn't load categories"; style: small; color: muted }
        }

      } else if view == "portfolio" {
        // ---------------------------------------------------------------- portfolio
        if len(txs) == 0 {
          Text { text: "open a coin and add a buy or a sell to track what you hold"; color: muted }
        } else {
          Column {
            gap: 4
            padding: [14, 12]
            background: alpha(foreground, 0.05)
            radius: 8 * corners
            Text { text: "value"; style: small; color: muted }
            Amount { v: total; sz: 28; heavy: true; right: false; fill: width }
            Row {
              gap: 6
              Text { text: "24h"; style: small; color: muted; width: 36 }
              Amount { v: totalDay; kind: "delta"; sz: 13; right: false; weight: 1; tint: totalDay >= 0 ? green : red }
            }
            Row {
              gap: 6
              Text { text: "P&L"; style: small; color: muted; width: 36 }
              Amount { v: rt == null && any(txs, t => t.vs != vs) ? null : totalPnl; kind: "delta"; sz: 13; right: false; weight: 1; tint: totalPnl >= 0 ? green : red }
            }
          }
          if total > 0 {
            Row {
              gap: 2
              height: 10
              fill: width
              for h, i in hold.filter(h => h.value > 0) key h.id {
                Box { weight: max(0.001, h.value / total); height: 10; background: palette[i % 8]; radius: 2 }
              }
            }
            Flow {
              gap: 10
              for h, i in hold.filter(h => h.value > 0).take(8) key h.id {
                Text { text: "● ${h.sym} ${round(h.value / total * 100)}%"; style: small; color: palette[i % 8] }
              }
            }
          }
          Head { t: "holdings" }
          for h, i in hold key h.id {
            Row {
              gap: 10
              align: center
              padding: [0, 6]
              onTap: { openId = h.id; hx = -1; adding = false; convIn = "1" }
              Badge { sym: h.sym; img: i < 25 ? h.img : "" }
              Column {
                gap: 1
                weight: 1
                Text { text: h.sym; bold: true; maxLines: 1 }
                Text { text: match(fixed(h.amt, 8), '^(-?[0-9]+(?:[.][0-9]*[1-9])?)')[0]; style: small; color: muted; maxLines: 1 }
              }
              Column {
                gap: 1
                width: 130
                Amount { v: h.priced ? h.value : null; heavy: true }
                Amount { v: h.priced ? h.pnl : null; kind: "delta"; sz: 12; tint: h.pnl >= 0 ? green : red }
              }
            }
          }
          Head { t: "transactions" }
          for t, i in txs.reverse() key "${t.time}-${t.id}-${i}" {
            Row {
              gap: 8
              align: center
              Text { text: t.side; style: small; color: t.side == "buy" ? green : red; width: 34 }
              Text { text: "${match(fixed(t.amount, 8), '^(-?[0-9]+(?:[.][0-9]*[1-9])?)')[0]} ${upper(t.symbol)}"; style: small; weight: 1; maxLines: 1 }
              Text { text: fmtTime(t.time, "d MMM yy"); style: small; color: muted; width: 70; align: end }
              Text { text: "✕"; color: muted; width: 28; align: center; onTap: txs = txs.filter(x => x.time != t.time || x.id != t.id) }
            }
          }
        }

      } else {
        // ---------------------------------------------------------------- settings
        Head { t: "currency" }
        for c in curs key c.code {
          Row {
            gap: 10
            align: center
            padding: [0, 7]
            onTap: { cur = c.code; page = 0 }
            Text { text: c.code == "sats" ? "sats" : trim(c.sym); width: 44; color: cur == c.code ? accent : muted; bold: cur == c.code }
            Text { text: c.name; weight: 1; color: cur == c.code ? foreground : muted }
            Text { text: cur == c.code ? "●" : ""; color: accent; width: 20 }
          }
        }
        Text { text: "Prices, charts and coin details come from CoinGecko's free API, fetched only while the app is open."; style: small; color: muted; padding: [0, 12, 0, 0] }
        Text { text: "coingecko.com"; style: small; color: accent; onTap: url("https://www.coingecko.com") }
      }
    }

    if openId == "" {
      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "markets"; label: "markets"; icon: marketsIcon }
        Tab { name: "watch"; label: "watchlist"; icon: watchIcon }
        Tab { name: "discover"; label: "discover"; icon: discoverIcon }
        Tab { name: "portfolio"; label: "portfolio"; icon: portfolioIcon }
        Tab { name: "settings"; label: "settings"; icon: settingsIcon }
      }
    }
  }
}
