app "formula 1" {
  meta {
    owl: 11
    description: "Formula 1 on one screen: the race weekend and its sessions, the calendar, every result, the driver and team standings, and OpenF1 timing."
    version: "1.1"
    license: "MIT"
    category: "sport"
  }
  // The window's title names the race that's open; Back goes to where it was opened from.
  title: view == "race" && openRace != null ? openRace.full : "F1"
  back: view == "race"
  onBack: view = from
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <rect x="58" y="40" width="12" height="176" rx="6" fill="#C0CAF5"/>
    <path d="M70 48h132v96H70z" fill="#E6E9F5"/>
    <path d="M70 48h33v32H70zM136 48h33v32h-33zM103 80h33v32h-33zM169 80h33v32h-33zM70 112h33v32H70zM136 112h33v32h-33z" fill="#2E3250"/>
    <rect x="98" y="172" width="120" height="14" rx="7" fill="#F7768E"/>
    <rect x="130" y="196" width="88" height="14" rx="7" fill="#FF9E64"/>
  </svg>"""

  // The bottom bar's icons, Material's sports score, calendar today, emoji events and timer (Apache 2.0).
  asset nowIcon = base64""
  asset calendarIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTIwIDNoLTFWMWgtMnYySDdWMUg1djJINGMtMS4xIDAtMiAuOS0yIDJ2MTZjMCAxLjEuOSAyIDIgMmgxNmMxLjEgMCAyLS45IDItMlY1YzAtMS4xLS45LTItMi0yem0wIDE4SDRWOGgxNnYxM3oiLz48L3N2Zz4K"
  asset standingsIcon = base64""
  asset timingIcon = base64""

  // The calendar, results and standings come from jolpica (the Ergast API's successor); the timing tab's
  // sessions, classifications, race control and weather from OpenF1, which is free once a session is 30 minutes over.
  let J = "https://api.jolpi.ca/ergast/f1"

  source now = clock every 30s
  source cal = http("https://api.jolpi.ca/ergast/f1/current.json") every 6h json timeout 20s status
  source drvStand = http("https://api.jolpi.ca/ergast/f1/current/driverStandings.json") every 30m json timeout 20s status
  source conStand = http("https://api.jolpi.ca/ergast/f1/current/constructorStandings.json") every 30m json timeout 20s status
  source lastRes = http("https://api.jolpi.ca/ergast/f1/current/last/results.json") every 15m json timeout 20s status

  state view = "now" persist
  state from = "now"
  state raceRound = 0
  state resKind = "race"
  state table = "drivers" persist
  state openId = ""
  state sessKey = 0

  // The last of everything that loaded, so a start shows it at once and the app works offline.
  state savedSeason = "" persist
  state savedRaces = [] persist
  state savedDrivers = [] persist
  state savedTeams = [] persist
  state savedLast = null persist
  state savedAt = 0 persist

  // Team colours by jolpica's constructor id, for the standings and results.
  let TEAM = {mercedes: "#00D7B6", ferrari: "#ED1131", mclaren: "#F47600", red_bull: "#4781D7", rb: "#6C98FF", alpine: "#00A1E8", haas: "#9C9FA2", audi: "#F50537", sauber: "#01C00E", williams: "#1868DB", aston_martin: "#229971", cadillac: "#909090"}
  // Flags by the circuit's country and the driver's nationality, as flagcdn's ISO codes.
  let COUNTRY = [["Australia", "au"], ["Austria", "at"], ["Azerbaijan", "az"], ["Bahrain", "bh"], ["Belgium", "be"], ["Brazil", "br"], ["Canada", "ca"], ["China", "cn"], ["France", "fr"], ["Germany", "de"], ["Hungary", "hu"], ["Italy", "it"], ["Japan", "jp"], ["Malaysia", "my"], ["Mexico", "mx"], ["Monaco", "mc"], ["Netherlands", "nl"], ["Portugal", "pt"], ["Qatar", "qa"], ["Saudi Arabia", "sa"], ["Singapore", "sg"], ["Spain", "es"], ["Turkey", "tr"], ["UAE", "ae"], ["UK", "gb"], ["USA", "us"], ["United States", "us"]]
  let NATION = [["American", "us"], ["Argentine", "ar"], ["Argentinian", "ar"], ["Australian", "au"], ["Austrian", "at"], ["Belgian", "be"], ["Brazilian", "br"], ["British", "gb"], ["Canadian", "ca"], ["Chinese", "cn"], ["Danish", "dk"], ["Dutch", "nl"], ["Finnish", "fi"], ["French", "fr"], ["German", "de"], ["Italian", "it"], ["Japanese", "jp"], ["Mexican", "mx"], ["Monegasque", "mc"], ["New Zealander", "nz"], ["Polish", "pl"], ["Spanish", "es"], ["Swedish", "se"], ["Swiss", "ch"], ["Thai", "th"]]

  // The calendar, each weekend with its sessions in order. Times are Unix seconds.
  let rt = cal != null && cal.ok ? cal.out.MRData.RaceTable : null
  let freshRaces = rt == null ? null : (rt.Races ?? []).map(r => {
    round: num(r.round, 0),
    name: replace(r.raceName, " Grand Prix", ""),
    full: r.raceName,
    circuit: r.Circuit.circuitName,
    city: r.Circuit.Location.locality,
    country: r.Circuit.Location.country,
    iso: (COUNTRY.find(p => p[0] == r.Circuit.Location.country) ?? ["", ""])[1],
    t: parseTime("${r.date}T${r.time ?? "12:00:00Z"}"),
    sprint: r.Sprint != null,
    sessions: [["practice 1", r.FirstPractice, 3600], ["practice 2", r.SecondPractice, 3600], ["practice 3", r.ThirdPractice, 3600], ["sprint quali", r.SprintQualifying, 2700], ["sprint", r.Sprint, 3600], ["qualifying", r.Qualifying, 3600], ["race", {date: r.date, time: r.time}, 7200]]
      .filter(s => s[1] != null)
      .map(s => {name: s[0], t: parseTime("${s[1].date}T${s[1].time ?? "12:00:00Z"}"), dur: s[2]})
      .sortBy(s => s.t)
  })
  when freshRaces != null && len(freshRaces) > 0 && freshRaces != savedRaces { savedRaces = freshRaces }
  when rt != null && "${rt.season}" != savedSeason { savedSeason = "${rt.season}" }
  when cal != null && cal.ok && now != null && now - savedAt >= 60 { savedAt = now }
  let offline = cal != null && !cal.ok

  // Each weekend as it stands now: done once the race is three hours old, live from its first session.
  let races = (freshRaces ?? savedRaces).map(r => merge(r, {
    state: now == null || now < r.sessions[0].t ? "next" : now >= r.t + 10800 ? "done" : "live",
    dates: fmtTime(r.sessions[0].t, "MMM") == fmtTime(r.t, "MMM") ? "${fmtTime(r.sessions[0].t, "d")}–${fmtTime(r.t, "d MMM")}" : "${fmtTime(r.sessions[0].t, "d MMM")} – ${fmtTime(r.t, "d MMM")}"
  }))
  let weekend = races.find(r => r.state != "done")
  let past = races.filter(r => r.state == "done")
  let latest = len(past) > 0 ? last(past) : null
  let later = weekend == null ? null : races.find(r => r.round > weekend.round)
  let nextSess = weekend == null || now == null ? null : weekend.sessions.find(s => now < s.t + s.dur)
  let liveSess = nextSess != null && now >= nextSess.t ? nextSess : null
  let secs = nextSess == null ? null : nextSess.t - now
  let countdown = secs == null ? "" : secs >= 172800 ? "${floor(secs / 86400)}d" : secs >= 86400 ? "1d ${floor((secs % 86400) / 3600)}h" : secs > 0 ? fmtDuration(secs) : "now"

  // The standings.
  let ds = drvStand != null && drvStand.ok ? drvStand.out.MRData.StandingsTable.StandingsLists[0] : null
  let freshDrivers = ds == null ? null : (ds.DriverStandings ?? []).map(d => {
    id: d.Driver.driverId,
    pos: d.positionText ?? d.position,
    code: d.Driver.code ?? "",
    name: "${d.Driver.givenName} ${d.Driver.familyName}",
    team: (last(d.Constructors ?? []) ?? {}).name ?? "",
    teamId: (last(d.Constructors ?? []) ?? {}).constructorId ?? "",
    iso: (NATION.find(p => p[0] == d.Driver.nationality) ?? ["", ""])[1],
    points: d.points,
    wins: num(d.wins, 0)
  })
  when freshDrivers != null && len(freshDrivers) > 0 && freshDrivers != savedDrivers { savedDrivers = freshDrivers }
  let cs = conStand != null && conStand.ok ? conStand.out.MRData.StandingsTable.StandingsLists[0] : null
  let freshTeams = cs == null ? null : (cs.ConstructorStandings ?? []).map(c => {
    id: c.Constructor.constructorId,
    pos: c.positionText ?? c.position,
    name: c.Constructor.name,
    points: c.points,
    wins: num(c.wins, 0)
  })
  when freshTeams != null && len(freshTeams) > 0 && freshTeams != savedTeams { savedTeams = freshTeams }
  let drivers = savedDrivers
  let teams = savedTeams
  let standRound = ds.round ?? ""

  // The last race's podium, for the first tab.
  let lr = lastRes != null && lastRes.ok ? lastRes.out.MRData.RaceTable.Races[0] : null
  let freshLast = lr == null ? null : {
    round: num(lr.round, 0),
    name: replace(lr.raceName, " Grand Prix", ""),
    top: (lr.Results ?? []).take(3).map(x => {
      key: x.Driver.driverId,
      pos: x.positionText,
      code: x.Driver.code ?? "",
      name: "${x.Driver.givenName} ${x.Driver.familyName}",
      team: x.Constructor.name,
      colour: TEAM[x.Constructor.constructorId] ?? "#888888",
      value: x.Time.time ?? x.status ?? "",
      extra: num(x.points, 0) > 0 ? "+${x.points}" : ""
    })
  }
  when freshLast != null && freshLast != savedLast { savedLast = freshLast }

  // A race's results, while one is open: the race, qualifying or the sprint.
  let openRace = races.find(r => r.round == raceRound)
  let kinds = openRace == null ? [] : openRace.sprint ? ["race", "qualifying", "sprint"] : ["race", "qualifying"]
  source raceRes = http(view != "race" || openRace == null || openRace.state == "next" ? null : resKind == "qualifying" ? "${J}/current/${int(raceRound)}/qualifying.json" : resKind == "sprint" ? "${J}/current/${int(raceRound)}/sprint.json" : "${J}/current/${int(raceRound)}/results.json") every 10m json timeout 20s status
  let rd = raceRes != null && raceRes.ok ? raceRes.out.MRData.RaceTable : null
  // Matched by round and by what it holds, so the answer for the race or the kind shown before never lands here.
  let rr = rd == null || num(rd.round, 0) != raceRound ? null : (rd.Races ?? [])[0]
  let rrList = rr == null ? null : resKind == "qualifying" ? rr.QualifyingResults : resKind == "sprint" ? rr.SprintResults : rr.Results
  let resRows = rrList == null ? null : rrList.map(x => {
    key: x.Driver.driverId,
    pos: x.positionText == "R" ? "DNF" : x.positionText == "D" ? "DSQ" : x.positionText == "W" ? "DNS" : x.positionText == "N" ? "NC" : x.positionText ?? x.position,
    code: x.Driver.code ?? "",
    name: "${x.Driver.givenName} ${x.Driver.familyName}",
    team: x.Constructor.name,
    colour: TEAM[x.Constructor.constructorId] ?? "#888888",
    value: resKind == "qualifying" ? (x.Q3 ?? x.Q2 ?? x.Q1 ?? "") : (x.Time.time ?? lower(x.status ?? "")),
    extra: resKind == "qualifying" ? (x.Q3 != null ? "Q3" : x.Q2 != null ? "Q2" : "Q1") : num(x.points, 0) > 0 ? "+${x.points}" : ""
  })
  let resEmpty = rd != null && num(rd.round, 0) == raceRound && len(rd.Races ?? []) == 0
  let resFailed = raceRes != null && !raceRes.ok

  // A driver's season, race by race, while their row is open in the standings.
  let openDriver = table == "drivers" ? drivers.find(d => d.id == openId) : null
  source drvRes = http(view != "standings" || openDriver == null ? null : "${J}/current/drivers/${enc(openDriver.id)}/results.json?limit=40") every 30m json timeout 20s status
  let dr = drvRes != null && drvRes.ok && drvRes.out.MRData.RaceTable.driverId == openId ? drvRes.out.MRData.RaceTable.Races : null
  let season = dr == null ? null : dr.map(r => {
    round: num(r.round, 0),
    name: replace(r.raceName, " Grand Prix", ""),
    grid: num(r.Results[0].grid, 0),
    pos: r.Results[0].positionText == "R" ? "DNF" : r.Results[0].positionText == "D" ? "DSQ" : r.Results[0].positionText == "W" ? "DNS" : r.Results[0].positionText,
    points: num(r.Results[0].points, 0)
  })

  // OpenF1, only while the timing tab shows, one request after the other to stay inside its 3 a second.
  source meet = http(view == "timing" ? "https://api.openf1.org/v1/sessions?meeting_key=latest" : null) every 10m json timeout 20s status
  let sessions = meet == null || !meet.ok ? [] : (meet.out ?? []).map(s => {
    key: s.session_key,
    name: lower(s.session_name ?? ""),
    short: s.session_name == "Practice 1" ? "FP1" : s.session_name == "Practice 2" ? "FP2" : s.session_name == "Practice 3" ? "FP3" : s.session_name == "Sprint Qualifying" || s.session_name == "Sprint Shootout" ? "SQ" : s.session_name == "Qualifying" ? "Quali" : s.session_name ?? "",
    type: s.session_type ?? "",
    place: s.location ?? s.circuit_short_name ?? "",
    country: s.country_name ?? "",
    t0: parseTime(s.date_start),
    t1: parseTime(s.date_end)
  }).filter(s => s.t0 != null).sortBy(s => s.t0)
  let free = sessions.filter(s => now != null && now >= s.t1 + 1800)
  let liveTiming = sessions.find(s => now != null && now >= s.t0 && now < s.t1 + 1800)
  let tSess = free.find(s => s.key == sessKey) ?? (len(free) > 0 ? last(free) : null)
  // The drivers first, so the classification shows with their names from the start.
  source tdrv = http(tSess == null || view != "timing" ? null : "https://api.openf1.org/v1/drivers?session_key=${int(tSess.key)}") every 1h json timeout 20s status
  let tdrvOk = tSess != null && tdrv != null && tdrv.ok && (tdrv.out[0].session_key ?? 0) == tSess.key
  source sres = http(!tdrvOk ? null : "https://api.openf1.org/v1/session_result?session_key=${int(tSess.key)}") every 10m json timeout 20s status
  let sresOk = tdrvOk && sres != null && sres.ok && (sres.out[0].session_key ?? 0) == tSess.key
  source rc = http(!sresOk ? null : "https://api.openf1.org/v1/race_control?session_key=${int(tSess.key)}") every 10m json timeout 20s status
  let rcOk = sresOk && rc != null && rc.ok && (rc.out[0].session_key ?? 0) == tSess.key
  source wx = http(!rcOk ? null : "https://api.openf1.org/v1/weather?session_key=${int(tSess.key)}") every 10m json timeout 20s status
  let tFailed = (meet != null && !meet.ok) || (tSess != null && ((tdrv != null && !tdrv.ok) || (sres != null && !sres.ok && sres.code != 404)))
  // OpenF1 allows 30 requests a minute; past that it answers 429 for a moment, and the source tries again in 30 s.
  let tBusy = (meet != null && meet.code == 429) || (tdrv != null && tdrv.code == 429) || (sres != null && sres.code == 429)
  let tDrivers = tdrvOk ? tdrv.out : []
  let isRace = tSess != null && tSess.type == "Race"
  let isQuali = tSess != null && tSess.type == "Qualifying"
  // Each driver's line: a race by its gap to the winner, qualifying by the best lap of the last part reached, practice by the best lap.
  let timing = !sresOk ? null : sres.out.map(x => [x, tDrivers.find(d => d.driver_number == x.driver_number) ?? {}, isQuali ? count((x.duration ?? []).filter(v => v != null)) : 0]).map(p => {
    key: "${p[0].driver_number}",
    pos: p[0].position != null ? "${p[0].position}" : p[0].dsq ? "DSQ" : p[0].dns ? "DNS" : p[0].dnf ? "DNF" : "–",
    code: p[1].name_acronym ?? "${p[0].driver_number}",
    name: p[1].first_name != null ? "${p[1].first_name} ${capitalize(lower(p[1].last_name ?? ""))}" : "#${p[0].driver_number}",
    team: p[1].team_name ?? "",
    colour: p[1].team_colour != null ? "#${p[1].team_colour}" : "#888888",
    value: isRace ? (p[0].position == 1 && p[0].duration != null ? fmtTime(p[0].duration, "H:mm:ss", "UTC") : p[0].gap_to_leader == null ? (p[0].dnf ? "dnf" : "") : num(p[0].gap_to_leader, -1) < 0 ? lower(str(p[0].gap_to_leader)) : "+${fixed(p[0].gap_to_leader, 3)}")
      : isQuali ? (p[2] == 0 ? "" : "${floor(p[0].duration[p[2] - 1] / 60)}:${pad(fixed(p[0].duration[p[2] - 1] % 60, 3), 6, "0")}")
      : (p[0].duration == null ? "" : "${floor(p[0].duration / 60)}:${pad(fixed(p[0].duration % 60, 3), 6, "0")}"),
    extra: isRace ? (num(p[0].points, 0) > 0 ? "+${round(p[0].points)}" : "${p[0].number_of_laps ?? 0} laps") : isQuali ? (p[2] == 0 ? "" : "Q${p[2]}") : "${p[0].number_of_laps ?? 0} laps"
  })
  let messages = !rcOk ? [] : rc.out.filter(m => m.message != null && m.category != "Other").reverse().take(8).map(m => {
    key: "${m.date}${m.message}",
    at: fmtTime(parseTime(m.date), "HH:mm"),
    lap: m.lap_number,
    flag: m.flag ?? (m.category == "SafetyCar" ? "YELLOW" : ""),
    text: capitalize(lower(m.message))
  })
  let weather = wx != null && wx.ok && len(wx.out ?? []) > 0 && (last(wx.out).session_key ?? 0) == (tSess.key ?? -1) ? last(wx.out) : null

  // A choice in a row of them, like the kinds of results.
  component Pick(label, on) {
    Text {
      text: label
      align: center
      maxLines: 1
      width: len(label) * 8 + 22
      padding: [0, 6]
      radius: 4 * corners
      color: on ? foreground : muted
      background: on ? alpha(foreground, 0.16) : null
      border: 1
      borderColor: on ? alpha(foreground, 0.7) : alpha(muted, 0.4)
    }
  }

  component Flag(iso) {
    Box {
      width: 24
      height: 16
      align: center
      if iso != "" {
        Image { src: "https://flagcdn.com/w40/${enc(iso)}.png"; width: 22; height: 15; fit: contain; radius: 2 }
      }
    }
  }

  // A result's line: position, the team's colour, the driver and what they did.
  component Line(x) {
    Row {
      gap: 8
      align: center
      Text {
        text: x.pos
        width: 30
        align: end
        maxLines: 1
        bold: x.pos == "1" || x.pos == "2" || x.pos == "3"
        color: x.pos == "1" ? yellow : x.pos == "2" ? foreground : x.pos == "3" ? orange : muted
      }
      Box { width: 3; height: 28; radius: 2; background: x.colour }
      Column {
        gap: 0
        weight: 1
        Text { text: x.name; style: small; maxLines: 1 }
        Text { text: x.team; style: label; color: muted; maxLines: 1 }
      }
      Column {
        gap: 0
        align: end
        Text { text: x.value; style: small; font: mono; maxLines: 1 }
        if x.extra != "" {
          Text { text: x.extra; style: label; color: muted; maxLines: 1 }
        }
      }
    }
  }

  // A weekend's sessions in the phone's time: done ones muted, the live one in the accent.
  component Schedule(r) {
    Column {
      gap: 4
      for s in r.sessions key s.name {
        let on = now != null && now >= s.t && now < s.t + s.dur
        let gone = now != null && now >= s.t + s.dur
        Row {
          gap: 8
          align: center
          Box { width: 6; height: 6; radius: 3; background: on ? accent : gone ? alpha(muted, 0.4) : yellow }
          Text { text: s.name; style: small; weight: 1; maxLines: 1; color: gone ? muted : foreground; bold: on }
          Text { text: on ? "live" : fmtTime(s.t, "EEE HH:mm"); style: small; font: mono; color: on ? accent : muted; maxLines: 1 }
        }
      }
    }
  }

  // A tab of the bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, icon) {
    let on = view == name || (view == "race" && from == name)
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { view = name; openId = ""; haptic() }
      Box {
        align: center
        width: 64
        height: 32
        Image { src: icon; size: 24; tint: on ? foreground : muted }
      }
      Text { text: name; style: small; align: center; maxLines: 1; bold: on; color: on ? foreground : muted }
    }
  }

  Column {
    fill: true
    gap: 0
    // One per tab, so each opens at its top rather than where the last one was scrolled to.
    for v in [view] key v {
      Column {
        weight: 1
        scroll: true
        gap: 12
        padding: [12, 0, 12, 12]

        if len(races) == 0 {
          Column {
            gap: 8
            Text { text: "formula 1"; style: muted }
            Text { text: offline ? "results offline" : "loading…"; style: title; color: muted }
            if offline {
              Button { text: "try again"; onTap: refresh() }
            }
          }
        } else {
          if view == "now" {
            Row {
              align: center
              Text { text: "formula 1"; style: small; color: muted; weight: 1; maxLines: 1 }
              Text { text: savedSeason; style: small; color: muted }
            }
            if weekend == null {
              Text { text: "the season is over"; style: title }
            } else {
              Column {
                gap: 8
                padding: 12
                radius: 8 * corners
                background: weekend.state == "live" ? alpha(accent, 0.16) : alpha(foreground, 0.05)
                border: 1
                borderColor: weekend.state == "live" ? alpha(accent, 0.55) : alpha(muted, 0.35)
                onTap: { from = "now"; view = "race"; raceRound = weekend.round; resKind = "race"; haptic() }
                Row {
                  align: center
                  Text {
                    text: liveSess != null ? "${liveSess.name} live" : weekend.state == "live" ? "race weekend" : "next up · round ${weekend.round}"
                    style: label
                    weight: 1
                    maxLines: 1
                    color: accent
                  }
                  Flag { iso: weekend.iso }
                }
                Column {
                  gap: 2
                  Text { text: weekend.full; style: title; maxLines: 2 }
                  Text { text: "${weekend.city} · ${weekend.dates}"; style: small; color: muted; maxLines: 1 }
                }
                if nextSess != null && liveSess == null && countdown != "" {
                  Row {
                    align: bottom
                    gap: 8
                    Text { text: countdown; fontSize: 32; bold: true; maxLines: 1 }
                    Text { text: "to ${nextSess.name}"; style: small; color: muted; padding: [0, 0, 0, 6]; maxLines: 1 }
                  }
                }
                Schedule { r: weekend }
              }

              if later != null {
                Row {
                  gap: 8
                  align: center
                  onTap: { from = "now"; view = "race"; raceRound = later.round; resKind = "race"; haptic() }
                  Text { text: "then"; style: label; color: muted; width: 36 }
                  Flag { iso: later.iso }
                  Text { text: later.name; style: small; weight: 1; maxLines: 1 }
                  Text { text: later.dates; style: small; color: muted; maxLines: 1 }
                }
              }
            }

            if savedLast != null {
              Column {
                gap: 6
                onTap: { from = "now"; view = "race"; raceRound = savedLast.round; resKind = "race"; haptic() }
                Row {
                  align: center
                  Text { text: "last race"; style: label; color: muted; weight: 1 }
                  Text { text: "round ${savedLast.round}"; style: label; color: muted }
                }
                Text { text: savedLast.name; style: body; maxLines: 1 }
                for x in savedLast.top key x.key { Line { x: x } }
              }
            }

            if len(drivers) > 0 {
              Column {
                gap: 6
                onTap: { view = "standings"; table = "drivers"; openId = ""; haptic() }
                Row {
                  align: center
                  Text { text: "championship"; style: label; color: muted; weight: 1 }
                  Text { text: standRound == "" ? "" : "after round ${standRound}"; style: label; color: muted }
                }
                for d in drivers.take(3) key d.id {
                  Row {
                    gap: 8
                    align: center
                    Text { text: d.pos; width: 30; align: end; bold: true; color: d.pos == "1" ? yellow : d.pos == "2" ? foreground : orange }
                    Box { width: 3; height: 20; radius: 2; background: TEAM[d.teamId] ?? "#888888" }
                    Text { text: d.name; style: small; weight: 1; maxLines: 1 }
                    Text { text: "${d.points}"; style: small; font: mono; bold: d.pos == "1" }
                  }
                }
                if len(drivers) > 1 {
                  Text { text: "${num(drivers[0].points, 0) - num(drivers[1].points, 0)} points between first and second"; style: label; color: muted; padding: [38, 0, 0, 0] }
                }
              }
            }
          }

          if view == "calendar" {
            for r in races key r.round {
              Row {
                gap: 8
                align: center
                padding: [0, 4]
                onTap: { from = "calendar"; view = "race"; raceRound = r.round; resKind = "race"; haptic() }
                Box { width: 3; height: 34; radius: 2; background: r.state == "live" ? accent : r.state == "next" ? yellow : alpha(muted, 0.35) }
                Text { text: "${r.round}"; style: label; color: muted; width: 20; align: end }
                Flag { iso: r.iso }
                Column {
                  gap: 0
                  weight: 1
                  Text { text: r.name; style: body; maxLines: 1; color: r.state == "done" ? muted : foreground; bold: weekend != null && r.round == weekend.round }
                  Text { text: r.city; style: small; color: muted; maxLines: 1 }
                }
                if r.sprint {
                  Text { text: "sprint"; style: label; color: orange; padding: [5, 1]; radius: 3 * corners; border: 1; borderColor: alpha(orange, 0.45) }
                }
                Text { text: r.dates; style: small; color: r.state == "done" ? muted : foreground; maxLines: 1 }
              }
            }
          }

          if view == "race" && openRace != null {
            let r = openRace
            Column {
              gap: 10
              Row {
                gap: 8
                align: center
                Flag { iso: r.iso }
                Column {
                  gap: 0
                  weight: 1
                  Text { text: r.circuit; style: small; maxLines: 1 }
                  Text { text: "${r.city}, ${r.country} · round ${r.round}"; style: label; color: muted; maxLines: 1 }
                }
                Text { text: r.dates; style: small; color: muted }
              }
              Schedule { r: r }
              if r.state == "next" {
                Text { text: "results come after the race"; style: small; color: muted }
              } else {
                Flow {
                  gap: 6
                  for k in kinds key k {
                    Box { onTap: { resKind = k; haptic() }; Pick { label: k; on: resKind == k } }
                  }
                }
                if resRows == null {
                  Text { text: resFailed ? "results offline" : resEmpty ? "no results yet" : "loading results…"; style: small; color: muted }
                  if resFailed {
                    Button { text: "try again"; onTap: refresh() }
                  }
                } else if len(resRows) == 0 {
                  Text { text: "no results yet"; style: small; color: muted }
                } else {
                  Column {
                    gap: 6
                    for x in resRows key x.key { Line { x: x } }
                  }
                }
              }
            }
          }

          if view == "standings" {
            Row {
              gap: 6
              Box { onTap: { table = "drivers"; openId = ""; haptic() }; Pick { label: "drivers"; on: table == "drivers" } }
              Box { onTap: { table = "teams"; openId = ""; haptic() }; Pick { label: "teams"; on: table == "teams" } }
              Spacer { weight: 1 }
              Text { text: standRound == "" ? "" : "after round ${standRound}"; style: label; color: muted }
            }
            if table == "drivers" {
              if len(drivers) == 0 {
                Text { text: "loading the standings…"; style: small; color: muted }
              }
              for d in drivers key d.id {
                Column {
                  gap: 6
                  padding: [8, 6]
                  radius: 6 * corners
                  background: openId == d.id ? alpha(accent, 0.08) : null
                  onTap: { openId = openId == d.id ? "" : d.id; haptic() }
                  Row {
                    gap: 8
                    align: center
                    Text { text: d.pos; width: 22; align: end; bold: d.pos == "1" || d.pos == "2" || d.pos == "3"; color: d.pos == "1" ? yellow : d.pos == "2" ? foreground : d.pos == "3" ? orange : muted }
                    Box { width: 3; height: 28; radius: 2; background: TEAM[d.teamId] ?? "#888888" }
                    Flag { iso: d.iso }
                    Column {
                      gap: 0
                      weight: 1
                      Text { text: d.name; style: small; maxLines: 1 }
                      Text { text: d.team; style: label; color: muted; maxLines: 1 }
                    }
                    Column {
                      gap: 0
                      align: end
                      Text { text: "${d.points}"; style: small; font: mono; bold: d.pos == "1" }
                      if d.wins > 0 {
                        Text { text: d.wins == 1 ? "1 win" : "${d.wins} wins"; style: label; color: muted }
                      }
                    }
                  }
                  if openId == d.id {
                    if season == null {
                      Text { text: drvRes != null && !drvRes.ok ? "results offline" : "loading the season…"; style: small; color: muted; padding: [30, 0, 0, 0] }
                    } else {
                      for s in season key s.round {
                        Row {
                          gap: 8
                          align: center
                          Text { text: "${s.round}"; style: label; color: muted; width: 22; align: end }
                          Text { text: s.name; style: small; weight: 1; maxLines: 1 }
                          Text { text: "P${s.grid} →"; style: label; color: muted; font: mono }
                          Text { text: s.pos; style: small; font: mono; width: 34; align: end; bold: s.pos == "1"; color: s.pos == "1" ? yellow : foreground }
                          Text { text: s.points > 0 ? "+${s.points}" : ""; style: label; color: muted; width: 30; align: end }
                        }
                      }
                    }
                  }
                }
              }
            } else {
              if len(teams) == 0 {
                Text { text: "loading the standings…"; style: small; color: muted }
              }
              for t in teams key t.id {
                Column {
                  gap: 6
                  padding: [8, 6]
                  radius: 6 * corners
                  background: openId == t.id ? alpha(accent, 0.08) : null
                  onTap: { openId = openId == t.id ? "" : t.id; haptic() }
                  Row {
                    gap: 8
                    align: center
                    Text { text: t.pos; width: 22; align: end; bold: t.pos == "1" || t.pos == "2" || t.pos == "3"; color: t.pos == "1" ? yellow : t.pos == "2" ? foreground : t.pos == "3" ? orange : muted }
                    Box { width: 3; height: 28; radius: 2; background: TEAM[t.id] ?? "#888888" }
                    Column {
                      gap: 0
                      weight: 1
                      Text { text: t.name; style: small; maxLines: 1 }
                      Text { text: t.wins == 0 ? "no wins" : t.wins == 1 ? "1 win" : "${t.wins} wins"; style: label; color: muted; maxLines: 1 }
                    }
                    Text { text: "${t.points}"; style: small; font: mono; bold: t.pos == "1" }
                  }
                  if openId == t.id {
                    for d in drivers.filter(d => d.teamId == t.id) key d.id {
                      Row {
                        gap: 8
                        align: center
                        padding: [30, 0, 0, 0]
                        Flag { iso: d.iso }
                        Text { text: d.name; style: small; weight: 1; maxLines: 1 }
                        Text { text: "P${d.pos}"; style: label; color: muted }
                        Text { text: "${d.points}"; style: small; font: mono; width: 40; align: end }
                      }
                    }
                  }
                }
              }
            }
          }

          if view == "timing" {
            if len(sessions) == 0 {
              Text { text: tBusy ? "OpenF1 is busy, trying again in a moment…" : tFailed ? "OpenF1 is offline" : "loading the timing…"; style: small; color: muted }
              if tFailed {
                Button { text: "try again"; onTap: refresh() }
              }
            } else {
              Row {
                align: center
                Column {
                  gap: 0
                  weight: 1
                  Text { text: sessions[0].country; style: body; maxLines: 1 }
                  Text { text: sessions[0].place; style: small; color: muted; maxLines: 1 }
                }
                if weather != null {
                  Column {
                    gap: 0
                    align: end
                    Text { text: "air ${round(weather.air_temperature)}° · track ${round(weather.track_temperature)}°"; style: small; font: mono }
                    Text { text: num(weather.rainfall, 0) > 0 ? "rain · wind ${fixed(weather.wind_speed, 1)} m/s" : "dry · wind ${fixed(weather.wind_speed, 1)} m/s"; style: label; color: muted }
                  }
                }
              }
              if liveTiming != null {
                Column {
                  gap: 2
                  padding: 10
                  radius: 8 * corners
                  background: alpha(accent, 0.12)
                  border: 1
                  borderColor: alpha(accent, 0.5)
                  Text { text: "${liveTiming.name} is on"; style: label; color: accent }
                  Text { text: "OpenF1's timing for it opens to everyone at ${fmtTime(liveTiming.t1 + 1800, "HH:mm")}, half an hour after the session"; style: small; color: muted }
                }
              }
              Flow {
                gap: 6
                for s in sessions key s.key {
                  let ok = now != null && now >= s.t1 + 1800
                  Box {
                    onTap: { if ok { sessKey = s.key; haptic() } }
                    opacity: ok ? 1 : 0.45
                    Pick { label: s.short; on: tSess != null && tSess.key == s.key }
                  }
                }
              }
              if tSess == null {
                Text { text: "the first session starts ${fmtTime(sessions[0].t0, "EEE HH:mm")}"; style: small; color: muted }
              } else {
                Row {
                  align: center
                  Text { text: tSess.name; style: label; color: muted; weight: 1 }
                  Text { text: fmtTime(tSess.t0, "EEE d MMM HH:mm"); style: label; color: muted }
                }
                if timing == null {
                  Text { text: tBusy ? "OpenF1 is busy, trying again in a moment…" : tFailed ? "OpenF1 is offline" : sres != null && sres.ok && len(sres.out ?? []) == 0 ? "no timing for this session" : "loading the timing…"; style: small; color: muted }
                } else {
                  Column {
                    gap: 6
                    for x in timing key x.key { Line { x: x } }
                  }
                }
                if len(messages) > 0 {
                  Column {
                    gap: 4
                    Text { text: "race control"; style: label; color: muted; padding: [0, 6, 0, 0] }
                    for m in messages key m.key {
                      Row {
                        gap: 8
                        align: top
                        Text { text: m.at; style: label; font: mono; color: muted }
                        Box {
                          width: 8
                          height: 8
                          radius: 2
                          offset: [0, 4]
                          background: m.flag == "GREEN" || m.flag == "CLEAR" ? green : m.flag == "YELLOW" || m.flag == "DOUBLE YELLOW" ? yellow : m.flag == "RED" ? red : m.flag == "BLUE" ? blue : m.flag == "CHEQUERED" ? foreground : alpha(muted, 0.4)
                        }
                        Text { text: m.text; style: small; weight: 1; maxLines: 3 }
                      }
                    }
                  }
                }
              }
              Text { text: "timing from OpenF1 · openf1.org ↗"; style: label; color: accent; padding: [0, 4]; onTap: url("https://openf1.org") }
            }
          }

          if offline && savedAt > 0 {
            Text { text: "offline · saved ${fmtTime(savedAt, "d MMM HH:mm")}"; style: label; color: muted }
          }
        }
      }
    }

    Box { height: 1; fill: width; background: alpha(muted, 0.25) }
    Row {
      gap: 0
      Tab { name: "now"; icon: nowIcon }
      Tab { name: "calendar"; icon: calendarIcon }
      Tab { name: "standings"; icon: standingsIcon }
      Tab { name: "timing"; icon: timingIcon }
    }
  }
}
