app "hacker news" {
  meta { owl: 8; description: "A Hacker News reader: the front page, newest, Ask and Show HN, and every story's comments, threaded and in HN's order"; version: "2.1"; license: "MIT"; category: "news" }
  // A story's comments are a view of their own; Back returns to the list.
  title: open == 0 ? "hacker news" : story.comments == 1 ? "1 comment" : "${story.comments ?? 0} comments"
  back: open != 0
  onBack: { open = 0; expanded = [] }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#FF6600"/>
    <g fill="#FFFFFF">
      <path d="M52 116l30-40 30 40z"/>
      <rect x="132" y="80" width="72" height="14" rx="7"/>
      <rect x="132" y="104" width="72" height="14" rx="7"/>
      <rect x="52" y="140" width="152" height="14" rx="7"/>
      <rect x="52" y="168" width="112" height="14" rx="7"/>
    </g>
  </svg>"""

  // The bottom bar's icons, Material's trending up, schedule, help outline and visibility (Apache 2.0).
  asset topIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE2IDZsMi4yOSAyLjI5LTQuODggNC44OC00LTRMMiAxNi41OSAzLjQxIDE4bDYtNiA0IDQgNi4zLTYuMjlMMjIgMTJWNnoiLz48L3N2Zz4K"
  asset newIcon = base64""
  asset askIcon = base64""
  asset showIcon = base64""

  state feed = "top" persist
  // The story whose comments are open (0 for the lists), and the comment threads unfolded in it.
  state open = 0
  state story = {}
  state expanded = []
  // Stories read, so the lists show them dimmed; the last 500.
  state seen = [] persist
  // Each feed as it last loaded, so a start shows it at once and the app reads offline.
  state savedTop = [] persist
  state savedNew = [] persist
  state savedAsk = [] persist
  state savedShow = [] persist

  source now = clock every 1m
  // Only the feed on show is asked for; the others wait with their saved lists.
  source top = http(feed == "top" ? "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=50" : null) every 5m json timeout 15s status
  source fresh = http(feed == "new" ? "https://hn.algolia.com/api/v1/search_by_date?tags=story&hitsPerPage=50" : null) every 5m json timeout 15s status
  source ask = http(feed == "ask" ? "https://hn.algolia.com/api/v1/search?tags=ask_hn&hitsPerPage=50" : null) every 5m json timeout 15s status
  source show = http(feed == "show" ? "https://hn.algolia.com/api/v1/search?tags=show_hn&hitsPerPage=50" : null) every 5m json timeout 15s status
  // The open story's comment tree from Algolia, and from HN itself the order its top comments rank in.
  source thread = http(open == 0 ? null : "https://hn.algolia.com/api/v1/items/${open}") every 5m json timeout 25s status
  source ranked = http(open == 0 ? null : "https://hacker-news.firebaseio.com/v0/item/${open}.json") every 5m json timeout 15s status

  // Each feed's stories, trimmed to what a row shows.
  let liveTop = top == null || !top.ok ? null : top.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  let liveNew = fresh == null || !fresh.ok ? null : fresh.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  let liveAsk = ask == null || !ask.ok ? null : ask.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  let liveShow = show == null || !show.ok ? null : show.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  when liveTop != null && liveTop != savedTop { savedTop = liveTop }
  when liveNew != null && liveNew != savedNew { savedNew = liveNew }
  when liveAsk != null && liveAsk != savedAsk { savedAsk = liveAsk }
  when liveShow != null && liveShow != savedShow { savedShow = liveShow }

  let src = feed == "new" ? fresh : feed == "ask" ? ask : feed == "show" ? show : top
  let stories = feed == "new" ? savedNew : feed == "ask" ? savedAsk : feed == "show" ? savedShow : savedTop
  let offline = src != null && !src.ok

  // The open story's comments: top ones in HN's order, each with its replies flattened, six deep.
  let tree = thread != null && thread.ok && thread.out.id == open ? thread.out : null
  let kids = ranked != null && ranked.ok && ranked.out.id == open ? ranked.out.kids ?? [] : []
  let tops = tree == null ? [] : (tree.children ?? []).filter(c => c.text != null || len(c.children ?? []) > 0).sortBy(c => indexOf(kids, c.id) < 0 ? 100000 + c.created_at_i % 100000 : indexOf(kids, c.id))

  // "2h", "3d": how long ago.
  component Ago(t) {
    Text { text: now == null ? "" : now - t < 3600 ? "${max(1, floor((now - t) / 60))}m" : now - t < 86400 ? "${floor((now - t) / 3600)}h" : "${floor((now - t) / 86400)}d"; style: small; color: muted; width: 32; maxLines: 1 }
  }

  // HN's comment HTML as text: paragraphs from <p>, tags dropped, entities read; its links listed under it.
  component Html(t, small = false) {
    let raw = t ?? ""
    let plain = join(split(raw, "<p>").map(p => join(matchAll(p, '<[^>]*>|[^<]+').filter(x => !startsWith(x, "<")), "")), "\n\n")
    let read = replace(replace(replace(replace(replace(replace(replace(plain, "&#x2F;", "/"), "&#x27;", "'"), "&quot;", "\""), "&gt;", ">"), "&lt;", "<"), "&#x60;", "`"), "&amp;", "&")
    let links = matchAll(raw, 'href="([^"]+)"').map(l => replace(replace(l[0], "&#x2F;", "/"), "&amp;", "&"))
    Column {
      gap: 4
      Text { text: read; style: small ? "small" : "body"; font: contains(raw, "<pre>") ? "mono" : "sans" }
      for l in links.take(3) {
        Text { text: "${match(l, '^https?://(?:www\.)?([^/]+)')[0] ?? l} ↗"; style: small; color: accent; maxLines: 1; onTap: url(l) }
      }
    }
  }

  // One comment: who and when, what they wrote, and how many replies sit under it.
  component Comment(c, depth = 0) {
    let replies = len(c.children ?? [])
    Row {
      gap: 8
      align: top
      // A reply sits in from its parent.
      if depth > 0 { Spacer { width: depth * 12 - 8 } }
      Column {
        gap: 3
        weight: 1
        Row {
          gap: 6
          Text { text: c.author ?? "[deleted]"; style: small; bold: true; color: c.author == story.author ? orange : accent; weight: 1; maxLines: 1 }
          Ago { t: c.created_at_i }
        }
        if c.text == null {
          Text { text: "[deleted]"; style: small; color: muted }
        } else {
          Html { t: c.text; small: depth > 0 }
        }
      }
    }
  }

  // A tab of the bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, icon) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { feed = name; open = 0; expanded = []; haptic() }
      Box {
        align: center
        width: 56
        height: 32
        Image { src: icon; size: 24; tint: feed == name ? foreground : muted }
      }
      Text { text: name; style: small; align: center; maxLines: 1; bold: feed == name; color: feed == name ? foreground : muted }
    }
  }

  Column {
    fill: true
    gap: 0

    if open == 0 {
      Column {
        scroll: true
        weight: 1
        gap: 14
        padding: [12, 4, 12, 12]
        if len(stories) == 0 {
          Text { text: offline ? "offline" : "loading…"; color: muted }
          if offline { Button { text: "try again"; onTap: refresh() } }
        }
        for s, i in stories key s.id {
          let link = "https://news.ycombinator.com/item?id=${s.id}"
          let read = contains(seen, s.id)
          Row {
            gap: 10
            align: top
            Text { text: "${i + 1}"; color: muted; width: 24; align: end }
            Column {
              gap: 3
              weight: 1
              // The story opens its link, or its comments when it has none.
              onTap: { seen = read ? seen : (seen + [s.id]).drop(max(0, len(seen) - 499)); story = s; open = s.url == "" ? s.id : 0; expanded = []; url(s.url == "" ? null : s.url) }
              Text { text: s.title; bold: !read; color: read ? muted : foreground; maxLines: 3 }
              Row {
                gap: 6
                Text { text: s.site == "" ? "news.ycombinator.com" : s.site; style: small; color: muted; maxLines: 1; weight: 1 }
              }
              Text { text: "${s.points} points · ${s.author}"; style: small; color: orange; maxLines: 1 }
            }
            // The comments, in the app.
            Column {
              width: 44
              align: center
              gap: 0
              padding: [0, 2]
              radius: 6 * corners
              background: alpha(foreground, 0.06)
              onTap: { seen = read ? seen : (seen + [s.id]).drop(max(0, len(seen) - 499)); story = s; open = s.id; expanded = []; haptic() }
              Text { text: s.comments > 999 ? "${floor(s.comments / 1000)}k" : "${s.comments}"; bold: true; align: center; maxLines: 1 }
              Ago { t: s.time }
            }
          }
        }
        if offline && len(stories) > 0 {
          Text { text: "offline · showing the last list"; style: label; color: muted }
        }
      }
    } else {
      Column {
        scroll: true
        weight: 1
        gap: 12
        padding: [12, 4, 12, 12]
        // The story: its title opens the link.
        Column {
          gap: 4
          Text { text: story.title; style: title; onTap: url(story.url == "" ? "https://news.ycombinator.com/item?id=${open}" : story.url) }
          Text { text: "${story.points} points · ${story.author}${story.site == "" ? "" : " · " + story.site}"; style: small; color: orange; maxLines: 1 }
          if story.url != "" {
            Text { text: "open the article ↗"; color: accent; onTap: url(story.url) }
          }
          if story.text != "" {
            Html { t: story.text }
          }
        }
        Box { height: 1; fill: width; background: alpha(muted, 0.25) }
        if tree == null {
          Text { text: thread != null && !thread.ok ? "the comments didn't load" : story.comments == 0 ? "no comments yet" : "loading the comments…"; color: muted }
          if thread != null && !thread.ok { Button { text: "try again"; onTap: refresh() } }
        } else {
          if len(tops) == 0 { Text { text: "no comments yet"; color: muted } }
          for c in tops.take(150) key c.id {
            let all = flatten((c.children ?? []).map(a => [{c: a, d: 1}] + flatten((a.children ?? []).map(b => [{c: b, d: 2}] + flatten((b.children ?? []).map(x => [{c: x, d: 3}] + flatten((x.children ?? []).map(y => [{c: y, d: 4}] + flatten((y.children ?? []).map(z => [{c: z, d: 5}] + (z.children ?? []).map(w => {c: w, d: 6})))))))))))
            let unfolded = contains(expanded, c.id)
            Column {
              gap: 8
              // A tap folds a thread's replies in or out.
              Column {
                onTap: { expanded = unfolded ? expanded.filter(e => e != c.id) : expanded + [c.id] }
                Comment { c: c }
              }
              if len(all) > 0 {
                Text {
                  text: unfolded ? "hide replies" : len(all) == 1 ? "1 reply" : "${len(all)} replies"
                  style: small
                  color: accent
                  padding: [0, 2]
                  onTap: { expanded = unfolded ? expanded.filter(e => e != c.id) : expanded + [c.id] }
                }
              }
              if unfolded {
                for r in all key r.c.id { Comment { c: r.c; depth: r.d } }
              }
            }
          }
          if len(tops) > 150 || tree.children == null {
            Text { text: "more on news.ycombinator.com ↗"; color: accent; onTap: url("https://news.ycombinator.com/item?id=${open}") }
          }
        }
      }
    }

    if open == 0 {
      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "top"; icon: topIcon }
        Tab { name: "new"; icon: newIcon }
        Tab { name: "ask"; icon: askIcon }
        Tab { name: "show"; icon: showIcon }
      }
    }
  }
}
