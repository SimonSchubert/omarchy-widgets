app "mtg cards" {
  meta { owl: 11; description: "Magic: The Gathering cards from Scryfall: search with Scryfall's syntax, card pages with prices, legality, printings and rulings, a random card, and deck lists"; version: "1.1"; license: "MIT"; category: "games" }
  // A card's page and an open deck are levels of their own; Back returns to the tab.
  title: openId != "" ? cd.name ?? "card" : deck != null ? deck.name : view == "search" ? "mtg cards" : view == "random" ? "random card" : view
  back: openId != "" || deck != null || (view == "search" && len(query) > 0)
  onBack: {
    if openId != "" {
      stack = take(stack, len(stack) - 1)
      faceIdx = 0
      adding = false
      showRulings = false
      allPrints = false
    } else if deck != null {
      deckOpen = 0
      dAdd = false
      dImp = false
      confirmDel = false
    } else {
      typed = ""
      query = ""
      page = 1
    }
  }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <rect x="58" y="54" width="104" height="146" rx="12" fill="#7AA2F7" transform="rotate(-14 110 127)"/>
    <rect x="96" y="58" width="104" height="146" rx="12" fill="#E0AF68" transform="rotate(10 148 131)"/>
    <rect x="106" y="70" width="84" height="64" rx="6" fill="#1A1B26" fill-opacity="0.35" transform="rotate(10 148 131)"/>
    <path d="M148 84l9 18 18 9-18 9-9 18-9-18-18-9 18-9z" fill="#F7F3E3" transform="rotate(10 148 131)"/>
    <rect x="106" y="144" width="84" height="8" rx="4" fill="#1A1B26" fill-opacity="0.35" transform="rotate(10 148 131)"/>
    <rect x="106" y="160" width="60" height="8" rx="4" fill="#1A1B26" fill-opacity="0.35" transform="rotate(10 148 131)"/>
  </svg>"""

  // The bottom bar's icons, Material's search, casino, style and settings (Apache 2.0).
  asset searchIcon = base64""
  asset randomIcon = base64""
  asset decksIcon = base64""
  asset settingsIcon = base64""

  // Every address is Scryfall's public API (scryfall.com/docs/api), its card images and its mana
  // symbols. A source whose URL is null waits, so only what's on screen is fetched. A page of search
  // results comes as CSV, a twentieth of its JSON, which is over the 1 MB a response may be.
  let api = "https://api.scryfall.com"
  let hj = {Accept: "application/json;q=0.9,*/*;q=0.8"}
  // /cards/collection turns a POST away without its Content-Type.
  let hp = {Accept: "application/json;q=0.9,*/*;q=0.8", "Content-Type": "application/json"}
  source now = clock every 1m

  state cur = "usd" persist
  state look = "list" persist
  state ord = "name" persist
  state dir = "auto" persist
  state recent = [] persist
  state rq = "" persist
  // Decks: {id, name, priced, cards: [{id, name, qty, side, cmc, type, cost, set, usd, eur, tix}]}.
  state decks = [] persist

  state view = "search"
  state typed = ""
  state query = ""
  state page = 1
  state prints = false
  state stack = []
  state faceIdx = 0
  state adding = false
  state newDeck = ""
  state showRulings = false
  state allPrints = false
  state nonce = random(1000000)
  state rTyped = ""
  state deckOpen = 0
  state dAdd = false
  state dq = ""
  state dTyped = ""
  state dImp = false
  state impText = ""
  state impItems = []
  state impAt = -1
  state impRes = null
  state impMsg = ""
  state impGot = 0
  state confirmDel = false
  state renaming = false
  state refRes = null
  state refAt = -1
  state refDeck = 0
  state addReq = null
  state addSeq = 0
  state toast = ""

  let openId = last(stack) ?? ""
  let deck = deckOpen == 0 ? null : decks.find(d => d.id == deckOpen)
  let psym = cur == "eur" ? "€" : cur == "tix" ? "" : "$"

  // ------------------------------------------------------------------ search results, as CSV
  let searchQ = openId != "" ? "" : deck != null ? (dAdd ? dq : "") : view == "search" ? query : ""
  source found = http(len(searchQ) > 0 ? "${api}/cards/search?q=${enc(searchQ)}&order=${enc(deck != null ? "edhrec" : ord)}&dir=${enc(deck != null ? "auto" : dir)}&unique=${deck != null || !prints ? "cards" : "prints"}&page=${int(deck != null ? 1 : page)}&format=csv" : null, hj) every 1h timeout 20s status
  let csvLines = found != null && found.ok ? lines(found.out) : []
  let hdr = split(first(csvLines) ?? "", ",")
  let csvRe = '^' + join(range(len(hdr)).map(i => '("(?:[^"]|"")*"|[^,]*)'), ",") + '$'
  let ix = {id: indexOf(hdr, "scryfall_id"), set: indexOf(hdr, "set"), cn: indexOf(hdr, "collector_number"), rarity: indexOf(hdr, "rarity"), name: indexOf(hdr, "name"), cost: indexOf(hdr, "mana_cost"), cmc: indexOf(hdr, "cmc"), type: indexOf(hdr, "type_line"), usd: indexOf(hdr, "usd_price"), eur: indexOf(hdr, "eur_price"), tix: indexOf(hdr, "tix_price"), img: indexOf(hdr, "image_uri")}
  let fields = csvLines.drop(1).map(l => match(trim(l), csvRe)).filter(m => m != null).map(m => m.map(f => startsWith(f ?? "", '"') ? replace(sub(f, 1, len(f) - 1), '""', '"') : f ?? ""))
  let rows = fields.map(f => {id: f[ix.id], set: lower(f[ix.set]), cn: f[ix.cn], rarity: f[ix.rarity], name: f[ix.name], cost: f[ix.cost], cmc: num(f[ix.cmc], 0), type: f[ix.type], usd: f[ix.usd] == "" ? null : f[ix.usd], eur: f[ix.eur] == "" ? null : f[ix.eur], tix: f[ix.tix] == "" ? null : f[ix.tix], img: startsWith(f[ix.img], "https://cards.scryfall.io/large/") ? sub(f[ix.img], 32, len(f[ix.img])) : ""})
  let searchErr = found == null || found.ok ? "" : found.code == 404 ? "no cards match" : parseJson(found.out).details ?? (found.code == 429 ? "Scryfall is busy; try again in a minute" : "couldn't reach Scryfall")
  let more = len(rows) >= 175

  // ------------------------------------------------------------------ a card's page
  source card = http(openId != "" ? "${api}/cards/${enc(openId)}" : null, hj) every 6h json timeout 20s status
  source rnd = http(openId == "" && deck == null && view == "random" ? "${api}/cards/random?q=${enc(rq)}&n=${int(nonce)}" : null, hj) every 24h json timeout 20s status
  let cd = openId != "" ? (card != null && card.ok && card.out.id == openId ? card.out : null) : view == "random" && deck == null && rnd != null && rnd.ok ? rnd.out : null
  let cardErr = openId != "" ? (card != null && !card.ok ? parseJson(card.out).details ?? "couldn't load the card" : "") : rnd != null && !rnd.ok ? (rnd.code == 404 ? "no card matches that filter" : parseJson(rnd.out).details ?? "couldn't reach Scryfall") : ""
  let faces = cd.card_faces ?? []
  let faceImgs = cd.image_uris == null && len(faces) > 1
  let imgUrl = faceImgs ? faces[faceIdx % len(faces)].image_uris.normal : cd.image_uris.normal
  let imgPath = startsWith(imgUrl ?? "", "https://cards.scryfall.io/") ? sub(imgUrl, 26, len(imgUrl)) : ""
  let textFaces = len(faces) > 0 ? faces : (cd == null ? [] : [cd])
  let oracleId = cd.oracle_id ?? faces[0].oracle_id
  let cw = (screenWidth ?? 360) - 32
  let imgW = min(cw, 340)
  source printsSrc = http(oracleId != null ? "${api}/cards/search?q=${enc("oracleid:" + oracleId)}&order=released&dir=desc&unique=prints&include_extras=true&format=csv" : null, hj) every 6h timeout 20s status
  let pLines = printsSrc != null && printsSrc.ok ? lines(printsSrc.out) : []
  let pHdr = split(first(pLines) ?? "", ",")
  let pRe = '^' + join(range(len(pHdr)).map(i => '("(?:[^"]|"")*"|[^,]*)'), ",") + '$'
  let pIx = {id: indexOf(pHdr, "scryfall_id"), set: indexOf(pHdr, "set"), cn: indexOf(pHdr, "collector_number"), rarity: indexOf(pHdr, "rarity"), usd: indexOf(pHdr, "usd_price"), eur: indexOf(pHdr, "eur_price"), tix: indexOf(pHdr, "tix_price")}
  let printRows = pLines.drop(1).map(l => match(trim(l), pRe)).filter(m => m != null).map(f => {id: f[pIx.id], set: f[pIx.set], cn: f[pIx.cn], rarity: f[pIx.rarity], usd: f[pIx.usd] == "" ? null : f[pIx.usd], eur: f[pIx.eur] == "" ? null : f[pIx.eur], tix: f[pIx.tix] == "" ? null : f[pIx.tix]})
  source rulings = http(showRulings && cd != null ? "${api}/cards/${enc(cd.id)}/rulings" : null, hj) every 24h json timeout 20s status
  let formats = ["standard", "pioneer", "modern", "legacy", "vintage", "commander", "pauper", "historic", "timeless", "brawl", "oathbreaker", "penny"]
  let priceList = [
    {l: "USD", v: cd.prices.usd, s: "$", href: cd.purchase_uris.tcgplayer},
    {l: "USD foil", v: cd.prices.usd_foil, s: "$", href: cd.purchase_uris.tcgplayer},
    {l: "USD etched", v: cd.prices.usd_etched, s: "$", href: cd.purchase_uris.tcgplayer},
    {l: "EUR", v: cd.prices.eur, s: "€", href: cd.purchase_uris.cardmarket},
    {l: "EUR foil", v: cd.prices.eur_foil, s: "€", href: cd.purchase_uris.cardmarket},
    {l: "MTGO", v: cd.prices.tix, s: "", href: cd.purchase_uris.cardhoarder}
  ].filter(p => p.v != null)

  // ------------------------------------------------------------------ decks
  let groups = ["Creature", "Planeswalker", "Battle", "Land", "Instant", "Sorcery", "Artifact", "Enchantment"]
  let dc = deck == null ? [] : deck.cards.map(c => merge(c, {g: first(groups.filter(g => contains(first(split(c.type ?? "", " // ")) ?? "", g))) ?? "Other"}))
  let mainC = dc.filter(c => !c.side)
  let sideC = dc.filter(c => c.side)
  let nMain = sum(mainC.map(c => c.qty))
  let nSide = sum(sideC.map(c => c.qty))
  let vMain = sum(mainC.map(c => c.qty * num(get(c, cur, null), 0)))
  let vSide = sum(sideC.map(c => c.qty * num(get(c, cur, null), 0)))
  let curve = range(8).map(k => sum(mainC.filter(c => c.g != "Land" && (k == 7 ? c.cmc >= 7 : floor(c.cmc) == k)).map(c => c.qty)))
  let curveMax = max(curve + [1])
  // The list as it shows: the main deck by type, then the sideboard, each by mana value.
  let sections = (groups + ["Other"]).map(g => {t: lower(g), cards: mainC.filter(c => c.g == g).sortBy(c => c.cmc)}).filter(x => len(x.cards) > 0) + (len(sideC) > 0 ? [{t: "sideboard", cards: sideC.sortBy(c => c.cmc)}] : [])
  let pips = ["W", "U", "B", "R", "G", "C"].map(s => {s: s, n: sum(mainC.map(c => c.qty * len(matchAll(c.cost ?? "", "[{][^}]*" + s + "[^}]*[}]"))))}).filter(p => p.n > 0)
  let pipTotal = max(1, sum(pips.map(p => p.n)))
  let deckIds = unique(dc.map(c => c.id))
  let exportText = join(mainC.map(c => "${c.qty} ${c.name}"), "\n") + (len(sideC) > 0 ? "\n\nSideboard\n" + join(sideC.map(c => "${c.qty} ${c.name}"), "\n") : "")

  // A pasted deck list, on lines or run together on one: "4 Lightning Bolt", "1x Sol Ring (C21) 263", with
  // a "Sideboard" heading before the sideboard.
  let impFlat = replace(replace(impText, "\r", ""), "\n", " ")
  let impSplit = match(impFlat, '(?i)^(.*?)(?:^|[ \t])sideboard:?(.*)$')
  let entryRe = '([0-9]+)x?[ \t]+(.+?)(?:[ \t]+[(]([A-Za-z0-9]+)[)](?:[ \t]+([A-Za-z0-9-]+))?)?(?:[ \t]+[*][A-Z][*])?(?=[ \t]+[0-9]+x?[ \t]+[A-Za-z"]|[ \t]+(?:Deck|Commander|Companion|Maybeboard)(?:[ \t]|$)|[ \t]*$)'
  // An optional group that didn't match is "", so a set counts only with its collector number.
  let impParsed = matchAll(impSplit == null ? impFlat : impSplit[0], entryRe).map(m => {q: num(m[0], 1), name: trim(m[1]), set: len(m[2] ?? "") > 0 && len(m[3] ?? "") > 0 ? m[2] : null, cn: len(m[2] ?? "") > 0 && len(m[3] ?? "") > 0 ? m[3] : null, side: false}) + (impSplit == null ? [] : matchAll(impSplit[1], entryRe).map(m => {q: num(m[0], 1), name: trim(m[1]), set: len(m[2] ?? "") > 0 && len(m[3] ?? "") > 0 ? m[2] : null, cn: len(m[2] ?? "") > 0 && len(m[3] ?? "") > 0 ? m[3] : null, side: true}))

  // Cards go into a deck here, from a card's page, a search in the deck or an import.
  on addSeq {
    let target = decks.find(x => x.id == addReq.did)
    if target != null {
      let merged = reduce(addReq.items, (acc, e) => any(acc, x => x.id == e.id && x.side == e.side) ? acc.map(x => x.id == e.id && x.side == e.side ? merge(x, {qty: x.qty + e.qty}) : x) : acc + [e], target.cards)
      decks = decks.map(x => x.id == addReq.did ? merge(x, {cards: merged}) : x)
    }
  }

  // Prices go stale: an open deck asks Scryfall for its cards again after six hours, 75 at a time.
  when deck != null && refAt < 0 && len(deckIds) > 0 && now - num(deck.priced, 0) > 21600 {
    refDeck = deckOpen
    refAt = 0
    refRes = null
    refRes = post("${api}/cards/collection", {identifiers: deckIds.take(75).map(i => {id: i})}, hp)
  }
  when refAt >= 0 && refRes != null {
    let got = refRes.ok ? refRes.out.data ?? [] : []
    decks = decks.map(x => x.id == refDeck ? merge(x, {priced: now, cards: x.cards.map(c => any(got, g => g.id == c.id) ? merge(c, {usd: got.find(g => g.id == c.id).prices.usd, eur: got.find(g => g.id == c.id).prices.eur, tix: got.find(g => g.id == c.id).prices.tix}) : c)}) : x)
    let ids = unique((decks.find(x => x.id == refDeck) ?? {cards: []}).cards.map(c => c.id))
    if refRes.ok && refAt + 75 < len(ids) {
      refAt = refAt + 75
      refRes = null
      refRes = post("${api}/cards/collection", {identifiers: ids.drop(refAt).take(75).map(i => {id: i})}, hp)
    } else {
      refAt = -1
    }
  }

  // An import asks for 75 cards at a time and adds what it finds.
  when impAt >= 0 && impRes != null {
    let chunk = impItems.drop(impAt).take(75)
    let got = impRes.ok ? impRes.out.data ?? [] : []
    let hits = chunk.map(it => {it: it, c: got.find(c => (it.set != null && it.cn != null && lower(c.set) == lower(it.set) && c.collector_number == it.cn) || lower(c.name) == lower(it.name) || lower(c.card_faces[0].name ?? "") == lower(it.name))})
    let found2 = hits.filter(h => h.c != null)
    addReq = {did: deckOpen, items: found2.map(h => {id: h.c.id, name: h.c.name, qty: h.it.q, side: h.it.side, cmc: h.c.cmc ?? 0, type: h.c.type_line ?? h.c.card_faces[0].type_line ?? "", cost: h.c.mana_cost ?? h.c.card_faces[0].mana_cost ?? "", set: h.c.set, usd: h.c.prices.usd, eur: h.c.prices.eur, tix: h.c.prices.tix})}
    addSeq = addSeq + 1
    impGot = impGot + sum(found2.map(h => h.it.q))
    let missing = hits.filter(h => h.c == null).map(h => h.it.name)
    impMsg = !impRes.ok ? impRes.out.details ?? "Scryfall didn't answer: ${impRes.code}" : (impMsg == "importing…" ? "" : impMsg) + (len(missing) > 0 ? "not found: ${join(missing, ", ")}. " : "")
    if impRes.ok && impAt + 75 < len(impItems) {
      impAt = impAt + 75
      impRes = null
      impRes = post("${api}/cards/collection", {identifiers: impItems.drop(impAt).take(75).map(it => it.set != null && it.cn != null ? {set: lower(it.set), collector_number: it.cn} : {name: it.name})}, hp)
    } else {
      impAt = -1
      impMsg = impRes.ok ? "imported ${impGot} cards. " + impMsg : impMsg
      impText = impRes.ok ? "" : impText
    }
  }

  // A price in the chosen currency, or – when Scryfall has none.
  component Price(v, sz = 14, tint = null, heavy = false) {
    let x = v == null || v == "" ? null : num(v, null)
    Text { text: x == null ? "–" : cur == "tix" ? "${fixed(x, 2)} tix" : psym + fmtNum(x, 2); fontSize: sz; bold: heavy; maxLines: 1; color: tint ?? (x == null ? muted : foreground) }
  }

  // A mana cost as Scryfall's symbols; a card with two faces shows the front's.
  component Mana(cost, sz = 16) {
    let syms = matchAll(first(split(cost ?? "", " // ")) ?? "", '[{]([^}]+)[}]').map(m => replace(m[0], "/", ""))
    Row {
      gap: 1
      align: center
      for s in syms {
        Image { src: "https://svgs.scryfall.io/card-symbols/${enc(s)}.svg"; size: sz }
      }
    }
  }

  // As wide as its label, unless `wide` lets the node around it decide.
  component Chip(label, on = false, tint = null, wide = false) {
    Text { text: label; width: wide ? null : len(label) * 8 + 28; fill: wide ? "width" : false; style: small; align: center; maxLines: 1; padding: [12, 6]; color: on ? foreground : tint ?? muted; background: on ? alpha(foreground, 0.12) : null; border: 1; borderColor: on ? alpha(foreground, 0.7) : alpha(tint ?? muted, 0.4); radius: 3 * corners }
  }

  component Head(t) {
    Text { text: t; style: label; color: muted; padding: [0, 10, 0, 2] }
  }

  // A search result: its art, name and type, its cost and its price; a tap opens its page.
  component CardRow(c, thumb = true) {
    Row {
      gap: 10
      align: center
      padding: [0, 5]
      onTap: { stack = stack + [c.id]; faceIdx = 0; adding = false; showRulings = false; allPrints = false }
      if thumb && c.img != "" {
        Box {
          width: 40
          height: 56
          radius: 3
          clip: true
          background: alpha(foreground, 0.06)
          Image { src: "https://cards.scryfall.io/small/${c.img}"; width: 40; height: 56; fit: cover }
        }
      }
      Column {
        gap: 1
        weight: 1
        Text { text: c.name; bold: true; maxLines: 1 }
        Text { text: c.type; style: small; color: muted; maxLines: 1 }
        Text { text: "${upper(c.set)} · ${c.cn}"; style: small; color: c.rarity == "M" ? orange : c.rarity == "R" ? yellow : c.rarity == "U" ? blue : muted; maxLines: 1 }
      }
      Column {
        gap: 4
        align: end
        Mana { cost: c.cost; sz: 15 }
        Price { v: get(c, cur, null); sz: 13 }
      }
    }
  }

  // A tab of the bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, label, pic) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { view = name; haptic() }
      Box {
        align: center
        width: 56
        height: 32
        Image { src: pic; size: 24; tint: view == name ? foreground : muted }
      }
      Text { text: label; style: small; align: center; maxLines: 1; bold: view == name; color: view == name ? foreground : muted }
    }
  }

  // The whole card: its picture (flipped for two faces), text, prices, legality, printings and rulings.
  component CardPage() {
    Column {
      gap: 10
      if cd == null {
        if cardErr != "" {
          Text { text: cardErr; color: muted; padding: [0, 24]; align: center }
          Button { text: "try again"; onTap: { nonce = random(1000000); refresh() } }
        } else {
          Text { text: "loading…"; color: muted; padding: [0, 24]; align: center }
        }
      } else {
        Column {
          align: center
          fill: width
          gap: 6
          Box {
            width: imgW
            height: imgW * 680 / 488
            radius: imgW * 0.045
            clip: true
            background: alpha(foreground, 0.06)
            onTap: faceIdx = faceImgs ? faceIdx + 1 : faceIdx
            if imgPath != "" {
              Image { src: "https://cards.scryfall.io/${imgPath}"; width: imgW; height: imgW * 680 / 488; fit: contain }
            }
          }
          if faceImgs {
            Box {
              onTap: faceIdx = faceIdx + 1
              Chip { label: "↻ flip to ${faces[(faceIdx + 1) % len(faces)].name}" }
            }
          }
        }

        for f in textFaces {
          Column {
            gap: 4
            padding: [14, 12]
            background: alpha(foreground, 0.05)
            radius: 8 * corners
            Row {
              gap: 8
              align: center
              Text { text: f.name; bold: true; fontSize: 17; weight: 1 }
              Mana { cost: f.mana_cost; sz: 18 }
            }
            Text { text: f.type_line ?? ""; style: small; color: muted }
            if len(f.oracle_text ?? "") > 0 {
              Text { text: f.oracle_text; padding: [0, 4, 0, 0] }
            }
            if len(f.flavor_text ?? "") > 0 {
              Text { text: f.flavor_text; italic: true; style: small; color: muted }
            }
            if f.power != null || f.loyalty != null || f.defense != null {
              Text { text: f.power != null ? "${f.power}/${f.toughness}" : f.loyalty != null ? "loyalty ${f.loyalty}" : "defense ${f.defense}"; bold: true; align: end }
            }
          }
        }

        Text { text: "${cd.set_name} (${upper(cd.set)}) · #${cd.collector_number} · ${cd.rarity} · ${sub(cd.released_at ?? "", 0, 4)}"; style: small; color: muted }
        if cd.artist != null {
          Text { text: "illustrated by ${cd.artist}"; style: small; color: muted }
        }

        Head { t: "prices" }
        if len(priceList) == 0 {
          Text { text: "Scryfall has no prices for this printing"; style: small; color: muted }
        } else {
          Grid {
            columns: 3
            gap: 6
            for p in priceList {
              Column {
                gap: 2
                padding: [10, 8]
                background: alpha(foreground, 0.05)
                radius: 6 * corners
                onTap: url(p.href ?? cd.scryfall_uri)
                Text { text: p.l; style: small; color: muted; maxLines: 1 }
                Text { text: p.s == "" ? "${fixed(num(p.v, 0), 2)} tix" : p.s + fmtNum(num(p.v, 0), 2); bold: true; maxLines: 1 }
              }
            }
          }
        }

        Head { t: "deck" }
        if !adding {
          Button { text: "add to a deck"; onTap: { adding = true; newDeck = "" } }
        } else {
          Column {
            gap: 6
            padding: [12, 10]
            background: alpha(foreground, 0.05)
            radius: 8 * corners
            for d in decks key d.id {
              Row {
                gap: 6
                align: center
                Column {
                  gap: 0
                  weight: 1
                  Text { text: d.name; bold: true; maxLines: 1 }
                  Text { text: "${sum(d.cards.filter(x => x.id == cd.id).map(x => x.qty))} in it"; style: small; color: muted }
                }
                Box {
                  onTap: { addReq = {did: d.id, items: [{id: cd.id, name: cd.name, qty: 1, side: false, cmc: cd.cmc ?? 0, type: cd.type_line ?? faces[0].type_line ?? "", cost: cd.mana_cost ?? faces[0].mana_cost ?? "", set: cd.set, usd: cd.prices.usd, eur: cd.prices.eur, tix: cd.prices.tix}]}; addSeq = addSeq + 1; haptic(); toast = "added to ${d.name}" }
                  Chip { label: "+ main"; tint: accent }
                }
                Box {
                  onTap: { addReq = {did: d.id, items: [{id: cd.id, name: cd.name, qty: 1, side: true, cmc: cd.cmc ?? 0, type: cd.type_line ?? faces[0].type_line ?? "", cost: cd.mana_cost ?? faces[0].mana_cost ?? "", set: cd.set, usd: cd.prices.usd, eur: cd.prices.eur, tix: cd.prices.tix}]}; addSeq = addSeq + 1; haptic(); toast = "added to ${d.name}'s sideboard" }
                  Chip { label: "+ side" }
                }
              }
            }
            Row {
              gap: 8
              align: center
              Input { text: newDeck; placeholder: len(decks) == 0 ? "name your first deck" : "or a new deck"; weight: 1; onChange: newDeck = value; onSubmit: { if trim(value) != "" { decks = decks + [{id: max(decks.map(d => d.id) + [0]) + 1, name: trim(value), priced: now, cards: []}]; newDeck = "" } } }
              Box {
                onTap: { if trim(newDeck) != "" { decks = decks + [{id: max(decks.map(d => d.id) + [0]) + 1, name: trim(newDeck), priced: now, cards: []}]; newDeck = "" } }
                Chip { label: "create" }
              }
            }
            if toast != "" {
              Text { text: toast; style: small; color: green }
            }
            Text { text: "done"; style: small; color: accent; align: end; onTap: { adding = false; toast = "" } }
          }
        }

        Head { t: "legality" }
        Grid {
          columns: 2
          gap: 6
          for k in formats {
            let st = get(cd.legalities ?? {}, k, "not_legal")
            Row {
              gap: 8
              align: center
              Text { text: st == "legal" ? "legal" : st == "banned" ? "banned" : st == "restricted" ? "restricted" : "not legal"; style: small; align: center; maxLines: 1; width: 78; padding: [0, 3]; radius: 3 * corners; color: st == "legal" ? green : st == "banned" ? red : st == "restricted" ? yellow : muted; background: alpha(st == "legal" ? green : st == "banned" ? red : st == "restricted" ? yellow : muted, 0.14) }
              Text { text: k; style: small; maxLines: 1 }
            }
          }
        }

        if len(printRows) > 1 {
          Head { t: "${len(printRows)}${len(printRows) >= 175 ? "+" : ""} printings" }
          for p in printRows.take(allPrints ? 175 : 8) key p.id {
            Row {
              gap: 8
              align: center
              padding: [0, 4]
              onTap: { stack = p.id == cd.id ? stack : stack + [p.id]; faceIdx = 0; adding = false; showRulings = false }
              Text { text: upper(p.set); bold: p.id == cd.id; color: p.id == cd.id ? accent : foreground; width: 56; maxLines: 1 }
              Text { text: "#${p.cn}"; style: small; color: muted; weight: 1; maxLines: 1 }
              Text { text: p.rarity; style: small; color: p.rarity == "M" ? orange : p.rarity == "R" ? yellow : p.rarity == "U" ? blue : muted; width: 18 }
              Price { v: get(p, cur, null); sz: 13 }
            }
          }
          if len(printRows) > 8 && !allPrints {
            Text { text: "show all"; style: small; color: accent; onTap: allPrints = true }
          }
        }

        Head { t: "rulings" }
        if !showRulings {
          Text { text: "show rulings"; style: small; color: accent; onTap: showRulings = true }
        } else if rulings == null {
          Text { text: "loading…"; style: small; color: muted }
        } else if !rulings.ok || len(rulings.out.data ?? []) == 0 {
          Text { text: rulings.ok ? "no rulings for this card" : "couldn't load the rulings"; style: small; color: muted }
        } else {
          for r in rulings.out.data {
            Column {
              gap: 2
              Text { text: "${r.published_at} · ${r.source}"; style: small; color: muted }
              Text { text: r.comment; style: small }
            }
          }
        }

        Flow {
          gap: 6
          Box {
            onTap: url(cd.scryfall_uri)
            Chip { label: "scryfall"; tint: accent }
          }
          if cd.related_uris.edhrec != null {
            Box {
              onTap: url(cd.related_uris.edhrec)
              Chip { label: "edhrec"; tint: accent }
            }
          }
          if cd.related_uris.gatherer != null {
            Box {
              onTap: url(cd.related_uris.gatherer)
              Chip { label: "gatherer"; tint: accent }
            }
          }
          Box {
            onTap: share("${cd.name}\n${cd.scryfall_uri}")
            Chip { label: "share" }
          }
        }
      }
    }
  }

  Column {
    gap: 0
    fill: true

    if openId != "" {
      // ---------------------------------------------------------------- a card
      Column {
        weight: 1
        scroll: true
        padding: [16, 4, 16, 16]
        CardPage { }
      }

    } else if deck != null {
      // ---------------------------------------------------------------- a deck
      Column {
        weight: 1
        scroll: true
        gap: 10
        padding: [16, 4, 16, 16]

        Column {
          gap: 4
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 8 * corners
          Row {
            gap: 8
            align: center
            Text { text: "${nMain} cards"; fontSize: 22; bold: true; weight: 1 }
            Price { v: vMain; sz: 22; heavy: true }
          }
          Row {
            gap: 8
            Text { text: nSide > 0 ? "sideboard ${nSide}" : "no sideboard"; style: small; color: muted; weight: 1 }
            if nSide > 0 {
              Price { v: vSide; sz: 12; tint: muted }
            }
          }
          if len(dc) > 0 {
            Text { text: refAt >= 0 ? "updating prices…" : fmtAgo(deck.priced ?? now, now) == "now" ? "prices just updated" : "prices from ${fmtAgo(deck.priced ?? now, now)} ago"; style: small; color: muted }
          }
        }

        if nMain > 0 {
          Head { t: "mana curve" }
          Row {
            gap: 6
            align: bottom
            height: 96
            for n, k in curve {
              Column {
                weight: 1
                gap: 2
                align: center
                Text { text: n > 0 ? "${n}" : ""; style: small; color: muted; align: center }
                Box { height: max(2, n / curveMax * 60); fill: width; radius: 3 * corners; background: n > 0 ? accent : alpha(muted, 0.25) }
                Text { text: k == 7 ? "7+" : "${k}"; style: small; color: muted; align: center }
              }
            }
          }
          if len(pips) > 0 {
            Row {
              gap: 2
              height: 8
              fill: width
              for p in pips {
                Box { weight: max(0.001, p.n / pipTotal); height: 8; radius: 2; background: p.s == "W" ? "#F8F6D8" : p.s == "U" ? "#4A90D9" : p.s == "B" ? "#6B5E5A" : p.s == "R" ? "#D9533B" : p.s == "G" ? "#3D9A5B" : "#B8B0A8" }
              }
            }
            Flow {
              gap: 10
              for p in pips {
                Row {
                  gap: 4
                  align: center
                  Image { src: "https://svgs.scryfall.io/card-symbols/${enc(p.s)}.svg"; size: 14 }
                  Text { text: "${round(p.n / pipTotal * 100)}%"; style: small; color: muted }
                }
              }
            }
          }
        }

        Flow {
          gap: 6
          Box {
            onTap: { dAdd = !dAdd; dImp = false; confirmDel = false; renaming = false }
            Chip { label: "add cards"; on: dAdd }
          }
          Box {
            onTap: { dImp = !dImp; dAdd = false; confirmDel = false; renaming = false; impMsg = "" }
            Chip { label: "import"; on: dImp }
          }
          if len(dc) > 0 {
            Box {
              onTap: share(exportText)
              Chip { label: "share list" }
            }
            Box {
              onTap: { copy(exportText); toast = "copied" }
              Chip { label: "copy" }
            }
            Box {
              onTap: { refDeck = deckOpen; refAt = 0; refRes = null; refRes = post("${api}/cards/collection", {identifiers: deckIds.take(75).map(i => {id: i})}, hp) }
              Chip { label: "update prices" }
            }
          }
          Box {
            onTap: { renaming = !renaming; newDeck = deck.name; confirmDel = false }
            Chip { label: "rename"; on: renaming }
          }
          Box {
            onTap: { confirmDel = !confirmDel; renaming = false }
            Chip { label: "delete"; on: confirmDel; tint: red }
          }
        }
        if toast == "copied" {
          Text { text: "copied the list"; style: small; color: green }
        }
        if renaming {
          Input { text: newDeck; placeholder: "deck name"; onChange: newDeck = value; onSubmit: { if trim(value) != "" { decks = decks.map(x => x.id == deckOpen ? merge(x, {name: trim(value)}) : x); renaming = false } } }
        }
        if confirmDel {
          Row {
            gap: 8
            align: center
            Text { text: "delete ${deck.name}?"; weight: 1; color: red }
            Button { text: "delete"; color: red; onTap: { decks = decks.filter(x => x.id != deckOpen); deckOpen = 0; confirmDel = false } }
          }
        }

        if dAdd {
          Column {
            gap: 4
            padding: [12, 8]
            background: alpha(foreground, 0.05)
            radius: 8 * corners
            Row {
              gap: 10
              align: center
              Image { src: searchIcon; size: 20; tint: muted }
              Input { text: dTyped; placeholder: "a card's name, or any Scryfall search"; weight: 1; onChange: dTyped = value; onSubmit: dq = trim(value) }
            }
            if dq != "" {
              if found == null {
                Text { text: "searching…"; style: small; color: muted }
              } else if searchErr != "" {
                Text { text: searchErr; style: small; color: muted }
              } else {
                for r in rows.take(15) key r.id {
                  let have = sum(dc.filter(x => x.id == r.id && !x.side).map(x => x.qty))
                  Row {
                    gap: 6
                    align: center
                    padding: [0, 3]
                    Column {
                      gap: 0
                      weight: 1
                      Text { text: r.name; bold: true; maxLines: 1; onTap: { stack = stack + [r.id]; faceIdx = 0 } }
                      Text { text: r.type; style: small; color: muted; maxLines: 1 }
                    }
                    Mana { cost: r.cost; sz: 14 }
                    Box {
                      onTap: { addReq = {did: deckOpen, items: [{id: r.id, name: r.name, qty: 1, side: false, cmc: r.cmc, type: r.type, cost: r.cost, set: r.set, usd: r.usd, eur: r.eur, tix: r.tix}]}; addSeq = addSeq + 1; haptic() }
                      Chip { label: have > 0 ? "+ ${have}" : "+"; tint: accent }
                    }
                    Box {
                      onTap: { addReq = {did: deckOpen, items: [{id: r.id, name: r.name, qty: 1, side: true, cmc: r.cmc, type: r.type, cost: r.cost, set: r.set, usd: r.usd, eur: r.eur, tix: r.tix}]}; addSeq = addSeq + 1; haptic() }
                      Chip { label: "side" }
                    }
                  }
                }
              }
            }
          }
        }

        if dImp {
          Column {
            gap: 6
            padding: [12, 8]
            background: alpha(foreground, 0.05)
            radius: 8 * corners
            Text { text: "Paste a deck list, one card a line like \"4 Lightning Bolt\" or \"1 Sol Ring (C21) 263\", with \"Sideboard\" before the sideboard."; style: small; color: muted }
            Input { text: impText; placeholder: "4 Lightning Bolt …"; onChange: impText = value }
            Row {
              gap: 8
              align: center
              Text { text: len(impParsed) == 0 ? "" : "${sum(impParsed.map(it => it.q))} cards in ${len(impParsed)} lines"; style: small; color: muted; weight: 1 }
              Button { text: impAt >= 0 ? "importing…" : "import"; onTap: { if len(impParsed) > 0 && impAt < 0 { impItems = impParsed.take(300); impAt = 0; impGot = 0; impMsg = "importing…"; impRes = null; impRes = post("${api}/cards/collection", {identifiers: impParsed.take(75).map(it => it.set != null && it.cn != null ? {set: lower(it.set), collector_number: it.cn} : {name: it.name})}, hp) } } }
            }
            if impMsg != "" {
              Text { text: impMsg; style: small; color: startsWith(impMsg, "imported") ? green : yellow }
            }
          }
        }

        if len(dc) == 0 && !dAdd && !dImp {
          Text { text: "An empty deck: add cards from a card's page, search for them under add cards, or import a list."; color: muted; padding: [0, 8] }
        }

        for sec in sections key sec.t {
          Head { t: "${sec.t} · ${sum(sec.cards.map(c => c.qty))}" }
          for c in sec.cards key "${c.id}-${c.side}" {
            Row {
              gap: 6
              align: center
              Text { text: "−"; fontSize: 18; color: muted; width: 26; align: center; onTap: decks = decks.map(x => x.id == deckOpen ? merge(x, {cards: x.cards.map(y => y.id == c.id && y.side == c.side ? merge(y, {qty: y.qty - 1}) : y).filter(y => y.qty > 0)}) : x) }
              Text { text: "${c.qty}"; bold: true; width: 22; align: center }
              Text { text: "+"; fontSize: 18; color: accent; width: 26; align: center; onTap: decks = decks.map(x => x.id == deckOpen ? merge(x, {cards: x.cards.map(y => y.id == c.id && y.side == c.side ? merge(y, {qty: y.qty + 1}) : y)}) : x) }
              Text { text: c.name; maxLines: 1; weight: 1; onTap: { stack = stack + [c.id]; faceIdx = 0; adding = false } }
              Mana { cost: c.cost; sz: 14 }
              Price { v: get(c, cur, null) == null ? null : num(get(c, cur, null), 0) * c.qty; sz: 12; tint: muted }
            }
          }
        }
      }

    } else {
      if view == "search" {
        // ---------------------------------------------------------------- search
        Column {
          gap: 8
          padding: [16, 4, 16, 6]
          Row {
            gap: 10
            align: center
            Image { src: searchIcon; size: 20; tint: muted }
            Input { text: typed; placeholder: "search cards, e.g. t:dragon c:r"; weight: 1; onChange: typed = value; onSubmit: { query = trim(value); page = 1; recent = trim(value) == "" ? recent : ([trim(value)] + recent.filter(r => r != trim(value))).take(8) } }
            if len(typed) > 0 {
              Text { text: "✕"; color: muted; width: 28; align: center; onTap: { typed = ""; query = ""; page = 1 } }
            }
          }
          if query != "" {
            Row {
              gap: 6
              for s in [{k: "name", l: "name"}, {k: "released", l: "new"}, {k: "cmc", l: "mana"}, {k: cur, l: "price"}, {k: "edhrec", l: "edhrec"}] {
                Box {
                  weight: 1
                  onTap: { dir = ord == s.k ? (dir == "desc" ? "asc" : "desc") : s.l == "price" ? "desc" : "auto"; ord = s.k; page = 1 }
                  Chip { label: ord == s.k ? s.l + (dir == "desc" ? " ↓" : dir == "asc" ? " ↑" : "") : s.l; on: ord == s.k; wide: true }
                }
              }
            }
          }
        }

        if query == "" {
          Column {
            weight: 1
            scroll: true
            gap: 8
            padding: [16, 4, 16, 16]
            if len(recent) > 0 {
              Head { t: "recent" }
              Flow {
                gap: 6
                for r in recent {
                  Box {
                    onTap: { typed = r; query = r; page = 1 }
                    Chip { label: r }
                  }
                }
              }
            }
            Head { t: "try" }
            for ex in [
              {q: "t:legendary t:dragon", l: "legendary dragons"},
              {q: "o:\"draw a card\" mv<=2 c:u", l: "cheap blue card draw"},
              {q: "is:commander id:bg", l: "Golgari commanders"},
              {q: "f:pauper t:creature pow>=4", l: "big creatures in Pauper"},
              {q: "usd>=100", l: "cards worth $100 or more"},
              {q: "year>=2025 r:mythic", l: "this year's mythics"},
              {q: "art:cat", l: "art with cats in it"}
            ] {
              Row {
                gap: 10
                align: center
                padding: [0, 5]
                onTap: { typed = ex.q; query = ex.q; page = 1 }
                Text { text: ex.l; weight: 1; maxLines: 1 }
                Text { text: ex.q; style: small; font: mono; color: accent; maxLines: 1 }
              }
            }
            Text { text: "Searches use Scryfall's syntax: t: type, o: rules text, c: colors, id: color identity, mv: mana value, f: format, r: rarity, s: set, usd: price."; style: small; color: muted; padding: [0, 10, 0, 0] }
            Text { text: "the full syntax guide"; style: small; color: accent; onTap: url("https://scryfall.com/docs/syntax") }
          }
        } else if found == null {
          Text { text: "searching…"; color: muted; padding: [0, 24]; align: center }
        } else if searchErr != "" {
          Column {
            weight: 1
            padding: [16, 24]
            gap: 8
            Text { text: searchErr; color: muted; align: center }
            if found.code != 404 {
              Button { text: "try again"; onTap: refresh() }
            }
          }
        } else if look == "grid" {
          Grid {
            columns: 3
            gap: 8
            lazy: true
            weight: 1
            padding: [16, 4, 16, 8]
            for c in rows key c.id {
              Box {
                height: ((screenWidth ?? 360) - 48) / 3 * 680 / 488
                radius: 5
                clip: true
                background: alpha(foreground, 0.06)
                onTap: { stack = stack + [c.id]; faceIdx = 0; adding = false; showRulings = false; allPrints = false }
                if c.img != "" {
                  Image { src: "https://cards.scryfall.io/small/${c.img}"; fill: true; fit: contain }
                }
              }
            }
          }
          if page > 1 || more {
            Row {
              gap: 8
              align: center
              padding: [16, 4]
              Box {
                width: 90
                opacity: page > 1 ? 1 : 0.35
                onTap: page = max(1, page - 1)
                Chip { label: "‹ prev"; wide: true }
              }
              Text { text: "page ${page}"; style: small; color: muted; weight: 1; align: center }
              Box {
                width: 90
                opacity: more ? 1 : 0.35
                onTap: page = more ? page + 1 : page
                Chip { label: "next ›"; wide: true }
              }
            }
          }
        } else {
          Column {
            lazy: true
            weight: 1
            gap: 2
            padding: [16, 0, 16, 8]
            for c in rows key c.id {
              CardRow { c: c }
            }
            if page > 1 || more {
              Row {
                gap: 8
                align: center
                padding: [0, 8]
                Box {
                  width: 90
                  opacity: page > 1 ? 1 : 0.35
                  onTap: page = max(1, page - 1)
                  Chip { label: "‹ prev"; wide: true }
                }
                Text { text: "page ${page}"; style: small; color: muted; weight: 1; align: center }
                Box {
                  width: 90
                  opacity: more ? 1 : 0.35
                  onTap: page = more ? page + 1 : page
                  Chip { label: "next ›"; wide: true }
                }
              }
            }
          }
        }

      } else if view == "random" {
        // ---------------------------------------------------------------- a random card
        Column {
          weight: 1
          scroll: true
          gap: 10
          padding: [16, 4, 16, 16]
          Flow {
            gap: 6
            for f in [{q: "", l: "any card"}, {q: "is:commander", l: "commander"}, {q: "t:planeswalker", l: "planeswalker"}, {q: "r:mythic", l: "mythic"}, {q: "is:funny", l: "silly"}, {q: "usd>=20", l: "pricey"}] {
              Box {
                onTap: { rq = f.q; rTyped = ""; nonce = random(1000000); faceIdx = 0; adding = false; showRulings = false; allPrints = false }
                Chip { label: f.l; on: rq == f.q }
              }
            }
          }
          Row {
            gap: 8
            align: center
            Input { text: rTyped; placeholder: "or your own filter, e.g. t:goblin"; weight: 1; onChange: rTyped = value; onSubmit: { rq = trim(value); nonce = random(1000000); faceIdx = 0; adding = false } }
            Button { text: "another"; color: accent; onTap: { nonce = random(1000000); faceIdx = 0; adding = false; showRulings = false; allPrints = false; haptic() } }
          }
          CardPage { }
        }

      } else if view == "decks" {
        // ---------------------------------------------------------------- decks
        Column {
          weight: 1
          scroll: true
          gap: 8
          padding: [16, 4, 16, 16]
          if len(decks) == 0 {
            Text { text: "Keep your deck lists here: name one, then add cards from their pages, search for them inside the deck, or paste a list."; color: muted; padding: [0, 8] }
          }
          for d in decks key d.id {
            Row {
              gap: 10
              align: center
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 8 * corners
              onTap: { deckOpen = d.id; dAdd = false; dImp = false; confirmDel = false; renaming = false; dq = ""; dTyped = ""; impMsg = ""; toast = "" }
              Column {
                gap: 2
                weight: 1
                Text { text: d.name; bold: true; maxLines: 1 }
                Text { text: "${sum(d.cards.filter(c => !c.side).map(c => c.qty))} cards${any(d.cards, c => c.side) ? " + ${sum(d.cards.filter(c => c.side).map(c => c.qty))} sideboard" : ""}"; style: small; color: muted }
              }
              Price { v: sum(d.cards.filter(c => !c.side).map(c => c.qty * num(get(c, cur, null), 0))); sz: 15; heavy: true }
            }
          }
          Row {
            gap: 8
            align: center
            padding: [0, 6, 0, 0]
            Input { text: newDeck; placeholder: "new deck name"; weight: 1; onChange: newDeck = value; onSubmit: { if trim(value) != "" { decks = decks + [{id: max(decks.map(d => d.id) + [0]) + 1, name: trim(value), priced: now, cards: []}]; newDeck = "" } } }
            Button { text: "create"; onTap: { if trim(newDeck) != "" { decks = decks + [{id: max(decks.map(d => d.id) + [0]) + 1, name: trim(newDeck), priced: now, cards: []}]; newDeck = "" } } }
          }
        }

      } else {
        // ---------------------------------------------------------------- settings
        Column {
          weight: 1
          scroll: true
          gap: 6
          padding: [16, 4, 16, 16]
          Head { t: "prices in" }
          for c in [{k: "usd", l: "US dollars", s: "$"}, {k: "eur", l: "euros", s: "€"}, {k: "tix", l: "MTGO tickets", s: "tix"}] {
            Row {
              gap: 10
              align: center
              padding: [0, 7]
              onTap: cur = c.k
              Text { text: c.s; width: 36; color: cur == c.k ? accent : muted; bold: cur == c.k }
              Text { text: c.l; weight: 1; color: cur == c.k ? foreground : muted }
              Text { text: cur == c.k ? "●" : ""; color: accent; width: 20 }
            }
          }
          Head { t: "search results" }
          for c in [{k: "list", l: "a list with prices"}, {k: "grid", l: "a grid of cards"}] {
            Row {
              gap: 10
              align: center
              padding: [0, 7]
              onTap: look = c.k
              Text { text: c.l; weight: 1; color: look == c.k ? foreground : muted }
              Text { text: look == c.k ? "●" : ""; color: accent; width: 20 }
            }
          }
          Row {
            gap: 10
            align: center
            padding: [0, 7]
            onTap: { prints = !prints; page = 1 }
            Text { text: "every printing, not one per card"; weight: 1; color: prints ? foreground : muted }
            Text { text: prints ? "●" : "○"; color: accent; width: 20 }
          }
          if len(recent) > 0 {
            Text { text: "clear recent searches"; style: small; color: accent; padding: [0, 8]; onTap: recent = [] }
          }
          Text { text: "Cards, prices and images come from Scryfall, fetched only while the app is open. Prices are updated once a day. Mana symbols and card images are Wizards of the Coast's; this app isn't affiliated with Wizards of the Coast or Scryfall."; style: small; color: muted; padding: [0, 12, 0, 0] }
          Text { text: "scryfall.com"; style: small; color: accent; onTap: url("https://scryfall.com") }
        }
      }

      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "search"; label: "search"; pic: searchIcon }
        Tab { name: "random"; label: "random"; pic: randomIcon }
        Tab { name: "decks"; label: "decks"; pic: decksIcon }
        Tab { name: "settings"; label: "settings"; pic: settingsIcon }
      }
    }
  }
}
