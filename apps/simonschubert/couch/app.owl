app "couch" {
  meta { owl: 8; description: "A movie and TV tracker for Trakt: trending, popular and anticipated titles, cast, seasons and episodes, search; sign in for up next, a calendar, your watchlist, history and ratings"; version: "1.1"; license: "MIT"; category: "media" }
  // A port of Couch for Trakt (github.com/SimonSchubert/omarchy-couch). Not affiliated with Trakt.
  // A title's page, search, history and settings are a level of their own; Back returns to the tab.
  title: open != null ? (open.m.title ?? "") : view == "search" ? "search" : view == "history" ? "history" : view == "settings" ? "settings" : tab == "upnext" ? "up next" : tab
  back: open != null || view != ""
  onBack: { view = len(stack) > 0 ? view : ""; stack = stack.drop(1); season = -1; allEps = false; more = false; unconf = false; confirmOut = false }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <path fill="#73DACA" transform="translate(53.33 186.56) scale(0.16267 -0.16267)" d="M480 611Q480 644 504.5 668.5Q529 693 563 693H709Q744 693 768.5 668.5Q793 644 793 611V521Q756 507 732.5 475.0Q709 443 709 404V318H480ZM209 404V318H438V611Q438 644 413.5 668.5Q389 693 355 693H209Q174 693 149.5 668.5Q125 644 125 611V521Q162 507 185.5 475.0Q209 443 209 404ZM820 484Q789 480 769.5 454.5Q750 429 750 396V277H168V402Q168 437 143.5 461.5Q119 486 84.0 486.0Q49 486 24.5 461.5Q0 437 0 402V193Q0 160 24.5 135.5Q49 111 84 111V27H168V111H750V27H834V111Q869 111 893.5 135.5Q918 160 918 193V402Q918 441 888.5 465.5Q859 490 820 484Z"/>
  </svg>"""

  // Material icons (Apache 2.0): the tabs, the top bar and the buttons.
  asset discoverIcon = base64""
  asset upnextIcon = base64""
  asset calendarIcon = base64""
  asset watchlistIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE3LDNMNywzYy0xLjEsMCAtMS45OSwwLjkgLTEuOTksMkw1LDIxbDcsLTMgNywzTDE5LDVjMCwtMS4xIC0wLjksLTIgLTIsLTJ6TTE3LDE4bC01LC0yLjE4TDcsMThMNyw1aDEwdjEzeiIvPjwvc3ZnPg=="
  asset bookmarkedIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE3LDNIN2MtMS4xLDAgLTEuOTksMC45IC0xLjk5LDJMNSwyMWw3LC0zIDcsM1Y1YzAsLTEuMSAtMC45LC0yIC0yLC0yeiIvPjwvc3ZnPg=="
  asset searchIcon = base64""
  asset historyIcon = base64""
  asset settingsIcon = base64""
  asset checkIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTksMTYuMTdMNC44MywxMmwtMS40MiwxLjQxTDksMTkgMjEsN2wtMS40MSwtMS40MXoiLz48L3N2Zz4="
  asset doneIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTEyLDJDNi40OCwyIDIsNi40OCAyLDEyczQuNDgsMTAgMTAsMTAgMTAsLTQuNDggMTAsLTEwUzE3LjUyLDIgMTIsMnpNMTAsMTdsLTUsLTUgMS40MSwtMS40MUwxMCwxNC4xN2w3LjU5LC03LjU5TDE5LDhsLTksOXoiLz48L3N2Zz4="
  asset heartIcon = base64""
  asset starIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTEyLDE3LjI3TDE4LjE4LDIxbC0xLjY0LC03LjAzTDIyLDkuMjRsLTcuMTksLTAuNjFMMTIsMiA5LjE5LDguNjMgMiw5LjI0bDUuNDYsNC43M0w1LjgyLDIxeiIvPjwvc3ZnPg=="
  asset starOffIcon = base64""
  asset openIcon = base64""
  asset trailerIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTIwLDRINEMyLjksNCAyLDQuOSAyLDZ2MTJjMCwxLjEgMC45LDIgMiwyaDE2YzEuMSwwIDIsLTAuOSAyLC0yVjZDMjIsNC45IDIxLjEsNCAyMCw0ek05LjUsMTYuNXYtOWw3LDQuNUw5LjUsMTYuNXoiLz48L3N2Zz4="
  asset logoutIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE3LDdsLTEuNDEsMS40MUwxOC4xNywxMUg4djJoMTAuMTdsLTIuNTgsMi41OEwxNywxN2w1LC01ek00LDVoOFYzSDRjLTEuMSwwIC0yLDAuOSAtMiwydjE0YzAsMS4xIDAuOSwyIDIsMmg4di0ySDRWNXoiLz48L3N2Zz4="
  asset loginIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTExLDdMOS42LDguNGwyLjYsMi42SDJ2MmgxMC4ybC0yLjYsMi42TDExLDE3bDUsLTVMMTEsN3pNMjAsMTloLTh2Mmg4YzEuMSwwIDIsLTAuOSAyLC0yVjVjMCwtMS4xIC0wLjksLTIgLTIsLTJoLTh2Mmg4VjE5eiIvPjwvc3ZnPg=="
  asset copyIcon = base64""
  asset movieIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE4LDRsMiw0aC0zbC0yLC00aC0ybDIsNGgtM2wtMiwtNEg4bDIsNEg3TDUsNEg0Yy0xLjEsMCAtMS45OSwwLjkgLTEuOTksMkwyLDE4YzAsMS4xIDAuOSwyIDIsMmgxNmMxLjEsMCAyLC0wLjkgMiwtMlY0aC00eiIvPjwvc3ZnPg=="
  asset tvIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTIxLDNMMywzYy0xLjEsMCAtMiwwLjkgLTIsMnYxMmMwLDEuMSAwLjksMiAyLDJoNXYyaDh2LTJoNWMxLjEsMCAxLjk5LC0wLjkgMS45OSwtMkwyMyw1YzAsLTEuMSAtMC45LC0yIC0yLC0yek0yMSwxN0wzLDE3TDMsNWgxOHYxMnoiLz48L3N2Zz4="
  asset circleIcon = base64""
  asset personIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTEyLDEyYzIuMjEsMCA0LC0xLjc5IDQsLTRzLTEuNzksLTQgLTQsLTQgLTQsMS43OSAtNCw0IDEuNzksNCA0LDR6TTEyLDE0Yy0yLjY3LDAgLTgsMS4zNCAtOCw0djJoMTZ2LTJjMCwtMi42NiAtNS4zMywtNCAtOCwtNHoiLz48L3N2Zz4="
  asset eyeIcon = base64""
  asset eyeOffIcon = base64""

  // The Trakt app Couch signs in as. Its source is public, so the secret identifies the app and
  // protects nobody's account; signing in still needs the person's approval on trakt.tv.
  // Settings can name another app instead.
  let builtinId = "FfaAy3QK7UmKwSgD3KP-Q4LbdHuki64OZBNNb44_ibc"
  let builtinSecret = "Nezbd-pNTJDVPaoOG08jQG5LpJyrZ_YQzUjogOlplhY"
  state myId = "" persist
  state mySecret = "" persist
  let cid = myId != "" ? myId : builtinId
  let csec = myId != "" ? mySecret : builtinSecret

  // {access, refresh, expires, life}: the person's tokens, times in Unix seconds.
  state auth = null persist
  let signedIn = auth != null && auth.access != null
  let hdr = signedIn ? {"trakt-api-key": cid, "trakt-api-version": "2", "Authorization": "Bearer ${auth.access}"} : {"trakt-api-key": cid, "trakt-api-version": "2"}

  source now = clock every 1m
  source tick = clock every 1s

  state tab = "discover" persist
  state view = ""
  // Pages opened, newest first: {t, id, m}, with m the movie or show as the list had it.
  state stack = []
  let open = first(stack)
  state hideSpoilers = false persist
  state note = ""
  state noteUntil = 0
  at noteUntil { note = ""; noteUntil = 0 }

  let sw = screenWidth ?? 411
  let pw = floor((sw - 32 - 20) / 3)
  let cum = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let today = fmtTime(now, "yyyy-MM-dd")
  let nowIso = fmtTime(now, "yyyy-MM-dd")

  // ------------------------------------------------------------------ sign-in
  // Trakt's device flow: ask for a code, show it, and poll until it's typed in at trakt.tv/activate.
  state codeRes = 0
  state tokRes = 0
  state refRes = 0
  state outRes = 0
  state asking = false
  state dev = null
  state authMsg = ""
  state confirmOut = false

  on codeRes {
    asking = value == 0 ? asking : false
    dev = value == 0 ? dev : value.ok && value.out.device_code != null ? {code: value.out.device_code, user: value.out.user_code, url: startsWith(value.out.verification_url ?? "", "https://") && contains(value.out.verification_url, "trakt.tv/") ? value.out.verification_url : "https://trakt.tv/activate", until: tick + clamp(num(value.out.expires_in, 600), 60, 1800)} : null
    authMsg = value == 0 ? authMsg : value.ok ? "" : value.code < 0 ? "Can't reach Trakt." : "Trakt didn't hand out a code (${value.code})."
  }
  // Every 7 s while a code is on show; Trakt asks for 5 or more.
  every 7s { tokRes = post(dev != null && !signedIn && tick < dev.until ? "https://api.trakt.tv/oauth/device/token" : null, {code: dev.code, client_id: cid, client_secret: csec}, {"trakt-api-key": cid, "trakt-api-version": "2"}) }
  on tokRes {
    auth = value != 0 && value.ok && value.out.access_token != null ? {access: value.out.access_token, refresh: value.out.refresh_token, expires: num(value.out.created_at, tick) + num(value.out.expires_in, 86400), life: num(value.out.expires_in, 86400)} : auth
    authMsg = value == 0 || value.ok || value.code == 400 || value.code == 429 || value.code < 0 ? authMsg : value.code == 418 ? "Sign-in was declined on Trakt." : value.code == 410 ? "The code expired. Get a new one." : value.code == 409 ? "That code was already used. Get a new one." : "Trakt didn't accept the sign-in (${value.code})."
    dev = value == 0 || value.code == 400 || value.code == 429 || value.code < 0 ? dev : null
    note = value != 0 && value.ok ? "Signed in" : note
    noteUntil = value != 0 && value.ok ? tick + 3 : noteUntil
  }
  when dev != null && tick > dev.until { dev = null; authMsg = "The code expired. Get a new one." }

  // Tokens are renewed once three quarters of their life is gone, and when Trakt stops taking one.
  source me = http(signedIn ? "https://api.trakt.tv/users/settings" : null, hdr) every 1h json timeout 20s status
  when signedIn && (auth.expires - now < auth.life / 4 || me.code == 401) {
    refRes = 0
    refRes = post(auth.refresh != null ? "https://api.trakt.tv/oauth/token" : null, {refresh_token: auth.refresh, client_id: cid, client_secret: csec, redirect_uri: "urn:ietf:wg:oauth:2.0:oob", grant_type: "refresh_token"}, {"trakt-api-key": cid, "trakt-api-version": "2"})
  }
  on refRes {
    authMsg = value != 0 && !value.ok && value.code >= 400 && value.code < 500 ? "Trakt signed you out. Sign in again to see your lists." : authMsg
    auth = value == 0 ? auth : value.ok && value.out.access_token != null ? {access: value.out.access_token, refresh: value.out.refresh_token, expires: num(value.out.created_at, now) + num(value.out.expires_in, 86400), life: num(value.out.expires_in, 86400)} : value.code >= 400 && value.code < 500 ? null : auth
  }
  let user = signedIn && me != null && me.ok ? me.out.user : null
  let avatarPath = replace(user.images.avatar.full ?? "", "https://media.trakt.tv/", "")
  let avatar = user != null && startsWith(user.images.avatar.full ?? "", "https://media.trakt.tv/") ? "https://media.trakt.tv/${avatarPath}" : null
  source stats = http(signedIn && view == "settings" && user != null ? "https://api.trakt.tv/users/${enc(user.ids.slug)}/stats" : null, hdr) every 10m json timeout 20s status

  // ------------------------------------------------------------------ your lists
  // Every change shows at once: an override stands in until Trakt's next copy of the list arrives,
  // and a change Trakt refuses is put back.
  state wlOver = []
  state playsOver = []
  state rateOver = []
  state epOver = []
  state doneOver = []
  state wlRes = 0
  state hisRes = 0
  state rateRes = 0
  state epRes = 0
  state upRes = 0

  source wlM = http(signedIn ? "https://api.trakt.tv/sync/watchlist/movies/added/desc?extended=full,images&page=1&limit=250" : null, hdr) every 10m json timeout 30s status
  source wlS = http(signedIn ? "https://api.trakt.tv/sync/watchlist/shows/added/desc?extended=full,images&page=1&limit=250" : null, hdr) every 10m json timeout 30s status
  let wlMovies = signedIn && wlM != null && wlM.ok ? wlM.out.filter(e => e.movie != null).map(e => {t: "movie", m: e.movie, at: e.listed_at}) : []
  let wlShows = signedIn && wlS != null && wlS.ok ? wlS.out.filter(e => e.show != null).map(e => {t: "show", m: e.show, at: e.listed_at}) : []
  let wlKeys = wlMovies.map(i => "movie:${i.m.ids.trakt}") + wlShows.map(i => "show:${i.m.ids.trakt}")
  on wlM { wlOver = [] }
  on wlS { wlOver = [] }
  on wlRes {
    wlOver = value != 0 && !value.ok ? [] : wlOver
    note = value != 0 && !value.ok ? "Couldn't update your watchlist. Try again in a moment." : note
    noteUntil = value != 0 && !value.ok ? tick + 4 : noteUntil
  }
  on hisRes {
    playsOver = value != 0 && !value.ok ? [] : playsOver
    note = value != 0 && !value.ok ? "Couldn't change your history. Try again in a moment." : note
    noteUntil = value != 0 && !value.ok ? tick + 4 : noteUntil
  }
  on rateRes {
    rateOver = value != 0 && !value.ok ? [] : rateOver
    note = value != 0 && !value.ok ? "Couldn't save your rating. Try again in a moment." : note
    noteUntil = value != 0 && !value.ok ? tick + 4 : noteUntil
  }
  on epRes {
    epOver = value != 0 && !value.ok ? [] : epOver
    note = value != 0 && !value.ok ? "Couldn't mark it. Try again in a moment." : note
    noteUntil = value != 0 && !value.ok ? tick + 4 : noteUntil
  }
  on upRes {
    doneOver = value != 0 && !value.ok ? [] : doneOver
    note = value != 0 && !value.ok ? "Couldn't mark it watched. Try again in a moment." : note
    noteUntil = value != 0 && !value.ok ? tick + 4 : noteUntil
  }

  // ------------------------------------------------------------------ discover
  state dtype = "movie" persist
  state dsec = "trending" persist
  state dpage = 1
  state hero = 0
  let dsec2 = dtype == "show" && dsec == "boxoffice" ? "trending" : dsec
  let onTab = view == "" && open == null
  source disc = http(tab == "discover" && onTab ? (dsec2 == "boxoffice" ? "https://api.trakt.tv/movies/boxoffice?extended=full,images" : dsec2 == "watched" ? "https://api.trakt.tv/${enc(dtype)}s/watched/weekly?extended=full,images&page=${int(dpage)}&limit=24" : "https://api.trakt.tv/${enc(dtype)}s/${enc(dsec2)}?extended=full,images&page=${int(dpage)}&limit=24") : null, hdr) every 15m json timeout 20s status
  let ditems = disc != null && disc.ok ? disc.out.map(e => {t: e.movie != null ? "movie" : e.show != null ? "show" : dtype, m: e.movie ?? e.show ?? e, stat: e.watchers ?? e.list_count ?? e.watcher_count, rev: e.revenue}).filter(i => i.m.ids.trakt != null) : []
  let heroes = ditems.filter(i => len(i.m.images.fanart ?? []) > 0).take(5)
  let heroAt = len(heroes) == 0 ? null : heroes[hero % len(heroes)]
  every 7s { hero = tab == "discover" && onTab ? (hero + 1) % max(1, len(heroes)) : hero }
  let sections = [
    {k: "trending", l: "trending", n: "Most watched on Trakt right now"},
    {k: "popular", l: "popular", n: "Best rated by the most people, all time"},
    {k: "anticipated", l: "anticipated", n: "Most added to lists, not out yet"},
    {k: "watched", l: "this week", n: "Most watched in the last seven days"},
    {k: "boxoffice", l: "box office", n: "Top 10 at the US box office last weekend"}
  ].filter(s => s.k != "boxoffice" || dtype == "movie")

  // ------------------------------------------------------------------ up next
  state upage = 1
  source up = http(signedIn && tab == "upnext" && onTab ? "https://api.trakt.tv/sync/progress/up_next?extended=full,images&page=${int(upage)}&limit=20" : null, hdr) every 5m json timeout 20s status
  let ups = up != null && up.ok ? up.out.filter(r => r.show != null && r.progress.next_episode != null) : []
  on up { doneOver = [] }

  // ------------------------------------------------------------------ calendar
  state cmode = "shows" persist
  let cmodes = signedIn ? [{k: "shows", l: "my shows"}, {k: "movies", l: "my movies"}, {k: "premieres", l: "premieres"}, {k: "new", l: "new shows"}] : [{k: "premieres", l: "premieres"}, {k: "new", l: "new shows"}]
  let cm = any(cmodes, x => x.k == cmode) ? cmode : cmodes[0].k
  // From yesterday, so last night's episode is still there in the morning.
  let cstart = fmtTime(now - 86400, "yyyy-MM-dd")
  source cal = http(tab == "calendar" && onTab ? (cm == "shows" ? "https://api.trakt.tv/calendars/my/shows/${enc(cstart)}/15?extended=full,images" : cm == "movies" ? "https://api.trakt.tv/calendars/my/movies/${enc(cstart)}/60?extended=full,images" : cm == "premieres" ? "https://api.trakt.tv/calendars/all/shows/premieres/${enc(cstart)}/21?extended=full,images" : "https://api.trakt.tv/calendars/all/shows/new/${enc(cstart)}/21?extended=full,images") : null, hdr) every 30m json timeout 30s status
  // An ISO time as Unix seconds, worked out from its digits; a movie's release date counts from noon.
  let crows0 = (cal != null && cal.ok ? cal.out : []).filter(r => r.show != null || r.movie != null).map(r => {r: r, s: r.first_aired ?? "${r.released}T12:00:00.000Z"})
  let crows1 = crows0.map(c => {r: c.r, y: num(sub(c.s, 0, 4)), mo: num(sub(c.s, 5, 7)), d: num(sub(c.s, 8, 10)), hm: num(sub(c.s, 11, 13)) * 3600 + num(sub(c.s, 14, 16)) * 60, movie: c.r.movie != null})
  // A movie's noon is local noon: the day it comes out wherever the phone is.
  let fmtOffset = num(fmtTime(43200, "H"), 12) * 3600 - 43200
  let crows = crows1.map(c => {r: c.r, movie: c.movie, t: ((c.y - 1970) * 365 + floor((c.y - 1969) / 4) + cum[c.mo - 1] + (c.y % 4 == 0 && c.mo > 2 ? 1 : 0) + c.d - 1) * 86400 + c.hm - (c.movie ? fmtOffset : 0)}).sortBy(c => c.t)
  let cdays = unique(crows.map(c => fmtTime(c.t, "yyyy-MM-dd")))

  // ------------------------------------------------------------------ watchlist
  state wtype = "movie" persist
  state wsort = "added"
  state wpage = 0
  let wraw = (wtype == "show" ? wlShows : wlMovies).filter(i => (wlOver.find(o => o.k == "${i.t}:${i.m.ids.trakt}") ?? {v: true}).v)
  let wlist = wsort == "title" ? wraw.sortBy(i => lower(i.m.title ?? "")) : wsort == "rating" ? wraw.sortBy(i => -num(i.m.rating, 0)) : wsort == "released" ? wraw.sortBy(i => i.m.released ?? i.m.first_aired ?? "").reverse() : wraw
  let wpages = max(1, ceil(len(wlist) / 24))

  // ------------------------------------------------------------------ history
  state hpage = 1
  source his = http(signedIn && view == "history" && open == null ? "https://api.trakt.tv/sync/history?extended=full,images&page=${int(hpage)}&limit=25" : null, hdr) every 5m json timeout 20s status
  let hrows0 = (his != null && his.ok ? his.out : []).filter(r => r.movie != null || r.show != null).map(r => {r: r, y: num(sub(r.watched_at, 0, 4)), mo: num(sub(r.watched_at, 5, 7)), d: num(sub(r.watched_at, 8, 10)), hm: num(sub(r.watched_at, 11, 13)) * 3600 + num(sub(r.watched_at, 14, 16)) * 60})
  let hrows = hrows0.map(c => {r: c.r, t: ((c.y - 1970) * 365 + floor((c.y - 1969) / 4) + cum[c.mo - 1] + (c.y % 4 == 0 && c.mo > 2 ? 1 : 0) + c.d - 1) * 86400 + c.hm})
  let hdays = unique(hrows.map(c => fmtTime(c.t, "yyyy-MM-dd")))

  // ------------------------------------------------------------------ search
  state typed = ""
  state sfilter = "movie,show"
  let squery = trim(typed)
  source found = http(view == "search" && open == null && len(squery) >= 2 ? (sfilter == "movie" ? "https://api.trakt.tv/search/movie?query=${enc(squery)}&extended=full,images&limit=24" : sfilter == "show" ? "https://api.trakt.tv/search/show?query=${enc(squery)}&extended=full,images&limit=24" : "https://api.trakt.tv/search/movie,show?query=${enc(squery)}&extended=full,images&limit=24") : null, hdr) every 1h json timeout 20s status
  // Nothing typed yet: what's trending.
  source trM = http(view == "search" && open == null && len(squery) < 2 ? "https://api.trakt.tv/movies/trending?extended=full,images&page=1&limit=12" : null, hdr) every 15m json timeout 20s status
  source trS = http(view == "search" && open == null && len(squery) < 2 ? "https://api.trakt.tv/shows/trending?extended=full,images&page=1&limit=12" : null, hdr) every 15m json timeout 20s status
  let results = found != null && found.ok ? found.out.filter(r => r.type == "movie" || r.type == "show").map(r => {t: r.type, m: get(r, r.type, null)}).filter(i => i.m.ids.trakt != null) : []
  let tm = trM != null && trM.ok ? trM.out.map(e => {t: "movie", m: e.movie}) : []
  let ts = trS != null && trS.ok ? trS.out.map(e => {t: "show", m: e.show}) : []
  let suggestions = flatten(range(12).map(i => [tm[i], ts[i]])).filter(i => i != null)

  // ------------------------------------------------------------------ a title's page
  state season = -1
  state allEps = false
  state more = false
  state unconf = false
  state unconfUntil = 0
  state step = false
  at unconfUntil { unconf = false; unconfUntil = 0 }
  let ot = open.t ?? "movie"
  let oid = open.id ?? 0
  let isShow = ot == "show"
  let okey = "${ot}:${oid}"
  source sum = http(open != null ? "https://api.trakt.tv/${enc(ot)}s/${int(oid)}?extended=full,images" : null, hdr) every 1h json timeout 20s status
  source ppl = http(open != null ? "https://api.trakt.tv/${enc(ot)}s/${int(oid)}/people?extended=images" : null, hdr) every 24h json timeout 20s status
  source rel = http(open != null ? "https://api.trakt.tv/${enc(ot)}s/${int(oid)}/related?extended=full,images&limit=12" : null, hdr) every 24h json timeout 20s status
  source seas = http(open != null && isShow ? "https://api.trakt.tv/shows/${int(oid)}/seasons?extended=full" : null, hdr) every 1h json timeout 20s status
  source prog = http(open != null && isShow && signedIn ? "https://api.trakt.tv/shows/${int(oid)}/progress/watched?hidden=false&specials=false" : null, hdr) every 2m json timeout 20s status
  source plays = http(open != null && !isShow && signedIn ? "https://api.trakt.tv/sync/history/movies/${int(oid)}?limit=100" : null, hdr) every 5m json timeout 20s status
  source rated = http(open != null && signedIn ? "https://api.trakt.tv/sync/ratings/${enc(ot)}s" : null, hdr) every 10m json timeout 30s status
  // Which title each answer belongs to: an answer stays on show until the next one arrives.
  state pplFor = ""
  state relFor = ""
  state seasFor = ""
  state progFor = ""
  on ppl { pplFor = okey }
  on rel { relFor = okey }
  on seas { seasFor = okey }
  on prog { progFor = okey; epOver = [] }
  on plays { playsOver = [] }
  on rated { rateOver = [] }
  when ppl != null { pplFor = okey }
  when rel != null { relFor = okey }
  when seas != null { seasFor = okey }
  when prog != null { progFor = okey }

  let full = sum != null && sum.ok && sum.out.ids.trakt == oid ? sum.out : null
  let item = full ?? open.m
  let cast = pplFor == okey && ppl != null && ppl.ok ? (ppl.out.cast ?? []).take(12) : []
  let crew = pplFor == okey && ppl != null && ppl.ok ? ppl.out.crew : null
  let crewLines = [
    {j: "Created by", n: get(crew ?? {}, "created by", []).map(p => p.person.name).unique().take(3)},
    {j: "Directed by", n: (crew.directing ?? []).filter(p => indexOf(p.jobs ?? [p.job], "Director") >= 0).map(p => p.person.name).unique().take(3)},
    {j: "Written by", n: (crew.writing ?? []).map(p => p.person.name).unique().take(3)}
  ].filter(c => len(c.n) > 0)
  let related = relFor == okey && rel != null && rel.ok ? rel.out.filter(m => m.ids.trakt != null).map(m => {t: ot, m: m}) : []
  let seasons0 = isShow && seasFor == okey && seas != null && seas.ok ? seas.out.filter(s => s.number != null) : []
  // Specials last: nobody starts a show there.
  let seasons = seasons0.filter(s => s.number > 0) + seasons0.filter(s => s.number == 0)
  let progress = isShow && progFor == okey && prog != null && prog.ok ? prog.out : null
  let sn = season >= 0 ? season : progress.next_episode.season ?? (first(seasons) ?? {number: 1}).number
  source eps = http(open != null && isShow && len(seasons) > 0 ? "https://api.trakt.tv/shows/${int(oid)}/seasons/${int(sn)}?extended=full" : null, hdr) every 1h json timeout 20s status
  state epsFor = ""
  on eps { epsFor = "${okey}:${sn}" }
  when eps != null { epsFor = "${okey}:${sn}" }
  let episodes = epsFor == "${okey}:${sn}" && eps != null && eps.ok ? eps.out : []
  let doneIn = (progress.seasons ?? []).find(s => s.number == sn).episodes ?? []
  let isDone = episodes.map(e => (epOver.find(o => o.k == "${oid}:${e.season}:${e.number}") ?? {v: any(doneIn, d => d.number == e.number && d.completed)}).v)
  let airedEps = episodes.filter(e => e.first_aired != null && sub(e.first_aired, 0, 10) <= nowIso)
  let seasonDone = len(airedEps) > 0 && all(range(len(episodes)), i => isDone[i] || episodes[i].first_aired == null || sub(episodes[i].first_aired, 0, 10) > nowIso)

  let listed = signedIn && (wlOver.find(o => o.k == okey) ?? {v: indexOf(wlKeys, okey) >= 0}).v
  let pl = (playsOver.find(o => o.k == oid) ?? {v: plays != null && plays.ok ? len(plays.out.filter(h => h.movie.ids.trakt == oid)) : 0}).v
  let mine = (rateOver.find(o => o.k == okey) ?? {v: (rated != null && rated.ok ? rated.out.find(r => get(r, ot, {}).ids.trakt == oid).rating : 0) ?? 0}).v
  let bodyFor = isShow ? {shows: [{ids: {trakt: oid}}]} : {movies: [{ids: {trakt: oid}}]}

  let genreWords = {"science-fiction": "Sci-Fi", "tv-movie": "TV Movie", "game-show": "Game Show", "talk-show": "Talk Show", "home-and-garden": "Home & Garden"}
  let genres = (item.genres ?? []).take(4).map(g => get(genreWords, g, join(split(g, "-").map(w => upper(sub(w, 0, 1)) + sub(w, 1, len(w))), " ")))
  let runtime = num(item.runtime, 0) <= 0 ? "" : floor(item.runtime / 60) > 0 ? "${floor(item.runtime / 60)}h${item.runtime % 60 > 0 ? " " + (item.runtime % 60) + "m" : ""}" : "${item.runtime}m"
  let relDate = item.released ?? sub(item.first_aired ?? "", 0, 10)
  let relText = len(relDate ?? "") >= 10 ? "${months[num(sub(relDate, 5, 7)) - 1]} ${num(sub(relDate, 8, 10))}, ${sub(relDate, 0, 4)}" : ""
  let statusWords = {"returning series": "Returning", "in production": "In production", "planned": "Planned", "canceled": "Canceled", "ended": "Ended", "released": "Released", "post production": "Post-production", "upcoming": "Upcoming", "pilot": "Pilot", "rumored": "Rumored"}
  let metaLine = join([item.year == null ? "" : "${item.year}", isShow ? item.network ?? "" : "", runtime == "" ? "" : runtime + (isShow ? " per ep" : ""), item.certification ?? ""].filter(s => s != ""), "  ·  ")
  let facts = [
    {k: isShow ? "Premiered" : "Released", v: relText},
    {k: "Runtime", v: runtime},
    {k: "Status", v: get(statusWords, item.status ?? "", "")},
    {k: "Network", v: item.network ?? ""},
    {k: "Airs", v: full.airs.day == null ? "" : "${full.airs.day}${full.airs.time == null ? "" : " " + full.airs.time}"},
    {k: "Country", v: upper(full.country ?? "")},
    {k: "Language", v: upper(full.language ?? "")},
    {k: "Episodes", v: full.aired_episodes == null ? "" : "${full.aired_episodes}"},
    {k: "Rated", v: full.certification ?? ""}
  ].filter(f => f.v != "")
  let trailer = startsWith(full.trailer ?? "", "https://") ? full.trailer : null
  let siteUrl = "https://trakt.tv/${ot}s/${item.ids.slug ?? oid}"

  // Changing or leaving settings.
  state idIn = ""
  state secretIn = ""
  state ownApp = false

  // A Trakt picture: always on media.trakt.tv, as "media.trakt.tv/images/…"; "thumb" for a list.
  component Pic(path, w, h, r = 8, thumb = true, dim = false) {
    let p = replace(path ?? "", "media.trakt.tv/", "")
    Box {
      width: w
      height: h
      radius: r * corners
      clip: true
      background: surface
      if p != "" {
        Image { src: "https://media.trakt.tv/${thumb ? replace(p, "/medium/", "/thumb/") : p}"; width: w; height: h; fit: cover; opacity: dim ? 0.45 : 1 }
      }
    }
  }

  // A movie or show as a poster, with its title and rating; it opens its page.
  component PosterCard(it, badge = "") {
    let m = it.m
    let k = "${it.t}:${m.ids.trakt}"
    let mark = signedIn && (wlOver.find(o => o.k == k) ?? {v: indexOf(wlKeys, k) >= 0}).v
    let poster = first(m.images.poster ?? [])
    Column {
      gap: 3
      width: pw
      onTap: { stack = [{t: it.t, id: m.ids.trakt, m: m}] + stack; season = -1; allEps = false; more = false; unconf = false }
      Box {
        width: pw
        height: pw * 1.5
        Pic { path: poster; w: pw; h: pw * 1.5 }
        if poster == null {
          Text { text: m.title ?? ""; style: small; color: muted; align: center; maxLines: 4; padding: [8, 12]; width: pw }
        }
        Row {
          width: pw
          padding: 5
          if badge != "" {
            Text { text: badge; fontSize: 11; bold: true; color: #ffffff; background: alpha(#000000, 0.6); radius: 4 * corners; padding: [6, 2]; maxLines: 1; width: min(pw - 40, len(badge) * 7 + 14) }
          }
          Spacer { weight: 1 }
          if mark {
            Box {
              width: 22
              height: 22
              radius: 11
              background: accent
              align: center
              Image { src: bookmarkedIcon; size: 14; tint: background }
            }
          }
        }
      }
      Text { text: m.title ?? ""; style: small; bold: true; maxLines: 1 }
      Row {
        gap: 4
        align: center
        Text { text: m.year == null ? (it.t == "show" ? "Show" : "Movie") : "${m.year}"; fontSize: 11; color: muted; weight: 1; maxLines: 1 }
        if num(m.rating, 0) > 0 {
          Image { src: heartIcon; size: 11; tint: red }
          Text { text: "${round(m.rating * 10)}%"; fontSize: 11; color: muted; width: 30; maxLines: 1 }
        }
      }
    }
  }

  // A labelled chip; the caller's Box takes the tap.
  component Chip(text, sel = false) {
    Text { text: text; style: small; align: center; maxLines: 1; padding: [14, 6]; color: sel ? background : foreground; background: sel ? accent : null; bold: sel; border: sel ? 0 : 1; borderColor: alpha(muted, 0.45); radius: 16 * corners; width: len(text) * 8 + 30 }
  }

  // A button with an icon, outlined; filled while it's `on`.
  component Pill(text, pic, sel = false, tint = accent) {
    Row {
      gap: 6
      align: center
      padding: [12, 8]
      border: 1
      borderColor: sel ? tint : alpha(muted, 0.5)
      background: sel ? alpha(tint, 0.16) : null
      radius: 18 * corners
      Image { src: pic; size: 16; tint: sel ? tint : foreground }
      Text { text: text; style: small; bold: true; maxLines: 1; color: sel ? tint : foreground; width: len(text) * 7.5 + 4 }
    }
  }

  component Head(text) {
    Text { text: text; bold: true; fontSize: 17; padding: [0, 10, 0, 2] }
  }

  // Nothing to show: why, and what to do.
  component Empty(pic, text, detail = "") {
    Column {
      gap: 8
      align: center
      padding: [8, 48, 8, 16]
      Image { src: pic; size: 44; tint: muted }
      Text { text: text; bold: true; align: center }
      if detail != "" {
        Text { text: detail; style: small; color: muted; align: center }
      }
    }
  }

  // What went wrong with an answer, if anything.
  component Trouble(res) {
    if res != null && !res.ok {
      Text { text: res.code == 429 ? "Trakt asked to slow down; try again in a minute." : res.code < 0 ? "Can't reach Trakt." : "Trakt answered ${res.code}."; style: small; color: yellow; padding: [0, 6] }
    }
  }

  // A row of a day list (calendar and history): the time, the poster, what it is.
  component DayRow(r, pic = true, lead = "", dim = false) {
    let m = r.movie ?? r.show
    let e = r.episode
    Row {
      gap: 12
      align: center
      padding: [0, 6]
      opacity: dim ? 0.5 : 1
      onTap: { stack = [{t: r.movie != null ? "movie" : "show", id: m.ids.trakt, m: m}] + stack; season = e == null ? -1 : e.season; allEps = false; more = false; unconf = false }
      Text { text: lead; style: small; color: muted; width: 42; maxLines: 1 }
      if pic {
        Pic { path: first(m.images.poster ?? []); w: 40; h: 60; r: 5 }
      } else {
        Box { width: 40; height: 60; radius: 5 * corners; background: surface }
      }
      Column {
        gap: 2
        weight: 1
        Text { text: m.title ?? ""; bold: true; maxLines: 1 }
        if e != null {
          Text { text: "S${pad(e.season, 2, "0")}E${pad(e.number, 2, "0")}${hideSpoilers || e.title == null ? "" : "  ·  " + e.title}"; style: small; maxLines: 1 }
        }
        Text { text: r.movie != null ? "Movie" + (num(m.runtime, 0) <= 0 ? "" : m.runtime >= 60 ? "  ·  ${floor(m.runtime / 60)}h ${m.runtime % 60}m" : "  ·  ${m.runtime}m") : m.network ?? ""; style: small; color: muted; maxLines: 1 }
      }
    }
  }

  // An episode of the open show, with your mark.
  component EpisodeRow(e, done) {
    let aired = e.first_aired != null && sub(e.first_aired, 0, 10) <= nowIso
    let veil = hideSpoilers && !done
    let d = sub(e.first_aired ?? "", 0, 10)
    Row {
      gap: 10
      align: center
      padding: [0, 7]
      Column {
        gap: 2
        weight: 1
        Text { text: "${e.number}.  ${veil || e.title == null ? "Episode " + e.number : e.title}"; bold: true; maxLines: 2; color: aired ? foreground : muted }
        Text { text: (len(d) == 10 ? "${months[num(sub(d, 5, 7)) - 1]} ${num(sub(d, 8, 10))}, ${sub(d, 0, 4)}" : "Not scheduled") + (num(e.rating, 0) > 0 && aired ? "  ·  ${round(e.rating * 10)}%" : "") + (e.runtime == null ? "" : "  ·  ${e.runtime}m"); style: small; color: muted; maxLines: 1 }
        if !veil && e.overview != null && more {
          Text { text: e.overview; style: small; color: alpha(foreground, 0.8); maxLines: 6 }
        }
      }
      if signedIn && aired {
        Box {
          width: 40
          height: 40
          align: center
          onTap: { epRes = 0; epRes = post(done ? "https://api.trakt.tv/sync/history/remove" : "https://api.trakt.tv/sync/history", {episodes: [{ids: {trakt: e.ids.trakt}}]}, hdr); epOver = [{k: "${oid}:${e.season}:${e.number}", v: !done}] + epOver; haptic() }
          Image { src: done ? doneIcon : circleIcon; size: 28; tint: done ? green : alpha(muted, 0.8) }
        }
      }
    }
  }

  // A tab of the bottom bar.
  component Tab(name, text, pic) {
    let sel = tab == name && view == ""
    Column {
      weight: 1
      align: center
      gap: 3
      padding: [0, 6]
      onTap: { tab = name; view = ""; stack = []; haptic() }
      Box {
        align: center
        width: 56
        height: 30
        Image { src: pic; size: 22; tint: sel ? accent : muted }
      }
      Text { text: text; fontSize: 11; align: center; maxLines: 1; bold: sel; color: sel ? foreground : muted }
    }
  }

  // The sign-in, wherever a list needs it.
  component SignIn(text) {
    Column {
      gap: 10
      align: center
      padding: [8, 40, 8, 16]
      Image { src: loginIcon; size: 44; tint: muted }
      Text { text: text; bold: true; align: center }
      Text { text: "Sign in with your Trakt account to track episodes, keep a watchlist and see your calendar."; style: small; color: muted; align: center }
      Box {
        onTap: { view = "settings"; stack = []; asking = true; authMsg = ""; codeRes = 0; codeRes = post("https://api.trakt.tv/oauth/device/code", {client_id: cid}, {"trakt-api-key": cid, "trakt-api-version": "2"}) }
        Pill { text: "Sign in with Trakt"; pic: loginIcon; sel: true }
      }
    }
  }

  Column {
    gap: 0
    fill: true

    Column {
      weight: 1
      scroll: true
      gap: 12
      padding: open != null ? [0, 0, 0, 16] : [16, 6, 16, 16]

      if open != null {
        // ---------------------------------------------------------------- a title's page
        let bh = round(sw * 0.56)
        let fan = first(item.images.fanart ?? [])
        Box {
          width: sw
          height: bh + 72
          Pic { path: fan; w: sw; h: bh; r: 0; thumb: false }
          Canvas {
            width: sw
            height: bh + 72
            rect(0, 0, width, bh + 1, fill: linear(0, 0, 0, bh, [alpha(#000000, 0.35), alpha(background, 0), alpha(background, 0.4), alpha(background, 0.9), background]))
            rect(0, bh, width, height - bh, fill: background)
          }
          Column {
            width: sw
            height: bh + 72
            padding: [16, 0]
            gap: 0
            Spacer { weight: 1 }
            Row {
              gap: 14
              align: bottom
              Pic { path: first(item.images.poster ?? []); w: 108; h: 162; r: 8 }
              Column {
                gap: 4
                weight: 1
                Text { text: item.title ?? ""; fontSize: 22; bold: true; maxLines: 3 }
                if metaLine != "" {
                  Text { text: metaLine; style: small; color: muted; maxLines: 2 }
                }
                if len(genres) > 0 {
                  Text { text: join(genres, "  ·  "); style: small; color: muted; maxLines: 2 }
                }
                if num(item.rating, 0) > 0 {
                  Row {
                    gap: 6
                    align: center
                    Image { src: heartIcon; size: 16; tint: red }
                    Text { text: "${round(item.rating * 10)}%"; bold: true; width: 44 }
                    Text { text: num(item.votes, 0) >= 1000 ? "${round(item.votes / 1000, 1)}K votes" : "${item.votes ?? 0} votes"; style: small; color: muted; weight: 1 }
                  }
                }
              }
            }
          }
        }

        Column {
          gap: 16
          padding: [16, 0]
          Trouble { res: full == null ? sum : null }

          Flow {
            gap: 8
            Box {
              onTap: { wlRes = 0; wlRes = post(listed ? "https://api.trakt.tv/sync/watchlist/remove" : "https://api.trakt.tv/sync/watchlist", bodyFor, hdr); note = signedIn ? (listed ? "Removed from your watchlist" : "Added to your watchlist") : "Sign in to Trakt first"; noteUntil = tick + 3; wlOver = signedIn ? [{k: okey, v: !listed}] + wlOver : wlOver; view = signedIn ? view : "settings"; stack = signedIn ? stack : []; haptic() }
              Pill { text: listed ? "On watchlist" : "Watchlist"; pic: listed ? bookmarkedIcon : watchlistIcon; sel: listed }
            }
            if !isShow {
              Box {
                onTap: { step = pl > 0 && !unconf; hisRes = 0; hisRes = post(!signedIn ? null : pl == 0 ? "https://api.trakt.tv/sync/history" : unconf ? "https://api.trakt.tv/sync/history/remove" : null, bodyFor, hdr); note = !signedIn ? "Sign in to Trakt first" : pl == 0 ? "Marked as watched" : unconf ? "Removed from your history" : note; noteUntil = !signedIn || pl == 0 || unconf ? tick + 3 : noteUntil; playsOver = !signedIn ? playsOver : pl == 0 ? [{k: oid, v: 1}] + playsOver : unconf ? [{k: oid, v: 0}] + playsOver : playsOver; unconf = step; unconfUntil = step ? tick + 3 : 0; haptic() }
                Pill { text: unconf ? "Tap again to unwatch" : pl > 1 ? "Watched ${pl}×" : pl == 1 ? "Watched" : "Mark watched"; pic: pl > 0 ? doneIcon : checkIcon; sel: pl > 0; tint: green }
              }
            }
            if trailer != null {
              Box {
                onTap: url(trailer)
                Pill { text: "Trailer"; pic: trailerIcon }
              }
            }
            Box {
              onTap: url(siteUrl)
              Pill { text: "Trakt"; pic: openIcon }
            }
          }

          if signedIn {
            Column {
              gap: 2
              Text { text: mine > 0 ? "Your rating: ${mine}/10" : "Your rating"; style: small; color: muted; bold: true }
              Row {
                gap: 0
                for v in range(1, 11) {
                  Box {
                    weight: 1
                    height: 34
                    align: center
                    onTap: { rateRes = 0; rateRes = post(v == mine ? "https://api.trakt.tv/sync/ratings/remove" : "https://api.trakt.tv/sync/ratings", isShow ? {shows: [{ids: {trakt: oid}, rating: v}]} : {movies: [{ids: {trakt: oid}, rating: v}]}, hdr); rateOver = [{k: okey, v: v == mine ? 0 : v}] + rateOver; haptic() }
                    Image { src: v <= mine ? starIcon : starOffIcon; size: 24; tint: v <= mine ? yellow : alpha(muted, 0.7) }
                  }
                }
              }
            }
          }

          if full.tagline != null && full.tagline != "" {
            Text { text: full.tagline; italic: true }
          }
          if item.overview != null && item.overview != "" {
            Text { text: item.overview; color: alpha(foreground, 0.85); maxLines: more ? 100 : 5; onTap: more = !more }
            Text { text: more ? "Less" : "More"; style: small; bold: true; color: accent; onTap: more = !more }
          }
          if len(crewLines) > 0 {
            Text { text: join(crewLines.map(c => "${c.j} ${join(c.n, ", ")}"), "\n"); style: small; color: muted }
          }

          if isShow && progress != null && num(progress.aired, 0) > 0 {
            let nx = progress.next_episode
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Row {
                gap: 8
                align: center
                Text { text: progress.completed >= progress.aired ? "All caught up" : "Your progress"; bold: true; weight: 1 }
                Text { text: "${progress.completed} of ${progress.aired} episodes"; style: small; color: muted; width: 140; align: end }
              }
              Progress { value: progress.completed; max: progress.aired; color: accent }
              if nx != null {
                Row {
                  gap: 10
                  align: center
                  Text { text: "Next: S${pad(nx.season, 2, "0")}E${pad(nx.number, 2, "0")}${hideSpoilers || nx.title == null ? "" : "  ·  " + nx.title}"; style: small; weight: 1; maxLines: 2 }
                  Box {
                    onTap: { epRes = 0; epRes = post("https://api.trakt.tv/sync/history", {episodes: [{ids: {trakt: nx.ids.trakt}}]}, hdr); epOver = [{k: "${oid}:${nx.season}:${nx.number}", v: true}] + epOver; note = "Marked as watched"; noteUntil = tick + 3; haptic() }
                    Pill { text: "Watched"; pic: checkIcon; sel: true; tint: green }
                  }
                }
              }
            }
          }

          if isShow && len(seasons) > 0 {
            Head { text: "Episodes" }
            Flow {
              gap: 6
              for s in seasons key s.number {
                Box {
                  onTap: { season = s.number; allEps = false }
                  Chip { text: s.number == 0 ? "Specials" : "S${s.number}"; sel: sn == s.number }
                }
              }
            }
            Row {
              gap: 8
              align: center
              let sinfo = seasons.find(s => s.number == sn)
              Text { text: len(episodes) == 0 ? (eps == null || epsFor != "${okey}:${sn}" ? "Loading episodes…" : "No episodes listed yet") : "${len(episodes)} episodes${sinfo.first_aired == null ? "" : "  ·  " + sub(sinfo.first_aired, 0, 4)}"; style: small; color: muted; weight: 1 }
              if signedIn && len(airedEps) > 0 {
                Box {
                  onTap: { epRes = 0; epRes = post(seasonDone ? "https://api.trakt.tv/sync/history/remove" : "https://api.trakt.tv/sync/history", {shows: [{ids: {trakt: oid}, seasons: [{number: sn}]}]}, hdr); epOver = airedEps.map(e => {k: "${oid}:${e.season}:${e.number}", v: !seasonDone}) + epOver; note = seasonDone ? "Unmarked ${len(airedEps)} episodes" : "Marked ${len(airedEps)} episodes"; noteUntil = tick + 3; haptic() }
                  Pill { text: seasonDone ? "Season watched" : "Mark season"; pic: seasonDone ? doneIcon : checkIcon; sel: seasonDone; tint: green }
                }
              }
            }
            Column {
              gap: 0
              for e, i in (allEps ? episodes : episodes.take(30)) key e.number {
                EpisodeRow { e: e; done: isDone[i] }
              }
            }
            if !allEps && len(episodes) > 30 {
              Box {
                onTap: allEps = true
                Pill { text: "Show all ${len(episodes)} episodes"; pic: tvIcon }
              }
            }
          }

          if len(facts) > 0 {
            Grid {
              columns: 3
              gap: 8
              for f in facts key f.k {
                Column {
                  gap: 2
                  padding: [10, 8]
                  background: alpha(foreground, 0.05)
                  radius: 8 * corners
                  Text { text: f.k; fontSize: 11; color: muted; maxLines: 1 }
                  Text { text: f.v; style: small; bold: true; maxLines: 2 }
                }
              }
            }
          }

          if len(cast) > 0 {
            Head { text: "Cast" }
            Grid {
              columns: 4
              gap: 8
              for c in cast key c.person.ids.trakt {
                let hs = first(c.person.images.headshot ?? [])
                Column {
                  gap: 2
                  align: center
                  onTap: url("https://trakt.tv/people/${c.person.ids.slug}")
                  Box {
                    width: 64
                    height: 64
                    radius: 32
                    clip: true
                    background: surface
                    align: center
                    if hs != null {
                      Image { src: "https://media.trakt.tv/${replace(replace(hs, "media.trakt.tv/", ""), "/medium/", "/thumb/")}"; width: 64; height: 64; fit: cover }
                    } else {
                      Image { src: personIcon; size: 34; tint: muted }
                    }
                  }
                  Text { text: c.person.name ?? ""; fontSize: 11; bold: true; align: center; maxLines: 2 }
                  Text { text: join(c.characters ?? [c.character ?? ""], " / "); fontSize: 10; color: muted; align: center; maxLines: 1 }
                }
              }
            }
          }

          if len(related) > 0 {
            Head { text: "More like this" }
            Grid {
              columns: 3
              gap: 10
              for r in related key r.m.ids.trakt {
                PosterCard { it: r }
              }
            }
          }
          Text { text: "Data and images from Trakt."; fontSize: 11; color: muted; align: center; onTap: url(siteUrl) }
        }

      } else {
        // ---------------------------------------------------------------- the top bar
        if view == "search" {
          Row {
            gap: 10
            align: center
            padding: [14, 2]
            border: 1
            borderColor: alpha(accent, 0.8)
            radius: 22 * corners
            Image { src: searchIcon; size: 20; tint: muted }
            Input { text: typed; placeholder: "movies and shows"; focus: true; weight: 1; onChange: typed = value; onSubmit: typed = value }
            if typed != "" {
              Text { text: "✕"; color: muted; width: 28; align: center; onTap: typed = "" }
            }
          }
        } else {
          Row {
            gap: 6
            align: center
            Row {
              weight: 1
              gap: 10
              align: center
              padding: [14, 11]
              background: alpha(foreground, 0.06)
              radius: 22 * corners
              onTap: { view = "search"; typed = "" }
              Image { src: searchIcon; size: 20; tint: muted }
              Text { text: "search movies and shows"; color: muted; maxLines: 1; weight: 1 }
            }
            if signedIn {
              Box {
                width: 42
                height: 42
                align: center
                onTap: { view = "history"; hpage = 1 }
                Image { src: historyIcon; size: 24; tint: view == "history" ? accent : foreground }
              }
            }
            Box {
              width: 42
              height: 42
              align: center
              onTap: { view = "settings"; confirmOut = false; ownApp = myId != ""; idIn = myId; secretIn = mySecret }
              if avatar != null {
                Box {
                  width: 32
                  height: 32
                  radius: 16
                  clip: true
                  border: view == "settings" ? 2 : 0
                  borderColor: accent
                  Image { src: avatar; width: 32; height: 32; fit: cover }
                }
              } else {
                Image { src: settingsIcon; size: 24; tint: view == "settings" ? accent : foreground }
              }
            }
          }
        }

        if view == "search" {
          // ---------------------------------------------------------------- search
          Row {
            gap: 6
            for f in [{k: "movie,show", l: "all"}, {k: "movie", l: "movies"}, {k: "show", l: "shows"}] key f.k {
              Box {
                onTap: sfilter = f.k
                Chip { text: f.l; sel: sfilter == f.k }
              }
            }
          }
          if len(squery) >= 2 {
            Trouble { res: found }
            Text { text: found == null ? "Searching…" : "${len(results)} results"; style: small; color: muted }
            if found != null && found.ok && len(results) == 0 {
              Empty { pic: searchIcon; text: "Nothing matches “${squery}”"; detail: "Try fewer words, or the original title." }
            }
            Grid {
              columns: 3
              gap: 10
              for r in results key "${r.t}${r.m.ids.trakt}" {
                PosterCard { it: r }
              }
            }
          } else {
            Text { text: len(suggestions) > 0 ? "Trending now" : ""; style: small; color: muted }
            Grid {
              columns: 3
              gap: 10
              for r in suggestions key "${r.t}${r.m.ids.trakt}" {
                PosterCard { it: r }
              }
            }
          }

        } else if view == "history" {
          // ---------------------------------------------------------------- history
          Trouble { res: his }
          if his == null {
            Text { text: "Loading…"; color: muted; align: center; padding: [0, 24] }
          } else if his.ok && len(hrows) == 0 {
            Empty { pic: historyIcon; text: hpage > 1 ? "That's everything" : "Nothing watched yet"; detail: "Movies and episodes you mark watched appear here." }
          }
          for d in hdays key d {
            let rows = hrows.filter(c => fmtTime(c.t, "yyyy-MM-dd") == d)
            let t0 = rows[0].t
            Text { text: d == today ? "Today" : d == fmtTime(now - 86400, "yyyy-MM-dd") ? "Yesterday" : now - t0 < 6 * 86400 ? fmtTime(t0, "EEEE") : fmtTime(t0, "EEE, MMM d, yyyy"); bold: true; padding: [0, 8, 0, 0] }
            for c in rows key c.r.id {
              DayRow { r: c.r; lead: fmtTime(c.t, "HH:mm") }
            }
          }
          if his != null && his.ok && (hpage > 1 || len(his.out) >= 25) {
            Row {
              gap: 8
              align: center
              Text { text: "‹ newer"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: hpage > 1 ? 1 : 0.35; onTap: hpage = max(1, hpage - 1) }
              Text { text: "page ${hpage}"; style: small; color: muted; weight: 1; align: center }
              Text { text: "older ›"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: len(his.out) >= 25 ? 1 : 0.35; onTap: hpage = len(his.out) >= 25 ? hpage + 1 : hpage }
            }
          }

        } else if view == "settings" {
          // ---------------------------------------------------------------- settings
          Column {
            gap: 12
            padding: [16, 14]
            border: 1
            borderColor: alpha(muted, 0.3)
            radius: 12 * corners
            if signedIn {
              Row {
                gap: 14
                align: center
                Box {
                  width: 56
                  height: 56
                  radius: 28
                  clip: true
                  background: surface
                  align: center
                  if avatar != null {
                    Image { src: avatar; width: 56; height: 56; fit: cover }
                  } else {
                    Image { src: personIcon; size: 32; tint: muted }
                  }
                }
                Column {
                  gap: 2
                  weight: 1
                  Text { text: user == null ? "Signed in" : user.name ?? user.username; bold: true; fontSize: 17; maxLines: 1 }
                  Text { text: user == null ? "" : "@${user.username}${user.vip ? "  ·  VIP" : ""}"; style: small; color: muted; maxLines: 1 }
                }
              }
              if stats != null && stats.ok {
                Row {
                  gap: 8
                  for s in [{v: stats.out.movies.watched, l: "movies"}, {v: stats.out.episodes.watched, l: "episodes"}, {v: round((num(stats.out.movies.minutes, 0) + num(stats.out.episodes.minutes, 0)) / 60), l: "hours"}] key s.l {
                    Column {
                      weight: 1
                      gap: 0
                      padding: [10, 8]
                      background: alpha(foreground, 0.05)
                      radius: 8 * corners
                      Text { text: "${s.v ?? 0}"; bold: true; fontSize: 17; maxLines: 1 }
                      Text { text: s.l; fontSize: 11; color: muted }
                    }
                  }
                }
              }
              Flow {
                gap: 8
                if user != null {
                  Box {
                    onTap: url("https://trakt.tv/users/${user.ids.slug}")
                    Pill { text: "Profile on Trakt"; pic: openIcon }
                  }
                }
                Box {
                  onTap: { outRes = 0; outRes = post(confirmOut ? "https://api.trakt.tv/oauth/revoke" : null, {token: auth.access, client_id: cid, client_secret: csec}, {"trakt-api-key": cid, "trakt-api-version": "2"}); note = confirmOut ? "Signed out" : note; noteUntil = confirmOut ? tick + 3 : noteUntil; auth = confirmOut ? null : auth; stack = []; confirmOut = !confirmOut }
                  Pill { text: confirmOut ? "Tap again to sign out" : "Sign out"; pic: logoutIcon; sel: confirmOut; tint: red }
                }
              }
            } else if dev == null {
              Text { text: "Sign in with Trakt"; bold: true; fontSize: 17 }
              Text { text: "Your watchlist, up next, calendar, history and ratings, kept in step with every other Trakt app you use."; style: small; color: muted }
              if authMsg != "" {
                Text { text: authMsg; style: small; color: red }
              }
              Box {
                onTap: { authMsg = ""; codeRes = 0; codeRes = post(asking ? null : "https://api.trakt.tv/oauth/device/code", {client_id: cid}, {"trakt-api-key": cid, "trakt-api-version": "2"}); asking = true }
                Pill { text: asking ? "Getting a code…" : authMsg != "" ? "Try again" : "Sign in"; pic: loginIcon; sel: true }
              }
            } else {
              Text { text: "On any phone or computer, go to ${replace(dev.url, "https://", "")} and enter this code:"; style: small }
              Text { text: dev.user; fontSize: 30; bold: true; font: mono; align: center; padding: [0, 12]; border: 2; borderColor: accent; radius: 10 * corners; color: accent }
              Flow {
                gap: 8
                Box {
                  onTap: url(dev.url)
                  Pill { text: "Open ${replace(dev.url, "https://", "")}"; pic: openIcon; sel: true }
                }
                Box {
                  onTap: { copy(dev.user); note = "Code copied"; noteUntil = tick + 2 }
                  Pill { text: "Copy code"; pic: copyIcon }
                }
                Box {
                  onTap: { dev = null; authMsg = "" }
                  Pill { text: "Cancel"; pic: logoutIcon }
                }
              }
              Text { text: "Waiting for you to approve  ·  code valid for ${floor(max(0, dev.until - tick) / 60)}:${pad(max(0, dev.until - tick) % 60, 2, "0")}"; style: small; color: muted }
            }
          }

          Head { text: "Spoilers" }
          Text { text: "Hide the titles and stories of episodes you haven't watched yet."; style: small; color: muted }
          Row {
            gap: 6
            Box {
              onTap: hideSpoilers = false
              Pill { text: "Show"; pic: eyeIcon; sel: !hideSpoilers }
            }
            Box {
              onTap: hideSpoilers = true
              Pill { text: "Hide"; pic: eyeOffIcon; sel: hideSpoilers }
            }
          }

          Head { text: "Trakt app" }
          Text { text: "Optional. Couch signs in as its own Trakt app. To use one of yours, create it at trakt.tv/oauth/applications with the redirect URI urn:ietf:wg:oauth:2.0:oob and paste its client ID and secret here. Changing this signs you out."; style: small; color: muted }
          if !ownApp {
            Box {
              onTap: ownApp = true
              Pill { text: "Use my own app"; pic: settingsIcon }
            }
          } else {
            Text { text: "Client ID"; style: small; color: muted }
            Input { text: idIn; placeholder: "from your app's page on trakt.tv"; onChange: idIn = value }
            Text { text: "Client secret"; style: small; color: muted }
            Input { text: secretIn; placeholder: "from your app's page on trakt.tv"; onChange: secretIn = value }
            let valid = (trim(idIn) == "") == (trim(secretIn) == "") && (trim(idIn) == "" || len(match(trim(idIn), '^[A-Za-z0-9_-]{20,128}$') ?? []) > 0)
            Row {
              gap: 8
              Box {
                onTap: { auth = valid && trim(idIn) != myId ? null : auth; note = !valid ? "That client ID doesn't look right" : trim(idIn) == "" ? "Using the built-in Trakt app" : "Using your Trakt app"; noteUntil = tick + 3; myId = valid ? trim(idIn) : myId; mySecret = valid ? trim(secretIn) : mySecret; ownApp = valid ? myId != "" : ownApp }
                Pill { text: "Save"; pic: checkIcon; sel: true }
              }
              Box {
                onTap: { idIn = ""; secretIn = "" }
                Pill { text: "Use the built-in app"; pic: logoutIcon }
              }
            }
          }

          Head { text: "About" }
          Text { text: "Couch for Trakt 1.0. Movie and show data and images from Trakt (trakt.tv). Couch is an independent app and not affiliated with or endorsed by Trakt."; style: small; color: muted }
          Row {
            gap: 8
            Box {
              onTap: url("https://trakt.tv")
              Pill { text: "trakt.tv"; pic: openIcon }
            }
            Box {
              onTap: url("https://github.com/SimonSchubert/omarchy-couch")
              Pill { text: "Source"; pic: openIcon }
            }
          }

        } else if tab == "discover" {
          // ---------------------------------------------------------------- discover
          if heroAt != null {
            let hm = heroAt.m
            let hh = round((sw - 32) * 0.56)
            Box {
              width: sw - 32
              height: hh
              radius: 12 * corners
              clip: true
              onTap: { stack = [{t: heroAt.t, id: hm.ids.trakt, m: hm}] + stack; season = -1; allEps = false; more = false; unconf = false }
              // Every slide's backdrop, stacked: all loaded at once, so each fades in ready.
              for h, i in heroes key i {
                Box {
                  opacity: i == hero % len(heroes) ? 1 : 0
                  animate opacity: tween(500ms, "ease")
                  Pic { path: first(h.m.images.fanart ?? []); w: sw - 32; h: hh; r: 12; thumb: false }
                }
              }
              Canvas {
                width: sw - 32
                height: hh
                rect(0, 0, width, height, fill: linear(0, 0, 0, height, [alpha(#000000, 0), alpha(#000000, 0.1), alpha(#000000, 0.55), alpha(#000000, 0.9)]))
              }
              Column {
                width: sw - 32
                height: hh
                padding: [14, 12]
                gap: 3
                Spacer { weight: 1 }
                Text { text: "#${hero % max(1, len(heroes)) + 1}${heroAt.stat == null ? "" : "  ·  " + (heroAt.stat >= 1000 ? "${round(heroAt.stat / 1000, 1)}K" : "${heroAt.stat}") + (dsec2 == "anticipated" ? " lists" : " watching")}"; fontSize: 11; bold: true; color: #ffffff; opacity: 0.85 }
                Text { text: hm.title ?? ""; fontSize: 22; bold: true; color: #ffffff; maxLines: 2 }
                Row {
                  gap: 6
                  align: center
                  Text { text: join(["${hm.year ?? ""}", num(hm.runtime, 0) <= 0 ? "" : hm.runtime >= 60 ? "${floor(hm.runtime / 60)}h ${hm.runtime % 60}m" : "${hm.runtime}m", hm.certification ?? ""].filter(s => s != ""), "  ·  "); style: small; color: #ffffff; opacity: 0.8; weight: 1; maxLines: 1 }
                  if num(hm.rating, 0) > 0 {
                    Image { src: heartIcon; size: 14; tint: red }
                    Text { text: "${round(hm.rating * 10)}%"; style: small; bold: true; color: #ffffff; width: 36 }
                  }
                }
                Row {
                  gap: 5
                  for h, i in heroes key i {
                    Box { width: i == hero % len(heroes) ? 18 : 6; height: 6; radius: 3; background: alpha(#ffffff, i == hero % len(heroes) ? 0.95 : 0.45); onTap: hero = i }
                  }
                }
              }
            }
          }
          Row {
            gap: 6
            for t in [{k: "movie", l: "movies"}, {k: "show", l: "shows"}] key t.k {
              Box {
                onTap: { dtype = t.k; dpage = 1; hero = 0 }
                Chip { text: t.l; sel: dtype == t.k }
              }
            }
          }
          Flow {
            gap: 6
            for s in sections key s.k {
              Box {
                onTap: { dsec = s.k; dpage = 1; hero = 0 }
                Chip { text: s.l; sel: dsec2 == s.k }
              }
            }
          }
          Text { text: (sections.find(s => s.k == dsec2) ?? {n: ""}).n; style: small; color: muted }
          Trouble { res: disc }
          if disc == null {
            Text { text: "Loading…"; color: muted; align: center; padding: [0, 24] }
          }
          Grid {
            columns: 3
            gap: 10
            for it, i in ditems key "${it.t}${it.m.ids.trakt}" {
              PosterCard { it: it; badge: dsec2 == "trending" || dsec2 == "anticipated" || dsec2 == "watched" ? (it.stat == null ? "" : it.stat >= 1000 ? "${round(it.stat / 1000, 1)}K" : "${it.stat}") : dsec2 == "boxoffice" ? (it.rev == null ? "" : "$${round(it.rev / 1000000)}M") : "#${(dpage - 1) * 24 + i + 1}" }
            }
          }
          if dsec2 != "boxoffice" && disc != null && disc.ok {
            Row {
              gap: 8
              align: center
              Text { text: "‹ prev"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: dpage > 1 ? 1 : 0.35; onTap: { dpage = max(1, dpage - 1); hero = 0 } }
              Text { text: "page ${dpage}"; style: small; color: muted; weight: 1; align: center }
              Text { text: "next ›"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: len(ditems) >= 24 && dpage < 10 ? 1 : 0.35; onTap: { dpage = len(ditems) >= 24 && dpage < 10 ? dpage + 1 : dpage; hero = 0 } }
            }
          }

        } else if tab == "upnext" {
          // ---------------------------------------------------------------- up next
          if !signedIn {
            SignIn { text: "See what's next in every show you watch" }
          } else {
            Trouble { res: up }
            if up == null {
              Text { text: "Loading…"; color: muted; align: center; padding: [0, 24] }
            } else if up.ok && len(ups) == 0 {
              Empty { pic: upnextIcon; text: upage > 1 ? "That's everything" : "You're all caught up"; detail: "Shows you are watching appear here with their next episode." }
            }
            for r in ups key r.show.ids.trakt {
              let nx = r.progress.next_episode
              let ticked = indexOf(doneOver, nx.ids.trakt) >= 0
              let shot = first(nx.images.screenshot ?? []) ?? first(r.show.images.fanart ?? [])
              Row {
                gap: 12
                align: center
                padding: [10, 10]
                background: alpha(foreground, 0.05)
                radius: 10 * corners
                onTap: { stack = [{t: "show", id: r.show.ids.trakt, m: r.show}] + stack; season = nx.season; allEps = false; more = false; unconf = false }
                Pic { path: hideSpoilers ? first(r.show.images.fanart ?? []) : shot; w: 112; h: 63; r: 6; dim: ticked }
                Column {
                  gap: 3
                  weight: 1
                  Text { text: r.show.title ?? ""; bold: true; maxLines: 1 }
                  Text { text: "S${pad(nx.season, 2, "0")}E${pad(nx.number, 2, "0")}${hideSpoilers || nx.title == null ? "" : "  ·  " + nx.title}"; style: small; maxLines: 1 }
                  Progress { value: num(r.progress.completed, 0) + (ticked ? 1 : 0); max: max(1, num(r.progress.aired, 1)); color: accent; height: 4 }
                  Text { text: "${num(r.progress.completed, 0) + (ticked ? 1 : 0)} of ${r.progress.aired}  ·  ${max(0, num(r.progress.aired, 0) - num(r.progress.completed, 0) - (ticked ? 1 : 0))} left"; fontSize: 11; color: muted; maxLines: 1 }
                }
                Box {
                  width: 44
                  height: 44
                  align: center
                  onTap: { upRes = 0; upRes = post(ticked ? null : "https://api.trakt.tv/sync/history", {episodes: [{ids: {trakt: nx.ids.trakt}}]}, hdr); doneOver = ticked ? doneOver : doneOver + [nx.ids.trakt]; note = ticked ? note : "Marked ${r.show.title} S${pad(nx.season, 2, "0")}E${pad(nx.number, 2, "0")} watched"; noteUntil = ticked ? noteUntil : tick + 3; haptic() }
                  Image { src: ticked ? doneIcon : checkIcon; size: ticked ? 34 : 26; tint: ticked ? green : muted; padding: ticked ? 0 : 4; border: ticked ? 0 : 2; borderColor: alpha(muted, 0.6); radius: 20 }
                }
              }
            }
            if up != null && up.ok && (upage > 1 || len(up.out) >= 20) {
              Row {
                gap: 8
                align: center
                Text { text: "‹ prev"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: upage > 1 ? 1 : 0.35; onTap: upage = max(1, upage - 1) }
                Text { text: "page ${upage}"; style: small; color: muted; weight: 1; align: center }
                Text { text: "next ›"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: len(up.out) >= 20 ? 1 : 0.35; onTap: upage = len(up.out) >= 20 ? upage + 1 : upage }
              }
            }
          }

        } else if tab == "calendar" {
          // ---------------------------------------------------------------- calendar
          Flow {
            gap: 6
            for c in cmodes key c.k {
              Box {
                onTap: cmode = c.k
                Chip { text: c.l; sel: cm == c.k }
              }
            }
          }
          if !signedIn {
            Row {
              gap: 10
              align: center
              padding: [14, 10]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Text { text: "Sign in to see when the shows you watch air next."; style: small; weight: 1 }
              Box {
                onTap: { view = "settings"; asking = true; authMsg = ""; codeRes = 0; codeRes = post("https://api.trakt.tv/oauth/device/code", {client_id: cid}, {"trakt-api-key": cid, "trakt-api-version": "2"}) }
                Pill { text: "Sign in"; pic: loginIcon; sel: true }
              }
            }
          }
          Trouble { res: cal }
          if cal == null {
            Text { text: "Loading…"; color: muted; align: center; padding: [0, 24] }
          } else if cal.ok && len(crows) == 0 {
            Empty { pic: calendarIcon; text: cm == "shows" ? "Nothing airing in the next two weeks" : cm == "movies" ? "No releases for your movies in the next two months" : "Nothing scheduled"; detail: cm == "shows" || cm == "movies" ? "Add shows and movies to your watchlist, or watch an episode, and their dates show up here." : "" }
          }
          let ranked = range(len(crows)).map(i => {c: crows[i], i: i, d: fmtTime(crows[i].t, "yyyy-MM-dd")})
          for d in cdays key d {
            let rows = ranked.filter(x => x.d == d)
            let t0 = rows[0].c.t
            Text { text: d == today ? "Today" : d == fmtTime(now + 86400, "yyyy-MM-dd") ? "Tomorrow" : d == fmtTime(now - 86400, "yyyy-MM-dd") ? "Yesterday" : t0 - now < 6 * 86400 && t0 > now ? fmtTime(t0, "EEEE") : fmtTime(t0, "EEE, MMM d"); bold: true; color: d < today ? muted : foreground; padding: [0, 8, 0, 0] }
            for x in rows key "${x.i}" {
              DayRow { r: x.c.r; pic: x.i < 24; lead: x.c.movie ? "" : fmtTime(x.c.t, "HH:mm"); dim: d < today }
            }
          }

        } else {
          // ---------------------------------------------------------------- watchlist
          if !signedIn {
            SignIn { text: "Keep a watchlist across all your devices" }
          } else {
            Row {
              gap: 6
              for t in [{k: "movie", l: "movies"}, {k: "show", l: "shows"}] key t.k {
                Box {
                  onTap: { wtype = t.k; wpage = 0 }
                  Chip { text: t.l; sel: wtype == t.k }
                }
              }
            }
            Flow {
              gap: 6
              for s in [{k: "added", l: "recently added"}, {k: "released", l: "newest"}, {k: "rating", l: "top rated"}, {k: "title", l: "A–Z"}] key s.k {
                Box {
                  onTap: { wsort = s.k; wpage = 0 }
                  Chip { text: s.l; sel: wsort == s.k }
                }
              }
            }
            Trouble { res: wtype == "show" ? wlS : wlM }
            if (wtype == "show" ? wlS : wlM) == null {
              Text { text: "Loading…"; color: muted; align: center; padding: [0, 24] }
            } else if len(wlist) == 0 {
              Empty { pic: watchlistIcon; text: "Your watchlist is empty"; detail: "Tap Watchlist on any movie or show to save it for later." }
            } else {
              Text { text: "${len(wlist)} ${wtype == "show" ? (len(wlist) == 1 ? "show" : "shows") : (len(wlist) == 1 ? "movie" : "movies")}"; style: small; color: muted }
            }
            Grid {
              columns: 3
              gap: 10
              for it in wlist.drop(wpage * 24).take(24) key "${it.t}${it.m.ids.trakt}" {
                PosterCard { it: it; badge: wtype == "movie" && it.m.released != null && it.m.released > nowIso ? "Out ${months[num(sub(it.m.released, 5, 7)) - 1]} ${num(sub(it.m.released, 8, 10))}" : "" }
              }
            }
            if wpages > 1 {
              Row {
                gap: 8
                align: center
                Text { text: "‹ prev"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: wpage > 0 ? 1 : 0.35; onTap: wpage = max(0, wpage - 1) }
                Text { text: "${wpage * 24 + 1}–${min(len(wlist), wpage * 24 + 24)} of ${len(wlist)}"; style: small; color: muted; weight: 1; align: center }
                Text { text: "next ›"; style: small; align: center; padding: [12, 6]; border: 1; borderColor: alpha(muted, 0.4); radius: 14 * corners; width: 90; opacity: wpage < wpages - 1 ? 1 : 0.35; onTap: wpage = min(wpages - 1, wpage + 1) }
              }
            }
          }
        }
      }
    }

    if note != "" {
      Text { text: note; style: small; color: background; background: foreground; padding: [16, 10]; maxLines: 2 }
    }
    if open == null {
      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "discover"; text: "discover"; pic: discoverIcon }
        Tab { name: "upnext"; text: "up next"; pic: upnextIcon }
        Tab { name: "calendar"; text: "calendar"; pic: calendarIcon }
        Tab { name: "watchlist"; text: "watchlist"; pic: watchlistIcon }
      }
    }
  }
}
