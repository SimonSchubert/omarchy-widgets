app "ifsc" {
  meta {
    owl: 8
    description: "The World Climbing Series on one screen: the next event, results from every stop, and the boulder, lead and speed cup."
    version: "2.1"
    license: "MIT"
    category: "sport"
  }
  // The window's title names the event that's open; Back goes to where it was opened from.
  title: view == "event" && shownEvent != null ? shownEvent.name : "IFSC"
  back: view == "event"
  onBack: view = from
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <path d="M36 200l58-104 34 50 22-28 70 82z" fill="#9ECE6A"/>
    <path d="M94 96l20 30-10-6-10 10-10-10-7 6z" fill="#E6F4D4"/>
    <rect x="88" y="44" width="10" height="56" rx="5" fill="#C0CAF5"/>
    <path d="M93 46h50l-12 16 12 16H93z" fill="#F7768E"/>
  </svg>"""

  // The bottom bar's icons, Material's terrain, calendar today and emoji events (Apache 2.0).
  asset nowIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE0IDZsLTMuNzUgNSAyLjg1IDMuOC0xLjYgMS4yQzkuODEgMTMuNzUgNyAxMCA3IDEwbC02IDhoMjJMMTQgNnoiLz48L3N2Zz4K"
  asset eventsIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTIwIDNoLTFWMWgtMnYySDdWMUg1djJINGMtMS4xIDAtMiAuOS0yIDJ2MTZjMCAxLjEuOSAyIDIgMmgxNmMxLjEgMCAyLS45IDItMlY1YzAtMS4xLS45LTItMi0yem0wIDE4SDRWOGgxNnYxM3oiLz48L3N2Zz4K"
  asset cupIcon = base64""

  // Everything comes from ifsc.results.info, which answers only with this Referer, straight from Android:
  // the season, its calendar, the results of the event on show, and the cup ranking on show.
  let API = "https://ifsc.results.info"
  let H = {Referer: "https://ifsc.results.info/"}

  source now = clock every 30s
  source season = http("https://ifsc.results.info/api/v1/", {Referer: "https://ifsc.results.info/"}) every 24h json timeout 15s status

  state view = "now" persist
  state from = "now"
  state eventId = 0
  state catId = 0
  state rankKey = "boulder men" persist
  state openId = 0

  // The last of everything that loaded, so a start shows it at once and the app works offline.
  state savedLeague = "" persist
  state savedSeason = "" persist
  state savedEvents = [] persist
  state savedBlocks = [] persist
  state savedRanks = [] persist
  state savedAt = 0 persist

  let seasonData = season != null && season.ok ? season.out.current : null
  let leagueUrl = seasonData == null ? savedLeague : (seasonData.leagues.find(l => l.league_id == 1).url ?? savedLeague)
  // The World Cup's calendar; its address comes with the season, or from the last run until the season loads.
  source league = http(leagueUrl == "" ? null : "${API}${leagueUrl}", H) every 10m json timeout 20s status
  let lg = league != null && league.ok ? league.out : null
  let offline = league != null && !league.ok

  let KINDS = ["boulder", "lead", "speed", "combined", "relay", "other"]
  let GENDERS = ["men", "women", "mixed", ""]
  let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let STAMP = '^(\d+)-(\d+)-(\d+) (\d+):(\d+):(\d+)'
  let DAY = '^(\d+)-(\d+)-(\d+)'

  // The calendar, trimmed to what the views show. Times are Unix seconds, from "2026-04-30 16:00:00 UTC".
  let parsed = (lg.events ?? []).map(e => [match(e.starts_at, STAMP).map(x => num(x)), match(e.ends_at, STAMP).map(x => num(x)), match(e.local_start_date, DAY).map(x => num(x)), match(e.local_end_date, DAY).map(x => num(x)), e])
  let fresh = lg == null ? null : parsed.map(q => {
    id: q[4].event_id,
    full: q[4].event,
    name: trim(match(replace(replace(replace(q[4].event, "World Climbing Series ", ""), "IFSC Climbing World Cup ", ""), "IFSC World Cup ", ""), '^(.*?)(?: \d{4})?$')[0]),
    start: [q[0]].map(p => (365 * (p[1] <= 2 ? p[0] - 1 : p[0]) + floor((p[1] <= 2 ? p[0] - 1 : p[0]) / 4) - floor((p[1] <= 2 ? p[0] - 1 : p[0]) / 100) + floor((p[1] <= 2 ? p[0] - 1 : p[0]) / 400) + floor((153 * (p[1] <= 2 ? p[1] + 9 : p[1] - 3) + 2) / 5) + p[2] - 719469) * 86400 + p[3] * 3600 + p[4] * 60 + p[5])[0],
    end: [q[1]].map(p => (365 * (p[1] <= 2 ? p[0] - 1 : p[0]) + floor((p[1] <= 2 ? p[0] - 1 : p[0]) / 4) - floor((p[1] <= 2 ? p[0] - 1 : p[0]) / 100) + floor((p[1] <= 2 ? p[0] - 1 : p[0]) / 400) + floor((153 * (p[1] <= 2 ? p[1] + 9 : p[1] - 3) + 2) / 5) + p[2] - 719469) * 86400 + p[3] * 3600 + p[4] * 60 + p[5])[0],
    dates: q[2][1] == q[3][1] ? (q[2][2] == q[3][2] ? "${q[2][2]} ${MONTHS[q[2][1] - 1]}" : "${q[2][2]}–${q[3][2]} ${MONTHS[q[2][1] - 1]}") : "${q[2][2]} ${MONTHS[q[2][1] - 1]} – ${q[3][2]} ${MONTHS[q[3][1] - 1]}",
    cats: (q[4].d_cats ?? []).map(c => {
      id: c.id,
      name: c.name,
      kind: contains(upper(c.name), "RELAY") ? "relay" : contains(c.name, "&") || startsWith(upper(c.name), "COMBINED") ? "combined" : startsWith(upper(c.name), "BOULDER") ? "boulder" : startsWith(upper(c.name), "LEAD") ? "lead" : startsWith(upper(c.name), "SPEED") ? "speed" : "other",
      gender: endsWith(c.name, "Women") ? "women" : endsWith(c.name, "Men") ? "men" : endsWith(c.name, "Mixed") ? "mixed" : "",
      status: c.status ?? "",
      url: c.result_url
    }).sortBy(c => indexOf(KINDS, c.kind) * 10 + indexOf(GENDERS, c.gender))
  }).sortBy(e => e.start)
  when fresh != null && fresh != savedEvents { savedEvents = fresh }
  // When the calendar last answered, for "offline · saved …".
  when league != null && league.ok && now != null && now - savedAt >= 60 { savedAt = now }
  when leagueUrl != "" && leagueUrl != savedLeague { savedLeague = leagueUrl }
  when seasonData != null && "${seasonData.season}" != savedSeason { savedSeason = "${seasonData.season}" }

  // Each event as it stands now: live, next or done.
  let events = (fresh ?? savedEvents).map(e => {
    id: e.id, full: e.full, name: e.name, start: e.start, end: e.end, dates: e.dates, cats: e.cats,
    kinds: unique(e.cats.map(c => c.kind)),
    state: now == null || now < e.start ? "next" : now >= e.end || (len(e.cats) > 0 && all(e.cats, c => c.status == "finished")) ? "done" : "live"
  })
  let liveEv = events.find(e => e.state == "live")
  let upcoming = events.find(e => e.state == "next")
  let past = events.filter(e => e.state == "done")
  let latest = len(past) > 0 ? last(past) : null
  let hero = liveEv ?? upcoming ?? latest
  let later = hero == null ? null : first(events.filter(e => e.state == "next" && e.id != hero.id))
  let secs = hero == null || now == null ? null : hero.start - now
  let countdown = secs == null ? "" : secs >= 172800 ? "${floor(secs / 86400)}d" : secs >= 86400 ? "1d ${floor((secs % 86400) / 3600)}h" : secs > 0 ? fmtDuration(secs) : "now"

  // The event whose results load: the one open, else the live one, else the last one.
  let shownEvent = events.find(e => e.id == eventId) ?? hero
  let focus = view == "event" ? shownEvent : (liveEv ?? latest)
  let todo = focus == null || focus.state == "next" ? [] : focus.cats.filter(c => c.url != null && c.status != "pending" && c.status != "registration_pending").take(6)
  // The event on show: one source per category, up to six; a category without results yet asks for nothing.
  source r0 = http(len(todo) > 0 ? "${API}${todo[0].url}" : null, H) every 3m json timeout 20s status
  source r1 = http(len(todo) > 1 ? "${API}${todo[1].url}" : null, H) every 3m json timeout 20s status
  source r2 = http(len(todo) > 2 ? "${API}${todo[2].url}" : null, H) every 3m json timeout 20s status
  source r3 = http(len(todo) > 3 ? "${API}${todo[3].url}" : null, H) every 3m json timeout 20s status
  source r4 = http(len(todo) > 4 ? "${API}${todo[4].url}" : null, H) every 3m json timeout 20s status
  source r5 = http(len(todo) > 5 ? "${API}${todo[5].url}" : null, H) every 3m json timeout 20s status
  let got = [r0, r1, r2, r3, r4, r5].filter(r => r != null && r.ok)
  // Each category with its response, matched by their names, so a response for the event shown before never lands here.
  let matched = focus == null ? [] : todo.map(c => [c, got.find(r => r.out.event == focus.full && r.out.dcat == c.name)]).filter(t => t[1] != null)
  // Some still on their way; once all have answered, an empty event just has no results yet.
  let failed = any([r0, r1, r2, r3, r4, r5].take(len(todo)), r => r != null && !r.ok)
  let pending = len(matched) < len(todo) && !failed
  // A category's top 8.
  let block = focus == null ? null : {id: focus.id, cats: matched.map(t => {
    id: t[0].id,
    kind: t[0].kind,
    label: trim("${t[0].kind} ${t[0].gender}"),
    round: lower(last((t[1].out.category_rounds ?? []).filter(r => r.status != null && r.status != "pending")).name ?? ""),
    top: (t[1].out.ranking ?? []).take(8).map(a => {
      key: "${a.rank}-${a.athlete_id ?? a.name}",
      rank: a.rank,
      name: a.firstname != null && a.lastname != null ? "${a.firstname} ${join(words(lower(a.lastname)).map(w => join(split(w, "-").map(v => startsWith(v, "mc") && len(v) > 2 ? "Mc" + upper(sub(v, 2, 3)) + sub(v, 3, len(v)) : upper(sub(v, 0, 1)) + sub(v, 1, len(v))), "-")), " ")}" : a.name ?? "",
      country: a.country ?? "",
      flag: a.flag_url ?? "",
      score: [split(str(last((a.rounds ?? []).filter(r => r.score != null && r.score != "")).score ?? ""), " (")[0]].map(s => upper(s) == "FALSE START" ? "FS" : s)[0]
    })
  }).filter(b => len(b.top) > 0)}
  when block != null && len(block.cats) > 0 && block != savedBlocks.find(b => b.id == block.id) {
    savedBlocks = savedBlocks.filter(b => b.id != block.id) + [block]
  }
  let blocks = savedBlocks

  // The cup: the ranking on show, top 12 with where their points came from.
  let cupCats = ((lg.cups ?? [])[0]).d_cats ?? []
  let rankUrl = cupCats.find(c => lower(c.name) == rankKey).ranking_url
  source ranking = http(rankUrl == null ? null : "${API}${rankUrl}", H) every 10m json timeout 20s status
  let freshRank = ranking == null || !ranking.ok || lower(ranking.out.dcat_name ?? "") != rankKey ? null : {
    key: rankKey,
    top: (ranking.out.ranking ?? []).take(12).map(a => {
      id: a.athlete_id ?? 0,
      key: "${a.rank}-${a.athlete_id}",
      rank: a.rank,
      name: a.firstname != null && a.lastname != null ? "${a.firstname} ${join(words(lower(a.lastname)).map(w => join(split(w, "-").map(v => startsWith(v, "mc") && len(v) > 2 ? "Mc" + upper(sub(v, 2, 3)) + sub(v, 3, len(v)) : upper(sub(v, 0, 1)) + sub(v, 1, len(v))), "-")), " ")}" : a.name ?? "",
      country: a.country ?? "",
      flag: a.country == null ? "" : "https://d1n1qj9geboqnb.cloudfront.net/flags/${a.country}.png",
      score: "${round(num(a.score, 0))}",
      events: (a.events ?? []).filter(s => s.included != false).sortBy(s => -num(s.points, 0)).take(6).map(s => {
        event: trim(match(replace(replace(s.event_name ?? "", "World Climbing Series ", ""), "IFSC Climbing World Cup ", ""), '^(.*?)(?: \d{4})?$')[0]),
        place: s.rank,
        points: "${round(num(s.points, 0))}"
      })
    })
  }
  when freshRank != null && freshRank != savedRanks.find(r => r.key == freshRank.key) {
    savedRanks = savedRanks.filter(r => r.key != freshRank.key) + [freshRank]
  }
  let RANKS = ["boulder men", "boulder women", "lead men", "lead women", "speed men", "speed women"]
  let cup = savedRanks.find(r => r.key == rankKey)

  component Chip(kind) {
    Text {
      text: kind
      style: label
      align: center
      width: len(kind) * 8 + 14
      maxLines: 1
      padding: [0, 2]
      radius: 3 * corners
      color: kind == "boulder" ? yellow : kind == "lead" ? blue : kind == "speed" ? red : kind == "relay" ? cyan : accent
      border: 1
      borderColor: alpha(kind == "boulder" ? yellow : kind == "lead" ? blue : kind == "speed" ? red : kind == "relay" ? cyan : accent, 0.45)
    }
  }

  // A choice in a row of them, like the categories of an event.
  component Pick(label, on) {
    Text {
      text: label
      align: center
      maxLines: 1
      width: len(label) * 8 + 18
      padding: [0, 6]
      radius: 4 * corners
      color: on ? foreground : muted
      background: on ? alpha(foreground, 0.16) : null
      border: 1
      borderColor: on ? alpha(foreground, 0.7) : alpha(muted, 0.4)
    }
  }

  component Athlete(a) {
    Row {
      gap: 8
      align: center
      Text {
        text: "${a.rank}"
        width: 22
        align: end
        bold: a.rank <= 3
        color: a.rank == 1 ? yellow : a.rank == 2 ? foreground : a.rank == 3 ? orange : muted
      }
      Box {
        width: 28
        height: 16
        align: center
        if a.flag != "" {
          Image { src: a.flag; width: 24; height: 16; fit: contain }
        } else {
          Text { text: a.country; font: mono; fontSize: 10; width: 28; align: center; maxLines: 1; color: muted }
        }
      }
      Text { text: a.name; style: small; weight: 1; maxLines: 1 }
      Text { text: a.score; style: small; width: 56; align: end; color: muted; maxLines: 1 }
    }
  }

  // A category's results: its name in its color, the round, and the athletes.
  component Category(c, count = 8) {
    Column {
      gap: 3
      Row {
        align: center
        Text {
          text: c.label
          style: label
          weight: 1
          maxLines: 1
          color: c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : c.kind == "relay" ? cyan : accent
        }
        Text { text: c.round; style: small; color: muted; width: 88; align: end; maxLines: 1 }
      }
      for a in c.top.take(count) key a.key { Athlete { a: a } }
    }
  }

  // A tab of the bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, icon) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { view = name; openId = 0; haptic() }
      Box {
        align: center
        width: 64
        height: 32
        Image { src: icon; size: 24; tint: view == name || (name == "events" && view == "event" && from == "events") ? foreground : muted }
      }
      Text { text: name; style: small; align: center; maxLines: 1; bold: view == name; color: view == name || (name == "events" && view == "event" && from == "events") ? foreground : muted }
    }
  }

  Column {
    fill: true
    gap: 0
    Column {
      weight: 1
      scroll: true
      gap: 12
      padding: [12, 0, 12, 12]

      if len(events) == 0 {
        Column {
          gap: 8
          Text { text: "world climbing series"; style: muted }
          Text { text: offline || (season != null && !season.ok) ? "results offline" : "loading…"; style: title; color: muted }
          if offline || (season != null && !season.ok) {
            Button { text: "try again"; onTap: refresh() }
          }
        }
      } else {
        if view == "now" {
          Row {
            align: center
            Text { text: "world climbing series"; style: small; color: muted; weight: 1; maxLines: 1 }
            Text { text: savedSeason; style: small; color: muted; width: 48; align: end }
          }
          if hero == null {
            Text { text: "no events this season"; style: small; color: muted }
          } else {
            Column {
              gap: 6
              padding: 12
              radius: 8 * corners
              background: hero.state == "live" ? alpha(accent, 0.16) : alpha(foreground, 0.05)
              border: 1
              borderColor: hero.state == "live" ? alpha(accent, 0.55) : alpha(muted, 0.35)
              onTap: { from = "now"; view = "event"; eventId = hero.id; catId = 0; haptic() }
              Text {
                text: hero.state == "live" ? "live now" : hero.state == "next" ? "next up" : "last event"
                style: label
                color: hero.state == "done" ? muted : accent
              }
              Text { text: hero.name; style: title; maxLines: 2 }
              Text { text: hero.dates; style: small; color: muted; maxLines: 1 }
              if hero.state == "next" && countdown != "" {
                Text { text: countdown; fontSize: 32; bold: true; color: foreground; maxLines: 1 }
              }
              Flow {
                gap: 6
                for k in hero.kinds key k { Chip { kind: k } }
              }
            }

            if later != null {
              Row {
                gap: 8
                align: center
                onTap: { from = "now"; view = "event"; eventId = later.id; catId = 0; haptic() }
                Text { text: "then"; style: label; color: muted; width: 36 }
                Text { text: later.name; style: small; weight: 1; maxLines: 1 }
                Text { text: later.dates; style: small; color: muted; width: 110; align: end; maxLines: 1 }
              }
            }

            let shownBlock = focus == null ? null : blocks.find(b => b.id == focus.id)
            if hero.state == "live" {
              if shownBlock == null {
                Text { text: failed ? "results offline" : pending ? "loading results…" : "waiting for the first results"; style: small; color: muted }
              } else {
                for c in shownBlock.cats key c.id { Category { c: c } }
              }
            } else if latest != null && latest.id != hero.id {
              Row {
                align: center
                onTap: { from = "now"; view = "event"; eventId = latest.id; catId = 0; haptic() }
                Column {
                  gap: 0
                  weight: 1
                  Text { text: "latest"; style: label; color: muted }
                  Text { text: latest.name; style: body; maxLines: 1 }
                }
                Text { text: latest.dates; style: small; color: muted; width: 110; align: end; maxLines: 1 }
              }
              if shownBlock == null {
                Text { text: failed ? "results offline" : pending ? "loading results…" : "no results yet"; style: small; color: muted }
              } else {
                for c in shownBlock.cats key c.id { Category { c: c; count: 3 } }
              }
            }
          }
        }

        if view == "events" {
          for e in events key e.id {
            Row {
              gap: 8
              align: center
              padding: [0, 4]
              onTap: { from = "events"; view = "event"; eventId = e.id; catId = 0; haptic() }
              Box {
                width: 3
                height: 32
                radius: 2
                background: e.state == "live" ? accent : e.state == "next" ? yellow : alpha(muted, 0.35)
              }
              Column {
                gap: 0
                weight: 1
                Text { text: e.name; style: body; maxLines: 1 }
                Text { text: e.dates; style: small; color: muted; maxLines: 1 }
              }
              if e.state != "done" {
                Text { text: e.state; style: small; width: 42; align: end; color: e.state == "live" ? accent : yellow }
              }
            }
          }
        }

        if view == "event" && shownEvent != null {
          let ev = shownEvent
          let res = blocks.find(b => b.id == ev.id)
          let cats = res.cats ?? []
          let shown = cats.find(c => c.id == catId) ?? cats[0]
          Column {
            gap: 8
            Row {
              align: center
              Text { text: ev.dates; style: small; color: muted; weight: 1; maxLines: 1 }
              Text {
                text: ev.state == "live" ? "live" : ev.state == "next" ? "upcoming" : "finished"
                style: small
                width: 84
                align: end
                color: ev.state == "done" ? muted : accent
              }
            }
            Flow {
              gap: 6
              for k in ev.kinds key k { Chip { kind: k } }
            }
            if shown == null {
              Text { text: ev.state != "next" && failed ? "results offline" : ev.state != "next" && pending ? "loading results…" : ev.state == "live" ? "waiting for the first results" : "no results published yet"; style: small; color: muted }
            } else {
              Flow {
                gap: 6
                for c in cats key c.id {
                  Box { onTap: { catId = c.id; haptic() }; Pick { label: c.label; on: shown.id == c.id } }
                }
              }
              Row {
                align: center
                Text { text: len(shown.top) >= 8 ? "top 8" : "${len(shown.top)} athletes"; style: label; color: muted; weight: 1 }
                Text { text: shown.round; style: small; color: muted; width: 88; align: end; maxLines: 1 }
              }
              Column {
                gap: 4
                for a in shown.top key a.key { Athlete { a: a } }
              }
            }
            Text { text: "full results ↗"; color: accent; padding: [0, 6]; onTap: url("https://ifsc.results.info/event/${ev.id}") }
          }
        }

        if view == "cup" {
          Flow {
            gap: 6
            for k in RANKS key k {
              Box { onTap: { rankKey = k; openId = 0; haptic() }; Pick { label: k; on: rankKey == k } }
            }
          }
          if cup == null {
            Text { text: len(cupCats) == 0 && lg != null ? "no cup standings yet" : "loading the standings…"; style: small; color: muted }
          } else {
            for a in cup.top key a.key {
              Column {
                gap: 4
                padding: [8, 4]
                radius: 6 * corners
                background: openId == a.id ? alpha(accent, 0.08) : null
                onTap: { openId = openId == a.id ? 0 : a.id; haptic() }
                Athlete { a: a }
                if openId == a.id {
                  for s in a.events key s.event {
                    Row {
                      gap: 8
                      align: center
                      Text { text: "#${s.place}"; font: mono; width: 40; color: accent; maxLines: 1 }
                      Text { text: s.event; style: small; weight: 1; maxLines: 1 }
                      Text { text: s.points; font: mono; width: 48; align: end; color: muted; maxLines: 1 }
                    }
                  }
                  if a.id != 0 {
                    Text { text: "profile ↗"; color: accent; padding: [0, 4]; onTap: url("https://ifsc.results.info/athlete/${a.id}") }
                  }
                }
              }
            }
          }
        }

        if offline && savedAt > 0 {
          Text { text: "offline · saved ${fmtTime(savedAt, "d MMM HH:mm")}"; style: label; color: muted }
        }
      }
    }

    Box { height: 1; fill: width; background: alpha(muted, 0.25) }
    Row {
      gap: 0
      Tab { name: "now"; icon: nowIcon }
      Tab { name: "events"; icon: eventsIcon }
      Tab { name: "cup"; icon: cupIcon }
    }
  }
}
