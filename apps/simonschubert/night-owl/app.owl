  ]
  let shroomArt = [
    "...mmmm.......",
    ".mMMWMMMm.....",
    "mMWMMMMWMm....",
    "mMMMMWMMMm.mm.",
    ".mmmmmmmm.mMWm",
    "...SSsS..mMMMm",
