    ".odecCccCccCcBo.",
    ".oddbcccccccbbo.",
    "..ooobbbbbbboo..",
    "....ff....ff....",
    "...ff......ff..."
  ]
  let run1 = [
    "................",
    "..oo.......oo...",
    "..obo.....obo...",
    "..obboooooobbo..",
    ".obbbbbbbbbbbbo.",
    ".obwwwwbbwwwwbo.",
