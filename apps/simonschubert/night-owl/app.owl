    <rect x="44" y="80" width="12" height="12" fill="#2a1830"/>
    <rect x="56" y="80" width="144" height="12" fill="#8a5a3c"/>
    <rect x="200" y="80" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="92" width="12" height="12" fill="#2a1830"/>
    <rect x="56" y="92" width="12" height="12" fill="#8a5a3c"/>
    <rect x="68" y="92" width="48" height="12" fill="#fff4c8"/>
    <rect x="116" y="92" width="24" height="12" fill="#8a5a3c"/>
    <rect x="140" y="92" width="48" height="12" fill="#fff4c8"/>
    <rect x="188" y="92" width="12" height="12" fill="#8a5a3c"/>
    <rect x="200" y="92" width="12" height="12" fill="#2a1830"/>
    <rect x="32" y="104" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="104" width="12" height="12" fill="#8a5a3c"/>
    <rect x="56" y="104" width="36" height="12" fill="#fff4c8"/>
    <rect x="92" y="104" width="12" height="12" fill="#ffc93c"/>
    <rect x="104" y="104" width="12" height="12" fill="#1a1020"/>
    <rect x="116" y="104" width="48" height="12" fill="#fff4c8"/>
    <rect x="164" y="104" width="12" height="12" fill="#ffc93c"/>
    <rect x="176" y="104" width="12" height="12" fill="#1a1020"/>
    <rect x="188" y="104" width="12" height="12" fill="#fff4c8"/>
    <rect x="200" y="104" width="12" height="12" fill="#8a5a3c"/>
    <rect x="212" y="104" width="12" height="12" fill="#2a1830"/>
    <rect x="32" y="116" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="116" width="12" height="12" fill="#8a5a3c"/>
    <rect x="56" y="116" width="36" height="12" fill="#fff4c8"/>
    <rect x="92" y="116" width="24" height="12" fill="#1a1020"/>
    <rect x="116" y="116" width="12" height="12" fill="#fff4c8"/>
    <rect x="128" y="116" width="24" height="12" fill="#f08a2b"/>
    <rect x="152" y="116" width="12" height="12" fill="#fff4c8"/>
    <rect x="164" y="116" width="24" height="12" fill="#1a1020"/>
    <rect x="188" y="116" width="12" height="12" fill="#fff4c8"/>
    <rect x="200" y="116" width="12" height="12" fill="#8a5a3c"/>
    <rect x="212" y="116" width="12" height="12" fill="#2a1830"/>
    <rect x="32" y="128" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="128" width="24" height="12" fill="#8a5a3c"/>
    <rect x="68" y="128" width="48" height="12" fill="#fff4c8"/>
    <rect x="116" y="128" width="12" height="12" fill="#8a5a3c"/>
    <rect x="128" y="128" width="24" height="12" fill="#f08a2b"/>
    <rect x="152" y="128" width="12" height="12" fill="#8a5a3c"/>
    <rect x="164" y="128" width="36" height="12" fill="#fff4c8"/>
    <rect x="200" y="128" width="12" height="12" fill="#8a5a3c"/>
    <rect x="212" y="128" width="12" height="12" fill="#2a1830"/>
    <rect x="32" y="140" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="140" width="12" height="12" fill="#5e3a2a"/>
    <rect x="56" y="140" width="72" height="12" fill="#8a5a3c"/>
    <rect x="128" y="140" width="12" height="12" fill="#f08a2b"/>
    <rect x="140" y="140" width="60" height="12" fill="#8a5a3c"/>
    <rect x="200" y="140" width="12" height="12" fill="#b8845a"/>
    <rect x="212" y="140" width="12" height="12" fill="#2a1830"/>
    <rect x="32" y="152" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="152" width="36" height="12" fill="#5e3a2a"/>
    <rect x="80" y="152" width="12" height="12" fill="#f4dcae"/>
    <rect x="92" y="152" width="12" height="12" fill="#d9ae7c"/>
    <rect x="104" y="152" width="24" height="12" fill="#f4dcae"/>
    <rect x="128" y="152" width="12" height="12" fill="#d9ae7c"/>
    <rect x="140" y="152" width="24" height="12" fill="#f4dcae"/>
    <rect x="164" y="152" width="12" height="12" fill="#d9ae7c"/>
    <rect x="176" y="152" width="12" height="12" fill="#f4dcae"/>
    <rect x="188" y="152" width="24" height="12" fill="#b8845a"/>
    <rect x="212" y="152" width="12" height="12" fill="#2a1830"/>
    <rect x="32" y="164" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="164" width="24" height="12" fill="#5e3a2a"/>
    <rect x="68" y="164" width="12" height="12" fill="#a06a45"/>
    <rect x="80" y="164" width="108" height="12" fill="#f4dcae"/>
    <rect x="188" y="164" width="12" height="12" fill="#8a5a3c"/>
    <rect x="200" y="164" width="12" height="12" fill="#b8845a"/>
    <rect x="212" y="164" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="176" width="12" height="12" fill="#2a1830"/>
    <rect x="56" y="176" width="12" height="12" fill="#5e3a2a"/>
    <rect x="68" y="176" width="12" height="12" fill="#a06a45"/>
    <rect x="80" y="176" width="12" height="12" fill="#f4dcae"/>
    <rect x="92" y="176" width="12" height="12" fill="#d9ae7c"/>
    <rect x="104" y="176" width="24" height="12" fill="#f4dcae"/>
    <rect x="128" y="176" width="12" height="12" fill="#d9ae7c"/>
    <rect x="140" y="176" width="24" height="12" fill="#f4dcae"/>
    <rect x="164" y="176" width="12" height="12" fill="#d9ae7c"/>
    <rect x="176" y="176" width="12" height="12" fill="#f4dcae"/>
    <rect x="188" y="176" width="12" height="12" fill="#b8845a"/>
    <rect x="200" y="176" width="12" height="12" fill="#2a1830"/>
    <rect x="44" y="188" width="12" height="12" fill="#2a1830"/>
    <rect x="56" y="188" width="24" height="12" fill="#5e3a2a"/>
    <rect x="80" y="188" width="12" height="12" fill="#8a5a3c"/>
    <rect x="92" y="188" width="84" height="12" fill="#f4dcae"/>
    <rect x="176" y="188" width="24" height="12" fill="#8a5a3c"/>
    <rect x="200" y="188" width="12" height="12" fill="#2a1830"/>
    <rect x="56" y="200" width="36" height="12" fill="#2a1830"/>
    <rect x="92" y="200" width="84" height="12" fill="#8a5a3c"/>
    <rect x="176" y="200" width="24" height="12" fill="#2a1830"/>
    <rect x="80" y="212" width="24" height="12" fill="#f5a33c"/>
    <rect x="164" y="212" width="24" height="12" fill="#f5a33c"/>
  </svg>"""

  // Settles a run that ended with nobody tapping, so its score still counts towards the best.
  source now = clock every 1s

  // "title", "play" or "over"
  state mode = "title"
  state best = 0 persist
  state seed = 1
  // the time the run started at
  state t0 = 0
  // the arc the owl is on: when it began (seconds into the run), the height then, the speed up,
  // and the jumps used since it last stood on the ground
  state jt = 0
  state jh = 0
  state jv = 0
  state air = 0
  // fireflies caught on arcs that are over, and which
  state got = 0
  state taken = []
  state final = 0

  // ---- the world, in art pixels and seconds ----------------------------------------------------
  // The forest runs at V0, speeding up by ACC each second to VMAX; DC is the distance run by then.
  let V0 = 72
  let ACC = 2.2
  let VMAX = 150
  let TC = (VMAX - V0) / ACC
  let DC = V0 * TC + ACC * TC * TC / 2
  // gravity, a jump from the ground and the flap in the air
  let G = 620
  let V1 = 205
  let V2 = 180
  // the owl's middle, from the left edge
  let PX = 30

  // per kind: width, the height the owl has to clear
  let kinds = [[14, 11], [14, 7], [14, 7], [14, 9], [18, 8], [22, 7]]
  // Each obstacle's distance and kind. Gaps grow with the speed; now and then two low rocks come
  // close together, which takes the flap.
  let raw = scan(range(240), (prev, k) => {
    d: prev.d + kinds[prev.k][0] + (k > 8 && hash(seed, k, 2) < 0.15 && kinds[prev.k][1] <= 9 ? 9 : min(VMAX, sqrt(V0 * V0 + 2 * ACC * prev.d)) * (0.6 + 0.8 * hash(seed, k, 3)) + 18),
    k: k > 8 && hash(seed, k, 2) < 0.15 && kinds[prev.k][1] <= 9 ? 1 + floor(hash(seed, k, 4) * 2) : floor(hash(seed, k, 1) * (k < 5 ? 4 : 6))
  }, {d: 150, k: 1})
  // When an obstacle reaches the owl (a) and when it's past (b), in seconds into the run, from
  // the distance: within 2 px of its sides and 5 of the owl's middle they touch. The fireflies in
  // the gap after it fly in an arc, with when each passes the owl (c).
  let obs = raw.map((o, i) => {
    i: i, d: o.d, k: o.k, w: kinds[o.k][0], h: kinds[o.k][1],
    a: o.d - PX - 3 < DC ? (sqrt(V0 * V0 + 2 * ACC * (o.d - PX - 3)) - V0) / ACC : TC + (o.d - PX - 3 - DC) / VMAX,
    b: o.d + kinds[o.k][0] - PX + 3 < DC ? (sqrt(V0 * V0 + 2 * ACC * (o.d + kinds[o.k][0] - PX + 3)) - V0) / ACC : TC + (o.d + kinds[o.k][0] - PX + 3 - DC) / VMAX,
    fl: i + 1 < len(raw) && raw[i + 1].d - o.d - kinds[o.k][0] > 48 && hash(seed, i, 7) < 0.6
      ? range(5).map(j => {
          i: i * 8 + j,
          d: (o.d + kinds[o.k][0] + raw[i + 1].d) / 2 + (j - 2) * 8,
          y: 9 + (4 + hash(seed, i, 9) * 26) * (1 - pow((j - 2) / 2.6, 2)),
          c: (o.d + kinds[o.k][0] + raw[i + 1].d) / 2 + (j - 2) * 8 - PX < DC ? (sqrt(V0 * V0 + 2 * ACC * ((o.d + kinds[o.k][0] + raw[i + 1].d) / 2 + (j - 2) * 8 - PX)) - V0) / ACC : TC + ((o.d + kinds[o.k][0] + raw[i + 1].d) / 2 + (j - 2) * 8 - PX - DC) / VMAX
        })
      : []
  })

  // ---- what the current arc runs into ---------------------------------------------------------
  // The arc is a parabola, highest at `peak`, so over an obstacle it's lowest at the edges: the owl
  // is clear when it's above the obstacle from the moment it reaches it until it's past. It hits
  // the front when it's still too low there, or comes down on top when the arc drops too soon. On
  // the ground the next obstacle is certain, so a few ahead are enough.
  let ahead = obs.filter(o => o.b >= jt).take(5)
  let peak = jh + jv * jv / (2 * G)
  let hits = ahead.map(o => peak < o.h ? max(o.a, jt)
    : max(o.a, jt) < (jh >= o.h ? jt : jt + (jv - sqrt(jv * jv - 2 * G * (o.h - jh))) / G) ? max(o.a, jt)
    : o.b > jt + (jv + sqrt(jv * jv + 2 * G * (jh - o.h))) / G ? max(o.a, jt, jt + (jv + sqrt(jv * jv + 2 * G * (jh - o.h))) / G)
    : null)
  let dieAt = min(hits.filter(x => x != null)) ?? 9999
  let k0 = len(ahead) > 0 ? ahead[0].i : 0
  // the fireflies this arc passes through before it ends: the owl is 15 px tall
  let caught = flatten(obs.drop(max(0, k0 - 1)).take(6).map(o => o.fl)).filter(f => f.c >= jt && f.c < dieAt && abs(max(0, jh + jv * (f.c - jt) - G / 2 * pow(f.c - jt, 2)) + 8 - f.y) <= 8)
  let caughtIds = caught.map(f => f.i)
  let distAtDeath = dieAt < TC ? V0 * dieAt + ACC * dieAt * dieAt / 2 : DC + VMAX * (dieAt - TC)

  // A run over: count its fireflies and its score.
  on now {
    if mode == "play" && time - t0 >= dieAt {
      got = got + len(caught)
      taken = taken + caughtIds
      final = floor(distAtDeath / 10) + (got + len(caught)) * 5
      best = max(best, floor(distAtDeath / 10) + (got + len(caught)) * 5)
      mode = "over"
    }
  }

  // ---- the art -----------------------------------------------------------------------------------
  // One palette for every sprite; a letter is a color, "." is empty.
  let pal = {A: "#3f8f5a", B: "#b8845a", C: "#d9ae7c", E: "#9fe0ff", F: "#ffe46b", G: "#4f9a5c", H: "#8fd16f", I: "#ffd166", J: "#a5aecb", K: "#6c7391", L: "#2f6a45", M: "#e0457b", N: "#6a4a52", O: "#8d6b6b", P: "#5a3a44", Q: "#b59c78", R: "#d8a86c", S: "#f1e3c8", T: "#6b4430", V: "#d9d0c0", W: "#ffe0ec", X: "#ff8aa0", Y: "#fffbd0", Z: "#fff3d6", a: "#2c6b48", b: "#8a5a3c", c: "#f4dcae", d: "#5e3a2a", e: "#a06a45", f: "#f5a33c", g: "#2f6b45", h: "#7fc46e", i: "#e8e0ff", j: "#4b506b", k: "#1a1020", l: "#1f4532", m: "#a82a63", n: "#f08a2b", o: "#2a1830", p: "#4a2f3c", q: "#cdb48c", r: "#a87a4a", s: "#c9b59a", t: "#4a2c22", u: "#2e1c1c", v: "#3a3f57", w: "#fff4c8", x: "#d23a5a", y: "#ffc93c", z: "#e9d3a8"}
  let run0 = [
    "..oo.......oo...",
    "..obo.....obo...",
    "..obboooooobbo..",
    ".obbbbbbbbbbbbo.",
    ".obwwwwbbwwwwbo.",
    "obwwwykwwwwykwbo",
    "obwwwkkwnnwkkwbo",
    "obbwwwwbnnbwwwbo",
    "odbbbbbbnbbbbbBo",
    "odddcCccCccCcBBo",
