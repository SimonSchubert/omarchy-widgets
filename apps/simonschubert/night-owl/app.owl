  let hills = [[0, 20], [0, 6], [1, 6], [1, 5], [2, 5], [2, 4], [3, 4], [3, 3], [5, 3], [5, 2], [8, 2], [8, 3], [10, 3], [10, 4], [12, 4], [12, 5], [14, 5], [14, 6], [17, 6], [17, 7], [21, 7], [21, 8], [23, 8], [23, 9], [24, 9], [24, 10], [26, 10], [26, 11], [27, 11], [27, 12], [29, 12], [29, 13], [33, 13], [33, 12], [35, 12], [35, 11], [37, 11], [37, 10], [39, 10], [39, 9], [43, 9], [43, 10], [46, 10], [46, 11], [48, 11], [48, 12], [55, 12], [55, 13], [58, 13], [58, 14], [59, 14], [59, 15], [61, 15], [61, 16], [62, 16], [62, 17], [64, 17], [64, 18], [66, 18], [66, 17], [68, 17], [68, 16], [70, 16], [70, 15], [71, 15], [71, 14], [72, 14], [72, 13], [73, 13], [73, 12], [74, 12], [74, 11], [75, 11], [75, 10], [77, 10], [77, 9], [81, 9], [81, 8], [84, 8], [84, 7], [86, 7], [86, 6], [88, 6], [88, 5], [94, 5], [94, 6], [95, 6], [95, 7], [96, 7], [96, 8], [98, 8], [98, 9], [100, 9], [100, 10], [104, 10], [104, 9], [106, 9], [106, 8], [108, 8], [108, 7], [119, 7], [119, 6], [122, 6], [122, 5], [127, 5], [127, 6], [128, 6], [128, 7], [129, 7], [129, 8], [130, 8], [130, 9], [131, 9], [131, 10], [132, 10], [132, 11], [133, 11], [133, 12], [134, 12], [134, 13], [135, 13], [135, 14], [136, 14], [136, 15], [154, 15], [154, 14], [155, 14], [155, 13], [156, 13], [156, 12], [158, 12], [158, 11], [159, 11], [159, 10], [161, 10], [161, 9], [164, 9], [164, 10], [167, 10], [167, 11], [168, 11], [168, 12], [171, 12], [171, 13], [174, 13], [174, 12], [178, 12], [178, 11], [187, 11], [187, 10], [189, 10], [189, 9], [190, 9], [190, 8], [191, 8], [191, 7], [192, 7], [192, 20]]
  let pines = [[0, 32], [0, 15], [1, 15], [1, 12], [2, 12], [2, 8], [3, 8], [3, 12], [4, 12], [4, 15], [6, 15], [6, 12], [7, 12], [7, 9], [8, 9], [8, 6], [9, 6], [9, 9], [10, 9], [10, 12], [11, 12], [11, 15], [12, 15], [12, 19], [13, 19], [13, 22], [14, 22], [14, 25], [16, 25], [16, 24], [17, 24], [17, 21], [18, 21], [18, 17], [19, 17], [19, 21], [20, 21], [20, 24], [21, 24], [21, 21], [22, 21], [22, 18], [23, 18], [23, 15], [24, 15], [24, 18], [25, 18], [25, 21], [26, 21], [26, 25], [28, 25], [28, 24], [29, 24], [29, 21], [30, 21], [30, 17], [31, 17], [31, 21], [32, 21], [32, 24], [33, 24], [33, 26], [35, 26], [35, 25], [36, 25], [36, 22], [37, 22], [37, 18], [38, 18], [38, 15], [39, 15], [39, 12], [40, 12], [40, 15], [41, 15], [41, 18], [42, 18], [42, 22], [43, 22], [43, 19], [44, 19], [44, 16], [45, 16], [45, 19], [46, 19], [46, 22], [47, 22], [47, 21], [48, 21], [48, 18], [49, 18], [49, 15], [50, 15], [50, 12], [51, 12], [51, 9], [52, 9], [52, 5], [53, 5], [53, 9], [54, 9], [54, 12], [55, 12], [55, 15], [57, 15], [57, 11], [58, 11], [58, 15], [60, 15], [60, 12], [61, 12], [61, 9], [62, 9], [62, 5], [63, 5], [63, 9], [64, 9], [64, 12], [65, 12], [65, 15], [66, 15], [66, 18], [67, 18], [67, 15], [68, 15], [68, 18], [69, 18], [69, 21], [70, 21], [70, 25], [71, 25], [71, 24], [72, 24], [72, 21], [73, 21], [73, 17], [74, 17], [74, 21], [75, 21], [75, 24], [76, 24], [76, 25], [77, 25], [77, 22], [78, 22], [78, 19], [79, 19], [79, 15], [80, 15], [80, 12], [81, 12], [81, 9], [82, 9], [82, 6], [83, 6], [83, 9], [84, 9], [84, 12], [85, 12], [85, 15], [87, 15], [87, 11], [88, 11], [88, 15], [89, 15], [89, 18], [90, 18], [90, 21], [91, 21], [91, 18], [92, 18], [92, 14], [93, 14], [93, 18], [94, 18], [94, 21], [95, 21], [95, 18], [96, 18], [96, 15], [97, 15], [97, 12], [98, 12], [98, 9], [99, 9], [99, 5], [100, 5], [100, 9], [101, 9], [101, 12], [102, 12], [102, 15], [103, 15], [103, 18], [105, 18], [105, 15], [106, 15], [106, 18], [107, 18], [107, 21], [108, 21], [108, 25], [110, 25], [110, 22], [111, 22], [111, 18], [112, 18], [112, 15], [113, 15], [113, 12], [114, 12], [114, 9], [115, 9], [115, 12], [116, 12], [116, 15], [117, 15], [117, 18], [118, 18], [118, 22], [119, 22], [119, 25], [120, 25], [120, 22], [121, 22], [121, 19], [122, 19], [122, 16], [123, 16], [123, 13], [124, 13], [124, 16], [125, 16], [125, 19], [126, 19], [126, 18], [127, 18], [127, 15], [128, 15], [128, 12], [129, 12], [129, 15], [130, 15], [130, 18], [131, 18], [131, 22], [132, 22], [132, 25], [133, 25], [133, 21], [134, 21], [134, 18], [135, 18], [135, 15], [136, 15], [136, 18], [137, 18], [137, 21], [138, 21], [138, 25], [142, 25], [142, 22], [143, 22], [143, 19], [144, 19], [144, 16], [145, 16], [145, 19], [146, 19], [146, 22], [147, 22], [147, 25], [151, 25], [151, 24], [152, 24], [152, 21], [153, 21], [153, 17], [154, 17], [154, 21], [155, 21], [155, 24], [156, 24], [156, 25], [157, 25], [157, 26], [158, 26], [158, 25], [159, 25], [159, 22], [160, 22], [160, 18], [161, 18], [161, 15], [162, 15], [162, 12], [163, 12], [163, 15], [164, 15], [164, 18], [165, 18], [165, 21], [166, 21], [166, 18], [167, 18], [167, 15], [168, 15], [168, 12], [169, 12], [169, 9], [170, 9], [170, 5], [171, 5], [171, 9], [172, 9], [172, 12], [173, 12], [173, 15], [174, 15], [174, 18], [175, 18], [175, 21], [176, 21], [176, 24], [177, 24], [177, 21], [178, 21], [178, 18], [179, 18], [179, 15], [180, 15], [180, 12], [181, 12], [181, 8], [182, 8], [182, 12], [183, 12], [183, 15], [184, 15], [184, 18], [185, 18], [185, 21], [186, 21], [186, 24], [187, 24], [187, 27], [189, 27], [189, 24], [190, 24], [190, 21], [191, 21], [191, 18], [192, 18], [192, 32]]
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"

  Canvas {
    fill: true
    background: "#0a0a20"

    onPress: {
      let T = time - t0
      // A run from before the clock started over (the app was reloaded) is dropped.
      if T < 0 && mode != "title" {
        mode = "title"
      } else if mode == "play" && T < dieAt {
        let h = max(0, jh + jv * (T - jt) - G / 2 * pow(T - jt, 2))
        let used = h <= 0 ? 0 : air
        if used < 2 {
          let done = caught.filter(f => f.c < T)
          got = got + len(done)
          taken = taken + done.map(f => f.i)
          jt = T
          jh = h
          jv = used == 0 ? V1 : V2
          air = used + 1
        }
      } else if mode == "play" {
        got = got + len(caught)
        taken = taken + caughtIds
        final = floor(distAtDeath / 10) + (got + len(caught)) * 5
        best = max(best, floor(distAtDeath / 10) + (got + len(caught)) * 5)
        mode = "over"
      } else if mode == "title" || (mode == "over" && time - t0 - dieAt > 0.8) {
        seed = random(1000000)
        t0 = time
        jt = 0
        jh = 0
        jv = 0
        air = 0
        got = 0
        taken = []
        mode = "play"
      }
    }

    // ---- where things are ----
    // An art pixel is p dp; the ground is a third of the way up a phone held upright.
    let p = min(width / 128, height / 150)
    let W = width / p
    let H = height / p
    let GY = floor(min(H * 0.64, H - 24))
    // seconds into the run, stopped where it ended; the distance run
    let fresh = mode == "title" || time < t0
    let rt = fresh ? 0 : min(time - t0, dieAt)
    let dist = fresh ? time * 28 : rt < TC ? V0 * rt + ACC * rt * rt / 2 : DC + VMAX * (rt - TC)
    let dead = !fresh && time - t0 >= dieAt
    let since = time - t0 - dieAt
    let oy = fresh ? 0 : max(0, jh + jv * (rt - jt) - G / 2 * pow(rt - jt, 2))
    // after a crash the owl pops up and drops back down
    let hop = dead ? max(0, oy + 60 * since - 260 * since * since) : oy
    let score = fresh ? 0 : mode == "over" ? final : floor(dist / 10) + (got + count(caught, f => f.c < rt)) * 5

    // ---- the sky ----
    let bandH = (GY - 18) / len(sky)
    for c, i in sky {
      rect(0, floor(i * bandH) * p, width, (i == len(sky) - 1 ? GY - floor(i * bandH) : ceil(bandH) + 1) * p, fill: c)
    }
    // a dithered row where each band meets the next
    for i in range(1, len(sky)) {
      for k in range(ceil(W / 32) + 1) { sprite(ditherArt, k * 32 * p, (floor(i * bandH) - 1) * p, p, palette: {x: sky[i]}) }
    }
    for s, i in stars {
      let sx = ((s[0] * W - dist * 0.01) % W + W) % W
      rect(floor(sx) * p, floor(s[1] * (GY - 40)) * p, p, p, fill: alpha(starCols[s[2]], 0.55 + 0.45 * sin(time * s[3] + i)))
    }
    // the moon and its glow
    let mx = floor(W * 0.62)
    let my = floor(GY * 0.12)
    for r in [30, 23, 17] { circle((mx + 10.5) * p, (my + 10) * p, r * p, fill: alpha("#b8a8ff", 0.035)) }
    sprite(moonArt, mx * p, my * p, p, palette: pal)

    // ---- far to near: mountains, mist, hills, pines ----
    // [outline, parallax, offset, top above the ground, moonlit rim, body]. Each is drawn rims first,
    // then bodies, so one tile's rim never lands on the tile before it.
    let layers = [[mount, 0.08, 0, 52, "#3d3676", "#2b2658"], [hills, 0.2, 60, 24, "#2a3a66", "#1f2b52"], [pines, 0.45, 100, 30, "#1d3150", "#13203a"]]
    for L, n in layers {
      if n == 1 { rect(0, (GY - 22) * p, width, 10 * p, fill: alpha("#6e417d", 0.25)) }
      for pass in [0, 1] {
        for k in range(ceil(W / 192) + 1) {
          translate((k * 192 - (dist * L[1] + L[2]) % 192) * p, (GY - L[3]) * p) {
            scale(p, p, 0, 0) { translate(pass - 1, pass - 1) { path(L[0], closed: true, fill: L[4 + pass]) } }
          }
        }
      }
    }

    // ---- the ground ----
    rect(0, (GY + 3) * p, width, height - (GY + 3) * p, fill: "#3a2330")
    rect(0, (GY + 26) * p, width, height - (GY + 26) * p, fill: "#2e1b29")
    rect(0, (GY + 44) * p, width, height - (GY + 44) * p, fill: "#24162a")
    let gx = -(floor(dist) % 32)
    for k in range(ceil(W / 32) + 1) {
      sprite(grassArt, (gx + k * 32) * p, (GY - 3) * p, p, palette: pal)
      sprite(dirtArt, (gx + k * 32) * p, (GY + 8) * p, p, palette: pal)
    }
    let ux = -(floor(dist) % 96)
    for k in range(ceil(W / 96) + 1) { sprite(underArt, (ux + k * 96) * p, (GY + 7) * p, p, palette: pal) }

    // ---- obstacles and fireflies ----
    if !fresh {
      for o in obs.drop(max(0, k0 - 3)).take(9) {
        let ox = o.d - dist
        if ox > -30 && ox < W + 4 {
          let art = obsArt[o.k]
          sprite(art, floor(ox) * p, (GY - len(art) + (o.k == 4 ? 1 : 0)) * p, p, palette: pal)
        }
        for f in o.fl {
          let fx = f.d - dist
          let gone = indexOf(taken, f.i) >= 0 || (indexOf(caughtIds, f.i) >= 0 && f.c < rt)
          if fx > -6 && fx < W + 4 && !gone {
            let bob = sin(time * 3 + f.i) * 1.5
            let fy = GY - f.y + bob
            sprite(haloArt, floor(fx - 3) * p, floor(fy - 3) * p, p, palette: {h: alpha("#ffe46b", 0.18 + 0.1 * sin(time * 6 + f.i))})
            sprite(flyArt, floor(fx - 1) * p, floor(fy - 1) * p, p, palette: pal)
          }
          // a caught one bursts
          if gone && rt - f.c < 0.35 && fx > -6 {
            let s = (rt - f.c) * 30
            for a in [0, 1, 2, 3] {
              rect((fx + [s, -s, 0, 0][a]) * p, (GY - f.y + [0, 0, s, -s][a]) * p, p, p, fill: "#fffbd0")
            }
          }
        }
      }
    }

    // ---- the owl ----
    let ox0 = PX - 8
    let feet = GY - hop
    if dead {
      sprite(deadArt, ox0 * p, (feet - 16) * p, p, palette: pal)
    } else if oy > 0 && air == 2 && rt - jt < 0.3 {
      sprite(flapArt, (ox0 - 4) * p, (feet - 19) * p, p, palette: pal)
    } else if oy > 0 {
      sprite(jumpArt, ox0 * p, (feet - 16) * p, p, palette: pal)
    } else {
      sprite(runArt[floor(time * 12) % 4], ox0 * p, (feet - 16) * p, p, palette: pal)
    }

    // ---- words ----
    if fresh {
      text("NIGHT OWL", width / 2 + p, (GY * 0.42) * p + p, size: 9 * p, color: "#141436", font: press, align: center)
      text("NIGHT OWL", width / 2, (GY * 0.42) * p, size: 9 * p, color: "#ffe46b", font: press, align: center)
      if time % 1.2 < 0.8 { text("TAP TO START", width / 2, (GY * 0.42 + 16) * p, size: 3.5 * p, color: "#e8e0ff", font: press, align: center) }
      text("TAP TO JUMP, AGAIN TO FLAP", width / 2, (GY + 54) * p, size: 3 * p, color: "#8a7aa0", font: press, align: center)
      if best > 0 { text("BEST ${best}", width / 2, (GY + 62) * p, size: 3 * p, color: "#8a7aa0", font: press, align: center) }
    } else {
      text(pad(str(score), 5, "0"), 6 * p, 8 * p, size: 4 * p, color: "#fff3d6", font: press)
      text("HI ${pad(str(max(best, score)), 5, "0")}", width - 6 * p, 8 * p, size: 4 * p, color: "#8a7aa0", font: press, align: end)
      if dead {
        text("GAME OVER", width / 2 + p, (GY * 0.42) * p + p, size: 7 * p, color: "#141436", font: press, align: center)
        text("GAME OVER", width / 2, (GY * 0.42) * p, size: 7 * p, color: "#ff8aa0", font: press, align: center)
        text("SCORE ${final > 0 ? final : score}", width / 2, (GY * 0.42 + 12) * p, size: 4 * p, color: "#fff3d6", font: press, align: center)
        if since > 0.8 && time % 1.2 < 0.8 { text("TAP TO RUN AGAIN", width / 2, (GY * 0.42 + 24) * p, size: 3.5 * p, color: "#e8e0ff", font: press, align: center) }
      }
    }
  }
}
