app "night owl" {
  // A one-button runner through a moonlit forest, all pixel art. Tap to jump, and tap again in the
  // air to flap once more. Clear stumps, rocks, mushrooms, brambles and logs, and catch the
  // fireflies on the way; the forest speeds up the longer the owl lasts.
  //
  // There's no game loop. The world scrolls by a formula of the time since the run started, the
  // obstacles and fireflies come from the run's seed, and a tap starts a new arc: from that arc
  // follows the moment the owl next hits something (`dieAt`), so a frame only has to draw.

  meta { owl: 12; description: "A one-button pixel art runner: an owl jumps and flaps through a moonlit forest, over stumps and brambles, catching fireflies"; version: "1.0"; license: "MIT"; category: "games" }

  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#141436"/>
    <circle cx="196" cy="62" r="26" fill="#fff3d6" opacity="0.9"/>
    <rect x="56" y="44" width="24" height="12" fill="#2a1830"/>
    <rect x="164" y="44" width="24" height="12" fill="#2a1830"/>
