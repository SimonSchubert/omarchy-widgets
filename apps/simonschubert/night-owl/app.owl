    "vjjjjjjjjjjjjv"
  ]
  let mossArt = [
    "....ggggg.....",
    "..gGGGGGGgg...",
    ".jgGGhGGGGGg..",
    ".jKJJgGgggGKj.",
    "jKKKKKgKKKKKKj",
