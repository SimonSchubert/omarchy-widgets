    ".....odecCccCccCcBo.....",
    ".....oddbcccccccbbo.....",
    "......ooobbbbbbboo......",
    "........ff.....ff......."
  ]
  let deadArt = [
    "..oo.......oo...",
    "..obo.....obo...",
    "..obboooooobbo..",
    ".obbbbbbbbbbbbo.",
    ".obwwwwbbwwwwbo.",
    "obwkwkwwwwkwkwbo",
