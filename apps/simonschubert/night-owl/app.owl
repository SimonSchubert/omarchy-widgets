  let stars = [[0.238, 0.363, 2, 3.7], [0.474, 0.397, 0, 3.7], [0.469, 0.369, 1, 4.0], [0.470, 0.662, 3, 2.2], [0.861, 0.110, 1, 3.6], [0.523, 0.559, 0, 1.5], [0.957, 0.010, 0, 3.5], [0.269, 0.411, 3, 3.1], [0.921, 0.232, 3, 3.9], [0.134, 0.208, 0, 1.4], [0.217, 0.809, 3, 3.3], [0.855, 0.253, 3, 2.7], [0.534, 0.242, 1, 3.7], [0.682, 0.767, 2, 4.0], [0.671, 0.067, 2, 3.9], [0.905, 0.386, 1, 2.9], [0.988, 0.134, 0, 1.2], [0.854, 0.838, 0, 2.0], [0.067, 0.730, 0, 1.9], [0.769, 0.703, 0, 2.8], [0.762, 0.218, 2, 2.7], [0.922, 0.142, 1, 4.0], [0.310, 0.023, 0, 3.8], [0.971, 0.151, 2, 1.5], [0.042, 0.697, 2, 2.1], [0.138, 0.690, 3, 2.4], [0.520, 0.459, 0, 2.9], [0.941, 0.328, 3, 2.9], [0.716, 0.775, 3, 3.9], [0.521, 0.367, 0, 3.4], [0.987, 0.169, 3, 2.8], [0.632, 0.017, 2, 2.4], [0.679, 0.198, 2, 3.2], [0.022, 0.017, 0, 3.9], [0.251, 0.283, 2, 1.5], [0.185, 0.577, 2, 1.9], [0.377, 0.592, 0, 3.9], [0.684, 0.050, 1, 3.0], [0.269, 0.178, 3, 2.9], [0.097, 0.416, 2, 3.0], [0.224, 0.633, 1, 1.2], [0.742, 0.101, 3, 1.8], [0.787, 0.007, 1, 1.9], [0.836, 0.392, 2, 2.0], [0.828, 0.027, 2, 2.8], [0.421, 0.339, 2, 2.4]]
  let starCols = ["#ffffff", "#c8d0ff", "#ffe9b0", "#8890c0"]
  // the far mountains, the hills and the pines: stepped outlines, 192 px long, that repeat
  let mount = [[0, 52], [0, 17], [1, 17], [1, 16], [2, 16], [2, 15], [4, 15], [4, 16], [6, 16], [6, 18], [7, 18], [7, 19], [8, 19], [8, 21], [9, 21], [9, 22], [10, 22], [10, 24], [11, 24], [11, 25], [12, 25], [12, 26], [21, 26], [21, 27], [23, 27], [23, 28], [34, 28], [34, 29], [35, 29], [35, 30], [36, 30], [36, 32], [37, 32], [37, 33], [38, 33], [38, 34], [39, 34], [39, 36], [41, 36], [41, 37], [42, 37], [42, 36], [44, 36], [44, 35], [45, 35], [45, 34], [46, 34], [46, 33], [47, 33], [47, 32], [48, 32], [48, 31], [50, 31], [50, 30], [53, 30], [53, 31], [59, 31], [59, 30], [61, 30], [61, 31], [63, 31], [63, 32], [64, 32], [64, 33], [65, 33], [65, 35], [66, 35], [66, 36], [67, 36], [67, 37], [68, 37], [68, 39], [70, 39], [70, 40], [73, 40], [73, 39], [74, 39], [74, 38], [75, 38], [75, 37], [76, 37], [76, 36], [77, 36], [77, 35], [78, 35], [78, 34], [83, 34], [83, 35], [87, 35], [87, 34], [90, 34], [90, 33], [99, 33], [99, 32], [100, 32], [100, 31], [101, 31], [101, 29], [102, 29], [102, 27], [103, 27], [103, 25], [104, 25], [104, 23], [105, 23], [105, 21], [106, 21], [106, 19], [107, 19], [107, 18], [108, 18], [108, 17], [109, 17], [109, 16], [115, 16], [115, 17], [121, 17], [121, 18], [123, 18], [123, 19], [124, 19], [124, 20], [125, 20], [125, 21], [126, 21], [126, 23], [127, 23], [127, 24], [129, 24], [129, 25], [137, 25], [137, 26], [138, 26], [138, 27], [139, 27], [139, 29], [140, 29], [140, 31], [141, 31], [141, 33], [142, 33], [142, 35], [143, 35], [143, 37], [144, 37], [144, 39], [145, 39], [145, 40], [146, 40], [146, 42], [148, 42], [148, 43], [149, 43], [149, 44], [151, 44], [151, 45], [153, 45], [153, 46], [154, 46], [154, 47], [159, 47], [159, 46], [160, 46], [160, 45], [161, 45], [161, 43], [162, 43], [162, 42], [163, 42], [163, 40], [164, 40], [164, 38], [165, 38], [165, 37], [166, 37], [166, 36], [168, 36], [168, 35], [171, 35], [171, 36], [174, 36], [174, 35], [176, 35], [176, 34], [177, 34], [177, 33], [178, 33], [178, 31], [179, 31], [179, 30], [180,