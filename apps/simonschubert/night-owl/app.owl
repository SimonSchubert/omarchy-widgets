  ]
  let logArt = [
    "....tttttttttttttttt..",
    "..ttTTTTTTTTTTTTTTTTt.",
    ".tRRtTTtTTTTTtTTTTtTTt",
    "tRrrRtTTTTtTTTTTTTTTTt",
    "tRrRrtTtTTTTTTtTTGgTTt",
    "tRrrRtTTTTTTtTTTGGGTTt",
    ".tRRtTTTTtTTTTTTTTTTTt",
    "..ttuuuuuuuuuuuuuuuuu."
  ]
  let moonArt = [
    ".......zzzzzzz.......",
    ".....zzZZZZZZZzz.....",
    "....zZZZZZZZZZZZz....",
    "...zZZZqqZZZZZZZZz...",
    "..zZZZqQQqZZZZZZZZz..",
    ".zZZZZqQQqZZZZZqqZZz.",
    ".zZZZZZqqZZZZZqQQqZz.",
    "zZZZZZZZZZZZZZZqqZZZz",
    "zZZZZZZZZZZZZZZZZZZZz",
    "zZZZZZZZZZZZZZZZZZZzz",
    "zZZZqqZZZZZZZZZZZZZzz",
    "zZZqQQqZZZZZZZqZZZZzz",
