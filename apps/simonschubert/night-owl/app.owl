  ]
  let run2 = [
    "..oo.......oo...",
    "..obo.....obo...",
    "..obboooooobbo..",
    ".obbbbbbbbbbbbo.",
    ".obwwwwbbwwwwbo.",
    "obwwwykwwwwykwbo",
    "obwwwkkwnnwkkwbo",
    "obbwwwwbnnbwwwbo",
    "odbbbbbbnbbbbbBo",
    "odddcCccCccCcBBo",
    "oddecccccccccbBo",
    ".odecCccCccCcBo.",
    ".oddbcccccccbbo.",
    "..ooobbbbbbboo..",
    "......ffff......",
    "......ffff......"
  ]
  let run3 = [
    "................",
    "..oo.......oo...",
    "..obo.....obo...",
    "..obboooooobbo..",
    ".obbbbbbbbbbbbo.",
    ".obwwwwbbwwwwbo.",
    "obwwwykwwwwykwbo",
    "obwwwkkwnnwkkwbo",
    "obbwwwwbnnbwwwbo",
    "odbbbbbbnbbbbbBo",
    "odddcCccCccCcBBo",
    "oddecccccccccbBo",
    ".odecCccCccCcBo.",
    ".oddbcccccccbbo.",
    "..ooobbbbbbboo..",
    ".....ff..ff....."
  ]
  let jumpArt = [
    "..oo.......oo...",
    "..obo.....obo...",
    "..obboooooobbo..",
    ".obbbbbbbbbbbbo.",
    ".obwwwwbbwwwwbo.",
    "obwwwykwwwwykwbo",
    "obwwwkkwnnwkkwbo",
    "obbwwwwbnnbwwwbo",
    "odbbbbbbnbbbbbBo",
    "odddcCccCccCcBBo",
    "oddecccccccccbBo",
    ".odecCccCccCcBo.",
    ".oddbcccccccbbo.",
    "..ooobbbbbbboo..",
    "....ff.....ff...",
    "................"
  ]
  let flapArt = [
    "o......................o",
    "do....................ob",
    "edo..................obB",
    "ddo...oo.......oo....obb",
    "edd...obo.....obo....bbB",
    "dddo..obboooooobbo..obbb",
    ".ddo.obbbbbbbbbbbbo.obb.",
    "..od.obwwwwbbwwwwbo.bo..",
    "...oobwwwykwwwwykwboo...",
    "....obwwwkkwnnwkkwbo....",
    "....obbwwwwbnnbwwwbo....",
