app "Color Relay" {
  meta { owl: 21; category: "games"; description: "A beach-themed solo card game. Find the one color or number match in ten hands, with a relaxed soundtrack or three timed challenges."; version: "1.0"; license: "MIT" }
  title: ""
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#64DFF6"/>
    <clipPath id="tile"><rect width="256" height="256" rx="56"/></clipPath>
    <g clip-path="url(#tile)">
      <circle cx="198" cy="54" r="28" fill="#FFE145"/>
      <path d="M0 146Q64 111 128 146T256 146V256H0Z" fill="#1FBBC8"/>
      <path d="M0 213Q59 188 123 213T256 209V256H0Z" fill="#FFF0BB"/>
    </g>
    <g transform="rotate(-19 91 126)">
      <rect x="47" y="55" width="94" height="142" rx="17" fill="#D93051" stroke="#FFF0BB" stroke-width="8"/>
      <circle cx="85" cy="108" r="17" fill="#FFF0BB"/>
    </g>
    <g transform="rotate(14 148 145)">
      <rect x="105" y="72" width="96" height="144" rx="17" fill="#2065D8" stroke="#FFF0BB" stroke-width="8"/>
      <path d="m153 97 9 27 29 1-23 17 8 28-23-17-23 17 8-28-23-17 29-1z" fill="#FFF0BB"/>
    </g>
  </svg>"""

  requires { pacman: ["python", "libpulse", "libsndfile"] }
  source audioPlayer = stream("""python3 -c 'from array import array
from ctypes import CDLL, POINTER, Structure, byref
from ctypes import c_char_p, c_int, c_size_t, c_uint8, c_uint32, c_void_p
import os
from pathlib import Path
import select
import socket
from time import monotonic
from base64 import b64decode
from hashlib import sha256
from tempfile import TemporaryFile
from ctypes import c_int64, c_int16


SAMPLE_RATE = 24_000
BLOCK_SIZE = 240
BYTES_PER_MILLISECOND = SAMPLE_RATE * 2 // 1000  # 16-bit mono PCM
KEEPALIVE_SECONDS = 2.1
CUES = ("match", "miss", "win", "timeout")
EVENTS = (*CUES, "play", "idle", "mute")
ADDRESS = f"\0omalauncher-color-relay-store-{os.getuid()}"


# The store installs a single OWL file. Read only its embedded audio bytes.
# The sizes separate the MP3 clips, and the hash selects the matching version.
CLIP_SIZES = (40413, 40413, 30405, 30405, 23637, 23637, 18885, 18885, 1029, 1101, 3117, 2397)
AUDIO_HASH = "4b1c35e40b0fe5229e6280dc43bb55dc32c2fada20142b3a4aebede633417ec4"


def audio_bytes():
    widgets = Path.home() / ".config/omalauncher/widgets"
    pattern = "market-app-dgtwt-color-relay*.owl"
    marker = "\n  asset relayAudioPack = base64" + chr(34)
    for path in sorted(widgets.glob(pattern)):
        try:
            _, found, rest = path.read_text().partition(marker)
            if found:
                blob = b64decode(rest.partition(chr(34))[0], validate=True)
                if sha256(blob).hexdigest() == AUDIO_HASH:
                    return blob
        except (OSError, ValueError):
            continue
    raise FileNotFoundError("Color Relay audio data is missing from the installed OWL file")


class SoundFileInfo(Structure):
    _fields_ = [("frames", c_int64), ("rate", c_int), ("channels", c_int),
                ("format", c_int), ("sections", c_int), ("seekable", c_int)]


def load_audio():
    lib = CDLL("libsndfile.so.1")
    lib.sf_open_fd.argtypes = [c_int, c_int, POINTER(SoundFileInfo), c_int]
    lib.sf_open_fd.restype = c_void_p
    lib.sf_readf_short.argtypes = [c_void_p, POINTER(c_int16), c_int64]
    lib.sf_readf_short.restype = c_int64
    lib.sf_close.argtypes = [c_void_p]
    lib.sf_close.restype = c_int

    compressed = audio_bytes()
    decoded = []
    offset = 0
    for size in CLIP_SIZES:
        with TemporaryFile() as clip:
            clip.write(compressed[offset:offset + size])
            clip.seek(0)
            offset += size
            info = SoundFileInfo()
            handle = lib.sf_open_fd(clip.fileno(), 0x10, byref(info), 0)  # SFM_READ
            if not handle:
                raise ValueError("Color Relay audio could not be decoded")
            try:
                if (info.rate, info.channels) != (SAMPLE_RATE, 1) or not 0 < info.frames < 20 * SAMPLE_RATE:
                    raise ValueError("Unexpected format in Color Relay audio")
                pcm = (c_int16 * info.frames)()
                frames = lib.sf_readf_short(handle, pcm, info.frames)
                if frames <= 0:
                    raise ValueError("Empty Color Relay audio clip")
                samples = array("h")
                samples.frombytes(bytes(pcm)[:frames * 2])
                decoded.append(samples)
            finally:
                lib.sf_close(handle)
    tracks = [decoded[i] + decoded[i + 1] for i in range(0, 8, 2)]
    return tracks, dict(zip(CUES, decoded[8:]))


class Mixer:
    def __init__(self, tracks, cues):
        self.tracks = tracks
        self.cues = cues
        self.mode = 0
        self.playing = False
        self.position = 0
        self.cue = ()
        self.cue_position = 0

    @property
    def active(self):
        return self.playing or self.cue_position < len(self.cue)

    def update(self, mode, event):
        if mode != self.mode:
            self.mode = mode
            self.position = 0
            self.cue = ()
            self.cue_position = 0
        self.playing = event in ("play", "match", "miss")
        if event == "mute":
            self.cue = ()
            self.cue_position = 0
        elif event in self.cues:
            self.cue = self.cues[event]
            self.cue_position = 0

    def render(self):
        samples = array("h", [0]) * BLOCK_SIZE
        if self.playing:
            track = self.tracks[self.mode]
            end = self.position + BLOCK_SIZE
            samples = track[self.position:end]
            if len(samples) < BLOCK_SIZE:
                samples.extend(track[:BLOCK_SIZE - len(samples)])
            self.position = end % len(track)

        cue_block = self.cue[self.cue_position:self.cue_position + BLOCK_SIZE]
        for i, sample in enumerate(cue_block):
            # The clips leave room for both signals at full level.
            samples[i] = max(-32768, min(32767, samples[i] + sample))
        self.cue_position += len(cue_block)
        return samples.tobytes()


class SampleSpec(Structure):
    _fields_ = [("format", c_int), ("rate", c_uint32), ("channels", c_uint8)]


class BufferAttributes(Structure):
    _fields_ = [(name, c_uint32) for name in ("maxlength", "tlength", "prebuf", "minreq", "fragsize")]


class PulseOutput:
    def __init__(self):
        self.lib = CDLL("libpulse-simple.so.0")
        self.lib.pa_simple_new.argtypes = [
            c_char_p, c_char_p, c_int, c_char_p, c_char_p,
            POINTER(SampleSpec), c_void_p, POINTER(BufferAttributes), POINTER(c_int),
        ]
        self.lib.pa_simple_new.restype = c_void_p
        self.lib.pa_simple_write.argtypes = [c_void_p, c_char_p, c_size_t, POINTER(c_int)]
        self.lib.pa_simple_flush.argtypes = [c_void_p, POINTER(c_int)]
        self.lib.pa_simple_drain.argtypes = [c_void_p, POINTER(c_int)]
        self.lib.pa_simple_free.argtypes = [c_void_p]
        self.lib.pa_simple_free.restype = None
        self.error = c_int()
        spec = SampleSpec(3, SAMPLE_RATE, 1)  # PA_SAMPLE_S16LE
        # The Android pipe sink can consume audio in bursts. Keep enough queued
        # to cover those bursts instead of repeatedly underrunning and refilling.
        buffer = BufferAttributes(
            500 * BYTES_PER_MILLISECOND,
            300 * BYTES_PER_MILLISECOND,
            200 * BYTES_PER_MILLISECOND,
            50 * BYTES_PER_MILLISECOND,
            0xFFFFFFFF,
        )
        self.handle = self.lib.pa_simple_new(
            None, b"Color Relay", 1, None, b"Soundtrack and feedback",
            byref(spec), None, byref(buffer), byref(self.error),
        )
        if not self.handle:
            raise OSError(f"Opening PulseAudio failed ({self.error.value})")

    def write(self, samples):
        if self.lib.pa_simple_write(self.handle, samples, len(samples), byref(self.error)) < 0:
            raise OSError(f"Writing to PulseAudio failed ({self.error.value})")

    def close(self, drain=False):
        finish = self.lib.pa_simple_drain if drain else self.lib.pa_simple_flush
        finish(self.handle, byref(self.error))
        self.lib.pa_simple_free(self.handle)


def serve():
    mixer = Mixer(*load_audio())
    output = None
    deadline = 0
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as receiver:
        receiver.bind(ADDRESS)
        receiver.setblocking(False)
        print("ready", flush=True)
        try:
            while True:
                readable, _, _ = select.select([receiver], [], [], 0 if output else None)
                if readable:
                    while True:
                        try:
                            message = receiver.recv(64).decode("ascii", errors="replace").split()
                        except BlockingIOError:
                            break
                        if len(message) != 2 or message[0] not in ("0", "1", "2", "3") or message[1] not in EVENTS:
                            continue
                        mode, event = int(message[0]), message[1]
                        mixer.update(mode, event)
                        deadline = monotonic() + KEEPALIVE_SECONDS
                        if event == "mute" and output:
                            output.close()
                            output = None
                if output and monotonic() >= deadline:
                    mixer.update(mixer.mode, "mute")
                    output.close()
                    output = None
                if mixer.active:
                    if output is None:
                        output = PulseOutput()
                    output.write(mixer.render())
                elif output:
                    output.close(drain=True)
                    output = None
        finally:
            if output:
                output.close()


serve()
'""")

  state mode = 0
  state target = random(80)
  state dealSeed = random(1000000)
  state score = 0
  state remaining = 0
  state missed = -1
  state feedback = ""
  state pickedSlot = -1
  state playedCard = null
  state previousHand = []
  state transitionTime = 0
  state audioEnabled = true persist
  let goal = 10
  let modes = [
    {name: "Untimed", seconds: 0},
    {name: "Easy", seconds: 12},
    {name: "Normal", seconds: 7},
    {name: "Hard", seconds: 4}
  ]
  let suits = [
    {name: "Red", mark: "●", paper: #D81F3E, stripe: #B31632, ink: #FFFFFF},
    {name: "Green", mark: "◆", paper: #83DF47, stripe: #5BBF31, ink: #173909},
    {name: "Blue", mark: "■", paper: #2065D8, stripe: #164CB3, ink: #FFFFFF},
    {name: "Yellow", mark: "▲", paper: #FFDA36, stripe: #E6AC14, ink: #503500},
    {name: "Purple", mark: "✦", paper: #8143CB, stripe: #6731A9, ink: #FFFFFF},
    {name: "Teal", mark: "✚", paper: #21D6C7, stripe: #11B7AC, ink: #073E3D},
    {name: "Pink", mark: "◒", paper: #F673CA, stripe: #D650AE, ink: #4F123B},
    {name: "Orange", mark: "✿", paper: #FF952E, stripe: #DF6D17, ink: #542600}
  ]
  let seaInk = #143F60
  let mutedInk = #31566C
  let alertInk = #A72741
  let deck = range(len(suits) * 10).map(id => {id: id, suit: floor(id / 10), digit: id % 10})
  let topCard = deck[target]
  // Choose the matching rule for this deal, then draw five cards that fail both rules.
  let sameColor = deck.filter(card => card.suit == topCard.suit && card.digit != topCard.digit)
  let sameNumber = deck.filter(card => card.suit != topCard.suit && card.digit == topCard.digit)
  let decoys = deck.filter(card => card.suit != topCard.suit && card.digit != topCard.digit)
  let matches = dealSeed % 2 == 0 ? sameColor : sameNumber
  let answer = first(shuffle(matches, dealSeed))
  let hand = shuffle([answer] + take(shuffle(decoys, dealSeed + 1), 5), dealSeed + 2)
  let limit = modes[mode].seconds
  let won = score >= goal
  let expired = mode != 0 && remaining <= 0
  let finished = won || expired
  let transitioning = pickedSlot >= 0
  let lastMatch = transitioning && score == goal - 1
  let flightSeconds = 0.36
  let flipSeconds = 0.32
  let flipStagger = 0.018
  let transitionSeconds = flightSeconds + (lastMatch ? 0.18 : flipSeconds + 5 * flipStagger)
  let urgent = !won && mode != 0 && remaining <= 2
  let viewHeight = screenHeight ?? 730
  let cardHeight = clamp(viewHeight * 0.15, 74, 126)
  let stageHeight = clamp(viewHeight * 0.29, 141, 213)
  let sectionGap = clamp(viewHeight * 0.021, 9, 17)
  let handInset = clamp((viewHeight - 650) * 0.22, 0, 32)
  let boardWidth = min(440, (screenWidth ?? 380) - 32)
  let targetTop = stageHeight * 0.20
  let targetWidth = stageHeight * 0.54
  let targetHeight = stageHeight * 0.70
  let handLabelHeight = 24
  let cardGap = 8
  let slotWidth = (boardWidth - 2 * cardGap) / 3
  let handTop = stageHeight + sectionGap + handInset + handLabelHeight + cardGap

  // Start automatically and renew playback while this app is visible.
  every 1s {
    if audioEnabled && !finished && !lastMatch {
      run("python3 -c 'import os, socket, sys\naddress = f\"\\0omalauncher-color-relay-store-{os.getuid()}\"\nwith socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sender:\n    sender.setblocking(False)\n    try:\n        sender.sendto(\" \".join(sys.argv[1:]).encode(), address)\n    except (FileNotFoundError, ConnectionRefusedError, BlockingIOError):\n        pass' ${int(mode)} play")
    }
  }

  fps: transitioning ? 60 : (!finished && mode != 0 ? 24 : 1)
  every frame {
    let clockRuns = mode != 0 && !finished && !transitioning
    let outOfTime = clockRuns && remaining <= dt
    if clockRuns {
      remaining = max(0, remaining - dt)
    }
    if transitioning {
      let nextTime = transitionTime + dt
      if transitionTime < flightSeconds && nextTime >= flightSeconds {
        target = playedCard.id
        dealSeed = random(1000000)
      }
      transitionTime = nextTime
      if nextTime >= transitionSeconds {
        score = score + 1
        remaining = limit
        pickedSlot = -1
        playedCard = null
        previousHand = []
        transitionTime = 0
      }
    }
    if outOfTime && audioEnabled {
      run("python3 -c 'import os, socket, sys\naddress = f\"\\0omalauncher-color-relay-store-{os.getuid()}\"\nwith socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sender:\n    sender.setblocking(False)\n    try:\n        sender.sendto(\" \".join(sys.argv[1:]).encode(), address)\n    except (FileNotFoundError, ConnectionRefusedError, BlockingIOError):\n        pass' ${int(mode)} timeout")
    }
  }

  component StartControl(modeIndex, replay = false) {
    let selected = modeIndex == mode
    let choice = modes[modeIndex]
    let primary = selected || replay
    Box {
      fill: width
      height: replay ? 48 : 51
      radius: 16
      align: center
      background: primary ? #176492 : #F8FEFF
      border: 1
      borderColor: primary ? #176492 : #83C9DC
      onTap: {
        if replay || !selected {
          remaining = choice.seconds
          mode = modeIndex
          target = random(len(deck))
          dealSeed = random(1000000)
          score = 0
          missed = -1
          feedback = ""
          pickedSlot = -1
          playedCard = null
          previousHand = []
          transitionTime = 0
        }
        if audioEnabled {
          run("python3 -c 'import os, socket, sys\naddress = f\"\\0omalauncher-color-relay-store-{os.getuid()}\"\nwith socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sender:\n    sender.setblocking(False)\n    try:\n        sender.sendto(\" \".join(sys.argv[1:]).encode(), address)\n    except (FileNotFoundError, ConnectionRefusedError, BlockingIOError):\n        pass' ${int(modeIndex)} play")
        }
      }
      Column {
        fill: width
        gap: 1
        Text {
          text: replay ? "Play again" : choice.name
          font: sans
          fontSize: replay ? 15 : 13
          fontWeight: 750
          color: primary ? #FFFFFF : seaInk
          align: center
        }
        if !replay {
          Text {
            text: choice.seconds == 0 ? "No limit" : "${choice.seconds} s"
            font: mono
            fontSize: 10
            color: selected ? #DDF7FF : mutedInk
            align: center
          }
        }
      }
    }
  }

  component PlayingCard(card, tallness, emphasis = 0, faceScale = 1, showBack = false) {
    let suit = suits[card.suit]
    let textFade = clamp((faceScale - 0.35) / 0.45, 0, 1)
    Box {
      fill: width
      height: tallness
      align: center
      radius: lerp(16, 20, emphasis) * faceScale
      clip: true
      background: showBack ? #176492 : suit.paper
      border: 1
      borderColor: showBack ? #0F4B70 : suit.stripe
      if showBack {
        Canvas {
          fill: true
          rect(width * 0.09, 7, width * 0.82, height - 14, radius: 10 * faceScale, stroke: #91DDED, width: 1.5)
          circle(width / 2, height * 0.42, min(width * 0.16, height * 0.14), fill: #FFD736)
          let wave = range(13).map(i => [width * (0.20 + i * 0.05), height * (0.61 + 0.036 * sin(i * 0.72))])
          path(wave, stroke: #91DDED, width: 3, cap: round)
        }
      } else {
        Box {
          fill: true
          align: bottom
          Box { fill: width; height: 8; background: suit.stripe }
        }
        Box {
          fill: true
          align: topStart
          padding: [9 * faceScale, 5, 8 * faceScale, 0]
          opacity: textFade
          Text { text: suit.mark; font: sans; fontSize: lerp(12, 16, emphasis); color: suit.ink }
        }
        Column {
          fill: width
          align: center
          gap: 0
          opacity: textFade
          Text {
            text: "${card.digit}"
            font: sans
            fontSize: tallness * lerp(0.46, 0.55, emphasis) * max(0.65, faceScale)
            fontWeight: 900
            color: suit.ink
            align: center
            maxLines: 1
          }
          Text {
            text: suit.name
            font: sans
            fontSize: lerp(13, 15, emphasis) * max(0.65, faceScale)
            fontWeight: 750
            color: suit.ink
            align: center
            maxLines: 1
          }
        }
      }
    }
  }

  Column {
    fill: true
    scroll: true
    align: center
    padding: [16, sectionGap + handInset * 0.25, 16, 12]
    background: linear(0, 0, 0, 1, [#BFEFFF, #E5F8F6, #FFF2D3, #FFE8B5])
    Column {
      width: boardWidth
      gap: sectionGap

      Column {
        gap: 1
        Row {
          fill: width
          align: center
          Text {
            text: "Color Relay"
            weight: 1
            font: sans
            fontSize: boardWidth < 300 ? 34 : 41
            fontWeight: 900
            letterSpacing: -1.4
            color: seaInk
          }
          Box {
            width: 82
            height: 44
            align: center
            radius: 14
            background: #F8FEFF
            border: 1
            borderColor: #83C9DC
            onTap: {
              audioEnabled = !audioEnabled
              let event = !audioEnabled ? "mute" : (finished || lastMatch ? "idle" : "play")
              run("python3 -c 'import os, socket, sys\naddress = f\"\\0omalauncher-color-relay-store-{os.getuid()}\"\nwith socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sender:\n    sender.setblocking(False)\n    try:\n        sender.sendto(\" \".join(sys.argv[1:]).encode(), address)\n    except (FileNotFoundError, ConnectionRefusedError, BlockingIOError):\n        pass' ${int(mode)} ${sh(event)}")
            }
            Text {
              text: audioEnabled ? "Sound on" : "Sound off"
              font: sans
              fontSize: 12
              fontWeight: 750
              align: center
              color: seaInk
            }
          }
        }
        Text { text: "Match the color or number."; font: sans; fontSize: 15; color: mutedInk }
      }

      Row {
        fill: width
        gap: 6
        for i in range(len(modes)) {
          StartControl { modeIndex: i; weight: 1 }
        }
      }

      Column {
        fill: width
        gap: 5
        Row {
          fill: width
          align: center
          Text {
            text: "${score} / ${goal} matches"
            weight: 1
            font: mono
            fontSize: 12
            color: seaInk
          }
          if mode != 0 && !won {
            Text {
              text: "${ceil(remaining)} s left"
              font: mono
              fontSize: 12
              color: urgent ? alertInk : seaInk
            }
          }
        }
        Progress {
          fill: width
          height: 5
          value: mode == 0 || won ? score / goal : remaining / limit
          max: 1
          color: urgent ? #D7394D : #1686A3
          track: #B5DCE2
        }
      }

      if finished {
        Column {
          fill: width
          height: stageHeight + cardHeight
          align: center
          justify: center
          gap: 11
          padding: 20
          background: #FEFAEA
          border: 1
          borderColor: #E7C981
          radius: 24
          Text { text: won ? "Relay complete" : "Time’s up"; align: center; font: sans; fontSize: 33; fontWeight: 900; color: seaInk }
          Text {
            text: won ? "You matched all ${goal} cards." : "You matched ${score} of ${goal} cards."
            align: center
            font: sans
            fontSize: 15
            color: mutedInk
          }
          Spacer { height: 6 }
          StartControl { modeIndex: mode; replay: true; width: 156 }
        }
      } else {
        Box {
          fill: width
          align: topStart
          Column {
            fill: width
            gap: 0
            Box {
              fill: width
              height: stageHeight
              align: top
              radius: 24
              clip: true
              background: linear(0, 0, 0, 1, [#79DDFC, #D4F8FF])
              border: 1
              borderColor: #77CADD
              Canvas {
                fill: true
                let sunX = width * 0.84
                let sunY = height * 0.29
                let sunSize = height * 0.105
                circle(sunX, sunY, sunSize, fill: #FFD736)
                for ray in range(8) {
                  rotate(ray * 45, sunX, sunY) {
                    line(sunX, sunY - sunSize - 4, sunX, sunY - sunSize - 9, stroke: #FFD736, width: 2, cap: round)
                  }
                }
                rect(width * 0.065, height * 0.30, width * 0.17, height * 0.10, radius: 10, fill: #EFFEFF)
                circle(width * 0.14, height * 0.29, height * 0.065, fill: #EFFEFF)
                circle(width * 0.19, height * 0.30, height * 0.047, fill: #EFFEFF)
                let sea = range(33).map(i => [width * i / 32, height * (0.55 + 0.038 * sin(i * 0.31))])
                let shore = range(33).map(i => [width * i / 32, height * (0.80 + 0.055 * sin(i * 0.25 + 0.6))])
                path(sea + [[width, height], [0, height]], closed: true, fill: #28B8D3)
                path(shore + [[width, height], [0, height]], closed: true, fill: #FFE6A9)
                path(shore, stroke: #FBFFED, width: 4)
              }
              Column {
                align: center
                gap: 0
                Box {
                  height: targetTop
                  fill: width
                  align: center
                  Text { text: "Target card"; align: center; font: sans; fontSize: 14; fontWeight: 800; color: seaInk }
                }
                PlayingCard { card: topCard; tallness: targetHeight; emphasis: 1; width: targetWidth }
              }
            }

            Spacer { height: sectionGap + handInset }
            Column {
              fill: width
              gap: cardGap
              Row {
                fill: width
                height: handLabelHeight
                align: center
                Text { text: "Your hand"; weight: 1; font: sans; fontSize: 17; fontWeight: 800; color: seaInk }
                Text {
                  text: feedback == "" ? "Find the only match" : feedback
                  font: sans
                  fontSize: 13
                  color: missed >= 0 ? alertInk : mutedInk
                }
              }
              for rowIndex in range(2) {
                Row {
                  fill: width
                  gap: cardGap
                  for columnIndex in range(3) {
                    let slot = rowIndex * 3 + columnIndex
                    let card = hand[slot]
                    let flip = transitioning && !lastMatch ? clamp((transitionTime - flightSeconds - slot * flipStagger) / flipSeconds, 0, 1) : 0
                    let faceScale = max(0.055, abs(cos(flip * 2 * pi)))
                    let hidePicked = transitioning && slot == pickedSlot && flip < 0.25
                    Box {
                      width: slotWidth
                      height: cardHeight
                      radius: 16
                      align: center
                      opacity: hidePicked ? 0 : (card.id == missed ? 0.56 : 1)
                      onTap: {
                        if !finished && !transitioning {
                            let correct = card.suit == topCard.suit || card.digit == topCard.digit
                            if correct {
                            feedback = card.suit == topCard.suit ? "Color match!" : "Number match!"
                            previousHand = hand
                            playedCard = card
                            missed = -1
                            transitionTime = 0
                            pickedSlot = slot
                            haptic()
                          } else {
                            missed = card.id
                            feedback = "Try another card"
                            }
                            if audioEnabled {
                              let cue = !correct ? "miss" : (score == goal - 1 ? "win" : "match")
                              run("python3 -c 'import os, socket, sys\naddress = f\"\\0omalauncher-color-relay-store-{os.getuid()}\"\nwith socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sender:\n    sender.setblocking(False)\n    try:\n        sender.sendto(\" \".join(sys.argv[1:]).encode(), address)\n    except (FileNotFoundError, ConnectionRefusedError, BlockingIOError):\n        pass' ${int(mode)} ${sh(cue)}")
                          }
                        }
                      }
                      PlayingCard {
                        card: transitioning && flip < 0.75 ? previousHand[slot] : card
                        tallness: cardHeight
                        width: slotWidth * faceScale
                        faceScale: faceScale
                        showBack: flip >= 0.25 && flip < 0.75
                      }
                    }
                  }
                }
              }
            }
          }
          if transitioning && transitionTime < flightSeconds {
            let progress = clamp(transitionTime / flightSeconds, 0, 1)
            let eased = progress * progress * (3 - 2 * progress)
            let arc = sin(progress * pi)
            let columnIndex = pickedSlot % 3
            let launchX = columnIndex * (slotWidth + cardGap) + slotWidth / 2
            let launchY = handTop + floor(pickedSlot / 3) * (cardHeight + cardGap) + cardHeight / 2
            let flyingWidth = lerp(slotWidth, targetWidth, eased)
            let flyingHeight = lerp(cardHeight, targetHeight, eased)
            let centerX = lerp(launchX, boardWidth / 2, eased) + (columnIndex == 2 ? -1 : 1) * arc * 20
            let centerY = lerp(launchY, targetTop + targetHeight / 2, eased) - arc * 24
            Box {
              width: flyingWidth
              height: flyingHeight
              offset: [centerX - flyingWidth / 2, centerY - flyingHeight / 2]
              rotation: (columnIndex == 2 ? -1 : 1) * arc * 13
              PlayingCard { card: playedCard; tallness: flyingHeight; emphasis: eased }
            }
          }
        }
      }
    }
  }

  // Original soundtrack and feedback clips, concatenated as MP3 data.
  asset relayAudioPack = base64""
}
