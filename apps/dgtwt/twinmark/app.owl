     [#DA7B28, [[-8,34],[8,34],[0,46]]]],
    // 26 · Pennant
    [[#8A4A2B, [[-31,-41],[-24,-41],[-24,44],[-31,44]]],
     [#D75342, [[-24,-36],[37,-36],[15,-16],[37,5],[-24,5]]],
