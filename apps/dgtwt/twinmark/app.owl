    // 66 · Ice-cream cone
    [[#A36532, [[-23,2],[23,2],[0,44]]],
     [#B75C8B, [[-28,4],[-34,-6],[-31,-18],[-23,-25],[-15,-35],[-3,-42],[9,-41],[20,-34],[25,-24],[33,-14],[33,-4],[27,5],[11,8],[-12,7]]],
     [#F3B6D2, [[-19,-18],[-11,-29],[-3,-32],[3,-28],[-7,-24],[-12,-15]]]],
    // 67 · Lighthouse
    [[#A23F48, [[-18,-27],[18,-27],[26,39],[-26,39]]],
     [#F1C0A0, [[-21,-5],[21,-5],[23,10],[-23,10]], [[-25,24],[25,24],[26,38],[-26,38]]],
     [#744556, [[-25,-27],[0,-43],[25,-27]], [[-31,40],[31,40],[31,45],[-31,45]]],
     [#E9AD52, [[-10,-24],[10,-24],[10,-12],[-10,-12]], [[23,-21],[43,-27],[43,-12],[23,-15]]]],
    // 68 · Compass
    [[#5268A5, [[-42,0],[-36,-21],[-21,-36],[0,-42],[21,-36],[36,-21],[42,0],[36,21],[21,36],[0,42],[-21,36],[-36,21]]],
     [#BECDE7, [[-33,0],[-27,-16],[-16,-27],[0,-33],[16,-27],[27,-16],[33,0],[27,16],[16,27],[0,33],[-16,27],[-27,16]]],
     [#AB4656, [[22,-23],[7,7],[-7,-7]]],
     [#36518B, [[-22,23],[-7,-7],[7,7]]]],
    // 69 · Acorn
    [[#9A5425, [[-30,-5],[30,-5],[28,15],[20,30],[9,38],[0,44],[-9,38],[-20,30],[-28,15]]],
     [#6E4C37, [[-39,-5],[-35,-17],[-20,-26],[-7,-27],[-4,-39],[7,-44],[12,-35],[4,-26],[20,-26],[35,-17],[39,-5],[26,1],[-26,1]]],
     [#E4A455, [[-18,9],[-11,7],[-8,18],[-3,29],[-10,28],[-16,19]]]],
    // 70 · Whale
    [[#286F97, [[-44,2],[-38,-15],[-25,-22],[-8,-19],[7,-9],[21,-3],[27,-8],[23,-15],[22,-25],[31,-22],[36,-16],[42,-26],[46,-21],[45,-10],[35,-3],[32,12],[19,23],[2,29],[-22,29],[-36,21]]],
     [#ACD5E1, [[-38,14],[-23,19],[-4,20],[13,17],[8,24],[-7,29],[-23,27],[-34,22]], [[-29,-5],[-22,-5],[-22,1],[-29,1]]]],
    // 71 · Bowling pin
    [[#49669E, [[-6,-42],[6,-42],[12,-35],[11,-23],[7,-14],[9,-5],[20,14],[22,29],[16,40],[-16,40],[-22,29],[-20,14],[-9,-5],[-7,-14],[-11,-23],[-12,-35]]],
     [#BBCDE5, [[-8,-20],[8,-20],[7,-14],[-7,-14]], [[-8,-9],[8,-9],[11,-3],[-11,-3]], [[-9,14],[-3,12],[-5,31],[-11,32]]]],
    // 72 · Book
    [[#854E96, [[-43,-31],[-24,-34],[-9,-28],[0,-21],[9,-28],[24,-34],[43,-31],[43,28],[25,25],[10,29],[0,36],[-10,29],[-25,25],[-43,28]]],
     [#D6B6E6, [[-34,-23],[-23,-24],[-9,-19],[-9,22],[-24,16],[-34,17]], [[34,-23],[23,-24],[9,-19],[9,22],[24,16],[34,17]]],
     [#945AA8, [[-29,-16],[-15,-13],[-15,-9],[-29,-12]], [[29,-16],[15,-13],[15,-9],[29,-12]]]]
  ]

  let boardWidth = 780
  let boardHeight = 360
  let boardMidX = boardWidth / 2
  let boardMidY = boardHeight / 2
  let frameWidth = screenWidth ?? boardWidth
  let safeTop = screenTop ?? 0
  let frameHeight = max(1, (screenHeight ?? boardHeight) - safeTop)
  // OWL cannot request an Android orientation. Turn the board within a portrait window.
  let sideways = frameHeight > frameWidth
  let centerX = frameWidth / 2
  let centerY = safeTop + frameHeight / 2
  let boardScale = min((sideways ? frameHeight : frameWidth) / boardWidth,
    (sideways ? frameWidth : frameHeight) / boardHeight)
  let cardLeft = [12, 438]
  let cardTop = 12
  let cardWidth = 330
  let cardHeight = 330
  let edgeGap = 9
  let symbolGap = 8
  let slotsOnCard = range(9)
  let startingCenters = [[56, 57], [161, 55], [273, 59], [58, 165], [164, 160], [271, 166], [57, 274], [163, 271], [273, 273]]
  let marks = dealSeeds.map((seed, side) => shuffle(cards[activeCards[side]], seed))
  let sizes = dealSeeds.map(seed => slotsOnCard.map(i => 0.43 + 0.32 * hash(seed, i, "size")))
  let shapeRadii = range(21).map(i => 53) + newSymbols.map(layers =>
    1 + sqrt(reduce(flatten(layers.map(layer => drop(layer, 1)), 2), (largest, vertex) =>
      max(largest, vertex[0] * vertex[0] + vertex[1] * vertex[1]), 0)))
  // Enclose every rotated silhouette in a circle. Leave 8 dp between circles and at least 9 dp from the outer edge.
  let initialLayout = sizes.map((sideSizes, side) => slotsOnCard.map(i => {
    slot: i, cx: startingCenters[i][0], cy: startingCenters[i][1], radius: shapeRadii[marks[side][i]] * sideSizes[i],
    zoom: sideSizes[i], turn: 360 * hash(dealSeeds[side], i, "angle") - 180
  }))
  // Scatter the largest symbols first. Sample the full usable face for each symbol.
  let candidateCenters = initialLayout.map((layout, side) => layout.map(item => range(52).map(attempt => {
    cx: lerp(edgeGap + item.radius, cardWidth - edgeGap - item.radius, hash(dealSeeds[side], item.slot, attempt, "scatter x")),
    cy: lerp(edgeGap + item.radius, cardHeight - edgeGap - item.radius, hash(dealSeeds[side], item.slot, attempt, "scatter y"))
  })))
  let scattered = initialLayout.map((layout, side) => reduce(layout.sortBy(item => -item.radius), (placed, item) =>
    reduce([candidateCenters[side][item.slot].find(point => placed.all(other =>
      pow(point.cx - other.cx, 2) + pow(point.cy - other.cy, 2) >= pow(item.radius + other.radius + symbolGap, 2)))],
      (current, point) => point == null ? current : current + [merge(item, point)], placed), []))
  // If a scatter gets crowded, start from safe spacing and shuffle positions with bounded moves.
  let proposals = dealSeeds.map(seed => range(216).map(step => {
    slot: floor(9 * hash(seed, step, "slot")),
    wide: step % 3 == 0,
    ux: hash(seed, step, "x"),
    uy: hash(seed, step, "y")
  }))
  let layouts = initialLayout.map((layout, side) => len(scattered[side]) == len(layout) ? scattered[side] : reduce(proposals[side], (placed, move) =>
    reduce([{
      cx: move.wide ? move.ux * cardWidth : placed[move.slot].cx + (move.ux - 0.5) * 90,
      cy: move.wide ? move.uy * cardHeight : placed[move.slot].cy + (move.uy - 0.5) * 90,
      radius: placed[move.slot].radius
    }], (current, point) =>
      point.cx >= edgeGap + point.radius && point.cx <= cardWidth - edgeGap - point.radius &&
      point.cy >= edgeGap + point.radius && point.cy <= cardHeight - edgeGap - point.radius &&
      current.all(other => other.slot == move.slot ||
        pow(point.cx - other.cx, 2) + pow(point.cy - other.cy, 2) >= pow(point.radius + other.radius + symbolGap, 2))
      ? set(current, move.slot, merge(current[move.slot], point)) : current, placed), layout))
  // Enlarge symbols in place. Each symbol sees the radii that have already grown.
  let filledLayouts = layouts.map(layout => reduce(layout, (filled, item, index) =>
    reduce([reduce(filled, (limit, other) => other.slot == item.slot ? limit :
      min(limit, sqrt(pow(item.cx - other.cx, 2) + pow(item.cy - other.cy, 2)) - other.radius - symbolGap),
      min(item.radius * 1.5, item.radius / item.zoom * 1.04,
        min(item.cx, cardWidth - item.cx, item.cy, cardHeight - item.cy) - edgeGap))],
      (current, radius) => set(current, index, merge(item, {radius: radius, zoom: item.zoom * radius / item.radius})),
      filled), layout))
  let symbols = filledLayouts.map((layout, side) => layout.map(item => merge(item, {mark: marks[side][item.slot]})))

  let resetWidth = 82
  let resetHeight = 50
  let resetLeft = boardMidX - resetWidth / 2
  let resetTop = boardMidY - resetHeight / 2
  let helpTop = resetTop + resetHeight + 12
  let helpHeight = 48
  let guideWidth = 422
  let guideHeight = 268
  let guideLeft = boardMidX - guideWidth / 2
  let guideTop = boardMidY - guideHeight / 2
  let doneLeft = boardMidX - 58
  let doneTop = guideTop + 202
  let doneWidth = 116
  let doneHeight = 48
  let scoreText = "${pad(scores[0], 2, "0")}:${pad(scores[1], 2, "0")}"
  let sideInk = [#FFBC87, #9ADFC8]
  let cardPaper = [#FFF1DF, #EEFAEF]
  let cardTrim = [#D9A57E, #90C7B3]

  every frame {
    if flipSide >= 0 {
      flipTime = flipTime + dt
      if flipTime >= 0.32 && nextCard >= 0 {
        activeCards = set(activeCards, flipSide, nextCard)
        dealSeeds = set(dealSeeds, flipSide, random(1000000))
        nextCard = -1
      }
      if flipTime >= 0.64 {
        flipSide = -1
        flipTime = 0
      }
    }
    if missTime > 0 { missTime = max(0, missTime - dt) }
  }

  Canvas {
    fill: true
    ripple: false
    onTap: {
      // Undo the exact transform used for the board before testing any hit areas.
      let tapX = (sideways ? y - centerY : x - centerX) / boardScale + boardMidX
      let tapY = (sideways ? centerX - x : y - centerY) / boardScale + boardMidY
      if helpOpen {
        let outsideGuide = tapX < guideLeft || tapX > guideLeft + guideWidth || tapY < guideTop || tapY > guideTop + guideHeight
        let pressedDone = tapX >= doneLeft && tapX <= doneLeft + doneWidth && tapY >= doneTop && tapY <= doneTop + doneHeight
        if outsideGuide || pressedDone { helpOpen = false }
      } else if tapX >= resetLeft && tapX <= resetLeft + resetWidth && tapY >= helpTop && tapY <= helpTop + helpHeight {
        helpOpen = true
      } else if tapX >= resetLeft && tapX <= resetLeft + resetWidth && tapY >= resetTop && tapY <= resetTop + resetHeight {
        scores = [0, 0]
      } else if flipSide < 0 && tapY >= cardTop && tapY <= cardTop + cardHeight {
        let pressedSide = tapX < boardMidX ? 0 : 1
        let localX = tapX - cardLeft[pressedSide]
        let localY = tapY - cardTop
        if localX >= 0 && localX <= cardWidth {
          let pair = symbols[pressedSide]
          let hits = slotsOnCard.map(i => {
            slot: i,
            distance: pow(localX - pair[i].cx, 2) + pow(localY - pair[i].cy, 2),
            radius: max(23, pair[i].radius)
          }).filter(hit => hit.distance <= pow(hit.radius, 2))
          let nearest = first(hits.sortBy(hit => hit.distance))
          if nearest != null {
            if pair[nearest.slot].mark == sharedSymbol {
              let choices = range(len(cards)).filter(n => !contains(cards[n], sharedSymbol))
              nextCard = choices[random(len(choices))]
              scores = set(scores, pressedSide, scores[pressedSide] + 1)
              missTime = 0
              flipTime = 0
              flipSide = pressedSide
              haptic()
            } else {
              missSide = pressedSide
              missSlot = nearest.slot
              missTime = 0.42
            }
          }
        }
      }
    }

    rect(0, 0, width, height, fill: linear(0, 0, sideways ? width : 0, sideways ? 0 : height, sideways
      ? [#112320, #142B28, #23413B] : [#23413B, #142B28, #112320]))
    rotate(sideways ? 90 : 0, centerX, centerY) {
      scale(boardScale, boardScale, centerX, centerY) {
        translate(centerX - boardMidX, centerY - boardMidY) {
          for side in range(2) {
            let leftEdge = cardLeft[side]
            let ink = sideInk[side]
            let flipping = flipSide == side
            let showingBack = flipping && flipTime >= 0.16 && flipTime < 0.48
            let angle = flipTime < 0.32 ? flipTime / 0.32 * 180 : (flipTime - 0.32) / 0.32 * 180
            let squash = flipping ? max(0.018, abs(cos(rad(angle)))) : 1
            translate(leftEdge, cardTop) {
              rect(2, 7, cardWidth - 2, cardHeight, radius: 20, fill: #0C1F1C)
              scale(1, squash, cardWidth / 2, cardHeight / 2) {
                if showingBack {
                  rect(0, 0, cardWidth, cardHeight, radius: 20, fill: #254A43, stroke: ink, width: 1.5)
                  rect(8, 8, cardWidth - 16, cardHeight - 16, radius: 14, stroke: ink, width: 1)
                  for row in range(9) {
                    for col in range(9) {
                      let dx = 25 + col * 35
                      let dy = 25 + row * 35
                      path([[dx, dy - 5], [dx + 4, dy], [dx, dy + 5], [dx - 4, dy]], closed: true, fill: alpha(ink, 0.32))
                    }
                  }
                  translate(cardWidth / 2, cardHeight / 2) {
                    rotate(180, 0, 0) {
                      circle(0, 0, 29, fill: ink)
                      path([[0, -21], [16, -2], [0, 18], [-16, -2]], closed: true, fill: #163631)
                      circle(0, -2, 5, fill: ink)
                    }
                  }
                } else {
                  rect(0, 0, cardWidth, cardHeight, radius: 20, fill: cardPaper[side])
                  rect(5, 5, cardWidth - 10, cardHeight - 10, radius: 16, stroke: cardTrim[side], width: 1)
                  for i in slotsOnCard {
                    let item = symbols[side][i]
                    let mark = item.mark
                    if missSide == side && missSlot == i && missTime > 0 {
                      circle(item.cx, item.cy, item.radius, stroke: alpha(#A63D3D, missTime / 0.42), width: 2)
                    }
                    translate(item.cx, item.cy) {
                      rotate(item.turn, 0, 0) {
                        scale(item.zoom, item.zoom, 0, 0) {
                          if mark == 0 {
                            path([[0,-43],[11,-14],[41,-13],[18,7],[25,36],[0,20],[-26,36],[-18,7],[-41,-13],[-11,-14]], closed: true, fill: #C26A16)
                            circle(0, 0, 6, fill: #FFE095)
                          } else if mark == 1 {
                            path([[12,-42],[-32,6],[-5,6],[-16,43],[33,-11],[6,-11]], closed: true, fill: #7451AF)
                          } else if mark == 2 {
                            circle(0, 2, 36, fill: #226E85)
                            circle(0, 2, 18, fill: cardPaper[side])
                            circle(26, -29, 12, fill: #42A2A7)
                          } else if mark == 3 {
                            path([[0,-42],[32,-23],[38,12],[17,36],[-17,36],[-38,12],[-32,-23]], closed: true, fill: #AF3E69)
                            path([[0,-42],[16,-10],[38,12],[-17,36],[-13,0]], closed: true, fill: #D56990)
                            path([[-13,0],[16,-10],[17,36]], closed: true, fill: #8D3158)
                          } else if mark == 4 {
                            for petal in range(5) {
                              rotate(petal * 72, 0, 0) { circle(0, -24, 15, fill: #B84848) }
                            }
                            circle(0, 0, 13, fill: #FFCF75)
                          } else if mark == 5 {
                            circle(-4, 0, 36, fill: #485EAE)
                            circle(12, -10, 29, fill: cardPaper[side])
                            circle(27, -26, 7, fill: #7987C7)
                          } else if mark == 6 {
                            path([[0,-42],[34,3],[34,22],[23,35],[0,41],[-23,35],[-34,22],[-34,3]], closed: true, fill: #197EAA)
                            line(-18, 14, -10, 25, stroke: #B4E5F1, width: 6, cap: round)
                          } else if mark == 7 {
                            path([[-40,-22],[-34,-32],[-19,-31],[0,-15],[19,-31],[34,-32],[40,-22],[33,27],[22,34],[0,16],[-22,34],[-33,27]], closed: true, fill: #943C80)
                            line(0, -15, 0, 16, stroke: #D989BA, width: 7)
                          } else if mark == 8 {
                            path([[0,-43],[34,-5],[22,-5],[42,26],[8,26],[8,42],[-8,42],[-8,26],[-42,26],[-22,-5],[-34,-5]], closed: true, fill: #34764D)
                          } else if mark == 9 {
                            path([[-39,-17],[39,-17],[24,26],[-24,26]], closed: true, fill: #A7592C)
                            path([[0,-43],[23,-17],[-23,-17]], closed: true, fill: #E6944D)
                            line(-34, -13, 32, -13, stroke: #FFC188, width: 6, cap: round)
                          } else if mark == 10 {
                            rect(-13, -41, 26, 82, radius: 8, fill: #8B3851)
                            rect(-41, -13, 82, 26, radius: 8, fill: #8B3851)
                            rect(-7, -7, 14, 14, radius: 4, fill: #E699A7)
                          } else if mark == 11 {
                            path([[-42,29],[-8,-37],[5,-12],[16,-30],[42,29]], closed: true, fill: #40579B)
                            path([[-24,-6],[-8,-37],[7,-8],[-8,-13]], closed: true, fill: #A7BEE6)
                          } else if mark == 12 {
                            circle(0, 0, 29, fill: #735297)
                            line(-37, 18, 36, -17, stroke: #AF86C2, width: 12, cap: round)
                            circle(32, -33, 6, fill: #735297)
                          } else if mark == 13 {
                            path([[-42,0],[-22,-20],[0,-26],[22,-20],[42,0],[22,20],[0,26],[-22,20]], closed: true, fill: #157567)
                            circle(0, 0, 15, fill: #A8DEC6)
                            circle(0, 0, 8, fill: #174F46)
                          } else if mark == 14 {
                            circle(0, -13, 27, fill: #B03D33)
                            line(0, 7, 0, 38, stroke: #B03D33, width: 10, cap: round)
                            circle(-9, -22, 7, fill: #FAB088)
                          } else if mark == 15 {
                            path([[-42,-20],[42,-20],[37,32],[-37,32]], closed: true, fill: #9C5C26)
                            line(-24, -21, -12, -37, stroke: #9C5C26, width: 9, cap: round)
                            line(24, -21, 12, -37, stroke: #9C5C26, width: 9, cap: round)
                            for reed in [-19, 0, 19] {
                              line(reed, -6, reed, 17, stroke: #F0BD76, width: 5, cap: round)
                            }
                          } else if mark == 16 {
                            circle(0, 0, 23, fill: #B96B16)
                            for ray in range(8) {
                              rotate(ray * 45, 0, 0) { line(0, -33, 0, -42, stroke: #B96B16, width: 6, cap: round) }
                            }
                          } else if mark == 17 {
                            path([[0,-40],[15,-20],[42,-22],[24,1],[31,33],[0,21],[-31,33],[-24,1],[-42,-22],[-15,-20]], closed: true, fill: #266A61)
                            path([[0,-40],[0,21],[-31,33],[-24,1],[-42,-22],[-15,-20]], closed: true, fill: #58AA89)
                          } else if mark == 18 {
                            path([[-40,-26],[-20,-26],[0,-7],[20,-26],[40,-26],[40,-6],[0,33],[-40,-6]], closed: true, fill: #AC4C38)
                            path([[-37,-26],[-20,-26],[0,-7],[20,-26],[37,-26],[0,12]], closed: true, fill: #DD866C)
                          } else if mark == 19 {
                            rect(-29, -33, 58, 72, radius: 10, fill: #3E6280)
                            rect(-18, -22, 36, 33, radius: 6, fill: #9ED5D9)
                            line(-11, 24, 11, 24, stroke: #ABC8D6, width: 6, cap: round)
                            line(0, -39, 0, -32, stroke: #3E6280, width: 9, cap: round)
                          } else if mark == 20 {
                            path([[-40,23],[-39,1],[-27,-20],[-8,-32],[13,-33],[31,-24],[41,-8],[41,12],[26,9],[15,18],[0,14],[-15,27]], closed: true, fill: #9A491E)
                            line(-25, 10, 25, -16, stroke: #FAC986, width: 5, cap: round)
                          } else {
                            for layer in newSymbols[mark - 21] {
                              for polygon in drop(layer, 1) {
                                path(polygon, closed: true, fill: layer[0])
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }

          rect(resetLeft, resetTop, resetWidth, resetHeight, radius: 15, fill: #0F2421,
            stroke: flipSide >= 0 ? sideInk[flipSide] : #5C7A70, width: 1)
          text(scoreText, boardMidX, boardMidY, size: min(23, 114 / len(scoreText)), font: mono,
            bold: true, align: center, color: #FFF4E4)
          rect(resetLeft, helpTop, resetWidth, helpHeight, radius: 15, fill: #0F2421, stroke: #5C7A70, width: 1)
          text("Help", boardMidX, helpTop + helpHeight / 2, size: 16, font: sans, bold: true, align: center, color: #FFF4E4)

          if helpOpen {
            rect(0, 0, boardWidth, boardHeight, fill: alpha(#081613, 0.76))
            rect(guideLeft, guideTop, guideWidth, guideHeight, radius: 22, fill: #142F2B, stroke: #84B7A7, width: 1.5)
            text("How to play", boardMidX, guideTop + 35, size: 27, font: serif, bold: true, align: center, color: #FFF4E4)
            text("Find the one symbol on both cards.", boardMidX, guideTop + 76, size: 17, font: sans, align: center, color: #FFF4E4)
            text("It may be a different size or angle.", boardMidX, guideTop + 99, size: 16, font: sans, align: center, color: #D4E4D9)
            text("Tap the match on either card. That side scores", boardMidX, guideTop + 137, size: 16, font: sans, align: center, color: #FFF4E4)
            text("one point, and its card flips to a new one.", boardMidX, guideTop + 159, size: 16, font: sans, align: center, color: #FFF4E4)
            text("Tap the score to reset both sides.", boardMidX, guideTop + 184, size: 16, font: sans, align: center, color: #D4E4D9)
            rect(doneLeft, doneTop, doneWidth, doneHeight, radius: 14, fill: #9ADFC8)
            text("Got it", boardMidX, doneTop + doneHeight / 2, size: 16, font: sans, bold: true, align: center, color: #12332D)
          }
        }
      }
    }
  }
}
