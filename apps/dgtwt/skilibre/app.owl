app "Skilibre" {
  meta {
    owl: 23
    description: "Carve down an endless pixel-art mountain. Race through slalom gates, take ski jumps, and stay ahead of the ridge beast and an avalanche."
    version: "1.0"
    license: "MIT"
    category: "games"
  }
  title: ""
  fps: mode == "run" || mode == "burial" ? 60 : 1
  back: mode == "run" || mode == "pause"
  onBack: {
    fingers = []
    hopQueued = false
    centerPress = null
    bestRun = recordToSave
    mode = mode == "run" ? "pause" : "ready"
  }

  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" shape-rendering="crispEdges">
    <rect width="256" height="256" rx="56" fill="#183348"/>
    <path fill="#38718a" d="M42 145h24v-20h20v-20h20v40h32v-20h20v-20h20v20h20v20h16v36H42z"/>
    <path fill="#9fc8d4" d="M56 176h144v24H56z"/>
    <path fill="#e8f5f2" d="M56 164h144v24H56zM72 188h112v12H72z"/>
    <path fill="#17374b" d="M92 168h64v-12h24v12h-12v12H92z"/>
    <path fill="#f6b552" d="M84 156h32v-12h24v-12h12v-12h24v12h-12v12h-12v12h-24v12H84z"/>
    <path fill="#f17d52" d="M100 108h20V96h36v12h12v24h-24v12h-24v-12h-20z"/>
    <path fill="#c34b48" d="M100 120h32v12h12v12h-24v-12h-20z"/>
    <path fill="#e8f5f2" d="M128 56h32v12h12v24h-16v12h-36V80h8z"/>
    <path fill="#183348" d="M144 80h28v12h-28z"/>
  </svg>"""

  state mode = "ready"
  // Keep the legacy score for installs that recorded a best before distance was saved.
  state best = 0 persist
  state bestRun = null persist
  state restart = 0
  state seed = 18
  state lives = 3
  state avalancheGap = null
  state burialStartGap = 0
  state burialTime = 0
  state fingers = []
  state centerPress = null
  state hopQueued = false
  state distance = 0
  state rider = 120
  state cameraX = 0
  state carve = 0
  state speed = 122
  state recovery = 0
  state airtime = 0
  state skiJumpEnd = null
  state airTotal = 0.42
  state lift = 0
  state tucked = false
  state bonus = 0
  state callout = ""
  state calloutFor = 0
  state reason = ""
  state huntStarted = false
  state caveX = null
  state caveSide = 1
  state hunterX = 120
  state hunterZ = 0
  state hunterVx = 0
  state hunterTurn = 0
  state nextHunterTurn = 0
  state hunting = false
  state huntTime = 0
  state stride = 0
  state traffic = []
  state trafficAt = 0
  state trafficGroup = 0

  let touchWidth = screenWidth ?? 400
  let fieldWidth = min(touchWidth, (screenHeight ?? 800) * 0.9)
  let gutter = (touchWidth - fieldWidth) / 2
  let slopeWidth = 240
  let unit = fieldWidth / slopeWidth
  let viewDepth = (screenHeight ?? 800) / unit
  let riderLine = clamp(viewDepth * 0.28, 54, 165)
  let metersPerUnit = 0.1
  let meters = floor(distance * metersPerUnit)
  let score = floor(distance * 0.65) + bonus
  let savedScore = bestRun.score ?? best
  let savedMeters = bestRun.meters
  let betterRun = score > savedScore || (score == savedScore && score > 0
    && (savedMeters == null || meters > savedMeters))
  let recordToSave = betterRun ? {score: score, meters: meters} : bestRun
  let bestLabel = "Best ${recordToSave.score ?? savedScore} pts · ${recordToSave.meters ?? (savedScore > 0 ? "—" : 0)} m"
  let ink = #183348
  let snow = #fcfeff
  let snowShade = #e8f0f7
  let gold = #f6b552
  let beastStartMeters = 1800
  let beastEscapeMeters = beastStartMeters + 300
  let avalancheStartMeters = 3000
  let burialSweepTime = 0.84
  let burialTotalTime = burialSweepTime + 0.36
  let caveZ = beastStartMeters / metersPerUnit + 75
  let slalomSpacing = 4
  let gateHalfWidth = 22
  let skiJumpSpacing = 1000 / metersPerUnit
  let skiJumpDistance = 100 / metersPerUnit
  let skiJumpHalfWidth = 23

  // Generate only the rows and sections near the camera. Section boundaries are
  // invisible and have no effect on movement.
  let rowLength = 85
  let firstRow = max(0, ceil((distance - riderLine - 40 - 92) / rowLength))
  let lastRow = floor((distance + viewDepth - riderLine + 40 - 92) / rowLength)
  // Keep kilometre jumps on the slalom route and leave its gates in place.
  let firstJump = max(1, floor(distance / skiJumpSpacing))
  let lastJump = ceil((distance + viewDepth + rowLength) / skiJumpSpacing)
  let skiJumpRows = range(firstJump, lastJump + 1)
    .map(jump => round((jump * skiJumpSpacing - 92) / rowLength))
    .map(row => row % slalomSpacing == 0 ? row + 1 : row)
  let rows = range(firstRow, lastRow + 1).map(row => {
    index: row,
    at: 92 + row * rowLength + (row == 0 ? 0 : round(hash(seed, row, 8) * 36 - 18))
  })
  let firstSection = floor((cameraX - 24) / slopeWidth)
  let lastSection = floor((cameraX + slopeWidth + 24) / slopeWidth)
  let course = flatten(range(firstSection, lastSection + 1).map(section => rows.map(row => merge(row, {
    section: section,
    origin: section * slopeWidth,
    center: section * slopeWidth + (section == 0 && row.index == 0 ? 120
      : round(120 + sin(row.index * 0.53 + seed + section * 1.58) * 48))
  })))).map(row => merge(row, {
    kind: row.section == 0 && skiJumpRows.indexOf(row.index) >= 0 ? "skiJump"
      : (row.section == 0 && row.index % slalomSpacing == 0 ? "gate"
      : ((row.index + row.section * 7) % 17 == 0 ? "ramp" : "clear")),
    obstacles: [
      {x: row.center - round(39 + 21 * hash(seed, row.section, row.index, 2)),
        rock: hash(seed, row.section, row.index, 0) < 0.28, present: hash(seed, row.section, row.index, 10) < 0.49},
      {x: row.center + round(39 + 21 * hash(seed, row.section, row.index, 3)),
        rock: hash(seed, row.section, row.index, 1) < 0.28, present: hash(seed, row.section, row.index, 11) < 0.49},
      {x: row.origin + round(10 + 220 * hash(seed, row.section, row.index, 4)),
        rock: false, present: hash(seed, row.section, row.index, 12) < 0.48}
    ].filter(obstacle => obstacle.present && abs(obstacle.x - row.center) > 30)
  }))

  let edgeBand = gutter + fieldWidth * 0.27
  let leftHold = any(fingers, f => f.x < edgeBand)
  let rightHold = any(fingers, f => f.x > touchWidth - edgeBand)

  on restart {
    bestRun = recordToSave
    seed = random(10000)
    lives = 3
    avalancheGap = null
    burialStartGap = 0
    burialTime = 0
    distance = 0
    rider = 120
    cameraX = 0
    carve = 0
    speed = 122
    recovery = 0
    airtime = 0
    skiJumpEnd = null
    airTotal = 0.42
    lift = 0
    tucked = false
    bonus = 0
    callout = "SLALOM AHEAD"
    calloutFor = 1.4
    reason = ""
    huntStarted = false
    caveX = null
    caveSide = 1
    hunterX = 120
    hunterZ = 0
    hunterVx = 0
    hunterTurn = 0
    nextHunterTurn = 0
    hunting = false
    huntTime = 0
    stride = 0
    traffic = []
    trafficAt = 0
    trafficGroup = 0
    fingers = []
    centerPress = null
    hopQueued = false
    mode = "run"
  }

  // Save improving scores during longer runs as well as on pause and game over.
  every 5s {
    if mode == "run" && betterRun { bestRun = recordToSave }
  }

  // OWL suspends frame triggers when the app is off screen or the display sleeps.
  every frame {
    let step = min(dt, 0.04)
    if mode == "run" {
      if skiJumpEnd != null && distance >= skiJumpEnd { skiJumpEnd = null }
      let longAir = skiJumpEnd != null
      let airborne = longAir || airtime > 0
      let steer = (rightHold ? 1 : 0) - (leftHold ? 1 : 0)
      let grip = airborne ? 2.5 : 9
      let wantedHeading = recovery > 0 ? 0 : steer * 0.62
      let nextCarve = lerp(carve, wantedHeading, min(1, step * grip))
      let oldDistance = distance
      let oldRider = rider
      recovery = max(0, recovery - step)
      tucked = recovery <= 0 && !airborne && steer == 0 && abs(nextCarve) < 0.18
      // Heading splits speed into travel across the slope and travel down it.
      let downhill = cos(nextCarve)
      let goalSpeed = tucked ? 301 : 282
      if recovery > 0 {
        speed = lerp(speed, 36, min(1, step * 8))
      } else if !airborne {
        speed = lerp(speed, goalSpeed, min(1, step * (tucked ? 2.5 : 1.9)))
      }
      rider = rider + sin(nextCarve) * speed * step
      cameraX = clamp(cameraX, rider - slopeWidth * 0.65, rider - slopeWidth * 0.35)
      carve = nextCarve
      distance = distance + speed * downhill * step
      stride = stride + step
      calloutFor = max(0, calloutFor - step)
      if avalancheGap == null && meters >= avalancheStartMeters {
        avalancheGap = riderLine + 16
        callout = "AVALANCHE"
        calloutFor = 2.4
      } else if avalancheGap != null {
        let safeGap = min(riderLine * 0.52, 64) - abs(nextCarve) * 15
        avalancheGap = lerp(avalancheGap, safeGap, min(1, step * 3.5))
      }
      if caveX == null && meters >= beastStartMeters - 10 {
        caveSide = rider - cameraX < slopeWidth / 2 ? 1 : -1
        caveX = cameraX + (caveSide > 0 ? slopeWidth - 28 : 28)
      }
      if !huntStarted && meters >= beastStartMeters {
        huntStarted = true
        hunting = true
        hunterX = caveX
        hunterZ = caveZ
        hunterVx = -caveSide * 94
        hunterTurn = hunterVx
        nextHunterTurn = 0.92
        huntTime = 0
      }
      if hopQueued && !airborne && recovery <= 0 {
        airTotal = 0.47
        airtime = airTotal
      }
      hopQueued = false
      airtime = max(0, airtime - step)
      if longAir {
        let remaining = clamp((skiJumpEnd - distance) / skiJumpDistance, 0, 1)
        lift = sin(remaining * 3.14159) * min(53, riderLine * 0.52)
      } else {
        lift = sin(airtime / airTotal * 3.14159) * (airTotal > 0.5 ? 32 : 16)
      }

      // Keep each actor in world coordinates so overtaking works in either direction.
      let nearby = traffic.map(actor => merge(actor, {
        px: actor.x,
        pz: actor.z,
        x: actor.kind == "dog" ? actor.x + actor.dir * 62 * step : actor.lane + actor.sweep * sin((stride - actor.born) * actor.rate),
        z: actor.z + actor.pace * step
      })).filter(actor => actor.z >= distance - riderLine - 38
        && actor.z <= distance + viewDepth - riderLine + 120
        && actor.x >= cameraX - 75 && actor.x <= cameraX + slopeWidth + 75)
      // Test sideways overlap over the entire time the riders are close downhill.
      let approach = nearby.filter(actor => lift < actor.clearance
        && min(actor.pz - oldDistance, actor.z - distance) < 6
        && max(actor.pz - oldDistance, actor.z - distance) > -6).map(actor => {
          actor: actor,
          fromZ: actor.pz - oldDistance,
          deltaZ: (actor.z - distance) - (actor.pz - oldDistance),
          fromX: actor.px - oldRider,
          toX: actor.x - rider
        })
      let windows = approach.map(hit => merge(hit, {
        enter: hit.deltaZ == 0 ? 0
          : clamp((-6 * sign(hit.deltaZ) - hit.fromZ) / hit.deltaZ, 0, 1),
        leave: hit.deltaZ == 0 ? 1
          : clamp((6 * sign(hit.deltaZ) - hit.fromZ) / hit.deltaZ, 0, 1)
      }))
      let trafficHit = windows.find(hit => min(lerp(hit.fromX, hit.toX, hit.enter), lerp(hit.fromX, hit.toX, hit.leave)) < 10
        && max(lerp(hit.fromX, hit.toX, hit.enter), lerp(hit.fromX, hit.toX, hit.leave)) > -10).actor
      traffic = nearby
      if distance >= trafficAt && len(traffic) < 2 {
        let pattern = trafficGroup % 5
        let direction = hash(seed, trafficAt) < 0.5 ? -1 : 1
        let lane = cameraX + 56 + hash(seed, trafficAt, 3) * 128
        let wideLane = cameraX + 120 + 57 * direction
        let dogX = cameraX + (direction > 0 ? 15 : 225)
        let ahead = viewDepth - riderLine
        let kid = {kind: "kid", x: lane, z: distance + (trafficGroup == 0 ? min(155, ahead - 20) : ahead + 36),
          lane: lane, pace: 68, sweep: 15, rate: 3.2, born: stride, clearance: 11}
        let adult = {kind: "skier", x: lane, z: distance + ahead + 29, lane: lane,
          pace: 107 + hash(seed, trafficAt, 8) * 33, sweep: 26, rate: 2, born: stride, clearance: 15}
        let fallenLane = cameraX + 120 - 54 * direction
        let fallen = {kind: "fallen", x: fallenLane, z: distance + ahead + 59, lane: fallenLane,
          pace: 0, sweep: 0, rate: 0, born: stride, dir: direction, clearance: 7}
        let boarder = {kind: "boarder", x: wideLane, z: distance - min(120, riderLine - 5), lane: wideLane,
          pace: 396 + hash(seed, trafficAt, 9) * 23, sweep: 24, rate: 2.8, born: stride, clearance: 15}
        let crossingDog = {kind: "dog", x: dogX, z: distance + min(325, ahead + 28),
          pace: 0, dir: direction, clearance: 7}
        traffic = traffic + [trafficGroup % 10 == 2 ? boarder : [kid, crossingDog, adult, adult, fallen][pattern]]
        trafficAt = distance + 505 + 195 * hash(seed, trafficAt, 5)
        trafficGroup = trafficGroup + 1
      }

      // Resolve crossings at the interpolated contact point, including at high speed.
      let rowLine = rows.find(row => row.at > oldDistance && row.at <= distance)
      let contact = rowLine == null ? rider : lerp(oldRider, rider, (rowLine.at - oldDistance) / max(0.01, distance - oldDistance))
      let crossing = rowLine == null ? null : course.find(row => row.index == rowLine.index && row.section == floor(contact / slopeWidth))
      let offset = crossing == null ? 0 : contact - crossing.center
      let takingOff = crossing != null && crossing.kind == "skiJump"
        && !longAir && recovery <= 0 && abs(offset) < skiJumpHalfWidth
      let onJumpDeck = !longAir && recovery <= 0 && any(course, row => row.kind == "skiJump"
        && row.at >= oldDistance && row.at - distance <= 35
        && abs(rider - row.center) < skiJumpHalfWidth - clamp((row.at - distance) / 35, 0, 1) * 8)
      let jumpProtected = longAir || takingOff || onJumpDeck
      let blocked = crossing != null && any(crossing.obstacles, obstacle =>
        abs(contact - obstacle.x) < (obstacle.rock ? 6 : 5) && lift < (obstacle.rock ? 7 : 14))
      if takingOff {
        skiJumpEnd = crossing.at + skiJumpDistance
        airtime = 0
        callout = "100 M JUMP"
        calloutFor = 1.8
      } else if crossing != null && recovery <= 0 {
        if crossing.kind == "ramp" && abs(offset) <= 20 && airtime <= 0 && !longAir {
          airTotal = 0.88
          airtime = airTotal
          bonus = bonus + 75
          callout = "+75"
          calloutFor = 1.15
        } else if crossing.kind == "gate" && abs(offset) < gateHalfWidth - 1 {
          bonus = bonus + 35
          callout = "+35"
          calloutFor = 0.95
        }
      }
      if !jumpProtected && (recovery <= 0 || hunting || avalancheGap != null) && (blocked || trafficHit != null) {
        lives = max(0, lives - 1)
        haptic(avalancheGap != null || hunting || lives == 0 ? "strong" : "medium")
        if avalancheGap != null {
          burialStartGap = avalancheGap
          burialTime = 0
          recovery = 0.82
          lift = 0
          fingers = []
          centerPress = null
          hopQueued = false
          tucked = false
          bestRun = recordToSave
          reason = "Buried by the avalanche"
          mode = "burial"
        } else if hunting {
          lives = 0
          reason = "Run ended"
          mode = "over"
        } else if lives == 0 {
          reason = "Out of lives"
          mode = "over"
        } else {
          recovery = 0.82
          speed = 37
          airtime = 0
          lift = 0
          callout = "−1"
          calloutFor = recovery
        }
      }

      if mode == "run" && hunting {
        let canEscape = meters >= beastEscapeMeters
        huntTime = huntTime + step
        // The beast commits to turns. During the first 300 m, its pace
        // responds to the gap so it stays in pursuit even on a fast line.
        if huntTime >= nextHunterTurn {
          let sidewaysGap = rider - hunterX
          let lateralPace = canEscape ? 114 : 126 + clamp((abs(sidewaysGap) - 32) * 1.45, 0, 108)
          hunterTurn = clamp(sidewaysGap / 72, -1, 1) * lateralPace
          nextHunterTurn = huntTime + (canEscape ? 0.92 : 0.64)
        }
        hunterVx = lerp(hunterVx, hunterTurn, min(1, step * 3))
        let targetGap = min(40, riderLine * 0.42) + sin(huntTime * 2.1) * 7
        let downhillPace = speed * downhill
        let catchupPace = clamp(downhillPace + (oldDistance - hunterZ - targetGap) * 4, 65, 440)
        let freePace = hunterZ > distance + 14 ? 180 : 268 - abs(hunterVx) * 0.25
        let chaseSpeed = huntTime < 0.55 ? 82 : (canEscape ? freePace : catchupPace)
        hunterX = hunterX + hunterVx * step
        hunterZ = hunterZ + chaseSpeed * step
        let gap = distance - hunterZ
        let separation = abs(rider - hunterX)
        if !jumpProtected && huntTime > 0.8 && abs(gap) <= 12 && separation < 12 && lift < 19 {
          haptic("strong")
          lives = 0
          reason = "Run ended"
          mode = "over"
        } else if canEscape && (gap >= 154 || (huntTime >= 2 && separation >= 175)) {
          hunting = false
          bonus = bonus + 120
        }
      }

      if mode == "over" {
        bestRun = recordToSave
        fingers = []
        centerPress = null
        tucked = false
      }
    } else if mode == "burial" {
      burialTime = burialTime + step
      stride = stride + step
      let progress = clamp(burialTime / burialSweepTime, 0, 1)
      let sweep = progress * progress * (3 - 2 * progress)
      avalancheGap = lerp(burialStartGap, riderLine - viewDepth - 44, sweep)
      if burialTime >= burialTotalTime { mode = "over" }
    }
  }

  // Original pixel sprites.
  let heart = [
    ".oo...oo.", "offo.offo", "ohffofffo", "offfffffo",
    ".offfffo.", "..offfo..", "...ofo...", "....o...."
  ]
  let pine = [
    ".......h........", "......hll.......", "......hll.......", ".....hllls......",
    "....hhlllls.....", "....ggtllls.....", ".....gtlss......", "...ggttlllls....",
    "..ggttlllllss...", "..ggtttllssss...", "....ggtttts.....", "..ggttlllllss...",
    ".gggttlllllsss..", "gggtttllsssssss.", "...ggggtssss....", "......bb........",
    "......bd........"
  ]
  let stone = [
    "....lllll....", "...llmmmmr...", "..lmmmmmmrr..", ".lmmmmmmrrrr.",
    ".lmmmrrrrddr.", "lmmrrrrddddrr", "rrrrddddddddr", ".dddddddddd.."
  ]
  let skier = [
    "......hhhh......", ".....hwwhhh.....", ".....hwwhhh.....", ".....hiiiii.....",
    "......hii.......", "....rrroorrr....", "...rooaoaooor...", "..irrraaarrrri..",
    "..i.rrraaar..i..", ".k..rrraaar...k.", ".k...ppppp....k.", "....pp..ppp.....",
    "...gpp..pp.g....", "...gk....k.g....", "...gg....ggg....", "....g.....g....."
  ]
  let beast = [
    ".....b....b.....", "....bb....bb....", "...bbbccccbbb...", "...cccllccccc...",
    "..ccllttttllcc..", "..cclttyyttlcc..", "..cclttttlcccc..", ".ddcclllccccdd.",
    "dddccllllcccddd", "dd.cllllllcc.dd", "d..ccllllccc..d.",
    "...ccc..ccc.....", "..ddcc..ccdd....", "..ddd....ddd...."
  ]
  let cave = [
    "..........ssssssss..........", "........ssssssssssss........",
    "......ssllssssssssllss......", "....ssllllmmmmlmmmllllss....",
    "...ssllmmmmmmmmmmmmmllss...", "..ssllmmrrrrrrrrrrmmmllss..",
    "..sllmrrrrdddddrrrrmmlllss.", ".sllmrrrddddddddddrrrmmlls.",
    ".slmmrrddddddddddddrrmmlls.", "slmmrrddddddddddddddrrmmls",
    "smmrrddddddddddddddddrrmms", "smrrddddddddddddddddddrrms",
    "mmrrddddddddddddddddddrrmm", "mrrddddddddddddddddddddrrm",
    "rrrddddddddddddddddddddrrr", ".sssss................sss."
  ]
  let dog = [
    "..........d....", ".........dd.c..", "d........ccccc.",
    ".dcccccccccc.wd", "..ccccccccccdd.", "..ccccccccw....",
    "...dd...dd....."
  ]
  let dogFeetA = ["...d.....d.....", "..dd.....dd...."]
  let dogFeetB = ["....d...d......", "....dd.dd......"]
  let snowboarder = [
    ".....hhhh.......", "....hwwhhh......", "....hiiiii......",
    ".....hii........", "...rrrooor......", "..irroaaoorri...",
    ".ii.rraaor..ii..", ".....ppppp......", "....pp..ppp.....",
    "...pp....pp.....", "..ggggggggggg...", ".ggggggggggggg.."
  ]
  let pineColors = {h: #fafffc, l: #bde5dd, s: #73b7a9, g: #184c3b, t: #2c7959, b: #9b7758, d: #534136}
  let rockColors = {l: #e2edf1, m: #9eacbc, r: #6f8197, d: #47546f}
  let skiColors = {h: #f2ddac, w: #ffffff, i: ink, r: #9f2442, o: #ff7045, a: #e94642, p: #294d94, g: #efb23e, k: #163044}
  let visitorColors = merge(skiColors, {r: #245353, o: #8cc845, a: #4b9e68, p: #3e3771, g: #4469b9})
  let kidColors = merge(skiColors, {r: #92522a, o: #ffcd51, a: #e99941, p: #64579b, g: #5e7faf})
  let boardColors = merge(skiColors, {r: #3c2774, o: #bf77e5, a: #8454b8, p: #25395b, g: #36a9b2})
  let dogColors = {c: #ab6038, d: #563543, w: #f7e4c0}
  let beastColors = {b: #f6b552, c: #515779, l: #777ca7, t: #272c4d, y: #ffdc77, d: #3f4568}
  let caveColors = {s: #e1edf6, l: #b6cfdf, m: #839ab1, r: #546681, d: #273448}

  Box {
    fill: true
    align: center
    background: ink

    Box {
      fill: true

      Canvas {
        fill: true
        onTouch: {
          if mode == "run" {
            if centerPress != null {
              let centerFinger = touches.find(f => f.id == centerPress.id)
              if centerFinger == null {
                if stride - centerPress.at < 0.32 && centerPress.valid { hopQueued = true }
                centerPress = null
              } else if centerPress.valid && (
                centerFinger.x < edgeBand || centerFinger.x > touchWidth - edgeBand
                || abs(centerFinger.x - centerFinger.startX) > 18
                || abs(centerFinger.y - centerFinger.startY) > 18
              ) {
                centerPress = merge(centerPress, {valid: false})
              }
            }
            if centerPress == null {
              let newCenterFinger = touches.find(f => f.startX >= edgeBand && f.startX <= touchWidth - edgeBand
                && !any(fingers, previous => previous.id == f.id))
              if newCenterFinger != null { centerPress = {id: newCenterFinger.id, at: stride, valid: true} }
            }
            fingers = touches
          }
        }

        let depth = height / unit
        let fullyBuried = mode == "over" && avalancheGap != null && avalancheGap < 0
        let avalancheFront = avalancheGap == null ? 0 : (fullyBuried ? depth + 44 : riderLine - avalancheGap)
        if avalancheFront < depth + 9 {
          clip(gutter, 0, fieldWidth, height) {
            translate(gutter, 0) {
              scale(unit, unit, 0, 0) {
                rect(0, 0, slopeWidth, depth, fill: snow)

                // Snow texture scrolls with the course, reusing a fixed set of marks.
                let snowRow = floor((distance - riderLine) / 30)
                for i in range(ceil(depth / 30) + 2) {
                  let mark = snowRow + i
                  let markY = round(mark * 30 - distance + riderLine)
                  let worldMark = round(hash(mark, 3) * slopeWidth) - cameraX
                  let markX = worldMark - floor(worldMark / slopeWidth) * slopeWidth
                  rect(markX, markY, 3 + floor(hash(mark, 9) * 6), 1, fill: snowShade)
                  rect(markX - 2, markY + 1, 4, 1, fill: snowShade)
                }

                let startY = round(riderLine - distance - 29)
                if startY > -12 && cameraX > -172 && cameraX < 172 {
                  rect(74 - cameraX, startY, 92, 3, fill: #9fc8d4)
                }

                for row in course {
                  let atY = round(row.at - distance + riderLine)
                  let center = row.center - cameraX
                  let centerVisible = center > -27 && center < slopeWidth + 27
                  if row.kind == "skiJump" && centerVisible {
                    path([[center - 17, atY - 38], [center + 17, atY - 38], [center + 26, atY],
                      [center + 21, atY + 6], [center - 21, atY + 6], [center - 26, atY]],
                      closed: true, fill: #29475f)
                    path([[center - 13, atY - 35], [center + 13, atY - 35],
                      [center + 20, atY - 3], [center - 20, atY - 3]],
                      closed: true, fill: #b4e7f2)
                    path([[center - 10, atY - 34], [center - 6, atY - 34],
                      [center - 9, atY - 5], [center - 14, atY - 5]],
                      closed: true, fill: #eafaff)
                    path([[center + 6, atY - 34], [center + 10, atY - 34],
                      [center + 14, atY - 5], [center + 9, atY - 5]],
                      closed: true, fill: #eafaff)
                    for slat in range(5) {
                      rect(center - 17 + slat * 7, atY - 3, 5, 2, fill: #f6b552)
                    }
                    rect(center - 20, atY + 1, 40, 2, fill: #587991)
                  } else if row.kind == "ramp" && centerVisible {
                    rect(center - 20, atY - 10, 40, 21, fill: #9fc8d4)
                    rect(center - 18, atY - 10, 36, 17, fill: #f9fbef)
                    rect(center - 20, atY - 10, 3, 17, fill: #e97550)
                    rect(center + 17, atY - 10, 3, 17, fill: #e97550)
                    rect(center - 5, atY - 5, 10, 2, fill: #659bac)
                    rect(center - 3, atY - 3, 6, 2, fill: #659bac)
                    rect(center - 1, atY - 1, 2, 2, fill: #659bac)
                  }
                  if row.kind == "gate" && centerVisible {
                    let flag = floor(row.index / slalomSpacing) % 2 == 1 ? #d53f49 : #3d68aa
                    for side in [-1, 1] {
                      let post = center + side * gateHalfWidth
                      let fabric = side < 0 ? post - 8 : post + 1
                      rect(post - 2, atY, 8, 2, fill: #c3d4e4)
                      rect(post - 1, atY - 13, 2, 15, fill: #28596a)
                      rect(fabric, atY - 13, 7, 3, fill: flag)
                      rect(fabric + (side < 0 ? 1 : 0), atY - 10, 6, 2, fill: flag)
                    }
                  }
                  for obstacle in row.obstacles {
                    let px = obstacle.x - cameraX
                    if px > -12 && px < slopeWidth + 12 {
                      rect(px - 3, atY, 9, 2, fill: #c3d4e4)
                      rect(px + 3, atY + 2, 4, 1, fill: #dbe6ee)
                      if obstacle.rock {
                        sprite(stone, px - 5, atY - 6, 0.82, palette: rockColors)
                      } else {
                        sprite(pine, px - 5, atY - 11, 0.67, palette: pineColors)
                      }
                    }
                  }
                }

                for actor in traffic.filter(actor => actor.x >= cameraX - 22 && actor.x <= cameraX + slopeWidth + 22
                  && actor.z >= distance - riderLine - 8 && actor.z <= distance - riderLine + depth + 24) {
                  let actorX = round(actor.x - cameraX)
                  let actorY = round(actor.z - distance + riderLine)
                  let phase = floor(stride * 12) % 2
                  rect(actorX - 5, actorY - 1, 11, 2, fill: #c3d4e4)
                  if actor.kind == "dog" {
                    scale(actor.dir, 1, actorX, actorY) {
                      sprite(dog + (phase == 0 ? dogFeetA : dogFeetB), actorX - 8, actorY - 8, 1, palette: dogColors)
                    }
                  } else if actor.kind == "fallen" {
                    rect(actorX - 9, actorY + 4, 14, 1, fill: #4469b9)
                    rect(actorX + 2, actorY - 8, 12, 1, fill: #4469b9)
                    rotate(actor.dir * 83, actorX, actorY - 4) {
                      sprite(skier, actorX - 7, actorY - 12, 0.9, palette: visitorColors)
                    }
                  } else {
                    let angle = -cos((stride - actor.born) * actor.rate) * 26
                    if actor.kind == "boarder" {
                      rect(actorX - 3 - round(angle * 0.1), actorY - 8, 2, 4, fill: #d1e1ed)
                      rotate(angle, actorX, actorY - 4) {
                        sprite(snowboarder, actorX - 8, actorY - 11, 1, palette: boardColors)
                      }
                    } else {
                      let child = actor.kind == "kid"
                      let pixel = child ? 0.77 : 1
                      rotate(angle, actorX, actorY - 6) {
                        sprite(skier, actorX - 8 * pixel, actorY - 15 * pixel, pixel, palette: child ? kidColors : visitorColors)
                      }
                    }
                  }
                }

                if caveX != null && abs(caveX - cameraX - slopeWidth / 2) < slopeWidth / 2 + 30 {
                  let entranceY = round(caveZ - distance + riderLine)
                  if entranceY > -8 && entranceY < depth + 30 {
                    let entranceX = round(caveX - cameraX)
                    rect(entranceX - 22, entranceY - 2, 44, 4, fill: #c3d4e4)
                    sprite(cave, entranceX - 21, entranceY - 22, 1.5, palette: caveColors)
                  }
                }
                if hunting && hunterX >= cameraX - 18 && hunterX <= cameraX + slopeWidth + 18
                  && hunterZ >= distance - riderLine - 5 && hunterZ <= distance - riderLine + depth + 22 {
                  let beastX = round(hunterX - cameraX)
                  let beastY = round(riderLine + hunterZ - distance)
                  let gait = floor(stride * 12) % 2
                  rect(beastX - 9, beastY - 2, 18, 3, fill: #afcfd6)
                  sprite(beast, beastX - 10, beastY - 16 + gait * 2, 1.28, palette: beastColors)
                }
                let skiX = round(rider - cameraX)
                let skiY = round(riderLine)
                if mode == "run" && lift < 4 && (tucked || abs(carve) > 0.25 || recovery > 0) {
                  for flake in range(recovery > 0 ? 8 : 4) {
                    let spread = (hash(flake, floor(stride * 12)) - 0.5) * (recovery > 0 ? 20 : 9)
                    rect(round(skiX + spread - carve * flake * 1.7), skiY - 7 - flake * 3, 2, 2, fill: #8eb6c4)
                  }
                }
                let facing = -round(deg(carve) / 15) * 15
                let tilt = recovery > 0 ? 78 : facing
                rect(skiX - 5 + round(lift * 0.2), skiY - 1, 11, 2, fill: #c3d4e4)
                rotate(tilt, skiX, skiY - lift - 6) {
                  scale(1, tucked && lift < 2 ? 0.8 : 1, skiX, skiY - lift) {
                    sprite(skier, skiX - 8, round(skiY - lift) - 15, 1, palette: skiColors)
                  }
                }

              }
            }
          }
        }

        if avalancheGap != null {
          let front = avalancheFront
          let bodyDepth = clamp(front - 9, 0, depth)
          let coveringScreen = mode == "burial" || fullyBuried
          let waveLeft = coveringScreen ? -gutter / unit : 0
          let waveWidth = coveringScreen ? width / unit : slopeWidth
          translate(gutter, 0) {
            scale(unit, unit, 0, 0) {
              if bodyDepth > 0 {
                rect(waveLeft, 0, waveWidth, bodyDepth, fill: linear(0, 0, 0, bodyDepth, [#c6dce9, #e1eff6, #cfdfeb]))
                clip(waveLeft, 0, waveWidth, bodyDepth) {
                  let cloudWidth = max(37, waveWidth / 6)
                  let cloudHeight = max(23, depth / 10)
                  let firstCloud = floor((cameraX + waveLeft) / cloudWidth) - 1
                  let layerCount = ceil(bodyDepth / cloudHeight) + 1
                  for plumeRow in range(layerCount).reverse() {
                    for plume in range(firstCloud, firstCloud + ceil(waveWidth / cloudWidth) + 3) {
                      let variation = hash(plume, plumeRow, 27)
                      let billow = sin(stride * (2.4 + variation) + plume * 1.7 + plumeRow * 1.1)
                      let plumeX = plume * cloudWidth - cameraX + plumeRow % 2 * cloudWidth / 2 + billow * 7
                      let plumeY = bodyDepth - (plumeRow + 1) * cloudHeight - variation * 11 + billow * 5
                      let swell = 0.86 + variation * 0.44
                      translate(round(plumeX), round(plumeY)) {
                        scale(cloudWidth / 37 * swell, cloudHeight / 23 * swell, 0, 0) {
                          path([[0, 16], [3, 16], [3, 10], [9, 10], [9, 6], [15, 6], [15, 2], [24, 2], [24, 5],
                            [30, 5], [30, 9], [35, 9], [35, 13], [40, 13], [40, 21], [36, 21], [36, 24],
                            [28, 24], [28, 27], [8, 27], [8, 24], [2, 24], [2, 20], [0, 20]],
                            closed: true, fill: mix(#b4cddc, #cce1ed, variation))
                          path([[3, 16], [6, 16], [6, 11], [12, 11], [12, 7], [17, 7], [17, 3], [24, 3], [24, 6],
                            [29, 6], [29, 10], [34, 10], [34, 14], [38, 14], [38, 18], [29, 18], [29, 20],
                            [20, 20], [20, 17], [13, 17], [13, 21], [6, 21], [6, 19], [3, 19]],
                            closed: true, fill: mix(#daeaf3, #f0f8fc, variation))
                          path([[10, 12], [15, 12], [15, 8], [19, 8], [19, 5], [24, 5], [24, 8], [27, 8],
                            [27, 11], [22, 11], [22, 13], [16, 13], [16, 15], [10, 15]],
                            closed: true, fill: #f5fbfe)
                        }
                      }
                    }
                  }
                }
              }

              if front < depth + 15 {
                let bandWidth = max(10, waveWidth / 34)
                let firstBand = floor((cameraX + waveLeft) / bandWidth)
                for band in range(firstBand, firstBand + ceil(waveWidth / bandWidth) + 1) {
                  let flurry = hash(band, 26) * 7 + sin(stride * 9 + band * 0.85) * 5
                  let bandX = band * bandWidth - cameraX
                  let tip = max(0, round(front + flurry))
                  let crest = max(0, tip - 7)
                  let cloudTop = max(0, front - 16)
                  if tip > 0 {
                    rect(bandX, cloudTop, bandWidth, max(0, crest - cloudTop), fill: #d4e6f1)
                    rect(bandX, crest, bandWidth, tip - crest, fill: #eaf5fb)
                    rect(bandX + 3, max(0, tip - 14), 3, min(tip, 3), fill: #f8fcff)
                  }
                }
              }
            }
          }
        }

      }

      if mode == "run" || mode == "pause" {
        Row {
          fill: width
          padding: [11, 9, 11, 0]
          gap: 8
          align: center
          Column {
            weight: 1
            gap: 1
            padding: [9, 5]
            background: ink
            let feedback = mode == "run" && calloutFor > 0 ? callout : ""
            let lostLife = feedback == "−1"
            let isDelta = lostLife || startsWith(feedback, "+")
            Row {
              fill: width
              gap: 6
              align: center
              Text { text: "${score} pts"; weight: 1; font: mono; bold: true; fontSize: 15; color: snow; maxLines: 1 }
              if isDelta {
                Text { text: feedback; font: mono; bold: true; fontSize: 12; color: lostLife ? #f87b86 : gold }
              }
              Canvas {
                width: 50
                height: 14
                for slot in range(3) {
                  let filled = slot < lives
                  sprite(heart, slot * 18, 1, 1.5, palette: {
                    o: filled ? #bc526b : #71899a,
                    f: filled ? #f87b86 : ink,
                    h: filled ? #ffd4ce : ink
                  })
                }
              }
            }
            Row {
              fill: width
              gap: 6
              align: center
              Text { text: "${meters} m"; weight: 1; font: mono; fontSize: 11; color: #b9d6df; maxLines: 1 }
              if feedback != "" && !isDelta {
                Text { text: feedback; font: mono; fontSize: 10; color: gold; maxLines: 1 }
              }
            }
            Text { text: bestLabel; font: mono; fontSize: 11; color: #b9d6df; maxLines: 1 }
          }
          if mode == "run" {
            Text {
              text: "Pause"
              fontSize: 13
              bold: true
              color: snow
              background: ink
              padding: [12, 12]
              onTap: { fingers = []; centerPress = null; hopQueued = false; bestRun = recordToSave; mode = "pause" }
            }
          }
        }
      }

      if mode == "ready" || mode == "pause" || mode == "over" {
        Box {
          fill: true
          align: center
          background: alpha(ink, 0.26)
          Column {
            width: min(fieldWidth - 24, 360)
            gap: 10
            padding: [18, 16]
            background: ink
            Text {
              text: mode == "ready" ? "SKILIBRE" : (mode == "pause" ? "Paused" : reason)
              font: mono
              fontSize: mode == "ready" ? 28 : 20
              bold: true
              color: gold
            }
            if mode == "ready" {
              Text { text: "Hold either edge to carve and slow down. Release to tuck downhill."; color: snow; fontSize: 14 }
              Text { text: "Tap the center to jump."; color: #b9d6df; fontSize: 14 }
            } else if mode == "over" {
              Text { text: "${score} pts  /  ${meters} m"; font: mono; color: snow; fontSize: 16 }
            }
            if savedScore > 0 && mode != "pause" {
              Text { text: bestLabel; font: mono; color: #b9d6df; fontSize: 13 }
            }
            Text {
              text: mode == "ready" ? "Start run" : (mode == "pause" ? "Resume" : "Ski again")
              fill: width
              padding: [12, 11]
              fontSize: 16
              bold: true
              color: ink
              background: gold
              align: center
              onTap: {
                if mode == "pause" { mode = "run" } else { restart = restart + 1 }
              }
            }
            if mode == "pause" {
              Text {
                text: "Restart"
                fill: width
                padding: [12, 9]
                color: snow
                align: center
                onTap: restart = restart + 1
              }
            }
          }
        }
      }
    }
  }
}
