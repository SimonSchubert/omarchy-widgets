app "flamingo heat" {
  meta { owl: 23; description: "A neon coast city at dusk, seen from above in low-poly: drive, take any car, race, run jobs for the people of Costa Brasa and shake the police to win back your family's marina"; version: "1.2"; license: "MIT"; category: "games" }
  // Flamingo Heat: built on the launcher's example "sunset heist" (MIT), its driving, traffic, police and missions,
  // with a city of its own from another seed, dusk light with lit windows, neon and headlights, and a story.
  // How it works: the city is made from a seed in lets, 12 by 16 cells of 32 units, each a block with
  // roads along its edges, and a kind: docks on the north shore, a canal across the middle, hotels on the
  // beach, houses in the south, towers downtown and a few landmarks. Only the cells around the camera are drawn. Two scenes share one camera: the
  // ground first, so nothing on it is ever sorted under it, then everything that stands on it. Traffic
  // drives on the right along the road grid and picks a turn at each corner; the police drive straight
  // at you and slide along buildings. The stick comes from onTouch: wherever a thumb goes down,
  // pushed the way to drive or walk.
  title: ""
  statusBar: false
  edge: true
  fps: mode == "play" ? 60 : modes.saver ? 15 : 30
  source modes = android.modes
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <defs><clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath></defs>
    <g clip-path="url(#t)">
      <rect width="256" height="256" fill="#2a1256"/>
      <rect y="0" width="256" height="70" fill="#3a1668"/>
      <rect y="70" width="256" height="50" fill="#6a1f7a"/>
      <rect y="120" width="256" height="40" fill="#b02a80"/>
      <circle cx="128" cy="150" r="74" fill="#ffb03b"/>
      <rect y="160" width="256" height="96" fill="#161032"/>
      <path d="M0 160V118H34V160ZM40 160V92H78V160ZM178 160V104H212V160ZM218 160V126H256V160Z" fill="#161032"/>
      <path d="M48 104H58V114H48ZM62 122H72V132H62ZM186 116H196V126H186ZM198 136H208V146H198ZM8 130H18V140H8ZM230 138H240V148H230Z" fill="#ffd886"/>
      <path d="M0 196H256V208H0Z" fill="#35e0ff"/>
      <path d="M60 196L78 168H150L176 184L206 188V212H60Z" fill="#ff4fa3"/>
      <path d="M88 184L98 172H124V184ZM132 172H148L166 184H132Z" fill="#161032"/>
      <circle cx="92" cy="214" r="15" fill="#0c0820"/><circle cx="176" cy="214" r="15" fill="#0c0820"/>
      <circle cx="92" cy="214" r="6" fill="#b8b0d8"/><circle cx="176" cy="214" r="6" fill="#b8b0d8"/>
      <rect x="194" y="192" width="14" height="8" fill="#fff6d0"/>
    </g>
  </svg>"""

  asset sfxShot = base64""
  asset sfxPunch = base64""
  asset sfxCrash = base64""
  asset sfxBoom = base64""
  asset sfxPick = base64""
  asset sfxWin = base64""
  asset sfxFail = base64""
  asset sfxSiren = base64""
  asset sfxEngine = base64""
  asset sfxBlip = base64""
  asset radio1 = base64""
  asset radio2 = base64""
  asset radio3 = base64""
  asset nightTex = base64""
  asset roadTex = base64""
  asset parkTex = base64""
  asset beachTex = base64""
  asset facadeTex = base64""
  asset glowTex = base64""
  asset beamTex = base64""
  asset roofTex = base64""
  asset heliTex = base64""
  asset seaTex = base64""
  asset docksTex = base64""
  asset lawnTex = base64""
  asset plazaTex = base64""
  asset dirtTex = base64""
  asset canalTex = base64""
  asset canalBeachTex = base64""
  asset poolTex = base64""
  asset courtTex = base64"iVBORw0KGgoAAAANSUhEUgAAACAAAABACAYAAAB7jnWuAAAAmklEQVR42u3ZwQ2AIAxAUQZjFAdxJidxHC6cMR3A2EJJwfxDg4kEXxooiimfVyulNmnfQu7fRzaFZkxpk1xERgrPAAAAAAAA0AJ6wg0wIwAAAAAAgAtAU/PdASMb0DDg6yEWhBmgHdzSzwywpncPwDZfxz0rhTnwr2UYXoiWKMVLbEa8DwAAAABACCD8kIpzQgAAAADg5/XMDDyu2eBnP1wGLQAAAABJRU5ErkJggg=="
  asset ribTex = base64"iVBORw0KGgoAAAANSUhEUgAAACAAAAAQCAYAAAB3AH1ZAAAAL0lEQVR42mOIikj5P5CYAUS8fv0BjFet2EZX9qgDRh0w6oBRB4w6YNQBg8cBA4kBAQqHMyW8ENMAAAAASUVORK5CYII="
  asset edgeWTex = base64"iVBORw0KGgoAAAANSUhEUgAAABIAAACAAgMAAAB7DtGMAAAACVBMVEVSUlbqwDLq6uQrqiBiAAAAKUlEQVQoz2NgGEAgACUXAAEyyYCFJMYcYkly3TlqPvHmo8cptvgdBAAAMl8gwboHYqAAAAAASUVORK5CYII="
  asset edgeNTex = base64"iVBORw0KGgoAAAANSUhEUgAAAIAAAAASAgMAAADu/j4QAAAACVBMVEVSUlbq6uTqwDKjP0pLAAAAJUlEQVQoz2NgAAHWUAYMEBqAxCGogHIw6obB4waCYBUQYcEgAACv3w9HszkBfQAAAABJRU5ErkJggg=="
  asset edgeSTex = base64"iVBORw0KGgoAAAANSUhEUgAAAIAAAAASAgMAAADu/j4QAAAACVBMVEVSUlbqwDLq6uQrqiBiAAAAIUlEQVQoz2NgAIFQIMKCSQBcqzDFVi0gRQHlYNQNg8ENAI11E5i/YrZnAAAAAElFTkSuQmCC"
  asset skidTex = base64"iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAIElEQVR42mMQEZJgAOITaJgBB8ZQxzBqwKgBowYMFwMArEiiAW6IzpwAAAAASUVORK5CYII="

  // The language: the phone's, or the one picked on the title screen ("en" or "es").
  state lg = "" persist
  let ES = (lg == "" ? lang() : lg) == "es"
  strings {
    en {
      jobs: ES ? "TRABAJOS" : "JOBS"
      hudDone: (a, b) => ES ? ("${a} DE ${b} HECHOS · TOCA PARA LA LISTA") : ("${a} OF ${b} DONE · TAP FOR THE LIST")
      hudFar: d => ES ? ("${d} M · TOCA PARA LA LISTA") : ("${d} M · TAP FOR THE LIST")
      quit: ES ? "DEJARLO" : "QUIT"
      firstBack: ES ? "LLEGA EL PRIMERO A LA SALIDA" : "BE FIRST BACK TO THE START"
      go: ES ? "YA" : "GO"
      touch: ES ? "TOCA Y EMPUJA HACIA DONDE QUIERAS IR" : "TOUCH ANYWHERE AND PUSH THE WAY TO GO"
      getOut: ES ? "BAJAR" : "GET OUT"
      takeThe: n => ES ? ("robar el ${n}") : ("take the ${n}")
      getIn: n => ES ? ("subir al ${n}") : ("get in the ${n}")
      brake: ES ? "FRENO" : "BRAKE"
      fire: ES ? "FUEGO" : "FIRE"
      pistol: ES ? "pistola" : "pistol"
      smg: ES ? "subfusil" : "SMG"
      shotgun: ES ? "escopeta" : "shotgun"
      radioOff: ES ? "RADIO APAGADA" : "RADIO OFF"
      getCar: ES ? "CONSIGUE UN COCHE" : "GET A CAR FIRST"
      start: ES ? "EMPEZAR" : "START"
      pays: ES ? "paga " : "pays "
      doneAgain: ES ? "hecho · otra vez " : "done · again, it "
      yourBest: ES ? " · tu mejor tiempo " : " · your best "
      back: ES ? "VOLVER" : "BACK"
      listDone: (a, b) => ES ? ("${a} DE ${b} HECHOS") : ("${a} OF ${b} DONE")
      listIntro: ES ? "Coral Trust se quedó con el puerto de los Montoya tras el temporal. Ayuda a esta gente y te ayudarán a recuperarlo. Elige un trabajo, y las flechas de la calle y del mapa te llevan hasta él." : "Coral Trust took the Montoya marina after the storm. Do right by these people and they'll help you take it back. Pick a job, and the arrows on the road and on the map lead you to it."
      listFree: ES ? "El puerto vuelve a ser tuyo. Puedes repetir cualquier trabajo por el dinero." : "The marina is yours again. Every job can still be run for the money."
      tMarina: ES ? "EL PUERTO ES TUYO" : "THE MARINA IS YOURS"
      tJobs: (a, b) => ES ? ("${a} DE ${b} TRABAJOS HECHOS") : ("${a} OF ${b} JOBS DONE")
      tIntro: ES ? "Eres Rafa Montoya y vuelves a Costa Brasa tras tres años fuera. El temporal destrozó el puerto de tu familia y Coral Trust se quedó con lo que quedaba. La ciudad no te debe nada, pero su gente puede ayudarte: un promotor de carreras y su rival, una inspectora cansada, la tía del desguace, una streamer, un tabernero, un jefe de taxis y una médica de calle." : "You're Rafa Montoya, back in Costa Brasa after three years away. The storm wrecked your family's marina and Coral Trust took what was left. The city owes you nothing, but its people might help: a race promoter and his rival, a tired detective, a chop-shop auntie, a streamer, a barman, a cab dispatcher and a street doctor."
      tHow: ES ? "toca donde quieras y empuja hacia donde conducir · baja y roba cualquier coche · elige un trabajo en la lista o entra en un marcador · salta las rampas · despista a la policía en el taller de pintura · la partida se guarda sola" : "touch anywhere and push the way to drive · get out and take any car · pick a job from the list or drive into a marker · jump the ramps · lose the police at the paint shop · the game saves itself"
      soundOn: ES ? "EFECTOS DE SONIDO SÍ" : "SOUND EFFECTS ON"
      soundOff: ES ? "EFECTOS DE SONIDO NO" : "SOUND EFFECTS OFF"
      tapDrive: ES ? "TOCA PARA CONDUCIR" : "TAP TO DRIVE"
      tapContinue: ES ? "TOCA PARA SEGUIR" : "TAP TO CONTINUE"
      failed: ES ? "fallaste" : "failed"
      ko: ES ? "fuera de combate" : "knocked out"
      koDrink: ES ? "al agua" : "in the drink"
      arrested: ES ? "detenido" : "arrested"
      wrecked: ES ? "siniestro total" : "wrecked"
      fAway: ES ? "se ha escapado" : "it got away"
      fRum: ES ? "el ron está todo por el suelo" : "the rum's all over the floor"
      fPatient: ES ? "demasiado brusco · el paciente se bajó y se fue andando" : "too rough · the patient got out and walked"
      fLostCar: ES ? "has perdido el coche" : "you lost the car"
      fTime: ES ? "se acabó el tiempo" : "out of time"
      fGaveUp: ES ? "lo has dejado" : "you gave up"
      fLostThem: ES ? "los despistaste demasiado pronto" : "you lost them too soon"
      mMarina: ES ? "el puerto vuelve a ser tuyo · Coral Trust se va de Costa Brasa · +$2,500" : "the marina is yours again · Coral Trust is out of Costa Brasa · +$2,500"
      mStunt: (m, b) => ES ? ("acrobacia · ${m} m · +$${b}") : ("stunt · ${m} m · +$${b}")
      pHealth: ES ? "+ vida" : "+ health"
      pArmor: ES ? "+ blindaje" : "+ armor"
      mPlace: n => ES ? ("${n}º puesto") : (["1st", "2nd", "3rd", "4th"][n - 1] + " place")
      newBest: ES ? "nuevo récord" : "new best"
      mStopped: ES ? "lo has parado" : "stopped cold"
      mHit: p => ES ? ("tocado · su coche al ${p}%") : ("hit · its car ${p}%")
      mClean: ES ? "entregado limpio" : "delivered clean"
      mStillOn: ES ? "aún te siguen · despístalos primero" : "they're still on you · lose them first"
      mViral: ES ? "se ha hecho viral" : "that went viral"
      mJump: n => ES ? ("salto ${n} de 3 · +$150 · a por la siguiente rampa") : ("jump ${n} of 3 · +$150 · on to the next ramp")
      mDelivered: c => ES ? ("entregado · ${c}% entero") : ("delivered · ${c}% whole")
      mPatient: c => ES ? ("en el hospital · viaje ${c}% suave") : ("at the hospital · a ${c}% smooth ride")
      mAllThree: ES ? "las tres entregadas" : "all three delivered"
      mAllFares: ES ? "los tres clientes en casa" : "all three fares home"
      mParcel: n => ES ? ("paquete ${n} entregado · +$80 · al siguiente") : ("parcel ${n} delivered · +$80 · on to the next")
      mFare: n => ES ? ("cliente ${n} en su destino · +$80 · al siguiente") : ("fare ${n} dropped off · +$80 · on to the next")
      mPaint: ES ? "colores nuevos · te han perdido" : "new colors · they've lost you"
      mDecoy: ES ? "la cámara está vacía · ni miraron" : "the vault is empty · they never looked"
      hCatch: ES ? "alcanza el cupé rojo · embístelo hasta destrozarlo" : "catch the red coupe · ram it till it's wrecked"
      hGetaway: ES ? "despista a la policía · luego al garaje" : "lose the police · then to the garage"
      hStunt: ES ? "sigue las flechas hasta la rampa · entra rápido" : "follow the arrows to the ramp · hit it fast"
      hCargo: ES ? "conduce suave · cada golpe rompe botellas" : "drive gently · every knock breaks bottles"
      hPatient: ES ? "conduce suave · cada golpe duele" : "drive gently · every knock hurts"
      hCourier: ES ? "tres paquetes · sigue las flechas" : "three parcels · follow the arrows"
      hCab: ES ? "tres clientes · sigue las flechas" : "three fares · follow the arrows"
      hDecoy: ES ? "ten a la policía encima 75 segundos · ni los pierdas ni te dejes coger" : "keep the police on you for 75 seconds · don't lose them, don't get caught"
      oReady: ES ? "prepárate" : "get ready"
      oCheck: (i, n, d) => ES ? ("control ${i} de ${n} · ${d} m") : ("checkpoint ${i} of ${n} · ${d} m")
      oRam: d => ES ? ("embiste el cupé rojo · ${d} m") : ("ram the red coupe · ${d} m")
      oLose: ES ? "despista a la policía" : "lose the police"
      oGarage: d => ES ? ("al garaje de la tía Bao · ${d} m") : ("to Auntie Bao's garage · ${d} m")
      oRamp: (i, d) => ES ? ("rampa ${i} de 3 · ${d} m") : ("ramp ${i} of 3 · ${d} m")
      oRum: d => ES ? ("entrega el ron · ${d} m") : ("deliver the rum · ${d} m")
      oHospital: d => ES ? ("al hospital · ${d} m") : ("to the hospital · ${d} m")
      oParcel: (i, d) => ES ? ("paquete ${i} de 3 · ${d} m") : ("parcel ${i} of 3 · ${d} m")
      oFare: (i, d) => ES ? ("cliente ${i} de 3 · ${d} m") : ("fare ${i} of 3 · ${d} m")
      oDecoy: ES ? "que no dejen de seguirte" : "keep them chasing you"
      sGrid: ES ? "en la parrilla" : "on the grid"
      sPlace: (n, t) => ES ? ("${n}º puesto · ${t}") : (["1st", "2nd", "3rd", "4th"][n - 1] + " place · ${t}")
      sCar: (p, t) => ES ? ("su coche al ${p}% · quedan ${t}") : ("its car ${p}% · ${t} left")
      sHide: ES ? "fuera de su vista baja la búsqueda" : "out of their sight the heat drops"
      sClean: ES ? "nadie te busca · que siga así" : "no heat on you · keep it that way"
      sRamp: t => ES ? ("sube la rampa rápido · quedan ${t}") : ("drive up the ramp fast · ${t} left")
      sCargo: (c, t) => ES ? ("carga ${c}% · quedan ${t}") : ("cargo ${c}% · ${t} left")
      sPatient: (c, t) => ES ? ("paciente ${c}% · quedan ${t}") : ("patient ${c}% · ${t} left")
      sLeft: t => ES ? ("quedan ${t}") : ("${t} left")
      sDecoy: (n, h) => ES ? ("faltan ${n} s · búsqueda ${h}") : ("${n} s to go · heat ${h}")
      upTo: n => ES ? ("hasta $${n}") : ("up to $${n}")
      aJump: ES ? "$150 por salto" : "$150 a jump"
      aDrop: ES ? "$80 por entrega" : "$80 a drop"
      aFare: ES ? "$80 por cliente" : "$80 a fare"
      nRace: ES ? "carrera al anochecer" : "dusk race"
      rDash: ES ? "sprint del muelle" : "dockyard dash"
      rCanal: ES ? "vuelta al canal" : "canal loop"
      rPlaya: ES ? "sprint de la playa" : "playa sprint"
      nBagman: ES ? "el hombre del maletín" : "the bagman"
      sBagman: ES ? "fuera de registro" : "off the books"
      nGetaway: ES ? "flamenco caliente" : "hot flamingo"
      sGetaway: ES ? "para el desguace" : "for the chop shop"
      nStunt: ES ? "hacerse viral" : "going viral"
      sStunt: ES ? "tres rampas" : "three ramps"
      nCargo: ES ? "carga de cristal" : "glass cargo"
      sCargoJob: ES ? "ron de sesenta años" : "sixty-year rum"
      nCourier: ES ? "ronda nocturna" : "night rounds"
      sCourier: ES ? "tres entregas" : "three drops"
      nCab: ES ? "taxi nocturno" : "night cab"
      sCab: ES ? "tres clientes" : "three fares"
      nPatient: ES ? "visita a domicilio" : "house call"
      sPatientJob: ES ? "al hospital" : "to the hospital"
      nCollector: ES ? "el cobrador" : "the collector"
      sCollector: ES ? "en el canal" : "on the canal"
      nDecoy: ES ? "cortina de humo" : "smoke screen"
      sDecoyJob: ES ? "75 segundos" : "75 seconds"
      gDash: ES ? "Tico organiza las carreras del anochecer en Puerto Viejo, y medio puerto apuesta en ellas. Gana a sus tres pilotos pasando por todos los controles; el primero en volver a la salida se lleva el bote." : "Tico runs the dusk races out of Puerto Viejo, and half the port bets on them. Beat his three drivers through every checkpoint; first back to the line takes the pot."
      gCanal: ES ? "Tico quiere recuperar su dinero. Por los puentes del canal y alrededor de Los Mangos, todos los controles; gana el primero en volver." : "Tico wants his money back. Over the canal bridges and round Los Mangos, every checkpoint; first back wins."
      gPlaya: ES ? "La Reina no ha perdido nunca en la carretera de la costa, y sabe que le ganaste a Tico. Por Playa Rosa, dos veces sobre el canal y vuelta; gana quien llegue primero." : "La Reina has never lost on the coast road, and she heard you beat Tico. Down Playa Rosa, over the canal twice and back; first to the line wins."
      gBagman: ES ? "El hombre del maletín de Coral Trust se va de la ciudad en un cupé rojo con los papeles que te quitaron el puerto. Okafor no puede pararlo. Tú sí: embístelo hasta destrozarlo, en 2:30." : "Coral Trust's bagman is leaving town in a red coupe with the papers that took your marina. Okafor can't stop him. You can: ram it until it's wrecked, within 2:30."
      gGetaway: ES ? "La tía Bao tiene comprador para un coche que busca toda la policía. Llévatelo con tres de búsqueda, despista a la policía y déjalo limpio en su garaje." : "Auntie Bao has a buyer for a car the whole force is looking for. Take it with three heat on you, lose the police, and bring it to her garage clean."
      gStunt: ES ? "Kiki emite para media Costa Brasa y necesita a alguien que sepa volar. Aterriza un salto en cada rampa marcada en 2:30. Entra rápido, hacia donde apuntan sus rayas." : "Kiki streams to half of Costa Brasa and needs a driver who can fly. Land a jump off each marked ramp within 2:30. Hit it fast, the way its stripes point."
      gCargo: ES ? "Una caja de ron de sesenta años para la fiesta en el yate del alcalde, y el bar del viejo Sal depende de ella. Crúzala por la ciudad antes de que se acabe el tiempo. Cada golpe rompe botellas y baja la paga." : "A crate of sixty-year rum for the mayor's yacht party, and Old Sal's bar rides on it. Get it across town before the clock runs out. Every knock breaks bottles, and the pay drops."
      gCourier: ES ? "La doctora Mirela cura a quien no puede ir a un hospital. Lleva sus tres paquetes, uno tras otro, cada uno a su puerta antes de que se acabe el tiempo." : "Doc Mirela patches up whoever can't go to a hospital. Take her three parcels, one after another, each to its door before the clock runs out."
      gCab: ES ? "A Brasa Cab le faltan tres conductores y Chato paga en efectivo, sin preguntas. Lleva a tres clientes, uno tras otro, cada uno a su puerta antes de que se acabe el tiempo." : "Brasa Cab is three drivers short and Chato pays cash, no questions. Take three fares, one after another, each to their door before the clock runs out."
      gPatient: ES ? "Un paciente de la doctora necesita un hospital de verdad, esta noche, y a Los Mangos no llega ninguna ambulancia. Llega antes de que se acabe el tiempo. Cada golpe duele y baja la paga." : "One of the doc's patients needs a real hospital, tonight, and no ambulance comes to Los Mangos. Drive there before the clock runs out. Every knock hurts, and the pay drops."
      gCollector: ES ? "El cobrador de Coral Trust exprime a todos los bares del canal, y esta noche le toca al de Sal. Conduce un cupé rojo. Embístelo hasta destrozarlo, en 2:30." : "Coral Trust's collector is squeezing every bar on the canal, and tonight it's Sal's turn. He drives a red coupe. Ram it until it's wrecked, within 2:30."
      gDecoy: ES ? "La banda de Bao va a entrar en la cámara de Coral Trust y necesita a todas las patrullas en otra parte. Ponte con cuatro de búsqueda, haz que te sigan 75 segundos y que no te cojan." : "Bao's crew is going into the Coral Trust vault and needs every patrol car somewhere else. Take four heat, keep them chasing you for 75 seconds, and don't get caught."
    }
  }
  state mode = "title"
  state cash = 0 persist
  state gt = 0
  // set by the store's screenshots (screens.txt) to hold a scene still while it's drawn in each theme
  state still = false
  // every finger down, from onTouch
  state fingers = []
  // the player, in world units; heading in degrees, 0 toward +z (south, down the screen), 90 toward +x (east)
  state px = 112
  state pz = 322.5
  state ph = 90
  // the car's forward speed, and its velocity, which the tires pull toward where it points: a drift when they let go
  state pv = 0
  state pvx = 0
  state pvz = 0
  // how fast a hit off the middle turns the car, in degrees a second, dying away
  state pspin = 0
  state inCar = true
  state pcol = 1
  // what you drive: an index into TYPES and VEH
  state ptype = 1
  state dmg = 0
  // Off a ramp: how high the car is, how fast it rises, and where and when it took off (null on the ground).
  state py = 0
  state pvy = 0
  state air = null
  // Driven into the water: where the car went under and when (null on land); a moment later you're wasted.
  state sunk = null
  state camX = 112
  state camZ = 322.5
  state cars = []
  // Parked vehicles, to get into: a few of each kind wait by the curb near the start, and again in a new game.
  let STARTERS = [{id: -1, t: 2, x: 106, z: 315.3, h: 90, c: 1, dmg: 0, wreck: false}, {id: -2, t: 6, x: 113.5, z: 315.6, h: 90, c: 2, dmg: 0, wreck: false}, {id: -3, t: 4, x: 121, z: 315.3, h: 90, c: 0, dmg: 0, wreck: false}, {id: -4, t: 3, x: 138, z: 315.3, h: 90, c: 3, dmg: 0, wreck: false}, {id: -5, t: 5, x: 148.5, z: 315.3, h: 90, c: 4, dmg: 0, wreck: false}, {id: -6, t: 0, x: 106, z: 324.8, h: 270, c: 7, dmg: 0, wreck: false}, {id: -7, t: 7, x: 114, z: 324.8, h: 270, c: 3, dmg: 0, wreck: false}, {id: -8, t: 8, x: 122, z: 324.8, h: 270, c: 1, dmg: 0, wreck: false}]
  state parked = STARTERS
  state peds = []
  state cops = []
  state nextId = 1
  state heat = 0
  state crimeAt = -100
  state seenAt = -100
  state hitAt = -100
  state copAt = -100
  // Missions: the one running (null for none), the mission spot the map leads you to (an index into GIVERS), the
  // rivals in a race, the car to stop in a takedown, the jump just landed, and the best race times by race.
  state mis = null
  state track = null
  state rivals = []
  state prey = null
  state landed = null
  state best = {} persist
  // The missions passed (indexes into GIVERS), ticked off in the list, on the map and over their spots; they can be
  // played again.
  state done = [] persist
  // Every job done once: the marina is bought back, with a bonus, once.
  state free = false persist
  // Sound on or off, from the title screen.
  state snd = true persist
  // Where you were and what you had, kept every few seconds and picked up again from the title.
  state save = null persist
  // The car radio: 0 is off, else a station of RADIO; when its loop last started.
  state radio = 0 persist
  state radioAt = -100
  state msg = ""
  state msgAt = -100
  // skid marks on the road, and smoke and sparks in the air
  state skids = []
  state skidAt = -100
  state fx = []
  state fxAt = -100
  // You on foot: health and armor, which takes the damage first. Guns: ammo for each of WEAPONS, the one in hand (-1:
  // none), whether the fire button is held, and when the last shot went. Damage this frame, taken from armor first.
  state hp = 100
  state armor = 0
  state ammo = [0, 0, 0]
  state gun = -1
  state firing = false
  // the brake button held, in a car
  state braking = false
  state shotAt = -100
  state hurt = 0
  // Tracers of recent shots, police on foot, explosions to set off and those burning, pickups taken and when.
  state shots = []
  state officers = []
  state blasts = []
  state booms = []
  state taken = []

  let C = 32
  // The city's districts, by where you are.
  let DISTRICT = pz < 2 * 32 ? "Puerto Viejo" : (pz >= 10 * 32 && pz < 11 * 32 ? "El Canal" : (px >= 10 * 32 ? "Playa Rosa" : (pz >= 12 * 32 ? "Los Mangos" : (px >= 3 * 32 && px < 8 * 32 && pz >= 3 * 32 && pz < 9 * 32 ? "Centro" : "Barrio Luz"))))
  // The roads round the edge are whole roads, both lanes: the land reaches half a road past the grid on the west,
  // north and south, with a strip of sand past that on the west and south (the beach is the east edge). Off it is
  // the sea, and a car driven into it, or into the canal, goes under.
  let E = 4.5
  let W = screenWidth ?? 400
  let H = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 12)
  let BOT = screenInset ?? 0
  // Dusk: the sun is down behind the city. The ground is drawn in its day colors and a wash of DUSK laid over it;
  // what stands on it is painted in dusk colors, and what glows (windows, neon, lamps, headlights) keeps its own.
  let DUSK = #26124c
  let SKY = #26124c
  let NWHITE = #8a7f9e
  // Tints for lit facades: the windows carry them.
  let WIN = [#ffffff, #ffe6f2, #dff2ff, #fff0d8]
  let LIGHT = [-0.35, 1, 0.45]
  // Painted signs and awnings, and the colors of flat roofs.
  let SIGNS = [#ff3fa4, #35e0ff, #ffb03b, #7dff6a, #b06cff]
  let ROOFT = [#857893, #7c6b80, #776f91, #715e74]
  let TINTS = [#847283, #777195, #816679, #7a6f87]
  let PAINT = [#817695, #71203d, #283376, #83623f, #2c2346, #541941, #2a424b, #675e80]
  let SHIRTS = [#782c44, #2f4285, #7f5e3f, #837895, #37494b]
  let SPRAY = [112, 256]
  // Where you wake up after being wasted.
  let HOSPITAL = [7 * C + 6, 5 * C + 16]
  // Guns: damage a hit, shots a second, reach, how far off straight ahead it still finds a target, ammo a pickup gives.
  let WEAPONS = [
    {name: str.pistol, dmg: 30, rate: 3, range: 22, cone: 45, give: 24},
    {name: str.smg, dmg: 14, rate: 10, range: 18, cone: 40, give: 90},
    {name: str.shotgun, dmg: 80, rate: 1.1, range: 11, cone: 55, give: 10}
  ]
  // Without a gun: a punch, at arm's length, at people only; it knocks them down rather than out.
  let FIST = {name: "fists", dmg: 20, rate: 2.5, range: 2.6, cone: 70}
  // Pickups on the sidewalks, made from the seed: health, armor, the three guns, cash.
  let PICK_COLOR = [#ff3b5c, #3d8bff, #ffb03b, #ffb03b, #ffb03b, #3ccf6e]
  let PICKS = range(52).map(i => {id: i, x: floor(hash(i + 50, 91) * 11) * 32 + (hash(i + 50, 96) < 0.5 ? 6 : 26), z: floor(hash(i + 50, 92) * 16) * 32 + 8 + hash(i + 50, 94) * 16, k: hash(i + 50, 95) < 0.28 ? 0 : (hash(i + 50, 95) < 0.48 ? 1 : (hash(i + 50, 95) < 0.62 ? 2 : (hash(i + 50, 95) < 0.74 ? 3 : (hash(i + 50, 95) < 0.84 ? 4 : 5))))}).filter(p => abs(p.z - (10 * 32 + 16)) > 10)

  // The city: cells by row. Landmarks where SPOTS puts them; the canal across row 10, under a bridge at every
  // crossing and out to sea under the coast road; the beach in the last column, docks along the north shore,
  // hotels facing the beach, houses in the south, and blocks of one to four buildings between, tallest downtown,
  // with a park here and there. What's in a cell, `b`, is what you can't drive through; its `k` says how it's drawn.
  let SPOTS = [{cx: 8, cz: 7, k: "stadium"}, {cx: 7, cz: 5, k: "hosp"}, {cx: 3, cz: 7, k: "spray"}, {cx: 6, cz: 8, k: "police"}, {cx: 1, cz: 4, k: "gas"}, {cx: 8, cz: 11, k: "gas"}, {cx: 3, cz: 13, k: "gas"}, {cx: 4, cz: 8, k: "build"}, {cx: 9, cz: 3, k: "build"}, {cx: 5, cz: 4, k: "plaza"}, {cx: 2, cz: 9, k: "park"}, {cx: 6, cz: 2, k: "park"}, {cx: 7, cz: 14, k: "court"}, {cx: 1, cz: 12, k: "court"}]
  let CELL0 = flatten(range(16).map(cz => range(12).map(cx => {cx: cx, cz: cz, k: (first(SPOTS.filter(s => s.cx == cx && s.cz == cz)) ?? {k: cz == 10 ? "canal" : (cx == 11 ? "beach" : (cz <= 1 ? "docks" : (cx == 10 ? "hotel" : (cz >= 12 ? (hash(cx + 37, cz + 11, 1) < 0.12 ? "park" : "suburb") : (hash(cx + 37, cz + 11, 1) < 0.12 && cx != 5 ? "park" : "city")))))}).k})))
  let CELLS = CELL0.map(c => merge(c, {b: {
    city: hash(c.cx + 37, c.cz + 11, 2) < (c.cx >= 3 && c.cx <= 7 && c.cz >= 3 && c.cz <= 8 ? 0.45 : 0.2)
      ? [{k: "bldg", x: c.cx * C + 16, z: c.cz * C + 16, w: 15, d: 15, h: 14 + hash(c.cx + 37, c.cz + 11, 3) * 12 + (c.cx >= 3 && c.cx <= 7 && c.cz >= 3 && c.cz <= 8 ? 10 : 0), u: hash(c.cx + 37, c.cz + 11, 6) < 0.7 ? 8 + hash(c.cx + 37, c.cz + 11, 7) * 12 : 0, heli: hash(c.cx + 37, c.cz + 11, 8) < 0.5, t: hash(c.cx + 37, c.cz + 11, 4), n: hash(c.cx + 37, c.cz + 11, 5)}]
      : range(4).filter(i => hash(c.cx + 37, c.cz + 11, 10 + i) > 0.2).map(i => {k: "bldg", x: c.cx * C + 11.5 + i % 2 * 9, z: c.cz * C + 11.5 + floor(i / 2) * 9, w: 6.5 + hash(c.cx + 37, c.cz + 11, 20 + i) * 1.5, d: 6.5 + hash(c.cx + 37, c.cz + 11, 30 + i) * 1.5, h: 4 + pow(hash(c.cx + 37, c.cz + 11, 40 + i), 2) * 16 + (c.cx >= 3 && c.cx <= 7 && c.cz >= 3 && c.cz <= 8 ? 6 : 0), u: 0, heli: false, t: hash(c.cx + 37, c.cz + 11, 50 + i), n: hash(c.cx + 37, c.cz + 11, 60 + i)}),
    // A gantry crane's legs and two stacks under its boom; a shed; fuel tanks; or a yard of stacked containers.
    docks: c.cz == 0 && c.cx % 3 == 1
      ? range(4).map(i => {k: "post", x: c.cx * C + 11 + i % 2 * 10, z: c.cz * C + 7.5 + floor(i / 2) * 7.5, w: 1, d: 1, h: 14}) + range(2).map(i => {k: "cont", x: c.cx * C + 11.5 + i * 9, z: c.cz * C + 21.5, w: 6.4, d: 2.6, n: 1 + i, h: 2.6 + i * 2.6})
      : (hash(c.cx + 37, c.cz + 11, 2) < 0.3 ? [{k: "ware", x: c.cx * C + 16, z: c.cz * C + 15.5, w: 18, d: 13, h: 6}]
      : (hash(c.cx + 37, c.cz + 11, 2) < 0.45 ? [{k: "tank", x: c.cx * C + 11.5, z: c.cz * C + 17, w: 7.5, d: 7.5, h: 6}, {k: "tank", x: c.cx * C + 20.5, z: c.cz * C + 12, w: 6, d: 6, h: 5}]
      : range(8).filter(i => hash(c.cx + 37, c.cz + 11, 10 + i) > 0.25).map(i => {k: "cont", x: c.cx * C + 11.5 + i % 2 * 9, z: c.cz * C + 9 + floor(i / 2) * 4.6, w: 6.4, d: 2.6, n: 1 + floor(hash(c.cx + 37, c.cz + 11, 20 + i) * 3), h: 2.6 + floor(hash(c.cx + 37, c.cz + 11, 20 + i) * 3) * 2.6}))),
    hotel: [{k: "hotel", x: c.cx * C + 14, z: c.cz * C + 16, w: 13, d: 17, h: 8 + hash(c.cx + 37, c.cz + 11, 3) * 7, t: floor(hash(c.cx + 37, c.cz + 11, 4) * 5), n: hash(c.cx + 37, c.cz + 11, 5)}],
    suburb: range(4).filter(i => hash(c.cx + 37, c.cz + 11, 10 + i) > 0.15).map(i => {k: "house", x: c.cx * C + 11 + i % 2 * 10, z: c.cz * C + 11 + floor(i / 2) * 10, w: 5.5, d: 5, h: 2.4, r: hash(c.cx + 37, c.cz + 11, 50 + i), t: hash(c.cx + 37, c.cz + 11, 60 + i)}),
    canal: [{k: "water", x: c.cx * C + (c.cx == 11 ? 18.5 : 16), z: c.cz * C + 16, w: c.cx == 11 ? 27 : 22, d: 18, h: 0}],
    beach: c.cz == 0 ? [{k: "light", x: c.cx * C + 24, z: c.cz * C + 8, w: 3.6, d: 3.6, h: 17}] : [],
    stadium: [{k: "stadium", x: c.cx * C + 16, z: c.cz * C + 16, w: 19, d: 19, h: 5}],
    hosp: [{k: "hosp", x: c.cx * C + 16.5, z: c.cz * C + 15, w: 15, d: 13, h: 9}],
    police: [{k: "police", x: c.cx * C + 16, z: c.cz * C + 13, w: 15, d: 10, h: 6}, {k: "copcar", x: c.cx * C + 12, z: c.cz * C + 22.5, w: 4.2, d: 2, h: 1.5}, {k: "copcar", x: c.cx * C + 19, z: c.cz * C + 22.5, w: 4.2, d: 2, h: 1.5}],
    spray: [{k: "spray", x: c.cx * C + 16, z: c.cz * C + 13, w: 14, d: 11, h: 5}],
    gas: [{k: "shop", x: c.cx * C + 16, z: c.cz * C + 9.5, w: 12, d: 4, h: 3.2}, {k: "pump", x: c.cx * C + 13, z: c.cz * C + 18, w: 1, d: 1.6, h: 1.4}, {k: "pump", x: c.cx * C + 19, z: c.cz * C + 18, w: 1, d: 1.6, h: 1.4}],
    build: [{k: "frame", x: c.cx * C + 14, z: c.cz * C + 14, w: 13, d: 12, h: 7}, {k: "post", x: c.cx * C + 23.5, z: c.cz * C + 23.5, w: 1.4, d: 1.4, h: 30}],
    plaza: [{k: "fount", x: c.cx * C + 16, z: c.cz * C + 16, w: 6, d: 6, h: 0.8}]
  }[c.k] ?? []}))
  // What each kind of cell is paved with, and its color on the map.
  let GROUND = {park: parkTex, beach: beachTex, docks: docksTex, suburb: lawnTex, court: lawnTex, plaza: plazaTex, build: dirtTex, canal: canalTex, stadium: parkTex}
  let KCOL = {park: #2f7a5a, beach: #c8a888, canal: #1c3a7a, docks: #5a5478, suburb: #4a8a6a, court: #4a8a6a, plaza: #a88ab0, stadium: #7dff6a, hosp: #ff6a8a, police: #4f8bff, spray: #ff8a3a, gas: #7dff6a, build: #8a6a5a, hotel: #ff8ac8}
  // Stunt ramps, facing the way to jump, `y` high and throwing the car up by `k` of its speed: one in every park,
  // one on the beach, and two steep ones to clear the canal, from the park north of it and up the beach at its mouth.
  let RAMPS = [{x: 2 * C + 16, z: 9 * C + 20, h: 0, y: 2.4, k: 0.45}, {x: 11 * C + 19, z: 11 * C + 14, h: 180, y: 2.4, k: 0.45}, {x: 11 * C + 19, z: 5 * C + 16, h: 0, y: 1.6, k: 0.3}] + CELLS.filter(c => c.k == "park" && !(c.cx == 2 && c.cz == 9)).map(c => {x: c.cx * C + 16, z: c.cz * C + 16, h: floor(hash(c.cx + 37, c.cz + 11, 9) * 4) * 90, y: 1.6, k: 0.3})
  // Missions start at spots on the streets, each a column in its color with its name over it; the list (the
  // MISSIONS button) leads you to one. Races run over corners of the road grid, each leg along one road, from a
  // start line half a block past the first corner, round and back to it.
  let RACES = [
    {name: "dockyard dash", pts: [[3, 2], [8, 2], [8, 6], [10, 6], [10, 9], [5, 9], [5, 5], [2, 5], [2, 2], [3, 2]]},
    {name: "canal loop", pts: [[6, 11], [10, 11], [10, 14], [6, 14], [6, 15], [2, 15], [2, 12], [4, 12], [4, 9], [6, 9], [6, 11]]},
    {name: "playa sprint", pts: [[11, 4], [11, 9], [9, 9], [9, 13], [11, 13], [11, 15], [8, 15], [8, 11], [7, 11], [7, 6], [9, 6], [9, 4], [11, 4]]}
  ]
  let RPATH = RACES.map(r => [[r.pts[0][0] * C + sign(r.pts[1][0] - r.pts[0][0]) * 16, r.pts[0][1] * C + sign(r.pts[1][1] - r.pts[0][1]) * 16]] + drop(r.pts, 1).map(p => [p[0] * C, p[1] * C]))
  // How far along its race each corner is.
  let RCUM = RPATH.map(P => range(len(P)).map(i => sum(range(i).map(j => dist(P[j], P[j + 1])))))
  let GIVERS = [
    {k: "race", r: 0, who: "Tico Almeida", name: str.nRace, sub: str.rDash, key: "dockyard dash", x: RPATH[0][0][0], z: RPATH[0][0][1], col: #ff4f6a, car: true, pay: str.upTo(500), goal: str.gDash},
    {k: "race", r: 1, who: "Tico Almeida", name: str.nRace, sub: str.rCanal, key: "canal loop", x: RPATH[1][0][0], z: RPATH[1][0][1], col: #ff4f6a, car: true, pay: str.upTo(500), goal: str.gCanal},
    {k: "takedown", who: "Det. Ines Okafor", name: str.nBagman, sub: str.sBagman, x: 6 * C + 16, z: 8 * C, col: #4f8bff, car: true, pay: "$350", goal: str.gBagman},
    {k: "getaway", who: "Auntie Bao", name: str.nGetaway, sub: str.sGetaway, x: 4 * C + 16, z: C, col: #b06cff, car: false, pay: "$500", goal: str.gGetaway},
    {k: "stunt", who: "Kiki Voltage", name: str.nStunt, sub: str.sStunt, x: C, z: 7 * C + 16, col: #ffd23b, car: true, pay: str.aJump, goal: str.gStunt},
    {k: "cargo", who: "Old Sal", name: str.nCargo, sub: str.sCargoJob, x: 8 * C + 16, z: 2 * C, col: #3ccf6e, car: true, pay: str.upTo(450), goal: str.gCargo},
    {k: "courier", who: "Doc Mirela", name: str.nCourier, sub: str.sCourier, x: 5 * C + 16, z: 6 * C, col: #ffb03b, car: false, pay: str.aDrop, goal: str.gCourier},
    {k: "race", r: 2, who: "La Reina Valdés", name: str.nRace, sub: str.rPlaya, key: "playa sprint", x: RPATH[2][0][0], z: RPATH[2][0][1], col: #ff4f6a, car: true, pay: str.upTo(500), goal: str.gPlaya},
    {k: "courier", v: "cab", who: "Chato · Brasa Cab", name: str.nCab, sub: str.sCab, x: 2 * C + 16, z: 5 * C, col: #ffe14a, car: true, pay: str.aFare, goal: str.gCab},
    {k: "cargo", v: "patient", who: "Doc Mirela", name: str.nPatient, sub: str.sPatientJob, x: 2 * C + 16, z: 13 * C, col: #ff8ac8, car: true, pay: str.upTo(450), goal: str.gPatient},
    {k: "takedown", who: "Old Sal", name: str.nCollector, sub: str.sCollector, x: 9 * C + 16, z: 12 * C, col: #4f8bff, car: true, pay: "$350", goal: str.gCollector},
    {k: "decoy", who: "Auntie Bao", name: str.nDecoy, sub: str.sDecoyJob, x: 9 * C, z: 7 * C + 16, col: #b06cff, car: false, pay: "$600", goal: str.gDecoy}
  ]
  // The stunt tour's ramps: the three park ramps nearest its start.
  let STUNT = take(sortBy(drop(RAMPS, 2), r => dist([r.x, r.z], [C, 7 * C + 16])), 3)
  // Doors on the roads to deliver to, and crossings for a takedown's car to start from.
  let DROPS = flatten(range(1, 16).map(cz => range(0, 11).map(cx => [cx * C + 16, cz * C])))
  let XING = flatten(range(2, 15).map(z => range(2, 11).map(x => [x, z])))
  // Shadows: everything standing casts one away from the sun (LIGHT), its footprint swept toward the north-east by
  // its height. One flat mesh per row of cells, made once; a row's shadows reach at most into the row north of it.
  let SHADES = range(16).map(cz => [flatten(range(12).map(cx => CELLS[cz * 12 + cx].b)).filter(b => b.h > 0 && b.k != "water" && b.k != "tank")].map(bs => mesh(
    flatten(bs.map(b => [[(b.h + (b.u ?? 0)) * 0.35, (b.h + (b.u ?? 0)) * -0.45]].map(s => [[b.x - b.w / 2, 0, b.z - b.d / 2], [b.x - b.w / 2 + s[0], 0, b.z - b.d / 2 + s[1]], [b.x + b.w / 2 + s[0], 0, b.z - b.d / 2 + s[1]], [b.x + b.w / 2 + s[0], 0, b.z + b.d / 2 + s[1]], [b.x + b.w / 2, 0, b.z + b.d / 2], [b.x - b.w / 2, 0, b.z + b.d / 2]])[0])),
    range(len(bs)).map(i => range(6).map(j => i * 6 + j))
  ))[0])
  // A container ship tied up at the docks.
  let SHIP = range(16).map(i => {x: 108 + i % 8 * 7, z: -23.5 + floor(i / 8) * 7, n: 1 + floor(hash(i, 71) * 3), c: floor(hash(i, 72) * 7)})
  // The coast round the grid, which you can't drive onto: a strip of sand along the edge, and over it round coves
  // and outcrops of rock and sand, so the shore isn't a ruled line; surf round each. Islands offshore, a breakwater
  // off the docks, a pier, and boats going round in lanes outside it all.
  let SHORE = range(16).map(i => {x: -E - 1.6, z: i * 32 + 16, w: 3.4, d: 32.2, rock: false, flat: true})
    + [{x: -E - 1.6, z: -E / 2, w: 3.4, d: E + 0.2, rock: false, flat: true}, {x: -E - 1.6, z: 16 * C + (E + 3.4) / 2, w: 3.4, d: E + 3.6, rock: false, flat: true}, {x: -E / 2, z: 16 * C + E + 1.6, w: E + 0.2, d: 3.4, rock: false, flat: true}]
    + range(12).map(i => {x: i * 32 + 16, z: 16 * C + E + 1.6, w: 32.2, d: 3.4, rock: false, flat: true})
    + range(44).map(i => [8 + hash(i, 201) * 12].map(w => {x: -E - 0.5 - w / 2, z: i * 12 + 2, w: w, d: 10 + hash(i, 202) * 10, rock: hash(i, 204) < 0.45, flat: false})[0])
    + range(29).map(i => [8 + hash(i, 211) * 14].map(d => {x: i * 14 + 2, z: 16 * C + E + 0.5 + d / 2, w: 12 + hash(i, 212) * 10, d: d, rock: hash(i, 215) < 0.15, flat: false})[0])
    + range(44).filter(i => hash(i, 221) < 0.4 && abs(i * 12 + 2 - 336) > 14).map(i => [5 + hash(i, 222) * 7].map(w => {x: 383.5 + w * 0.3, z: i * 12 + 2, w: w, d: 6 + hash(i, 223) * 8, rock: hash(i, 224) < 0.3, flat: false})[0])
  // The shore by rows of 32 m (from 96 m north of the grid), so finding the pieces near the camera looks at a few rows, not all.
  let SHORE_ROWS = range(22).map(r => SHORE.filter(p => floor(p.z / C) + 3 == r))
  let ISLES = [{x: 110, z: 566 + E, r: 13, k: "villa"}, {x: 300, z: 558 + E, r: 6, k: "palm"}, {x: 250, z: -64 - E, r: 6, k: "beacon"}, {x: 410, z: 250, r: 0, k: "none"}]
  // The breakwater's stones, from the north-west corner out past the docks, its light at the end.
  let MOLE = range(12).map(i => {x: 2 + i * 2.6, z: -4 - E - i * 2.9, s: 2.2 + hash(i, 251) * 1.2})
  // Boats: each on a lane (0 west, 1 north, 2 east, 3 south), there and back; some sail.
  let BOATS = range(8).map(i => {lane: i % 4, off: hash(i, 241) * 900, sp: 5 + hash(i, 242) * 7, c: PAINT[floor(hash(i, 243) * 8)], sail: hash(i, 244) < 0.4})
  let HULL = mesh([[-1, 0.9, -3], [1, 0.9, -3], [1, 0.9, 1.4], [0, 0.9, 3], [-1, 0.9, 1.4], [-0.6, -0.2, -2.55], [0.6, -0.2, -2.55], [0.6, -0.2, 1.19], [0.0, -0.2, 2.55], [-0.6, -0.2, 1.19]], [[4, 3, 2, 1, 0], [5, 6, 7, 8, 9], [0, 1, 6, 5], [1, 2, 7, 6], [2, 3, 8, 7], [3, 4, 9, 8], [4, 0, 5, 9]], [#7f7397, #281b43, null, null, null, null, null])
  let SAIL = mesh([[0, 1.2, -1.8], [0, 7.5, 0.2], [0, 1.2, 1.6]], [[0, 1, 2]], [#7f7397])
  let CONT = [#71214c, #2a4481, #7c493c, #2a5361, #4d2e81, #695b85, #2f3369]
  let PASTEL = [#855681, #5e7185, #8a6673, #62699e, #775e9e]
  let ROOFS = [#692a44, #373369, #2f4252, #543344]

  let BOX = cube()
  let TILE = plane(1)
  let TRUNK = cylinder(5)
  let CROWN = sphere(6)
  let MARK = cylinder(16)
  // An arrow painted on the road, pointing +z.
  let CHEV = mesh([[-0.7, 0, -0.4], [0, 0, 0.3], [0.7, 0, -0.4], [0.7, 0, 0.05], [0, 0, 0.75], [-0.7, 0, 0.05]], [[0, 5, 4, 1], [1, 4, 3, 2]])
  let WAVES = plane(10)
