  let WALLED = v => any(CELLS[floor(v[1] / C) * 12 + floor(v[0] / C)].b ?? [], b => b.k != "water" && abs(v[0] - b.x) < b.w / 2 + v[2] && abs(v[1] - b.z) < b.d / 2 + v[2])
  // What traffic is made of: each type as often as it appears here.
