face "dash" {
  // A Material 3 daily dash after Noctalia and DankMaterialShell: tonal cards in the theme's colors.

  meta { owl: 11; description: "A Material 3 daily dash: clock and week, weather, quick tiles, media, phone stats and notifications on tonal cards"; version: "1.0"; license: "MIT"; category: "productivity" }
  requires { pacman: ["btop"] }

  padding: 0

  source now = clock every 1m
  source wx = http("https://wttr.in/?format=j1") every 30m timeout 10s json
  source bat = android.battery
  source alarm = android.alarm
  source n = android.notifications
  source m = android.media
  source v = android.volume
  source modes = android.modes
  source dev = android.device
  source sys = android.system every 1m
  source d = android.drawer

  let inter = "https://raw.githubusercontent.com/google/fonts/main/ofl/inter/Inter%5Bopsz,wght%5D.ttf"
  let mi = "https://raw.githubusercontent.com/google/material-design-icons/master/font/MaterialIconsRound-Regular.otf"

  // Material 3 roles, taken from the Omarchy theme.
  let primary = accent
  let onPrimary = background
  let primaryContainer = mix(background, accent, 0.3)
  let container = alpha(mix(background, foreground, 0.06), 0.92)
  let containerHigh = mix(background, foreground, 0.15)
  let outline = alpha(foreground, 0.12)

  let hour = num(fmtTime(now, "H"))
  let greeting = hour < 5 ? "Good night" : hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening"
  let night = hour < 7 || hour >= 19
  let cur = wx.current_condition[0]
  let today = wx.weather[0]
  let place = wx.nearest_area[0].areaName[0].value
  // This week, Monday first, for the strip under the clock.
  let wd = indexOf(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"], fmtTime(now, "EEE", null, "en"))
  let week = range(7).map(i => now + (i - wd) * 86400)
  let playing = m.available && m.title != null
  let mem = sys.memory.total ? sys.memory.used / sys.memory.total : 0
  let disk = sys.storage.total ? sys.storage.used / sys.storage.total : 0
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)

  component Ic(g, sz = 22, tint = foreground) {
    Text { text: g; font: mi; fontSize: sz; color: tint; maxLines: 1; align: center }
  }


  // A quick-settings tile: tonal, filled with the primary container while on.
  component Tile(g, label, note, on = false) {
    Row {
      gap: 12
      align: center
      padding: [14, 12]
      background: on ? primary : containerHigh
      radius: 22
      animate background: tween(200ms, "ease")
      Ic { g: g; sz: 22; tint: on ? onPrimary : foreground }
      Column {
        gap: 0
        weight: 1
        Text { text: label; font: inter; fontSize: 14; fontWeight: 600; color: on ? onPrimary : foreground; maxLines: 1 }
        Text { text: note; font: inter; fontSize: 12; color: on ? alpha(onPrimary, 0.75) : muted; maxLines: 1 }
      }
    }
  }

  component Stat(g, label, value, frac, tint = primary) {
    Column {
      gap: 6
      weight: 1
      align: center
      Box {
        size: 64
        align: center
        Ring { value: frac; max: 1; color: tint; track: alpha(tint, 0.18); thickness: 6; size: 64; animate value: spring() }
        Ic { g: g; sz: 22; tint: tint }
      }
      Text { text: value; font: inter; fontSize: 15; fontWeight: 600; align: center; maxLines: 1 }
      Text { text: label; font: inter; fontSize: 11; color: muted; align: center; maxLines: 1 }
    }
  }

  component Header() {
    Row {
      gap: 12
      align: center
      padding: 8
      background: container
      radius: 30
      Box {
        size: 44
        align: center
        background: primaryContainer
        radius: 22
        Text { text: upper(sub(dev.maker ?? "o", 0, 1)); font: inter; fontSize: 18; fontWeight: 700; color: primary; align: center }
      }
      Column {
        gap: 0
        weight: 1
        Text { text: greeting; font: inter; fontSize: 20; fontWeight: 600; maxLines: 1 }
        Text { text: "${capitalize(dev.maker ?? "")} · up ${fmtDuration(sys.uptime)}"; font: inter; fontSize: 12; color: muted; maxLines: 1 }
      }
      Box {
        size: 44
        align: center
        background: containerHigh
        radius: 22
        onTap: launcher("settings")
        Ic { g: ""; sz: 22 }
      }
    }
  }

  component Clock() {
    Column {
      gap: 12; padding: 16; background: container; radius: 28; fill: width
      Row {
        align: center
        gap: 12
        Column {
          gap: 0
          weight: 1
          Text { spans: [fmtTime(now, "HH"), {text: ":", color: primary}, fmtTime(now, "mm")]; font: inter; fontSize: 64; fontWeight: 300; letterSpacing: -2; maxLines: 1 }
          Text { text: fmtTime(now, "EEEE, d MMMM"); font: inter; fontSize: 14; color: muted; maxLines: 1 }
        }
        if cur {
          Column {
            gap: 2
            align: end
            onTap: url("https://wttr.in/")
            Text { text: weatherIcon(cur.weatherCode, night); font: icon; fontSize: 34; color: primary; align: end }
            Text { text: "${cur.temp_C}°"; font: inter; fontSize: 24; fontWeight: 500; align: end }
            Text { text: "↑${today.maxtempC}° ↓${today.mintempC}°"; font: inter; fontSize: 12; color: muted; align: end }
          }
        }
      }
      // The week, today in a filled pill.
      Row {
        gap: 4
        for t, i in week {
          Column {
            weight: 1
            gap: 2
            align: center
            padding: [0, 8]
            background: i == wd ? primary : alpha(primary, 0)
            radius: 16
            Text { text: sub(fmtTime(t, "EEE"), 0, 1); font: inter; fontSize: 11; color: i == wd ? onPrimary : muted; align: center }
            Text { text: fmtTime(t, "d"); font: inter; fontSize: 14; fontWeight: i == wd ? 700 : 500; color: i == wd ? onPrimary : foreground; align: center }
          }
        }
      }
      Flow {
        gap: 8
        if cur {
          Text { text: "${trim(cur.weatherDesc[0].value)} · ${place}"; font: inter; fontSize: 12; color: foreground; maxLines: 1; padding: [12, 6]; background: containerHigh; radius: 14 }
        }
        if alarm.set {
          Row {
            gap: 6
            align: center
            padding: [12, 6]
            background: primaryContainer
            radius: 14
            onTap: androidApp(alarm.app)
            Ic { g: ""; sz: 14; tint: primary }
            Text { text: fmtTime(alarm.time, "EEE HH:mm"); font: inter; fontSize: 12; fontWeight: 600; maxLines: 1 }
          }
        }
      }
    }
  }

  component Media() {
    if playing {
      Column {
        gap: 12; padding: 12; background: container; radius: 28; fill: width
        Row {
          gap: 14
          align: center
          Box {
            size: 64
            radius: 18
            clip: true
            background: primaryContainer
            align: center
            onTap: media("open")
            if m.art != null {
              Image { src: m.art; fit: cover; fill: true }
            } else {
              Ic { g: ""; sz: 28; tint: primary }
            }
          }
          Column {
            gap: 0
            weight: 1
            onTap: media("open")
            Text { text: m.title; font: inter; fontSize: 15; fontWeight: 600; maxLines: 1 }
            Text { text: m.artist ?? m.app ?? ""; font: inter; fontSize: 12; color: muted; maxLines: 1 }
          }
          Box { size: 40; align: center; onTap: media("previous"); Ic { g: ""; sz: 26 } }
          Box {
            size: 46
            align: center
            background: primary
            radius: 16
            onTap: media("toggle")
            Ic { g: m.playing ? "" : ""; sz: 26; tint: onPrimary }
          }
          Box { size: 40; align: center; onTap: media("next"); Ic { g: ""; sz: 26 } }
        }
        if m.duration {
          Progress { value: m.position ?? 0; max: m.duration; color: primary; track: alpha(primary, 0.18); height: 4 }
        }
      }
    }
  }

  component Quick() {
    Column {
      gap: 12; padding: 12; background: container; radius: 28; fill: width
      Grid {
        columns: 2
        gap: 8
        if modes.torch != null {
          Box { onTap: { haptic(); torch("toggle") }; Tile { g: modes.torch ? "" : ""; label: "Flashlight"; note: modes.torch ? "On" : "Off"; on: modes.torch } }
        }
        Box { onTap: volume("toggle"); Tile { g: v.muted ? "" : ""; label: "Media"; note: v.muted ? "Muted" : "${v.level}%"; on: !v.muted } }
        Tile { g: ""; label: "Do not disturb"; note: modes.dnd ? "On" : capitalize(modes.ringer ?? "off"); on: modes.dnd }
        Box { onTap: terminal("pacman -Syu", "updates"); Tile { g: ""; label: "Updates"; note: d.updates ? "${d.updates} waiting" : "Up to date"; on: d.updates > 0 } }
        Box { onTap: terminal("btop"); Tile { g: ""; label: "Monitor"; note: "btop" } }
        Box { onTap: launcher("style"); Tile { g: ""; label: "Theme"; note: sys.theme ?? "" } }
      }
      Row {
        gap: 12
        align: center
        padding: [8, 0]
        Ic { g: ""; sz: 20; tint: muted }
        Slider { value: v.level; onChange: volume(value); color: primary; track: alpha(primary, 0.2); weight: 1 }
      }
    }
  }

  component Stats() {
    Column {
      gap: 12; padding: 16; background: container; radius: 28; fill: width
      Row {
        gap: 8
        Stat { g: bat.charging ? "" : ""; label: bat.charging ? "Charging" : "Battery"; value: "${bat.level}%"; frac: (bat.level ?? 0) / 100; tint: bat.level < 20 && !bat.charging ? red : primary }
        Stat { g: ""; label: "Memory"; value: "${round(mem * 100)}%"; frac: mem }
        Stat { g: ""; label: "Storage"; value: fmtBytes(sys.storage.free); frac: disk }
      }
    }
  }

  // Notifications, newest first: tap to open, hold to dismiss.
  component Notifications() {
    Column {
      gap: 12; padding: 12; background: container; radius: 28; fill: width
      Row {
        gap: 10
        align: center
        padding: [6, 2]
        Ic { g: ""; sz: 20; tint: primary }
        Text { text: "Notifications"; font: inter; fontSize: 15; fontWeight: 600; weight: 1 }
        if n.available && n.count > 0 {
          Text { text: "${n.count}"; font: inter; fontSize: 12; fontWeight: 700; color: onPrimary; padding: [9, 3]; background: primary; radius: 10 }
        }
      }
      if !n.available {
        Row {
          gap: 12
          align: center
          padding: [12, 10]
          background: containerHigh
          radius: 18
          onTap: notification("open", "")
          Text { text: "Allow notification access to see them here"; font: inter; fontSize: 13; color: muted; weight: 1 }
          Ic { g: ""; sz: 20; tint: muted }
        }
      } else if n.count == 0 {
        Column {
          gap: 4
          align: center
          padding: [0, 14]
          Ic { g: ""; sz: 30; tint: primary }
          Text { text: "All caught up"; font: inter; fontSize: 13; color: muted; align: center }
        }
      } else {
        Column {
          gap: 4
          for it in n.items.take(5) key it.key {
            Row {
              gap: 12
              align: center
              padding: [12, 10]
              background: containerHigh
              radius: 18
              onTap: notification("open", it.key)
              onLongPress: { haptic(); notification("dismiss", it.key) }
              Box {
                size: 36
                align: center
                background: primaryContainer
                radius: 18
                Image { src: it.icon; size: 22 }
              }
              Column {
                gap: 0
                weight: 1
                Text { text: it.title; font: inter; fontSize: 14; fontWeight: 600; maxLines: 1 }
                if it.text != "" {
                  Text { text: it.text; font: inter; fontSize: 12; color: muted; maxLines: 2 }
                }
              }
              Text { text: fmtAgo(it.time, now); font: inter; fontSize: 11; color: muted; maxLines: 1 }
            }
          }
          if n.count > 5 {
            Text { text: "+${n.count - 5} more"; font: inter; fontSize: 12; color: muted; align: center; padding: [0, 4] }
          }
        }
      }
    }
  }

  if wide {
    Row {
      gap: 12
      fill: true
      padding: [16, 12]
      Column {
        gap: 12
        weight: 1
        scroll: true
        Header { }
        Clock { }
        Media { }
        Stats { }
        Spacer { height: screenInset }
      }
      Column {
        gap: 12
        weight: 1
        scroll: true
        Quick { }
        Notifications { }
        Spacer { height: screenInset }
      }
    }
  } else {
    Column {
      gap: 12
      fill: true
      scroll: true
      padding: [16, 12]
      Header { }
      Clock { }
      Media { }
      Quick { }
      Stats { }
      Notifications { }
      // The page runs under the navigation bar; the last card scrolls up clear of it.
      Spacer { height: screenInset + 8 }
    }
  }
}
