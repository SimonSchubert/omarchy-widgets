face "Spawn" {
  page: -1
  padding: 0
  background: background
  meta {
    owl: 17
    description: "A spawn.co game store: a live featured world, trending, top and new shelves, genre browsing, and search."
    version: "4.1"
    license: "MIT"
    category: "fun"
  }

  requires { pacman: [] }

  // Official logo SVG and wisp frames from spawn.co's procedural renderer.
  // Official Geist Pixel Square font, converted from the site WOFF2 to Android TTF.
  asset spawnPixel = base64""
  asset spawnLogo = base64""
  let wispFrames = [[".............",".............",".............",".............",".............","......a......",".....bbb.....","....abb......",".....ccbb....",".....ccc.....",".....cdcb....","....bfdfc....",".....ded....."],[".............",".............",".............",".............",".............","......a......",".....ab......",".....bb......","....bbcb.....",".....ccca....",".....cfcfc...","....bdddb....",".....ded....."],[".............",".............",".............",".............",".............",".............",".....ab......","......c......",".....bcb.....",".....cccbb...",".....cdcc....","....bfdfb....",".....ded....."],[".............",".............",".............",".............",".............","......a......","......b......","......cb.....",".....ccb.....",".....cdcb....",".....ddc.....","....bfdfc....",".....ded....."],[".............",".............",".............",".............",".............","......a......",".....bbb.....","......b......",".....bcb.....",".....ccc.....",".....cdcb....","....bfdfc....",".....ded....."],[".............",".............",".............",".............",".............","......a......","......b......",".....cc......",".....bcb.....",".....cdca....","....cfdfc....","....cdddb....",".....ded....."],[".............",".............",".............",".............",".............","......a......",".....bbb.....","......c......",".....ccc.....","....bddc.....",".....ddc.....","....bfdfb....",".....ded....."],[".............",".............",".............",".............",".............","......a......","......b......",".....bcb.....",".....ccc.....",".....cdcb....",".....cdc.....","....bfdfc....",".....ded....."],[".............",".............",".............",".............",".............","......a......","......ba.....",".....bbc.....",".....ccc.....",".....ccc.....",".....dddc....","....bfdfb....",".....ded....."],[".............",".............",".............",".............",".............","......b......",".....acb.....",".....bcb.....",".....ccc.....",".....cdcc....","....cfdfb....","....cdedc....",".....ded....."],[".............",".............",".............",".............",".............","......bb.....",".....acb.....",".....bccb....",".....cccbb...","....bcdc.....","....bfdfb....","....bdedc....",".....ded....."],[".............",".............",".............",".............",".............","......b......",".....cbb.....",".....bcb.....",".....ccc.....",".....cdc.....","....bfdfb....","....ddedb....",".....ded....."]]

  state tab = "for you"
  state showGenres = false
  state query = ""
  state genre = ""
  state lastOk = 0 persist

  source now = clock every 30s
  source hot = http("https://www.spawn.co/api/feed?sort=hot") every 10m timeout 15s json status
  source top = http("https://www.spawn.co/api/feed?sort=top") every 10m timeout 15s json status
  source recent = http("https://www.spawn.co/api/feed?sort=recent") every 10m timeout 15s json status
  source results = http(query == "" && genre == "" ? null : "https://www.spawn.co/api/feed?sort=top${genre != "" ? "&genre=${enc(genre)}" : ""}${query != "" ? "&q=${enc(query)}" : ""}") every 10m timeout 15s json status

  // Page colors follow the launcher theme; game artwork keeps its original colors.
  let ink = background
  let paper = foreground
  let quiet = muted
  let rule = border
  let panel = surface
  let teal = accent

  let hotOut = hot != null && hot.ok ? hot.out : null
  let topOut = top != null && top.ok ? top.out : null
  let recentOut = recent != null && recent.ok ? recent.out : null
  let resultOut = results != null && results.ok ? results.out : null
  let hotGames = hotOut.games ?? []
  let topGames = topOut.games ?? []
  let recentGames = recentOut.games ?? []
  let resultGames = resultOut.games ?? []
  let allGames = flatten([hotGames, topGames, recentGames])
  let genres = unique(flatten(allGames.map(g => g.genre_tags ?? []))).take(10)
  let feature = first(hotGames) ?? first(topGames) ?? first(recentGames)
  let browsing = query != "" || genre != ""
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let short = (tileHeight ?? 900) < 650
  let shelfCols = wide ? 5 : 3
  let shelfN = wide ? 5 : 3
  let browseCols = wide ? 4 : 2
  let heroH = short ? 210 : 285
  let agoSec = now != null && lastOk > 0 ? now - lastOk : null
  let ago = agoSec == null ? null : agoSec < 30 ? "just now" : "${fmtDuration(agoSec)} ago"

  on hot first { lastOk = value.ok ? (now ?? lastOk) : lastOk }
  on top first { lastOk = value.ok ? (now ?? lastOk) : lastOk }
  on recent first { lastOk = value.ok ? (now ?? lastOk) : lastOk }

  // Walk along the card ledge, tumble off, and return at a staggered phase.
  component CardWisp(phase = 0) {
    Canvas {
      fill: true
      let cycle = (time + phase) % 14
      let falling = cycle > 9
      let drop = max(0, cycle - 9)
      let px = falling ? width - 24 + min(drop * 3, 10) : 2 + (width - 26) * cycle / 9
      let py = falling ? min(height + 30, drop * drop * 48) : 0
      if cycle < 12 {
        rotate(falling ? min(drop * 160, 300) : 0, px + 13, py + 13) {
          sprite(wispFrames[floor((time + phase) / 0.09) % 12], px, py, 2, palette: {a: alpha(accent, 0.26), b: mix(background, accent, 0.55), c: accent, d: mix(accent, foreground, 0.35), e: foreground, f: background})
        }
      }
    }
  }

  component GameArt(src, h = 150, phase = 0) {
    Box {
      height: h + 26
      fill: width
    Box {
      height: h
      offset: [0, 26]
      fill: width
      radius: 3 * corners
      clip: true
      align: center
      background: panel
      border: 1
      borderColor: rule
      if src != null {
        Image { src: src; fit: cover; fill: true }
      } else {
        Text { text: "spawn"; style: label; font: spawnPixel; color: quiet; align: center }
      }
    }
      CardWisp { phase: phase }
    }
  }

  component GameCard(g, artH = 150) {
    Column {
      gap: 6
      fill: width
      onTap: url("https://www.spawn.co/@${g.profiles.username}/${g.games.adventure_name}")
      onLongPress: { haptic(); copy("https://www.spawn.co/@${g.profiles.username}/${g.games.adventure_name}") }
      GameArt { src: g.custom_thumbnail_url ?? g.og_image_url; h: artH; phase: hash(g.id) * 9 }
      Text { text: g.games.name; font: sans; fontWeight: 600; color: paper; style: small; maxLines: 2 }
      Text { text: "@${g.profiles.username}"; style: label; font: spawnPixel; color: quiet; maxLines: 1 }
      Row {
        gap: 6
        Text { text: "▶ ${fmtNum(g.play_count, {compact: true})}"; style: label; font: spawnPixel; color: quiet; maxLines: 1 }
        Text { text: "♥ ${fmtNum(g.like_count, {compact: true})}"; style: label; font: spawnPixel; color: quiet; maxLines: 1 }
      }
    }
  }

  component Hero(g, h = 300) {
    Box {
      height: h
      fill: width
      radius: 4 * corners
      clip: true
      background: panel
      onTap: url("https://www.spawn.co/@${g.profiles.username}/${g.games.adventure_name}")
      if (g.custom_thumbnail_url ?? g.og_image_url) != null {
        Image { src: g.custom_thumbnail_url ?? g.og_image_url; fit: cover; fill: true }
      }
      Box { fill: true; background: linear(0, 0, 0, 1, [alpha(ink, 0), alpha(ink, 0.35), alpha(ink, 0.96)]) }
      Column {
        fill: true
        justify: end
        padding: 16
        gap: 4
        Text { text: "picked for you"; style: label; font: spawnPixel; color: teal; maxLines: 1 }
        Text { text: g.games.name; font: sans; color: paper; letterSpacing: -0.6; fontSize: h < 260 ? 24 : 30; fontWeight: 700; maxLines: 2 }
        Text { text: "@${g.profiles.username} · ${join(take(g.genre_tags ?? [], 3), " · ")}"; style: small; color: paper; maxLines: 1 }
        if (g.box_copy.headline ?? "") != "" {
          Text { text: g.box_copy.headline; style: small; font: sans; color: paper; maxLines: 2 }
        }
        Row {
          gap: 10
          align: center
          Text { text: "▶ ${fmtNum(g.play_count, {compact: true})}"; style: small; color: quiet; maxLines: 1 }
          Text { text: "♥ ${fmtNum(g.like_count, {compact: true})}"; style: small; color: quiet; maxLines: 1 }
          Text { text: "✎ ${fmtNum(g.comment_count, {compact: true})}"; style: small; color: quiet; maxLines: 1 }
          Spacer { weight: 1 }
          Text { text: "play ↗"; style: small; color: ink; background: paper; padding: [14, 6]; radius: 3 * corners; maxLines: 1 }
        }
      }
    }
  }

  component Shelf(heading, games, cols = 3, artH = 140, note = "") {
    Column {
      gap: 8
      Row {
        align: center
        Text { text: heading; style: label; font: spawnPixel; color: teal; maxLines: 1 }
        Spacer { height: 1; weight: 1; background: linear(0, 0, 1, 0, [alpha(teal, 0.5), rule, alpha(rule, 0)]) }
        Text { text: len(games) > 0 ? "${len(games)} worlds" : ""; style: label; font: spawnPixel; color: quiet; maxLines: 1 }
      }
      if len(games) > 0 {
        Grid {
          columns: cols
          gap: 10
          for g in games key g.id {
            GameCard { g: g; artH: artH }
          }
        }
      } else {
        Text { text: note == "" ? "nothing here yet" : note; style: small; color: quiet; maxLines: 2 }
      }
    }
  }

  Box {
    fill: true
    background: ink

    Column {
      scroll: true
      fill: true
      gap: 20
      padding: [18, 16, 18, 0]
      onPull: refresh()

      Row {
        align: center
        gap: 12
        Row {
          weight: 1
          gap: 10
          align: center
          onTap: { query = ""; genre = ""; tab = "for you" }
          Image { src: spawnLogo; tint: foreground; width: 30; height: 35; fit: contain; label: "Spawn" }
          Text { text: "spawn"; font: spawnPixel; fontSize: 23; letterSpacing: 2; color: paper; maxLines: 1 }
        }
        Text { text: "↻"; fontSize: 22; color: quiet; padding: [8, 6]; onTap: refresh() }
        Text { text: "make a game"; font: spawnPixel; fontSize: 11; color: ink; background: paper; padding: [12, 10]; radius: 3 * corners; maxLines: 1; onTap: url("https://www.spawn.co/create") }
      }

      Row {
        gap: 10
        align: center
        background: panel
        border: 1
        borderColor: rule
        radius: 3 * corners
        padding: [12, 3]
        Text { text: "⌕"; fontSize: 22; color: quiet }
        Input {
          text: query
          placeholder: "search games, makers, genres"
          fontSize: 12
          color: paper
          underline: false
          weight: 1
          onChange: query = value
          onSubmit: refresh()
        }
        if query != "" {
          Text { text: "×"; color: paper; padding: 6; onTap: query = "" }
        }
      }

      Row {
        gap: 0
        border: 1
        borderColor: rule
        radius: 3 * corners
        for name in ["for you", "top", "new"] key name {
          Text {
            text: name
            font: spawnPixel
            fontSize: 12
            align: center
            weight: 1
            color: tab == name ? paper : quiet
            background: tab == name ? mix(surface, accent, 0.12) : ink
            padding: [10, 10]
            maxLines: 1
            onTap: { tab = name; query = ""; genre = "" }
          }
        }
        Text { text: genre == "" ? "genres ▾" : "genres •"; font: spawnPixel; fontSize: 12; color: showGenres || genre != "" ? paper : quiet; padding: [12, 10]; maxLines: 1; onTap: showGenres = !showGenres }
      }

      if showGenres {
        Flow {
          gap: 6
          for name in flatten([["all"], genres]) key name {
            let selected = name == "all" ? genre == "" : genre == name
            Text {
              text: name
              font: spawnPixel
              fontSize: 11
              color: selected ? paper : quiet
              background: selected ? mix(surface, accent, 0.12) : panel
              border: 1
              borderColor: selected ? teal : rule
              radius: 3 * corners
              padding: [10, 7]
              maxLines: 1
              onTap: { genre = name == "all" || genre == name ? "" : name; refresh() }
            }
          }
        }
      }

      if browsing {
        Column {
          gap: 10
          Row {
            gap: 8
            align: center
            Text { text: query != "" ? "search results" : "genre"; style: label; font: spawnPixel; color: teal; weight: 1; maxLines: 1 }
            Text { text: len(resultGames) > 0 ? "${len(resultGames)} games" : ""; style: label; font: spawnPixel; color: quiet; maxLines: 1 }
            Text { text: "back to store"; style: label; font: spawnPixel; color: quiet; maxLines: 1; onTap: { query = ""; genre = "" } }
          }
          if results == null {
            Text { text: "searching…"; style: small; color: quiet }
          } else if !results.ok {
            Row {
              gap: 8
              align: center
              Text { text: "couldn't reach spawn.co"; style: small; color: quiet; weight: 1; maxLines: 1 }
              Button { text: "retry"; onTap: refresh() }
            }
          } else if len(resultGames) == 0 {
            Text { text: "no games found"; style: small; color: quiet; maxLines: 2 }
          } else {
            Grid {
              columns: browseCols
              gap: 10
              for g in resultGames.take(16) key g.id {
                GameCard { g: g; artH: wide ? 150 : 190 }
              }
            }
          }
        }
      } else if tab != "for you" {
        Shelf { heading: tab == "top" ? "top played" : "just released"; games: (tab == "top" ? topGames : recentGames).take(16); cols: browseCols; artH: wide ? 180 : 205; note: (tab == "top" ? top : recent) == null ? "loading…" : !(tab == "top" ? top.ok : recent.ok) ? "couldn't reach spawn.co · pull to retry" : "nothing here yet" }
      } else {
        Column {
          gap: 6
          Text { text: "your next world awaits"; font: sans; fontSize: short ? 24 : 30; fontWeight: 600; letterSpacing: -0.8; color: paper; maxLines: 2 }
          Text { text: "free to make. free to play."; font: spawnPixel; fontSize: 11; color: quiet }
        }
        if feature != null {
          Box {
            height: heroH + 26
            fill: width
            Hero { g: feature; h: heroH; offset: [0, 26] }
            CardWisp { phase: 4 }
          }
        } else {
          Column {
            gap: 8
            padding: 16
            radius: 4 * corners
            background: panel
            border: 1
            borderColor: rule
            Text { text: hot == null ? "loading the store…" : hot.ok ? "no games today" : "couldn't reach spawn.co"; style: small; color: quiet; maxLines: 2 }
            if hot != null && !hot.ok {
              Button { text: "retry"; onTap: refresh() }
            }
          }
        }

        Shelf { heading: "trending now"; games: hotGames.drop(1).take(shelfN); cols: shelfCols; artH: wide ? 130 : 140; note: hot == null ? "loading…" : !hot.ok ? "offline" : "" }
        Shelf { heading: "top played"; games: topGames.take(shelfN); cols: shelfCols; artH: wide ? 130 : 140; note: top == null ? "loading…" : !top.ok ? "offline" : "" }
        Shelf { heading: "just released"; games: recentGames.take(shelfN); cols: shelfCols; artH: wide ? 130 : 140; note: recent == null ? "loading…" : !recent.ok ? "offline" : "" }
      }

      Row {
        gap: 8
        align: center
        Text { text: ago != null ? "updated ${ago}" : "spawn.co"; style: label; font: spawnPixel; color: quiet; weight: 1; maxLines: 1 }
        Text { text: "spawn.co ↗"; style: label; font: spawnPixel; color: quiet; maxLines: 1; onTap: url("https://www.spawn.co/") }
      }

      Spacer { height: screenInset }
    }
  }
}
