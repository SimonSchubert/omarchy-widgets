face "Daily learning" {
  meta { owl: 18; description: "Published daily word and a daily selection of sourced college math problems"; version: "4.0"; license: "MIT"; category: "productivity" }
  page: 0
  padding: 0
  background: linear(0, 0, 1, 1, [background, mix(background, blue, 0.12), background])
  source now = clock every 1m
  let date = fmtTime(now, "yyyy-MM-dd")
  requires { pacman: ["python", "python-matplotlib"] }
  source data = cmd("""python -c 'import concurrent.futures
import datetime as dt
import hashlib
import html
from html.parser import HTMLParser
import io
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

CACHE = Path.home() / '"'"'.cache'"'"' / '"'"'daily-learning'"'"'
CACHE.mkdir(parents=True, exist_ok=True)
DAY = dt.date.fromisoformat(sys.argv[1]) if len(sys.argv) > 1 else dt.date.today()
DATE = DAY.isoformat()
os.environ.setdefault('"'"'MPLCONFIGDIR'"'"', str(CACHE / '"'"'matplotlib'"'"'))

class Plain(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.chunks = []
        self.images = []
    def handle_data(self, data):
        self.chunks.append(data)
    def handle_starttag(self, tag, attrs):
        if tag == '"'"'br'"'"':
            self.chunks.append('"'"'\n'"'"')
        if tag == '"'"'img'"'"':
            src = dict(attrs).get('"'"'src'"'"', '"'"''"'"')
            if src.startswith('"'"'https://'"'"'):
                self.images.append(src)
    def handle_endtag(self, tag):
        if tag in ('"'"'p'"'"', '"'"'div'"'"', '"'"'blockquote'"'"', '"'"'li'"'"', '"'"'pre'"'"') or re.fullmatch(r'"'"'h\d'"'"', tag):
            self.chunks.append('"'"'\n\n'"'"')

def plain(text):
    parser = Plain()
    parser.feed(text)
    return re.sub(r'"'"'\n\s*\n\s*\n'"'"', '"'"'\n\n'"'"', '"'"''"'"'.join(parser.chunks)).strip()

def get(url):
    request = urllib.request.Request(url, headers={'"'"'User-Agent'"'"': '"'"'DailyLearningWidget/4.0'"'"'})
    with urllib.request.urlopen(request, timeout=18) as response:
        return response.read(2_000_001).decode('"'"'utf-8'"'"')

def save(path, content):
    # Atomic replacement also protects overlapping widget refreshes.
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        temp = Path(stream.name)
        stream.write(content)
    temp.replace(path)

def cached(name, fetch):
    path = CACHE / (name + '"'"'.json'"'"')
    try:
        old = json.loads(path.read_text())
    except (OSError, ValueError):
        old = {}
    if old.get('"'"'checked'"'"') == DATE and not old.get('"'"'error'"'"') and (name != '"'"'math'"'"' or old.get('"'"'rawTex'"'"')):
        return old
    try:
        fresh = dict(fetch(), checked=DATE, fetched=dt.datetime.now(dt.timezone.utc).isoformat())
        save(path, json.dumps(fresh).encode())
        return fresh
    except Exception as exc:
        return dict(old, error='"'"'Could not refresh: '"'"' + str(exc), stale=bool(old.get('"'"'title'"'"')))

def word():
    root = ET.fromstring(get('"'"'https://www.merriam-webster.com/wotd/feed/rss2'"'"'))
    item = root.find('"'"'./channel/item'"'"')
    if item is None:
        raise ValueError('"'"'No word in feed'"'"')
    fields = {node.tag.rsplit('"'"'}'"'"', 1)[-1]: node.text or '"'"''"'"' for node in item}
    body = plain(fields.get('"'"'shortdef'"'"') or fields.get('"'"'description'"'"', '"'"''"'"'))
    body = re.split(r'"'"'Did You Know\?'"'"', body, flags=re.I)[0]
    body = re.sub(r"^Merriam-Webster'"'"'s Word of the Day[^\n]*\n+", '"'"''"'"', body)
    return dict(title=plain(fields.get('"'"'title'"'"', '"'"''"'"')), body='"'"' '"'"'.join(body.split()[:100]),
                url=fields.get('"'"'link'"'"', '"'"''"'"'), published=fields.get('"'"'pubDate'"'"', '"'"''"'"'), source='"'"'Merriam-Webster'"'"')

def problem():
    topics = ['"'"'geometry'"'"', '"'"'multivariable-calculus'"'"', '"'"'linear-algebra'"'"', '"'"'geometry'"'"',
              '"'"'ordinary-differential-equations'"'"', '"'"'integration'"'"', '"'"'optimization'"'"']
    day = (DAY - dt.date(1970, 1, 1)).days
    topic = topics[day % len(topics)]
    query = urllib.parse.urlencode(dict(site='"'"'math'"'"', pagesize=100, order='"'"'desc'"'"', sort='"'"'votes'"'"',
                                       min=5, tagged=topic, filter='"'"'withbody'"'"'))
    data = json.loads(get('"'"'https://api.stackexchange.com/2.3/questions?'"'"' + query))
    if data.get('"'"'error_message'"'"'):
        raise ValueError(data['"'"'error_message'"'"'])
    pool = [q for q in data.get('"'"'items'"'"', []) if q.get('"'"'accepted_answer_id'"'"') and len(q['"'"'body'"'"']) < 7000
            and re.search(r'"'"'find|calculat|determin|prove|evaluat|area|volume|integral|solve'"'"', q['"'"'title'"'"'], re.I)]
    if topic == '"'"'geometry'"'"':
        pool = [q for q in pool if '"'"'<img '"'"' in q['"'"'body'"'"']] or pool
    if not pool:
        raise ValueError('"'"'No matching problems'"'"')
    q = pool[(day // 7) % len(pool)]
    parser = Plain()
    parser.feed(q['"'"'body'"'"'])
    return dict(rawTex=True, title=html.unescape(q['"'"'title'"'"']), body=plain(q['"'"'body'"'"']),
                images=parser.images[:3], url=q['"'"'link'"'"'], id=q['"'"'question_id'"'"'],
                author=html.unescape(q.get('"'"'owner'"'"', {}).get('"'"'display_name'"'"', '"'"'Community contributor'"'"')),
                topic=topic, source='"'"'Mathematics Stack Exchange'"'"', license=q.get('"'"'content_license'"'"', '"'"'CC BY-SA'"'"'),
                published=dt.datetime.fromtimestamp(q['"'"'creation_date'"'"'], dt.timezone.utc).date().isoformat())

FORMULA = re.compile(r'"'"'\$\$([\s\S]+?)\$\$|(?<!\\)\$((?:\\.|[^$\n])+?)(?<!\\)\$|\\\[([\s\S]+?)\\\]|\\\(([\s\S]+?)\\\)'"'"')

def normalize(tex):
    # MathText places integral limits automatically and requires braced fractions.
    tex = re.sub(r'"'"'\\(?:limits|nolimits|displaystyle|textstyle)(?![A-Za-z])'"'"', '"'"''"'"', tex)
    tex = re.sub(r'"'"'\\(?:dfrac|tfrac)\b'"'"', r'"'"'\\frac'"'"', tex)
    tex = re.sub(r'"'"'\\frac\s*([0-9A-Za-z])\s*([0-9A-Za-z])'"'"', r'"'"'\\frac{\1}{\2}'"'"', tex)
    tex = re.sub(r'"'"'\\frac\s*([0-9A-Za-z])\s*(?=\{)'"'"', r'"'"'\\frac{\1}'"'"', tex)
    # TeX permits an unbraced single token in either fraction argument.
    def argument(source, pos):
        while pos < len(source) and source[pos].isspace():
            pos += 1
        if pos == len(source):
            raise ValueError('"'"'Missing fraction argument'"'"')
        if source[pos] == '"'"'{'"'"':
            end, depth = pos + 1, 1
            while end < len(source) and depth:
                if source[end] == '"'"'{'"'"' and source[end - 1] != chr(92): depth += 1
                if source[end] == '"'"'}'"'"' and source[end - 1] != chr(92): depth -= 1
                end += 1
            if depth: raise ValueError('"'"'Unclosed fraction argument'"'"')
            return source[pos + 1:end - 1], end
        if source[pos] == chr(92):
            match = re.match(r'"'"'[A-Za-z]+|.'"'"', source[pos + 1:])
            end = pos + 1 + len(match[0])
            return source[pos:end], end
        return source[pos], pos + 1
    def fractions(source):
        output, pos = [], 0
        while pos < len(source):
            if source.startswith(chr(92) + '"'"'frac'"'"', pos):
                first, end = argument(source, pos + 5)
                second, pos = argument(source, end)
                output.append(chr(92) + '"'"'frac{'"'"' + fractions(first) + '"'"'}{'"'"' + fractions(second) + '"'"'}'"'"')
            else:
                output.append(source[pos])
                pos += 1
        return '"'"''"'"'.join(output)
    return fractions(tex)

def render(data):
    import matplotlib
    matplotlib.use('"'"'Agg'"'"')
    from matplotlib.mathtext import math_to_image
    from matplotlib.font_manager import FontProperties
    from PIL import Image
    equations = CACHE / '"'"'equations'"'"'
    equations.mkdir(exist_ok=True)
    parts = []
    for text, title in [(data.get('"'"'title'"'"', '"'"''"'"'), True), (data.get('"'"'body'"'"', '"'"''"'"'), False)]:
        start = 0
        for match in FORMULA.finditer(text):
            before = text[start:match.start()].strip()
            if before:
                parts.append(dict(text=before, title=title))
            tex = next(group for group in match.groups() if group is not None)
            try:
                normalized = normalize(tex)
                digest = hashlib.sha256((matplotlib.__version__ + '"'"':mask-v3:'"'"' + normalized).encode()).hexdigest()[:24]
                path = equations / ('"'"'py-'"'"' + digest + '"'"'.png'"'"')
                if not path.exists():
                    buffer = io.BytesIO()
                    with matplotlib.rc_context({'"'"'savefig.transparent'"'"': True}):
                        math_to_image('"'"'$'"'"' + normalized + '"'"'$'"'"', buffer, dpi=180, format='"'"'png'"'"', color='"'"'white'"'"', prop=FontProperties(size=16))
                    save(path, buffer.getvalue())
                with Image.open(path) as image:
                    width, height = image.size
                parts.append(dict(image=str(path), width=width / 2, height=height / 2, tex=tex))
            except Exception:
                # Keep unsupported source TeX visible; never lose the remaining content.
                parts.append(dict(text=tex, title=title, fallback=True))
            start = match.end()
        tail = text[start:].strip()
        if tail:
            parts.append(dict(text=tail, title=title))
    data['"'"'parts'"'"'] = parts
    data['"'"'unsupported'"'"'] = sum(bool(part.get('"'"'fallback'"'"')) for part in parts)

if __name__ == '"'"'__main__'"'"':
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
        w = executor.submit(cached, '"'"'word'"'"', word)
        p = executor.submit(cached, '"'"'math'"'"', problem)
        result = dict(word=w.result(), problem=p.result())
    try:
        render(result['"'"'problem'"'"'])
    except Exception as exc:
        result['"'"'problem'"'"']['"'"'parts'"'"'] = [dict(text=result['"'"'problem'"'"'].get(key, '"'"''"'"'), title=key == '"'"'title'"'"') for key in ('"'"'title'"'"', '"'"'body'"'"')]
        result['"'"'problem'"'"']['"'"'error'"'"'] = '"'"'Could not render equations: '"'"' + str(exc)
    print(json.dumps(result))
' """ + sh(date)) every 1h json timeout 90s
  let word = data.word
  let problem = data.problem
  on date { refresh() }
  let equationWidth = max(80, (tileWidth ?? 360) - 72)
  Column {
    fill: true
    gap: 14
    padding: [20, 16]
      Column {
        weight: 1
        fill: width
        scroll: true
        gap: 18
        Text { text: "DAILY / LEARNING"; fontSize: 12; letterSpacing: 3; color: accent }
        Text { text: fmtTime(now, "EEEE, d MMMM"); fontSize: 23; font: serif }
        Column {
          fill: width
          gap: 12
          padding: 20
          background: alpha(surface, 0.85)
          border: 1
          borderColor: alpha(accent, 0.3)
          radius: 20
          Text { text: "01   WORD OF THE DAY"; fontSize: 11; letterSpacing: 2; color: accent }
          Text { text: word.title ?? "Fetching today's word…"; font: serif; fontSize: 32 }
          Text { text: word.body ?? "Connect to the internet to load the publisher's word."; fontSize: 16 }
          Text { text: "Merriam-Webster · ${word.published ?? "loading"}"; fontSize: 11; color: muted }
          if word.error { Text { text: word.error; fontSize: 12; color: yellow } }
          Button { text: "Word entry in browser ↗"; onTap: url(word.url ?? "https://www.merriam-webster.com/word-of-the-day") }
        }
        Column {
          fill: width
          gap: 14
          padding: 20
          background: alpha(surface, 0.85)
          border: 1
          borderColor: alpha(blue, 0.35)
          radius: 20
          Text { text: "02   DAILY MATH SELECTION"; fontSize: 11; letterSpacing: 2; color: blue }
          Text { text: problem.topic ?? "Fetching…"; fontSize: 13; color: accent }
          if !problem.parts { Text { text: "Preparing typeset problem…"; fontSize: 16 } }
          for part in problem.parts ?? [] {
            if part.image {
              Image { src: part.image; width: min(part.width, equationWidth); height: part.height * min(1, (equationWidth) / part.width); fit: contain; label: part.tex; tint: foreground; radius: 6 }
            } else {
              Text { text: part.text; fontSize: part.title ? 21 : 16; font: part.fallback ? "mono" : "serif" }
            }
          }
          for picture in problem.images ?? [] {
            Image { src: picture; fill: width; height: 240; fit: contain; label: "Original problem diagram"; background: #ffffff; radius: 8 }
          }
          Text { text: "By ${problem.author ?? "…"} · Mathematics Stack Exchange\n${problem.license ?? ""} · selected ${problem.checked ?? "…"}"; fontSize: 11; color: muted }
          Text { text: "Equations rendered locally with MathText."; fontSize: 12; color: muted }
          if problem.unsupported > 0 { Text { text: "Some expressions are shown as source TeX. Open the source for full typesetting."; fontSize: 12; color: muted } }
          if problem.error { Text { text: problem.error; fontSize: 12; color: yellow } }
          Button { text: "Solution in browser ↗"; onTap: url(problem.url ?? "https://math.stackexchange.com/") }
        }
        Button { text: "Refresh from websites"; onTap: refresh() }
        Text { text: "Published content · saved locally for offline reading\nMath is selected daily from the archive."; fontSize: 11; color: muted; align: center }
      }
    Spacer { height: screenInset }
  }
}
