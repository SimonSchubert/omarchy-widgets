face "Daily learning" {
  meta { owl: 18; description: "Published daily word and a daily selection of sourced college math problems"; version: "4.1.1"; license: "MIT"; category: "productivity" }
  page: 0
  padding: 0
  background: linear(0, 0, 1, 1, [background, mix(background, blue, 0.12), background])
  state problemOffset = 0 persist
  state reload = 0
  source now = clock every 1m
  let date = fmtTime(now, "yyyy-MM-dd")
  requires { pacman: ["nodejs", "npm"] }
  source data = cmd("""node -e 'const fs=require('"'"'fs'"'"');
const dir=require('"'"'path'"'"').join(require('"'"'os'"'"').homedir(),'"'"'.cache'"'"','"'"'daily-learning'"'"');
fs.mkdirSync(dir,{recursive:true});
const date=/^\d{4}-\d{2}-\d{2}$/.test(process.argv[1]||'"'"''"'"') ? process.argv[1] : new Date().toISOString().slice(0,10);
const selection=String(process.argv[2]||0);
const force=Number(process.argv[3]||0);
const decode=s=>s.replace(/&#x([0-9a-f]+);/gi,(_,n)=>String.fromCodePoint(parseInt(n,16))).replace(/&#(\d+);/g,(_,n)=>String.fromCodePoint(+n)).replace(/&(amp|lt|gt|quot|apos|nbsp);/g,(_,n)=>({amp:'"'"'&'"'"',lt:'"'"'<'"'"',gt:'"'"'>'"'"',quot:'"'"'"'"'"',apos:"'"'"'",nbsp:'"'"' '"'"'})[n]);
const plain=s=>decode(s.replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g,'"'"'$1'"'"').replace(/<\/(p|div|blockquote|li|h\d)>/g,'"'"'\n\n'"'"').replace(/<br\s*\/?>/g,'"'"'\n'"'"').replace(/<[^>]+>/g,'"'"''"'"')).replace(/\n\s*\n\s*\n/g,'"'"'\n\n'"'"').trim();
const math=s=>plain(s);
const get=async u=>{let r=await fetch(u,{signal:AbortSignal.timeout(18000),headers:{'"'"'User-Agent'"'"':'"'"'DailyLearningPersonalWidget/1.0'"'"'}});if(!r.ok)throw Error('"'"'HTTP '"'"'+r.status);return r.text()};
async function cached(name,fn){const p=dir+'"'"'/'"'"'+name+'"'"'.json'"'"';let old={};try{old=JSON.parse(fs.readFileSync(p,'"'"'utf8'"'"'))}catch{};if(old.checked===date&&!old.error&&(name!=="math"||old.rawTex&&old.selection===selection)&&(name!=="word"||Date.now()-Date.parse(old.fetched)<28800000&&Number(old.force||0)===force))return old;if(name==="word"){
const budgetPath=dir+"/word-requests.json";
let budget={date,count:old.checked===date?1:0,last:old.checked===date?old.fetched:null,force:old.force||0};
try{const saved=JSON.parse(fs.readFileSync(budgetPath,"utf8"));if(saved.date===date)budget=saved;else budget={date,count:0,last:null,force:0}}catch{}
if(budget.count>=3||(budget.force===force&&Date.now()-Date.parse(budget.last)<28800000))return old;
budget={date,count:budget.count+1,last:new Date().toISOString(),force};
fs.writeFileSync(budgetPath,JSON.stringify(budget));
}
try{const fresh={...await fn(old),checked:date,selection,force,fetched:new Date().toISOString()};fs.writeFileSync(p,JSON.stringify(fresh));return fresh}catch(e){return {...old,error:'"'"'Could not refresh: '"'"'+e.message,stale:!!old.title}}}
async function libraries() {
  const path=require('"'"'path'"'"');
  const crypto=require('"'"'crypto'"'"');
  const manifest={"name":"daily-learning-equations","private":true,"dependencies":{"mathjax-full":"3.2.1","sharp":"0.35.5"}};
