  const contents=JSON.stringify(lock);
  const root=path.join(dir,'"'"'runtime-'"'"'+crypto.createHash('"'"'sha256'"'"').update(contents).digest('"'"'hex'"'"').slice(0,16));
  fs.mkdirSync(root,{recursive:true});
  const ready=path.join(root,'"'"'.ready'"'"');
  if(!fs.existsSync(ready)) {
    const mutex=path.join(root,'"'"'.installing'"'"');
    let owner=false;
    for(let attempt=0;attempt<170&&!owner&&!fs.existsSync(ready);attempt++) {
      try { fs.mkdirSync(mutex); owner=true; }
      catch(e) {
        if(e.code!=='"'"'EEXIST'"'"')throw e;
        if(Date.now()-fs.statSync(mutex).mtimeMs>180000)fs.rmdirSync(mutex);
        else await new Promise(resolve=>setTimeout(resolve,1000));
      }
    }
    if(owner) {
      try {
        fs.writeFileSync(path.join(root,'"'"'package.json'"'"'),JSON.stringify(manifest));
        fs.writeFileSync(path.join(root,'"'"'package-lock.json'"'"'),contents);
        require('"'"'child_process'"'"').execFileSync('"'"'npm'"'"',['"'"'ci'"'"','"'"'--prefix'"'"',root,'"'"'--ignore-scripts'"'"','"'"'--omit=dev'"'"','"'"'--no-audit'"'"','"'"'--no-fund'"'"','"'"'--fetch-retries=1'"'"','"'"'--fetch-timeout=30000'"'"'],{timeout:150000,stdio:['"'"'ignore'"'"','"'"'pipe'"'"','"'"'pipe'"'"']});
        const library=require('"'"'module'"'"').createRequire(path.join(root,'"'"'package.json'"'"'));
        library('"'"'mathjax-full/js/mathjax.js'"'"'); library('"'"'sharp'"'"');
        fs.writeFileSync(ready,'"'"'Installed from the embedded integrity-checked lockfile.'"'"');
      } finally { fs.rmdirSync(mutex); }
    }
    if(!fs.existsSync(ready))throw Error('"'"'Math renderer installation is still pending; refresh to retry.'"'"');
  }
  return require('"'"'module'"'"').createRequire(path.join(root,'"'"'package.json'"'"'));
}

async function renderProblem(problem) {
  const library=await libraries();
const fs=require('"'"'fs'"'"');
const path=require('"'"'path'"'"');
const crypto=require('"'"'crypto'"'"');
const {mathjax}=library('"'"'mathjax-full/js/mathjax.js'"'"');
const {TeX}=library('"'"'mathjax-full/js/input/tex.js'"'"');
const {SVG}=library('"'"'mathjax-full/js/output/svg.js'"'"');
const {liteAdaptor}=library('"'"'mathjax-full/js/adaptors/liteAdaptor.js'"'"');
const {RegisterHTMLHandler}=library('"'"'mathjax-full/js/handlers/html.js'"'"');
const {AllPackages}=library('"'"'mathjax-full/js/input/tex/AllPackages.js'"'"');
const sharp=library('"'"'sharp'"'"');
const adaptor=liteAdaptor(); RegisterHTMLHandler(adaptor);
const document=mathjax.document('"'"''"'"',{InputJax:new TeX({packages:AllPackages}),OutputJax:new SVG({fontCache:'"'"'none'"'"'})});
const dir=path.join(require('"'"'os'"'"').homedir(),'"'"'.cache/daily-learning/equations'"'"'); fs.mkdirSync(dir,{recursive:true});

  if(!problem.rawTex) return;
  const parts=[];
  for(const [text,title] of [[problem.title,true],[problem.body,false]]){
    const regex=/\$\$([\s\S]+?)\$\$|\$([^$\n]+?)\$|\\\[([\s\S]+?)\\\]|\\\(([\s\S]+?)\\\)/g;
    let start=0;
    for(const match of text.matchAll(regex)){
      const before=text.slice(start,match.index).trim(); if(before)parts.push({text:before,title});
      const tex=match.slice(1).find(x=>x!==undefined);
      const node=document.convert(tex,{display:true});
      if(adaptor.outerHTML(node).includes('"'"'data-mjx-error'"'"')) throw Error('"'"'Invalid TeX in source equation'"'"');
      const svg=adaptor.firstChild(node);
      const box=adaptor.getAttribute(svg,'"'"'viewBox'"'"').split(/\s+/).map(Number);
      const width=Math.ceil(box[2]/1000*18+20), height=Math.ceil(box[3]/1000*18+16);
      adaptor.setAttribute(svg,'"'"'width'"'"',String(width));adaptor.setAttribute(svg,'"'"'height'"'"',String(height));
      // Transparent glyph mask; OWL tints it with the live theme foreground.
      let xml=adaptor.outerHTML(svg).replace(/currentColor/g,'"'"'#ffffff'"'"');
      const image=path.join(dir,crypto.createHash('"'"'sha256'"'"').update(xml).digest('"'"'hex'"'"').slice(0,24)+'"'"'.png'"'"');
      if(!fs.existsSync(image))await sharp(Buffer.from(xml),{density:192}).png().toFile(image);
      parts.push({image,width,height,tex}); start=match.index+match[0].length;
    }
    const tail=text.slice(start).trim();if(tail)parts.push({text:tail,title});
  }
  problem.parts=parts;

}

(async()=>{
const [word,problem]=await Promise.all([
cached('"'"'word'"'"',async()=>{const xml=await get('"'"'https://www.merriam-webster.com/wotd/feed/rss2'"'"');const item=xml.match(/<item>([\s\S]*?)<\/item>/)?.[1];if(!item)throw Error('"'"'No word in feed'"'"');const tag=n=>item.match(new RegExp('"'"'<'"'"'+n+'"'"'[^>]*>([\\s\\S]*?)<\/'"'"'+n+'"'"'>'"'"'))?.[1]||'"'"''"'"';const desc=tag('"'"'description'"'"').replace(/<!\[CDATA\[|\]\]>/g,'"'"''"'"');const short=tag('"'"'merriam:shortdef'"'"');let body=plain(short||desc);if(!short)body=body.split(/Did You Know\?/i)[0].replace(/^Merriam-Webster'"'"'s Word of the Day[^\n]*\n+/,'"'"''"'"');return {title:plain(tag('"'"'title'"'"')),body:body.split(/\s+/).slice(0,100).join('"'"' '"'"'),url:plain(tag('"'"'link'"'"')),published:plain(tag('"'"'pubDate'"'"')),source:'"'"'Merriam-Webster'"'"'};}),
cached('"'"'math'"'"',async(old)=>{const topics=['"'"'geometry'"'"','"'"'multivariable-calculus'"'"','"'"'linear-algebra'"'"','"'"'geometry'"'"','"'"'ordinary-differential-equations'"'"','"'"'integration'"'"','"'"'optimization'"'"'];const day=Math.floor(Date.parse(date+'"'"'T00:00:00Z'"'"')/86400000);const topic=topics[day%topics.length];const api='"'"'https://api.stackexchange.com/2.3/questions?site=math&pagesize=100&order=desc&sort=votes&min=5&tagged='"'"'+encodeURIComponent(topic)+'"'"'&filter=withbody'"'"';const j=JSON.parse(await get(api));if(j.error_message)throw Error(j.error_message);let pool=(j.items||[]).filter(x=>x.accepted_answer_id&&x.body.length<7000&&/find|calculat|determin|prove|evaluat|area|volume|integral|solve/i.test(x.title));if(topic==='"'"'geometry'"'"'){const illustrated=pool.filter(x=>/<img /i.test(x.body));if(illustrated.length)pool=illustrated;}if(!pool.length)throw Error('"'"'No matching problems'"'"');const choices=old.checked===date&&old.selection!==selection ? pool.filter(x=>x.question_id!==old.id) : pool;const q=choices[(Math.floor(day/7)+Number(selection))%choices.length];const images=[...q.body.matchAll(/<img[^>]+src="(https:[^"]+)"/g)].map(x=>decode(x[1])).slice(0,3);return {rawTex:true,title:math(q.title),body:math(q.body),images,url:q.link,id:q.question_id,author:decode(q.owner?.display_name||'"'"'Community contributor'"'"'),topic,source:'"'"'Mathematics Stack Exchange'"'"',license:q.content_license||'"'"'CC BY-SA'"'"',published:new Date(q.creation_date*1000).toISOString().slice(0,10)};})]);
try { await renderProblem(problem); }
catch(e) { problem.error='"'"'Could not render equations: '"'"'+e.message; problem.parts=[{text:problem.title||'"'"'Loading problem…'"'"',title:true},{text:problem.body||'"'"'Connect to the internet to load the source.'"'"'}]; }
console.log(JSON.stringify({word,problem}));
})().catch(e=>{console.log(JSON.stringify({error:e.message}));process.exitCode=0});' """ + sh(date) + " " + sh(problemOffset) + " " + sh(reload)) every 15m json timeout 210s
  let word = data.word
  let problem = data.problem
  on date { problemOffset = 0 }
  Column {
    fill: true
    gap: 14
    padding: [20, 16]
      Column {
        weight: 1
        fill: width
        scroll: true
        gap: 18
        Text { text: "DAILY / LEARNING"; fontSize: 12; letterSpacing: 3; color: accent }
        Text { text: fmtTime(now, "EEEE, d MMMM"); fontSize: 23; font: serif }
        Column {
          fill: width
          gap: 12
          padding: 20
          background: alpha(surface, 0.85)
          border: 1
          borderColor: alpha(accent, 0.3)
          radius: 20
          Text { text: "01   WORD OF THE DAY"; fontSize: 11; letterSpacing: 2; color: accent }
          Text { text: word.title ?? "Fetching today's word…"; font: serif; fontSize: 32 }
          Text { text: word.body ?? "Connect to the internet to load the publisher's word."; fontSize: 16 }
          Text { text: "Merriam-Webster · ${word.published ?? "loading"}"; fontSize: 11; color: muted }
          if word.error { Text { text: word.error; fontSize: 12; color: yellow } }
          Button { text: "Word entry in browser ↗"; onTap: url(word.url ?? "https://www.merriam-webster.com/word-of-the-day") }
        }
        Column {
          fill: width
          gap: 14
          padding: 20
          background: alpha(surface, 0.85)
          border: 1
          borderColor: alpha(blue, 0.35)
          radius: 20
          Row {
            fill: width
            align: center
            Text { text: "02   DAILY MATH SELECTION"; fontSize: 11; letterSpacing: 2; color: blue; weight: 1 }
            Box {
              width: 32
              height: 32
              align: center
              radius: 16
              onTap: problemOffset = problemOffset + 1
              Text { text: "↻"; fontSize: 22; color: blue; align: center }
            }
          }
          Text { text: problem.topic ?? "Fetching…"; fontSize: 13; color: accent }
          if !problem.parts { Text { text: "Preparing typeset problem…"; fontSize: 16 } }
          for part in problem.parts ?? [] {
            if part.image {
              Image { src: part.image; width: min(part.width, tileWidth - 72); height: part.height * min(1, (tileWidth - 72) / part.width); fit: contain; label: part.tex; tint: foreground; radius: 6 }
            } else {
              Text { text: part.text; fontSize: part.title ? 21 : 16; font: serif }
            }
          }
          for picture in problem.images ?? [] {
            Image { src: picture; fill: width; height: 240; fit: contain; label: "Original problem diagram"; background: #ffffff; radius: 8 }
          }
          Text { text: "By ${problem.author ?? "…"} · Mathematics Stack Exchange\n${problem.license ?? ""} · selected ${problem.checked ?? "…"}"; fontSize: 11; color: muted }
          Text { text: "Equations typeset locally with MathJax."; fontSize: 12; color: muted }
          if problem.error { Text { text: problem.error; fontSize: 12; color: yellow } }
          Button { text: "Solution in browser ↗"; onTap: url(problem.url ?? "https://math.stackexchange.com/") }
        }
        Button { text: "Atualizar dos sites ↻"; onTap: reload = reload + 1 }
        Text { text: "Published content · saved locally for offline reading\nMath is selected daily from the archive."; fontSize: 11; color: muted; align: center }
      }
    Spacer { height: screenInset }
  }
}
