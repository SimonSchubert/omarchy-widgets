      methodLabel: "MÉTHODE DE CALCUL", schoolLabel: "ÉCOLE JURIDIQUE (ASR)", tuneLabel: "MARGE DE SÉCURITÉ",
      mMWL: "Ligue Islamique Mondiale (MWL)", mMakkah: "Oumm al-Qura, La Mecque", mEgypt: "Autorité Égyptienne (EGAS)", mISNA: "ISNA (Amérique du Nord)",
      mKarachi: "Université de Karachi", mKemenag: "Kemenag RI (Indonésie)", mDiyanet: "Diyanet (Turquie)", mMUIS: "MUIS (Singapour)",
      mShortMWL: "MWL", mShortMakkah: "Oumm al-Qura", mShortEgypt: "Égypte", mShortISNA: "ISNA", mShortKarachi: "Karachi", mShortKemenag: "Indonésie", mShortDiyanet: "Diyanet", mShortMUIS: "MUIS",
      shafii: "Standard (Chaféite, Malékite, Hanbalite)", hanafi: "Hanafite",
      shafiiShort: "Chaféite", hanafiShort: "Hanafite",
      verseFreqLabel: "FRÉQUENCE DU VERSET", verseEdLabel: "TRADUCTION & TAFSIR",
      edAuto: "Auto (Selon la langue)", edSahih: "Sahih International (Anglais)", edAsad: "Muhammad Asad (Anglais)", edMuyassar: "Tafsir Al-Muyassar (Arabe)",
      edIndo: "Indonésien", edDiyanet: "Turc (Diyanet)", edUrdu: "Ourdou (Ahmed Ali)", edFrench: "Français (Hamidullah)",
      hadithFreqLabel: "FRÉQUENCE DU HADITH", hadithBookLabel: "RECUEIL DE HADITH",
      bkNawawi: "40 Hadiths an-Nawawi", bkQudsi: "40 Hadiths Qudsi", bkBukhari: "Sahih al-Boukhari", bkMuslim: "Sahih Mouslim",
      freq1h: "Toutes les 1h", freq6h: "Toutes les 6h", freq12h: "Toutes les 12h", freq1d: "Quotidien (24h)",
      verseArToggle: "Verset en Arabe", hadithArToggle: "Hadith en Arabe",
      closeSettings: "✓ Terminé", searchApps: "rechercher des applis",
      sunnahTimes: "HORAIRES SUNNAH & NUIT",
      am: "AM", pm: "PM"
    }
  }
  let tr = get(dict, lang, dict.en)
  let isRtl = lang == "ar" || lang == "ur"
  // Right-to-Left Mark (U+200F) so strings starting with numbers render in true RTL order
  let rlm = "‏"

  // Localized preset city display name when a preset city is selected
  let placeName = city == "Mecca" ? tr.cityMecca :
    city == "Medina" ? tr.cityMedina :
    city == "Cairo" ? tr.cityCairo :
    city == "Istanbul" ? tr.cityIstanbul :
    city == "Jakarta" ? tr.cityJakarta :
    city == "London" ? tr.cityLondon :
    city == "New York" ? tr.cityNY :
    rawPlaceName

  // Main Clock & Date formatting (12h vs 24h and configurable Date Formats in selected language)
  let sysHour = num(fmtTime(now, "H"))
  let sysMinute = sysHour * 60 + num(fmtTime(now, "m"))
  let hr12Val = sysHour % 12 == 0 ? 12 : sysHour % 12
  let clockHourStr = use24h ? fmtTime(now, "HH") : pad(hr12Val, 2, "0")
  let clockMinStr = fmtTime(now, "mm")
  let clockAmPm = sysHour < 12 ? tr.am : tr.pm

  let dDayStr = pad(fmtTime(now, "d"), 2, "0")
  let dMonStr = pad(fmtTime(now, "M"), 2, "0")
  let dYearStr = fmtTime(now, "yyyy")
  let dMonShort = fmtTime(now, "MMM", null, lang)
  let dWeekdayShort = fmtTime(now, "EEE", null, lang)
  let sepComma = isRtl ? "،" : ","
  let gregRaw = dateFmt == "DD/MM/YYYY" ? "${dWeekdayShort}${sepComma} ${dDayStr}/${dMonStr}/${dYearStr}" :
    dateFmt == "MM/DD/YYYY" ? "${dWeekdayShort}${sepComma} ${dMonStr}/${dDayStr}/${dYearStr}" :
    dateFmt == "YYYY-MM-DD" ? "${dWeekdayShort}${sepComma} ${dYearStr}-${dMonStr}-${dDayStr}" :
    dateFmt == "DD MMM YYYY" ? "${dWeekdayShort}${sepComma} ${dDayStr} ${dMonShort} ${dYearStr}" :
    fmtTime(now, "EEEE, d MMMM yyyy", null, lang)
  let gregFormatted = isRtl ? "${rlm}${gregRaw}" : gregRaw

  // The offset moves the date along the calendar, as a correction would: the Hijri date
  // of a day `hijriAdj` away (Aladhan's HJCoSA ignores `adjustment`). Before the first
  // fetched day, only the day number moves, within the month.
  let hijriToday = todayItem != null && todayItem.date != null ? todayItem.date.hijri : null
  let hijriShifted = todayIdx >= 0 && todayIdx + hijriAdj >= 0 ? first(drop(allDays, todayIdx + hijriAdj)) : null
  let hijriInfo = hijriAdj == 0 ? hijriToday : hijriShifted != null && hijriShifted.date != null ? hijriShifted.date.hijri : hijriToday
  let hijriDay = hijriAdj != 0 && hijriShifted == null && hijriToday != null && num(hijriToday.day) + hijriAdj >= 1 && num(hijriToday.day) + hijriAdj <= 29 ? str(floor(num(hijriToday.day)) + hijriAdj) : hijriInfo != null ? hijriInfo.day : ""
  // Prefix with Right-to-Left Mark (rlm) in Arabic/Urdu so "9 جمادى الأولى 1448 هـ" renders RTL from right to left
  let hijriFormatted = hijriInfo != null ? (
    isRtl ? "${rlm}${hijriDay} ${hijriInfo.month.ar} ${hijriInfo.year} هـ" :
    dateFmt == "DD/MM/YYYY" ? "${pad(hijriDay, 2, "0")}/${pad(hijriInfo.month.number, 2, "0")}/${hijriInfo.year} H (${hijriInfo.month.en})" :
    dateFmt == "MM/DD/YYYY" ? "${pad(hijriInfo.month.number, 2, "0")}/${pad(hijriDay, 2, "0")}/${hijriInfo.year} H (${hijriInfo.month.en})" :
    "${hijriDay} ${hijriInfo.month.en} ${hijriInfo.year} H"
  ) : ""

  // Extract prayer timings and convert to minutes + 12h/24h formatted strings
  let rawTimings = todayItem != null ? todayItem.timings : null
  let rImsak = rawTimings != null ? sub(rawTimings.Imsak, 0, 5) : null
  let rFajr = rawTimings != null ? sub(rawTimings.Fajr, 0, 5) : null
  let rSunrise = rawTimings != null ? sub(rawTimings.Sunrise, 0, 5) : null
  let rDhuhr = rawTimings != null ? sub(rawTimings.Dhuhr, 0, 5) : null
  let rAsr = rawTimings != null ? sub(rawTimings.Asr, 0, 5) : null
  let rMaghrib = rawTimings != null ? sub(rawTimings.Maghrib, 0, 5) : null
  let rIsha = rawTimings != null ? sub(rawTimings.Isha, 0, 5) : null
  let rMidnight = rawTimings != null && rawTimings.Midnight != null ? sub(rawTimings.Midnight, 0, 5) : null
  let rLastThird = rawTimings != null && rawTimings.Lastthird != null ? sub(rawTimings.Lastthird, 0, 5) : null

  let imsakMin = rImsak != null ? floor(num(sub(rImsak, 0, 2))) * 60 + floor(num(sub(rImsak, 3, 5))) : null
  let fMin = rFajr != null ? floor(num(sub(rFajr, 0, 2))) * 60 + floor(num(sub(rFajr, 3, 5))) : null
  let sMin = rSunrise != null ? floor(num(sub(rSunrise, 0, 2))) * 60 + floor(num(sub(rSunrise, 3, 5))) : null
  let dMin = rDhuhr != null ? floor(num(sub(rDhuhr, 0, 2))) * 60 + floor(num(sub(rDhuhr, 3, 5))) : null
  let aMin = rAsr != null ? floor(num(sub(rAsr, 0, 2))) * 60 + floor(num(sub(rAsr, 3, 5))) : null
  let mgMin = rMaghrib != null ? floor(num(sub(rMaghrib, 0, 2))) * 60 + floor(num(sub(rMaghrib, 3, 5))) : null
  let iMin = rIsha != null ? floor(num(sub(rIsha, 0, 2))) * 60 + floor(num(sub(rIsha, 3, 5))) : null
  let midMin = rMidnight != null ? floor(num(sub(rMidnight, 0, 2))) * 60 + floor(num(sub(rMidnight, 3, 5))) : null
  let ltMin = rLastThird != null ? floor(num(sub(rLastThird, 0, 2))) * 60 + floor(num(sub(rLastThird, 3, 5))) : null

  let activeId = rawTimings == null ? null :
    curMin < fMin ? "night" :
    curMin < sMin ? "fajr" :
    curMin < dMin ? "sunrise" :
    curMin < aMin ? "dhuhr" :
    curMin < mgMin ? "asr" :
    curMin < iMin ? "maghrib" :
    "isha"

  let nextId = rawTimings == null ? null :
    curMin < fMin ? "fajr" :
    curMin < sMin ? "sunrise" :
    curMin < dMin ? "dhuhr" :
    curMin < aMin ? "asr" :
    curMin < mgMin ? "maghrib" :
    curMin < iMin ? "isha" :
    "fajr"

  let isTomorrow = rawTimings != null && curMin >= iMin && nextId == "fajr"

  let rawPrayers = [
    { id: "fajr", name: tr.fajr, ar: "الفجر", raw: rFajr, min: fMin, fard: true },
    { id: "sunrise", name: tr.sunrise, ar: "الشروق", raw: rSunrise, min: sMin, fard: false },
    { id: "dhuhr", name: tr.dhuhr, ar: "الظهر", raw: rDhuhr, min: dMin, fard: true },
    { id: "asr", name: tr.asr, ar: "العصر", raw: rAsr, min: aMin, fard: true },
    { id: "maghrib", name: tr.maghrib, ar: "المغرب", raw: rMaghrib, min: mgMin, fard: true },
    { id: "isha", name: tr.isha, ar: "العشاء", raw: rIsha, min: iMin, fard: true }
  ]

  let prayersList = rawPrayers.map(p => merge(p, {
    disp: p.raw == null ? "offline" : use24h ? p.raw : "${(floor(p.min / 60) % 12 == 0 ? 12 : floor(p.min / 60) % 12)}:${pad(p.min % 60, 2, "0")} ${floor(p.min / 60) % 24 < 12 ? tr.am : tr.pm}",
    shortDisp: p.raw == null ? "offline" : use24h ? p.raw : "${(floor(p.min / 60) % 12 == 0 ? 12 : floor(p.min / 60) % 12)}:${pad(p.min % 60, 2, "0")}",
    ampm: p.raw == null || use24h ? "" : (floor(p.min / 60) % 24 < 12 ? tr.am : tr.pm),
    isCurrent: rawTimings != null && p.id == activeId,
    isNext: rawTimings != null && p.id == nextId,
    isPast: rawTimings != null && p.min <= curMin && p.id != activeId
  }))

  let sunnahList = [
    { id: "imsak", name: tr.imsak, ar: "الإمساك", raw: rImsak, min: imsakMin },
    { id: "midnight", name: tr.midnight, ar: "منتصف الليل", raw: rMidnight, min: midMin },
    { id: "lastthird", name: tr.lastThird, ar: "الثلث الأخير", raw: rLastThird, min: ltMin }
  ].map(s => merge(s, {
    disp: s.raw == null ? "offline" : use24h ? s.raw : "${(floor(s.min / 60) % 12 == 0 ? 12 : floor(s.min / 60) % 12)}:${pad(s.min % 60, 2, "0")} ${floor(s.min / 60) % 24 < 12 ? tr.am : tr.pm}"
  }))

  let nextPrayerObj = prayersList.find(p => p.id == nextId) ?? prayersList[0]
  let minLeft = rawTimings == null ? null : curMin >= iMin ? (1440 - curMin + fMin) : max(nextPrayerObj.min - curMin, 0)
  let hLeft = minLeft != null ? floor(minLeft / 60) : 0
  let mLeft = minLeft != null ? minLeft % 60 : 0
  let countdownStr = minLeft == null ? "offline" : isRtl ? "${rlm}${hLeft > 0 ? "${hLeft}س ${mLeft}د" : "${mLeft}د"}" : (hLeft > 0 ? "${hLeft}h ${mLeft}m" : "${mLeft}m")
  let prayerSoon = minLeft != null && minLeft <= 15

  let methodDisplay = method == "3" ? tr.mShortMWL :
    method == "4" ? tr.mShortMakkah :
    method == "5" ? tr.mShortEgypt :
    method == "2" ? tr.mShortISNA :
    method == "1" ? tr.mShortKarachi :
    method == "20" ? tr.mShortKemenag :
    method == "13" ? tr.mShortDiyanet :
    tr.mShortMUIS
  let schoolDisplay = school == "1" ? tr.hanafiShort : tr.shafiiShort

  // Prayer Habit Tracker logic (last 7 days)
  let todayIso = fmtTime(now, "yyyy-MM-dd", zone)
  let todayDayIdx = todayIso != null ? floor(parseTime("${todayIso}T00:00:00Z") / 86400) : 0
  let activeTrackIdx = selectedTrackDay ?? todayDayIdx
  let activeTrackKey = str(activeTrackIdx)
  let fardIds = ["fajr", "dhuhr", "asr", "maghrib", "isha"]
  let fardPrayers = prayersList.filter(p => p.fard)

  let activeDayRecord = get(prayerLog, activeTrackKey, {})
  let activeDayCount = fardIds.count(k => get(activeDayRecord, k, false) == true)

  let last7Days = range(7).map(i => {
    idx: todayDayIdx - (6 - i),
    key: str(todayDayIdx - (6 - i)),
    label: i == 6 ? tr.todayLabel : fmtTime((todayDayIdx - (6 - i)) * 86400, "EEE", "UTC", lang),
    dayNum: fmtTime((todayDayIdx - (6 - i)) * 86400, "d", "UTC"),
    rec: get(prayerLog, str(todayDayIdx - (6 - i)), {}),
    count: fardIds.count(k => get(get(prayerLog, str(todayDayIdx - (6 - i)), {}), k, false) == true),
    isToday: i == 6,
    isSelected: (todayDayIdx - (6 - i)) == activeTrackIdx
  })

  let weekTotalDone = sum(last7Days.map(d => d.count))
  let weekRatePct = round(weekTotalDone / 35 * 100)
  let weekFullDays = last7Days.count(d => d.count == 5)

  // Verse of Today logic
  let verseIntervalSec = verseFreq == "1h" ? 3600 : verseFreq == "6h" ? 21600 : verseFreq == "12h" ? 43200 : 86400
  let verseBucket = floor((now ?? 0) / verseIntervalSec)
  let ayahNum = floor(hash("islamic-ayah", verseBucket, verseSeed) * 6236) + 1
  let resolvedVerseEdition = verseEdition != "auto" ? verseEdition : (
    lang == "ar" ? "ar.muyassar" :
    lang == "id" ? "id.indonesian" :
    lang == "tr" ? "tr.diyanet" :
    lang == "ur" ? "ur.ahmedali" :
    lang == "fr" ? "fr.hamidullah" :
    "en.sahih"
  )

  let verseEditionDisplay = resolvedVerseEdition == "ar.muyassar" ? tr.edMuyassar :
    resolvedVerseEdition == "en.sahih" ? tr.edSahih :
    resolvedVerseEdition == "en.asad" ? tr.edAsad :
    resolvedVerseEdition == "id.indonesian" ? tr.edIndo :
    resolvedVerseEdition == "tr.diyanet" ? tr.edDiyanet :
    resolvedVerseEdition == "ur.ahmedali" ? tr.edUrdu :
    tr.edFrench

  let verseFreqDisplay = verseFreq == "1h" ? tr.freq1h :
    verseFreq == "6h" ? tr.freq6h :
    verseFreq == "12h" ? tr.freq12h :
    tr.freq1d

  source ayahAr = http("https://api.alquran.cloud/v1/ayah/${int(ayahNum)}/ar.alquran") every 1h timeout 10s json status
  source ayahTr = http("https://api.alquran.cloud/v1/ayah/${int(ayahNum)}/${enc(resolvedVerseEdition)}") every 1h timeout 10s json status

  let liveVerse = ayahTr != null && ayahTr.ok && ayahTr.out.data != null ? {
    arabic: ayahAr != null && ayahAr.ok && ayahAr.out.data != null ? trim(ayahAr.out.data.text ?? "") : "",
    text: trim(ayahTr.out.data.text ?? ""),
    ref: isRtl
      ? "${ayahTr.out.data.surah.name} · الآية ${ayahTr.out.data.numberInSurah}"
      : "${ayahTr.out.data.surah.englishName} (${ayahTr.out.data.surah.name}) · ${ayahTr.out.data.surah.number}:${ayahTr.out.data.numberInSurah}"
  } : null
  let shownVerse = liveVerse ?? lastVerse
  on liveVerse.text { lastVerse = liveVerse }

  // Hadith of Today logic
  let hadithIntervalSec = hadithFreq == "1h" ? 3600 : hadithFreq == "6h" ? 21600 : hadithFreq == "12h" ? 43200 : 86400
  let hadithBucket = floor((now ?? 0) / hadithIntervalSec)
  let hadithMax = hadithBook == "nawawi" ? 42 : hadithBook == "qudsi" ? 40 : 300
  let hadithNum = floor(hash("islamic-hadith", hadithBook, hadithBucket, hadithSeed) * hadithMax) + 1

  let hadithArEd = hadithBook == "qudsi" ? "ara-qudsi" :
    hadithBook == "bukhari" ? "ara-bukhari" :
    hadithBook == "muslim" ? "ara-muslim" :
    "ara-nawawi"

  let hadithTrEd = hadithBook == "qudsi" ? (lang == "fr" ? "fra-qudsi" : "eng-qudsi") :
    hadithBook == "bukhari" ? (
      lang == "id" ? "ind-bukhari" :
      lang == "tr" ? "tur-bukhari" :
      lang == "ur" ? "urd-bukhari" :
      lang == "fr" ? "fra-bukhari" :
      "eng-bukhari"
    ) :
    hadithBook == "muslim" ? (
      lang == "id" ? "ind-muslim" :
      lang == "tr" ? "tur-muslim" :
      lang == "ur" ? "urd-muslim" :
      lang == "fr" ? "fra-muslim" :
      "eng-muslim"
    ) :
    (lang == "tr" ? "tur-nawawi" : lang == "fr" ? "fra-nawawi" : "eng-nawawi")

  source hadithArSrc = http("https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions/${enc(hadithArEd)}/${int(hadithNum)}.min.json") every 1h timeout 10s json status
  source hadithTrSrc = http("https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions/${enc(hadithTrEd)}/${int(hadithNum)}.min.json") every 1h timeout 10s json status

  let bookDisplayName = hadithBook == "nawawi" ? tr.bkNawawi :
    hadithBook == "qudsi" ? tr.bkQudsi :
    hadithBook == "bukhari" ? tr.bkBukhari :
    tr.bkMuslim

  let hadithFreqDisplay = hadithFreq == "1h" ? tr.freq1h :
    hadithFreq == "6h" ? tr.freq6h :
    hadithFreq == "12h" ? tr.freq12h :
    tr.freq1d

  let rawHadithAr = hadithArSrc != null && hadithArSrc.ok && hadithArSrc.out.hadiths != null && len(hadithArSrc.out.hadiths) > 0
    ? (hadithArSrc.out.hadiths[0].text ?? "")
    : ""
  let rawHadithTr = hadithTrSrc != null && hadithTrSrc.ok && hadithTrSrc.out.hadiths != null && len(hadithTrSrc.out.hadiths) > 0
    ? (hadithTrSrc.out.hadiths[0].text ?? "")
    : ""

  let liveHadith = trim(rawHadithTr) != "" ? {
    arabic: trim(rawHadithAr.replace("<br />", "\n").replace("<br/>", "\n").replace("<br>", "\n").replace("<BR />", "\n").replace("<BR/>", "\n").replace("<BR>", "\n").replace("</p>", "\n").replace("<p>", "").replace("<b>", "").replace("</b>", "").replace("<i>", "").replace("</i>", "").replace("&quot;", "\"").replace("&#39;", "'").replace("&apos;", "'").replace("&amp;", "&").replace("&nbsp;", " ").replace("\n\n\n", "\n\n")),
    text: trim(rawHadithTr.replace("<br />", "\n").replace("<br/>", "\n").replace("<br>", "\n").replace("<BR />", "\n").replace("<BR/>", "\n").replace("<BR>", "\n").replace("</p>", "\n").replace("<p>", "").replace("<b>", "").replace("</b>", "").replace("<i>", "").replace("</i>", "").replace("&quot;", "\"").replace("&#39;", "'").replace("&apos;", "'").replace("&amp;", "&").replace("&nbsp;", " ").replace("\n\n\n", "\n\n")),
    ref: "${bookDisplayName} · #${hadithNum}"
  } : null
  let shownHadith = liveHadith != null ? liveHadith : (lastHadith != null && trim(lastHadith.text ?? "") != "" ? lastHadith : null)
  on liveHadith.text first { lastHadith = liveHadith }
  on hadithTrSrc first {
    if value.ok && trim(value.out.hadiths[0].text ?? "") == "" {
      hadithSeed = hadithSeed + 1
    }
  }

  let cleanHadithAr = shownHadith != null && shownHadith.arabic != null
    ? trim(shownHadith.arabic.replace("<br />", "\n").replace("<br/>", "\n").replace("<br>", "\n").replace("<BR />", "\n").replace("<BR/>", "\n").replace("<BR>", "\n").replace("</p>", "\n").replace("<p>", "").replace("<b>", "").replace("</b>", "").replace("<i>", "").replace("</i>", "").replace("&quot;", "\"").replace("&#39;", "'").replace("&apos;", "'").replace("&amp;", "&").replace("&nbsp;", " ").replace("\n\n\n", "\n\n"))
    : ""
  let cleanHadithText = shownHadith != null && shownHadith.text != null
    ? trim(shownHadith.text.replace("<br />", "\n").replace("<br/>", "\n").replace("<br>", "\n").replace("<BR />", "\n").replace("<BR/>", "\n").replace("<BR>", "\n").replace("</p>", "\n").replace("<p>", "").replace("<b>", "").replace("</b>", "").replace("<i>", "").replace("</i>", "").replace("&quot;", "\"").replace("&#39;", "'").replace("&apos;", "'").replace("&amp;", "&").replace("&nbsp;", " ").replace("\n\n\n", "\n\n"))
    : ""

  // Weather & Dashboard helpers (with 12h/24h formatted step labels)
  let sun = [dayWx.astronomy[0].sunrise, dayWx.astronomy[0].sunset]
    .map(s => match(s ?? "", "(\\d+):(\\d+) (AM|PM)"))
    .map(t => t == null ? null : (num(t[0]) % 12 + (t[2] == "PM" ? 12 : 0)) * 60 + num(t[1]))
  let night = sun[0] != null && (sysMinute < sun[0] || sysMinute >= sun[1])
  let sky = contains(["113", "116"], curWx.weatherCode) ? (night ? blue : yellow) : foreground
  let wxSteps = flatten(range(2).map(i => (wxData.weather[i].hourly ?? []).map(h => {
    hr: i * 24 + num(h.time) / 100,
    h24: (i * 24 + floor(num(h.time) / 100)) % 24,
    t: num(h.tempC),
    rain: num(h.chanceofrain),
    code: h.weatherCode
  }))).filter(s => s.hr > sysHour - 3).take(4).map(s => merge(s, {
    timeLabel: s.hr <= sysHour
      ? tr.nowLabel
      : (use24h
          ? "${pad(s.h24, 2, "0")}:00"
          : "${isRtl ? rlm : ""}${s.h24 % 12 == 0 ? 12 : s.h24 % 12} ${s.h24 < 12 ? tr.am : tr.pm}")
  }))

  let playing = m != null && m.available != false && m.title != null

  // Morning & Evening Azkar time windows & notification triggers
  // Morning Azkar: from Fajr until 90 minutes after Sunrise
  // Evening Azkar: from Asr until 90 minutes after Maghrib
  let isMorningAzkarTime = rawTimings != null && curMin >= fMin && curMin <= sMin + 90
  let isEveningAzkarTime = rawTimings != null && curMin >= aMin && curMin <= mgMin + 90

  // Comprehensive Authentic Azkar & Duas Dataset
  let allAzkar = [
    // Morning Azkar (أذكار الصباح)
    {id: "m1", cat: "morning", target: 1, nameAr: "آية الكرسي", nameEn: "Ayat al-Kursi", ar: "﴿اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ وَلَا يَئُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ﴾", noteAr: "من قالها حين يصبح أجير من الجن حتى يمسي", noteEn: "Protection from Jinn until evening"},
    {id: "m2", cat: "morning", target: 3, nameAr: "سورة الإخلاص والمعوذتين", nameEn: "Al-Ikhlas, Al-Falaq & An-Nas", ar: "﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ﴾\n﴿قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ * مِن شَرِّ مَا خَلَقَ * وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ * وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ * وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ﴾\n﴿قُلْ أَعُوذُ بِرَبِّ النَّاسِ * مَلِكِ النَّاسِ * إِلَٰهِ النَّاسِ * مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ * الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ * مِنَ الْجِنَّةِ وَالنَّاسِ﴾", noteAr: "ثلاث مرات حين يصبح تكفيه من كل شيء", noteEn: "Recite 3 times to suffice against all harm"},
    {id: "m3", cat: "morning", target: 1, nameAr: "أصبحنا وأصبح الملك لله", nameEn: "Morning Declaration", ar: "أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ، لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ، رَبِّ أَسْأَلُكَ خَيْرَ مَا فِي هَٰذَا الْيَوْمِ وَخَيْرَ مَا بَعْدَهُ، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَٰذَا الْيَوْمِ وَشَرِّ مَا بَعْدَهُ", noteAr: "سؤال خير هذا اليوم وما بعده والاستعاذة من شره", noteEn: "We have reached the morning and the dominion belongs to Allah"},
    {id: "m4", cat: "morning", target: 1, nameAr: "سيد الاستغفار", nameEn: "Sayyid al-Istighfar", ar: "اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَٰهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَىٰ عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ لَكَ بِذَنْبِي فَاغْفِرْ لِي فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ", noteAr: "من قالها موقناً بها حين يصبح فمات من يومه دخل الجنة", noteEn: "Master supplication for forgiveness"},
    {id: "m5", cat: "morning", target: 1, nameAr: "اللهم بك أصبحنا", nameEn: "By You We Enter Morning", ar: "اللَّهُمَّ بِكَ أَصْبَحْنَا، وَبِكَ أَمْسَيْنَا، وَبِكَ نَحْيَا، وَبِكَ نَمُوتُ وَإِلَيْكَ النُّشُورُ", noteAr: "تفويض الأمر لله في الصباح", noteEn: "O Allah, by You we enter the morning and by You we live"},
    {id: "m6", cat: "morning", target: 3, nameAr: "رضيت بالله رباً", nameEn: "Pleasure with Allah", ar: "رَضِيتُ بِاللَّهِ رَبًّا، وَبِالْإِسْلَامِ دِينًا، وَبِمُحَمَّدٍ ﷺ نَبِيًّا", noteAr: "من قالها ثلاثاً حين يصبح كان حقاً على الله أن يرضيه يوم القيامة", noteEn: "Allah will be pleased with him on the Day of Judgment"},
    {id: "m7", cat: "morning", target: 3, nameAr: "بسم الله الذي لا يضر مع اسمه شيء", nameEn: "Protection from Harm", ar: "بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ", noteAr: "من قالها ثلاثاً لم يضره من الله شيء", noteEn: "Nothing in earth or heaven will harm him"},
    {id: "m8", cat: "morning", target: 1, nameAr: "سؤال العفو والعافية", nameEn: "Asking for Well-Being", ar: "اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي دِينِي وَدُنْيَايَ وَأَهْلِي وَمَالِي، اللَّهُمَّ اسْتُرْ عَوْرَاتِي وَآمِنْ رَوْعَاتِي", noteAr: "حفظ الدين والدنيا والأهل والمال", noteEn: "Pardon and well-being in faith, family, and wealth"},
    {id: "m9", cat: "morning", target: 1, nameAr: "يا حي يا قيوم برحمتك أستغيث", nameEn: "Seeking Allah's Mercy", ar: "يَا حَيُّ يَا قَيُّومُ بِرَحْمَتِكَ أَسْتَغِيثُ، أَصْلِحْ لِي شَأْنِي كُلَّهُ، وَلَا تَكِلْنِي إِلَىٰ نَفْسِي طَرْفَةَ عَيْنٍ", noteAr: "إصلاح الشأن كله بعون الله", noteEn: "O Ever-Living, O Sustainer, rectify all my affairs"},
    {id: "m10", cat: "morning", target: 7, nameAr: "حسبي الله لا إله إلا هو", nameEn: "Sufficiency in Allah", ar: "حَسْبِيَ اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ", noteAr: "من قالها سبع مرات كفاه الله ما أهمه من أمر الدنيا والآخرة", noteEn: "Allah will suffice him against all worries"},
    {id: "m11", cat: "morning", target: 100, nameAr: "سبحان الله وبحمده", nameEn: "Morning Tasbih", ar: "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ", noteAr: "حطت خطاياه وإن كانت مثل زبد البحر", noteEn: "Sins forgiven even if like foam of the sea"},
    {id: "m12", cat: "morning", target: 10, nameAr: "الصلاة على النبي ﷺ", nameEn: "Salawat on the Prophet ﷺ", ar: "اللَّهُمَّ صَلِّ وَسَلِّمْ وَبَارِكْ عَلَىٰ نَبِيِّنَا مُحَمَّدٍ", noteAr: "من صلى علي حين يصبح وحين يمسي عشراً أدركته شفاعتي", noteEn: "Attains the Prophet's intercession"},

    // Evening Azkar (أذكار المساء)
    {id: "e1", cat: "evening", target: 1, nameAr: "آية الكرسي", nameEn: "Ayat al-Kursi", ar: "﴿اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ وَلَا يَئُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ﴾", noteAr: "من قالها حين يمسي أجير من الجن حتى يصبح", noteEn: "Protection from Jinn until morning"},
    {id: "e2", cat: "evening", target: 3, nameAr: "سورة الإخلاص والمعوذتين", nameEn: "Al-Ikhlas, Al-Falaq & An-Nas", ar: "﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ﴾\n﴿قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ * مِن شَرِّ مَا خَلَقَ * وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ * وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ * وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ﴾\n﴿قُلْ أَعُوذُ بِرَبِّ النَّاسِ * مَلِكِ النَّاسِ * إِلَٰهِ النَّاسِ * مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ * الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ * مِنَ الْجِنَّةِ وَالنَّاسِ﴾", noteAr: "ثلاث مرات حين يمسي تكفيه من كل شيء", noteEn: "Recite 3 times in the evening"},
    {id: "e3", cat: "evening", target: 1, nameAr: "أمسينا وأمسى الملك لله", nameEn: "Evening Declaration", ar: "أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ، لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ، رَبِّ أَسْأَلُكَ خَيْرَ مَا فِي هَٰذِهِ اللَّيْلَةِ وَخَيْرَ مَا بَعْدَهَا، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَٰذِهِ اللَّيْلَةِ وَشَرِّ مَا بَعْدَهَا", noteAr: "سؤال خير هذه الليلة وما بعدها والاستعاذة من شرها", noteEn: "We have reached the evening and the dominion belongs to Allah"},
    {id: "e4", cat: "evening", target: 1, nameAr: "سيد الاستغفار", nameEn: "Sayyid al-Istighfar", ar: "اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَٰهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَىٰ عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ لَكَ بِذَنْبِي فَاغْفِرْ لِي فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ", noteAr: "من قالها موقناً بها حين يمسي فمات من ليلته دخل الجنة", noteEn: "Master supplication for forgiveness"},
    {id: "e5", cat: "evening", target: 1, nameAr: "اللهم بك أمسينا", nameEn: "By You We Enter Evening", ar: "اللَّهُمَّ بِكَ أَمْسَيْنَا، وَبِكَ أَصْبَحْنَا، وَبِكَ نَحْيَا، وَبِكَ نَمُوتُ وَإِلَيْكَ الْمَصِيرُ", noteAr: "تفويض الأمر لله في المساء", noteEn: "O Allah, by You we enter the evening and to You is the return"},
    {id: "e6", cat: "evening", target: 3, nameAr: "أعوذ بكلمات الله التامات", nameEn: "Refuge in Allah's Words", ar: "أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ", noteAr: "من قالها ثلاثاً حين يمسي لم تضره حمة تلك الليلة", noteEn: "Protection from harm throughout the night"},
    {id: "e7", cat: "evening", target: 3, nameAr: "بسم الله الذي لا يضر مع اسمه شيء", nameEn: "Protection from Harm", ar: "بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ", noteAr: "من قالها ثلاثاً لم يضره من الله شيء", noteEn: "Nothing in earth or heaven will harm him"},
    {id: "e8", cat: "evening", target: 3, nameAr: "رضيت بالله رباً", nameEn: "Pleasure with Allah", ar: "رَضِيتُ بِاللَّهِ رَبًّا، وَبِالْإِسْلَامِ دِينًا، وَبِمُحَمَّدٍ ﷺ نَبِيًّا", noteAr: "كان حقاً على الله أن يرضيه يوم القيامة", noteEn: "Allah will be pleased with him"},
    {id: "e9", cat: "evening", target: 7, nameAr: "حسبي الله لا إله إلا هو", nameEn: "Sufficiency in Allah", ar: "حَسْبِيَ اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ", noteAr: "كفاه الله ما أهمه من أمر الدنيا والآخرة", noteEn: "Sufficiency against all concerns"},
    {id: "e10", cat: "evening", target: 100, nameAr: "سبحان الله وبحمده", nameEn: "Evening Tasbih", ar: "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ", noteAr: "مائة مرة حين يمسي", noteEn: "100 times in the evening"},
    {id: "e11", cat: "evening", target: 10, nameAr: "الصلاة على النبي ﷺ", nameEn: "Salawat on the Prophet ﷺ", ar: "اللَّهُمَّ صَلِّ وَسَلِّمْ وَبَارِكْ عَلَىٰ نَبِيِّنَا مُحَمَّدٍ", noteAr: "عشر مرات حين يمسي", noteEn: "10 times in the evening"},

    // After Prayer Azkar (أذكار بعد الصلاة)
    {id: "p1", cat: "prayer", target: 1, nameAr: "الاستغفار والسلام بعد الصلاة", nameEn: "Istighfar & Salam", ar: "أَسْتَغْفِرُ اللَّهَ (ثَلَاثًا)، اللَّهُمَّ أَنْتَ السَّلَامُ وَمِنْكَ السَّلَامُ، تَبَارَكْتَ يَا ذَا الْجَلَالِ وَالْإِكْرَامِ", noteAr: "عقب السلام من الصلاة المفروضة", noteEn: "Immediately after concluding prayer"},
    {id: "p2", cat: "prayer", target: 1, nameAr: "التهليل بعد الصلاة", nameEn: "Post-Prayer Tahlil", ar: "لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ، وَلَا يَنْفَعُ ذَا الْجَدِّ مِنْكَ الْجَدُّ", noteAr: "توحيد الله وتفويض الأمر له دبر كل صلاة", noteEn: "None can withhold what You give, nor give what You withhold"},
    {id: "p3", cat: "prayer", target: 33, nameAr: "سبحان الله", nameEn: "SubhanAllah", ar: "سُبْحَانَ اللَّهِ", noteAr: "ثلاثاً وثلاثين مرة دبر كل صلاة", noteEn: "Glory be to Allah (33x)"},
    {id: "p4", cat: "prayer", target: 33, nameAr: "الحمد لله", nameEn: "Alhamdulillah", ar: "الْحَمْدُ لِلَّهِ", noteAr: "ثلاثاً وثلاثين مرة دبر كل صلاة", noteEn: "Praise be to Allah (33x)"},
    {id: "p5", cat: "prayer", target: 33, nameAr: "الله أكبر", nameEn: "Allahu Akbar", ar: "اللَّهُ أَكْبَرُ", noteAr: "ثلاثاً وثلاثين مرة دبر كل صلاة", noteEn: "Allah is the Greatest (33x)"},
    {id: "p6", cat: "prayer", target: 1, nameAr: "تمام المائة", nameEn: "Completing the 100th", ar: "لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ", noteAr: "غفرت خطاياه وإن كانت مثل زبد البحر", noteEn: "Completes 100 after 33/33/33"},
    {id: "p7", cat: "prayer", target: 1, nameAr: "آية الكرسي دبر كل صلاة", nameEn: "Ayat al-Kursi After Prayer", ar: "﴿اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ وَلَا يَئُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ﴾", noteAr: "من قرأها دبر كل صلاة مكتوبة لم يمنعه من دخول الجنة إلا أن يموت", noteEn: "Reward of Paradise after every obligatory prayer"},
    {id: "p8", cat: "prayer", target: 1, nameAr: "اللهم أعني على ذكرك", nameEn: "Help in Worship", ar: "اللَّهُمَّ أَعِنِّي عَلَىٰ ذِكْرِكَ، وَشُكْرِكَ، وَحُسْنِ عِبَادَتِكَ", noteAr: "وصية النبي ﷺ لمعاذ بن جبل دبر كل صلاة", noteEn: "O Allah, help me remember You and thank You"},

    // Sleep & Waking Azkar (أذكار النوم والاستيقاظ)
    {id: "s1", cat: "sleep", target: 1, nameAr: "باسمك اللهم أموت وأحيا", nameEn: "Before Sleeping", ar: "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا", noteAr: "عند وضع الجنب للنوم", noteEn: "In Your name, O Allah, I die and I live"},
    {id: "s2", cat: "sleep", target: 1, nameAr: "باسمك ربي وضعت جنبي", nameEn: "Lying Down to Sleep", ar: "بِاسْمِكَ رَبِّي وَضَعْتُ جَنْبِي، وَبِكَ أَرْفَعُهُ، فَإِنْ أَمْسَكْتَ نَفْسِي فَارْحَمْهَا، وَإِنْ أَرْسَلْتَهَا فَاحْفَظْهَا بِمَا تَحْفَظُ بِهِ عِبَادَكَ الصَّالِحِينَ", noteAr: "حفظ النفس أثناء النوم", noteEn: "In Your name my Lord I lie down and by You I rise"},
    {id: "s3", cat: "sleep", target: 33, nameAr: "تسبيح النوم", nameEn: "Bedtime Tasbih", ar: "سُبْحَانَ اللَّهِ (33)، وَالْحَمْدُ لِلَّهِ (33)، وَاللَّهُ أَكْبَرُ (34)", noteAr: "وصية النبي ﷺ لفاطمة وعلي رضي الله عنهما عند النوم", noteEn: "33 SubhanAllah, 33 Alhamdulillah, 34 Allahu Akbar"},
    {id: "s4", cat: "sleep", target: 3, nameAr: "اللهم قني عذابك", nameEn: "Protection on Resurrection", ar: "اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ", noteAr: "ثلاث مرات عند وضع يده تحت خده", noteEn: "O Allah, protect me from Your punishment"},
    {id: "s5", cat: "sleep", target: 1, nameAr: "آية الكرسي عند النوم", nameEn: "Ayat al-Kursi at Night", ar: "﴿اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ وَلَا يَئُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ﴾", noteAr: "لا يزال عليك من الله حافظ ولا يقربك شيطان حتى تصبح", noteEn: "Guarded by an angel all night"},
    {id: "s6", cat: "sleep", target: 1, nameAr: "ذكر الاستيقاظ من النوم", nameEn: "Upon Waking Up", ar: "الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ", noteAr: "يقال فور الاستيقاظ من النوم", noteEn: "Praise be to Allah Who gave us life after sleep"},

    // Comprehensive Daily Duas & Azkar (أدعية وأذكار جامعة)
    {id: "g1", cat: "general", target: 100, nameAr: "كلمتان حبيبتان إلى الرحمن", nameEn: "Beloved to Ar-Rahman", ar: "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ، سُبْحَانَ اللَّهِ الْعَظِيمِ", noteAr: "خفيفتان على اللسان ثقيلتان في الميزان", noteEn: "Light on the tongue, heavy on the scales"},
    {id: "g2", cat: "general", target: 100, nameAr: "الحوقلة (كنز من كنوز الجنة)", nameEn: "Treasure of Paradise", ar: "لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ", noteAr: "كنز من كنوز الجنة", noteEn: "A treasure from the treasures of Paradise"},
    {id: "g3", cat: "general", target: 100, nameAr: "الاستغفار الجامع", nameEn: "Comprehensive Istighfar", ar: "أَسْتَغْفِرُ اللَّهَ الْعَظِيمَ الَّذِي لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ وَأَتُوبُ إِلَيْهِ", noteAr: "غفر الله له وإن كان فر من الزحف", noteEn: "I seek forgiveness from Allah the Almighty"},
    {id: "g4", cat: "general", target: 3, nameAr: "دعاء ذي النون (تفريج الكرب)", nameEn: "Dua for Distress", ar: "لَا إِلَٰهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ", noteAr: "ما دعا بها مسلم في شيء قط إلا استجاب الله له", noteEn: "Answered supplication of Prophet Yunus"},
    {id: "g5", cat: "general", target: 1, nameAr: "دعاء الهم والحزن والدَّين", nameEn: "Relief from Anxiety & Debt", ar: "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ، وَالْعَجْزِ وَالْكَسَلِ، وَالْبُخْلِ وَالْجُبْنِ، وَضَلَعِ الدَّيْنِ، وَغَلَبَةِ الرِّجَالِ", noteAr: "لإذهاب الهم والحزن وقضاء الدين", noteEn: "Refuge from worry, grief, helplessness, laziness, and debt"},
    {id: "g6", cat: "general", target: 3, nameAr: "ثبات القلب على الدين", nameEn: "Steadfastness of the Heart", ar: "يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَىٰ دِينِكَ", noteAr: "أكثر دعاء النبي ﷺ لثبات القلب", noteEn: "O Turner of hearts, keep my heart firm upon Your religion"},
    {id: "g7", cat: "general", target: 3, nameAr: "خير الدنيا والآخرة", nameEn: "Good in Both Worlds", ar: "رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ", noteAr: "من أجمع الأدعية القرآنية لخيري الدنيا والآخرة", noteEn: "Our Lord, grant us good in this world and the Hereafter"},
    {id: "g8", cat: "general", target: 3, nameAr: "سؤال العفو", nameEn: "Asking for Allah's Pardon", ar: "اللَّهُمَّ إِنَّكَ عَفُوٌّ تُحِبُّ الْعَفْوَ فَاعْفُ عَنِّي", noteAr: "سؤال الله العفو والمغفرة", noteEn: "O Allah, You are Pardoning and love pardon, so pardon me"}
  ]

  let morningAzkarList = allAzkar.filter(z => z.cat == "morning")
  let eveningAzkarList = allAzkar.filter(z => z.cat == "evening")
  let isMorningAzkarDone = len(morningAzkarList) > 0 && morningAzkarList.all(z => get(azkarCounts, z.id, 0) >= z.target)
  let isEveningAzkarDone = len(eveningAzkarList) > 0 && eveningAzkarList.all(z => get(azkarCounts, z.id, 0) >= z.target)
  let showMorningBanner = azkarNotif && isMorningAzkarTime && !isMorningAzkarDone
  let showEveningBanner = azkarNotif && isEveningAzkarTime && !isEveningAzkarDone

  let morningNotifItem = (notif.items ?? []).find(i => i.title == tr.morningNotifTitle)
  let eveningNotifItem = (notif.items ?? []).find(i => i.title == tr.eveningNotifTitle)
  let visibleNotifItems = (notif.items ?? []).filter(i => !(isMorningAzkarDone && i.title == tr.morningNotifTitle) && !(isEveningAzkarDone && i.title == tr.eveningNotifTitle))

  // Auto-reset daily Azkar progress at the start of each new day
  when zone != null && todayDayIdx > 0 && azkarResetDay != todayDayIdx {
    azkarCounts = {}
    azkarResetDay = todayDayIdx
  }

  // When it is time for Morning Azkar (and not yet completed), post notification and switch to Morning Azkar tab
  when azkarNotif && todayDayIdx > 0 && isMorningAzkarTime && !isMorningAzkarDone && lastMorningNotifDay != todayDayIdx {
    lastMorningNotifDay = todayDayIdx
    activeTab = "azkar"
    azkarCat = "morning"
    showConfig = false
    showPinModal = false
    notify(tr.morningNotifTitle, tr.morningNotifBody)
  }

  // When it is time for Evening Azkar (and not yet completed), post notification and switch to Evening Azkar tab
  when azkarNotif && todayDayIdx > 0 && isEveningAzkarTime && !isEveningAzkarDone && lastEveningNotifDay != todayDayIdx {
    lastEveningNotifDay = todayDayIdx
    activeTab = "azkar"
    azkarCat = "evening"
    showConfig = false
    showPinModal = false
    notify(tr.eveningNotifTitle, tr.eveningNotifBody)
  }

  // Automatically dismiss Morning / Evening Azkar notification when completed
  when isMorningAzkarDone && morningNotifItem != null {
    notification("dismiss", morningNotifItem.key)
  }

  when isEveningAzkarDone && eveningNotifItem != null {
    notification("dismiss", eveningNotifItem.key)
  }

  let selectedZikr = selectedZikrId != null ? allAzkar.find(z => z.id == selectedZikrId) : null

  let filteredAzkar = trim(azkarQuery) != ""
    ? allAzkar.filter(z => contains(lower(z.ar), lower(trim(azkarQuery))) || contains(lower(z.nameAr), lower(trim(azkarQuery))) || contains(lower(z.nameEn), lower(trim(azkarQuery))) || contains(lower(z.noteAr), lower(trim(azkarQuery))) || contains(lower(z.noteEn), lower(trim(azkarQuery))))
    : allAzkar.filter(z => z.cat == azkarCat)

  let catAzkarList = allAzkar.filter(z => z.cat == (azkarCat == "mesbaha" ? "morning" : azkarCat))
  let catCompletedCount = catAzkarList.count(z => get(azkarCounts, z.id, 0) >= z.target)
  let catTotalCount = len(catAzkarList)

  let tasbihPhrases = [
    {ar: "سُبْحَانَ اللَّهِ", tr: "SubhanAllah · Glory be to Allah"},
    {ar: "الْحَمْدُ لِلَّهِ", tr: "Alhamdulillah · Praise be to Allah"},
    {ar: "اللَّهُ أَكْبَرُ", tr: "Allahu Akbar · Allah is the Greatest"},
    {ar: "لَا إِلَٰهَ إِلَّا اللَّهُ", tr: "La ilaha illa Allah"},
    {ar: "أَسْتَغْفِرُ اللَّهَ", tr: "Astaghfirullah · I seek forgiveness"},
    {ar: "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ", tr: "SubhanAllahi wa bihamdihi"},
    {ar: "لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ", tr: "La hawla wa la quwwata illa billah"},
    {ar: "اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَىٰ نَبِيِّنَا مُحَمَّدٍ", tr: "Allahumma salli 'ala Muhammad"}
  ]
  let curTasbih = tasbihPhrases[clamp(tasbihIdx, 0, len(tasbihPhrases) - 1)]
  let tasbihProgress = tasbihTarget > 0 ? ((tasbihCount % tasbihTarget) / tasbihTarget) : ((tasbihCount % 33) / 33)
  let tasbihRounds = tasbihTarget > 0 ? floor(tasbihCount / tasbihTarget) : floor(tasbihCount / 33)

  // Pinned & Dock Apps logic (supports 6 apps in bottom dock)
  let allApps = apps ?? []
  let pinnedAppObjs = pinnedApps.map(k => allApps.find(a => a.key == k)).filter(a => a != null)
  let unpinnedTopApps = allApps.filter(a => (!a.system || a.score > 0) && !contains(pinnedApps, a.key)).sortBy(a => -a.score)
  let dockApps = len(pinnedAppObjs) >= 6
    ? pinnedAppObjs.take(6)
    : flatten([pinnedAppObjs, unpinnedTopApps.take(6 - len(pinnedAppObjs))])
  let filteredPickerApps = appSearchQuery == "" ? allApps.take(24) : rank(allApps, appSearchQuery).take(24)

  // Responsive layout & keyboard detection (screenInset > 100 means soft keyboard is open)
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let short = (tileHeight ?? 900) < 600
  let kbOpen = (screenInset ?? 0) > 100
  let glass = linear(0, 0, 1, 1, [alpha(background, 0.65), alpha(background, 0.45)])

  background: linear(0, 0, 0, 1, [alpha(background, 0.88), alpha(background, 0.42), alpha(background, 0.48), alpha(background, 0.92)])
  padding: 0

  // Reusable UI components
  component StatusPill(label, tint = foreground) {
    Text {
      text: label
      style: small
      color: tint
      maxLines: 1
      padding: [10, 5]
      frost: 20
      background: alpha(surface, 0.5)
      radius: 12 * corners
    }
  }

  // Top Header: Clock (NO greeting), RTL-aware Gregorian & Hijri Dates, Status Pills, and Gear Icon
  component ClockHeader() {
    Column {
      gap: 4
      Row {
        align: center
        gap: 8
        Text {
          spans: use24h
            ? [clockHourStr, {text: ":", color: accent}, clockMinStr]
            : [clockHourStr, {text: ":", color: accent}, clockMinStr, {text: " ${clockAmPm}", fontSize: 22, fontWeight: 500, color: accent}]
          fontSize: short ? 52 : 66
          fontWeight: 200
          letterSpacing: -2
          weight: 1
          maxLines: 1
        }
        Column {
          gap: 6
          align: end
          Text {
            text: showConfig ? "⚙ ${tr.closeSettings}" : "⚙ ${tr.settingsBtn}"
            style: small
            bold: true
            color: showConfig ? background : foreground
            padding: [12, 7]
            frost: 24
            background: showConfig ? accent : alpha(surface, 0.6)
            border: 1
            borderColor: showConfig ? accent : alpha(accent, 0.45)
            radius: 14 * corners
            maxLines: 1
            onTap: {
              haptic()
              showPinModal = false
              showConfig = !showConfig
            }
          }
          Row {
            gap: 6
            align: center
            StatusPill {
              label: bat.charging ? "⚡ ${bat.level}%" : "${bat.level}%"
              tint: bat.level < 20 && !bat.charging ? red : bat.charging ? green : foreground
            }
            if alarm.set {
              Text {
                text: "⏰ ${use24h ? fmtTime(alarm.time, "HH:mm") : fmtTime(alarm.time, "hh:mm a", null, lang)}"
                style: small
                color: accent
                maxLines: 1
                padding: [10, 5]
                frost: 20
                background: alpha(surface, 0.5)
                radius: 12 * corners
                onTap: androidApp(alarm.app)
              }
            }
          }
        }
      }

      // Gregorian & Hijri Date Row (Bidi-prefixed for accurate RTL rendering)
      Row {
        gap: 8
        align: center
        Text {
          text: gregFormatted
          style: body
          bold: true
          color: foreground
          maxLines: 1
        }
        if showHijri && hijriFormatted != "" {
          Text {
            text: "·"
            color: accent
            bold: true
          }
          Text {
            text: hijriFormatted
            style: small
            bold: true
            color: accent
            maxLines: 1
          }
        }
      }
    }
  }

  // Compact Weather Bar (follows 12h / 24h format setting)
  component WeatherCard() {
    if showWeather && curWx != null {
      Column {
        gap: 6
        padding: [14, 10]
        frost: 24
        background: glass
        radius: 16 * corners
        onTap: url("https://www.yr.no/en/forecast/daily-table/${lat},${lon}")
        Row {
          gap: 8
          align: center
          Text {
            text: weatherIcon(curWx.weatherCode, night)
            font: icon
            fontSize: 28
            color: sky
            width: 32
            align: center
          }
          Text {
            text: "${curWx.temp_C}°"
            fontSize: 24
            bold: true
            maxLines: 1
          }
          Column {
            gap: 0
            weight: 1
            Text {
              text: lower(trim(curWx.weatherDesc[0].value))
              style: small
              bold: true
              maxLines: 1
            }
            Text {
              text: placeName
              fontSize: 10
              color: muted
              maxLines: 1
            }
            Text {
              text: "↑${dayWx.maxtempC}° ↓${dayWx.mintempC}°"
              fontSize: 10
              color: muted
              maxLines: 1
            }
          }
          for s in wxSteps key s.hr {
            Column {
              gap: 1
              width: 42
              align: center
              Text {
                text: s.timeLabel
                fontSize: 9
                color: muted
                align: center
                maxLines: 1
              }
              Text {
                text: weatherIcon(s.code, sun[0] != null && (s.hr % 24 * 60 < sun[0] || s.hr % 24 * 60 >= sun[1]))
                font: icon
                fontSize: 14
                align: center
              }
              Text {
                text: "${s.t}°"
                fontSize: 10
                align: center
              }
            }
          }
        }
      }
    }
  }

  // Multi-Tab Islamic Hub (Prayers | Prayer Tracker | Verse | Hadith)
  component IslamicHub() {
    Column {
      gap: 8
      padding: [14, 10]
      frost: 24
      background: glass
      radius: 20 * corners
      weight: 1
      fill: width

      // 5-Tab Selector Strip (Prayers | Tracker | Azkar | Verse | Hadith)
      Row {
        gap: 4
        fill: width
        padding: 4
        background: alpha(surface, 0.5)
        radius: 14 * corners

        for t in [
          {id: "prayers", icon: "🕌", label: tr.tabPrayers},
          {id: "tracker", icon: "☑", label: tr.tabTracker},
          {id: "azkar", icon: "📿", label: tr.tabAzkar},
          {id: "verse", icon: "📖", label: tr.tabVerse},
          {id: "hadith", icon: "📜", label: tr.tabHadith}
        ] key t.id {
          Text {
            text: "${t.icon} ${t.label}"
            fontSize: 11
            bold: activeTab == t.id
            color: activeTab == t.id ? background : foreground
            align: center
            maxLines: 1
            weight: 1
            padding: [3, 7]
            background: activeTab == t.id ? accent : alpha(background, 0)
            radius: 10 * corners
            onTap: {
              haptic()
              activeTab = t.id
              selectedZikrId = null
            }
          }
        }
      }

      // Interactive Morning / Evening Azkar Time Notification Banner (auto-hides once completed or when keyboard is open)
      if !kbOpen && (showMorningBanner || showEveningBanner) && (activeTab != "azkar" || azkarCat != (showMorningBanner ? "morning" : "evening")) {
        Row {
          gap: 8
          align: center
          padding: [10, 7]
          background: alpha(accent, 0.2)
          border: 1
          borderColor: accent
          radius: 12 * corners
          onTap: {
            haptic()
            activeTab = "azkar"
            azkarCat = showMorningBanner ? "morning" : "evening"
            selectedZikrId = null
          }
          Column {
            gap: 0
            weight: 1
            Text {
              text: showMorningBanner ? tr.morningNotifTitle : tr.eveningNotifTitle
              fontSize: 12
              bold: true
              color: accent
              maxLines: 1
            }
            Text {
              text: showMorningBanner ? tr.morningNotifBody : tr.eveningNotifBody
              fontSize: 10
              color: foreground
              maxLines: 1
            }
          }
          Text {
            text: "📿 ${tr.tabAzkar}"
            fontSize: 11
            bold: true
            color: background
            padding: [10, 5]
            background: accent
            radius: 8 * corners
            maxLines: 1
          }
        }
      }

      // TAB 1: TODAY'S PRAYERS (Prayer Tracker removed from here; lives in Tracker tab)
      if activeTab == "prayers" {
        Column {
          gap: 8
          weight: 1
          scroll: true

          // Location & Quick Method Header
          Row {
            gap: 6
            align: center
            Column {
              gap: 0
              weight: 1
              Text {
                text: notFound ? "⚠ ${city}" : "📍 ${placeName}${len(countryName) > 0 && city == "auto" ? ", " + countryName : ""}"
                style: small
                bold: true
                color: notFound ? red : accent
                maxLines: 1
              }
              Text {
                text: "${methodDisplay} · ${schoolDisplay}${tuneMin != 0 ? " · " + (tuneMin > 0 ? "+" : "") + tuneMin + tr.minUnit : ""}"
                fontSize: 10
                color: muted
                maxLines: 1
              }
            }
            Text {
              text: show7Day ? "📅 ${tr.todaySchedule}" : "📅 ${tr.weekSchedule}"
              fontSize: 11
              bold: show7Day
              color: show7Day ? background : foreground
              padding: [10, 5]
              background: show7Day ? accent : alpha(surface, 0.6)
              border: 1
              borderColor: show7Day ? accent : alpha(muted, 0.4)
              radius: 8 * corners
              maxLines: 1
              onTap: {
                haptic()
                show7Day = !show7Day
              }
            }
            Text {
              text: "⚙ ${tr.prayerTab}"
              fontSize: 11
              bold: true
              color: accent
              padding: [10, 5]
              background: alpha(accent, 0.18)
              border: 1
              borderColor: alpha(accent, 0.5)
              radius: 8 * corners
              maxLines: 1
              onTap: {
                haptic()
                cfgTab = "prayer"
                showConfig = true
              }
            }
          }

          // Next Prayer Hero Countdown Banner
          Row {
            gap: 12
            align: center
            padding: [12, 9]
            background: alpha(accent, 0.14)
            border: 1
            borderColor: alpha(accent, 0.4)
            radius: 14 * corners

            Box {
              size: 52
              align: center
              Ring {
                fill: true
                thickness: 5
                value: minLeft == null ? 0 : clamp(1 - (minLeft / 360), 0.08, 1)
                color: prayerSoon ? red : accent
                track: alpha(muted, 0.25)
              }
              Text {
                text: rawTimings == null ? "—" : nextPrayerObj.ar
                fontSize: 11
                bold: true
                color: accent
                align: center
              }
            }

            Column {
              gap: 1
              weight: 1
              Text {
                text: tr.nextPrayer
                fontSize: 10
                color: muted
                maxLines: 1
              }
              Row {
                gap: 6
                align: center
                Text {
                  text: rawTimings == null ? "offline" : upper(nextPrayerObj.name)
                  fontSize: 17
                  bold: true
                  color: foreground
                  maxLines: 1
                }
                if isTomorrow {
                  Text {
                    text: "(${tr.tmrw})"
                    fontSize: 11
                    color: muted
                    maxLines: 1
                  }
                }
              }
              Text {
                text: "${isRtl ? rlm : ""}${nextPrayerObj.disp}"
                style: small
                bold: true
                color: accent
                maxLines: 1
              }
            }

            Column {
              gap: 1
              align: end
              Text {
                text: countdownStr
                fontSize: 17
                bold: true
                color: prayerSoon ? red : accent
                align: end
                maxLines: 1
              }
              Text {
                text: prayerSoon ? tr.prayerNow : tr.remaining
                fontSize: 11
                color: prayerSoon ? red : muted
                align: end
                maxLines: 1
              }
            }
          }

          // Horizon Day Strip
          Canvas {
            height: 8
            fill: width
            rect(0, 0, width, height, radius: 4, fill: alpha(muted, 0.2))
            if rawTimings != null {
              let xF = clamp((fMin / 1440) * width, 0, width)
              let xS = clamp((sMin / 1440) * width, 0, width)
              let xD = clamp((dMin / 1440) * width, 0, width)
              let xA = clamp((aMin / 1440) * width, 0, width)
              let xM = clamp((mgMin / 1440) * width, 0, width)
              let xI = clamp((iMin / 1440) * width, 0, width)
              rect(xF, 0, max(xS - xF, 2), height, fill: alpha(cyan, 0.7))
              rect(xS, 0, max(xD - xS, 2), height, fill: alpha(surface, 0.45))
              rect(xD, 0, max(xA - xD, 2), height, fill: alpha(yellow, 0.7))
              rect(xA, 0, max(xM - xA, 2), height, fill: alpha(orange, 0.7))
              rect(xM, 0, max(xI - xM, 2), height, fill: alpha(red, 0.7))
              rect(xI, 0, max(width - xI, 2), height, fill: alpha(blue, 0.7))
              let curX = clamp((curMin / 1440) * width, 0, width)
              circle(curX, height / 2, 4, fill: accent)
            }
          }

          if !show7Day {
            // 6 Prayer Cards Grid (Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha)
            Grid {
              columns: 3
              gap: 6
              fill: width
              for p in prayersList key p.id {
                Column {
                  gap: 2
                  align: center
                  padding: [8, 7]
                  background: p.isCurrent ? alpha(accent, 0.22) : p.isNext ? alpha(accent, 0.1) : alpha(surface, 0.45)
                  border: 1
                  borderColor: p.isCurrent ? accent : p.isNext ? alpha(accent, 0.45) : alpha(border, 0.25)
                  radius: 10 * corners
                  Text {
                    text: lang == "ar" ? p.ar : "${p.name} · ${p.ar}"
                    fontSize: 11
                    bold: p.isCurrent || p.isNext
                    color: p.isCurrent ? accent : p.isPast ? muted : foreground
                    align: center
                    maxLines: 1
                  }
                  Text {
                    text: "${isRtl ? rlm : ""}${p.disp}"
                    fontSize: 13
                    bold: true
                    color: p.isCurrent ? accent : p.isPast ? muted : foreground
                    align: center
                    maxLines: 1
                  }
                }
              }
            }

            // Sunnah & Night Times Row (Imsak, Midnight, Last Third / Tahajjud)
            Text {
              text: tr.sunnahTimes
              fontSize: 10
              bold: true
              color: muted
            }
            Row {
              gap: 6
              fill: width
              for s in sunnahList key s.id {
                Column {
                  weight: 1
                  gap: 1
                  align: center
                  padding: [6, 6]
                  background: alpha(surface, 0.35)
                  border: 1
                  borderColor: alpha(border, 0.2)
                  radius: 8 * corners
                  Text {
                    text: lang == "ar" ? s.ar : "${s.name} · ${s.ar}"
                    fontSize: 10
                    color: muted
                    align: center
                    maxLines: 1
                  }
                  Text {
                    text: "${isRtl ? rlm : ""}${s.disp}"
                    fontSize: 12
                    bold: true
                    color: foreground
                    align: center
                    maxLines: 1
                  }
                }
              }
            }
          } else {
            // 7-Day Upcoming Schedule Table
            Column {
              gap: 4
              Row {
                gap: 4
                padding: [6, 4]
                Text { text: tr.dayCol; fontSize: 10; bold: true; color: muted; width: 48 }
                Text { text: tr.fajr; fontSize: 10; bold: true; color: muted; weight: 1; align: center }
                Text { text: tr.dhuhr; fontSize: 10; bold: true; color: muted; weight: 1; align: center }
                Text { text: tr.asr; fontSize: 10; bold: true; color: muted; weight: 1; align: center }
                Text { text: tr.maghrib; fontSize: 10; bold: true; color: muted; weight: 1; align: center }
                Text { text: tr.isha; fontSize: 10; bold: true; color: muted; weight: 1; align: center }
              }
              for d, idx in weekDays key d.date.gregorian.date {
                Row {
                  gap: 4
                  padding: [6, 5]
                  background: idx == 0 ? alpha(accent, 0.15) : alpha(surface, 0.35)
                  radius: 6 * corners
                  Text {
                    text: "${d.date.gregorian.day}/${d.date.gregorian.month.number}"
                    fontSize: 11
                    bold: idx == 0
                    color: idx == 0 ? accent : foreground
                    width: 48
                    maxLines: 1
                  }
                  for rawT in [d.timings.Fajr, d.timings.Dhuhr, d.timings.Asr, d.timings.Maghrib, d.timings.Isha] {
                    let t24 = sub(rawT, 0, 5)
                    let th = floor(num(sub(t24, 0, 2)))
                    let tm = sub(t24, 3, 5)
                    let th12 = th % 12 == 0 ? 12 : th % 12
                    Text {
                      text: use24h ? t24 : "${th12}:${tm}"
                      fontSize: 11
                      weight: 1
                      align: center
                      color: idx == 0 ? accent : foreground
                    }
                  }
                }
              }
            }
          }
        }
      }

      // TAB 2: PRAYER TRACKER (Habit Tracker for 5 Daily Prayers)
      if activeTab == "tracker" {
        Column {
          gap: 8
          weight: 1
          scroll: true

          // Tracker Summary Row
          Row {
            gap: 8
            align: center
            Column {
              gap: 2
              weight: 1
              Text {
                text: tr.trackerTitle
                style: body
                bold: true
                color: foreground
                maxLines: 1
              }
              Text {
                text: tr.tapHint
                fontSize: 11
                color: muted
                maxLines: 1
              }
            }
            StatusPill {
              label: "${activeDayCount}/5 (${round(activeDayCount / 5 * 100)}%)"
              tint: activeDayCount == 5 ? green : accent
            }
          }

          Progress {
            value: activeDayCount * 20
            color: activeDayCount == 5 ? green : accent
            track: alpha(muted, 0.25)
          }

          // 5 Interactive Prayer Habit Buttons for Selected Day
          Row {
            gap: 6
            fill: width
            for p in fardPrayers key p.id {
              let isDone = get(activeDayRecord, p.id, false) == true
              Column {
                weight: 1
                gap: 4
                align: center
                padding: [6, 8]
                background: isDone ? alpha(green, 0.22) : alpha(surface, 0.5)
                border: 1
                borderColor: isDone ? green : alpha(border, 0.4)
                radius: 10 * corners
                onTap: {
                  haptic()
                  let curRec = get(prayerLog, activeTrackKey, {})
                  let nextRec = set(curRec, p.id, !get(curRec, p.id, false))
                  prayerLog = set(prayerLog, activeTrackKey, nextRec)
                }
                Text {
                  text: isDone ? "✓" : "○"
                  fontSize: 16
                  bold: true
                  color: isDone ? green : muted
                  align: center
                }
                Text {
                  text: p.name
                  fontSize: 11
                  bold: isDone
                  color: isDone ? green : foreground
                  align: center
                  maxLines: 1
                }
                Text {
                  text: p.shortDisp
                  fontSize: 9
                  color: muted
                  align: center
                  maxLines: 1
                }
              }
            }
          }

          // Quick Actions & Weekly Stats Row
          Row {
            gap: 6
            align: center
            Text {
              text: "✓ ${tr.markAll}"
              fontSize: 11
              bold: true
              color: green
              padding: [10, 5]
              background: alpha(green, 0.18)
              border: 1
              borderColor: alpha(green, 0.45)
              radius: 8 * corners
              maxLines: 1
              onTap: {
                haptic()
                prayerLog = set(prayerLog, activeTrackKey, {fajr: true, dhuhr: true, asr: true, maghrib: true, isha: true})
              }
            }
            Text {
              text: "↺ ${tr.resetDay}"
              fontSize: 11
              color: muted
              padding: [10, 5]
              background: alpha(surface, 0.55)
              border: 1
              borderColor: alpha(muted, 0.35)
              radius: 8 * corners
              maxLines: 1
              onTap: {
                haptic()
                prayerLog = set(prayerLog, activeTrackKey, {fajr: false, dhuhr: false, asr: false, maghrib: false, isha: false})
              }
            }
            Text {
              text: "${tr.weekScore}: ${weekRatePct}% · ${tr.fullDays}: ${weekFullDays}/7"
              fontSize: 11
              bold: true
              color: accent
              weight: 1
              align: end
              maxLines: 1
            }
          }

          // 7-Day Habit Matrix (Tap any day column to select or toggle)
          Column {
            gap: 4
            padding: [8, 6]
            background: alpha(surface, 0.35)
            radius: 12 * corners
            Text {
              text: tr.weeklyTitle
              fontSize: 10
              bold: true
              color: accent
              maxLines: 1
            }
            Row {
              gap: 4
              fill: width
              for d in last7Days key d.key {
                Column {
                  weight: 1
                  gap: 3
                  align: center
                  padding: [4, 6]
                  background: d.isSelected ? alpha(accent, 0.2) : alpha(background, 0.25)
                  border: 1
                  borderColor: d.isSelected ? accent : alpha(border, 0.2)
                  radius: 8 * corners
                  onTap: {
                    haptic()
                    selectedTrackDay = d.idx
                  }
                  Text {
                    text: d.label
                    fontSize: 9
                    bold: d.isToday
                    color: d.isToday ? accent : muted
                    align: center
                    maxLines: 1
                  }
                  Text {
                    text: d.dayNum
                    fontSize: 12
                    bold: true
                    color: foreground
                    align: center
                  }
                  Text {
                    text: "${d.count}/5"
                    fontSize: 10
                    bold: d.count == 5
                    color: d.count == 5 ? green : d.count > 0 ? accent : muted
                    align: center
                  }
                }
              }
            }
          }
        }
      }

      // TAB 3: AZKAR & ELECTRONIC MESBAHA (Comprehensive Azkar with Search, Counters & Mesbaha)
      if activeTab == "azkar" {
        Column {
          gap: 7
          weight: 1

          // Category & Mesbaha Selector Row
          Grid {
            columns: 6
            gap: 4
            fill: width
            for c in [
              {id: "morning", icon: "🌅", label: tr.azkMorning},
              {id: "evening", icon: "🌇", label: tr.azkEvening},
              {id: "prayer", icon: "🕌", label: tr.azkPrayer},
              {id: "sleep", icon: "🌙", label: tr.azkSleep},
              {id: "general", icon: "🤲", label: tr.azkGeneral},
              {id: "mesbaha", icon: "📿", label: tr.azkMesbaha}
            ] key c.id {
              let isSel = azkarCat == c.id
              Column {
                gap: 1
                align: center
                padding: [3, 5]
                background: isSel ? accent : alpha(surface, 0.5)
                border: 1
                borderColor: isSel ? accent : alpha(border, 0.3)
                radius: 8 * corners
                onTap: {
                  haptic()
                  azkarCat = c.id
                  azkarQuery = ""
                  selectedZikrId = null
                }
                Text {
                  text: c.icon
                  fontSize: 12
                  align: center
                }
                Text {
                  text: c.label
                  fontSize: 9
                  bold: isSel
                  color: isSel ? background : foreground
                  align: center
                  maxLines: 1
                }
              }
            }
          }

          if selectedZikr != null {
            // EXPANDED ZIKR VIEW (Opened by long-pressing a Zikr card or tapping ⤢)
            let selCount = get(azkarCounts, selectedZikr.id, 0)
            let selDone = selCount >= selectedZikr.target
            Column {
              gap: 8
              weight: 1
              padding: [12, 10]
              background: selDone ? alpha(green, 0.14) : alpha(surface, 0.48)
              border: 1
              borderColor: selDone ? green : alpha(accent, 0.5)
              radius: 14 * corners

              // Header Row: Zikr Title + Progress Pill + Close Button
              Row {
                gap: 6
                align: center
                Text {
                  text: isRtl ? selectedZikr.nameAr : selectedZikr.nameEn
                  fontSize: 14
                  bold: true
                  color: selDone ? green : accent
                  weight: 1
                  maxLines: 1
                }
                StatusPill {
                  label: "${isRtl ? rlm : ""}${selDone ? "✓ " : ""}${selCount}/${selectedZikr.target}"
                  tint: selDone ? green : accent
                }
                Text {
                  text: "✕ ${tr.closeBtn}"
                  fontSize: 11
                  bold: true
                  color: background
                  padding: [10, 5]
                  background: accent
                  radius: 8 * corners
                  maxLines: 1
                  onTap: {
                    haptic()
                    selectedZikrId = null
                  }
                }
              }

              // Scrollable Full Zikr Text & Virtue / Reference
              Column {
                gap: 8
                weight: 1
                scroll: true
                padding: [10, 8]
                background: alpha(background, 0.35)
                radius: 10 * corners

                Text {
                  text: "${rlm}${selectedZikr.ar}"
                  fontSize: 19
                  align: end
                  color: foreground
                }
                Text {
                  text: isRtl ? selectedZikr.noteAr : selectedZikr.noteEn
                  fontSize: 12
                  color: accent
                  align: isRtl ? "end" : "start"
                }
              }

              // Interactive Counter Controls (-1 | Tap Ring Counter | +1)
              Row {
                gap: 10
                align: center
                justify: center

                Text {
                  text: "−1"
                  fontSize: 14
                  bold: true
                  color: selCount > 0 ? foreground : muted
                  padding: [14, 8]
                  background: alpha(surface, 0.65)
                  border: 1
                  borderColor: alpha(border, 0.4)
                  radius: 10 * corners
                  onTap: {
                    if selCount > 0 {
                      haptic()
                      azkarCounts = set(azkarCounts, selectedZikr.id, selCount - 1)
                    }
                  }
                }

                Row {
                  gap: 10
                  align: center
                  justify: center
                  weight: 1
                  padding: [10, 6]
                  background: selDone ? alpha(green, 0.22) : alpha(accent, 0.18)
                  border: 1
                  borderColor: selDone ? green : accent
                  radius: 12 * corners
                  onTap: {
                    haptic()
                    if selCount < selectedZikr.target {
                      azkarCounts = set(azkarCounts, selectedZikr.id, selCount + 1)
                    }
                  }
                  Box {
                    size: 40
                    align: center
                    Ring {
                      fill: true
                      thickness: 4
                      value: clamp(selCount / max(selectedZikr.target, 1), 0.05, 1)
                      color: selDone ? green : accent
                      track: alpha(muted, 0.25)
                    }
                    Text {
                      text: selDone ? "✓" : "${selCount}"
                      fontSize: 12
                      bold: true
                      color: selDone ? green : accent
                      align: center
                    }
                  }
                  Column {
                    gap: 0
                    Text {
                      text: "${isRtl ? rlm : ""}${selCount} / ${selectedZikr.target}"
                      fontSize: 16
                      bold: true
                      color: selDone ? green : foreground
                      maxLines: 1
                    }
                    Text {
                      text: tr.mesbahaTap
                      fontSize: 9
                      color: muted
                      maxLines: 1
                    }
                  }
                }

                Text {
                  text: "+1"
                  fontSize: 14
                  bold: true
                  color: background
                  padding: [14, 8]
                  background: selDone ? green : accent
                  radius: 10 * corners
                  onTap: {
                    haptic()
                    if selCount < selectedZikr.target {
                      azkarCounts = set(azkarCounts, selectedZikr.id, selCount + 1)
                    }
                  }
                }
              }

              // All Zikr Options Row: Set to Complete Target | Reset | Copy | Share
              Row {
                gap: 6
                align: center
                Text {
                  text: "✓ ${tr.completeZikrBtn} (${selectedZikr.target})"
                  fontSize: 11
                  bold: true
                  color: selDone ? green : background
                  align: center
                  weight: 1
                  padding: [8, 7]
                  background: selDone ? alpha(green, 0.2) : green
                  border: 1
                  borderColor: green
                  radius: 9 * corners
                  maxLines: 1
                  onTap: {
                    haptic()
                    azkarCounts = set(azkarCounts, selectedZikr.id, selectedZikr.target)
                  }
                }
                Text {
                  text: "↺ ${tr.resetDay}"
                  fontSize: 11
                  bold: true
                  color: muted
                  padding: [8, 7]
                  background: alpha(surface, 0.65)
                  border: 1
                  borderColor: alpha(border, 0.4)
                  radius: 9 * corners
                  maxLines: 1
                  onTap: {
                    haptic()
                    azkarCounts = set(azkarCounts, selectedZikr.id, 0)
                  }
                }
                Text {
                  text: "📋 ${tr.copy}"
                  fontSize: 11
                  color: foreground
                  padding: [8, 7]
                  background: alpha(surface, 0.65)
                  border: 1
                  borderColor: alpha(border, 0.4)
                  radius: 9 * corners
                  maxLines: 1
                  onTap: {
                    haptic()
                    copy("${selectedZikr.ar}\n— ${isRtl ? selectedZikr.nameAr : selectedZikr.nameEn} (${isRtl ? selectedZikr.noteAr : selectedZikr.noteEn})")
                  }
                }
                Text {
                  text: "↗ ${tr.share}"
                  fontSize: 11
                  color: foreground
                  padding: [8, 7]
                  background: alpha(surface, 0.65)
                  border: 1
                  borderColor: alpha(border, 0.4)
                  radius: 9 * corners
                  maxLines: 1
                  onTap: {
                    haptic()
                    share("${selectedZikr.ar}\n— ${isRtl ? selectedZikr.nameAr : selectedZikr.nameEn} (${isRtl ? selectedZikr.noteAr : selectedZikr.noteEn})")
                  }
                }
              }
            }
          } else if azkarCat == "mesbaha" {
            // ELECTRONIC MESBAHA / TASBIH COUNTER VIEW
            Column {
              gap: 8
              weight: 1
              scroll: true

              // Selectable Dhikr Phrases Grid
              Grid {
                columns: 2
                gap: 5
                fill: width
                for p, idx in tasbihPhrases key p.ar {
                  let isPicked = tasbihIdx == idx
                  Text {
                    text: p.ar
                    fontSize: 12
                    bold: isPicked
                    color: isPicked ? background : foreground
                    align: center
                    maxLines: 1
                    padding: [6, 6]
                    background: isPicked ? accent : alpha(surface, 0.5)
                    border: 1
                    borderColor: isPicked ? accent : alpha(border, 0.35)
                    radius: 8 * corners
                    onTap: {
                      haptic()
                      tasbihIdx = idx
                    }
                  }
                }
              }

              // Target Selector Row (33 | 99 | 100 | 1000 | ∞) + Reset
              Row {
                gap: 5
                align: center
                Text {
                  text: "${tr.mesbahaTarget}:"
                  fontSize: 10
                  bold: true
                  color: muted
                  maxLines: 1
                }
                for tgt in [33, 99, 100, 1000, 0] key tgt {
                  let isTgt = tasbihTarget == tgt
                  Text {
                    text: tgt == 0 ? "∞" : "${tgt}"
                    fontSize: 11
                    bold: isTgt
                    color: isTgt ? background : foreground
                    align: center
                    weight: 1
                    padding: [4, 5]
                    background: isTgt ? accent : alpha(surface, 0.5)
                    border: 1
                    borderColor: isTgt ? accent : alpha(border, 0.35)
                    radius: 7 * corners
                    onTap: {
                      haptic()
                      tasbihTarget = tgt
                    }
                  }
                }
                Text {
                  text: "↺ ${tr.resetDay}"
                  fontSize: 11
                  bold: true
                  color: red
                  padding: [8, 5]
                  background: alpha(red, 0.15)
                  border: 1
                  borderColor: alpha(red, 0.4)
                  radius: 7 * corners
                  onTap: {
                    haptic()
                    tasbihCount = 0
                  }
                }
              }

              // Interactive Large Tap-to-Count Mesbaha Ring Card
              Column {
                gap: 6
                weight: 1
                fill: width
                align: center
                justify: center
                padding: [12, 12]
                background: alpha(accent, 0.12)
                border: 1
                borderColor: alpha(accent, 0.45)
                radius: 16 * corners
                onTap: {
                  haptic()
                  tasbihCount = tasbihCount + 1
                  tasbihTotal = tasbihTotal + 1
                }

                Text {
                  text: curTasbih.ar
                  fontSize: 20
                  bold: true
                  color: accent
                  align: center
                  maxLines: 1
                }
                Text {
                  text: curTasbih.tr
                  fontSize: 11
                  color: muted
                  align: center
                  maxLines: 1
                }

                Box {
                  size: 112
                  align: center
                  Ring {
                    fill: true
                    thickness: 8
                    value: clamp(tasbihProgress, 0.04, 1)
                    color: accent
                    track: alpha(muted, 0.25)
                  }
                  Column {
                    gap: 0
                    align: center
                    Text {
                      text: "${tasbihCount}"
                      fontSize: 30
                      bold: true
                      color: foreground
                      align: center
                    }
                    Text {
                      text: tasbihTarget > 0 ? "/ ${tasbihTarget}" : "∞"
                      fontSize: 11
                      color: muted
                      align: center
                    }
                  }
                }

                Row {
                  gap: 12
                  align: center
                  StatusPill {
                    label: "${tr.mesbahaRound}: ${tasbihRounds}"
                    tint: accent
                  }
                  Text {
                    text: "📿 ${tr.mesbahaTap}"
                    fontSize: 11
                    bold: true
                    color: accent
                  }
                  StatusPill {
                    label: "${tr.mesbahaTotal}: ${tasbihTotal}"
                    tint: green
                  }
                }
              }
            }
          } else {
            // AZKAR & DUAS LIST WITH SEARCH & INTERACTIVE COUNTERS
            Row {
              gap: 6
              align: center
              Input {
                weight: 1
                text: azkarQuery
                placeholder: tr.azkSearch
                clear: false
                onChange: azkarQuery = value
              }
              if trim(azkarQuery) != "" {
                Text {
                  text: "✕"
                  fontSize: 12
                  bold: true
                  color: muted
                  padding: [8, 6]
                  background: alpha(surface, 0.6)
                  radius: 8 * corners
                  onTap: azkarQuery = ""
                }
              }
              StatusPill {
                label: "✓ ${catCompletedCount}/${catTotalCount}"
                tint: catCompletedCount == catTotalCount && catTotalCount > 0 ? green : accent
              }
              if catCompletedCount < catTotalCount {
                Text {
                  text: "✓"
                  fontSize: 12
                  bold: true
                  color: green
                  padding: [8, 5]
                  background: alpha(green, 0.18)
                  border: 1
                  borderColor: alpha(green, 0.45)
                  radius: 8 * corners
                  onTap: {
                    haptic()
                    azkarCounts = catAzkarList.reduce((acc, z) => set(acc, z.id, z.target), azkarCounts)
                  }
                }
              }
              Text {
                text: "↺"
                fontSize: 13
                bold: true
                color: muted
                padding: [8, 5]
                background: alpha(surface, 0.55)
                border: 1
                borderColor: alpha(border, 0.35)
                radius: 8 * corners
                onTap: {
                  haptic()
                  azkarCounts = {}
                }
              }
            }

            Column {
              gap: 6
              weight: 1
              scroll: true
              for z in filteredAzkar key z.id {
                let cVal = get(azkarCounts, z.id, 0)
                let isDone = cVal >= z.target
                Column {
                  gap: 4
                  padding: [10, 8]
                  background: isDone ? alpha(green, 0.16) : alpha(surface, 0.42)
                  border: 1
                  borderColor: isDone ? green : alpha(border, 0.3)
                  radius: 12 * corners
                  onTap: {
                    haptic()
                    let curC = get(azkarCounts, z.id, 0)
                    if curC < z.target {
                      azkarCounts = set(azkarCounts, z.id, curC + 1)
                    }
                  }
                  onLongPress: {
                    haptic()
                    selectedZikrId = z.id
                  }

                  Row {
                    gap: 5
                    align: center
                    Text {
                      text: isRtl ? z.nameAr : z.nameEn
                      fontSize: 11
                      bold: true
                      color: isDone ? green : accent
                      weight: 1
                      maxLines: 1
                    }
                    Text {
                      text: "⤢"
                      fontSize: 11
                      bold: true
                      color: accent
                      padding: [6, 3]
                      background: alpha(accent, 0.16)
                      radius: 6 * corners
                      onTap: {
                        haptic()
                        selectedZikrId = z.id
                      }
                    }
                    if !isDone {
                      Text {
                        text: "✓"
                        fontSize: 11
                        bold: true
                        color: green
                        padding: [7, 3]
                        background: alpha(green, 0.18)
                        border: 1
                        borderColor: alpha(green, 0.45)
                        radius: 6 * corners
                        onTap: {
                          haptic()
                          azkarCounts = set(azkarCounts, z.id, z.target)
                        }
                      }
                    }
                    Text {
                      text: "📋"
                      fontSize: 11
                      color: muted
                      padding: [6, 3]
                      background: alpha(surface, 0.6)
                      radius: 6 * corners
                      onTap: {
                        haptic()
                        copy("${z.ar}\n— ${isRtl ? z.nameAr : z.nameEn}")
                      }
                    }
                    if cVal > 0 {
                      Text {
                        text: "↺"
                        fontSize: 11
                        color: muted
                        padding: [6, 3]
                        background: alpha(surface, 0.6)
                        radius: 6 * corners
                        onTap: {
                          haptic()
                          azkarCounts = set(azkarCounts, z.id, 0)
                        }
                      }
                    }
                    Text {
                      text: "${isRtl ? rlm : ""}${isDone ? "✓ " : ""}${cVal}/${z.target}"
                      fontSize: 11
                      bold: true
                      color: isDone ? background : accent
                      padding: [8, 3]
                      background: isDone ? green : alpha(accent, 0.2)
                      radius: 8 * corners
                      maxLines: 1
                    }
                  }

                  Text {
                    text: "${rlm}${z.ar}"
                    fontSize: 15
                    align: end
                    color: foreground
                  }

                  Row {
                    gap: 6
                    align: center
                    Text {
                      text: isRtl ? z.noteAr : z.noteEn
                      fontSize: 10
                      color: muted
                      weight: 1
                      maxLines: 1
                    }
                    Text {
                      text: tr.azkTapCount
                      fontSize: 9
                      color: isDone ? green : accent
                      maxLines: 1
                    }
                  }

                  Progress {
                    value: clamp(cVal / max(z.target, 1) * 100, 0, 100)
                    color: isDone ? green : accent
                    track: alpha(muted, 0.2)
                  }
                }
              }
            }
          }
        }
      }

      // TAB 4: VERSE OF TODAY
      if activeTab == "verse" {
        Column {
          gap: 8
          weight: 1

          Row {
            gap: 6
            align: center
            Text {
              text: "📖 ${shownVerse.ref ?? tr.verseTitle}"
              style: small
              bold: true
              color: accent
              weight: 1
              maxLines: 1
            }
            Text {
              text: tr.arabToggle
              fontSize: 11
              bold: showVerseAr
              color: showVerseAr ? accent : muted
              padding: [10, 5]
              background: showVerseAr ? alpha(accent, 0.2) : alpha(surface, 0.5)
              border: 1
              borderColor: showVerseAr ? accent : alpha(muted, 0.4)
              radius: 8 * corners
              onTap: showVerseAr = !showVerseAr
            }
            Text {
              text: tr.nextBtn
              fontSize: 11
              bold: true
              color: foreground
              padding: [10, 5]
              background: alpha(surface, 0.6)
              border: 1
              borderColor: alpha(muted, 0.4)
              radius: 8 * corners
              onTap: {
                haptic()
                verseSeed = verseSeed + 1
              }
            }
          }

          Column {
            gap: 10
            weight: 1
            scroll: true
            padding: [12, 10]
            background: alpha(surface, 0.35)
            radius: 12 * corners

            if showVerseAr && (shownVerse.arabic ?? "") != "" {
              Text {
                text: shownVerse.arabic
                fontSize: len(shownVerse.arabic ?? "") > 160 ? 18 : 22
                align: end
                color: foreground
              }
            }
            Text {
              text: shownVerse == null ? "…" : shownVerse.text
              fontSize: len(shownVerse.text ?? "") > 200 ? 13 : 15
              italic: !isRtl
              align: isRtl ? "end" : "start"
              color: alpha(foreground, 0.92)
            }
          }

          Row {
            gap: 8
            align: center
            Text {
              text: "📋 ${tr.copy}"
              fontSize: 11
              color: foreground
              padding: [10, 6]
              background: alpha(surface, 0.6)
              border: 1
              borderColor: alpha(muted, 0.4)
              radius: 8 * corners
              onTap: {
                if shownVerse != null {
                  copy("${shownVerse.arabic}\n\n${shownVerse.text}\n— ${shownVerse.ref}")
                  haptic()
                }
              }
            }
            Text {
              text: "↗ ${tr.share}"
              fontSize: 11
              color: foreground
              padding: [10, 6]
              background: alpha(surface, 0.6)
              border: 1
              borderColor: alpha(muted, 0.4)
              radius: 8 * corners
              onTap: {
                if shownVerse != null {
                  share("${shownVerse.arabic}\n\n${shownVerse.text}\n— ${shownVerse.ref}")
                }
              }
            }
            Text {
              text: "⚙ ${verseFreqDisplay} · ${verseEditionDisplay}"
              fontSize: 11
              color: accent
              weight: 1
              align: end
              maxLines: 1
              onTap: {
                cfgTab = "content"
                showConfig = true
              }
            }
          }
        }
      }

      // TAB 4: HADITH OF TODAY
      if activeTab == "hadith" {
        Column {
          gap: 8
          weight: 1

          Row {
            gap: 6
            align: center
            Text {
              text: "📜 ${shownHadith.ref ?? tr.hadithTitle}"
              style: small
              bold: true
              color: accent
              weight: 1
              maxLines: 1
            }
            Text {
              text: tr.arabToggle
              fontSize: 11
              bold: showHadithAr
              color: showHadithAr ? accent : muted
              padding: [10, 5]
              background: showHadithAr ? alpha(accent, 0.2) : alpha(surface, 0.5)
              border: 1
              borderColor: showHadithAr ? accent : alpha(muted, 0.4)
              radius: 8 * corners
              onTap: showHadithAr = !showHadithAr
            }
            Text {
              text: tr.nextBtn
              fontSize: 11
              bold: true
              color: foreground
              padding: [10, 5]
              background: alpha(surface, 0.6)
              border: 1
              borderColor: alpha(muted, 0.4)
              radius: 8 * corners
              onTap: {
                haptic()
                hadithSeed = hadithSeed + 1
              }
            }
          }

          Column {
            gap: 10
            weight: 1
            scroll: true
            padding: [12, 10]
            background: alpha(surface, 0.35)
            radius: 12 * corners

            if showHadithAr && cleanHadithAr != "" {
              Text {
                text: "${rlm}${cleanHadithAr}"
                fontSize: len(cleanHadithAr) > 220 ? 16 : 18
                align: end
                color: foreground
              }
            }
            if lang != "ar" || !showHadithAr {
              Text {
                text: shownHadith == null ? "…" : (isRtl ? "${rlm}${cleanHadithText}" : cleanHadithText)
                fontSize: len(cleanHadithText) > 240 ? 13 : 14
                align: isRtl ? "end" : "start"
                color: alpha(foreground, 0.92)
              }
            }
          }

          Row {
            gap: 8
            align: center
            Text {
              text: "📋 ${tr.copy}"
              fontSize: 11
              color: foreground
              padding: [10, 6]
              background: alpha(surface, 0.6)
              border: 1
              borderColor: alpha(muted, 0.4)
              radius: 8 * corners
              onTap: {
                if shownHadith != null {
                  copy("${cleanHadithAr}\n\n${cleanHadithText}\n— ${shownHadith.ref}")
                  haptic()
                }
              }
            }
            Text {
              text: "↗ ${tr.share}"
              fontSize: 11
              color: foreground
              padding: [10, 6]
              background: alpha(surface, 0.6)
              border: 1
              borderColor: alpha(muted, 0.4)
              radius: 8 * corners
              onTap: {
                if shownHadith != null {
                  share("${cleanHadithAr}\n\n${cleanHadithText}\n— ${shownHadith.ref}")
                }
              }
            }
            Text {
              text: "⚙ ${bookDisplayName} · ${hadithFreqDisplay}"
              fontSize: 11
              color: accent
              weight: 1
              align: end
              maxLines: 1
              onTap: {
                cfgTab = "content"
                showConfig = true
              }
            }
          }
        }
      }
    }
  }

  // Bottom Section: Compact 2-Row Scrollable Notifications (hidden when empty) & 6-App Pinnable Dock
  component BottomDock() {
    Column {
      gap: 8

      if playing {
        Column {
          gap: 6
          Row {
            gap: 10
            align: center
            padding: [12, 8]
            frost: 24
            background: glass
            radius: 16 * corners
            onTap: media("open")
            Box {
              size: 34
              radius: 8 * corners
              clip: true
              if m.art != null {
                Image { src: m.art; fit: cover; fill: true }
              } else {
                Text { text: "🎵"; fontSize: 16; align: center; fill: true; background: alpha(surface, 0.6) }
              }
            }
            Column {
              gap: 0
              weight: 1
              Text { text: m.title; style: small; bold: true; maxLines: 1 }
              Text { text: m.artist ?? lower(m.app ?? ""); fontSize: 11; color: muted; maxLines: 1 }
            }
            Text {
              text: "⏮"
              fontSize: 13
              color: foreground
              bold: true
              padding: [10, 5]
              background: alpha(surface, 0.6)
              radius: 10 * corners
              onTap: media("previous")
            }
            Text {
              text: m.playing == true ? "⏸" : "▶"
              fontSize: 12
              color: background
              bold: true
              padding: [10, 5]
              background: accent
              radius: 10 * corners
              onTap: media("toggle")
            }
            Text {
              text: "⏭"
              fontSize: 13
              color: foreground
              bold: true
              padding: [10, 5]
              background: alpha(surface, 0.6)
              radius: 10 * corners
              onTap: media("next")
            }
          }

          // Media volume: appears while music is playing; icon mutes/unmutes
          if m.playing == true {
            Row {
              gap: 10
              align: center
              padding: [12, 8]
              frost: 24
              background: glass
              radius: 16 * corners
              fill: width
              Text {
                text: v != null && v.muted ? "🔇" : "🔊"
                fontSize: 16
                onTap: volume("toggle")
              }
              Slider { value: v != null && !v.muted ? v.level : 0; step: v != null && v.steps ? 100 / v.steps : 5; live: true; weight: 1; onChange: volume(value) }
              Text { text: v != null && v.muted ? "✕" : "${v.level}%"; fontSize: 10; color: muted; width: 30; align: end }
            }
          }
        }
      }

      // Scrollable Notifications Card (2 rows max, hidden when there are no notifications or disabled in Settings)
      if showNotif && notif != null && notif.available && len(visibleNotifItems) > 0 {
        Column {
          gap: 5
          padding: [12, 8]
          frost: 24
          background: glass
          radius: 16 * corners
          fill: width

          Row {
            gap: 6
            align: center
            Text {
              text: "🔔 ${tr.notifTitle}"
              fontSize: 11
              bold: true
              color: accent
              weight: 1
              maxLines: 1
            }
            Text {
              text: "${len(visibleNotifItems)}"
              fontSize: 10
              bold: true
              color: background
              padding: [7, 2]
              background: accent
              radius: 8 * corners
            }
          }

          // Scrollable list sized to display 2 notification rows
          Column {
            scroll: true
            height: len(visibleNotifItems) == 1 ? 44 : 92
            gap: 5
            fill: width
            for item in visibleNotifItems key item.key {
              Row {
                gap: 8
                align: center
                padding: [8, 5]
                background: alpha(surface, 0.45)
                border: 1
                borderColor: alpha(border, 0.25)
                radius: 10 * corners
                onTap: {
                  if item.title == tr.morningNotifTitle {
                    haptic()
                    activeTab = "azkar"
                    azkarCat = "morning"
                    selectedZikrId = null
                    notification("dismiss", item.key)
                  } else if item.title == tr.eveningNotifTitle {
                    haptic()
                    activeTab = "azkar"
                    azkarCat = "evening"
                    selectedZikrId = null
                    notification("dismiss", item.key)
                  } else {
                    notification("open", item.key)
                  }
                }
                onLongPress: { haptic(); notification("dismiss", item.key) }
                Image { src: item.icon; size: 22 }
                Column {
                  gap: 0
                  weight: 1
                  Text { text: item.title; fontSize: 11; bold: true; maxLines: 1 }
                  if item.text != "" {
                    Text { text: item.text; fontSize: 10; color: muted; maxLines: 1 }
                  }
                }
                Text {
                  text: fmtAgo(item.time, now)
                  fontSize: 10
                  color: muted
                  maxLines: 1
                }
              }
            }
          }
        }
      }

      // Pinnable Bottom Apps Dock (Supports 6 apps, with optional app names, pin icons, and zero-gap icon outline border)
      if showApps {
        Row {
          gap: 4
          align: center
          padding: [10, 8]
          frost: 24
          background: glass
          radius: 18 * corners
          for a in dockApps key a.key {
            let isPinned = contains(pinnedApps, a.key)
            Column {
              weight: 1
              gap: 3
              align: center
              onTap: androidApp(a.key)
              onLongPress: {
                haptic()
                if isPinned {
                  pinnedApps = pinnedApps.filter(k => k != a.key)
                } else {
                  pinnedApps = flatten([pinnedApps, [a.key]])
                }
              }
              Box {
                size: 38
                padding: isPinned ? 2 : 0
                background: isPinned ? accent : alpha(background, 0)
                radius: 10 * corners
                clip: true
                align: center
                Box {
                  fill: true
                  radius: 8 * corners
                  clip: true
                  align: center
                  Image {
                    src: a.icon
                    fill: true
                    fit: cover
                    scale: isPinned ? 1.08 : 1
                  }
                }
              }
              if showAppNames {
                Text {
                  text: isPinned && showPinIcon ? "📌 ${lower(a.name)}" : lower(a.name)
                  fontSize: 9
                  bold: isPinned
                  color: isPinned ? accent : foreground
                  align: center
                  maxLines: 1
                }
              }
            }
          }
          if showPinIcon {
            // Pin Apps Manager Button
            Text {
              text: "📌"
              fontSize: 16
              color: showPinModal ? background : accent
              padding: [4, 4]
              background: showPinModal ? accent : alpha(background, 0)
              radius: 10 * corners
              onTap: {
                haptic()
                showConfig = false
                showPinModal = !showPinModal
              }
            }
          }
          // App Drawer Search Button (Bigger, bold, borderless)
          Text {
            text: "⌕"
            fontSize: 28
            bold: true
            fontWeight: 800
            color: accent
            padding: [4, 2]
            onTap: launcher("drawer")
          }
        }
      }
    }
  }

  // PIN APPS PICKER MODAL (Opened by tapping 📌 on the bottom dock)
  component PinAppsModal() {
    Column {
      gap: 10
      padding: [14, 12]
      frost: 28
      background: linear(0, 0, 0, 1, [alpha(background, 0.95), alpha(surface, 0.92)])
      border: 1
      borderColor: alpha(accent, 0.4)
      radius: 20 * corners
      weight: 1
      fill: width

      Row {
        gap: 8
        align: center
        Column {
          gap: 1
          weight: 1
          Text {
            text: "📌 ${tr.pinTitle}"
            style: body
            bold: true
            color: accent
            maxLines: 1
          }
          Text {
            text: tr.pinHint
            fontSize: 11
            color: muted
            maxLines: 1
          }
        }
        Text {
          text: tr.closeSettings
          style: small
          bold: true
          color: background
          padding: [12, 6]
          background: accent
          radius: 10 * corners
          onTap: {
            haptic()
            showPinModal = false
          }
        }
      }

      Input {
        text: appSearchQuery
        placeholder: tr.pinSearch
        clear: false
        onChange: appSearchQuery = value
      }

      Grid {
        columns: 4
        gap: 8
        lazy: true
        weight: 1
        for a in filteredPickerApps key a.key {
          let isPinned = contains(pinnedApps, a.key)
          Column {
            gap: 4
            align: center
            padding: [6, 8]
            background: isPinned ? alpha(accent, 0.22) : alpha(surface, 0.45)
            border: 1
            borderColor: isPinned ? accent : alpha(border, 0.25)
            radius: 12 * corners
            onTap: {
              haptic()
              if isPinned {
                pinnedApps = pinnedApps.filter(k => k != a.key)
              } else {
                pinnedApps = flatten([pinnedApps, [a.key]])
              }
            }
            Image { src: a.icon; size: 38 }
            Text {
              text: isPinned ? "📌 ${a.name}" : a.name
              fontSize: 10
              bold: isPinned
              color: isPinned ? accent : foreground
              align: center
              maxLines: 1
            }
          }
        }
      }
    }
  }

  // FACE CONFIGURATION MODAL (Gear Icon View — All Options Localized)
  component ConfigView() {
    Column {
      gap: 10
      padding: [14, 12]
      frost: 28
      background: linear(0, 0, 0, 1, [alpha(background, 0.95), alpha(surface, 0.92)])
      border: 1
      borderColor: alpha(accent, 0.4)
      radius: 20 * corners
      weight: 1
      fill: width

      // Settings Header & Sub-tabs
      Row {
        gap: 8
        align: center
        Text {
          text: "⚙ ${tr.settings}"
          style: body
          bold: true
          color: accent
          weight: 1
          maxLines: 1
        }
        Text {
          text: tr.closeSettings
          style: small
          bold: true
          color: background
          padding: [12, 6]
          background: accent
          radius: 10 * corners
          onTap: {
            haptic()
            showConfig = false
          }
        }
      }

      // Settings Category Tabs: General | Prayer | Verse & Hadith
      Row {
        gap: 6
        fill: width
        padding: 4
        background: alpha(surface, 0.6)
        radius: 12 * corners
        for c in [
          {id: "general", label: "🌐 ${tr.generalTab}"},
          {id: "prayer", label: "🕌 ${tr.prayerTab}"},
          {id: "content", label: "📖 ${tr.contentTab}"}
        ] key c.id {
          Text {
            text: c.label
            style: small
            bold: cfgTab == c.id
            color: cfgTab == c.id ? background : foreground
            align: center
            maxLines: 1
            weight: 1
            padding: [6, 7]
            background: cfgTab == c.id ? accent : alpha(background, 0)
            radius: 8 * corners
            onTap: {
              haptic()
              cfgTab = c.id
            }
          }
        }
      }

      // Scrollable Settings Body
      Column {
        gap: 10
        weight: 1
        scroll: true

        // 1. GENERAL SETTINGS (Language, 12h/24h, Date Format, Hijri, Sections)
        if cfgTab == "general" {
          Text { text: tr.langLabel; style: label; color: accent }
          Grid {
            columns: 3
            gap: 6
            for l in [
              {code: "en", label: "English"},
              {code: "ar", label: "العربية"},
              {code: "id", label: "Indonesia"},
              {code: "tr", label: "Türkçe"},
              {code: "ur", label: "اردو"},
              {code: "fr", label: "Français"}
            ] key l.code {
              Text {
                text: l.label
                style: small
                bold: lang == l.code
                color: lang == l.code ? background : foreground
                align: center
                maxLines: 1
                padding: [8, 8]
                background: lang == l.code ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: lang == l.code ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: {
                  haptic()
                  lang = l.code
                }
              }
            }
          }

          Text { text: tr.timeFmtLabel; style: label; color: accent }
          Row {
            gap: 6
            fill: width
            Text {
              text: tr.fmt12h
              style: small
              bold: !use24h
              color: !use24h ? background : foreground
              align: center
              weight: 1
              padding: [8, 8]
              background: !use24h ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: !use24h ? accent : alpha(border, 0.5)
              radius: 8 * corners
              onTap: { haptic(); use24h = false }
            }
            Text {
              text: tr.fmt24h
              style: small
              bold: use24h
              color: use24h ? background : foreground
              align: center
              weight: 1
              padding: [8, 8]
              background: use24h ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: use24h ? accent : alpha(border, 0.5)
              radius: 8 * corners
              onTap: { haptic(); use24h = true }
            }
          }

          Text { text: tr.dateFmtLabel; style: label; color: accent }
          Grid {
            columns: 2
            gap: 6
            for df in [
              {id: "DD/MM/YYYY", label: tr.dfDMY},
              {id: "MM/DD/YYYY", label: tr.dfMDY},
              {id: "YYYY-MM-DD", label: tr.dfYMD},
              {id: "DD MMM YYYY", label: tr.dfShort},
              {id: "Full", label: tr.dfFull}
            ] key df.id {
              Text {
                text: df.label
                fontSize: 11
                bold: dateFmt == df.id
                color: dateFmt == df.id ? background : foreground
                align: center
                maxLines: 1
                padding: [8, 8]
                background: dateFmt == df.id ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: dateFmt == df.id ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: { haptic(); dateFmt = df.id }
              }
            }
          }

          Text { text: tr.hijriLabel; style: label; color: accent }
          Row {
            gap: 6
            align: center
            Text {
              text: "${tr.hijriShow}: ${showHijri ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: true
              color: showHijri ? background : foreground
              padding: [10, 7]
              background: showHijri ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showHijri ? accent : alpha(border, 0.5)
              radius: 8 * corners
              onTap: { haptic(); showHijri = !showHijri }
            }
            for adj in [-2, -1, 0, 1, 2] key adj {
              Text {
                text: "${isRtl ? rlm : ""}${adj > 0 ? "+${adj}${tr.dayUnit}" : "${adj}${tr.dayUnit}"}"
                fontSize: 11
                bold: hijriAdj == adj
                color: hijriAdj == adj ? background : foreground
                align: center
                weight: 1
                padding: [6, 7]
                background: hijriAdj == adj ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: hijriAdj == adj ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: { haptic(); hijriAdj = adj; refresh() }
              }
            }
          }

          Text { text: tr.dashWidgets; style: label; color: accent }
          Grid {
            columns: 2
            gap: 6
            Text {
              text: "${tr.weatherToggle}: ${showWeather ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: showWeather
              color: showWeather ? background : foreground
              align: center
              padding: [8, 8]
              background: showWeather ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showWeather ? accent : alpha(border, 0.5)
              radius: 8 * corners
              maxLines: 1
              onTap: { haptic(); showWeather = !showWeather }
            }
            Text {
              text: "${tr.notifToggle}: ${showNotif ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: showNotif
              color: showNotif ? background : foreground
              align: center
              padding: [8, 8]
              background: showNotif ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showNotif ? accent : alpha(border, 0.5)
              radius: 8 * corners
              maxLines: 1
              onTap: { haptic(); showNotif = !showNotif }
            }
            Text {
              text: "${tr.appsToggle}: ${showApps ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: showApps
              color: showApps ? background : foreground
              align: center
              padding: [8, 8]
              background: showApps ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showApps ? accent : alpha(border, 0.5)
              radius: 8 * corners
              maxLines: 1
              onTap: { haptic(); showApps = !showApps }
            }
            Text {
              text: "${tr.pinIconToggle}: ${showPinIcon ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: showPinIcon
              color: showPinIcon ? background : foreground
              align: center
              padding: [8, 8]
              background: showPinIcon ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showPinIcon ? accent : alpha(border, 0.5)
              radius: 8 * corners
              maxLines: 1
              onTap: { haptic(); showPinIcon = !showPinIcon }
            }
            Text {
              text: "${tr.appNamesToggle}: ${showAppNames ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: showAppNames
              color: showAppNames ? background : foreground
              align: center
              padding: [8, 8]
              background: showAppNames ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showAppNames ? accent : alpha(border, 0.5)
              radius: 8 * corners
              maxLines: 1
              onTap: { haptic(); showAppNames = !showAppNames }
            }
            Text {
              text: "${tr.azkarNotifToggle}: ${azkarNotif ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: azkarNotif
              color: azkarNotif ? background : foreground
              align: center
              padding: [8, 8]
              background: azkarNotif ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: azkarNotif ? accent : alpha(border, 0.5)
              radius: 8 * corners
              maxLines: 1
              onTap: { haptic(); azkarNotif = !azkarNotif }
            }
          }
          Text {
            text: "📌 ${tr.pinTitle}"
            fontSize: 11
            bold: true
            color: accent
            align: center
            fill: width
            padding: [8, 8]
            background: alpha(accent, 0.16)
            border: 1
            borderColor: alpha(accent, 0.45)
            radius: 8 * corners
            maxLines: 1
            onTap: {
              haptic()
              showConfig = false
              showPinModal = true
            }
          }
        }

        // 2. PRAYER SETTINGS (City, Calculation Method, Madhab, Ihtiyat — All Localized)
        if cfgTab == "prayer" {
          Text { text: tr.locLabel; style: label; color: accent }
          Row {
            gap: 6
            align: center
            Input {
              text: typedCity
              weight: 1
              placeholder: tr.searchPlaceholder
              clear: false
              onChange: {
                typedCity = value
                cityQuery = value
              }
              onSubmit: {
                if len(trim(value)) > 0 {
                  cityQuery = trim(value)
                }
              }
            }
            Text {
              text: tr.searchBtn
              style: small
              bold: true
              color: background
              padding: [12, 8]
              background: accent
              radius: 8 * corners
              onTap: {
                if len(trim(typedCity)) > 0 {
                  cityQuery = trim(typedCity)
                }
              }
            }
          }

          if len(searchResults) > 0 {
            Column {
              gap: 4
              fill: width
              for r in searchResults key "${r.latitude},${r.longitude}" {
                let subLoc = join([r.admin1 ?? "", r.country ?? ""].filter(s => s != ""), ", ")
                let cEntry = {label: r.name, val: r.name, lat: r.latitude, lon: r.longitude, country: r.country ?? ""}
                Row {
                  gap: 6
                  align: center
                  padding: [10, 7]
                  background: alpha(surface, 0.75)
                  border: 1
                  borderColor: alpha(accent, 0.45)
                  radius: 8 * corners
                  onTap: {
                    haptic()
                    city = r.name
                    cityLat = r.latitude
                    cityLon = r.longitude
                    cityCountry = r.country ?? ""
                    if !contains(["auto", "Mecca", "Medina", "Cairo", "Istanbul", "Jakarta", "London", "New York"], r.name) {
                      savedCities = flatten([[cEntry], savedCities.filter(s => s.val != r.name)]).take(8)
                    }
                    typedCity = ""
                    cityQuery = ""
                    refresh()
                  }
                  Text {
                    text: "📍 ${r.name}"
                    fontSize: 12
                    bold: true
                    color: foreground
                    maxLines: 1
                  }
                  Text {
                    text: subLoc
                    fontSize: 11
                    color: muted
                    weight: 1
                    align: end
                    maxLines: 1
                  }
                }
              }
            }
          } else if searchEmpty {
            Text {
              text: "⚠ ${cityQuery}"
              fontSize: 11
              color: red
            }
          }

          Grid {
            columns: 4
            gap: 6
            for c in flatten([[
              {label: tr.cityAuto, val: "auto"},
              {label: tr.cityMecca, val: "Mecca"},
              {label: tr.cityMedina, val: "Medina"},
              {label: tr.cityCairo, val: "Cairo"},
              {label: tr.cityIstanbul, val: "Istanbul"},
              {label: tr.cityJakarta, val: "Jakarta"},
              {label: tr.cityLondon, val: "London"},
              {label: tr.cityNY, val: "New York"}
            ], savedCities]) key c.val {
              Text {
                text: c.label
                fontSize: 11
                bold: city == c.val
                color: city == c.val ? background : foreground
                align: center
                maxLines: 1
                padding: [6, 7]
                background: city == c.val ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: city == c.val ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: {
                  haptic()
                  city = c.val
                  cityLat = c.lat
                  cityLon = c.lon
                  cityCountry = c.country ?? ""
                  typedCity = ""
                  cityQuery = ""
                  refresh()
                }
              }
            }
          }

          Text { text: tr.methodLabel; style: label; color: accent }
          Grid {
            columns: 2
            gap: 6
            for mItem in [
              {id: "3", label: tr.mMWL},
              {id: "4", label: tr.mMakkah},
              {id: "5", label: tr.mEgypt},
              {id: "2", label: tr.mISNA},
              {id: "1", label: tr.mKarachi},
              {id: "20", label: tr.mKemenag},
              {id: "13", label: tr.mDiyanet},
              {id: "11", label: tr.mMUIS}
            ] key mItem.id {
              Text {
                text: mItem.label
                fontSize: 11
                bold: method == mItem.id
                color: method == mItem.id ? background : foreground
                align: center
                maxLines: 1
                padding: [8, 7]
                background: method == mItem.id ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: method == mItem.id ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: {
                  haptic()
                  method = mItem.id
                  refresh()
                }
              }
            }
          }

          Text { text: tr.schoolLabel; style: label; color: accent }
          Row {
            gap: 6
            fill: width
            for sItem in [
              {id: "0", label: tr.shafii},
              {id: "1", label: tr.hanafi}
            ] key sItem.id {
              Text {
                text: sItem.label
                fontSize: 11
                bold: school == sItem.id
                color: school == sItem.id ? background : foreground
                align: center
                maxLines: 1
                weight: 1
                padding: [8, 8]
                background: school == sItem.id ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: school == sItem.id ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: {
                  haptic()
                  school = sItem.id
                  refresh()
                }
              }
            }
          }

          Text { text: tr.tuneLabel; style: label; color: accent }
          Row {
            gap: 6
            fill: width
            for tVal in [-2, -1, 0, 1, 2, 3] key tVal {
              Text {
                text: "${isRtl ? rlm : ""}${tVal > 0 ? "+${tVal}${tr.minUnit}" : "${tVal}${tr.minUnit}"}"
                fontSize: 11
                bold: tuneMin == tVal
                color: tuneMin == tVal ? background : foreground
                align: center
                weight: 1
                padding: [6, 7]
                background: tuneMin == tVal ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: tuneMin == tVal ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: {
                  haptic()
                  tuneMin = tVal
                  refresh()
                }
              }
            }
          }
        }

        // 3. VERSE & HADITH SETTINGS (All Options Localized)
        if cfgTab == "content" {
          Text { text: tr.verseFreqLabel; style: label; color: accent }
          Row {
            gap: 6
            fill: width
            for vf in [
              {id: "1h", label: tr.freq1h},
              {id: "6h", label: tr.freq6h},
              {id: "12h", label: tr.freq12h},
              {id: "1d", label: tr.freq1d}
            ] key vf.id {
              Text {
                text: vf.label
                fontSize: 11
                bold: verseFreq == vf.id
                color: verseFreq == vf.id ? background : foreground
                align: center
                maxLines: 1
                weight: 1
                padding: [6, 8]
                background: verseFreq == vf.id ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: verseFreq == vf.id ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: { haptic(); verseFreq = vf.id }
              }
            }
          }

          Text { text: tr.verseEdLabel; style: label; color: accent }
          Grid {
            columns: 2
            gap: 6
            for ed in [
              {id: "auto", label: tr.edAuto},
              {id: "ar.muyassar", label: tr.edMuyassar},
              {id: "en.sahih", label: tr.edSahih},
              {id: "en.asad", label: tr.edAsad},
              {id: "id.indonesian", label: tr.edIndo},
              {id: "tr.diyanet", label: tr.edDiyanet},
              {id: "ur.ahmedali", label: tr.edUrdu},
              {id: "fr.hamidullah", label: tr.edFrench}
            ] key ed.id {
              Text {
                text: ed.label
                fontSize: 11
                bold: verseEdition == ed.id
                color: verseEdition == ed.id ? background : foreground
                align: center
                maxLines: 1
                padding: [8, 7]
                background: verseEdition == ed.id ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: verseEdition == ed.id ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: { haptic(); verseEdition = ed.id }
              }
            }
          }

          Text { text: tr.hadithFreqLabel; style: label; color: accent }
          Row {
            gap: 6
            fill: width
            for hf in [
              {id: "1h", label: tr.freq1h},
              {id: "6h", label: tr.freq6h},
              {id: "12h", label: tr.freq12h},
              {id: "1d", label: tr.freq1d}
            ] key hf.id {
              Text {
                text: hf.label
                fontSize: 11
                bold: hadithFreq == hf.id
                color: hadithFreq == hf.id ? background : foreground
                align: center
                maxLines: 1
                weight: 1
                padding: [6, 8]
                background: hadithFreq == hf.id ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: hadithFreq == hf.id ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: { haptic(); hadithFreq = hf.id }
              }
            }
          }

          Text { text: tr.hadithBookLabel; style: label; color: accent }
          Grid {
            columns: 2
            gap: 6
            for hb in [
              {id: "nawawi", label: tr.bkNawawi},
              {id: "qudsi", label: tr.bkQudsi},
              {id: "bukhari", label: tr.bkBukhari},
              {id: "muslim", label: tr.bkMuslim}
            ] key hb.id {
              Text {
                text: hb.label
                fontSize: 11
                bold: hadithBook == hb.id
                color: hadithBook == hb.id ? background : foreground
                align: center
                maxLines: 1
                padding: [8, 8]
                background: hadithBook == hb.id ? accent : alpha(surface, 0.65)
                border: 1
                borderColor: hadithBook == hb.id ? accent : alpha(border, 0.5)
                radius: 8 * corners
                onTap: { haptic(); hadithBook = hb.id }
              }
            }
          }

          Row {
            gap: 6
            fill: width
            Text {
              text: "${tr.verseArToggle}: ${showVerseAr ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: showVerseAr
              color: showVerseAr ? background : foreground
              align: center
              weight: 1
              padding: [8, 8]
              background: showVerseAr ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showVerseAr ? accent : alpha(border, 0.5)
              radius: 8 * corners
              onTap: { haptic(); showVerseAr = !showVerseAr }
            }
            Text {
              text: "${tr.hadithArToggle}: ${showHadithAr ? tr.onStr : tr.offStr}"
              fontSize: 11
              bold: showHadithAr
              color: showHadithAr ? background : foreground
              align: center
              weight: 1
              padding: [8, 8]
              background: showHadithAr ? accent : alpha(surface, 0.65)
              border: 1
              borderColor: showHadithAr ? accent : alpha(border, 0.5)
              radius: 8 * corners
              onTap: { haptic(); showHadithAr = !showHadithAr }
            }
          }
        }
      }
    }
  }

  // Root Face Layout (Responsive for Portrait & Foldable/Landscape; hides header/weather/bottom dock while keyboard is open)
  Box {
    fill: true

    if wide {
      Row {
        gap: 20
        fill: true
        padding: [20, 12]
        if !kbOpen {
          Column {
            gap: 12
            weight: 1
            fill: height
            ClockHeader { }
            WeatherCard { }
            Spacer { weight: 1 }
            BottomDock { }
            Spacer { height: screenInset }
          }
        }
        Column {
          gap: 12
          weight: 1
          fill: height
          if showConfig {
            ConfigView { }
          } else if showPinModal {
            PinAppsModal { }
          } else {
            IslamicHub { }
          }
          Spacer { height: screenInset }
        }
      }
    } else {
      Column {
        gap: 10
        fill: true
        padding: [16, 10]
        if !kbOpen {
          ClockHeader { }
        }
        if showConfig {
          ConfigView { }
        } else if showPinModal {
          PinAppsModal { }
        } else {
          if !kbOpen {
            WeatherCard { }
          }
          IslamicHub { }
          if !kbOpen {
            BottomDock { }
          }
        }
        Spacer { height: screenInset }
      }
    }
  }
}
