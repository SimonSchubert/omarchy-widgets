      onStr: "مفعل", offStr: "معطل", dayUnit: "ي", minUnit: "د",
      dashWidgets: "أقسام الشاشة", weatherToggle: "بطاقة الطقس", notifToggle: "الإشعارات", appsToggle: "التطبيقات السريعة", pinIconToggle: "أيقونة التثبيت", appNamesToggle: "أسماء التطبيقات", azkarNotifToggle: "تنبيه الأذكار",
      notifTitle: "الإشعارات", notifClear: "لا توجد إشعارات جديدة", notifAllow: "يرجى السماح بالوصول للإشعارات", notifGrantBtn: "سماح",
      pinTitle: "تثبيت التطبيقات بالأسفل", pinHint: "اضغط على أي تطبيق لتثبيته أو إلغاء تثبيته", pinSearch: "ابحث في التطبيقات...",
      locLabel: "المدينة والموقع", searchPlaceholder: "ابحث عن مدينة (مثل: مكة، القاهرة)...", searchBtn: "بحث",
      cityAuto: "📍 تلقائي", cityMecca: "مكة المكرمة", cityMedina: "المدينة المنورة", cityCairo: "القاهرة", cityIstanbul: "إسطنبول", cityJakarta: "جاكرتا", cityLondon: "لندن", cityNY: "نيويورك",
