face "islamic" {
  page: 0

  meta {
    owl: 11
    description: "Islamic home screen face with multi-tab prayer times, prayer habit tracker, verse of the day, hadith of the day, weather, notifications, pinnable apps, and full localization"
    version: "1.3"
    license: "MIT"
    category: "productivity"
  }

  requires {
    pacman: []
  }

  // Persistent user configuration
  state lang = "en" persist
  state use24h = false persist
  state dateFmt = "DD/MM/YYYY" persist
  state showHijri = true persist
  state hijriAdj = 0 persist
  state showWeather = true persist
  state showNotif = true persist
  state showApps = true persist
  state showPinIcon = true persist
  state showAppNames = true persist
  state azkarNotif = true persist

  // Azkar & Electronic Mesbaha state
  state azkarCat = "morning" persist
  state azkarQuery = ""
  state selectedZikrId = null
  state azkarCounts = {} persist
  state azkarResetDay = 0 persist
  state lastMorningNotifDay = 0 persist
  state lastEveningNotifDay = 0 persist
  state tasbihIdx = 0 persist
  state tasbihCount = 0 persist
  state tasbihTarget = 33 persist
  state tasbihTotal = 0 persist

  // Pinned apps state for bottom dock
  state pinnedApps = [] persist
  state showPinModal = false
  state appSearchQuery = ""

  // Navigation & UI state
  state activeTab = "prayers" persist
  state showConfig = false
  state cfgTab = "general"
  state show7Day = false

  // Prayer configuration (similar to omaprayer)
  state city = "auto" persist
  state cityLat = null persist
  state cityLon = null persist
  state cityCountry = "" persist
  state savedCities = [] persist
  state typedCity = ""
  state cityQuery = ""
  state method = "3" persist
  state school = "0" persist
  state tuneMin = 0 persist

  // Prayer habit tracker persisted log: map of dayNumberStr -> {fajr, dhuhr, asr, maghrib, isha}
  state prayerLog = {} persist
  state selectedTrackDay = null

  // Verse of today settings & cache
  state verseFreq = "1d" persist
  state verseEdition = "auto" persist
  state showVerseAr = true persist
  state verseSeed = 0 persist
  state lastVerse = null persist

  // Hadith of today settings & cache
  state hadithFreq = "1d" persist
  state hadithBook = "nawawi" persist
  state showHadithAr = true persist
  state hadithSeed = 0 persist
  state lastHadith = null persist

  // Live sources
  source now = clock every 10s
  source bat = android.battery
  source alarm = android.alarm
  source notif = android.notifications
  source m = android.media
  source v = android.volume
  source modes = android.modes
  source apps = android.apps

  // Geocoding via Open-Meteo when custom city is set
  source geo = http(city == "auto" || cityLat != null || len(trim(city)) < 2 ? null : "https://geocoding-api.open-meteo.com/v1/search?name=${enc(trim(city))}&count=1") every 1h timeout 10s json status
  source citySearch = http(len(trim(cityQuery)) < 2 ? null : "https://geocoding-api.open-meteo.com/v1/search?name=${enc(trim(cityQuery))}&count=5&language=${enc(lang)}") every 1h timeout 10s json status
  let searchResults = len(trim(cityQuery)) >= 2 && citySearch != null && citySearch.ok ? (citySearch.out.results ?? []) : []
  let searchEmpty = len(trim(cityQuery)) >= 2 && citySearch != null && citySearch.ok && len(searchResults) == 0
  let geoFound = city == "auto" || cityLat != null || (geo != null && geo.ok && geo.out.results != null && len(geo.out.results) > 0)
  let geoResult = city != "auto" && cityLat == null && geoFound && geo.out.results != null ? geo.out.results[0] : null
  let notFound = city != "auto" && cityLat == null && geo != null && geo.ok && (geo.out.results == null || len(geo.out.results) == 0)

  // Weather & auto-location via wttr.in
  let resLat = cityLat ?? geoResult.latitude
  let resLon = cityLon ?? geoResult.longitude
  let wxLoc = city == "auto" ? "" : (resLat != null ? "${resLat},${resLon}" : null)
  source wx = http(wxLoc == null ? null : "https://wttr.in/${enc(wxLoc)}?format=j1") every 30m timeout 10s json status
  let wxData = wx != null && wx.ok ? wx.out : null
  let curWx = wxData != null && wxData.current_condition != null ? wxData.current_condition[0] : null
  let dayWx = wxData != null && wxData.weather != null ? wxData.weather[0] : null
  let ipArea = wxData != null && wxData.nearest_area != null ? wxData.nearest_area[0] : null

  let lat = city == "auto" ? ipArea.latitude : resLat
  let lon = city == "auto" ? ipArea.longitude : resLon
  let rawPlaceName = city == "auto" ? (ipArea.areaName[0].value ?? "offline") : (cityLat != null ? city : (geoResult.name ?? city))
  let countryName = city == "auto" ? (ipArea.country[0].value ?? "") : (cityLat != null ? cityCountry : (geoResult.country ?? ""))

  // Aladhan tune & calendar sources
  let reqYear = floor(num(fmtTime(now, "yyyy")))
  let reqMonth = floor(num(fmtTime(now, "M")))
  let reqDay = floor(num(fmtTime(now, "d")))
  let nextMonth = reqMonth == 12 ? 1 : reqMonth + 1
  let nextYear = reqMonth == 12 ? reqYear + 1 : reqYear

  let tuneStr = "0,${int(tuneMin)},0,${int(tuneMin)},${int(tuneMin)},${int(tuneMin)},0,${int(tuneMin)},0"
  source cal = http(lat == null ? null : "https://api.aladhan.com/v1/calendar/${int(reqYear)}/${int(reqMonth)}?latitude=${enc(str(lat))}&longitude=${enc(str(lon))}&method=${enc(method)}&school=${enc(school)}&calendarMethod=HJCoSA&tune=${enc(tuneStr)}") every 1h timeout 15s json status
  source nextCal = http(lat == null || reqDay < 25 ? null : "https://api.aladhan.com/v1/calendar/${int(nextYear)}/${int(nextMonth)}?latitude=${enc(str(lat))}&longitude=${enc(str(lon))}&method=${enc(method)}&school=${enc(school)}&calendarMethod=HJCoSA&tune=${enc(tuneStr)}") every 1h timeout 15s json status

  let calList = lat != null && cal != null && cal.ok && cal.out.data != null ? cal.out.data : []
  let nextCalList = lat != null && nextCal != null && nextCal.ok && nextCal.out.data != null ? nextCal.out.data : []
  let allDays = flatten([calList, nextCalList])
  let zone = calList[0].meta.timezone

  // Target city's clock & date (uses phone's timezone until Aladhan responds)
  let curMin = floor(num(fmtTime(now, "H", zone))) * 60 + floor(num(fmtTime(now, "m", zone)))
  let localDay = floor(num(fmtTime(now, "d", zone)))
  let localMonth = floor(num(fmtTime(now, "M", zone)))
  let localYear = floor(num(fmtTime(now, "yyyy", zone)))

  let todayItem = allDays.find(d => floor(num(d.date.gregorian.day)) == localDay && floor(num(d.date.gregorian.month.number)) == localMonth) ?? allDays[0]
  let todayIdx = allDays.indexOf(todayItem)
  let weekDays = todayIdx >= 0 ? take(drop(allDays, todayIdx), 7) : take(allDays, 7)

  // Complete Localization Dictionary (All UI labels AND all Settings options)
  let dict = {
    en: {
      tabPrayers: "Prayers", tabTracker: "Tracker", tabAzkar: "Azkar", tabVerse: "Verse", tabHadith: "Hadith",
      imsak: "Imsak", fajr: "Fajr", sunrise: "Sunrise", dhuhr: "Dhuhr", asr: "Asr", maghrib: "Maghrib", isha: "Isha", midnight: "Midnight", lastThird: "Tahajjud",
      nextPrayer: "NEXT PRAYER", remaining: "remaining", prayerNow: "Prayer time!", tmrw: "tmrw",
      todaySchedule: "Today", weekSchedule: "7-Day", dayCol: "DAY", nowLabel: "now",
      trackerTitle: "Daily Prayer Tracker", weeklyTitle: "Last 7 Days Habit Grid",
      tapHint: "Tap a prayer to log completion",
      completed: "Prayed", pending: "Pending", markAll: "Complete All", resetDay: "Reset",
      weekScore: "7-Day Rate", fullDays: "Perfect Days", todayLabel: "Today",
      azkMorning: "Morning", azkEvening: "Evening", azkPrayer: "Prayer", azkSleep: "Sleep", azkGeneral: "Duas", azkMesbaha: "Mesbaha",
      azkSearch: "Search azkar & duas...", azkTapCount: "Tap: +1 · Hold: options", completeZikrBtn: "Set Complete", closeBtn: "Back",
      mesbahaTap: "TAP TO COUNT", mesbahaTarget: "Target", mesbahaTotal: "Total", mesbahaRound: "Rounds",
      morningNotifTitle: "🌅 Morning Azkar Time", morningNotifBody: "Tap to read your Morning Azkar",
      eveningNotifTitle: "🌇 Evening Azkar Time", eveningNotifBody: "Tap to read your Evening Azkar",
      verseTitle: "Verse of the Day", hadithTitle: "Hadith of the Day",
      copy: "Copy", share: "Share", nextBtn: "New ↻", arabToggle: "Arabic",
      settingsBtn: "Settings", settings: "Face Settings", generalTab: "General", prayerTab: "Prayer", contentTab: "Verse & Hadith",
      langLabel: "LANGUAGE", timeFmtLabel: "TIME FORMAT", dateFmtLabel: "DATE FORMAT",
      fmt12h: "12-Hour (AM/PM)", fmt24h: "24-Hour (14:30)",
      dfDMY: "DD/MM/YYYY (20/10/2026)", dfMDY: "MM/DD/YYYY (10/20/2026)", dfYMD: "YYYY-MM-DD (2026-10-20)", dfShort: "DD MMM YYYY (20 Oct 2026)", dfFull: "Full (Tuesday, 20 October)",
      hijriLabel: "HIJRI CALENDAR", hijriShow: "Show Hijri", hijriOffset: "Hijri Day Offset",
      onStr: "ON", offStr: "OFF", dayUnit: "d", minUnit: "m",
      dashWidgets: "FACE SECTIONS", weatherToggle: "Weather", notifToggle: "Notifications", appsToggle: "Quick Apps", pinIconToggle: "Pin Icon", appNamesToggle: "App Names", azkarNotifToggle: "Azkar Alerts",
      notifTitle: "Notifications", notifClear: "No new notifications", notifAllow: "Allow notification access", notifGrantBtn: "Allow",
      pinTitle: "Pin Apps to Bottom Dock", pinHint: "Tap apps below to pin/unpin (or long-press on dock)", pinSearch: "Search installed apps...",
      locLabel: "CITY / LOCATION", searchPlaceholder: "Search city (e.g. London, Cairo)...", searchBtn: "Search",
      cityAuto: "📍 Auto", cityMecca: "Makkah", cityMedina: "Madinah", cityCairo: "Cairo", cityIstanbul: "Istanbul", cityJakarta: "Jakarta", cityLondon: "London", cityNY: "New York",
      methodLabel: "CALCULATION METHOD", schoolLabel: "ASR JURISTIC METHOD (MADHAB)", tuneLabel: "SAFETY MARGIN (IHTIYAT)",
      mMWL: "Muslim World League (MWL)", mMakkah: "Umm al-Qura, Makkah", mEgypt: "Egyptian Authority (EGAS)", mISNA: "ISNA (North America)",
      mKarachi: "Karachi (UISC)", mKemenag: "Kemenag RI (Indonesia)", mDiyanet: "Diyanet (Turkey)", mMUIS: "MUIS (Singapore)",
      mShortMWL: "MWL", mShortMakkah: "Umm al-Qura", mShortEgypt: "Egypt", mShortISNA: "ISNA", mShortKarachi: "Karachi", mShortKemenag: "Kemenag RI", mShortDiyanet: "Diyanet", mShortMUIS: "MUIS",
      shafii: "Standard (Shafi'i, Maliki, Hanbali)", hanafi: "Hanafi (Later Asr)",
      shafiiShort: "Shafi'i", hanafiShort: "Hanafi",
      verseFreqLabel: "VERSE UPDATE FREQUENCY", verseEdLabel: "QURAN TRANSLATION / TAFSIR",
      edAuto: "Auto (Follow Language)", edSahih: "Sahih International (English)", edAsad: "Muhammad Asad (English)", edMuyassar: "Tafsir Al-Muyassar (Arabic)",
      edIndo: "Bahasa Indonesia", edDiyanet: "Türkçe (Diyanet)", edUrdu: "Urdu (Ahmed Ali)", edFrench: "Français (Hamidullah)",
      hadithFreqLabel: "HADITH UPDATE FREQUENCY", hadithBookLabel: "HADITH COLLECTION",
      bkNawawi: "40 Hadith an-Nawawi", bkQudsi: "40 Hadith Qudsi", bkBukhari: "Sahih al-Bukhari", bkMuslim: "Sahih Muslim",
      freq1h: "Every 1h", freq6h: "Every 6h", freq12h: "Every 12h", freq1d: "Daily (24h)",
      verseArToggle: "Verse Arabic Script", hadithArToggle: "Hadith Arabic Script",
      closeSettings: "✓ Done", searchApps: "search apps",
      sunnahTimes: "SUNNAH & NIGHT TIMES",
      am: "AM", pm: "PM"
    },
    ar: {
      tabPrayers: "الصلاة", tabTracker: "المتتبع", tabAzkar: "الأذكار", tabVerse: "الآية", tabHadith: "الحديث",
