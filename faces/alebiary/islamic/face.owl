      completed: "تمت", pending: "لم تسجل", markAll: "إكمال الكل", resetDay: "إعادة ضبط",
      weekScore: "إنجاز 7 أيام", fullDays: "أيام مكتملة", todayLabel: "اليوم",
      azkMorning: "الصباح", azkEvening: "المساء", azkPrayer: "بعد الصلاة", azkSleep: "النوم", azkGeneral: "أدعية", azkMesbaha: "المسبحة",
      azkSearch: "ابحث في الأذكار والأدعية...", azkTapCount: "اضغط للعد · مطولاً للخيارات", completeZikrBtn: "إكمال العدد", closeBtn: "رجوع",
      mesbahaTap: "اضغط للتسبيح", mesbahaTarget: "الهدف", mesbahaTotal: "المجموع", mesbahaRound: "الدورات",
