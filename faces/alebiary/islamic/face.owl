      methodLabel: "METODE PERHITUNGAN", schoolLabel: "MADZHAB ASHAR", tuneLabel: "KOREKSI IHTIYAT",
      mMWL: "Liga Muslim Dunia (MWL)", mMakkah: "Umm al-Qura, Makkah", mEgypt: "Otoritas Mesir (EGAS)", mISNA: "ISNA (Amerika Utara)",
      mKarachi: "Karachi (UISC)", mKemenag: "Kemenag RI (Indonesia)", mDiyanet: "Diyanet (Turki)", mMUIS: "MUIS (Singapura)",
      mShortMWL: "MWL", mShortMakkah: "Umm al-Qura", mShortEgypt: "Mesir", mShortISNA: "ISNA", mShortKarachi: "Karachi", mShortKemenag: "Kemenag RI", mShortDiyanet: "Diyanet", mShortMUIS: "MUIS",
      shafii: "Syafi'i, Maliki, Hanbali", hanafi: "Hanafi (Ashar Lebih Akhir)",
      shafiiShort: "Syafi'i", hanafiShort: "Hanafi",
