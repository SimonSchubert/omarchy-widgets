face "cdm-review" {
  meta { owl: 12; description: "Native CDM gate and question review with bounded offline text and browser-approved pairing"; version: "1.0"; license: "MIT"; category: "productivity" }
  background: alpha(background, 0.88)

  // One deployment origin. Editing it deliberately invalidates OWL's origin-bound secrets;
  // pair again after changing it. No token or browser cookie is ever pasted into this file.
  let api = "https://ai.cdm.space"

  state token = null secret
  state pairToken = null secret
  state account = null persist
  state pairStart = null
  state pairPoll = null
  state pairPollTarget = null
  state pairRequest = null persist
  state pairing = false persist
  state pairStarting = false
  state pairPolling = false
  state pairStatus = ""

  state lastQueue = null persist
  state hidden = [] persist
  state drafts = {} persist
  // At most six plaintext presentation snapshots. HTML/images/bytes are never copied here.
  state details = [] persist
  state conflicts = {} persist
  state itemErrors = {} persist
  state loadErrors = {} persist
  state current = null persist
  state openRequest = null
  state currentDetailSlot = -1
  state detailPoolFull = false
  state startupOpen = true
  state tab = "review"
  state dispatch = -1

  state res0 = null
  state tgt0 = null persist
  state live0 = false

  state res1 = null
  state tgt1 = null persist
  state live1 = false

  state res2 = null
  state tgt2 = null persist
  state live2 = false

  state res3 = null
  state tgt3 = null persist
  state live3 = false

  state d0 = null
  state d0active = false
  state d0exactDone = false
  state d0reviewDone = false
  state d0receiptDone = false
  state d0stateDone = false

  state d1 = null
  state d1active = false
  state d1exactDone = false
  state d1reviewDone = false
  state d1receiptDone = false
  state d1stateDone = false

  state d2 = null
  state d2active = false
  state d2exactDone = false
  state d2reviewDone = false
  state d2receiptDone = false
  state d2stateDone = false

  state d3 = null
  state d3active = false
  state d3exactDone = false
  state d3reviewDone = false
  state d3receiptDone = false
  state d3stateDone = false

  source me = http(token == null ? null : "${api}/api/native/me", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source q = http(token == null || account == null ? null : "${api}/api/native/review-queue?limit=50", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 30s json status

  source e0 = http(token == null || !d0active ? null : d0.key.kind == "gate" ? "${api}/api/swarms/${enc(d0.key.pack)}/gates/${enc(d0.key.id)}" : "${api}/api/swarms/${enc(d0.key.pack)}/asks/${enc(d0.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source r0 = http(token == null || !d0active || d0.key.kind != "gate" ? null : "${api}/api/swarms/${enc(d0.key.pack)}/gates/${enc(d0.key.id)}/review", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source c0 = http(token == null || !d0active || d0.key.kind != "gate" || (d0.tool_name != "onec_receipt_create" && d0.tool_name != "onec_receipt_update" && d0.tool_name != "onec_receipt_update_edited") ? null : "${api}/api/swarms/${enc(d0.key.pack)}/gates/${enc(d0.key.id)}/receipt", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source o0 = http(token == null || !d0active ? null : "${api}/api/swarms/${enc(d0.key.pack)}/operator-state/${enc(d0.key.kind)}/${enc(d0.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status

  source e1 = http(token == null || !d1active ? null : d1.key.kind == "gate" ? "${api}/api/swarms/${enc(d1.key.pack)}/gates/${enc(d1.key.id)}" : "${api}/api/swarms/${enc(d1.key.pack)}/asks/${enc(d1.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source r1 = http(token == null || !d1active || d1.key.kind != "gate" ? null : "${api}/api/swarms/${enc(d1.key.pack)}/gates/${enc(d1.key.id)}/review", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source c1 = http(token == null || !d1active || d1.key.kind != "gate" || (d1.tool_name != "onec_receipt_create" && d1.tool_name != "onec_receipt_update" && d1.tool_name != "onec_receipt_update_edited") ? null : "${api}/api/swarms/${enc(d1.key.pack)}/gates/${enc(d1.key.id)}/receipt", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source o1 = http(token == null || !d1active ? null : "${api}/api/swarms/${enc(d1.key.pack)}/operator-state/${enc(d1.key.kind)}/${enc(d1.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status

  source e2 = http(token == null || !d2active ? null : d2.key.kind == "gate" ? "${api}/api/swarms/${enc(d2.key.pack)}/gates/${enc(d2.key.id)}" : "${api}/api/swarms/${enc(d2.key.pack)}/asks/${enc(d2.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source r2 = http(token == null || !d2active || d2.key.kind != "gate" ? null : "${api}/api/swarms/${enc(d2.key.pack)}/gates/${enc(d2.key.id)}/review", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source c2 = http(token == null || !d2active || d2.key.kind != "gate" || (d2.tool_name != "onec_receipt_create" && d2.tool_name != "onec_receipt_update" && d2.tool_name != "onec_receipt_update_edited") ? null : "${api}/api/swarms/${enc(d2.key.pack)}/gates/${enc(d2.key.id)}/receipt", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source o2 = http(token == null || !d2active ? null : "${api}/api/swarms/${enc(d2.key.pack)}/operator-state/${enc(d2.key.kind)}/${enc(d2.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status

  source e3 = http(token == null || !d3active ? null : d3.key.kind == "gate" ? "${api}/api/swarms/${enc(d3.key.pack)}/gates/${enc(d3.key.id)}" : "${api}/api/swarms/${enc(d3.key.pack)}/asks/${enc(d3.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source r3 = http(token == null || !d3active || d3.key.kind != "gate" ? null : "${api}/api/swarms/${enc(d3.key.pack)}/gates/${enc(d3.key.id)}/review", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source c3 = http(token == null || !d3active || d3.key.kind != "gate" || (d3.tool_name != "onec_receipt_create" && d3.tool_name != "onec_receipt_update" && d3.tool_name != "onec_receipt_update_edited") ? null : "${api}/api/swarms/${enc(d3.key.pack)}/gates/${enc(d3.key.id)}/receipt", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status
  source o3 = http(token == null || !d3active ? null : "${api}/api/swarms/${enc(d3.key.pack)}/operator-state/${enc(d3.key.kind)}/${enc(d3.key.id)}", {Authorization: "Bearer ${token}", Accept: "application/json"}) every 15s timeout 20s json status

  let blank = {text: "", picks: [], reason: "", postmortem: false, mode: "normal"}
  let queue = q != null && q.ok ? q.out : lastQueue
  let qItems = (queue ?? {}).items ?? []
  let visibleItems = qItems.filter(item => !hidden.any(k => k == item.key))
  let targets = [tgt0, tgt1, tgt2, tgt3]
  let results = [res0, res1, res2, res3]
  let lives = [live0, live1, live2, live3]
  let detailActive = [d0active, d1active, d2active, d3active]
  let poolFree = targets.any(t => t == null)
  let activityCount = len(targets.filter(t => t != null))
  let currentId = current == null || account == null ? "" : toJson({account: account, key: current.key})
  let currentIndex = current == null ? -1 : indexOf(visibleItems.map(item => toJson(item.key)), toJson(current.key))
  let nextItem = current == null ? null : currentIndex >= 0 && currentIndex + 1 < len(visibleItems) ? visibleItems[currentIndex + 1] : null
  let entry = current == null ? null : details.find(d => d.key == currentId)
  let exact = (entry ?? {}).exact
  let review = (entry ?? {}).review
  let receipt = (entry ?? {}).receipt
  let serverState = (entry ?? {}).state
  let mail = (review ?? {}).mail
  let isReceipt = current != null && current.key.kind == "gate" && (exact.tool_name == "onec_receipt_create" || exact.tool_name == "onec_receipt_update" || exact.tool_name == "onec_receipt_update_edited")
  let localDraft = get(drafts, currentId, null)
  let draft = localDraft != null ? merge(blank, localDraft) : serverState != null && serverState.draft != null ? merge(blank, serverState.draft) : blank
  let options = (exact ?? {}).options ?? []
  let selected = join(draft.picks.map(i => options[i].label), ", ")
  let answerText = selected != "" && trim(draft.text) != "" ? "${selected}\n\n${trim(draft.text)}" : selected != "" ? selected : trim(draft.text)
  let currentLoaded = current != null && entry != null && currentDetailSlot >= 0 && !detailActive[currentDetailSlot]
  let currentBusy = current != null && targets.any(t => t != null && t.item.key == current.key)
  let currentAvailable = current != null && q != null && q.ok && !contains(q.out.unavailable_packs ?? [], current.key.pack)
  let canWrite = token != null && currentAvailable && currentLoaded && !currentBusy && get(loadErrors, currentId, null) == null
  let gateReady = canWrite && exact.status == "pending" && review.review_state == "ready" && (mail == null || trim(mail.body_plain ?? "") != "") && (!isReceipt || (exact.input != null && receipt != null))
  let askReady = canWrite && exact.status == "pending" && trim(exact.question ?? "") != ""
  let currentError = get(itemErrors, currentId, null)
  let currentConflict = get(conflicts, currentId, null)
  let currentLoadError = get(loadErrors, currentId, null)
  let recipients = mail == null ? "" : join((mail.to ?? []).map(a => a.name != "" ? "${a.name} <${a.address}>" : a.address), ", ")
  let cc = mail == null ? "" : join((mail.cc ?? []).map(a => a.name != "" ? "${a.name} <${a.address}>" : a.address), ", ")
  let bcc = mail == null ? "" : join((mail.bcc ?? []).map(a => a.name != "" ? "${a.name} <${a.address}>" : a.address), ", ")

  on pairStart {
    if pairStarting {
      pairStarting = false
      if pairing && pairStart.ok {
        pairRequest = {request_id: pairStart.out.request_id, user_code: pairStart.out.user_code, verification_uri: pairStart.out.verification_uri, expires_in: pairStart.out.expires_in, interval: pairStart.out.interval}
        pairToken = pairStart.out.poll_token
        pairStatus = "Confirm the matching code in your normal browser."
      } else {
        pairing = false
        pairStatus = "Could not start pairing. Check the connection and try again."
      }
    }
  }

  every 5s {
    if pairing && pairRequest != null && pairToken != null && !pairPolling {
      pairPolling = true
      pairPollTarget = pairRequest.request_id
      pairPoll = post("${api}/auth/native/poll", {request_id: pairRequest.request_id}, {Authorization: "Bearer ${pairToken}", Accept: "application/json"})
    }
  }

  on pairPoll {
    let result = value
    let target = pairPollTarget
    pairPolling = false
    pairPollTarget = null
    // Clear the slot: another identical pending response is still a new poll completion.
    pairPoll = null
    if pairing && pairRequest != null && target == pairRequest.request_id {
      if result.ok && result.out.status == "authorized" {
        // Successful explicit re-pairing is also an account/cache boundary. Server drafts remain.
        account = null
        lastQueue = null
        current = null
        hidden = []
        drafts = {}
        details = []
        conflicts = {}
        itemErrors = {}
        loadErrors = {}
        token = result.out.device_token
        pairToken = null
        pairRequest = null
        pairing = false
        pairStatus = ""
      } else if result.ok && result.out.status == "pending" {
        pairStatus = "Waiting for browser confirmation…"
      } else if result.code == -1 || result.code == 429 || result.code >= 500 {
        // Keep the same challenge/poll bearer: a lost authorized response replays the same grant.
        pairStatus = "Polling unavailable; retrying this challenge while it remains valid…"
      } else {
        pairing = false
        pairToken = null
        pairStatus = "Pairing expired or was denied. Start a new challenge."
      }
    }
  }

  on me first {
    if me.ok && account == null {
      account = me.out.user.id
    } else if me.ok && account != me.out.user.id {
      // Fail closed if a credential ever changes outside the normal re-pair boundary.
      account = me.out.user.id
      lastQueue = null
      current = null
      hidden = []
      drafts = {}
      details = []
      conflicts = {}
      itemErrors = {}
      loadErrors = {}
    }
  }

  on q first {
    if q.ok {
      lastQueue = q.out
      // A pack missing from a partial response is not proof that its hidden item resolved.
      hidden = hidden.filter(k => q.out.next_cursor != null || contains(q.out.unavailable_packs ?? [], k.pack) || q.out.items.any(item => item.key == k))
    }
  }

  when startupOpen && current != null && token != null {
    startupOpen = false
    openRequest = current
  }

  when openRequest != null {
    let item = openRequest
    let key = toJson({account: account, key: item.key})
    openRequest = null
    currentDetailSlot = -1
    detailPoolFull = false
    loadErrors = remove(loadErrors, key)
    if !d0active {
      d0 = item
      d0exactDone = false
      d0reviewDone = false
      d0receiptDone = false
      d0stateDone = false
      d0active = true
      currentDetailSlot = 0
    }
    else if !d1active {
      d1 = item
      d1exactDone = false
      d1reviewDone = false
      d1receiptDone = false
      d1stateDone = false
      d1active = true
      currentDetailSlot = 1
    }
    else if !d2active {
      d2 = item
      d2exactDone = false
      d2reviewDone = false
      d2receiptDone = false
      d2stateDone = false
      d2active = true
      currentDetailSlot = 2
    }
    else if !d3active {
      d3 = item
      d3exactDone = false
      d3reviewDone = false
      d3receiptDone = false
      d3stateDone = false
      d3active = true
      currentDetailSlot = 3
    }
    else { detailPoolFull = true }
  }

  on e0 { if d0active { d0exactDone = true } }
  on r0 { if d0active { d0reviewDone = true } }
  on c0 { if d0active { d0receiptDone = true } }
  on o0 { if d0active { d0stateDone = true } }
  when d0active && d0exactDone && d0stateDone && (d0.key.kind == "ask" || (d0reviewDone && ((d0.tool_name != "onec_receipt_create" && d0.tool_name != "onec_receipt_update" && d0.tool_name != "onec_receipt_update_edited") || d0receiptDone))) {
    let key = toJson({account: account, key: d0.key})
    let receiptGate = d0.key.kind == "gate" && (d0.tool_name == "onec_receipt_create" || d0.tool_name == "onec_receipt_update" || d0.tool_name == "onec_receipt_update_edited")
    let bound = e0.out.id == d0.key.id && e0.out.pack == d0.key.pack && o0.out.kind == d0.key.kind && o0.out.item_id == d0.key.id && (d0.key.kind == "ask" || r0.out.gate_id == d0.key.id) && (!receiptGate || !c0.ok || c0.out.gate_id == d0.key.id)
    if e0.ok && o0.ok && (d0.key.kind == "ask" || r0.ok) && (!receiptGate || c0.ok || c0.code == 404) && bound {
      let rawMail = d0.key.kind == "gate" ? r0.out.mail : null
      let mailProjection = rawMail == null ? null : {subject: rawMail.subject, to: rawMail.to, cc: rawMail.cc, bcc: rawMail.bcc, body_plain: rawMail.body_plain, attachments: (rawMail.attachments ?? []).map(a => {filename: a.filename, content_type: a.content_type, size: a.size})}
      let exactProjection = d0.key.kind == "gate" ? {id: e0.out.id, pack: e0.out.pack, status: e0.out.status, preview_gfm: e0.out.preview_gfm, tool_name: e0.out.tool_name, submitted_at: e0.out.submitted_at, input: receiptGate ? e0.out.input : null} : {id: e0.out.id, pack: e0.out.pack, status: e0.out.status, header: e0.out.header, question: e0.out.question, options: (e0.out.options ?? []).map(o => {label: o.label, description: o.description}), multi: e0.out.multi, kind: e0.out.kind, created_at: e0.out.created_at}
      let reviewProjection = d0.key.kind == "gate" ? {review_state: r0.out.review_state, review_error: r0.out.review_error, mail: mailProjection} : null
      let stateProjection = {revision: o0.out.revision, draft: o0.out.draft, parked: o0.out.parked}
      let loaded = {key: key, exact: exactProjection, review: reviewProjection, receipt: receiptGate && c0.ok ? c0.out.review_context : null, receiptError: receiptGate && !c0.ok ? "no_review_snapshot" : null, state: stateProjection}
      details = ([loaded] + details.filter(d => d.key != key)).take(6)
      loadErrors = remove(loadErrors, key)
    } else {
      loadErrors = set(loadErrors, key, "Refresh failed; showing the last complete copy when one exists.")
    }
    d0active = false
  }

  on e1 { if d1active { d1exactDone = true } }
  on r1 { if d1active { d1reviewDone = true } }
  on c1 { if d1active { d1receiptDone = true } }
  on o1 { if d1active { d1stateDone = true } }
  when d1active && d1exactDone && d1stateDone && (d1.key.kind == "ask" || (d1reviewDone && ((d1.tool_name != "onec_receipt_create" && d1.tool_name != "onec_receipt_update" && d1.tool_name != "onec_receipt_update_edited") || d1receiptDone))) {
    let key = toJson({account: account, key: d1.key})
    let receiptGate = d1.key.kind == "gate" && (d1.tool_name == "onec_receipt_create" || d1.tool_name == "onec_receipt_update" || d1.tool_name == "onec_receipt_update_edited")
    let bound = e1.out.id == d1.key.id && e1.out.pack == d1.key.pack && o1.out.kind == d1.key.kind && o1.out.item_id == d1.key.id && (d1.key.kind == "ask" || r1.out.gate_id == d1.key.id) && (!receiptGate || !c1.ok || c1.out.gate_id == d1.key.id)
    if e1.ok && o1.ok && (d1.key.kind == "ask" || r1.ok) && (!receiptGate || c1.ok || c1.code == 404) && bound {
      let rawMail = d1.key.kind == "gate" ? r1.out.mail : null
      let mailProjection = rawMail == null ? null : {subject: rawMail.subject, to: rawMail.to, cc: rawMail.cc, bcc: rawMail.bcc, body_plain: rawMail.body_plain, attachments: (rawMail.attachments ?? []).map(a => {filename: a.filename, content_type: a.content_type, size: a.size})}
      let exactProjection = d1.key.kind == "gate" ? {id: e1.out.id, pack: e1.out.pack, status: e1.out.status, preview_gfm: e1.out.preview_gfm, tool_name: e1.out.tool_name, submitted_at: e1.out.submitted_at, input: receiptGate ? e1.out.input : null} : {id: e1.out.id, pack: e1.out.pack, status: e1.out.status, header: e1.out.header, question: e1.out.question, options: (e1.out.options ?? []).map(o => {label: o.label, description: o.description}), multi: e1.out.multi, kind: e1.out.kind, created_at: e1.out.created_at}
      let reviewProjection = d1.key.kind == "gate" ? {review_state: r1.out.review_state, review_error: r1.out.review_error, mail: mailProjection} : null
      let stateProjection = {revision: o1.out.revision, draft: o1.out.draft, parked: o1.out.parked}
      let loaded = {key: key, exact: exactProjection, review: reviewProjection, receipt: receiptGate && c1.ok ? c1.out.review_context : null, receiptError: receiptGate && !c1.ok ? "no_review_snapshot" : null, state: stateProjection}
      details = ([loaded] + details.filter(d => d.key != key)).take(6)
      loadErrors = remove(loadErrors, key)
    } else {
      loadErrors = set(loadErrors, key, "Refresh failed; showing the last complete copy when one exists.")
    }
    d1active = false
  }

  on e2 { if d2active { d2exactDone = true } }
  on r2 { if d2active { d2reviewDone = true } }
  on c2 { if d2active { d2receiptDone = true } }
  on o2 { if d2active { d2stateDone = true } }
  when d2active && d2exactDone && d2stateDone && (d2.key.kind == "ask" || (d2reviewDone && ((d2.tool_name != "onec_receipt_create" && d2.tool_name != "onec_receipt_update" && d2.tool_name != "onec_receipt_update_edited") || d2receiptDone))) {
    let key = toJson({account: account, key: d2.key})
    let receiptGate = d2.key.kind == "gate" && (d2.tool_name == "onec_receipt_create" || d2.tool_name == "onec_receipt_update" || d2.tool_name == "onec_receipt_update_edited")
    let bound = e2.out.id == d2.key.id && e2.out.pack == d2.key.pack && o2.out.kind == d2.key.kind && o2.out.item_id == d2.key.id && (d2.key.kind == "ask" || r2.out.gate_id == d2.key.id) && (!receiptGate || !c2.ok || c2.out.gate_id == d2.key.id)
    if e2.ok && o2.ok && (d2.key.kind == "ask" || r2.ok) && (!receiptGate || c2.ok || c2.code == 404) && bound {
      let rawMail = d2.key.kind == "gate" ? r2.out.mail : null
      let mailProjection = rawMail == null ? null : {subject: rawMail.subject, to: rawMail.to, cc: rawMail.cc, bcc: rawMail.bcc, body_plain: rawMail.body_plain, attachments: (rawMail.attachments ?? []).map(a => {filename: a.filename, content_type: a.content_type, size: a.size})}
      let exactProjection = d2.key.kind == "gate" ? {id: e2.out.id, pack: e2.out.pack, status: e2.out.status, preview_gfm: e2.out.preview_gfm, tool_name: e2.out.tool_name, submitted_at: e2.out.submitted_at, input: receiptGate ? e2.out.input : null} : {id: e2.out.id, pack: e2.out.pack, status: e2.out.status, header: e2.out.header, question: e2.out.question, options: (e2.out.options ?? []).map(o => {label: o.label, description: o.description}), multi: e2.out.multi, kind: e2.out.kind, created_at: e2.out.created_at}
      let reviewProjection = d2.key.kind == "gate" ? {review_state: r2.out.review_state, review_error: r2.out.review_error, mail: mailProjection} : null
      let stateProjection = {revision: o2.out.revision, draft: o2.out.draft, parked: o2.out.parked}
      let loaded = {key: key, exact: exactProjection, review: reviewProjection, receipt: receiptGate && c2.ok ? c2.out.review_context : null, receiptError: receiptGate && !c2.ok ? "no_review_snapshot" : null, state: stateProjection}
      details = ([loaded] + details.filter(d => d.key != key)).take(6)
      loadErrors = remove(loadErrors, key)
    } else {
      loadErrors = set(loadErrors, key, "Refresh failed; showing the last complete copy when one exists.")
    }
    d2active = false
  }

  on e3 { if d3active { d3exactDone = true } }
  on r3 { if d3active { d3reviewDone = true } }
  on c3 { if d3active { d3receiptDone = true } }
  on o3 { if d3active { d3stateDone = true } }
  when d3active && d3exactDone && d3stateDone && (d3.key.kind == "ask" || (d3reviewDone && ((d3.tool_name != "onec_receipt_create" && d3.tool_name != "onec_receipt_update" && d3.tool_name != "onec_receipt_update_edited") || d3receiptDone))) {
    let key = toJson({account: account, key: d3.key})
    let receiptGate = d3.key.kind == "gate" && (d3.tool_name == "onec_receipt_create" || d3.tool_name == "onec_receipt_update" || d3.tool_name == "onec_receipt_update_edited")
    let bound = e3.out.id == d3.key.id && e3.out.pack == d3.key.pack && o3.out.kind == d3.key.kind && o3.out.item_id == d3.key.id && (d3.key.kind == "ask" || r3.out.gate_id == d3.key.id) && (!receiptGate || !c3.ok || c3.out.gate_id == d3.key.id)
    if e3.ok && o3.ok && (d3.key.kind == "ask" || r3.ok) && (!receiptGate || c3.ok || c3.code == 404) && bound {
      let rawMail = d3.key.kind == "gate" ? r3.out.mail : null
      let mailProjection = rawMail == null ? null : {subject: rawMail.subject, to: rawMail.to, cc: rawMail.cc, bcc: rawMail.bcc, body_plain: rawMail.body_plain, attachments: (rawMail.attachments ?? []).map(a => {filename: a.filename, content_type: a.content_type, size: a.size})}
      let exactProjection = d3.key.kind == "gate" ? {id: e3.out.id, pack: e3.out.pack, status: e3.out.status, preview_gfm: e3.out.preview_gfm, tool_name: e3.out.tool_name, submitted_at: e3.out.submitted_at, input: receiptGate ? e3.out.input : null} : {id: e3.out.id, pack: e3.out.pack, status: e3.out.status, header: e3.out.header, question: e3.out.question, options: (e3.out.options ?? []).map(o => {label: o.label, description: o.description}), multi: e3.out.multi, kind: e3.out.kind, created_at: e3.out.created_at}
      let reviewProjection = d3.key.kind == "gate" ? {review_state: r3.out.review_state, review_error: r3.out.review_error, mail: mailProjection} : null
      let stateProjection = {revision: o3.out.revision, draft: o3.out.draft, parked: o3.out.parked}
      let loaded = {key: key, exact: exactProjection, review: reviewProjection, receipt: receiptGate && c3.ok ? c3.out.review_context : null, receiptError: receiptGate && !c3.ok ? "no_review_snapshot" : null, state: stateProjection}
      details = ([loaded] + details.filter(d => d.key != key)).take(6)
      loadErrors = remove(loadErrors, key)
    } else {
      loadErrors = set(loadErrors, key, "Refresh failed; showing the last complete copy when one exists.")
    }
    d3active = false
  }

  when dispatch >= 0 {
    if dispatch == 0 {
      let t = tgt0
      if t.action == "allow" || t.action == "deny" {
        res0 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/decide", {verdict: t.action, reasoning: t.action == "deny" ? t.draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "answer" {
        res0 = post("${api}/api/swarms/${enc(t.item.key.pack)}/asks/${enc(t.item.key.id)}/answer", {answer: t.answer}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "save" {
        res0 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, draft: t.draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "skip" {
        res0 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "prepare" {
        res0 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      }
    }
    else if dispatch == 1 {
      let t = tgt1
      if t.action == "allow" || t.action == "deny" {
        res1 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/decide", {verdict: t.action, reasoning: t.action == "deny" ? t.draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "answer" {
        res1 = post("${api}/api/swarms/${enc(t.item.key.pack)}/asks/${enc(t.item.key.id)}/answer", {answer: t.answer}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "save" {
        res1 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, draft: t.draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "skip" {
        res1 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "prepare" {
        res1 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      }
    }
    else if dispatch == 2 {
      let t = tgt2
      if t.action == "allow" || t.action == "deny" {
        res2 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/decide", {verdict: t.action, reasoning: t.action == "deny" ? t.draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "answer" {
        res2 = post("${api}/api/swarms/${enc(t.item.key.pack)}/asks/${enc(t.item.key.id)}/answer", {answer: t.answer}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "save" {
        res2 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, draft: t.draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "skip" {
        res2 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "prepare" {
        res2 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      }
    }
    else if dispatch == 3 {
      let t = tgt3
      if t.action == "allow" || t.action == "deny" {
        res3 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/decide", {verdict: t.action, reasoning: t.action == "deny" ? t.draft.reason : null}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "answer" {
        res3 = post("${api}/api/swarms/${enc(t.item.key.pack)}/asks/${enc(t.item.key.id)}/answer", {answer: t.answer}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      } else if t.action == "save" {
        res3 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, draft: t.draft}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "skip" {
        res3 = post("${api}/api/swarms/${enc(t.item.key.pack)}/operator-state/${enc(t.item.key.kind)}/${enc(t.item.key.id)}", {expected_revision: t.expected, parked: true}, {Authorization: "Bearer ${token}", Accept: "application/json"}, method: "PATCH")
      } else if t.action == "prepare" {
        res3 = post("${api}/api/swarms/${enc(t.item.key.pack)}/gates/${enc(t.item.key.id)}/review/prepare", {}, {Authorization: "Bearer ${token}", Accept: "application/json"})
      }
    }
    dispatch = -1
  }

  on res0 {
    let t = tgt0
    if t != null && live0 {
      let key = t.id
      if res0.ok {
        if t.action == "save" {
          details = details.map(d => d.key == key ? merge(d, {state: {revision: res0.out.revision, draft: res0.out.draft, parked: res0.out.parked}}) : d)
        }
        if t.action == "allow" || t.action == "deny" || t.action == "answer" {
          if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
        }
        conflicts = remove(conflicts, key)
        itemErrors = remove(itemErrors, key)
        res0 = null
        tgt0 = null
        live0 = false
      } else {
        itemErrors = set(itemErrors, key, {action: t.action, code: res0.code, message: res0.code == -1 ? "No response; outcome unknown. Check before any new decision." : res0.code == 409 ? "Changed elsewhere; your local draft is retained." : "Request failed. Reopen and check the exact item."})
        if res0.code == 409 {
          if t.action == "save" {
            let server = res0.out.detail.current
            conflicts = set(conflicts, key, {server: server, local: t.draft})
            if server != null { details = details.map(d => d.key == key ? merge(d, {state: server}) : d) }
          } else {
            conflicts = set(conflicts, key, {resolved: true, local: t.draft})
          }
        }
      }
    }
  }

  on res1 {
    let t = tgt1
    if t != null && live1 {
      let key = t.id
      if res1.ok {
        if t.action == "save" {
          details = details.map(d => d.key == key ? merge(d, {state: {revision: res1.out.revision, draft: res1.out.draft, parked: res1.out.parked}}) : d)
        }
        if t.action == "allow" || t.action == "deny" || t.action == "answer" {
          if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
        }
        conflicts = remove(conflicts, key)
        itemErrors = remove(itemErrors, key)
        res1 = null
        tgt1 = null
        live1 = false
      } else {
        itemErrors = set(itemErrors, key, {action: t.action, code: res1.code, message: res1.code == -1 ? "No response; outcome unknown. Check before any new decision." : res1.code == 409 ? "Changed elsewhere; your local draft is retained." : "Request failed. Reopen and check the exact item."})
        if res1.code == 409 {
          if t.action == "save" {
            let server = res1.out.detail.current
            conflicts = set(conflicts, key, {server: server, local: t.draft})
            if server != null { details = details.map(d => d.key == key ? merge(d, {state: server}) : d) }
          } else {
            conflicts = set(conflicts, key, {resolved: true, local: t.draft})
          }
        }
      }
    }
  }

  on res2 {
    let t = tgt2
    if t != null && live2 {
      let key = t.id
      if res2.ok {
        if t.action == "save" {
          details = details.map(d => d.key == key ? merge(d, {state: {revision: res2.out.revision, draft: res2.out.draft, parked: res2.out.parked}}) : d)
        }
        if t.action == "allow" || t.action == "deny" || t.action == "answer" {
          if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
        }
        conflicts = remove(conflicts, key)
        itemErrors = remove(itemErrors, key)
        res2 = null
        tgt2 = null
        live2 = false
      } else {
        itemErrors = set(itemErrors, key, {action: t.action, code: res2.code, message: res2.code == -1 ? "No response; outcome unknown. Check before any new decision." : res2.code == 409 ? "Changed elsewhere; your local draft is retained." : "Request failed. Reopen and check the exact item."})
        if res2.code == 409 {
          if t.action == "save" {
            let server = res2.out.detail.current
            conflicts = set(conflicts, key, {server: server, local: t.draft})
            if server != null { details = details.map(d => d.key == key ? merge(d, {state: server}) : d) }
          } else {
            conflicts = set(conflicts, key, {resolved: true, local: t.draft})
          }
        }
      }
    }
  }

  on res3 {
    let t = tgt3
    if t != null && live3 {
      let key = t.id
      if res3.ok {
        if t.action == "save" {
          details = details.map(d => d.key == key ? merge(d, {state: {revision: res3.out.revision, draft: res3.out.draft, parked: res3.out.parked}}) : d)
        }
        if t.action == "allow" || t.action == "deny" || t.action == "answer" {
          if get(drafts, key, null) == t.draft { drafts = remove(drafts, key) }
        }
        conflicts = remove(conflicts, key)
        itemErrors = remove(itemErrors, key)
        res3 = null
        tgt3 = null
        live3 = false
      } else {
        itemErrors = set(itemErrors, key, {action: t.action, code: res3.code, message: res3.code == -1 ? "No response; outcome unknown. Check before any new decision." : res3.code == 409 ? "Changed elsewhere; your local draft is retained." : "Request failed. Reopen and check the exact item."})
        if res3.code == 409 {
          if t.action == "save" {
            let server = res3.out.detail.current
            conflicts = set(conflicts, key, {server: server, local: t.draft})
            if server != null { details = details.map(d => d.key == key ? merge(d, {state: server}) : d) }
          } else {
            conflicts = set(conflicts, key, {resolved: true, local: t.draft})
          }
        }
      }
    }
  }

  component ActionButton(item, label, action, advance = false, enabled = true) {
    Button {
      text: label
      color: enabled && poolFree ? accent : muted
      onTap: {
        if enabled && poolFree {
          let slot = tgt0 == null ? 0 : tgt1 == null ? 1 : tgt2 == null ? 2 : 3
          let next = nextItem
          let expected = action == "save" || action == "skip" ? serverState.revision : null
          let target = {id: toJson({account: account, key: item.key}), item: item, action: action, draft: action == "skip" || action == "prepare" ? blank : draft, answer: action == "answer" ? answerText : "", expected: expected}
          if slot == 0 { tgt0 = target; live0 = true; res0 = null }
          else if slot == 1 { tgt1 = target; live1 = true; res1 = null }
          else if slot == 2 { tgt2 = target; live2 = true; res2 = null }
          else { tgt3 = target; live3 = true; res3 = null }
          dispatch = slot
          itemErrors = remove(itemErrors, target.id)
          if advance {
            hidden = unique(hidden + [item.key])
            current = next
            currentDetailSlot = -1
            startupOpen = false
            openRequest = next
            tab = "review"
          }
        }
      }
    }
  }

  component Pairing() {
    Column {
      gap: 12
      weight: 1
      Text { text: "CDM review"; style: title; color: accent }
      Text { text: "Native gate and question review. Pair this surface with your CDM account in your normal browser; no token or cookie is copied."; color: muted }
      if !pairing {
        Button {
          text: pairStarting ? "Starting…" : "Pair this device"
          color: pairStarting ? muted : accent
          onTap: {
            if !pairStarting {
              pairing = true
              pairStarting = true
              pairStatus = "Starting a five-minute browser challenge…"
              pairStart = post("${api}/auth/native/start", {device_kind: "phone", device_name: "CDM review face"}, {Accept: "application/json"})
            }
          }
        }
      } else {
        if pairRequest != null {
          Text { text: "Matching code"; style: muted }
          Text { text: pairRequest.user_code; style: huge; color: accent }
          Text { text: "In the browser, confirm this exact code for the same CDM operator account. Fresh sign-in and consent happen there." }
          Button { text: "Open browser consent"; onTap: url(pairRequest.verification_uri) }
        }
        Text { text: pairStatus; color: muted }
        Button { text: "Cancel pairing"; color: muted; onTap: { pairing = false; pairToken = null; pairRequest = null; pairStatus = "" } }
      }
    }
  }

  component QueueStatus() {
    Column {
      gap: 2
      if q == null && lastQueue == null { Text { text: "Loading queue…"; color: muted } }
      if q != null && !q.ok { Text { text: lastQueue == null ? "Queue unavailable — not empty." : "Offline/stale copy — actions paused."; color: red } }
      if q != null && q.ok && !q.out.complete { Text { text: "Partial queue: ${join(q.out.unavailable_packs, ", ")} unavailable. Counts are lower bounds — not done."; color: yellow } }
      if queue != null && queue.next_cursor != null { Text { text: "This native page is bounded; ${queue.total} known reviews. More pages remain in the full app."; color: muted } }
      if detailPoolFull { Text { text: "All detail slots are still loading. Reopen/check an item or wait; nothing was dropped."; color: yellow } }
      if !poolFree { Text { text: "All four action slots need reconciliation. New actions pause visibly; no tap is silently dropped."; color: yellow } }
    }
  }

  component ReviewScreen() {
    Column {
      fill: width
      weight: 1
      gap: 10
      if token == null || pairing {
        Pairing { }
      } else {
        Row {
          Text { text: "CDM review"; style: title; color: accent; weight: 1 }
          Text { text: "↻"; style: title; color: accent; padding: [8, 4]; onTap: refresh() }
        }
        Text { text: queue == null ? "Count unknown" : "${queue.total} reviews · ${queue.problem_count} problems · ${activityCount} requests"; color: muted }
        QueueStatus { }
        if q != null && q.code == 401 {
          Text { text: "Device authorization expired or was revoked. Successful re-pairing clears this surface's local cache and unsent drafts; server drafts remain." ; color: yellow }
          Button {
            text: activityCount > 0 || detailActive.any(a => a) ? "Reconcile outstanding reads/writes before re-pairing" : "Re-pair / reset local copy"
            color: activityCount > 0 || detailActive.any(a => a) ? muted : accent
            onTap: {
              if activityCount == 0 && !detailActive.any(a => a) && !pairStarting {
                pairing = true
                pairStarting = true
                pairStatus = "Starting a five-minute browser challenge…"
                pairStart = post("${api}/auth/native/start", {device_kind: "phone", device_name: "CDM review face"}, {Accept: "application/json"})
              }
            }
          }
        }
        Flow {
          gap: 8
          Text { text: "Review"; padding: [4, 10]; background: tab == "review" ? accent : surface; color: tab == "review" ? background : foreground; onTap: tab = "review" }
          Text { text: "Problems ${(queue ?? {}).problem_count ?? 0}"; padding: [4, 10]; background: tab == "problems" ? accent : surface; color: tab == "problems" ? background : foreground; onTap: tab = "problems" }
          Text { text: "Requests ${activityCount}"; padding: [4, 10]; background: tab == "activity" ? accent : surface; color: tab == "activity" ? background : foreground; onTap: tab = "activity" }
        }
        if tab == "problems" {
          Column {
            scroll: true
            weight: 1
            gap: 8
            if queue == null || len((queue.problems ?? [])) == 0 { Text { text: q != null && q.ok && q.out.complete ? "No known preparation problems." : "Problem state unknown while the queue is unavailable."; color: muted } }
            for p in (queue ?? {}).problems ?? [] key toJson(p.key) {
              Column {
                gap: 5
                padding: 10
                background: surface
                Text { text: p.title; fontWeight: 600 }
                Text { text: "${p.review_state}: ${p.review_error.message}"; color: yellow }
                Text { text: "Approval stays unavailable until the exact review is ready."; style: small; color: muted }
                Flow {
                  if p.retry_prepare { ActionButton { item: p; label: "Retry preparation"; action: "prepare"; enabled: q != null && q.ok && contains(q.out.unavailable_packs ?? [], p.key.pack) == false && !targets.any(t => t != null && t.item.key == p.key) } }
                  Button { text: "Open full app"; onTap: url("${api}/#/${enc(p.key.kind)}/${enc(p.key.pack)}/${enc(p.key.id)}") }
                }
              }
            }
          }
        } else if tab == "activity" {
          Column {
            scroll: true
            weight: 1
            gap: 8
            if activityCount == 0 { Text { text: "No outstanding or unreconciled requests."; color: muted } }
            for r, i in results {
              if targets[i] != null {
                Column {
                  gap: 5
                  padding: 10
                  background: surface
                  Text { text: "${targets[i].item.title} · ${targets[i].action}"; fontWeight: 600 }
                  Text {
                    text: r == null ? lives[i] ? "Request outstanding; the queue advanced optimistically." : "Restored request: outcome unknown. CHECK ONLY — it will never be resent automatically." : r.ok ? "Confirmed" : "Late failure: ${get(itemErrors, targets[i].id, {}).message ?? "reopen and check"}"
                    color: r != null && !r.ok ? red : r == null && !lives[i] ? yellow : muted
                  }
                  Flow {
                    Button {
                      text: r == null && !lives[i] ? "Reopen / check only" : "Reopen / check"
                      onTap: {
                        current = targets[i].item
                        currentDetailSlot = -1
                        startupOpen = false
                        openRequest = targets[i].item
                        hidden = hidden.filter(k => k != targets[i].item.key)
                        tab = "review"
                      }
                    }
                    Button { text: "Full app"; onTap: url("${api}/#/review/${enc(targets[i].item.key.kind)}/${enc(targets[i].item.key.pack)}/${enc(targets[i].item.key.id)}") }
                    Button {
                      text: "Clear after check"
                      color: muted
                      onTap: {
                        hidden = hidden.filter(k => k != targets[i].item.key)
              if i == 0 { res0 = null; tgt0 = null; live0 = false }
              else if i == 1 { res1 = null; tgt1 = null; live1 = false }
              else if i == 2 { res2 = null; tgt2 = null; live2 = false }
              else if i == 3 { res3 = null; tgt3 = null; live3 = false }
                      }
                    }
                  }
                }
              }
            }
          }
        } else {
          if current == null {
            Column {
              weight: 1
              gap: 10
              Text {
                text: activityCount > 0 ? "Queue advanced. Requests still need confirmation/check; this is not a background-delivery claim." : q != null && q.ok && !q.out.complete ? "Some packs are unavailable. The visible page is empty, not the fleet." : queue != null && queue.next_cursor != null ? "This page is complete; more reviews remain in the full app." : "No visible ready reviews."
                style: title
              }
              if len(visibleItems) > 0 {
                Button { text: "Review next (${len(visibleItems)} on this page)"; onTap: { current = visibleItems[0]; currentDetailSlot = -1; startupOpen = false; openRequest = visibleItems[0] } }
              }
              Button { text: "Open full app"; onTap: url(api) }
              Button { text: "Requests / problems"; color: muted; onTap: tab = activityCount > 0 ? "activity" : "problems" }
            }
          } else {
            Row {
              Text { text: "${current.key.pack} · ${current.key.kind} #${current.key.id}"; style: small; color: muted; weight: 1 }
              Text { text: currentIndex >= 0 ? "${currentIndex + 1}/${queue.total}" : "exact item"; style: small; color: muted }
            }
            Column {
              scroll: true
              weight: 1
              gap: 10
              Text { text: current.title; style: title; fontWeight: 600 }
              if currentError != null { Text { text: currentError.message; color: red } }
              if currentLoadError != null { Text { text: currentLoadError; color: yellow } }
              if entry == null || currentDetailSlot < 0 || detailActive[currentDetailSlot] {
                Text { text: entry == null ? "Loading exact review…" : "Refreshing exact review; cached copy remains read-only until loaded."; color: muted }
              }
              if entry != null {
                if current.key.kind == "gate" {
                  if isReceipt {
                    Text { text: "Receipt proposal — complete canonical input"; style: small; color: muted }
                    if exact.input == null {
                      Text { text: "Canonical input unavailable. Native approval is disabled; use the full app."; color: yellow }
                    } else {
                      Text { text: toJson(exact.input) }
                      Row { Button { text: "Copy complete proposal"; color: muted; onTap: copy(toJson(exact.input)) } }
                    }
                    if receipt == null {
                      Text { text: "Receipt comparison unavailable (no stored snapshot). Native approval is disabled; open the full app."; color: yellow }
                    } else {
                      Text { text: "Stored receipt context · ${receipt.captured_at}"; style: small; color: muted }
                      if receipt.record != null { Text { text: "${receipt.record.title} · ${receipt.record.short_id}\n${receipt.record.id}" } }
                      Text { text: "Source: ${receipt.source.status}${receipt.source.filename != null ? " · ${receipt.source.filename}" : ""}${receipt.source.size != null ? " · ${fmtBytes(receipt.source.size)}" : ""}${receipt.source.sha256 != null ? "\nSHA-256 ${receipt.source.sha256}" : ""}${receipt.source.message != null ? "\n${receipt.source.message}" : ""}" }
                      Text { text: "Verified references (${len(keys(receipt.references ?? {}))})"; style: small; color: muted }
                      for ref in keys(receipt.references ?? {}) {
                        Text { text: "${ref}\n${toJson(receipt.references[ref])}" }
                      }
                      for warning in receipt.warnings ?? [] { Text { text: "⚠ ${warning}"; color: yellow } }
                      Row {
                        Button { text: "Copy receipt context"; color: muted; onTap: copy(toJson(receipt)) }
                        Button { text: "Original document (browser)"; color: muted; onTap: url("${api}/api/swarms/${enc(current.key.pack)}/gates/${enc(current.key.id)}/receipt/source") }
                      }
                    }
                  } else if mail != null {
                    Text { text: "Subject: ${mail.subject}"; fontWeight: 600 }
                    Text { text: "To: ${recipients}" }
                    if cc != "" { Text { text: "Cc: ${cc}" } }
                    if bcc != "" { Text { text: "Bcc: ${bcc}" } }
                    Text { text: "Complete body + signature text"; style: small; color: muted }
                    Text { text: mail.body_plain ?? "" }
                    Row {
                      Button { text: "Copy complete text"; color: muted; onTap: copy(mail.body_plain ?? "") }
                    }
                    for a, i in mail.attachments ?? [] {
                      Button {
                        text: "Attachment: ${a.filename} (${fmtBytes(a.size)})"
                        color: muted
                        onTap: url("${api}/api/swarms/${enc(current.key.pack)}/gates/${enc(current.key.id)}/draft/attachments/${int(i)}")
                      }
                    }
                  } else {
                    Text { text: "Gate proposal"; style: small; color: muted }
                    Text { text: exact.preview_gfm ?? current.title }
                  }
                  if exact.status != "pending" { Text { text: "Resolved elsewhere (${exact.status}). Your unsent draft is retained."; color: yellow } }
                  if review.review_state != "ready" { Text { text: "Review is not ready; approval and rejection stay disabled."; color: yellow } }
                  Input {
                    text: draft.reason
                    placeholder: "Rejection reason (required to reject)"
                    onChange: drafts = set(drafts, currentId, merge(draft, {reason: value, mode: trim(value) != "" ? "deny" : "normal"}))
                  }
                } else {
                  Text { text: exact.header ?? "Question"; fontWeight: 600 }
                  Text { text: exact.question ?? "" }
                  if exact.status != "pending" { Text { text: "Answered elsewhere. Your unsent draft is retained."; color: yellow } }
                  for option, i in options {
                    Button {
                      text: "${contains(draft.picks, i) ? "✓" : "○"} ${option.label}${option.description != null ? " — ${option.description}" : ""}"
                      color: contains(draft.picks, i) ? accent : muted
                      onTap: drafts = set(drafts, currentId, merge(draft, {picks: exact.multi ? (contains(draft.picks, i) ? draft.picks.filter(p => p != i) : (draft.picks + [i]).sort()) : [i]}))
                    }
                  }
                  Input {
                    text: draft.text
                    placeholder: "Answer / additional detail"
                    onChange: drafts = set(drafts, currentId, merge(draft, {text: value}))
                  }
                  if len(answerText) > 4000 { Text { text: "Answer exceeds 4000 characters; shorten it before sending."; color: red } }
                }
                if currentConflict != null {
                  Column {
                    gap: 5
                    padding: 8
                    background: surface
                    Text { text: currentConflict.resolved == true ? "Resolved elsewhere. Your local unsent copy is still below." : "Server draft changed elsewhere. Both copies are retained; choose explicitly."; color: yellow }
                    if currentConflict.server != null {
                      Button {
                        text: "Use server copy (discard mine)"
                        color: muted
                        onTap: {
                          drafts = currentConflict.server.draft == null ? remove(drafts, currentId) : set(drafts, currentId, merge(blank, currentConflict.server.draft))
                          details = details.map(d => d.key == currentId ? merge(d, {state: currentConflict.server}) : d)
                          conflicts = remove(conflicts, currentId)
                        }
                      }
                    }
                  }
                }
              }
            }
            Flow {
              gap: 8
              ActionButton { item: current; label: "Save draft"; action: "save"; enabled: canWrite }
              if current.key.kind == "gate" {
                ActionButton { item: current; label: "Approve"; action: "allow"; advance: true; enabled: gateReady }
                ActionButton { item: current; label: "Reject"; action: "deny"; advance: true; enabled: gateReady && trim(draft.reason) != "" && len(draft.reason) <= 4000 }
              } else {
                ActionButton { item: current; label: "Answer"; action: "answer"; advance: true; enabled: askReady && trim(answerText) != "" && len(answerText) <= 4000 }
              }
              ActionButton { item: current; label: "Skip"; action: "skip"; advance: true; enabled: canWrite && exact.status == "pending" }
              Button {
                text: "Next"
                color: muted
                onTap: {
                  current = nextItem
                  currentDetailSlot = -1
                  startupOpen = false
                  openRequest = nextItem
                }
              }
              Button { text: "Quick full app"; color: muted; onTap: url("${api}/#/review/${enc(current.key.kind)}/${enc(current.key.pack)}/${enc(current.key.id)}") }
              Button { text: "Full app escape"; color: muted; onTap: url("${api}/#/${enc(current.key.kind)}/${enc(current.key.pack)}/${enc(current.key.id)}") }
            }
          }
        }
      }
    }
  }


  Column {
    fill: width
    weight: 1
    padding: [12, 8]
    ReviewScreen { }
    Spacer { height: screenInset }
  }
}
