EDITIONS = {code: hl for code, hl, _, _ in EDITION_LIST}
SECTIONS = ["TOP", "WORLD", "NATION", "BUSINESS", "TECHNOLOGY", "SCIENCE", "HEALTH", "SPORTS", "ENTERTAINMENT"]
LISTS = ("sections", "include", "exclude", "blocked")


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, obj, indent=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, ensure_ascii=False, indent=indent)
        f.write("\n" if indent else "")
    os.replace(tmp, path)


def settings():
    s = dict(DEFAULTS)
    s.update({k: v for k, v in load(CONF, {}).items() if k in DEFAULTS})
    if s["edition"] not in EDITIONS:
        s["edition"] = DEFAULTS["edition"]
    s["sections"] = [x for x in s["sections"] if x in SECTIONS]
    if not s["sections"] and not s["include"]:
        s["sections"] = ["WORLD"]
    return s


# What the fetched stories depend on; the reader's settings don't count.
FETCHED = ("edition", "sections", "include", "exclude", "blocked", "limit", "maxAge")


def settings_key(s):
    keep = {k: s[k] for k in FETCHED}
    return hashlib.sha1(json.dumps(keep, sort_keys=True).encode()).hexdigest()[:12]


def edition_query(s):
    gl = s["edition"].split(":")[0]
    return f"hl={EDITIONS[s['edition']]}&gl={gl}&ceid={s['edition']}"


HEADERS = {"User-Agent": UA, "Accept-Language": "en-US,en;q=0.9,ar;q=0.8",
           "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
           "Accept-Encoding": "gzip"}


def get(url, data=None, timeout=25, limit=4 << 20):
    headers = dict(HEADERS)
    if data is not None:
        headers["Content-Type"] = "application/x-www-form-urlencoded;charset=UTF-8"
        data = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=data, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read(limit)
        if r.headers.get("Content-Encoding") == "gzip":
            body = gzip.decompress(body) if len(body) < limit else gzip.GzipFile(fileobj=io.BytesIO(body)).read(limit)
        charset = r.headers.get_content_charset()
        final = r.geturl()
    if not charset:
        m = re.search(rb'<meta[^>]+charset=["\']?([\w-]+)', body[:4096], re.I)
        charset = m.group(1).decode() if m else "utf-8"
    try:
        return final, body.decode(charset, "replace")
    except LookupError:
        return final, body.decode("utf-8", "replace")


# --- Google News ---------------------------------------------------------------------------------

def decode_many(aids):
    \"\"\"{article id: publisher's address}. The ids are encrypted; Google News' own page turns them into
    addresses through its batchexecute API, each signed with a token from the article's /rss/ page
    (which Google limits far less). One batchexecute call takes them all: Google limits those calls.\"\"\"
    reqs = []
    for k, aid in enumerate(aids):
        if k:
            time.sleep(0.3)
        _, page = get(f"https://news.google.com/rss/articles/{aid}", timeout=10)
        sg = re.search(r'data-n-a-sg="([^"]+)"', page).group(1)
        ts = re.search(r'data-n-a-ts="([^"]+)"', page).group(1)
        req = ["garturlreq", [["X", "X", ["X", "X"], None, None, 1, 1, "US:en", None, 1, None, None, None, None, None, 0, 1],
                              "X", "X", 1, [1, 1, 1], 1, 1, None, 0, 0, None, 0], aid, int(ts), sg]
        reqs.append(["Fbv4je", json.dumps(req), None, str(k)])
    _, resp = get("https://news.google.com/_/DotsSplashUi/data/batchexecute", {"f.req": json.dumps([reqs])}, timeout=15)
    urls = {}
    for line in resp.splitlines():
        if line.startswith("[["):
            for e in json.loads(line):
                if e[0] == "wrb.fr" and e[2]:
                    url = json.loads(e[2])[1]
                    if url.startswith(("https://", "http://")):
                        urls[aids[int(e[-1])]] = url
    return urls


def decode(aid):
    url = decode_many([aid]).get(aid)
    if not url:
        raise ValueError("not a link")
    return url


def images_by_id(page):
    # Each story card starts with jsdata="oM6qxc;<article id>;..." and holds its picture as
    # <img ... src="/api/attachments/<image id>-w350-h175-...">.
    imgs = {}
    for part in page.split('jsdata="oM6qxc;')[1:]:
        aid = part.split(";", 1)[0]
        m = re.search(r'src="/api/attachments/([A-Za-z0-9_\-]+=*)-w\d+', part)
        if m and aid not in imgs:
            imgs[aid] = "https://news.google.com/api/attachments/" + m.group(1) + "-w600-h338-p-df"
    return imgs


RELATED = re.compile(r'<a href="https://news\.google\.com/rss/articles/([^"?]+)[^"]*"[^>]*>(.*?)</a>(?:&nbsp;|\s)*'
                     r'<font[^>]*>(.*?)</font>', re.S)


def parse_feed(xml, tag):
    items = []
    for it in ET.fromstring(xml).iter("item"):
        aid = (it.findtext("guid") or "").strip()
        title = html.unescape(it.findtext("title") or "").strip()
        src = it.find("source")
        source = (src.text or "").strip() if src is not None else ""
        if source and title.endswith(" - " + source):
            title = title[: -len(source) - 3]
        if not aid or not title:
            continue
        try:
            t = int(email.utils.parsedate_to_datetime(it.findtext("pubDate")).timestamp())
        except Exception:
            t = None
        # A story Google groups with others lists them: the same news from other publishers, for
        # when this one won't let its page be read.
        related = [{"id": r, "title": html.unescape(re.sub("<[^>]+>", "", a)).strip(), "source": html.unescape(f).strip()}
                   for r, a, f in RELATED.findall(it.findtext("description") or "") if r != aid][:4]
        items.append({"id": aid, "title": title, "source": source, "site": src.get("url") if src is not None else None,
                      "time": t, "img": None, "url": None, "tag": tag, "related": related})
    return items


def fetch_all(s, known, force):
    ed = edition_query(s)
    feeds = []  # (tag, rss url, web page with the pictures, or None)
    for sec in s["sections"]:
        if sec == "TOP":
            feeds.append(("TOP", f"https://news.google.com/rss?{ed}", f"https://news.google.com/home?{ed}"))
        else:
            feeds.append((sec, f"https://news.google.com/rss/headlines/section/topic/{sec}?{ed}", "page"))
    when = f" when:{max(1, s['maxAge'])}h" if s["maxAge"] else ""
    for kw in s["include"]:
        q = urllib.parse.quote(kw + when)
        feeds.append(("#" + kw, f"https://news.google.com/rss/search?q={q}&{ed}", None))
    # A feed fetched within the refresh period is taken from its cache; forced, within the last 2 minutes.
    # The rest are fetched three at a time, each a second after the one before: one after another
    # took a minute or more with a dozen sections and keywords, and Google refuses quicker bursts.
    def one(k, tag, rss, page):
        time.sleep(k)  # k: how many fetches are under way before this one, in seconds
        final, xml = get(rss)
        items = parse_feed(xml, tag)
        if page:
            # A section's feed redirects to its topic; the same address without /rss is its page.
            page = final.replace("/rss/", "/", 1) if page == "page" else page
            time.sleep(1)
            try:
                imgs = images_by_id(get(page)[1])
                for i in items:
                    i["img"] = imgs.get(i["id"])
            except Exception:
                pass  # headlines without pictures beat no headlines
        out = {"fetched": int(time.time()), "items": items}
        save(os.path.join(FEEDS, hashlib.sha1(rss.encode()).hexdigest()[:16] + ".json"), out)
        return out

    results, jobs = [], {}
    with concurrent.futures.ThreadPoolExecutor(3) as pool:
        for tag, rss, page in feeds:
            cached = load(os.path.join(FEEDS, hashlib.sha1(rss.encode()).hexdigest()[:16] + ".json"), None)
            fresh = cached and time.time() - cached["fetched"] < (120 if force else max(5, s["refresh"]) * 60 - 20)
            if not fresh:
                jobs[len(results)] = pool.submit(one, min(len(jobs), 2), tag, rss, page)
            results.append((tag, cached, fresh))
    lists, times, errors = [], [], []
    for n, (tag, cached, fresh) in enumerate(results):
        feed = cached
        if not fresh:
            try:
                feed = jobs[n].result()
            except Exception as e:
                errors.append(f"{tag.lstrip('#').lower()}: {e}")
        if feed:  # on an error, the stories it had beat none
            lists.append(feed["items"])
            times.append(feed["fetched"])
    for f in os.listdir(FEEDS):  # feeds not asked for in a week
        if time.time() - os.path.getmtime(os.path.join(FEEDS, f)) > 7 * 86400:
            os.remove(os.path.join(FEEDS, f))
    if not lists:
        raise ValueError(errors[0] if errors else "no feeds")
    # Mixed in turn, each feed in Google's order, so every section and keyword gets the top spots.
    merged, seen = [], set()
    for row in range(max(len(l) for l in lists)):
        for l in lists:
            if row < len(l):
                i = l[row]
                norm = re.sub(r"\W+", " ", i["title"].lower()).strip()
                if i["id"] in seen or norm in seen:
                    continue
                seen.update((i["id"], norm))
                merged.append(dict(i))
    blocked = {b.lower() for b in s["blocked"]}
    excl = [re.compile(r"(?<!\w)" + re.escape(w.lower()) + r"(?!\w)") for w in s["exclude"] if w.strip()]
    oldest = time.time() - s["maxAge"] * 3600 if s["maxAge"] else 0
    items = [i for i in merged
             if i["source"].lower() not in blocked
             and not any(x.search(i["title"].lower()) for x in excl)
             and (not oldest or (i["time"] or 0) >= oldest)]
    for i in items:
        old = known.get(i["id"], {})
        i["img"] = i["img"] or old.get("img")  # pictures found earlier, by the page or the publisher
        i["url"] = old.get("url")  # addresses don't change
    # The face leads with a big picture: the first story that has one goes first.
    lead = next((k for k, i in enumerate(items) if i["img"]), None)
    if lead:
        items.insert(0, items.pop(lead))
    # The stories are as old as the oldest feed they came from.
    return items[: max(1, int(s["limit"]))], errors, min(times)


def update(force, wait=False):
    \"\"\"wait: after a fetch that's running, rather than leave it to that one (a settings change).\"\"\"
    os.makedirs(FEEDS, exist_ok=True)
    if not os.path.exists(EDITIONS_FILE):
        save(EDITIONS_FILE, editions())
    if wait:
        # One waiter is enough: it reads the settings once it has the lock, so taps queued behind it are in.
        queue = open(FEED + ".wait", "w")
        try:
            fcntl.flock(queue, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
    lock = open(FEED + ".lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | (0 if force or wait else fcntl.LOCK_NB))
    except OSError:
        return  # a fetch is running; its result shows when it's done
    if wait:
        queue.close()  # a tap from here on queues the next waiter
    fetching = False
    try:
        # Settings changed during a fetch (several sections tapped in a row): again, for the new ones.
        for _ in range(4):
            s = settings()
            key = settings_key(s)
            cache = load(FEED, {})
            fresh = cache.get("key") == key and time.time() - (cache.get("fetched") or 0) < max(5, s["refresh"]) * 60 - 20
            if not force and (fresh or (cache.get("key") == key and time.time() - (cache.get("tried") or 0) < 120)):
                break
            if not fetching:
                fetching = True
                save(STATUS, {"fetching": True, "since": int(time.time())})
            known = {i["id"]: i for i in cache.get("items", [])}
            try:
                items, errors, fetched = fetch_all(s, known, force)
                out = {"ok": True, "fetched": fetched, "tried": int(time.time()), "key": key,
                       "error": "; ".join(errors)[:160] or None, "items": items}
            except Exception as e:
                # Offline or refused: keep the stories there were, and say so.
                out = dict(cache, ok=False, tried=int(time.time()), error=str(e)[:160])
                out.setdefault("items", [])
            save(FEED, out)
            force = False
    finally:
        if fetching:
            save(STATUS, {"fetching": False, "since": int(time.time())})


def background(*args):
    subprocess.Popen([sys.executable, os.path.abspath(__file__), *args], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def patch_items(found):
    # Into the cache as it is now, which a fetch may have replaced meanwhile.
    cache = load(FEED, {})
    for i in cache.get("items", []):
        for k, v in found.get(i["id"], {}).items():
            if v and not i.get(k):
                i[k] = v
    if cache.get("items"):
        save(FEED, cache)


def page_image(page, base):
    for prop in ("og:image", "twitter:image", "og:image:url"):
        m = (re.search(r'<meta[^>]+(?:property|name)=["\']%s["\'][^>]*content=["\']([^"\']+)' % prop, page, re.I)
             or re.search(r'<meta[^>]+content=["\']([^"\']+)["\'][^>]*(?:property|name)=["\']%s["\']' % prop, page, re.I))
        if m:
            u = urllib.parse.urljoin(base, html.unescape(m.group(1)))
            if u.startswith("https://"):
                return u
    return None


def find_item(aid):
    for i in load(FEED, {}).get("items", []):
        if i["id"] == aid:
            return i
        for r in i.get("related", []):
            if r["id"] == aid:
                return dict(r, site=None, time=i.get("time"), img=None, url=None, tag=i.get("tag"), related=[])
    return None


def story_url(aid, item):
    if item and item.get("url"):
        return item["url"]
    url = decode(aid)
    patch_items({aid: {"url": url}})
    return url


def fallback_url(item):
    # Google refusing to decode: a DuckDuckGo "!ducky" search for the headline goes to the first result.
    site = urllib.parse.urlsplit((item or {}).get("site") or "").hostname or ""
    q = f"!ducky {(item or {}).get('title', '')}" + (f" site:{site.removeprefix('www.')}" if site else "")
    return "https://duckduckgo.com/?q=" + urllib.parse.quote(q)


# --- The reader ----------------------------------------------------------------------------------

# Containers that aren't the story: links to other stories, sharing, sign-ups, ads.
NOT_STORY = re.compile(r"related|recirc|promo|newsletter|share|social|signup|sign-up|subscribe|advert|\bad\b|ad-|"
                       r"-ad\b|sponsor|comment|outbrain|taboola|more-on|read-more|readmore|most-popular|trending|"
                       r"author-bio|byline-image|breadcrumb|toolbar|tags", re.I)
BOILERPLATE = re.compile(r"^(advertisement|share( this)?|read more|sign up|subscribe|follow us|related:?|"
                         r"add .* on google|image source|getty images|watch:|listen:|copy link)\b", re.I)
MAX_IMAGES = 10   # with the list's thumbnails, the face stays under the launcher's 32 images
MAX_BLOCKS = 220  # the screen holds 1000 nodes


def best_src(img, base):
    for a in ("data-src", "data-lazy-src", "data-original", "data-url", "data-hi-res-src"):
        if img.get(a) and not img.get(a).startswith("data:"):
            return urllib.parse.urljoin(base, img.get(a))
    for a in ("srcset", "data-srcset"):
        cands = []
        for c in (img.get(a) or "").split(","):
            parts = c.strip().split()
            if parts:
                w = parts[1][:-1] if len(parts) > 1 and parts[1].endswith("w") else "0"
                cands.append((int(w) if w.isdigit() else 0, parts[0]))
        if cands:
            cands.sort()
            fit = [c for c in cands if c[0] <= 1300] or cands
            return urllib.parse.urljoin(base, fit[-1][1])
    src = img.get("src") or ""
    return urllib.parse.urljoin(base, src) if src and not src.startswith("data:") else None


def img_key(url):
    # The same picture at other sizes or from another folder (BBC's lead 1200/branded_arabic/x.jpg is
    # ace/ws/800/cpsprodpb/x.jpg.webp in the story) has the same file name.
    name = urllib.parse.urlsplit(url or "").path.rsplit("/", 1)[-1].lower()
    return re.sub(r"(\.(jpe?g|png|webp|gif|avif))+$", "", name)


def text_of(el):
    return re.sub(r"\s+", " ", el.text_content()).strip()


def blocks_from(node, base, title, lead):
    \"\"\"The story's paragraphs, headings, quotes, list items and pictures, in order.\"\"\"
    out, imgs, seen_imgs = [], 0, {img_key(lead)} if lead else set()
    norm_title = re.sub(r"\W+", "", title.lower())

    def walk(el):
        nonlocal imgs
        if not isinstance(el.tag, str):
            return
        tag = el.tag.lower()
        cls = f"{el.get('class') or ''} {el.get('id') or ''} {el.get('data-component') or ''}"
        if tag in ("script", "style", "noscript", "nav", "aside", "footer", "form", "button", "svg", "iframe", "header") \
                or (el is not node and NOT_STORY.search(cls)) or el.get("aria-hidden") == "true" or el.get("hidden") is not None:
            return
        if tag in ("figure", "picture") or tag == "img":
            pics = [el] if tag == "img" else list(el.iter("img"))
            cap = el.find(".//figcaption")
            for img in pics[:1]:
                src = best_src(img, base)
                w, h = img.get("width") or "", img.get("height") or ""
                small = w.isdigit() and int(w) < 200 or h.isdigit() and int(h) < 120
                key = img_key(src)
                if src and src.startswith("https://") and not small and key not in seen_imgs and imgs < MAX_IMAGES \
                        and not re.search(r"\.svg|logo|icon|avatar|sprite|pixel|blank|placeholder", src, re.I):
                    seen_imgs.add(key)
                    imgs += 1
                    ratio = round(int(h) / int(w), 3) if w.isdigit() and h.isdigit() and int(w) > 0 else None
                    out.append({"k": "img", "src": src, "cap": text_of(cap) if cap is not None else (img.get("alt") or "").strip(),
                                "ratio": ratio if ratio and 0.3 < ratio < 1.6 else None})
            return
        kind = {"p": "p", "h2": "h", "h3": "h", "h4": "h", "h5": "h", "blockquote": "q", "li": "li", "pre": "p"}.get(tag)
        if kind == "q" or kind == "li" or (kind and not any(c.tag in ("p", "figure", "img", "ul", "ol") for c in el.iter() if c is not el)):
            t = text_of(el)
            # A paragraph with a picture in it: the picture first.
            for img in el.iter("img"):
                walk(img)
            if t and len(t) > 1 and not (len(t) < 60 and BOILERPLATE.search(t)) and re.sub(r"\W+", "", t.lower()) != norm_title:
                out.append({"k": kind, "t": t})
            return
        for c in el:
            walk(c)
        if tag == "div" and not len(el) and el.text and len(el.text.strip()) > 80:
            out.append({"k": "p", "t": re.sub(r"\s+", " ", el.text).strip()})

    walk(node)
    # The same line twice in a row (a pull quote repeating the text) once.
    dedup = [b for k, b in enumerate(out) if not (k and b.get("t") and b.get("t") == out[k - 1].get("t"))]
    return dedup[:MAX_BLOCKS], len(dedup) > MAX_BLOCKS


def extract(page, url, item):
    import lxml.html
    from readability import Document
    doc = lxml.html.fromstring(page)
    meta = lambda *names: next((m for n in names for m in doc.xpath(f'//meta[@property="{n}" or @name="{n}"]/@content') if m.strip()), None)
    lead = page_image(page, url) or item.get("img")
    # Google's headline has the source taken off; a page's own title often ends in " - BBC News عربي".
    title = (item.get("title") or re.sub(r"\s+[-|–—]\s+[^-|–—]{1,40}$", "", meta("og:title") or "")).strip()
    byline = meta("author", "article:author", "parsely-author", "sailthru.author")
    if byline and byline.startswith("http"):
        byline = None
    # Readability finds the story's main block; walking that block in the page as it was keeps the
    # pictures that readability's own output drops.
    d = Document(page, xpath=True, url=url)
    summary = lxml.html.fromstring(d.summary(html_partial=True))
    paths = sorted({e.get("x") for e in summary.iter() if isinstance(e.tag, str) and e.get("x")}, key=lambda p: p.count("/"))
    tree = doc.getroottree()
    blocks, cut = [], False
    for p in paths:
        if p.count("/") > paths[0].count("/"):
            break
        found = tree.xpath(p)
        if found:
            b, c = blocks_from(found[0], url, title, lead)
            blocks += b
            cut = cut or c
    words = sum(len(b.get("t", "").split()) for b in blocks)
    return {"title": title or item.get("title"), "byline": byline, "lead": lead, "blocks": blocks,
            "words": words, "cut": cut, "desc": meta("og:description", "description")}


def article(aid):
    if not aid:
        print("null")
        return
    os.makedirs(ARTICLES, exist_ok=True)
    now = time.time()
    for f in os.listdir(ARTICLES):  # a week's stories are kept
        p = os.path.join(ARTICLES, f)
        if now - os.path.getmtime(p) > 7 * 86400:
            os.remove(p)
    path = os.path.join(ARTICLES, hashlib.sha1(aid.encode()).hexdigest()[:16] + ".json")
    cached = load(path, None)
    # A story read is kept; a page that refused is asked again after 10 minutes.
    if cached and (cached.get("ok") or cached.get("url") and now - os.path.getmtime(path) < 600):
        if cached.get("lead") and not (find_item(aid) or {"img": True}).get("img"):
            patch_items({aid: {"img": cached["lead"]}})
        print(json.dumps(cached, ensure_ascii=False))
        return
    item = find_item(aid) or {"id": aid, "title": "", "source": "", "related": []}
    out = {"id": aid, "ok": False, "title": item.get("title"), "source": item.get("source"), "time": item.get("time"),
           "lead": item.get("img"), "byline": None, "blocks": [], "words": 0, "cut": False, "short": False,
           "desc": None, "url": None, "error": None, "related": item.get("related", [])}
    try:
        out["url"] = story_url(aid, item)
    except urllib.error.HTTPError as e:
        out["error"] = "Google News is limiting requests; try again in a minute" if e.code == 429 else f"Google News: {e}"
    except Exception as e:
        out["error"] = f"couldn't find the story's address ({str(e)[:60]})"
    if out["url"]:
        try:
            final, page = get(out["url"], timeout=20)
            out.update(extract(page, final, item))
            out["ok"] = bool(out["blocks"])
            # A few lines only: a teaser, the rest behind a paywall or drawn by the site's scripts.
            out["short"] = out["words"] < 150
            if not out["ok"]:
                out["error"] = "the page has no story text we could read"
        except urllib.error.HTTPError as e:
            out["error"] = f"{item.get('source') or 'the site'} doesn't let its page be read here ({e.code})"
        except Exception as e:
            out["error"] = f"couldn't load the page ({str(e)[:60]})"
    out["browse"] = out["url"] or fallback_url(item)
    if out["lead"] and not item.get("img"):  # the list shows the picture the reader found from now on
        patch_items({aid: {"img": out["lead"]}})
    if out["url"]:  # without one Google refused, and the next tap asks again
        save(path, out)
    print(json.dumps(out, ensure_ascii=False))


def editions():
    return [{"code": c, "country": n, "lang": l} for c, _, n, l in EDITION_LIST]


def change(cmd, key, value):
    os.makedirs(CACHE, exist_ok=True)
    lock = open(os.path.join(CACHE, "news.json.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)  # quick taps in a row each see the one before
    s = dict(DEFAULTS)
    s.update(load(CONF, {}))
    if cmd == "set":
        try:
            v = json.loads(value)
        except ValueError:
            v = value
        if key not in DEFAULTS or (key in LISTS) != isinstance(v, list):
            sys.exit(f"news: no setting {key} for {value!r}")
        s[key] = v
    else:
        if key not in LISTS:
            sys.exit(f"news: {key} isn't a list")
        value = value.strip()
        have = [x for x in s[key] if x.lower() != value.lower()]
        add = cmd == "add" or (cmd == "toggle" and len(have) == len(s[key]))
        s[key] = have + [value] if add and value else have
    save(CONF, s, indent=1)
    if key in FETCHED:
        # In the background: a tap's command that runs long is cut off. status.json spins the face's icon.
        background("update", "--wait")


def main():
    a = sys.argv[1:] or ["update"]
    if a[0] == "update":
        update("--force" in a, "--wait" in a)
    elif a[0] == "refresh":
        background("update", "--force")
    elif a[0] == "article":
        article(a[1] if len(a) > 1 else "")
    elif a[0] == "url":
        item = find_item(a[1])
        try:
            print(story_url(a[1], item))
        except Exception:
            print(fallback_url(item) if item else "!")
    elif a[0] == "editions":
        save(EDITIONS_FILE, editions())
        print(json.dumps(editions(), ensure_ascii=False))
    elif a[0] in ("set", "add", "remove", "toggle") and len(a) == 3:
        change(*a)
    else:
        sys.exit(__doc__)


main()
"""

  source feed = file("~/.cache/news/feed.json") json
  source conf = file("~/.config/omalauncher/news.json") json
  // Fetches once the stories are older than the refresh period or the settings changed; else does nothing.
  source tick = cmd("python -c ${sh(runner)} ${sh(helper)} update") every 1m timeout 120s
  source now = clock every 1m
  // {fetching, since}: a fetch is running, started here, by a settings change or by the timer.
  source fetch = file("~/.cache/news/status.json") json

  // The story open in the reader, read from the publisher's page (and kept a week once read).
  state openId = ""
  source art = cmd("python -c ${sh(runner)} ${sh(helper)} article ${sh(openId)}") every 6h json timeout 60s
  // What the screen shows: the story, or the settings.
  state view = "article"
  // Stories opened on this phone, the last 300.
  state read = [] persist
  // "yes" from a tap until its command returns; then status.json says whether a fetch runs.
  state busy = "no"
  // Settings as tapped, until news.json catches up, so a chip lights at once rather than when the
  // script is done. sent counts the taps; ack is the last one whose command returned.
  state pend = {}
  state sent = 0
  state ack = 0
  // Once every tap's command is done the file is the truth again; till then, keep what it hasn't got yet.
  on conf {
    pend = num(ack, 0) >= sent ? {} : reduce(keys(pend), (m, k) => toJson(get(value, k, null)) == toJson(get(pend, k, null)) ? m : set(m, k, get(pend, k, null)), {})
  }
  // The story whose long-press menu is open.
  state menu = ""
  // A story's address looked up for the browser; "!" when Google wouldn't give it.
  state link = ""
  on link {
    if startsWith(value, "http") { url(value) }
    if value == "!" { notify("news", "Couldn't get that story's address from Google News; try again in a minute.") }
  }

  // Every Google News edition, from the script that checked them: {code, country, lang}, by country.
  // (Written by update, so a tap's refresh starts no script for it.)
  source eds = file("~/.cache/news/editions.json") json
  let cf = merge(conf ?? {}, pend)
  let editions = eds ?? []
  let ed = editions.find(e => e.code == (cf.edition ?? "US:en")) ?? {code: cf.edition ?? "US:en", country: "United States", lang: "English"}
  // The edition dropdown: open or not, and what's typed to narrow it.
  state edOpen = false
  state edFilter = ""
  // Searched as the drawer searches apps: by country, then by language.
  let edShown = edFilter == "" ? editions : rank(editions.map(e => merge(e, {name: e.country, alias: e.lang})), edFilter)
  let sectionCodes = ["TOP", "WORLD", "NATION", "BUSINESS", "TECHNOLOGY", "SCIENCE", "HEALTH", "SPORTS", "ENTERTAINMENT"]
  let sectionNames = {TOP: "Top stories", WORLD: "World", NATION: ed.country, BUSINESS: "Business", TECHNOLOGY: "Technology", SCIENCE: "Science", HEALTH: "Health", SPORTS: "Sports", ENTERTAINMENT: "Entertainment"}
  let sections = cf.sections ?? ["WORLD"]
  let include = cf.include ?? []
  let exclude = cf.exclude ?? []
  let blocked = cf.blocked ?? []
  let limit = cf.limit ?? 30
  let refreshEvery = cf.refresh ?? 30
  let maxAge = cf.maxAge ?? 0
  let readMode = cf.read ?? "dim"
  let ts = cf.textSize ?? 16
  // The stories' font: the launcher's, Android's own three, or one from Google Fonts (downloaded once,
  // then kept; Arabic letters fall back to the phone's font).
  let gf = "https://raw.githubusercontent.com/google/fonts/main/ofl/"
  let fonts = [
    {k: "default", l: "Launcher", f: null},
    {k: "sans", l: "Sans", f: "sans"},
    {k: "serif", l: "Serif", f: "serif"},
    {k: "mono", l: "Mono", f: "mono"},
    {k: "inter", l: "Inter", f: gf + "inter/Inter%5Bopsz,wght%5D.ttf"},
    {k: "literata", l: "Literata", f: gf + "literata/Literata%5Bopsz,wght%5D.ttf"}
  ]
  let fontKey = cf.font ?? "default"
  let font = (fonts.find(x => x.k == fontKey) ?? fonts[0]).f
  // Right to left (Arabic, Hebrew): text whose first letter is in one of their scripts.
  let rtlRe = "^[^A-Za-z\\u0590-\\u08FF]*[\\u0590-\\u08FF]"

  // The fetch leaves blocked sources out; filtering here too hides one the moment it's blocked.
  let blockedLow = blocked.map(b => lower(b))
  let all = (feed.items ?? []).filter(i => indexOf(blockedLow, lower(i.source)) < 0)
  let items = readMode == "hide" ? all.filter(i => indexOf(read, i.id) < 0) : all
  let topics = sections.map(s => get(sectionNames, s, s)) + include
  let mixed = len(topics) > 1
  let updated = feed.fetched ? (fmtAgo(feed.fetched, now) == "now" ? "just now" : "${fmtAgo(feed.fetched, now)} ago") : null
  // A fetch killed before it could say it's done stops spinning after 3 minutes.
  let spinning = busy == "yes" || num(ack, 0) < sent || (fetch.fetching == true && now - (fetch.since ?? 0) < 180)

  // Unfolded or on its side: stories in two columns, no lead story.
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let sw = screenWidth ?? tileWidth ?? 360

  // The story the reader shows: from the feed, or one of a story's related ones.
  let story = all.find(i => i.id == openId)
  let ready = art != null && art.id == openId
  let a = ready ? art : null

  background: linear(0, 0, 0, 1, [alpha(background, 0.94), alpha(background, 0.8), alpha(background, 0.8), alpha(background, 0.94)])
  padding: 0

  // "Reuters · 3h", and the section or keyword it came from when several are mixed. The source and its
  // age are separate texts: one string of an Arabic source and "3h" gets its pieces reordered.
  component Byline(i, tint = muted, rtl = false) {
    Row {
      gap: 6
      align: center
      let tag = mixed && i.tag != null ? (startsWith(i.tag, "#") ? sub(i.tag, 1, len(i.tag)) : get(sectionNames, i.tag, i.tag)) : null
      let age = i.time ? fmtAgo(i.time, now) : null
      if rtl {
        if tag != null { Text { text: tag; fontSize: 10; bold: true; color: accent; maxLines: 1; width: 88 } }
        Text { text: i.source; fontSize: 12; color: tint; maxLines: 1; font: font; weight: 1; align: end }
        if age != null {
          Text { text: "·"; fontSize: 12; color: tint; width: 10; align: center }
          Text { text: age; fontSize: 12; color: tint; maxLines: 1; font: font; width: 30 }
        }
      } else {
        Text { text: i.source; fontSize: 12; color: tint; maxLines: 1; font: font; weight: 1 }
        if age != null {
          Text { text: "·"; fontSize: 12; color: tint; width: 10; align: center }
          Text { text: age; fontSize: 12; color: tint; maxLines: 1; font: font; width: 30 }
        }
        if tag != null { Text { text: tag; fontSize: 10; bold: true; color: accent; maxLines: 1; width: 88; align: end } }
      }
    }
  }

  // Long-press a story: the browser, sharing, read or not, and hiding its source.
  component Menu(i) {
    Popup {
      visible: menu == i.id
      onDismiss: menu = ""
      width: 250
      gap: 0
      Text {
        text: "Open in browser"; fontSize: 15; fill: width; padding: [14, 12]
        onTap: { menu = ""; if i.url != null { url(i.url) } else { link = ""; link = run("python -c ${sh(runner)} ${sh(helper)} url ${sh(i.id)}") } }
      }
      Text { text: "Share"; fontSize: 15; fill: width; padding: [14, 12]; onTap: { menu = ""; share("${i.title}\n${i.url ?? "https://news.google.com/articles/" + i.id}") } }
      Text {
        text: indexOf(read, i.id) >= 0 ? "Mark as unread" : "Mark as read"; fontSize: 15; fill: width; padding: [14, 12]
        onTap: { menu = ""; read = indexOf(read, i.id) >= 0 ? read.filter(r => r != i.id) : (read + [i.id]).drop(len(read) >= 300 ? 1 : 0) }
      }
      Spacer { height: 1; fill: width; background: border }
      Text {
        text: "Hide stories from ${i.source}"; fontSize: 15; color: red; fill: width; padding: [14, 12]; maxLines: 2
        onTap: { menu = ""; pend = set(pend, "blocked", blocked.filter(b => lower(b) != lower(i.source)) + [i.source]); sent = sent + 1; ack = run("python -c ${sh(runner)} ${sh(helper)} add blocked ${sh(i.source)} >/dev/null 2>&1; echo ${int(sent)}") }
      }
    }
  }

  component Thumb(i, s) {
    Box {
      size: s
      radius: 8 * corners
      clip: true
      background: alpha(surface, 0.7)
      Image { src: i.img; fit: cover; fill: true }
    }
  }

  // The lead story: its picture across the page, the headline big under it.
  component Hero(i) {
    Box {
      fill: width
      // A tap anywhere on it, title, picture or byline, opens it in the reader and counts it as read.
      onTap: {
        openId = i.id
        view = "article"
        if indexOf(read, i.id) < 0 { read = (read + [i.id]).drop(len(read) >= 300 ? 1 : 0) }
        screen()
      }
      onLongPress: { haptic(); menu = i.id }
      let rtl = match(i.title ?? "", rtlRe) != null
      Column {
        gap: 8
        fill: width
        padding: [0, 4, 0, 14]
        opacity: readMode == "dim" && indexOf(read, i.id) >= 0 ? 0.5 : 1
        Box {
          fill: width
          height: clamp(sw * 0.56, 160, 340)
          radius: 12 * corners
          clip: true
          background: alpha(surface, 0.7)
          Image { src: i.img; fit: cover; fill: true }
        }
        Text { text: i.title; fontSize: 22; fontWeight: 700; maxLines: 4; font: font; align: rtl ? "end" : "start" }
        Byline { i: i; rtl: rtl }
      }
      Menu { i: i }
    }
  }

  component Story(i, first = false, side = 0) {
    Box {
      fill: width
      // A tap anywhere on it, title, picture or byline, opens it in the reader and counts it as read.
      onTap: {
        openId = i.id
        view = "article"
        if indexOf(read, i.id) < 0 { read = (read + [i.id]).drop(len(read) >= 300 ? 1 : 0) }
        screen()
      }
      onLongPress: { haptic(); menu = i.id }
      let rtl = match(i.title ?? "", rtlRe) != null
      Column {
        gap: 0
        fill: width
        opacity: readMode == "dim" && indexOf(read, i.id) >= 0 ? 0.45 : 1
        padding: [side, 0]
        if !first { Spacer { height: 1; fill: width; background: alpha(border, 0.5) } }
        Row {
          gap: 12
          align: center
          padding: [0, 12]
          // Right to left, the picture goes first, on the left, as Arabic news apps have it.
          if rtl && i.img != null { Thumb { i: i; s: 78 } }
          Column {
            gap: 5
            weight: 1
            Text { text: i.title; fontSize: 15; fontWeight: 500; maxLines: 3; font: font; align: rtl ? "end" : "start" }
            Byline { i: i; rtl: rtl }
          }
          if !rtl && i.img != null { Thumb { i: i; s: 78 } }
        }
      }
      Menu { i: i }
    }
  }

  // Refresh (spins while a fetch runs) and settings, drawn so they don't depend on the font.
  component RefreshIcon() {
    Canvas {
      width: 40
      height: 40
      onTap: { busy = "yes"; busy = run("python -c ${sh(runner)} ${sh(helper)} refresh >/dev/null 2>&1; echo no") }
      let ink = spinning ? accent : foreground
      rotate(spinning ? time * 300 % 360 : 0, 20, 20) {
        arc(20, 20, 8, 45, 270, stroke: ink, width: 2, cap: round)
        path([[17.2, 11.3], [11.2, 12.4], [16.1, 17.3]], closed: true, fill: ink)
      }
    }
  }

  component GearIcon() {
    Canvas {
      width: 40
      height: 40
      onTap: { view = "settings"; screen() }
      for k in range(8) {
        rotate(k * 45, 20, 20) { rect(18, 9.5, 4, 4.5, radius: 1, fill: foreground) }
      }
      circle(20, 20, 6.5, stroke: foreground, width: 2.5)
    }
  }

  component Header() {
    Row {
      gap: 0
      align: center
      padding: [20, 10, 8, 10]
      Column {
        gap: 1
        weight: 1
        Text { text: lower(fmtTime(now, "EEEE d MMMM")); style: label; color: accent; maxLines: 1 }
        Text { text: "News"; fontSize: 34; fontWeight: 700; letterSpacing: -1; font: font }
        Text {
          text: join(topics, " · ") + (feed.ok == false ? " · offline" : "") + (spinning ? " · updating…" : updated ? " · ${updated}" : "")
          style: small
          color: feed.ok == false ? red : muted
          maxLines: 1
        }
      }
      RefreshIcon { }
      GearIcon { }
    }
  }

  Column {
    fill: true
    gap: 0
    Header { }
    if len(items) == 0 {
      Column {
        weight: 1
        padding: [20, 24]
        gap: 8
        Text { text: feed == null || feed.items == null ? "Loading headlines…" : len(all) > 0 ? "You've read everything." : "No stories match your settings."; style: title }
        Text { text: feed.error ?? (len(all) > 0 ? "Read stories are hidden; settings › read stories shows them again." : ""); style: muted }
      }
    } else if wide {
      Grid {
        lazy: true
        weight: 1
        columns: 2
        gap: 0
        padding: [4, 0]
        // 16 dp each side of a story: room between the columns, so a headline doesn't run into the
        // next column's picture (Grid's gap would space the rows as well).
        for i in items key i.id { Story { i: i; first: true; side: 16 } }
      }
    } else {
      Column {
        lazy: true
        weight: 1
        gap: 0
        padding: [20, 0]
        for i, k in items key i.id {
          if k == 0 && i.img != null { Hero { i: i } } else { Story { i: i; first: k == 0 } }
        }
      }
    }
    Spacer { height: screenInset }
  }

  // --- The reader ---

  component Para(b, rtl = false) {
    let al = rtl ? "end" : "start"
    if b.k == "h" {
      Text { text: b.t; fontSize: ts + 3; fontWeight: 700; padding: [0, 6, 0, 0]; font: font; align: al }
    } else if b.k == "q" {
      // The quote's bar is on the side the text starts from.
      Row {
        gap: 12
        if !rtl { Spacer { width: 3; fill: height; background: accent; radius: 2 } }
        Text { text: b.t; fontSize: ts; italic: true; weight: 1; font: font; align: al }
        if rtl { Spacer { width: 3; fill: height; background: accent; radius: 2 } }
      }
    } else if b.k == "li" {
      Row {
        gap: 10
        align: top
        if !rtl { Text { text: "•"; fontSize: ts; color: accent; width: 10 } }
        Text { text: b.t; fontSize: ts; weight: 1; font: font; align: al }
        if rtl { Text { text: "•"; fontSize: ts; color: accent; width: 10 } }
      }
    } else if b.k == "img" {
      Column {
        gap: 6
        Box {
          fill: width
          height: (sw - 24) * (b.ratio ?? 0.62)
          radius: 8 * corners
          clip: true
          background: surface
          Image { src: b.src; fit: cover; fill: true }
        }
        if b.cap != null && b.cap != "" { Text { text: b.cap; style: small; color: muted; maxLines: 4; font: font; align: al } }
      }
    } else {
      Text { text: b.t; fontSize: ts; font: font; align: al }
    }
  }

  component Reader() {
    Column {
      scroll: true
      gap: 14
      padding: [4, 8]
      let lead = a.lead ?? story.img
      let source = a.source ?? story.source ?? ""
      let when = a.time ?? story.time
      let rtl = match(a.title ?? story.title ?? "", rtlRe) != null
      if lead != null {
        Box {
          fill: width
          height: clamp(sw * 0.56, 160, 360)
          radius: 10 * corners
          clip: true
          background: surface
          Image { src: lead; fit: cover; fill: true }
        }
      }
      Text {
        spans: [{text: source, bold: true, color: accent}, when ? " · ${fmtTime(when, "d MMM, HH:mm")}" : "", a.words > 0 ? " · ${max(1, round(a.words / 230))} min read" : ""]
        style: small
        color: muted
        align: rtl ? "end" : "start"
      }
      Text { text: a.title ?? story.title ?? ""; fontSize: ts + 9; fontWeight: 700; font: font; align: rtl ? "end" : "start" }
      if a.byline != null { Text { text: a.byline; style: small; color: muted; maxLines: 2; font: font; align: rtl ? "end" : "start" } }
      if !ready {
        Text { text: "Loading the story from ${source}…"; style: muted }
      } else {
        for b in a.blocks { Para { b: b; rtl: rtl } }
        if !a.ok || a.short || a.cut {
          Column {
            gap: 6
            padding: [14, 12]
            radius: 10 * corners
            background: alpha(surface, 0.9)
            Text {
              text: !a.ok ? "Couldn't read the whole story" : a.cut ? "The story goes on" : "This may be only the start"
              fontWeight: 700
            }
            Text {
              text: !a.ok ? "${a.error ?? "The page had no text to read."}. ${a.desc ?? ""}" : a.cut ? "It's longer than the reader shows; the rest is on ${source}'s site." : "${source} showed only this much here: the rest may be for subscribers, or drawn by the site itself."
              style: small
              color: muted
            }
          }
        }
        if !a.ok && len(a.related ?? []) > 0 {
          Text { text: "ALSO COVERED BY"; style: label; color: muted; padding: [0, 6, 0, 0] }
          for r in a.related {
            Column {
              gap: 2
              padding: [0, 6]
              onTap: openId = r.id
              Text { text: r.title; fontSize: 15; maxLines: 3; font: font; align: match(r.title ?? "", rtlRe) != null ? "end" : "start" }
              Text { text: r.source; style: small; color: accent }
            }
          }
        }
      }
      Row {
        gap: 8
        padding: [0, 8, 0, 4]
        if ready && !a.ok && a.url == null {
          Button { text: "try again"; onTap: refresh() }
        }
        Button {
          text: "open in browser"
          onTap: { if a.browse != null { url(a.browse) } else if story.url != null { url(story.url) } else { link = ""; link = run("python -c ${sh(runner)} ${sh(helper)} url ${sh(openId)}") } }
        }
        Button { text: "share"; color: muted; onTap: share("${a.title ?? story.title}\n${a.url ?? story.url ?? "https://news.google.com/articles/" + openId}") }
      }
      Spacer { height: 12 }
    }
  }

  // --- Settings ---

  component Heading(label, note = "") {
    Column {
      gap: 2
      padding: [0, 8, 0, 0]
      Text { text: label; style: label; color: accent }
      if note != "" { Text { text: note; style: small; color: muted } }
    }
  }

  // A list setting: its words as chips with ✕, and a field that adds one.
  component Words(key, list, hint) {
    Column {
      gap: 8
      if len(list) > 0 {
        Flow {
          gap: 8
          for w in list {
            Text {
              text: "${w}  ✕"; fontSize: 14; maxLines: 1; padding: [14, 8]; radius: 16 * corners; border: 1
              color: background; background: key == "include" ? accent : red; borderColor: key == "include" ? accent : red
              onTap: { pend = set(pend, key, list.filter(x => lower(x) != lower(w))); sent = sent + 1; ack = run("python -c ${sh(runner)} ${sh(helper)} remove ${sh(key)} ${sh(w)} >/dev/null 2>&1; echo ${int(sent)}") }
            }
          }
        }
      }
      Input {
        placeholder: hint
        clear: true
        onSubmit: {
          let v = trim(value)
          if v != "" { pend = set(pend, key, list.filter(x => lower(x) != lower(v)) + [v]); sent = sent + 1; ack = run("python -c ${sh(runner)} ${sh(helper)} add ${sh(key)} ${sh(v)} >/dev/null 2>&1; echo ${int(sent)}") }
        }
      }
    }
  }

  // A setting with a few values: chips, the chosen one lit.
  component Choice(key, options, chosen) {
    Flow {
      gap: 8
      for o in options {
        Text {
          text: o.l; fontSize: 14; maxLines: 1; padding: [14, 8]; radius: 16 * corners; border: 1
          color: o.v == chosen ? background : foreground; background: o.v == chosen ? accent : alpha(surface, 0.9); borderColor: o.v == chosen ? accent : border
          onTap: { pend = set(pend, key, o.v); sent = sent + 1; ack = run("python -c ${sh(runner)} ${sh(helper)} set ${sh(key)} ${sh(toJson(o.v))} >/dev/null 2>&1; echo ${int(sent)}") }
        }
      }
    }
  }

  // The chosen edition; a tap drops down every edition, with a field to narrow them.
  component EditionPicker() {
    Box {
      fill: width
      Row {
        fill: width
        gap: 10
        align: center
        padding: [14, 12]
        radius: 10 * corners
        border: 1
        borderColor: edOpen ? accent : border
        background: alpha(surface, 0.9)
        onTap: { edFilter = ""; edOpen = true }
        Text { text: ed.country; fontSize: 15; maxLines: 1; weight: 1 }
        Text { text: ed.lang; fontSize: 15; color: muted; maxLines: 1; width: 110; align: end }
        Text { text: "▾"; fontSize: 15; color: accent; width: 14 }
      }
      Popup {
        visible: edOpen
        onDismiss: edOpen = false
        // As wide as the field: the screen less the settings' padding.
        width: (screenWidth ?? 360) - 8
        gap: 4
        Column {
          gap: 0
          fill: width
          Input { placeholder: "search ${len(editions)} editions…"; padding: [14, 4]; onChange: edFilter = value }
          Column {
            lazy: true
            height: clamp((screenHeight ?? 700) * 0.5, 200, 460)
            fill: width
            gap: 0
            for e in edShown key e.code {
              Row {
                fill: width
                gap: 10
                align: center
                padding: [14, 11]
                background: e.code == ed.code ? alpha(accent, 0.15) : null
                onTap: {
                  edOpen = false
                  pend = set(pend, "edition", e.code)
                  sent = sent + 1
                  ack = run("python -c ${sh(runner)} ${sh(helper)} set edition ${sh(e.code)} >/dev/null 2>&1; echo ${int(sent)}")
                }
                Text { text: e.country; fontSize: 15; maxLines: 1; weight: 1; color: e.code == ed.code ? accent : foreground }
                Text { text: e.lang; fontSize: 14; color: muted; maxLines: 1; width: 110; align: end }
              }
            }
          }
        }
      }
    }
  }

  component Settings() {
    Column {
      scroll: true
      gap: 10
      padding: [4, 8]
      Text {
        text: spinning ? "Updating the stories…" : "Changes apply at once and sync to your other devices."
        style: small
        color: spinning ? accent : muted
      }
      Heading { label: "EDITION"; note: "The country and language Google News picks stories for." }
      EditionPicker { }

      Heading { label: "SECTIONS"; note: "Google News sections to mix in, in turn." }
      Flow {
        gap: 8
        for s in sectionCodes {
          let picked = indexOf(sections, s) >= 0
          Text {
            text: get(sectionNames, s, s); fontSize: 14; maxLines: 1; padding: [14, 8]; radius: 16 * corners; border: 1
            color: picked ? background : foreground; background: picked ? accent : alpha(surface, 0.9); borderColor: picked ? accent : border
            onTap: { pend = set(pend, "sections", picked ? sections.filter(x => x != s) : sections + [s]); sent = sent + 1; ack = run("python -c ${sh(runner)} ${sh(helper)} toggle sections ${sh(s)} >/dev/null 2>&1; echo ${int(sent)}") }
          }
        }
      }

      Heading { label: "INCLUDE TOPICS"; note: "Each one adds a Google News search for it, mixed in with the sections." }
      Words { key: "include"; list: include; hint: "add a topic, like bitcoin or \"Champions League\"" }

      Heading { label: "EXCLUDE TOPICS"; note: "Hides stories with any of these words in the headline." }
      Words { key: "exclude"; list: exclude; hint: "add a word to hide" }

      Heading { label: "BLOCKED SOURCES"; note: "Hides these publishers. Long-press a story to block its source." }
      Words { key: "blocked"; list: blocked; hint: "add a source, like Fox News" }

      Heading { label: "STORIES"; note: "At most this many." }
      Choice { key: "limit"; options: [10, 20, 30, 40, 50].map(n => {l: "${n}", v: n}); chosen: limit }

      Heading { label: "REFRESH EVERY"; note: "While home is on screen; the refresh button fetches at once." }
      Choice { key: "refresh"; options: [{l: "15 min", v: 15}, {l: "30 min", v: 30}, {l: "1 hour", v: 60}, {l: "2 hours", v: 120}, {l: "6 hours", v: 360}, {l: "12 hours", v: 720}]; chosen: refreshEvery }

      Heading { label: "MAX AGE"; note: "Leaves out older stories." }
      Choice { key: "maxAge"; options: [{l: "any", v: 0}, {l: "6 hours", v: 6}, {l: "12 hours", v: 12}, {l: "1 day", v: 24}, {l: "2 days", v: 48}, {l: "1 week", v: 168}]; chosen: maxAge }

      Heading { label: "READ STORIES"; note: "Stories you've opened on this phone (${len(read)})." }
      Row {
        gap: 8
        Choice { key: "read"; options: [{l: "dim", v: "dim"}, {l: "hide", v: "hide"}, {l: "show", v: "show"}]; chosen: readMode; weight: 1 }
      }
      if len(read) > 0 { Button { text: "forget read stories"; color: muted; onTap: read = [] } }

      Heading { label: "FONT"; note: "For the headlines and the stories." }
      Flow {
        gap: 8
        for o in fonts {
          Text {
            text: o.l; font: o.f; fontSize: 15; maxLines: 1; padding: [14, 8]; radius: 16 * corners; border: 1
            color: o.k == fontKey ? background : foreground; background: o.k == fontKey ? accent : alpha(surface, 0.9); borderColor: o.k == fontKey ? accent : border
            onTap: { pend = set(pend, "font", o.k); sent = sent + 1; ack = run("python -c ${sh(runner)} ${sh(helper)} set font ${sh(o.k)} >/dev/null 2>&1; echo ${int(sent)}") }
          }
        }
      }

      Heading { label: "READER TEXT SIZE" }
      Choice { key: "textSize"; options: [14, 16, 18, 20, 22].map(n => {l: "${n}", v: n}); chosen: ts }
      Text { text: "The quick brown fox reads the news."; fontSize: ts; color: muted; font: font }
      Spacer { height: 16 }
    }
  }

  screen {
    title: view == "settings" ? "news settings" : (a.source ?? story.source ?? "news")
    if view == "settings" { Settings { } } else { Reader { } }
  }
}
