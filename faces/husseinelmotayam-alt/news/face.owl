face "news" {
  page: 0
  meta { owl: 11; description: "Google News as a page of its own: headlines with pictures, the whole story with its pictures in a reader, and settings for sections, keywords, sources and refresh"; version: "1.1"; license: "MIT"; category: "news" }
  requires { pacman: ["python", "python-lxml", "python-readability-lxml"] }

  // The face carries its own fetcher: the helper below is written to ~/.cache/news/owl-news on the first
  // run, then run from there. It fetches the stories into ~/.cache/news/feed.json, which is read here the
  // moment it changes; the settings are ~/.config/omalauncher/news.json. No downloads, no other files.
  let runner = "import pathlib,runpy,sys,os; p=pathlib.Path.home()/'.cache/news/owl-news'; p.parent.mkdir(parents=True,exist_ok=True); s=sys.argv.pop(1).replace(chr(92)+chr(34),chr(34)); old=(p.read_text() if p.exists() else ''); old!=s and (p.write_text(s),os.chmod(p,0o755)); sys.argv[0]=str(p); runpy.run_path(str(p),run_name='__main__')"
  let helper = """#!/usr/bin/env python3
\"\"\"Google News for the news face.

  owl-news update [--force]  fetch the stories if the cache is older than the refresh period or the
                             settings changed (--force: now); writes ~/.cache/news/feed.json
  owl-news refresh           update --force in the background, at once (the face's refresh button)
  owl-news article ID        one story's full text and pictures from the publisher's page, as JSON
                             blocks; cached in ~/.cache/news/articles/
  owl-news url ID            a story's address on the publisher's site, for the browser
  owl-news editions          every Google News edition, as JSON {code, country, lang}, for the settings
                             (update also leaves them in ~/.cache/news/editions.json, which the face reads)
  owl-news set KEY VALUE     change a setting (VALUE is read as JSON, else as text), then fetch again
                             in the background
  owl-news toggle KEY ITEM   add ITEM to the list setting KEY, or take it out if it's there
  owl-news add KEY ITEM, owl-news remove KEY ITEM

The settings live in ~/.config/omalauncher/news.json, so every device reads the same news. Stories come from the RSS feeds of the chosen Google News sections and from a Google News
search per keyword to include, mixed in turn; the pictures from the sections' web pages, matched by
article id. Each feed is kept in ~/.cache/news/feeds/ for the refresh period, so turning a section
off needs no fetch and turning one on fetches only it. Google refuses quick bursts (429), so its
requests are spaced out, and a story's link is decoded only when it's opened. While a fetch
runs, ~/.cache/news/status.json says so, for the face's spinner.
\"\"\"
import concurrent.futures, email.utils, fcntl, gzip, hashlib, html, io, json, os, re, subprocess, sys, time, urllib.parse, urllib.request, zlib
import xml.etree.ElementTree as ET

CONF = os.path.expanduser("~/.config/omalauncher/news.json")
CACHE = os.path.expanduser("~/.cache/news")
FEED = os.path.join(CACHE, "feed.json")
FEEDS = os.path.join(CACHE, "feeds")
STATUS = os.path.join(CACHE, "status.json")
EDITIONS_FILE = os.path.join(CACHE, "editions.json")
ARTICLES = os.path.join(CACHE, "articles")
UA = "owl-news/1.1 (Omalauncher news face)"

DEFAULTS = {
    "edition": "US:en",     # Google News edition, country:language (EDITIONS)
    "sections": ["WORLD"],  # Google News sections to mix (SECTIONS)
    "include": [],          # keywords: each one adds a Google News search for it
    "exclude": [],          # keywords: hide stories whose headline has one
    "blocked": [],          # sources to hide, by name as Google gives it ("Fox News")
    "limit": 30,            # stories at most
    "refresh": 30,          # minutes between fetches
    "maxAge": 0,            # hide stories older than this many hours; 0: any age
    "read": "dim",          # opened stories: dim, hide or show
    "textSize": 16,         # the reader's text size, sp
    "font": "default",      # the stories' font, one of the face's (default: the launcher's)
}
# Every edition Google News has, as (edition, page language, country, language), by country. Asked
# for one it doesn't have (Egypt in English, Denmark, Croatia, ...), Google gives the US edition, so
# each of these was checked to come back as itself, with stories in Top stories and World.
