    ("KR:ko", "ko", "South Korea", "한국어"),
    ("ES:es", "es", "Spain", "Español"),
    ("SE:sv", "sv", "Sweden", "Svenska"),
    ("CH:de", "de", "Switzerland", "Deutsch"),
    ("CH:fr", "fr", "Switzerland", "Français"),
    ("TW:zh-Hant", "zh-TW", "Taiwan", "中文"),
    ("TZ:en", "en-TZ", "Tanzania", "English"),
    ("TH:th", "th", "Thailand", "ไทย"),
    ("TR:tr", "tr", "T\u00fcrkiye", "Türkçe"),
    ("UG:en", "en-UG", "Uganda", "English"),
    ("UA:ru", "ru", "Ukraine", "Русский"),
    ("UA:uk", "uk", "Ukraine", "Українська"),
    ("AE:ar", "ar", "United Arab Emirates", "العربية"),
    ("GB:en", "en-GB", "United Kingdom", "English"),
    ("US:en", "en-US", "United States", "English"),
    ("US:es-419", "es-419", "United States", "Español"),
    ("VE:es-419", "es-419", "Venezuela", "Español"),
    ("VN:vi", "vi", "Vietnam", "Tiếng Việt"),
    ("ZW:en", "en-ZW", "Zimbabwe", "English"),
