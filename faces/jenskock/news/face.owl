face "news" {
  // Left of page 1: a Google News–style reader for your RSS and Atom feeds.
  page: 0

  meta {
    owl: 13
    description: "A news face: your RSS and Atom feeds merged into one scrollable feed, filterable by source. Tap a story to open it; tap Feeds to edit ~/.config/omalauncher/feeds"
    version: "1.0"
    license: "MIT"
    category: "news"
  }

  requires { pacman: ["python"] }

  // One feed URL per line (# comments ok). Fetched in parallel, merged newest first.
  source items = cmd("""
    # news face feed merge
    f=~/.config/omalauncher/feeds
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf '%s\n' \
      'https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en' \
      'https://feeds.bbci.co.uk/news/world/rss.xml' \
      'https://feeds.npr.org/1001/rss.xml' \
      'https://www.theguardian.com/world/rss' \
      'https://archlinux.org/feeds/news/' > "$f"
    grep -v '^#' "$f" | grep . | python3 -c '
import html, json, re, sys, urllib.request, xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from email.utils import parsedate_to_datetime

A = "{http://www.w3.org/2005/Atom}"
M = "{http://search.yahoo.com/mrss/}"
C = "{http://purl.org/rss/1.0/modules/content/}"
UA = "omalauncher-news/1.0"

def when(s):
    if not s:
        return 0
    try:
        return int(parsedate_to_datetime(s).timestamp())
    except Exception:
        try:
            return int(datetime.fromisoformat(s.strip().replace("Z", "+00:00")).timestamp())
        except Exception:
            return 0

def text(e, *tags):
    for t in tags:
        x = e.find(t)
        if x is not None and x.text:
            return clean(x.text)
    return ""

def clean(s):
    s = re.sub(r"(?is)<(script|style)[^>]*>.*?</\\1>", " ", s or "")
    s = re.sub(r"(?is)<br\\s*/?>", " · ", s)
    s = re.sub(r"(?is)<[^>]+>", " ", s)
    return " ".join(html.unescape(s).split())

def short_feed(s):
    s = (s or "").strip()
    low = s.lower()
    if " | " in s:
        s = s.rsplit(" | ", 1)[-1]
    elif low.startswith("top stories - "):
        s = s.split(" - ", 1)[-1]
    elif low.startswith("npr"):
        return "NPR"
    elif low.startswith("bbc"):
        return "BBC"
    elif low.startswith("arch linux"):
        return "Arch Linux"
    return s[:28]

def first_img(s):
    m = re.search("(?is)<img[^>]+src=\"([^\"]+)\"", s or "")
    if m:
        return m.group(1)
    a = chr(39)
    m = re.search("(?is)<img[^>]+src=" + a + "([^" + a + "]+)" + a, s or "")
    return m.group(1) if m else ""

def image(e, raw_desc=""):
    for tag in (M + "content", M + "thumbnail"):
        for n in e.findall(tag):
            url = n.get("url") or ""
            typ = (n.get("type") or "").lower()
            if url and (not typ or typ.startswith("image") or n.get("medium") == "image"):
                return url
    enc = e.find("enclosure")
    if enc is not None:
        url = enc.get("url") or ""
        typ = (enc.get("type") or "").lower()
        if url and typ.startswith("image"):
            return url
    return first_img(raw_desc)

def fetch(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        root = ET.fromstring(urllib.request.urlopen(req, timeout=12).read())
    except Exception:
        return []
    out = []
    ch = root.find("channel")
    if ch is not None:
        feed = short_feed(text(ch, "title") or url)
        for i in ch.findall("item"):
            raw = ""
            for t in ("description", C + "encoded"):
                n = i.find(t)
                if n is not None and (n.text or len(n)):
                    raw = "".join(n.itertext()) if n.text is None else (n.text or "")
                    if not raw:
                        raw = "".join(n.itertext())
                    break
            link = text(i, "link")
            title = text(i, "title")
            if not title:
                continue
            comments = text(i, "comments")
            summary = clean(raw)[:280]
            # Official HN RSS description is only a Comments link; keep the URL, clear the summary.
            if comments and summary.lower() == "comments":
                summary = ""
            out.append({
                "title": title,
                "url": link,
                "at": when(text(i, "pubDate")),
                "feed": feed,
                "summary": summary,
                "comments": comments,
                "image": image(i, raw),
            })
    else:
        feed = short_feed(text(root, A + "title") or url)
        for e in root.findall(A + "entry"):
            link = e.find(A + "link[@rel=\"alternate\"]")
            if link is None:
                link = e.find(A + "link")
            href = link.get("href") if link is not None else ""
            raw = ""
            for t in (A + "summary", A + "content"):
                n = e.find(t)
                if n is not None:
                    raw = "".join(n.itertext())
                    break
            title = text(e, A + "title")
            if not title:
                continue
            out.append({
                "title": title,
                "url": href,
                "at": when(text(e, A + "published", A + "updated")),
                "feed": feed,
                "summary": clean(raw)[:280],
                "comments": "",
                "image": image(e, raw),
            })
    return out

urls = [l.strip() for l in sys.stdin if l.strip()]
with ThreadPoolExecutor(8) as pool:
    posts = [p for ps in pool.map(fetch, urls) for p in ps if p.get("url")]
# Keep a share from every feed so quieter ones are not crowded out, then merge.
by = {}
for p in posts:
    by.setdefault(p["feed"], []).append(p)
seen = set()
uniq = []
per = max(8, 80 // max(len(by), 1))
for ps in by.values():
    ps.sort(key=lambda p: -p["at"])
    for p in ps[:per]:
        if p["url"] in seen:
            continue
        seen.add(p["url"])
        uniq.append(p)
uniq.sort(key=lambda p: (-p["at"], p["title"]))
print(json.dumps(uniq[:80]))
'
  """) every 20m json timeout 45s

  source now = clock every 1m

  state topic = "All" persist
  state chipsOpen = false persist

  let feeds = unique((items ?? []).map(p => p.feed)).sort()
  let topics = flatten([["All"], feeds])
  let shown = items == null ? null : topic == "All" ? items : items.filter(p => p.feed == topic)
  let hero = shown != null && len(shown) > 0 ? shown[0] : null
  let rest = shown != null ? shown.drop(1) : []
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let glass = alpha(background, tileOpacity)
  let chip = alpha(surface, 0.55)

  background: linear(0, 0, 0, 1, [alpha(background, 0.92), alpha(background, 0.55), alpha(background, 0.88)])
  padding: 0

  component Topic(label) {
    Text {
      text: label
      style: small
      color: topic == label ? background : foreground
      maxLines: 1
      padding: [14, 8]
      background: topic == label ? accent : chip
      frost: topic == label ? 0 : tileFrost
      radius: 16 * corners
      onTap: { topic = label; chipsOpen = false }
    }
  }

  component Meta(p) {
    Row {
      gap: 6
      align: center
      Text { text: p.feed; style: label; color: accent; maxLines: 1; weight: 1 }
      Text {
        text: p.at == 0 ? "" : fmtAgo(p.at, now)
        style: label
        color: muted
        width: 40
        align: end
        maxLines: 1
      }
    }
  }

  component Hero(p) {
    Column {
      gap: 10
      padding: 14
      frost: tileFrost
      background: glass
      radius: 18 * corners
      onTap: url(p.url)
      if p.image != "" {
        Box {
          height: wide ? 180 : 160
          fill: width
          radius: 12 * corners
          clip: true
          Image { src: p.image; fit: cover; fill: true }
        }
      }
      Meta { p: p }
      Text { text: p.title; fontSize: 22; fontWeight: 600; maxLines: 3 }
      if p.summary != "" {
        Text { text: p.summary; style: body; color: muted; maxLines: 3 }
      }
      if p.comments != "" {
        Text {
          text: "Comments"
          style: small
          color: accent
          maxLines: 1
          onTap: url(p.comments)
        }
      }
    }
  }

  component Story(p) {
    Row {
      gap: 12
      align: top
      padding: 12
      frost: tileFrost
      background: glass
      radius: 14 * corners
      onTap: url(p.url)
      Column {
        gap: 4
        weight: 1
        Meta { p: p }
        Text { text: p.title; bold: true; maxLines: 3 }
        if p.summary != "" {
          Text { text: p.summary; style: small; color: muted; maxLines: 2 }
        }
        if p.comments != "" {
          Text {
            text: "Comments"
            style: small
            color: accent
            maxLines: 1
            onTap: url(p.comments)
          }
        }
      }
      if p.image != "" {
        Box {
          size: 76
          radius: 10 * corners
          clip: true
          Image { src: p.image; fit: cover; fill: true }
        }
      }
    }
  }

  Column {
    gap: 12
    fill: true
    padding: [16, 10, 16, 0]

    Row {
      gap: 10
      align: center
      Column {
        gap: 0
        weight: 1
        Text { text: "News"; fontSize: 28; fontWeight: 600 }
        Text { text: lower(fmtTime(now, "EEEE d MMMM")); style: muted; maxLines: 1 }
      }
      Text {
        text: "↻"
        style: body
        color: muted
        padding: [10, 8]
        onTap: refresh()
      }
      Text {
        text: "Feeds"
        style: small
        color: accent
        padding: [12, 8]
        background: chip
        frost: tileFrost
        radius: 14 * corners
        onTap: terminal("$EDITOR ~/.config/omalauncher/feeds", "feeds")
      }
    }

    Column {
      gap: 8
      Row {
        gap: 8
        align: center
        Text {
          text: chipsOpen ? "Sources ▴" : "${topic} ▾"
          style: small
          color: chipsOpen ? muted : background
          maxLines: 1
          padding: [14, 8]
          background: chipsOpen ? chip : accent
          frost: chipsOpen ? tileFrost : 0
          radius: 16 * corners
          onTap: chipsOpen = !chipsOpen
        }
        if !chipsOpen && topic != "All" {
          Text {
            text: "All"
            style: small
            color: muted
            padding: [12, 8]
            background: chip
            frost: tileFrost
            radius: 16 * corners
            onTap: topic = "All"
          }
        }
      }
      if chipsOpen {
        Flow {
          gap: 8
          for t in topics key t {
            Topic { label: t }
          }
        }
      }
    }

    if items == null {
      Column {
        weight: 1
        justify: center
        align: center
        Text { text: "loading feeds…"; style: muted }
      }
    } else if len(shown) == 0 {
      Column {
        weight: 1
        gap: 10
        justify: center
        align: center
        padding: 24
        Text { text: "nothing loaded"; style: title; color: muted }
        Text { text: "check your feed list, then tap ↻"; style: small; color: muted; align: center }
        Text {
          text: "edit feeds"
          style: small
          color: accent
          padding: [14, 10]
          background: chip
          frost: tileFrost
          radius: 14 * corners
          onTap: terminal("$EDITOR ~/.config/omalauncher/feeds", "feeds")
        }
      }
    } else {
      Column {
        lazy: true
        weight: 1
        gap: 10
        if hero != null {
          Hero { p: hero }
        }
        for p in rest key p.url {
          Story { p: p }
        }
        Spacer { height: 8 + screenInset }
      }
    }
  }
}
