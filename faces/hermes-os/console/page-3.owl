face "console engineering" {
  // The console's third page (see face.owl): the battery, memory and storage, the network's speed and signal,
  // switches for Wi-Fi, Bluetooth, Do Not Disturb and the torch, the volume in ten steps with a mute key and the phone
  // itself; the sidebar adds Android's location and airplane panels, and the phone.

  meta { owl: 19 }

  source now = clock every 1m
  source bat = android.battery
  source sys = android.system every 30s
  source dev = android.device
  source net = android.network every 3s
  source sim = android.sim
  source modes = android.modes
  source vol = android.volume

  // The console draws straight on the wallpaper in the theme's colours, so the status bar steps aside.
  statusBar: false
  edge: true
  padding: 0
  // The number cascade scrolls a row every half second; two frames a second is all it needs.
  fps: 2

  // Tapping the number cascade reshuffles it.
  state seed = 4774 persist

  // ---- the console's look, the same on all three pages ----
  let antonio = "https://raw.githubusercontent.com/google/fonts/main/ofl/antonio/Antonio%5Bwght%5D.ttf"
  // The theme's colours: the console follows the Omarchy theme. Every coloured part is a pane of frosted glass in
  // its colour (gA, from home's widget opacity); behind them the wallpaper shows clear, darkened by the theme's
  // background at widgets.opacity in style.toml.
  let void = background
  let amber = orange
  let peach = bright_red
  let tan = bright_yellow
  let lilac = magenta
  let violet = mix(magenta, blue, 0.5)
  let periw = blue
  let sky = cyan
  let rose = red
  let gold = yellow
  let gA = clamp(tileOpacity + 0.1, 0.45, 0.85)
  // The coloured parts are frosted glass, never less than 20 dp of blur; the screen behind them is clear glass.
  let fz = max(num(tileFrost, 0), 20)
  // The screen behind them: the wallpaper Omarchy puts behind home, diffused (frost reads it live, so it follows
  // the theme picker). Below about 10 dp the launcher's small copy of it shows as blotches.
  let bgBlur = 1
  // Text and unlit parts: the theme's foreground, stepped back toward its background.
  let txLabel = mix(foreground, background, 0.22)
  let txNote = mix(foreground, background, 0.42)
  let dim = mix(foreground, background, 0.62)
  let off = mix(foreground, background, 0.8)
  // The three pages on home, left to right, as layout.toml numbers them: faces left of the first page of tiles
  // count down from 0. Change these if the pages are moved.
  let pages = [-2, -1, 0]
  let deco = [amber, peach, tan, lilac, periw, gold, violet, sky]

  let W = tileWidth ?? 412
  let H = tileHeight ?? 915
  let wide = W > H
  let sw = wide ? 120 : 80
  let bar = 18
  let R = 32
  let ri = 14
  let gp = 4
  let topH = 64
  let botH = 64
  // The height of every sidebar key.
  let bh = 44
  let eX = sw + 52

  let yr = num(fmtTime(now, "yyyy"), 2026)
  let doy = num(fmtTime(now, "D"), 1)
  // The stardate in the Kelvin style: the year, a point and the day of the year (2026.315), so it turns each day.
  let stardate = "${int(yr)}.${int(doy)}"

  // A half-pill of frosted glass, round at the right (side 1) or the left (side -1).
  component Cap(w, h, c, side) {
    Box {
      width: w
      height: h
      // Plain frost in its shape, a square and a disc, then its tint over both at once.
      Box { width: w - h / 2; height: h; offset: [side > 0 ? 0 : h / 2, 0]; frost: fz }
      Box { width: h; height: h; radius: h / 2; offset: [side > 0 ? w - h : 0, 0]; frost: fz }
      Canvas {
        fill: true
        layer(gA) {
          rect(side > 0 ? 0 : h / 2, 0, w - h / 2, h, fill: c)
          circle(side > 0 ? w - h / 2 : h / 2, h / 2, h / 2, fill: c)
        }
      }
    }
  }

  // The top of the frame: the elbow into the sidebar, the bar in three segments, the page's name and an end cap.
  component Top(name, code, cA, cB, cC) {
    Row {
      gap: 0
      align: top
      fill: width
      Box {
        weight: 1
        height: topH
        // The elbow's frost: boxes of plain frosted glass whose union is its shape (the outer curve from a rounded
        // box), and over them its tint, drawn once as one shape so no two panes darken each other.
        Box { width: sw; height: topH; radius: R; frost: fz }
        Box { width: sw; height: topH - R; offset: [0, R]; frost: fz }
        Box { width: sw - R; height: R; offset: [R, 0]; frost: fz }
        Box { width: eX - R; height: bar; offset: [R, 0]; frost: fz }
        Canvas {
          fill: true
          path([[0, height]] + range(9).map(i => [R + R * cos(rad(180 + i * 11.25)), R + R * sin(rad(180 + i * 11.25))]) + [[eX, 0], [eX, bar]] + range(9).map(i => [sw + ri + ri * cos(rad(270 - i * 11.25)), bar + ri + ri * sin(rad(270 - i * 11.25))]) + [[sw, height]], closed: true, fill: alpha(cA, gA))
        }
        Row {
          fill: width
          height: bar
          gap: gp
          padding: [eX + gp, 0, 8, 0]
          Box { width: 26; height: bar; frost: fz; background: alpha(cB, gA) }
          Box { weight: 1; height: bar; frost: fz; background: alpha(cC, gA) }
        }
        Box {
          width: sw
          height: topH
          align: bottomEnd
          padding: [0, 0, 6, 3]
          Text { text: code; font: antonio; fontSize: 14.5; fontWeight: 500; color: void; align: end }
        }
      }
      Text { text: upper(name); font: antonio; fontSize: 28; fontWeight: 500; letterSpacing: 1; color: cA; maxLines: 1; offset: [0, -7] }
      Row { gap: 0; Spacer { width: 6 }; Cap { w: bar; h: bar; c: cA; side: 1 } }
    }
  }

  // The bottom of the frame, the top's mirror.
  component Bottom(name, cA, cB, cC, here = 0, phone = "") {
    Row {
      gap: 0
      align: bottom
      fill: width
      Box {
        weight: 1
        height: botH
        // The elbow's frost and its tint, as at the top.
        Box { width: sw; height: botH; radius: R; frost: fz }
        Box { width: sw; height: botH - R; frost: fz }
        Box { width: sw - R; height: R; offset: [R, botH - R]; frost: fz }
        Box { width: eX - R; height: bar; offset: [R, botH - bar]; frost: fz }
        Canvas {
          fill: true
          path([[0, 0]] + range(9).map(i => [R + R * cos(rad(180 - i * 11.25)), height - R + R * sin(rad(180 - i * 11.25))]) + [[eX, height], [eX, height - bar]] + range(9).map(i => [sw + ri + ri * cos(rad(90 + i * 11.25)), height - bar - ri + ri * sin(rad(90 + i * 11.25))]) + [[sw, 0]], closed: true, fill: alpha(cA, gA))
        }
        // The bar under the screen is the three pages' tabs: the one showing lit in cB, a tap on another turns to it.
        Box {
          fill: true
          align: bottomStart
          padding: [sw + 52 + gp, 0, 8, 0]
          Row {
            gap: gp
            fill: width
            height: bar
            for i in range(3) {
              Box {
                weight: i == here ? 2 : 1
                height: bar
                background: alpha(i == here ? cB : cC, gA); frost: fz
                align: end
                padding: [0, 0, 5, 0]
                onTap: if i != here { haptic(); launcher("page:${pages[i]}") }
                Text { text: "${pad(i + 1, 2, "0")}"; font: antonio; fontSize: 13.5; fontWeight: 600; letterSpacing: 1; color: void; maxLines: 1; align: end }
              }
            }
          }
        }
        // The phone's name and number, in the elbow: the elbow and the key above it are the phone.
        if phone != "" {
          Box {
            width: sw
            height: botH
            align: bottomEnd
            padding: [0, 0, 6, 3]
            onTap: { haptic(); androidApp("com.google.android.dialer") }
            Column {
              gap: 0
              Text { text: "PHONE"; font: antonio; fontSize: 24; fontWeight: 600; color: void; align: end; maxLines: 1 }
              Text { text: phone; font: antonio; fontSize: 12.5; fontWeight: 500; color: alpha(void, 0.7); align: end; maxLines: 1 }
            }
          }
        }
      }
      Text { text: upper(name); font: antonio; fontSize: 17.5; fontWeight: 500; letterSpacing: 2; color: cB; maxLines: 1; offset: [0, 2] }
      Row { gap: 0; Spacer { width: 6 }; Cap { w: bar; h: bar; c: cA; side: 1 } }
    }
  }

  // A sidebar button: its name and a number at the bottom right, in void.
  component Side(label, code, tint, h) {
    Column {
      width: sw
      height: h
      gap: 0
      background: alpha(tint, gA); frost: fz
      padding: [6, 4, 6, 4]
      Spacer { weight: 1 }
      Text { text: upper(label); font: antonio; fontSize: 16.5; fontWeight: 600; color: void; align: end; maxLines: 1 }
      Text { text: code; font: antonio; fontSize: 12.5; fontWeight: 500; color: alpha(void, 0.7); align: end; maxLines: 1 }
    }
  }

  // A section's heading: a rounded bar running into its name.
  component Head(t, tint) {
    Row {
      gap: 8
      align: center
      fill: width
      Cap { w: 22; h: 14; c: tint; side: -1 }
      Text { text: upper(t); font: antonio; fontSize: 19; fontWeight: 500; letterSpacing: 1; color: tint; maxLines: 1 }
      Box { weight: 1; height: 14; background: alpha(tint, gA); frost: fz }
      Cap { w: 14; h: 14; c: tint; side: 1 }
    }
  }

  // A label at the left, its value at the right.
  component Readout(k, v, vc = amber) {
    Row {
      gap: 8
      fill: width
      Text { text: upper(k); font: antonio; fontSize: 14.5; color: txLabel; maxLines: 1; weight: 1 }
      Text { text: upper(v); font: antonio; fontSize: 15.5; fontWeight: 500; color: vc; maxLines: 1 }
    }
  }

  // A percentage over twelve segments that light up, red past ninety.
  component Meter(label, pct, note, tint) {
    Column {
      weight: 1
      gap: 2
      Row {
        fill: width
        align: bottom
        gap: 4
        Text { text: upper(label); font: antonio; fontSize: 14.5; color: txLabel; weight: 1; maxLines: 1 }
        Text { text: pct == null ? "——" : "${round(pct)}%"; font: antonio; fontSize: 22; fontWeight: 500; color: pct != null && pct >= 90 ? rose : tint; maxLines: 1 }
      }
      Canvas {
        fill: width
        height: 10
        let n = 12
        let sg = (width - (n - 1) * 2) / n
        let lit = pct == null ? 0 : round(clamp(pct, 0, 100) / 100 * n)
        for i in range(n) {
          rect(i * (sg + 2), 0, sg, height, fill: alpha(i < lit ? (pct >= 90 ? rose : tint) : off, gA))
        }
      }
      Text { text: upper(note ?? ""); font: antonio; fontSize: 12.5; color: txNote; maxLines: 1 }
    }
  }

  // The stardate and the time.
  component Clock() {
    Row {
      fill: width
      align: bottom
      gap: 8
      Column {
        weight: 1
        gap: 0
        Text { text: "STARDATE"; font: antonio; fontSize: 14.5; letterSpacing: 2; color: txLabel }
        Text { text: stardate; font: antonio; fontSize: 24; fontWeight: 500; color: gold }
        Text { text: upper(fmtTime(now, "EEE d MMM yyyy")) + (bat.level == null ? "" : " · ${bat.level}%"); font: antonio; fontSize: 13.5; letterSpacing: 1; color: bat.level != null && bat.level < 20 && bat.charging != true ? rose : lilac; maxLines: 1 }
      }
      Text { text: fmtTime(now, "HH:mm"); font: antonio; fontSize: 60; fontWeight: 400; color: amber; maxLines: 1 }
    }
  }

  // Columns of numbers scrolling up a row every half second; a few are lit. Tap to reshuffle.
  component Cascade(salt) {
    Box {
      weight: 1
      fill: width
      onTap: seed = random(1000000)
      ripple: false
      clip: true
      Canvas {
        fill: true
        let rh = 17
        let rows = floor(height / rh)
        let cw = 50
        let cols = max(floor(width / cw), 1)
        let tick = floor(time * 2)
        for r in range(rows) {
          for k in range(cols) {
            let h = hash(seed, salt, r + tick, k)
            let d = 2 + floor(hash(seed, salt, r + tick, k, 1) * 5)
            let x = width - k * cw - 2
            if h < 0.06 {
              rect(x - cw + 6, r * rh + 1, cw - 6, rh - 2, fill: alpha(deco[floor(h * 100) % 8], gA))
            }
            text(pad(str(floor(hash(seed, salt, r + tick, k, 2) * pow(10, d))), d, "0"), x - 3, r * rh + rh / 2, size: 13, align: end, font: antonio, color: h < 0.06 ? void : h < 0.3 ? deco[floor(h * 1000) % 8] : dim)
          }
        }
      }
    }
  }


  // ---- this page ----
  // The network's speed, from the change in its byte counters between two polls.
  state down = null
  state up = null
  on net { if old != null && value.rx >= old.rx && value.uptime > old.uptime { down = (value.rx - old.rx) / (value.uptime - old.uptime); up = (value.tx - old.tx) / (value.uptime - old.uptime) } }
  // And how it has run lately: the last fourteen readings each way.
  let downH = history(down ?? 0, 14)
  let upH = history(up ?? 0, 14)

  let level = num(bat.level, 0)
  let batTint = bat.charging ? sky : level < 20 ? rose : amber
  let memF = sys.memory == null || !sys.memory.total ? null : sys.memory.used / sys.memory.total
  let diskF = sys.storage == null || !sys.storage.total ? null : sys.storage.used / sys.storage.total
  let volLv = num(vol.level, 0)

  // The battery as a big number and its readings, memory and storage as meters beside it.
  component Power() {
    Column {
      gap: 6
      fill: width
      Head { t: "power · memory"; tint: amber }
      Row {
        gap: 12
        fill: width
        align: top
        Box {
          onTap: settings("battery")
          Column {
            gap: 0
            width: 86
            Text { text: "${bat.level ?? "…"}%"; font: antonio; fontSize: 40; fontWeight: 500; color: batTint; maxLines: 1 }
            Text { text: (bat.charging ? "CHARGING" : "BATTERY") + (bat.health == null ? "" : " · " + upper(bat.health)); font: antonio; fontSize: 13.5; letterSpacing: 1; color: bat.charging ? sky : txLabel; maxLines: 1 }
            Text { text: upper([bat.temp == null ? null : "${round(bat.temp)}°c", bat.voltage == null ? null : "${fixed(bat.voltage, 2)} v"].filter(x => x != null).join(" · ")); font: antonio; fontSize: 13.5; color: lilac; maxLines: 1 }
          }
        }
        Column {
          weight: 1
          gap: 8
          Row { fill: width; Meter { label: "memory"; pct: memF == null ? null : memF * 100; note: sys.memory == null ? "" : "${fmtBytes(sys.memory.available)} free"; tint: periw } }
          Row { fill: width; Meter { label: "storage"; pct: diskF == null ? null : diskF * 100; note: sys.storage == null ? "" : "${fmtBytes(sys.storage.free)} free"; tint: lilac } }
        }
      }
    }
  }

  // Down and up, the carrier and its signal, and how long the phone has been on.
  component Net() {
    Column {
      gap: 6
      fill: width
      Head { t: "subspace network"; tint: sky }
      Row {
        gap: 16
        fill: width
        Column {
          weight: 1
          gap: 1
          Readout { k: "downlink"; v: down == null ? "…" : "${fmtBytes(down)}/s"; vc: sky }
          Readout { k: "uplink"; v: up == null ? "…" : "${fmtBytes(up)}/s"; vc: peach }
          Readout { k: "uptime"; v: sys.uptime == null ? "…" : fmtDuration(sys.uptime) }
          // The last readings as bars: down in sky, up in peach.
          Row {
            fill: width
            gap: 8
            padding: [0, 3, 0, 0]
            for h, c in [{v: downH, t: sky}, {v: upH, t: peach}] {
              Canvas {
                weight: 1
                height: 14
                let k = len(h.v)
                let top = max(last(sort(h.v)) ?? 1, 1)
                let bw = width / 14
                for j in range(k) {
                  rect((14 - k + j) * bw, height - max(2, h.v[j] / top * height), bw - 2, max(2, h.v[j] / top * height), fill: j == k - 1 ? h.t : alpha(h.t, 0.45))
                }
              }
            }
          }
        }
        Box {
          weight: 1
          onTap: settings("internet")
          Column {
            fill: width
            gap: 1
            Readout { k: "carrier"; v: !sim.available ? "wi-fi" : !sim.present ? "no sim" : sim.carrier ?? "…"; vc: periw }
            Readout { k: "link"; v: sim.data ? "mobile data" : modes.wifi == true ? "wi-fi" : "—"; vc: periw }
            Row {
              fill: width
              gap: 8
              Text { text: "SIGNAL"; font: antonio; fontSize: 14.5; color: txLabel; weight: 1 }
              Canvas {
                width: 40
                height: 16
                for i in range(4) {
                  rect(i * 10, 16 - (i + 1) * 4, 7, (i + 1) * 4, fill: alpha(sim.signal != null && i < sim.signal ? gold : off, gA))
                }
              }
            }
          }
        }
      }
    }
  }

  // A switch as a console button: lit in its colour when on, dark with its name in colour when off.
  component Toggle(label, on, tint) {
    Box {
      fill: width
      height: 34
      radius: 17
      background: alpha(on ? tint : off, gA); frost: fz
      align: end
      padding: [14, 0]
      Text { text: upper(label) + (on ? " · ON" : " · OFF"); font: antonio; fontSize: 16.5; fontWeight: 600; letterSpacing: 1; color: on ? void : tint; maxLines: 1; align: end }
    }
  }

  component Systems() {
    Column {
      gap: 6
      fill: width
      Head { t: "systems"; tint: periw }
      Row {
        gap: 6
        fill: width
        Box { weight: 1; onTap: settings("wifi"); Toggle { label: "wi-fi"; on: modes.wifi == true; tint: periw } }
        Box { weight: 1; onTap: settings("bluetooth"); Toggle { label: "bluetooth"; on: modes.bluetooth == true; tint: sky } }
      }
      Row {
        gap: 6
        fill: width
        Box { weight: 1; onTap: dnd("toggle"); Toggle { label: "quiet"; on: modes.dnd == true; tint: rose } }
        Box { weight: 1; onTap: if modes.torch != null { torch("toggle") }; Toggle { label: "torch"; on: modes.torch == true; tint: gold } }
      }
    }
  }

  // The volume in ten rising steps: tap one to set it.
  component Volume() {
    Column {
      gap: 6
      fill: width
      Head { t: "audio level"; tint: lilac }
      Row {
        fill: width
        gap: 8
        Text { text: vol.muted ? "MUTED" : "VOLUME ${volLv}%"; font: antonio; fontSize: 15.5; fontWeight: 500; color: amber; weight: 1 }
        Text { text: upper(vol.output.name ?? vol.output.type ?? ""); font: antonio; fontSize: 13.5; color: txNote; maxLines: 1 }
        Box {
          width: 64
          height: 22
          radius: 11
          background: alpha(vol.muted == true ? rose : off, gA); frost: fz
          align: center
          onTap: { haptic(); volume("toggle") }
          Text { text: vol.muted == true ? "UNMUTE" : "MUTE"; font: antonio; fontSize: 14.5; fontWeight: 600; letterSpacing: 1; color: vol.muted == true ? void : rose; align: center }
        }
      }
      Row {
        fill: width
        height: 28
        gap: 3
        align: bottom
        for i in range(10) {
          Box {
            weight: 1
            height: 28
            align: bottom
            onTap: volume((i + 1) * 10)
            ripple: false
            Box { fill: width; height: 5 + i * 2.5; radius: 3; background: alpha(!vol.muted && volLv > i * 10 ? lilac : off, gA); frost: fz }
          }
        }
      }
    }
  }

  // The phone itself.
  component Vessel() {
    Column {
      gap: 4
      fill: width
      Head { t: "vessel"; tint: tan }
      Text { text: dev == null ? "…" : upper("${dev.maker} ${dev.model}"); font: antonio; fontSize: 21; fontWeight: 500; color: amber; maxLines: 1 }
      Text { text: upper([dev.android == null ? null : "android ${dev.android}", sys.kernel == null ? null : "linux ${first(split(sys.kernel, "-"))}", sys.launcher == null ? null : "omalauncher ${sys.launcher}"].filter(x => x != null).join(" · ")); font: antonio; fontSize: 13.5; color: txLabel; maxLines: 1 }
    }
  }

  component Content() {
    if wide {
      Row {
        gap: 20
        fill: true
        Column {
          weight: 1
          gap: 10
          Clock { }
          Power { }
          Net { }
          Cascade { salt: 5; weight: 1; fill: width }
        }
        Column {
          weight: 1
          gap: 10
          Systems { }
          Volume { }
          Vessel { }
          Cascade { salt: 6; weight: 1; fill: width }
        }
      }
    } else {
      Column {
        fill: true
        gap: 10
        Clock { }
        Power { }
        Net { }
        Systems { }
        Volume { }
        Vessel { }
        Cascade { salt: 5; weight: 1; fill: width }
      }
    }
  }

  Column {
    fill: true
    gap: 0
    background: alpha(background, tileOpacity)
    frost: bgBlur
    padding: [8 + screenLeft, screenTop + 6, 8 + screenRight, 0]
    Top { name: "engineering"; code: "03-00"; cA: peach; cB: periw; cC: amber }
    Row {
      weight: 1
      fill: width
      gap: 0
      Column {
        width: sw
        fill: height
        gap: gp
        padding: [0, gp, 0, 0]
        // Grouped by what they do, the most used at the foot twice as tall; numbered page and place, top to bottom,
        // a live reading after its number. Under the filler, past a gap, the phone: a key that runs on into the elbow,
        // where its name sits.
        Box { onTap: { haptic(); launcher("settings") }; Side { label: "launcher"; code: "03-01"; tint: violet; h: bh } }
        Box { onTap: { haptic(); settings("location") }; Side { label: "location"; code: modes.location == true ? "03-02 · ON" : "03-02 · OFF"; tint: modes.location == true ? tan : violet; h: bh } }
        Box { onTap: { haptic(); settings("airplane") }; Side { label: "airplane"; code: modes.airplane == true ? "03-03 · ON" : "03-03 · OFF"; tint: modes.airplane == true ? rose : violet; h: bh } }
        Box { onTap: { haptic(); settings("internet") }; Side { label: "network"; code: "03-04"; tint: sky; h: 2 * bh } }
        Box { onTap: { haptic(); settings("volume") }; Side { label: "volume"; code: "03-05 · ${volLv}%"; tint: periw; h: 2 * bh } }
        Box { onTap: { haptic(); settings("battery") }; Side { label: "power"; code: "03-06 · ${level}%"; tint: batTint; h: 2 * bh } }
        Column { width: sw; weight: 1; background: alpha(amber, gA); frost: fz }
        Box { width: sw; height: bh; background: alpha(violet, gA); frost: fz; onTap: { haptic(); androidApp("com.google.android.dialer") } }
      }
      Column {
        weight: 1
        fill: height
        gap: 0
        padding: [ri + 10, 10, 2, 10]
        Content { weight: 1; fill: width }
      }
    }
    Bottom { name: "phone · systems"; cA: violet; cB: peach; cC: periw; here: 2; phone: "03-07" }
    Spacer { height: screenInset }
  }
}
