face "t9" {
  // The classic candybar, back on a modern phone: a black body with the Omarchy icon over an LCD lit in your theme's
  // colours, raised rubber keys, a green and a red handset, a square nav key. The keypad is the whole launcher: tap
  // keys and they spell the old predictive way (2-2-6 is CAMera, 8-6-7-2-4 is TORCH), any three digits or more can be
  // dialled, and the pick shows as an LCD pixel icon. Keys play their real touch-tones. The LCD lights like hardware:
  // full for eight seconds after the last touch, then dim, then out. Menu opens your apps on the LCD as pixel icons,
  // with the t9's own screens a page to the left: a calendar, your coding agents' sessions and limits, tasks, the
  // notifications, the phone's vitals and switches, music and Snake. Go to lists shortcuts. Hold a key after spelling
  // something and it's on speed dial there; hold it from the idle screen to open it. Hold # for key tones off and on.

  meta {
    owl: 24
    description: "A classic candybar on a modern phone: raised rubber keys, an LCD in your theme. T9 spells apps and dials; Menu opens your apps, calendar, agents, limits, tasks, inbox and Snake on the LCD"
    version: "3.0"
    license: "MIT"
    category: "productivity"
  }

  source now = clock every 1m
  source sec = clock every 1s
  source apps = android.apps
  source n = android.notifications
  source alarm = android.alarm
  source bat = android.battery
  source sim = android.sim
  source modes = android.modes
  source m = android.media
  source vol = android.volume
  source dev = android.device
  // For the t9's own screens: the phone's calendar, the coding agents installed, its vitals and network counters.
  source cal = android.calendar
  source ag = android.agents
  source sys = android.system every 30s
  source net = android.network every 5s

  // Telephone-band sounds, 8 kHz: each key's DTMF pair, then the earcons (open, busy, nothing there, saved, *#06#).
  asset k1 = base64""
  asset k2 = base64""
  asset k3 = base64""
  asset k4 = base64""
  asset k5 = base64""
  asset k6 = base64""
  asset k7 = base64""
  asset k8 = base64""
  asset k9 = base64""
  asset k0 = base64""
  asset kStar = base64""
  asset kHash = base64""
  asset sConnect = base64""
  asset sBusy = base64""
  asset sNope = base64""
  asset sSaved = base64""
  asset sSit = base64""
  // The Omarchy icon, the square mark, where the old phone had its maker's name.
  asset omarchyLogo = base64""

  // What's typed, the result picked, seconds left of the backlight, of a message and of the volume bar.
  state q = ""
  state sel = 0
  state lit = 0
  state flash = ""
  state flashN = 0
  state volN = 0
  // Speed dial: a key's digit to what it opens.
  state speed = {} persist
  // Key tones and earcons on; the time of the last touch, so only newer notifications light the LED.
  state tones = true persist
  state seenAt = 0 persist
  // The control under the finger, the nav key's pressed zone, and the LCD's screen ("", "goto", "player", "snake").
  state down = ""
  state navZ = ""
  state view = ""
  // The Go to list's selection.
  state gsel = 0
  // A line typing itself in: which, when it started (frame time) and seconds left.
  state revealK = ""
  state revealAt = 0
  state revealN = 0
  // The last commit and a counter, so one trigger holds the command chain.
  state go = {n: 0, c: null, t: 0}
  state goN = 0
  // A held key whose speed dial would be replaced: held again while the question shows, it is.
  state armK = ""
  // Snake: the body head first, the way it goes and the way asked for next, the food, the score, a new-game counter.
  state snake = []
  state sDir = [1, 0]
  state sNext = [1, 0]
  state food = [14, 6]
  state sPlay = false
  state sDead = false
  state sScore = 0
  state sAcc = 0
  state sSeed = 1
  state sNew = 0
  state sBest = 0 persist
  // The screen's colour: the theme's yellow, accent, green or blue, or the night screen.
  state scr = "yellow" persist

  // ---- the t9's own screens: the drawer (Menu) and what it opens ----
  // The drawer's page and selection, the folder open in it ("" for none) and where it was opened from, a swipe.
  state mPage = 0
  state mSel = 0
  state mFolder = ""
  state mBack = {p: 0, s: 0}
  state mDrag = 0
  // A list screen's selection, and the calendar's picked day (noon, Unix seconds; 0 is today).
  state lSel = 0
  state calDay = 0
  // Typing the old way (multi-tap): what for ("task"; "" when not typing), the text, the
  // key pressed last and when (pressed again within a second it changes that letter), the case (abc, Abc, ABC, 123),
  // and a counter the OK keys bump.
  state tx = ""
  state txt = ""
  state txKey = ""
  state txAt = 0
  state txCase = 1
  state txGo = 0
  // Tasks as last written, until the file shows them; a task action for the trigger that writes it.
  state tasksPend = null
  state tAct = {n: 0, op: "", id: ""}
  // Network speed, from the counters' change.
  state netDown = 0
  state netUp = 0
  // Writes to Linux files without run() (which would make home's only page wait for Linux): each write is a state
  // with a one-time number; its source below runs when that changes and does the write once.
  state wSeq = 0
  state wTasks = {n: "", j: ""}

  // ---- from Linux: all optional, so the t9 runs without Linux (these stay empty until it's up). The commands that
  // reach out fetch only while their screen is open and show the last copy otherwise ----
  // An iOS 26 drawer's arrangement, if one has saved a copy there; your tasks (Tide keeps them in the same file).
  source arr = file("~/.local/share/iphone-drawer/arrangement.json") json optional
  source tf = file("~/.local/share/tide/tasks.json") optional
  // The phone's calendar for 45 days (Android's own source gives 14).
  source calX = cmd("v=${sh(view)}\n" + """
    c=~/.cache/t9/calendar.json
    mkdir -p ~/.cache/t9
    if [ "$v" = cal ]; then omalauncher calendar 45 > "$c.new" 2>/dev/null && [ -s "$c.new" ] && mv "$c.new" "$c"; rm -f "$c.new"; fi
    cat "$c" 2>/dev/null || echo '[]'
  """) every 10m json timeout 20s optional
  // Claude Code's running sessions (a live process each).
  source cs = cmd("v=${sh(view)}\n" + """
    c=~/.cache/t9/sessions.json
    mkdir -p ~/.cache/t9
    if [ "$v" = agents ]; then
      {
        sep=""
        printf '['
        for f in ~/.claude/sessions/*.json; do
          [ -e "$f" ] || continue
          p=${f##*/}; p=${p%.json}
          case $p in ''|*[!0-9]*) continue ;; esac
          [ -r /proc/$p/stat ] || continue
          st=$(sed 's/.*) //' /proc/$p/stat | cut -d' ' -f20)
          if grep -q '"procStart"' "$f"; then grep -q "\"procStart\" *: *\"$st\"" "$f" || continue; fi
          printf '%s' "$sep"; tr -d '\n' < "$f"; sep=,
        done
        printf ']\n'
      } > "$c.new" && mv "$c.new" "$c"
    fi
    cat "$c" 2>/dev/null || echo '[]'
  """) every 15s json optional
  // Claude Code's recent conversations, with the titles Claude gave them.
  source ch = cmd("v=${sh(view)}\n" + """
    c=~/.cache/t9/history.json
    mkdir -p ~/.cache/t9
    if [ "$v" = agents ]; then
      {
        sep=""
        printf '['
        for f in $(ls -t ~/.claude/projects/*/*.jsonl 2>/dev/null | head -8); do
          id=${f##*/}; id=${id%.jsonl}
          w=$(grep -m1 -o '"cwd":"\([^"\\]\|\\.\)*"' "$f" | sed 's/^"cwd"://')
          t=$(tail -c 300000 "$f" | grep -o '"aiTitle":"\([^"\\]\|\\.\)*"' | tail -1 | sed 's/^"aiTitle"://')
          [ -n "$t" ] || t=$(grep -m1 -o '"aiTitle":"\([^"\\]\|\\.\)*"' "$f" | sed 's/^"aiTitle"://')
          printf '%s{"id":"%s","cwd":%s,"title":%s,"mtime":%s}' "$sep" "$id" "${w:-null}" "${t:-null}" "$(stat -c %Y "$f")"
          sep=,
        done
        printf ']\n'
      } > "$c.new" && mv "$c.new" "$c"
    fi
    cat "$c" 2>/dev/null || echo '[]'
  """) every 60s json timeout 20s optional
  // Codex's recent sessions, and how many are running.
  source xs = cmd("v=${sh(view)}\n" + """
    c=~/.cache/t9/codex.json
    mkdir -p ~/.cache/t9
    if [ "$v" = agents ]; then
      n=$(pgrep -x codex 2>/dev/null | wc -l)
      ls -t ~/.codex/sessions/*/*/*/rollout-*.jsonl 2>/dev/null | head -4 | while read -r f; do
        jq -cs --arg m "$(stat -c %Y "$f")" '
          (map(select(.type == "session_meta"))[0].payload) as $s |
          {id: $s.id, cwd: $s.cwd,
           title: ([.[] | select(.type == "event_msg" and .payload.type == "user_message") | .payload.message][0] // null),
           mtime: ($m | tonumber)}' "$f" 2>/dev/null
      done | jq -cs --argjson n "$n" '{running: $n, sessions: .}' > "$c.new" 2>/dev/null && mv "$c.new" "$c"
      rm -f "$c.new"
    fi
    cat "$c" 2>/dev/null || echo '{}'
  """) every 60s json timeout 20s optional
  // Claude's usage limits, as the Claude app shows them.
  source cl = cmd("v=${sh(view)}\n" + """
    c=~/.cache/tide-claude-usage.json
    mkdir -p ~/.cache
    j=$(tr -d '\n' 2>/dev/null < ~/.claude/.credentials.json)
    t=$(printf '%s' "$j" | grep -o '"accessToken" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    p=$(printf '%s' "$j" | grep -o '"subscriptionType" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    r=$(printf '%s' "$j" | grep -o '"rateLimitTier" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    if [ -n "$t" ] && [ "$v" = limits ]; then
      code=$(printf 'Authorization: Bearer %s\n' "$t" | curl -s -m 15 -o "$c.new" -w '%{http_code}' -H @- -H 'anthropic-beta: oauth-2025-04-20' https://api.anthropic.com/api/oauth/usage)
      [ "$code" = 200 ] && mv "$c.new" "$c"
      rm -f "$c.new"
    fi
    if [ -s "$c" ]; then printf '{"at":%s,"plan":"%s","tier":"%s","login":%s,"u":' "$(stat -c %Y "$c")" "$p" "$r" "$([ -n "$t" ] && echo true || echo false)"; cat "$c"; printf '}\n'; else printf '{"error":"no data","login":%s}\n' "$([ -n "$t" ] && echo true || echo false)"; fi
  """) every 10m json timeout 30s optional
  // ChatGPT's limits, which Codex uses.
  source gu = cmd("v=${sh(view)}\n" + """
    c=~/.cache/tide-codex-usage.json
    mkdir -p ~/.cache
    a=$(tr -d '\n' 2>/dev/null < ~/.codex/auth.json)
    t=$(printf '%s' "$a" | grep -o '"access_token" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    u=$(printf '%s' "$a" | grep -o '"account_id" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    code=""
    if [ -n "$t" ] && [ "$v" = limits ]; then
      code=$(printf 'Authorization: Bearer %s\nChatGPT-Account-Id: %s\n' "$t" "$u" | curl -s -m 15 -A 'omarchy-widgets/t9' -o "$c.new" -w '%{http_code}' -H @- -H 'Accept: application/json' https://chatgpt.com/backend-api/wham/usage)
      [ "$code" = 200 ] && [ "$(head -c 1 "$c.new")" = "{" ] && mv "$c.new" "$c"
      rm -f "$c.new"
    fi
    l=$([ -n "$t" ] && echo true || echo false)
    if [ -s "$c" ]; then printf '{"at":%s,"login":%s,"code":"%s","u":' "$(stat -c %Y "$c")" "$l" "$code"; cat "$c"; printf '}\n'; else printf '{"error":"no data","login":%s,"code":"%s"}\n' "$l" "$code"; fi
  """) every 15m json timeout 30s optional
  // The writers. Each runs once per number: a marker file per number keeps a repeat (its interval, a restart) from
  // writing again. Tasks are written whole.
  source wt = cmd("n=${sh(wTasks.n)}; j=${sh(wTasks.j)}; case $n in '') exit 0;; esac; m=~/.cache/t9/w/t$n; if [ ! -e $m ]; then mkdir -p ~/.cache/t9/w ~/.local/share/tide && touch $m && printf '%s' \"$j\" > ~/.local/share/tide/tasks.json.t9 && mv ~/.local/share/tide/tasks.json.t9 ~/.local/share/tide/tasks.json; fi; echo $n") every 24h optional

  statusBar: false
  edge: true
  padding: 0
  // A tap that no key, line or row takes (the LCD, the gaps, the margins) still lights the LCD.
  onTap: lit = LIT
  // The phone's body: the theme's background, a shade darker.
  background: bodyC

  let lcdFont = "https://raw.githubusercontent.com/google/fonts/main/ofl/jersey10/Jersey10-Regular.ttf"
  let inter = "https://raw.githubusercontent.com/google/fonts/main/ofl/inter/Inter%5Bopsz,wght%5D.ttf"

  // ---- sizes ----
  let W = tileWidth ?? 412
  let H = tileHeight ?? 915
  let wide = W > H
  // ---- the keys, measured on the video's straightened frame, in parts of the phone's width PW: three columns 30%
  // apart, every key on its column's centre line (soft key, call or end, then the keypad); keys 22.5% wide and 84% of
  // a row tall (about 1.55 to 1), corners 30% of their height; rows 16.8% apart; the nav ring a square 24% wide in
  // the middle column. SC scales all of it; 1 is the video's size, which the keys look right at ----
  let PW = wide ? min(W * 0.42, 380) : W - num(screenLeft, 0) - num(screenRight, 0)
  let SC = 1
  let colP = PW * 0.3 * SC
  let kpPad = (PW - 3 * colP) / 2
  // Tightened from the video's 16.8% rows so the LCD runs further down: rows 14.8% apart, keys 86% of a row.
  let keyW = PW * 0.215 * SC
  let rowP = min(PW * 0.148 * SC, (H - 230) / 4.4)
  let keyH = min(PW * 0.14 * SC, rowP * 0.86)
  let kh = rowP
  let navH = clamp(PW * 0.235 * SC, 84, 116)
  let ringS = min(PW * 0.215 * SC, navH * 0.95)
  let softKH = keyH * 0.78
  // The gaps above and below the nav block.
  let gapA = PW * 0.022
  let gapB = PW * 0.02
  let softBH = navH * 0.44
  let rowsN = H > 800 ? 5 : 4
  let gRows = H > 800 ? 6 : 5
  // The LCD's width in dp.
  let lcdM = wide ? 14 : PW * 0.03
  let lcdW = wide ? W - 48 - num(screenLeft, 0) - num(screenRight, 0) - min(W * 0.42, 380) : PW - 2 * lcdM
  let digitFs = clamp(PW * 0.047 * SC, 15, 22)
  let artS = clamp(min(lcdW - 32, H * 0.2), 96, 200)
  let iconSpan = 0.8

  // ---- the backlight: seconds of light a touch gives (8 full, then 4 dim), and a wake (2 full, 4 dim) ----
  let LIT = 12
  let WAKE = 6
  let bl = lit > 4 ? 1 : lit > 0 ? 0.35 : 0

  // ---- the look, all from the Omarchy theme: the LCD lit in one of its colours (Go to › Screen picks which), the
  // theme's background as the ink, the body a shade darker than the background, keys raised off it ----
  let scrs = ["yellow", "accent", "green", "blue", "night"]
  let tintC = scr == "accent" ? accent : scr == "green" ? green : scr == "blue" ? blue : yellow
  // Night is the old dark screen: glass tinted by the accent, light ink.
  let night = scr == "night"
  // Lit, dimmed and out: the screen sinks toward the background as the light goes, as an unlit LCD greys.
  let lcdC = night ? mix(background, accent, bl >= 1 ? 0.17 : bl > 0 ? 0.13 : 0.08) : bl >= 1 ? tintC : bl > 0 ? mix(tintC, background, 0.14) : mix(tintC, background, 0.3)
  let ink = night ? mix(foreground, accent, 0.2) : background
  let inkLvl = !night ? 1 : bl >= 1 ? 1 : bl > 0 ? 0.9 : 0.8
  let faint = alpha(ink, 0.55)
  // The backlight's own light: a whiter light of the screen's hue (the accent's glow on the night screen).
  let glowC = night ? mix(accent, foreground, 0.15) : mix(tintC, #ffffff, 0.6)
  let keyGlow = night ? glowC : tintC
  // The body: black, as the video's. Keys are a shade darker, ringed by a darker crevice, with a faint light on
  // their top edge: on a slightly lifted black, so the crevice and the shade can show.
  let bodyC = #0a0a0a
  let keyLvl = bl >= 1 ? 1 : bl > 0 ? 0.88 : 0.72
  // What's printed on the body and its keys glows: the print, then a faint ring of copies round it (two radii),
  // brighter and tinted by the screen's light while the backlight is on.
  let whiteC = mix(#ffffff, foreground, 0.15)
  let printC = bl > 0 ? mix(whiteC, keyGlow, 0.15) : alpha(whiteC, 0.92)
  let haloC = bl > 0 ? mix(whiteC, keyGlow, 0.5) : whiteC
  let haloLvl = bl >= 1 ? 1 : bl > 0 ? 0.8 : 0.5
  let ring1 = [[1, 0], [0.7, 0.7], [0, 1], [-0.7, 0.7], [-1, 0], [-0.7, -0.7], [0, -1], [0.7, -0.7]]
  let ring2 = [[2.2, 0], [1.56, 1.56], [0, 2.2], [-1.56, 1.56], [-2.2, 0], [-1.56, -1.56], [0, -2.2], [1.56, -1.56]]
  // The margin round a raised key that its shadow may fall in.
  let PM = 8

  // ---- T9: every app's words as the digits that spell them ----
  let t9 = {a: "2", b: "2", c: "2", d: "3", e: "3", f: "3", g: "4", h: "4", i: "4", j: "5", k: "5", l: "5", m: "6", n: "6", o: "6", p: "7", q: "7", r: "7", s: "7", t: "8", u: "8", v: "8", w: "9", x: "9", y: "9", z: "9"}
  let cmds = [
    {kind: "cmd", id: "torch", name: "Torch"},
    {kind: "cmd", id: "quiet", name: "Quiet"},
    {kind: "cmd", id: "wifi", name: "Wifi"},
    {kind: "cmd", id: "bluetooth", name: "Bluetooth"},
    {kind: "cmd", id: "music", name: "Music"},
    {kind: "cmd", id: "next", name: "Next track"},
    {kind: "cmd", id: "snake", name: "Snake"},
    {kind: "cmd", id: "settings", name: "Settings"},
    {kind: "cmd", id: "menu", name: "Menu"}
  ]
  // Only what spelling needs from each app: opening an app changes its score, not this, so the codes aren't redone.
  let appNames = (apps ?? []).map(a => {key: a.key, name: a.name, work: a.profile})
  let pool = (appNames.map(a => {kind: "app", key: a.key, id: null, name: join(words(a.name), " "), work: a.work, ws: words(lower(a.name))})
    + cmds.map(c => merge(c, {work: null, ws: words(lower(c.name))})))
    .map(p => merge(p, {codes: p.ws.map(w => join(range(len(w)).map(i => contains("0123456789", sub(w, i, i + 1)) ? sub(w, i, i + 1) : get(t9, sub(w, i, i + 1), "")), ""))}))
  // How much each app is used, by key, for the ranking: cheap to redo after every launch.
  let usage = groupBy((apps ?? []).filter(a => num(a.score, 0) > 0), a => a.key)

  let typing = q != ""
  let spell = typing && !contains(q, "*") && !contains(q, "#") && !contains(q, "+")
  let info = q == "*#06#"
  // A whole word spelled first, then a name's start, then any word's start; apps before commands, used ones first.
  let found = !spell ? [] : pool
    .filter(p => any(p.codes, c => startsWith(c, q)))
    .map(p => merge(p, {wi: range(len(p.codes)).find(i => startsWith(p.codes[i], q)), score: p.kind == "app" ? num(get(usage, p.key, [])[0].score, 0) : 0}))
    .sortBy(p => (p.codes[p.wi] == q ? 0 : 1000000) + (p.wi == 0 ? 0 : 300000) + (p.kind == "cmd" ? 100000 : 0) - p.score)
    .take(8)
    .map(p => merge(p, {off: sum(range(p.wi).map(j => len(p.ws[j]) + 1))}))
  let cands = found + (len(q) >= 3 && !info ? [{kind: "call", name: "Call ${q}", num: q}] : [])
  let at = len(cands) == 0 ? 0 : clamp(sel, 0, len(cands) - 1)
  let cur = len(cands) == 0 ? null : cands[at]
  let from = max(0, at - rowsN + 1)
  let shown = cands.drop(from).take(rowsN)
  let selI = at - from

  // ---- dialling abroad: the country code's city and the time there, so nobody gets rung at 3 a.m. ----
  let zones = [
    {c: "1", city: "New York", z: "America/New_York"}, {c: "1", city: "Los Angeles", z: "America/Los_Angeles"},
    {c: "7", city: "Moscow", z: "Europe/Moscow"}, {c: "20", city: "Cairo", z: "Africa/Cairo"},
    {c: "27", city: "Johannesburg", z: "Africa/Johannesburg"}, {c: "30", city: "Athens", z: "Europe/Athens"},
    {c: "31", city: "Amsterdam", z: "Europe/Amsterdam"}, {c: "32", city: "Brussels", z: "Europe/Brussels"},
    {c: "33", city: "Paris", z: "Europe/Paris"}, {c: "34", city: "Madrid", z: "Europe/Madrid"}, {c: "36", city: "Budapest", z: "Europe/Budapest"},
    {c: "39", city: "Rome", z: "Europe/Rome"}, {c: "40", city: "Bucharest", z: "Europe/Bucharest"}, {c: "41", city: "Zurich", z: "Europe/Zurich"},
    {c: "43", city: "Vienna", z: "Europe/Vienna"}, {c: "44", city: "London", z: "Europe/London"},
    {c: "45", city: "Copenhagen", z: "Europe/Copenhagen"}, {c: "46", city: "Stockholm", z: "Europe/Stockholm"},
    {c: "47", city: "Oslo", z: "Europe/Oslo"}, {c: "48", city: "Warsaw", z: "Europe/Warsaw"}, {c: "49", city: "Berlin", z: "Europe/Berlin"},
    {c: "51", city: "Lima", z: "America/Lima"}, {c: "52", city: "Mexico City", z: "America/Mexico_City"},
    {c: "54", city: "Buenos Aires", z: "America/Argentina/Buenos_Aires"}, {c: "55", city: "Sao Paulo", z: "America/Sao_Paulo"},
    {c: "56", city: "Santiago", z: "America/Santiago"}, {c: "57", city: "Bogota", z: "America/Bogota"},
    {c: "60", city: "Kuala Lumpur", z: "Asia/Kuala_Lumpur"}, {c: "61", city: "Sydney", z: "Australia/Sydney"},
    {c: "62", city: "Jakarta", z: "Asia/Jakarta"}, {c: "63", city: "Manila", z: "Asia/Manila"}, {c: "64", city: "Auckland", z: "Pacific/Auckland"},
    {c: "65", city: "Singapore", z: "Asia/Singapore"}, {c: "66", city: "Bangkok", z: "Asia/Bangkok"}, {c: "81", city: "Tokyo", z: "Asia/Tokyo"},
    {c: "82", city: "Seoul", z: "Asia/Seoul"}, {c: "84", city: "Hanoi", z: "Asia/Ho_Chi_Minh"}, {c: "86", city: "Beijing", z: "Asia/Shanghai"},
    {c: "90", city: "Istanbul", z: "Europe/Istanbul"}, {c: "91", city: "New Delhi", z: "Asia/Kolkata"},
    {c: "92", city: "Karachi", z: "Asia/Karachi"}, {c: "234", city: "Lagos", z: "Africa/Lagos"}, {c: "254", city: "Nairobi", z: "Africa/Nairobi"},
    {c: "351", city: "Lisbon", z: "Europe/Lisbon"}, {c: "353", city: "Dublin", z: "Europe/Dublin"},
    {c: "358", city: "Helsinki", z: "Europe/Helsinki"}, {c: "380", city: "Kyiv", z: "Europe/Kiev"}, {c: "420", city: "Prague", z: "Europe/Prague"},
    {c: "852", city: "Hong Kong", z: "Asia/Hong_Kong"}, {c: "886", city: "Taipei", z: "Asia/Taipei"}, {c: "966", city: "Riyadh", z: "Asia/Riyadh"},
    {c: "971", city: "Dubai", z: "Asia/Dubai"}, {c: "972", city: "Tel Aviv", z: "Asia/Jerusalem"}
  ]
  let intl = startsWith(q, "+") ? sub(q, 1, len(q)) : startsWith(q, "00") ? sub(q, 2, len(q)) : ""
  let zoneHits = intl == "" ? [] : zones.filter(z => startsWith(intl, z.c))
  let zoneLen = reduce(zoneHits, (best, z) => max(best, len(z.c)), 0)
  let zoneShow = zoneHits.filter(z => len(z.c) == zoneLen).take(2)

  // ---- the phone, as a dumb phone would tell it ----
  let phoneApp = (apps ?? []).find(a => a.profile == null && contains(["com.google.android.dialer", "com.samsung.android.dialer", "com.android.dialer", "org.fossify.phone"], a.package))
  let msgApp = (apps ?? []).find(a => a.profile == null && contains(["com.google.android.apps.messaging", "com.samsung.android.messaging", "com.android.mms", "com.android.messaging", "org.fossify.messages"], a.package))
  let camApp = (apps ?? []).find(a => a.profile == null && contains(["com.google.android.GoogleCamera", "com.sec.android.app.camera", "com.android.camera", "com.android.camera2", "com.oneplus.camera", "com.motorola.camera3", "com.motorola.camera2", "com.oplus.camera", "com.huawei.camera", "com.nothing.camera", "app.grapheneos.camera", "org.fossify.camera"], a.package))
  let webApp = (apps ?? []).find(a => a.profile == null && contains(["com.android.chrome", "com.sec.android.app.sbrowser", "org.mozilla.firefox", "com.brave.browser", "com.vivaldi.browser", "com.duckduckgo.mobile.android", "com.microsoft.emmx", "com.opera.browser", "com.kiwibrowser.browser", "app.vanadium.browser", "org.mozilla.fennec_fdroid", "org.mozilla.focus"], a.package))
  let setApp = (apps ?? []).find(a => a.profile == null && a.package == "com.android.settings")
  let items = n.available ? n.items : []
  let missed = phoneApp == null ? 0 : len(items.filter(i => i.package == phoneApp.package))
  let unread = msgApp == null ? 0 : len(items.filter(i => i.package == msgApp.package))
  let rest = items.filter(i => (phoneApp == null || i.package != phoneApp.package) && (msgApp == null || i.package != msgApp.package))
  let lines = [
    missed > 0 ? {k: "call", t: missed == 1 ? "1 missed call" : "${missed} missed calls"} : null,
    unread > 0 ? {k: "sms", t: unread == 1 ? "1 message" : "${unread} messages"} : null,
    len(rest) > 0 ? {k: "note", t: len(rest) == 1 ? "1 notification" : "${len(rest)} notifications"} : null,
    alarm.set ? {k: "bell", t: "Alarm " + fmtTime(alarm.time, "EEE HH:mm")} : null
  ].filter(x => x != null)
  let song = m.available && m.title != null ? [m.title, m.artist].filter(x => x != null && x != "").join(" - ") : null
  // android.media is pushed every second while playing (its position): what changes per track goes through lets,
  // so only the blocks and the times follow the second.
  let mPlaying = m.playing == true
  let mArt = m.art
  let mTitle = m.title
  let mArtist = m.artist
  let mPkg = m.package
  let mAppName = m.app
  // The player's own name, from the apps list; some apps only give their package.
  let mediaApp = mPkg == null ? null : ((apps ?? []).find(a => a.package == mPkg)).name ?? (mAppName != null && !contains(mAppName, ".") ? mAppName : null)
  let songBy = [mArtist, mediaApp].filter(x => x != null && x != "").join(" · ")
  // The song line's ink, here and not on the line: a node's own lets are for its children, and its handlers misread.
  let songCol = down == "song" ? lcdC : mPlaying ? ink : faint
  // Null until the notifications and the apps have loaded, so loading never looks like something arriving.
  let counts = n == null || n.available != true || apps == null || len(apps) == 0 ? null : [missed, unread, len(rest)]
  let charged = bat == null || bat.charging == null ? null : bat.charging == true && num(bat.level, 0) >= 100
  // Plugged in, charging or held below full: bat.charging alone flips while the cable stays in.
  let plugged = bat == null || bat.status == null ? null : bat.status != "on battery"

  // ---- Go to: the shortcuts list the left soft key opens ----
  let gotoItems = [
    webApp == null ? null : {kind: "app", key: webApp.key, name: "Internet"},
    camApp == null ? null : {kind: "app", key: camApp.key, name: "Camera"},
    {kind: "cmd", id: "snake", name: "Snake"},
    {kind: "cmd", id: "torch", name: "Torch"},
    {kind: "cmd", id: "quiet", name: "Quiet"},
    {kind: "cmd", id: "music", name: "Music"},
    {kind: "cmd", id: "wifi", name: "Wifi"},
    {kind: "cmd", id: "bluetooth", name: "Bluetooth"},
    {kind: "cmd", id: "screen", name: "Screen"},
    {kind: "cmd", id: "style", name: "Customize"}
  ].filter(x => x != null)
  let gAt = clamp(gsel, 0, len(gotoItems) - 1)
  let gFrom = max(0, gAt - gRows + 1)
  let gShown = gotoItems.drop(gFrom).take(gRows)
  let gSelI = gAt - gFrom
  let gCur = gotoItems[gAt]

  // ---- the drawer (Menu), as an iOS 26 drawer: one page per iOS page, its apps and folders in the same order and
  // places (4 across, 6 down), the dock along the bottom of each; the t9's own screens on a page to the left of the
  // first, where iOS keeps its Today View. From the drawer's saved copy; A to Z while Linux is off ----
  let t9Apps = [
    {kind: "t9", id: "cal", name: "Calendar"}, {kind: "t9", id: "agents", name: "Agents"},
    {kind: "t9", id: "limits", name: "Limits"}, {kind: "t9", id: "tasks", name: "Tasks"},
    {kind: "t9", id: "inbox", name: "Inbox"}, {kind: "t9", id: "vitals", name: "Vitals"},
    {kind: "t9", id: "switches", name: "Switches"},
    {kind: "t9", id: "player", name: "Music"}, {kind: "t9", id: "snake", name: "Snake"}
  ]
  let arrNames = groupBy(arr.apps ?? [], a => a.key)
  let apNames = groupBy((apps ?? []).map(a => {key: "a:" + a.key, name: a.name}), a => a.key)
  let dRows = clamp(num(arr.rows ?? arr.layout.rows, 6), 4, 6)
  let dPer = 4 * dRows
  let iosPages = (arr.pages ?? arr.layout.pages ?? []).map(pg => pg.map(it => it.apps != null ? {kind: "folder", id: "${it.id ?? it.name}", name: it.name ?? "Folder", apps: it.apps} : {kind: "app", key: it, name: get(arrNames, it, [])[0].name ?? get(apNames, it, [])[0].name ?? "?"}))
  let hasIos = len(iosPages) > 0
  let dockItems = hasIos ? (arr.dock ?? arr.layout.dock ?? []).map(k => {kind: "app", key: k, name: get(arrNames, k, [])[0].name ?? get(apNames, k, [])[0].name ?? "?"}) : []
  let azItems = (apps ?? []).filter(a => a.profile == null).sortBy(a => lower(a.name ?? "")).map(a => {kind: "app", key: "a:" + a.key, name: a.name})
  let allPages = [t9Apps] + (hasIos ? iosPages : chunk(azItems, dPer))
  // The page Menu opens on: your first iOS page (the t9's own screens are one to the left).
  let homePg = hasIos ? 1 : 0
  let mFold = mFolder == "" ? null : flatten(iosPages).find(it => it.kind == "folder" && it.id == mFolder)
  let mPagesL = mFold == null ? allPages : chunk(mFold.apps.map(k => {kind: "app", key: k, name: get(arrNames, k, [])[0].name ?? get(apNames, k, [])[0].name ?? "?"}), dPer)
  let mPages = max(1, len(mPagesL))
  let mPg = clamp(mPage, 0, mPages - 1)
  let mGrid = mPagesL[mPg] ?? []
  let mN = len(mGrid)
  let mDock = mFold == null && mPg > 0 ? dockItems : []
  let mShown = mGrid + mDock
  let mPer = dPer
  let mSelC = len(mShown) == 0 ? 0 : clamp(mSel, 0, len(mShown) - 1)
  let mCur = len(mShown) == 0 ? null : mShown[mSelC]
  // The LCD's content height (for how big a cell can be), from the screen's own sums.
  let lcdHt = H - num(screenTop, 0) - 28 - gapA - navH - gapB - 4 * kh - max(num(screenInset, 0) + 10, PW * 0.05)
  let contH = lcdHt - 65
  // Cells: the grid's rows share what the title, the dots and the dock leave; names under the icons when there's room.
  let dDockH = hasIos ? 38 : 0
  let dCellH = max(24, (contH - 26 - 12 - dDockH - 4) / dRows)
  let dLabels = dCellH >= 36
  let dIcon = clamp(dCellH - (dLabels ? 14 : 4), 18, 46)

  // ---- Calendar: the picked day's month, a dot on each day with events, that day's agenda ----
  let todayNoon = parseTime(fmtTime(now, "yyyy-MM-dd") + " 12:00", "yyyy-MM-dd HH:mm")
  let selNoon = calDay == 0 ? todayNoon : calDay
  let m1 = parseTime(fmtTime(selNoon, "yyyy-MM") + "-01 12:00", "yyyy-MM-dd HH:mm")
  let mNext = parseTime(fmtTime(m1 + 32 * 86400, "yyyy-MM") + "-01 12:00", "yyyy-MM-dd HH:mm")
  let dim = round((mNext - m1) / 86400)
  let wd1 = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(fmtTime(m1, "EEE", null, "en"))
  let calWeeks = ceil((wd1 + dim) / 7)
  let calEvents = len(calX ?? []) > len(cal.events ?? []) ? calX : (cal.events ?? [])
  let calCells = range(calWeeks * 7).map(i => {d: i - wd1 + 1, t: m1 + (i - wd1) * 86400, k: fmtTime(m1 + (i - wd1) * 86400, "yyyy-MM-dd")})
  let calDots = calCells.map(c => c.d >= 1 && c.d <= dim && any(calEvents, e => e.start < c.t + 43200 && e.end > c.t - 43200))
  let todayKey = fmtTime(now, "yyyy-MM-dd")
  let selKey = fmtTime(selNoon, "yyyy-MM-dd")
  let dayEvents = calEvents.filter(e => e.start < selNoon + 43200 && e.end > selNoon - 43200).sortBy(e => (e.allDay ? 0 : 1) * 10000000000 + e.start)
  let calCellH = clamp((contH - 150) / calWeeks, 20, 34)
  let calNeedsOk = cal.granted != true && len(calX ?? []) == 0

  // ---- Agents: Claude Code's running sessions, then the newest of Claude's and Codex's to pick up again, then
  // something new ----
  let sess = (cs ?? []).filter(s => s != null && s.sessionId != null).sortBy(s => s.status == "idle" ? 1 : 0)
  let hist = (ch ?? []).filter(h => h != null && h.id != null)
  let past = hist.filter(h => !any(sess, s => s.sessionId == h.id))
  let xsess = (xs.sessions ?? []).filter(x => x != null && x.id != null)
  let agRows = flatten([
    sess.map(s => {k: "run", id: s.sessionId, hot: s.status != "idle", name: (hist.find(h => h.id == s.sessionId)).title ?? s.name ?? "Claude Code", cwd: s.cwd ?? "", note: s.status == "idle" ? "idle" : "${s.status ?? "busy"}"}),
    (past.map(h => {k: "claude", id: h.id, hot: false, name: h.title ?? "Claude Code session", cwd: h.cwd ?? "", last: num(h.mtime, 0)}) + xsess.map(x => {k: "codex", id: x.id, hot: false, name: trim(first(lines(x.title ?? "")) ?? "") == "" ? "Codex session" : trim(first(lines(x.title))), cwd: x.cwd ?? "", last: num(x.mtime, 0)})).sortBy(r => -r.last).take(8).map(r => merge(r, {note: r.last == 0 ? "" : fmtAgo(min(r.last, now), now) + " ago"})),
    [{k: "new", id: "claude", name: "New Claude Code", cwd: "", note: "in ~"}, {k: "new", id: "codex", name: "New Codex", cwd: "", note: "in ~"}, {k: "new", id: "shell", name: "Terminal", cwd: "", note: "in ~"}]
  ]).map(r => merge(r, {dir: r.cwd == "" ? "." : r.cwd, place: r.cwd == "" || match(r.cwd, "^(/root|/home/[^/]+)/?$") != null ? "~" : last(split(r.cwd, "/"))}))
  let agRunN = len(sess) + num(xs.running, 0)
  let agTitle = !linux ? "Agents · Linux is off" : len(sess) == 0 ? "Agents" : "Agents · ${agRunN} running"

  // ---- Limits: Claude's and ChatGPT's (what Codex uses) ----
  let cuU = cl.u
  let cuL = cuU.limits ?? []
  let cuWeek = cuU.seven_day.utilization ?? (cuL.find(l => l.kind == "weekly_all")).percent
  let cuFiveL = cuL.find(l => l.kind == "session")
  let cuHasFive = cuFiveL != null || cuU.five_hour != null
  let cuFive = cuHasFive ? (cuU.five_hour.utilization ?? cuFiveL.percent) : null
  let cuFiveAt = parseTime(cuU.five_hour.resets_at ?? cuFiveL.resets_at ?? "")
  let cuWeekAt = parseTime(cuU.seven_day.resets_at ?? (cuL.find(l => l.kind == "weekly_all")).resets_at ?? "")
  let cuPlan = (cl.plan ?? "") == "" ? null : contains(cl.tier ?? "", "20x") ? "Ultra" : capitalize(cl.plan)
  let cuErr = !linux ? "Linux is off" : cl == null ? "…" : cl.login == false ? "not signed in" : cl.error != null ? "no data yet" : (cuU.seven_day == null && len(cuL) == 0 ? "offline" : null)
  let gxU = gu.u
  let gxRl = gxU.rate_limit
  let gxErr = !linux ? "Linux is off" : gu == null ? "…" : gu.login == false ? "not signed in" : gu.code == "401" ? "login expired" : gu.error != null ? (gu.code == "000" ? "offline" : "no data yet") : gxRl == null ? "offline" : null
  let gxPlan = gxU.plan_type == null ? null : capitalize(gxU.plan_type)
  let gx1 = gxRl.primary_window
  let gx2 = gxRl.secondary_window
  let gx1Reset = gx1.reset_at ?? (gx1.reset_after_seconds == null ? null : gu.at + gx1.reset_after_seconds)
  let gx2Reset = gx2.reset_at ?? (gx2.reset_after_seconds == null ? null : gu.at + gx2.reset_after_seconds)
  let gx1s = num(gx1.limit_window_seconds, 18000)
  let gx2s = num(gx2.limit_window_seconds, 604800)
  let gx1Name = gx1s < 86400 ? "${round(gx1s / 3600)} hours" : gx1s <= 691200 ? "This week" : gx1s <= 2851200 ? "This month" : "${round(gx1s / 86400)} days"
  let gx2Name = gx2s < 86400 ? "${round(gx2s / 3600)} hours" : gx2s <= 691200 ? "This week" : gx2s <= 2851200 ? "This month" : "${round(gx2s / 86400)} days"
  let limCl = flatten([
    cuWeek != null ? [{t: "This week", p: cuWeek, v: cuWeekAt == null ? "" : "resets " + fmtTime(round(cuWeekAt / 60) * 60, "EEE h:mm a")}] : [],
    cuHasFive ? [{t: "5 hours", p: cuFive ?? 0, v: cuFiveAt == null ? "" : "resets in " + fmtDuration(max(0, cuFiveAt - now))}] : []
  ])
  let limGx = flatten([
    gx1 != null ? [{t: gx1Name, p: gx1.used_percent ?? 0, v: gx1Reset == null ? "" : "resets " + fmtTime(round(gx1Reset / 60) * 60, gx1Reset - now < 86400 ? "h:mm a" : "MMM d")}] : [],
    gx2 != null ? [{t: gx2Name, p: gx2.used_percent ?? 0, v: gx2Reset == null ? "" : "resets " + fmtTime(round(gx2Reset / 60) * 60, "EEE h:mm a")}] : []
  ])

  // ---- Tasks: what's to do, then what's done, then a row that clears the done ones ----
  let tasksF = tf == null || tf == "" ? null : parseJson(tf)
  let tasks = tasksPend ?? tasksF ?? []
  let tTodo = tasks.filter(x => !x.done)
  let tDone = tasks.filter(x => x.done)
  let taskRows = tTodo + tDone + (len(tDone) > 0 ? [{id: "clear", t: "Clear ${len(tDone)} done", clear: true, done: false}] : [])

  // ---- Vitals and switches ----
  let memT = sys.memory.total
  let memA = sys.memory.available
  let stT = sys.storage.total
  let stF = sys.storage.free
  let vitRows = [
    {t: "Battery", v: bat == null ? "…" : "${bat.level}%" + (bat.charging == true ? " charging" : "") + " · ${round(num(bat.temp, 0) * 9 / 5 + 32)}°F", p: num(bat.level, 0)},
    {t: "Memory", v: memT == null ? "…" : "${fmtBytes(memA)} free of ${fmtBytes(memT)}", p: memT == null ? null : 100 - memA / memT * 100},
    {t: "Storage", v: stT == null ? "…" : "${fmtBytes(stF)} free of ${fmtBytes(stT)}", p: stT == null ? null : 100 - stF / stT * 100},
    {t: "Network", v: "In ${fmtBytes(netDown)}/s · Out ${fmtBytes(netUp)}/s", p: null},
    {t: "Up for", v: sys.uptime == null ? "…" : fmtDuration(sys.uptime), p: null},
    {t: "Phone", v: "${dev.model ?? ""} · Android ${dev.android ?? "…"}", p: null}
  ]
  let swRows = [
    {id: "torch", t: "Torch", v: modes.torch == true ? "On" : "Off"},
    {id: "quiet", t: "Quiet", v: modes.dnd ? "On" : "Off"},
    {id: "wifi", t: "Wi-Fi", v: ">"}, {id: "bluetooth", t: "Bluetooth", v: ">"},
    {id: "data", t: "Mobile data", v: ">"}, {id: "airplane", t: "Airplane mode", v: ">"},
    {id: "location", t: "Location", v: ">"}, {id: "sound", t: "Sound", v: ">"},
    {id: "display", t: "Display", v: ">"}, {id: "battery", t: "Battery", v: ">"},
    {id: "files", t: "Files", v: ">"}, {id: "agentsL", t: "Agents", v: ">"},
    {id: "style", t: "Style", v: ">"}, {id: "store", t: "Widget store", v: ">"},
    {id: "lsettings", t: "Launcher settings", v: ">"}
  ]


  // ---- the list screens' shared selection ----
  let listViews = ["agents", "tasks", "inbox", "switches", "vitals"]
  let lRows = view == "agents" ? agRows : view == "tasks" ? taskRows : view == "inbox" ? items : view == "switches" ? swRows : view == "vitals" ? vitRows : []
  let lN = len(lRows)
  let lSelC = lN == 0 ? 0 : clamp(lSel, 0, lN - 1)
  let lCur = lN == 0 ? null : lRows[lSelC]
  let lTall = view == "agents" || view == "inbox"
  let lVis = max(2, floor((contH - 30) / (lTall ? 46 : 34)))
  let lFrom = max(0, lSelC - lVis + 1)
  let lShown = lRows.drop(lFrom).take(lVis)
  let lSelI = lSelC - lFrom

  // ---- typing the old way ----
  let mtMap = {"1": ".,?!1'-@", "2": "abc2", "3": "def3", "4": "ghi4", "5": "jkl5", "6": "mno6", "7": "pqrs7", "8": "tuv8", "9": "wxyz9", "0": " 0", "*": "*+-/()$%&#"}
  let txTitle = tx == "task" ? "New task" : ""

  // ---- Snake: a 20 x 16 field (13 on short screens) that wraps at the edges; it speeds up as it eats ----
  let SW = 20
  let SH = H > 800 ? 16 : 13
  let sStep = max(0.075, 0.16 - sScore * 0.003)
  let sState = sDead ? "over" : sPlay ? "play" : len(snake) > 0 ? "pause" : "start"
  let sScoreS = sub("0000${sScore}", len("${sScore}"), len("${sScore}") + 4)

  // ---- the notification LED, the dot over Menu: newer than the last touch; it blinks ----
  let fresh = items.filter(i => num(i.time, 0) > seenAt)
  let freshCall = phoneApp != null && any(fresh, i => i.package == phoneApp.package)
  let ledOn = len(fresh) > 0 && (revealK != "" || modes.saver == true || sec % 4 == 0)
  let callT = freshCall ? num(first(fresh.filter(i => i.package == phoneApp.package)).time, 0) : 0
  let wob = callT > 0 && sec - callT < 120 && sec % 4 == 0

  // ---- sound: never over music, on a quiet ringer, in Do Not Disturb, or into headphones ----
  let soundOk = m.playing != true && modes.ringer == "normal" && modes.dnd != true && (vol.output == null || vol.output.type == "speaker")
  let voice = tones && soundOk

  // ---- what the soft keys and the nav key's centre do now, as the LCD labels them ----
  let inHub = contains(["menu", "cal", "agents", "limits", "tasks", "inbox", "vitals", "switches"], view)
  let softL = tx != "" ? "Save" : view == "player" ? "Prev" : view == "cal" ? "Today" : view == "agents" ? "New" : view == "tasks" ? "Add" : view == "inbox" ? (lCur != null && lCur.clearable == true ? "Clear" : "") : inHub ? "" : view == "" && !typing ? "Go to" : ""
  let softM = tx != "" ? "OK" : view == "player" ? (m.playing == true ? "Pause" : "Play") : view == "snake" ? (sState == "play" ? "Pause" : sState == "pause" ? "Go on" : "Start") : view == "goto" ? "Select" : view == "menu" || view == "cal" || view == "agents" ? "Open" : view == "limits" ? "Usage" : view == "tasks" ? (lCur == null ? "" : lCur.clear == true ? "Clear" : lCur.done == true ? "Undo" : "Done") : view == "inbox" ? (lN > 0 ? "Open" : "") : view == "switches" ? "Select" : view == "vitals" ? "" : info ? "Close" : typing ? (cur != null ? "Select" : "") : "Menu"
  let softR = tx != "" ? (txt == "" ? "Back" : "Clear") : view == "player" ? "Next" : view == "snake" || view == "goto" ? "Exit" : inHub ? "Back" : typing ? "Delete" : "Setting"

  // Pixel icons, one letter per LCD pixel.
  let sprites = {
    call: [".xxxxxxx.", "xx.....xx", "xx.xxx.xx", "...xxx...", "..xxxxx..", "..xxxxx.."],
    sms: ["xxxxxxxxx", "xx.....xx", "x.x...x.x", "x..x.x..x", "x...x...x", "xxxxxxxxx"],
    note: [".xxxxxxx.", "x.......x", "x.x.x.x.x", "x.......x", ".xxxxxxx.", ".xx......"],
    bell: ["...x...", "..xxx..", ".xxxxx.", ".xxxxx.", "xxxxxxx", "...x..."],
    song: ["..xxxxx", "..x...x", "..x...x", "xxx.xxx", "xxx.xxx", "......."]
  }
  let antenna = ["x.x.x", ".xxx.", "..x..", "..x..", "..x.."]
  let bolt = ["..x", ".x.", "xxx", ".x.", "x.."]
  let sunArt = ["...x...", ".x...x.", "..xxx..", "x.xxx.x", "..xxx..", ".x...x.", "...x..."]
  let moonArt = ["..xxx..", ".xx....", "xx.....", "xx.....", "xx.....", ".xx....", "..xxx.."]
  let muteArt = ["...x.....", "..xx.x..x", "xxxx..xx.", "xxxx..xx.", "..xx.x..x", "...x....."]
  // What a command or a call looks like as a 16x16 LCD icon; apps show their own silhouette.
  let px16 = {
    torch: [".x.....xx.....x.", "..x....xx....x..", "................", "...xxxxxxxxxx...", "...x........x...", "....x......x....", ".....xxxxxx.....", ".....x....x.....", ".....x.xx.x.....", ".....x.xx.x.....", ".....x....x.....", ".....x....x.....", ".....x....x.....", ".....x....x.....", ".....x....x.....", ".....xxxxxx....."],
    quiet: ["................", ".....xxxx.......", "...xxxx.........", "..xxx...........", ".xxx............", ".xxx............", "xxx.............", "xxx.............", "xxx.............", "xxx............x", ".xxx..........xx", ".xxxx.......xxx.", "..xxxxx...xxxx..", "...xxxxxxxxxx...", ".....xxxxxx.....", "................"],
    wifi: ["................", "................", "....xxxxxxxx....", "..xxx......xxx..", ".xx..........xx.", "xx............xx", "......xxxx......", "....xxx..xxx....", "...xx......xx...", "..x..........x..", "................", "......xxxx......", ".....xx..xx.....", "................", ".......xx.......", ".......xx......."],
    bluetooth: [".......x........", ".......xx.......", ".......x.x......", "...x...x..x.....", "....x..x...x....", ".....x.x..x.....", "......xx.x......", ".......xx.......", ".......xx.......", "......xx.x......", ".....x.x..x.....", "....x..x...x....", "...x...x..x.....", ".......x.x......", ".......xx.......", ".......x........"],
    music: ["................", ".....xxxxxxxxxx.", ".....xxxxxxxxxx.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x.....xxxx.", "..xxxx....xxxxx.", ".xxxxx....xxxxx.", ".xxxxx.....xxx..", "..xxx...........", "................", "................"],
    next: ["................", "................", "................", ".x.....x.....xx.", ".xx....xx....xx.", ".xxx...xxx...xx.", ".xxxx..xxxx..xx.", ".xxxxx.xxxxx.xx.", ".xxxxx.xxxxx.xx.", ".xxxx..xxxx..xx.", ".xxx...xxx...xx.", ".xx....xx....xx.", ".x.....x.....xx.", "................", "................", "................"],
    snake: ["................", "................", "..........xxxx..", "..........x.xx..", "..........xxxx..", "..........xx....", "..........xx....", "..xxxxxxxxxx....", "..xxxxxxxxxx....", "..xx............", "..xx............", "..xxxxxxxx...xx.", "..xxxxxxxx...xx.", "................", "................", "................"],
    settings: ["......xxxx......", "..xx..xxxx..xx..", ".xxxxxxxxxxxxxx.", ".xxxxxxxxxxxxxx.", "..xxxx....xxxx..", "..xxx......xxx..", "xxxx........xxxx", "xxxx........xxxx", "xxxx........xxxx", "xxxx........xxxx", "..xxx......xxx..", "..xxxx....xxxx..", ".xxxxxxxxxxxxxx.", ".xxxxxxxxxxxxxx.", "..xx..xxxx..xx..", "......xxxx......"],
    menu: ["xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "................", "................", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "................", "................", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx"],
    call: ["................", "..xxx...........", ".xxxxx..........", ".xxxxx..........", ".xxxx...........", "..xxx...........", "..xxx...........", "...xxx..........", "....xxx.........", ".....xxx..xxx...", "......xxxxxxxx..", ".......xxxxxxxx.", "........xxxxxxx.", "..........xxxx..", "................", "................"]
  }

  // The t9's own screens and a folder, as 16x16 LCD icons for the drawer.
  let px16b = {
    cal: ["...x......x.....", ".xxxxxxxxxxxxxx.", ".xxxxxxxxxxxxxx.", ".x............x.", ".x.x.x.x.x.x..x.", ".x............x.", ".x.x.x.x.x.x..x.", ".x............x.", ".x.x.x.xxx.x..x.", ".x.....xxx....x.", ".x.x.x.xxx.x..x.", ".x............x.", ".xxxxxxxxxxxxxx.", "................", "................", "................"],
    agents: ["................", ".xxxxxxxxxxxxxx.", ".xxxxxxxxxxxxxx.", ".x............x.", ".x.x..........x.", ".x..x.........x.", ".x...x........x.", ".x..x.........x.", ".x.x..xxxxx...x.", ".x............x.", ".x............x.", ".xxxxxxxxxxxxxx.", "................", "................", "................", "................"],
    limits: ["................", "................", ".....xxxxxx.....", "...xx......xx...", "..x..........x..", ".x............x.", ".x.......x....x.", "x.......x......x", "x......x.......x", "x.....xx.......x", "x.....xx.......x", "x..............x", ".xxxxxxxxxxxxxx.", "................", "................", "................"],
    tasks: ["................", ".xxx............", ".x.x..xxxxxxxxx.", ".xxx............", "................", ".xxx............", ".xxx..xxxxxxxxx.", ".xxx............", "................", ".xxx............", ".x.x..xxxxxxxxx.", ".xxx............", "................", "................", "................", "................"],
    inbox: ["................", "................", "................", "xxxxxxxxxxxxxxxx", "xx............xx", "x.x..........x.x", "x..x........x..x", "x...x......x...x", "x....x....x....x", "x.....xxxx.....x", "x..............x", "x..............x", "xxxxxxxxxxxxxxxx", "................", "................", "................"],
    vitals: ["................", "................", "................", ".....x..........", ".....x..........", "....x.x.........", "....x.x.....x...", "....x.x....x.x..", "xxxx...x...x.xxx", ".......x..x.....", "........x.x.....", "........x.x.....", ".........x......", "................", "................", "................"],
    switches: ["................", "................", "...xxxxxxxxxx...", "..x.......xxxx..", ".x.......xxxxxx.", ".x.......xxxxxx.", "..x.......xxxx..", "...xxxxxxxxxx...", "................", "...xxxxxxxxxx...", "..xxxx.......x..", ".xxxxxx.......x.", ".xxxxxx.......x.", "..xxxx.......x..", "...xxxxxxxxxx...", "................"],
    folder: ["................", "................", "..xxxxx.........", ".x.....x........", ".xxxxxxxxxxxxxx.", ".x............x.", ".x............x.", ".x............x.", ".x............x.", ".x............x.", ".x............x.", ".xxxxxxxxxxxxxx.", "................", "................", "................", "................"]
  }
  let t9Bits = ["cal", "agents", "limits", "tasks", "inbox", "vitals", "switches", "folder"].map(k => {k: k, b: get(px16b, k, []).map(r => reduce(range(16), (acc, i) => acc * 2 + (sub(r, i, i + 1) == "x" ? 1 : 0), 0))})
  let musicBits = px16.music.map(r => reduce(range(16), (acc, i) => acc * 2 + (sub(r, i, i + 1) == "x" ? 1 : 0), 0))
  let snakeBits = px16.snake.map(r => reduce(range(16), (acc, i) => acc * 2 + (sub(r, i, i + 1) == "x" ? 1 : 0), 0))

  // A command's or a call's icon, and the player's note, as 16 rows of bits for the GPU.
  let pxArt = cur == null || cur.kind == "app" ? null : get(px16, cur.kind == "call" ? "call" : cur.id, px16.menu)
  let pxBits = pxArt == null ? [] : pxArt.map(r => reduce(range(16), (acc, i) => acc * 2 + (sub(r, i, i + 1) == "x" ? 1 : 0), 0))
  let noteBits = px16.music.map(r => reduce(range(16), (acc, i) => acc * 2 + (sub(r, i, i + 1) == "x" ? 1 : 0), 0))
  // Shaders need Android 13; older phones draw the same with Canvas calls.
  let gpu = num(dev.sdk, 33) >= 33

  // Each key: its digit, its letters and its touch-tone.
  let pad = [{d: "1", l: "", t: k1}, {d: "2", l: "abc", t: k2}, {d: "3", l: "def", t: k3}, {d: "4", l: "ghi", t: k4}, {d: "5", l: "jkl", t: k5}, {d: "6", l: "mno", t: k6}, {d: "7", l: "pqrs", t: k7}, {d: "8", l: "tuv", t: k8}, {d: "9", l: "wxyz", t: k9}, {d: "*", l: "", t: kStar, ic: "lock"}, {d: "0", l: "", t: k0, ic: "mic"}, {d: "#", l: "", t: kHash}]

  // ---- shaders: none reads time, so each runs again only when its uniforms change ----
  // Three LEDs under the LCD's bottom edge, through a light guide: brightest along the bottom, darker corners.
  let guideCode = """
    uniform half4 glow;
    uniform half4 bg;
    half4 main(float2 p) {
      float2 uv = p / size;
      float ar = size.x / size.y;
      float a = 0.05 * exp(-(1.0 - uv.y) * 6.0);
      for (int i = 0; i < 3; i++) {
        float2 d = float2((uv.x - 0.2 - 0.3 * float(i)) * ar, uv.y - 1.04);
        a += 0.11 * exp(-dot(d, d) * 30.0);
      }
      float vx = uv.x * 2.0 - 1.0;
      a = min(a * (1.0 - 0.3 * vx * vx), 0.24);
      // Light on a dark theme is the glow colour; on a light one, the light background is.
      half3 c = dot(float3(glow.rgb), float3(0.333)) > dot(float3(bg.rgb), float3(0.333)) ? glow.rgb : bg.rgb;
      return half4(c * a, a);
    }
  """
  // The pixel grid: 0.7 dp gaps every 4 dp, under the ink, and the bezel's recess shadow along the top, both in the
  // darker of the theme's background and foreground, so they show on light themes too.
  let gridCode = """
    uniform half4 gap;
    uniform half4 fg;
    uniform float wdp;
    half4 main(float2 p) {
      float k = size.x / wdp;
      float c = 4.0 * k;
      float w = 0.7 * k;
      float2 q = mod(p, c);
      float lx = 1.0 - smoothstep(w - 0.5, w + 0.5, q.x);
      float ly = 1.0 - smoothstep(w - 0.5, w + 0.5, q.y);
      float g = max(lx, ly) * gap.a;
      half3 dk = dot(float3(fg.rgb), float3(0.333)) < dot(float3(gap.rgb), float3(0.333)) ? fg.rgb : gap.rgb;
      float rc = 0.28 * (1.0 - smoothstep(0.0, 10.0 * k, p.y));
      float o = max(g, rc);
      return half4(dk * o, o);
    }
  """
  // The light guide's slow wash, rising toward the LEDs at the bottom.
  let washCode = """
    uniform half4 glow;
    uniform half4 bg;
    half4 main(float2 p) {
      float y = p.y / size.y;
      float a = 0.16 * y * y;
      half3 c = dot(float3(glow.rgb), float3(0.333)) > dot(float3(bg.rgb), float3(0.333)) ? glow.rgb : bg.rgb;
      return half4(c * a, a);
    }
  """
  // A raised key as the video's: the body itself rising in a gradual slope into a rounded dome, in the same black, with
  // no outline and no flat top. Its height comes from a superellipse the shape of the key (so it curves smoothly in
  // every direction, with no creases): a parabolic dome, round all over, on a soft foot that starts a few dp outside
  // the outline. Only light and shade show it, continuously across the key: the half facing the light (top, upper
  // left) lighter, the half facing away (bottom, right) darker, fading into the body all round. Drawn as light and
  // shade over the body, so the body's own black and grain run through it. Pressed, the dome flattens and darkens.
  let pillowCode = """
    uniform float2 cap;
    uniform float rad;
    uniform float m;
    uniform float down;
    uniform half4 body;
    float dome(float2 p, float2 b, float rb, float hh) {
      float2 q = max(abs(p) / b, float2(0.0001));
      float r = pow(pow(q.x, 5.0) + pow(q.y, 5.0), 0.2);
      float t = clamp(1.0 - r / rb, 0.0, 1.0);
      return hh * (1.0 - (1.0 - t) * (1.0 - t)) * smoothstep(0.0, 0.3, t);
    }
    half4 main(float2 px) {
      float k = size.x / (cap.x + 2.0 * m);
      float2 p = (px - size * 0.5) / k;
      float2 b = cap * 0.5;
      // The foot starts this far outside the outline, as a part of the key's half height.
      float rb = 1.0 + min(m - 1.0, 4.0) / b.y;
      float hh = mix(5.5, 2.0, down);
      float e = 0.1;
      float h0 = dome(p, b, rb, hh);
      float hx = dome(p + float2(e, 0.0), b, rb, hh);
      float hy = dome(p + float2(0.0, e), b, rb, hh);
      float3 n = normalize(float3(-(hx - h0) / e, -(hy - h0) / e, 1.0));
      float3 L = normalize(float3(-0.35, -0.9, 1.0));
      float lit = dot(n, L) - L.z;
      float inside = smoothstep(0.0, 0.3, clamp(1.0 - pow(pow(max(abs(p.x) / b.x, 0.0001), 5.0) + pow(max(abs(p.y) / b.y, 0.0001), 5.0), 0.2) / rb, 0.0, 1.0));
      float delta = (lit > 0.0 ? lit * 0.17 : lit * 0.08) - down * 0.012 * inside;
      float bb = max(float(body.r), 0.01);
      float a = delta > 0.0 ? clamp(delta / (1.0 - bb), 0.0, 1.0) : clamp(-delta / bb, 0.0, 1.0);
      return delta > 0.0 ? half4(a, a, a, a) : half4(0.0, 0.0, 0.0, a);
    }
  """
  // The body's matte grain under everything.
  let grainCode = """
    uniform half4 body;
    float grain(float2 px) {
      float2 q = fract(floor(px) * float2(0.1031, 0.1030));
      q += dot(q, q.yx + 33.33);
      return fract((q.x + q.y) * q.x) - 0.5;
    }
    half4 main(float2 px) {
      return half4(float4(float3(body.rgb) + grain(px) * 0.012, 1.0));
    }
  """
  // A 16x16 pixel icon from 16 rows of bits, the leftmost highest; cells inset 10%.
  let pxCode = """
    uniform float bits[16];
    uniform half4 inkc;
    uniform half4 ghost;
    half4 main(float2 p) {
      float2 g = p / size * 16.0;
      float2 cell = floor(g);
      float m = 0.0;
      for (int i = 0; i < 16; i++) {
        if (float(i) == cell.y) { m = bits[i]; }
      }
      float on = mod(floor(m / exp2(15.0 - cell.x)), 2.0);
      float2 f = g - cell;
      float inside = step(0.1, f.x) * step(f.x, 0.9) * step(0.1, f.y) * step(f.y, 0.9);
      half4 c = on > 0.5 ? inkc : ghost;
      return half4(c.rgb * c.a, c.a) * inside;
    }
  """
  // An app's icon as 16x16 LCD cells. Where the app has a one-colour icon, its silhouette (a glyph with gaps). Where it
  // hasn't, the silhouette is just the icon's shape, a solid block: then its outline, and inside it whatever stands out
  // from the icon's own background, which is its logo.
  let iconCode = """
    uniform shader img;
    uniform shader full;
    uniform half4 ink;
    uniform half4 ghost;
    uniform float span;
    float2 at(float2 cell) {
      return 0.5 + ((cell + 0.5) / 16.0 - 0.5) * span;
    }
    float inShape(float2 cell) {
      if (cell.x < 0.0 || cell.x > 15.0 || cell.y < 0.0 || cell.y > 15.0) { return 0.0; }
      return step(0.45, img.eval(at(cell)).a);
    }
    half4 main(float2 p) {
      float2 g = p / size * 16.0;
      float2 cell = floor(g);
      // How much of the icon's middle the silhouette covers: a glyph leaves gaps, a plain shape doesn't.
      float cov = 0.0;
      for (int j = 0; j < 6; j++) {
        for (int i = 0; i < 6; i++) {
          cov += step(0.45, img.eval(0.5 + (float2(float(i), float(j)) / 5.0 - 0.5) * span * 0.6).a);
        }
      }
      cov = cov / 36.0;
      float on = inShape(cell);
      if (cov > 0.8) {
        half4 c = full.eval(at(cell));
        float k = 0.38 * span;
        float3 bg = (float3(full.eval(float2(0.5, 0.5 - k)).rgb) + float3(full.eval(float2(0.5, 0.5 + k)).rgb) + float3(full.eval(float2(0.5 - k, 0.5)).rgb) + float3(full.eval(float2(0.5 + k, 0.5)).rgb)) * 0.25;
        float3 cc = float3(c.rgb) / max(float(c.a), 0.01);
        float diff = step(0.24, distance(cc, bg)) * step(0.45, float(c.a));
        float edge = on * (1.0 - inShape(cell + float2(1.0, 0.0)) * inShape(cell - float2(1.0, 0.0)) * inShape(cell + float2(0.0, 1.0)) * inShape(cell - float2(0.0, 1.0)));
        on = max(edge, on * diff);
      }
      float2 f = fract(g);
      float inside = step(0.1, f.x) * step(f.x, 0.9) * step(0.1, f.y) * step(f.y, 0.9);
      half4 col = on > 0.5 ? ink : ghost;
      return half4(col.rgb * col.a, col.a) * inside;
    }
  """
  // Album art as a 4x4 ordered dither in ink on the LCD.
  let coverCode = """
    uniform shader art;
    uniform half4 ink;
    uniform half4 plate;
    uniform half4 bg;
    uniform float cells;
    half4 main(float2 p) {
      float c = size.x / cells;
      float2 g = floor(p / c);
      // Levels from 16 samples of the cover, so dark and pale artwork still fill the plate.
      float lo = 1.0;
      float hi = 0.0;
      for (int j = 0; j < 4; j++) {
        for (int i = 0; i < 4; i++) {
          float v = dot(float3(art.eval((float2(float(i), float(j)) + 0.5) / 4.0).rgb), float3(0.299, 0.587, 0.114));
          lo = min(lo, v);
          hi = max(hi, v);
        }
      }
      half3 s = art.eval((g + 0.5) / cells).rgb;
      float span = max(hi - lo, 0.2);
      float base = mix(lo, hi - span, smoothstep(0.3, 0.7, lo));
      float l = clamp((dot(float3(s), float3(0.299, 0.587, 0.114)) - base) / span, 0.0, 1.0);
      float2 o = mod(g, 2.0);
      float2 h = mod(floor(g / 2.0), 2.0);
      float t = (4.0 * mod(2.0 * o.x + 3.0 * o.y, 4.0) + mod(2.0 * h.x + 3.0 * h.y, 4.0) + 0.5) / 16.0;
      bool lightInk = dot(float3(ink.rgb), float3(0.333)) > dot(float3(bg.rgb), float3(0.333));
      bool inked = lightInk ? l > t : l < t;
      float2 f = fract(p / c);
      half4 col = plate;
      if (inked && f.x < 0.84 && f.y < 0.84) { col = ink; }
      return half4(col.rgb * col.a, col.a);
    }
  """

  fps: view == "snake" && sPlay ? (modes.saver ? 20 : 30) : revealK != "" && revealN > 1 ? (modes.saver ? 15 : 30) : typing ? 2 : mPlaying ? (modes.saver ? 4 : 8) : 1

  // ---- triggers ----
  // One clock for every countdown. A jump means home is back (the screen was off or an app was in front): the light
  // wakes, a game pauses, and after more than 30 seconds away the LCD goes back to its idle screen.
  on sec {
    if value - old > 4 {
      lit = WAKE
      flashN = 0
      volN = 0
      down = ""
      navZ = ""
      sPlay = false
      if value - old > 30 {
        q = ""
        sel = 0
        view = ""
        tx = ""
        mFolder = ""
      }
    } else {
      if view == "snake" && sPlay {
        lit = LIT
      } else if lit > 0 {
        lit = lit - 1
      }
      if flashN > 0 { flashN = flashN - 1 }
      if volN > 0 { volN = volN - 1 }
      if revealN > 0 {
        revealN = revealN - 1
        if revealN == 0 { revealK = "" }
      }
    }
  }
  // A touch gives the full light, which marks every notification seen; a wake never reaches it.
  on lit { if value > old && value >= LIT { seenAt = sec } }
  // Something new: the light wakes, and on the idle screen its line types itself in.
  on counts {
    let newK = value[0] > old[0] ? "call" : value[1] > old[1] ? "sms" : value[2] > old[2] ? "note" : ""
    if newK != "" {
      lit = max(lit, WAKE)
      if q == "" && view == "" {
        revealK = newK
        revealAt = time
        revealN = 3
      }
    }
  }
  on plugged {
    flash = !value ? "Unplugged" : bat.charging == true ? "Charging" : "Plugged in"
    flashN = 3
    lit = max(lit, WAKE)
  }
  on charged {
    if value {
      flash = "Battery full"
      flashN = 4
    }
  }
  when view == "player" && song == null { view = "" }
  // Network speed from the counters' change over the time between readings.
  on net { if old != null && value.rx >= old.rx && value.uptime > old.uptime { netDown = (value.rx - old.rx) / (value.uptime - old.uptime); netUp = (value.tx - old.tx) / (value.uptime - old.uptime) } }
  // Once the tasks file shows what was written, it's the one to read again.
  on tf { if tasksPend != null && tasksF == tasksPend { tasksPend = null } }
  // A task ticked, cleared or deleted: written whole.
  on tAct {
    let next = value.op == "clear" ? tTodo : value.op == "delete" ? tasks.filter(x => "${x.id}" != value.id) : tasks.map(x => "${x.id}" == value.id ? merge(x, {done: !x.done}) : x)
    tasksPend = next
    wSeq = wSeq + 1
    wTasks = {n: "${sec}-${wSeq}", j: toJson(next)}
  }
  // OK while typing: a new task is written; an amount, then who it was paid to, then what for, is queued.
  on txGo {
    if tx == "task" {
      if trim(txt) != "" {
        let next = flatten([[{id: sec * 1000 + wSeq % 1000, t: trim(txt), done: false}], tasks])
        tasksPend = next
        wSeq = wSeq + 1
        wTasks = {n: "${sec}-${wSeq}", j: toJson(next)}
        flash = "Task added"
        flashN = 2
      }
      tx = ""
      txt = ""
    }
  }
  // Every commit (green, Select, the picked row, the pixel icon, Go to, a held speed dial) ends up here.
  on go {
    let c = value.c
    if c != null {
      if c.kind == "app" { androidApp(c.key) } else if c.kind == "call" { url("tel:${enc(c.num)}") } else if c.id == "torch" { torch(modes.torch == true ? 0 : 100) } else if c.id == "quiet" { dnd("toggle") } else if c.id == "wifi" { settings("wifi") } else if c.id == "bluetooth" { settings("bluetooth") } else if c.id == "music" { media("toggle") } else if c.id == "next" { media("next") } else if c.id == "settings" { launcher("settings") } else if c.id == "menu" { launcher("drawer") } else if c.id == "style" { launcher("style") } else if c.id == "screen" {
        // The next of the theme's colours for the LCD; Go to stays open to press again.
        let si = range(len(scrs)).find(i => scrs[i] == scr) ?? 0
        scr = scrs[(si + 1) % len(scrs)]
        view = "goto"
        lit = LIT
      } else if c.id == "snake" {
        view = "snake"
        sPlay = false
      }
    }
  }
  // A new game of Snake: four long in the middle, heading right, the food ahead.
  on sNew {
    sSeed = floor(hash(sSeed, sec, time) * 1000000)
    snake = [[7, 6], [6, 6], [5, 6], [4, 6]]
    sDir = [1, 0]
    sNext = [1, 0]
    food = [14, 6]
    sScore = 0
    sAcc = 0
    sDead = false
    sPlay = true
  }
  // Snake moves one cell a step; it dies on its own tail, and eating grows it, scores and lays new food.
  every frame {
    if view == "snake" && sPlay && !sDead && len(snake) > 0 {
      sAcc = sAcc + dt
      if sAcc >= sStep {
        sAcc = min(sAcc - sStep, sStep)
        let d = sNext[0] + sDir[0] == 0 && sNext[1] + sDir[1] == 0 ? sDir : sNext
        sDir = d
        let hx = (snake[0][0] + d[0] + SW) % SW
        let hy = (snake[0][1] + d[1] + SH) % SH
        let eat = hx == food[0] && hy == food[1]
        let body = eat ? snake : snake.take(len(snake) - 1)
        if any(body, s => s[0] == hx && s[1] == hy) {
          sDead = true
          sPlay = false
          if sScore > sBest { sBest = sScore }
          haptic("strong")
          if voice { sound(sBusy) }
        } else {
          snake = [[hx, hy]] + body
          if eat {
            sScore = sScore + 1
            haptic("light")
            let free = range(SW * SH).filter(i => !any(snake, s => s[0] + s[1] * SW == i))
            let f = free[floor(hash(sSeed, sScore, hx, hy) * len(free))]
            food = [f % SW, floor(f / SW)]
          }
        }
      }
    }
  }

  // ---- the LCD ----
  component Status() {
    Row {
      fill: width
      height: 20
      gap: 8
      align: center
      padding: [12, 0]
      // An antenna and four bars, as the old phones drew it.
      Canvas {
        width: 26
        height: 12
        sprite(antenna, 0, 1, 2, fill: ink)
        for i in range(4) {
          rect(12 + i * 3.5, 12 - (i + 1) * 3, 2.2, (i + 1) * 3, fill: i < num(sim.signal, 0) ? ink : alpha(ink, 0.2))
        }
      }
      Spacer { weight: 1 }
      // Away from the idle screen, the time sits here.
      if typing || view != "" {
        Text { text: fmtTime(now, "HH:mm"); font: lcdFont; fontSize: 20; color: ink; maxLines: 1 }
      }
      if modes.dnd {
        Text { text: "Quiet"; font: lcdFont; fontSize: 17; color: lcdC; background: ink; radius: 2; padding: [5, 0]; maxLines: 1 }
      }
      if modes.torch == true {
        Text { text: "Light"; font: lcdFont; fontSize: 17; color: lcdC; background: ink; radius: 2; padding: [5, 0]; maxLines: 1 }
      }
      if !tones {
        Canvas { width: 18; height: 12; sprite(muteArt, 0, 0, 2, fill: ink) }
      }
      // The battery with its level inside; a bolt while charging, and the outline blinks under 15% unplugged.
      if bat != null && bat.charging == true {
        Canvas { width: 6; height: 10; sprite(bolt, 0, 0, 2, fill: ink) }
      }
      Canvas {
        width: 34
        height: 16
        let lv = num(bat.level, 0)
        let low = lv < 15 && bat.charging != true && modes.saver != true && sec % 2 == 1
        rect(0.75, 0.75, 29.5, 14.5, radius: 2.5, stroke: low ? alpha(ink, 0.3) : ink, width: 1.5)
        rect(30.5, 5, 2.5, 6, fill: ink)
        text(bat == null ? "" : "${lv}", 15.25, 8.5, size: 13, font: lcdFont, color: ink, align: "center")
      }
    }
  }

  // A soft key's label; it inverts while its key is held.
  component SoftLabel(t, held, place) {
    Row {
      weight: 1
      justify: place
      Text { text: t; font: lcdFont; fontSize: 24; maxLines: 1; padding: [5, 0]; radius: 2; color: held ? lcdC : ink; background: held ? ink : alpha(ink, 0); animate background: tween(80ms, "out") }
    }
  }

  component Soft() {
    Box {
      fill: width
      height: 30
      Row {
        fill: true
        gap: 4
        align: end
        padding: [8, 0]
        SoftLabel { t: softL; held: down == "softL" && softL != ""; place: "start" }
        SoftLabel { t: softM; held: navZ == "mid" && softM != ""; place: "center" }
        SoftLabel { t: softR; held: down == "softR"; place: "end" }
      }
      // The dot over Menu: the notification LED, blinking for what's new since the last touch.
      Canvas {
        fill: true
        circle(width / 2, 2.5, ledOn ? 3 : 2, fill: ledOn ? ink : alpha(glowC, 0.85))
      }
    }
  }

  // A message, or the volume as ten blocks.
  component Banner() {
    if volN > 0 {
      Row {
        fill: width
        height: 28
        gap: 10
        align: center
        padding: [14, 0]
        Text { text: "Volume"; font: lcdFont; fontSize: 22; color: ink }
        Canvas {
          weight: 1
          height: 14
          for i in range(10) {
            rect(i * width / 10, 0, width / 10 - 3, height, fill: i < round(num(vol.level, 0) / 10) ? ink : alpha(ink, 0.15))
          }
        }
      }
    } else if flashN > 0 {
      Row {
        fill: width
        justify: center
        Text { text: flash; font: lcdFont; fontSize: 22; color: lcdC; background: ink; maxLines: 1; padding: [8, 1]; radius: 2 }
      }
    }
  }

  // The rule across the LCD and the black tab hanging from it on the right, with the time in it.
  component RuleTab() {
    Canvas {
      fill: width
      height: 44
      let tx = width * 0.5
      line(0, 1, width, 1, stroke: ink, width: 2)
      path([[tx, 0], [width, 0], [width, height], [tx + height * 0.9, height]], closed: true, fill: ink)
      // The colon, the face's heartbeat at rest: it dims and comes back once a second.
      text([fmtTime(now, "HH"), {text: ":", color: modes.saver == true || sec % 2 == 0 ? lcdC : alpha(lcdC, 0.3)}, fmtTime(now, "mm")], width - 16, height / 2 + 1, size: 36, font: lcdFont, color: lcdC, align: "end")
    }
  }

  component Idle() {
    Column {
      fill: true
      gap: 0
      Spacer { weight: 1 }
      Text { text: fmtTime(now, "EEE, d MMM"); font: lcdFont; fontSize: 30; color: ink; align: center; maxLines: 1 }
      Spacer { height: 18 }
      for it in lines key it.k {
        Row {
          fill: width
          height: 27
          gap: 10
          align: center
          padding: [16, 0]
          ripple: false
          background: down == "l:" + it.k ? ink : alpha(ink, 0)
          animate background: tween(80ms, "out")
          onPress: down = "l:" + it.k
          // Not it.k: a tap that opens the notification can take the line away before the finger lifts.
          onRelease: { if startsWith(down, "l:") { down = "" } }
          onLongPress: lit = LIT
          onTap: {
            lit = LIT
            haptic("strong")
            if voice { sound(sConnect) }
            if it.k == "call" {
              if phoneApp != null { androidApp(phoneApp.key) }
            } else if it.k == "sms" {
              if msgApp != null { androidApp(msgApp.key) }
            } else if it.k == "note" {
              if len(rest) > 0 { notification("open", rest[0].key) }
            } else if it.k == "bell" {
              androidApp(alarm.app)
            }
          }
          Canvas { width: 22; height: 14; sprite(get(sprites, it.k), 2, 1, 2, fill: down == "l:" + it.k ? lcdC : ink) }
          // A line that just arrived types itself in behind a cursor, then holds.
          if revealK == it.k && revealN > 1 {
            Box {
              weight: 1
              height: 27
              Canvas {
                fill: true
                let s = it.t
                let nc = clamp(floor((time - revealAt) * 32), 0, len(s))
                text(sub(s, 0, nc) + (nc < len(s) ? "_" : ""), 0, height / 2, size: 23, font: lcdFont, color: down == "l:" + it.k ? lcdC : ink)
              }
            }
          } else {
            Text { text: it.t; font: lcdFont; fontSize: 23; color: down == "l:" + it.k ? lcdC : ink; maxLines: 1; weight: 1 }
          }
        }
      }
      if song != null {
        Row {
          fill: width
          height: 27
          gap: 10
          align: center
          padding: [16, 0]
          ripple: false
          background: down == "song" ? ink : alpha(ink, 0)
          animate background: tween(80ms, "out")
          onPress: down = "song"
          onRelease: { if down == "song" { down = "" } }
          onLongPress: lit = LIT
          onTap: { lit = LIT; haptic("medium"); view = "player" }
          Canvas { width: 22; height: 14; sprite(get(sprites, "song"), 4, 1, 2, fill: down == "song" ? lcdC : ink) }
          // A long title scrolls like a ticker, in whole 2 dp steps, only while it plays and the light is on.
          if mPlaying && bl > 0 && len(song) * 9 > lcdW - 70 {
            Canvas {
              weight: 1
              height: 24
              let tw = len(song) * 9 + 48
              let x = -floor(((time * 32) % tw) / 2) * 2
              clip(0, 0, width, height) {
                text(song, x, height / 2, size: 23, font: lcdFont, color: songCol)
                text(song, x + tw, height / 2, size: 23, font: lcdFont, color: songCol)
              }
            }
          } else {
            Text { text: song; font: lcdFont; fontSize: 23; color: songCol; maxLines: 1; weight: 1 }
          }
        }
      }
      Spacer { weight: 1.3 }
      // Messages and the volume show just above the rule, in a slot that keeps the rest still.
      Box { fill: width; height: 30; align: center; Banner { } }
      Spacer { height: 4 }
      RuleTab { }
    }
  }

  // The pick as a 16x16 LCD icon: an app's own silhouette, a command's or a call's pixel art. Tap to open it.
  component PixelIcon() {
    Box {
      size: 48
      ripple: false
      scale: down == "icon" ? 0.92 : 1
      animate scale: spring(0.6, 1400)
      onPress: down = "icon"
      onRelease: { if down == "icon" { down = "" } }
      onLongPress: lit = LIT
      onTap: {
        lit = LIT
        haptic("strong")
        if voice { sound(sConnect) }
        goN = goN + 1
        go = {n: goN, c: cur, t: sec}
        q = ""
        sel = 0
      }
      if cur.kind == "app" {
        if gpu {
          Shader { fill: true; fallback: alpha(lcdC, 0); uniforms: { img: "mask:a:${cur.key}", full: "icon:a:${cur.key}", ink: ink, ghost: alpha(ink, 0.07), span: iconSpan }; code: iconCode }
        } else {
          Image { src: "mask:a:${cur.key}"; tint: ink; fill: true }
        }
      } else if gpu {
        Shader { fill: true; fallback: alpha(lcdC, 0); uniforms: { bits: pxBits, inkc: ink, ghost: alpha(ink, 0.07) }; code: pxCode }
      } else {
        Canvas {
          fill: true
          let art = get(px16, cur.kind == "call" ? "call" : cur.id, px16.menu)
          let cs = width / 16
          for r in range(16) {
            for c in range(16) {
              rect(c * cs + cs * 0.1, r * cs + cs * 0.1, cs * 0.8, cs * 0.8, fill: sub(art[r], c, c + 1) == "x" ? ink : alpha(ink, 0.07))
            }
          }
        }
      }
    }
  }

  // Typing: the matches as a Go to list with an inverted bar, the digits big at the bottom right.
  component Typing() {
    Column {
      fill: true
      gap: 0
      padding: [0, 6, 0, 0]
      if info {
        Column {
          fill: width
          gap: 0
          padding: [14, 0]
          Text { text: "Phone"; font: lcdFont; fontSize: 20; color: faint }
          Text { text: "${dev.maker ?? ""} ${dev.model ?? ""}"; font: lcdFont; fontSize: 28; color: ink; maxLines: 1 }
          Text { text: "Android ${dev.android ?? "…"} · SDK ${dev.sdk ?? "…"}"; font: lcdFont; fontSize: 23; color: ink; maxLines: 1 }
          Text { text: dev.soc ?? ""; font: lcdFont; fontSize: 23; color: ink; maxLines: 1 }
          Text { text: bat == null ? "" : "Battery ${round(num(bat.temp, 0) * 9 / 5 + 32)}°F · ${bat.health ?? "ok"}"; font: lcdFont; fontSize: 23; color: ink; maxLines: 1 }
          Text { text: "Hold # · key tones ${tones ? (soundOk ? "on" : "on, silent now") : "off"}"; font: lcdFont; fontSize: 20; color: faint; maxLines: 1 }
        }
      } else if len(cands) > 0 {
        // The selection is one bar that glides between the rows (31 high, 3 apart).
        Box {
          fill: width
          padding: [6, 0]
          Box { fill: width; height: 31; radius: 2; background: ink; offset: [0, selI * 34]; animate offset: spring(0.8, 900) }
          Column {
            fill: width
            gap: 3
            for c, i in shown key "${c.kind}${c.key ?? c.id ?? c.num}" {
              Row {
                fill: width
                height: 31
                gap: 8
                align: center
                padding: [8, 0]
                ripple: false
                onLongPress: lit = LIT
                onTap: {
                  lit = LIT
                  if i == selI {
                    haptic("strong")
                    if voice { sound(sConnect) }
                    goN = goN + 1
                    go = {n: goN, c: c, t: sec}
                    q = ""
                    sel = 0
                  } else {
                    haptic("light")
                    sel = from + i
                  }
                }
                // The letters the digits spell stand out; the rest of the name is fainter.
                Text {
                  spans: c.kind == "call" ? ["Call ", {text: c.num, color: i == selI ? lcdC : ink}] : c.wi == null ? [c.name] : [sub(c.name, 0, c.off), {text: sub(c.name, c.off, min(c.off + len(q), len(c.name))), color: i == selI ? lcdC : ink}, sub(c.name, min(c.off + len(q), len(c.name)), len(c.name))]
                  font: lcdFont
                  fontSize: 26
                  color: i == selI ? alpha(lcdC, 0.62) : faint
                  maxLines: 1
                  weight: 1
                }
                Text {
                  text: c.kind == "app" ? (c.work ?? "") : c.kind == "call" ? "dial" : c.id == "torch" ? (modes.torch == true ? "on" : "off") : c.id == "quiet" ? (modes.dnd ? "on" : "off") : c.id == "music" ? (mPlaying ? "pause" : "play") : ""
                  font: lcdFont
                  fontSize: 20
                  color: i == selI ? lcdC : faint
                  maxLines: 1
                }
              }
            }
          }
        }
      } else if len(zoneShow) == 0 {
        Text { text: "No match"; font: lcdFont; fontSize: 24; color: faint; padding: [14, 0] }
      }
      Spacer { weight: 1 }
      // Dialling abroad: the time where the call would ring; faint and a moon while they're asleep.
      for z in zoneShow key z.city {
        Row {
          fill: width
          height: 28
          gap: 10
          align: center
          padding: [14, 0]
          let hr = num(fmtTime(now, "H", z.z), 12)
          let night = hr >= 22 || hr < 7
          Canvas { width: 14; height: 14; sprite(hr >= 7 && hr < 19 ? sunArt : moonArt, 0, 0, 2, fill: night ? faint : ink) }
          Text { text: z.city; font: lcdFont; fontSize: 23; color: ink; maxLines: 1; weight: 1 }
          Text { text: fmtTime(now, "EEE HH:mm", z.z); font: lcdFont; fontSize: 23; color: night ? faint : ink; maxLines: 1 }
        }
      }
      Box { fill: width; height: 30; align: center; Banner { } }
      Row {
        fill: width
        height: 64
        gap: 0
        align: center
        padding: [12, 0, 10, 0]
        if cur != null && len(q) <= 8 {
          PixelIcon { }
        }
        Spacer { weight: 1 }
        Text { text: q; font: lcdFont; fontSize: len(q) > 12 ? 40 : 64; color: ink; maxLines: 1 }
        Canvas {
          width: 12
          height: 46
          // It blinks while the light is on; at rest it stays, so nothing animates.
          if bl == 0 || floor(time * 2) % 2 == 0 { rect(4, 6, 5, 36, fill: ink) }
        }
      }
    }
  }

  // Go to: shortcuts in a list, the selection inverted; up and down move it, the centre or a tap opens.
  component GoTo() {
    Column {
      fill: true
      gap: 0
      Text { text: "Go to"; font: lcdFont; fontSize: 22; color: ink; align: center; maxLines: 1 }
      Spacer { height: 6 }
      Box {
        fill: width
        padding: [6, 0]
        Box { fill: width; height: 32; radius: 2; background: ink; offset: [0, gSelI * 35]; animate offset: spring(0.8, 900) }
        Column {
          fill: width
          gap: 3
          for g, i in gShown key g.name {
            Row {
              fill: width
              height: 32
              gap: 8
              align: center
              padding: [8, 0]
              ripple: false
              onLongPress: lit = LIT
              onTap: {
                lit = LIT
                if i == gSelI {
                  haptic("strong")
                  if voice { sound(sConnect) }
                  view = ""
                  goN = goN + 1
                  go = {n: goN, c: g, t: sec}
                } else {
                  haptic("light")
                  gsel = gFrom + i
                }
              }
              Text { text: g.name; font: lcdFont; fontSize: 27; color: i == gSelI ? lcdC : ink; maxLines: 1; weight: 1 }
              Text {
                text: g.id == "torch" ? (modes.torch == true ? "on" : "off") : g.id == "quiet" ? (modes.dnd ? "on" : "off") : g.id == "music" ? (mPlaying ? "pause" : "play") : g.id == "snake" && sBest > 0 ? "best ${sBest}" : g.id == "screen" ? scr : ""
                font: lcdFont
                fontSize: 20
                color: i == gSelI ? lcdC : faint
                maxLines: 1
              }
            }
          }
        }
      }
      Spacer { weight: 1 }
      // A scroll mark when the list runs past the screen.
      if len(gotoItems) > gRows {
        Canvas {
          fill: width
          height: 8
          let n2 = len(gotoItems)
          for i in range(n2) {
            rect(width / 2 - n2 * 4 + i * 8 + 1, 2, 5, 4, fill: i == gAt ? ink : alpha(ink, 0.22))
          }
        }
      }
      Box { fill: width; height: 30; align: center; Banner { } }
    }
  }

  // Snake, on the LCD: the score and the best above a walled field; 2 4 6 8 steer, 5 or the centre pauses.
  component Snake() {
    Column {
      fill: true
      gap: 4
      padding: [12, 2, 12, 4]
      Row {
        fill: width
        height: 22
        align: center
        Text { text: sScoreS; font: lcdFont; fontSize: 24; color: ink; weight: 1; maxLines: 1 }
        Text { text: "Best ${sBest}"; font: lcdFont; fontSize: 20; color: faint; maxLines: 1 }
      }
      Canvas {
        weight: 1
        fill: width
        let cs = floor(min((width - 8) / SW, (height - 8) / SH))
        let fw = cs * SW
        let fh = cs * SH
        let x0 = floor((width - fw) / 2)
        let y0 = floor((height - fh) / 2)
        rect(x0 - 3, y0 - 3, fw + 6, fh + 6, stroke: ink, width: 2)
        for s in snake {
          rect(x0 + s[0] * cs + 1, y0 + s[1] * cs + 1, cs - 2, cs - 2, fill: ink)
        }
        let fx = x0 + food[0] * cs
        let fy = y0 + food[1] * cs
        if sState != "start" {
          path([[fx + cs / 2, fy + 1], [fx + cs - 1, fy + cs / 2], [fx + cs / 2, fy + cs - 1], [fx + 1, fy + cs / 2]], closed: true, fill: ink)
        }
        if sState != "play" {
          let msg = sState == "over" ? "Game over" : sState == "pause" ? "Paused" : "Snake"
          let hint = sState == "over" ? "Score ${sScore} · 5 plays again" : sState == "pause" ? "5 goes on" : "2 4 6 8 steer · 5 starts"
          // A small box near the top, so a paused snake still shows where it is.
          rect(x0 + fw * 0.15, y0 + cs, fw * 0.7, 54, fill: lcdC)
          rect(x0 + fw * 0.15, y0 + cs, fw * 0.7, 54, stroke: ink, width: 2)
          text(msg, x0 + fw / 2, y0 + cs + 18, size: 26, font: lcdFont, color: ink, align: "center")
          text(hint, x0 + fw / 2, y0 + cs + 40, size: 18, font: lcdFont, color: ink, align: "center")
        }
      }
    }
  }

  // What's playing, as an LCD would show it: the cover in dots, a ticker, who and where, blocks and times.
  component Player() {
    Column {
      fill: true
      gap: 0
      align: center
      padding: [14, 0]
      Spacer { weight: 1 }
      Box {
        size: artS
        radius: 2
        clip: true
        if m.art != null {
          if gpu {
            Shader { fill: true; fallback: lcdC; uniforms: { art: mArt, ink: ink, plate: lcdC, bg: lcdC, cells: floor(artS / 3) }; code: coverCode }
          } else {
            Image { src: m.art; fit: cover; fill: true; opacity: 0.85 }
          }
        } else if gpu {
          Shader { fill: true; fallback: alpha(lcdC, 0); uniforms: { bits: noteBits, inkc: ink, ghost: alpha(ink, 0.07) }; code: pxCode }
        } else {
          Canvas {
            fill: true
            let art = px16.music
            let cs = width / 16
            for r in range(16) {
              for c in range(16) {
                rect(c * cs + cs * 0.1, r * cs + cs * 0.1, cs * 0.8, cs * 0.8, fill: sub(art[r], c, c + 1) == "x" ? ink : alpha(ink, 0.07))
              }
            }
          }
        }
      }
      Spacer { height: 10 }
      Box {
        fill: width
        height: 28
        align: center
        let s = mTitle ?? ""
        // A long title scrolls only while it plays and the light is on.
        if mPlaying && bl > 0 && len(s) * 9 > lcdW - 32 {
          Canvas {
            fill: true
            let tw = len(s) * 9 + 48
            let x = -floor(((time * 32) % tw) / 2) * 2
            clip(0, 0, width, height) {
              text(s, x, height / 2, size: 24, font: lcdFont, color: ink)
              text(s, x + tw, height / 2, size: 24, font: lcdFont, color: ink)
            }
          }
        } else {
          Text { text: s; font: lcdFont; fontSize: 24; color: ink; maxLines: 1; align: center }
        }
      }
      Text { text: songBy; font: lcdFont; fontSize: 20; color: faint; maxLines: 1; align: center }
      Spacer { weight: 1 }
      Canvas {
        fill: width
        height: 12
        let f = num(m.duration, 0) > 0 ? clamp(num(m.position, 0) / m.duration, 0, 1) : 0
        for i in range(20) {
          rect(i * width / 20, 0, width / 20 - 2, height, fill: i < round(f * 20) ? ink : alpha(ink, 0.15))
        }
      }
      Spacer { height: 4 }
      Row {
        fill: width
        gap: 8
        Text { text: fmtTime(num(m.position, 0), num(m.duration, 0) >= 3600 ? "H:mm:ss" : "m:ss", "UTC"); font: lcdFont; fontSize: 21; color: ink; maxLines: 1; weight: 1 }
        Text { text: num(m.duration, 0) > 0 ? fmtTime(m.duration, m.duration >= 3600 ? "H:mm:ss" : "m:ss", "UTC") : ""; font: lcdFont; fontSize: 21; color: faint; maxLines: 1 }
      }
      Box { fill: width; height: 30; align: center; Banner { } }
    }
  }

  // ---- the t9's own screens, drawn on the LCD ----
  component Title(tt) {
    Text { text: tt; font: lcdFont; fontSize: 22; color: ink; align: center; maxLines: 1 }
  }

  // A list row, inverted while it's the selection: a line with a value at its end, or that and a fainter line.
  component Row1(a, v, sel, dim) {
    Row {
      fill: true
      gap: 8
      align: center
      padding: [8, 0]
      radius: 2
      background: sel ? ink : alpha(ink, 0)
      Text { text: a; font: lcdFont; fontSize: 24; color: sel ? lcdC : dim ? faint : ink; maxLines: 1; weight: 1 }
      if v != "" {
        Text { text: v; font: lcdFont; fontSize: 20; color: sel ? lcdC : faint; maxLines: 1 }
      }
    }
  }
  component Row2(a, b, v, sel) {
    Column {
      fill: true
      gap: 0
      padding: [8, 2]
      radius: 2
      background: sel ? ink : alpha(ink, 0)
      Row {
        fill: width
        gap: 8
        align: center
        Text { text: a; font: lcdFont; fontSize: 23; color: sel ? lcdC : ink; maxLines: 1; weight: 1 }
        if v != "" {
          Text { text: v; font: lcdFont; fontSize: 18; color: sel ? lcdC : faint; maxLines: 1 }
        }
      }
      Text { text: b; font: lcdFont; fontSize: 18; color: sel ? alpha(lcdC, 0.8) : faint; maxLines: 1 }
    }
  }

  // The drawer (Menu): your iOS pages on the LCD, icons 4 across in LCD pixels with their names when there's room, the
  // dock under a dotted line, the selected one inverted and named in full on top; pages swipe sideways and show as
  // dots (the t9's own page as a square). Tap one to open it.
  component DIcon(it, on, sz) {
    Box {
      size: sz
      if it.kind == "app" {
        if gpu {
          Shader { fill: true; fallback: alpha(lcdC, 0); uniforms: { img: "mask:${it.key}", full: "icon:${it.key}", ink: on ? lcdC : ink, ghost: alpha(on ? lcdC : ink, 0.08), span: iconSpan }; code: iconCode }
        } else {
          Image { src: "mask:${it.key}"; tint: on ? lcdC : ink; fill: true }
        }
      } else if gpu {
        Shader { fill: true; fallback: alpha(lcdC, 0); uniforms: { bits: it.kind == "folder" ? (t9Bits.find(b => b.k == "folder")).b : it.id == "player" ? musicBits : it.id == "snake" ? snakeBits : (t9Bits.find(b => b.k == it.id)).b, inkc: on ? lcdC : ink, ghost: alpha(on ? lcdC : ink, 0.08) }; code: pxCode }
      } else {
        Text { text: sub(it.name, 0, 1); font: lcdFont; fontSize: sz * 0.7; color: on ? lcdC : ink; align: center; fill: true }
      }
    }
  }

  component Drawer() {
    Column {
      fill: true
      gap: 0
      padding: [6, 0, 6, 0]
      Title { tt: (mFold == null ? "" : mFold.name + " > ") + (mCur.name ?? "") }
      Spacer { height: 4 }
      Box {
        fill: width
        weight: 1
        onDrag: mDrag = mDrag + dx
        onDragEnd: {
          lit = LIT
          if mDrag < -40 && mPg < mPages - 1 {
            haptic("light")
            mPage = mPg + 1
            mSel = 0
          } else if mDrag > 40 && mPg > 0 {
            haptic("light")
            mPage = mPg - 1
            mSel = 0
          }
          mDrag = 0
        }
        Column {
          fill: true
          gap: 0
          Grid {
            columns: 4
            gap: 0
            fill: width
            for it, i in mGrid key "${mPg}-${i}" {
              Box {
                fill: width
                height: dCellH
                align: center
                ripple: false
                onTap: {
                  lit = LIT
                  mSel = i
                  if it.kind == "folder" {
                    haptic("medium")
                    mBack = {p: mPg, s: i}
                    mFolder = it.id
                    mPage = 0
                    mSel = 0
                  } else if it.kind == "t9" {
                    haptic("medium")
                    if it.id == "player" && song == null {
                      flash = "Nothing playing"
                      flashN = 2
                    } else {
                      view = it.id
                      lSel = 0
                      calDay = 0
                      sPlay = false
                    }
                  } else {
                    haptic("strong")
                    if voice { sound(sConnect) }
                    open(it.key)
                  }
                }
                onLongPress: lit = LIT
                Column {
                  fill: width
                  height: dCellH - 2
                  gap: 0
                  align: center
                  justify: center
                  padding: [2, 1]
                  radius: 3
                  background: i == mSelC ? ink : alpha(ink, 0)
                  DIcon { it: it; on: i == mSelC; sz: dIcon }
                  if dLabels {
                    Text { text: it.name; font: lcdFont; fontSize: 13; color: i == mSelC ? lcdC : ink; align: center; maxLines: 1; fill: width }
                  }
                }
              }
            }
          }
          Spacer { weight: 1 }
          // The dock, as iOS keeps it under every page.
          if len(mDock) > 0 {
            Canvas {
              fill: width
              height: 4
              for d in range(floor(width / 6)) {
                rect(d * 6 + 1, 1, 3, 2, fill: alpha(ink, 0.35))
              }
            }
            Row {
              fill: width
              height: dDockH - 4
              gap: 0
              for it, j in mDock key "dock-${j}" {
                Box {
                  weight: 1
                  fill: height
                  align: center
                  ripple: false
                  onTap: {
                    lit = LIT
                    mSel = mN + j
                    haptic("strong")
                    if voice { sound(sConnect) }
                    open(it.key)
                  }
                  onLongPress: lit = LIT
                  Box {
                    width: dDockH
                    height: dDockH - 6
                    radius: 3
                    align: center
                    background: mN + j == mSelC ? ink : alpha(ink, 0)
                    DIcon { it: it; on: mN + j == mSelC; sz: dDockH - 10 }
                  }
                }
              }
            }
          }
        }
      }
      // Which page, as dots; the t9's own page is a square.
      Canvas {
        fill: width
        height: 10
        for i in range(mPages) {
          if mFold == null && i == 0 {
            rect(width / 2 + (i - (mPages - 1) / 2) * 11 - (i == mPg ? 3 : 2), 5 - (i == mPg ? 3 : 2), i == mPg ? 6 : 4, i == mPg ? 6 : 4, fill: i == mPg ? ink : alpha(ink, 0.3))
          } else {
            circle(width / 2 + (i - (mPages - 1) / 2) * 11, 5, i == mPg ? 3 : 2, fill: i == mPg ? ink : alpha(ink, 0.3))
          }
        }
      }
    }
  }

  // The calendar: the picked day's month (today inverted, the picked day boxed, a dot under days with events), and
  // that day's agenda. The nav key moves a day (left, right) or a week (up, down); tap a day to pick it.
  component Cal() {
    Column {
      fill: true
      gap: 0
      padding: [8, 0, 8, 0]
      Title { tt: fmtTime(selNoon, "MMMM yyyy") }
      Row {
        fill: width
        height: 18
        for w, i in ["S", "M", "T", "W", "T", "F", "S"] key i {
          Text { text: w; font: lcdFont; fontSize: 17; color: faint; align: center; weight: 1 }
        }
      }
      Grid {
        columns: 7
        gap: 0
        fill: width
        for c, i in calCells key c.k {
          Box {
            fill: width
            height: calCellH
            align: center
            ripple: false
            onTap: {
              lit = LIT
              if c.d >= 1 && c.d <= dim {
                haptic("light")
                calDay = c.t
              }
            }
            onLongPress: lit = LIT
            if c.d >= 1 && c.d <= dim {
              Box {
                width: 34
                height: calCellH - 3
                radius: 2
                align: center
                background: c.k == todayKey ? ink : alpha(ink, 0)
                border: c.k == selKey ? 2 : 0
                borderColor: c.k == todayKey ? lcdC : ink
                Text { text: "${c.d}"; font: lcdFont; fontSize: 20; color: c.k == todayKey ? lcdC : ink; align: center }
              }
              if calDots[i] {
                Canvas { fill: true; circle(width / 2, height - 3, 1.8, fill: c.k == todayKey ? lcdC : ink) }
              }
            }
          }
        }
      }
      Spacer { height: 4 }
      if calNeedsOk {
        Box {
          fill: width
          height: 30
          ripple: false
          onTap: { lit = LIT; calendar("request") }
          onLongPress: lit = LIT
          Row1 { a: "Allow the calendar"; v: ">"; sel: true; dim: false }
        }
      } else {
        Text { text: fmtTime(selNoon, "EEEE d MMMM") + (len(dayEvents) == 0 ? " · nothing on" : ""); font: lcdFont; fontSize: 18; color: faint; maxLines: 1; padding: [8, 0] }
        for e in dayEvents.take(3) key e.id {
          Box {
            fill: width
            height: 27
            ripple: false
            onTap: { lit = LIT; haptic("medium"); calendar("open", e) }
            onLongPress: lit = LIT
            Row1 { a: e.title; v: e.allDay ? "all day" : fmtTime(e.start, "h:mm a"); sel: false; dim: false }
          }
        }
        if len(dayEvents) > 3 {
          Text { text: "+${len(dayEvents) - 3} more"; font: lcdFont; fontSize: 17; color: faint; padding: [8, 0] }
        }
      }
    }
  }

  // Agents: Claude Code running (* busy, o idle), sessions to pick up again, something new. Open runs it in a terminal.
  component Agents() {
    Column {
      fill: true
      gap: 2
      padding: [6, 0, 6, 0]
      Title { tt: agTitle }
      for r, i in lShown key "${r.k}${r.id}" {
        Box {
          fill: width
          height: 44
          ripple: false
          onTap: {
            lit = LIT
            if i == lSelI {
              haptic("strong")
              if r.k == "new" {
                if r.id == "claude" { terminal("cd ~ && claude", "claude") } else if r.id == "codex" { terminal("cd ~ && codex", "codex") } else { terminal("cd ~ && exec bash -l", "shell") }
              } else if r.k == "codex" {
                terminal("cd ${sh(r.dir)} && codex resume ${sh(r.id)}", "codex")
              } else if r.k == "run" {
                terminal("cd ${sh(r.dir)} && exec bash -l", "shell")
              } else {
                terminal("cd ${sh(r.dir)} && claude --resume ${sh(r.id)}", "claude")
              }
            } else {
              haptic("light")
              lSel = lFrom + i
            }
          }
          onLongPress: lit = LIT
          Row2 { a: (r.k == "run" ? (r.hot ? "* " : "o ") : "") + r.name; b: (r.k == "codex" ? "Codex · " : r.k == "new" ? "" : "Claude Code · ") + r.place; v: r.note; sel: i == lSelI }
        }
      }
    }
  }

  // Limits: each service's heading (the selected one inverted; Usage opens its page), then each window as blocks.
  component Limits() {
    Column {
      fill: true
      gap: 2
      padding: [8, 0, 8, 0]
      Title { tt: "Limits" }
      for s, si in [{nm: "Claude" + (cuPlan == null ? "" : " · " + cuPlan), e: cuErr ?? (cl.at == null ? "" : fmtAgo(min(cl.at, now), now) + " ago"), rows: limCl}, {nm: "Codex" + (gxPlan == null ? "" : " · " + gxPlan), e: gxErr ?? (gu.at == null ? "" : fmtAgo(min(gu.at, now), now) + " ago"), rows: limGx}] key si {
        Column {
          fill: width
          gap: 0
          Box {
            fill: width
            height: 30
            ripple: false
            onTap: {
              lit = LIT
              if lSel == si {
                haptic("strong")
                url(si == 0 ? "https://claude.ai/settings/usage" : "https://chatgpt.com/codex/settings/usage")
              } else {
                haptic("light")
                lSel = si
              }
            }
            onLongPress: lit = LIT
            Row1 { a: s.nm; v: s.e; sel: lSel == si; dim: false }
          }
          for w, wi in s.rows key wi {
            Column {
              fill: width
              gap: 1
              padding: [8, 2]
              Row {
                fill: width
                Text { text: w.t; font: lcdFont; fontSize: 20; color: ink; weight: 1; maxLines: 1 }
                Text { text: "${round(w.p)}%"; font: lcdFont; fontSize: 20; color: ink; maxLines: 1 }
              }
              Canvas {
                fill: width
                height: 9
                for b in range(20) {
                  rect(b * width / 20, 0, width / 20 - 2, height, fill: b < round(clamp(w.p, 0, 100) / 5) ? ink : alpha(ink, 0.15))
                }
              }
              Text { text: w.v; font: lcdFont; fontSize: 16; color: faint; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  // Tasks: [ ] to do, [x] done; Done ticks the selected one, Add types a new one, holding one deletes it.
  component Tasks() {
    Column {
      fill: true
      gap: 2
      padding: [6, 0, 6, 0]
      Title { tt: len(tTodo) > 0 ? "Tasks · ${len(tTodo)} to do" : "Tasks" }
      if lN == 0 {
        Text { text: linux ? "Nothing to do" : "Linux is off"; font: lcdFont; fontSize: 22; color: faint; align: center; padding: [0, 16] }
      }
      for r, i in lShown key "${r.id}" {
        Box {
          fill: width
          height: 32
          ripple: false
          onTap: {
            lit = LIT
            if i == lSelI {
              haptic("medium")
              tAct = {n: tAct.n + 1, op: r.clear == true ? "clear" : "toggle", id: "${r.id}"}
            } else {
              haptic("light")
              lSel = lFrom + i
            }
          }
          onLongPress: {
            lit = LIT
            if r.clear != true {
              haptic("strong")
              tAct = {n: tAct.n + 1, op: "delete", id: "${r.id}"}
              flash = "Task deleted"
              flashN = 2
            }
          }
          Row1 { a: r.clear == true ? r.t : (r.done ? "[x] " : "[ ] ") + r.t; v: ""; sel: i == lSelI; dim: r.done == true }
        }
      }
    }
  }

  // Inbox: every notification, newest first; Open opens it, Clear clears it, holding one snoozes it for an hour.
  component Inbox() {
    Column {
      fill: true
      gap: 2
      padding: [6, 0, 6, 0]
      Title { tt: lN == 0 ? "Inbox" : "Inbox · ${lN}" }
      if lN == 0 {
        Text { text: n.available ? "Nothing new" : "Allow notification access"; font: lcdFont; fontSize: 22; color: faint; align: center; padding: [0, 16] }
      }
      for r, i in lShown key r.key {
        Box {
          fill: width
          height: 44
          ripple: false
          onTap: {
            lit = LIT
            if i == lSelI {
              haptic("strong")
              notification("open", r.key)
            } else {
              haptic("light")
              lSel = lFrom + i
            }
          }
          onLongPress: {
            lit = LIT
            haptic("medium")
            notification("snooze", r.key, 3600)
            flash = "Snoozed for an hour"
            flashN = 2
          }
          Row2 { a: (r.app ?? "") + (r.title == null || r.title == "" ? "" : ": " + r.title); b: r.text ?? ""; v: r.time == null ? "" : fmtAgo(min(r.time, now), now); sel: i == lSelI }
        }
      }
    }
  }

  // Vitals: the phone's battery, memory, storage, network and uptime.
  component Vitals() {
    Column {
      fill: true
      gap: 3
      padding: [10, 0, 10, 0]
      Title { tt: "Vitals" }
      for r, i in vitRows key r.t {
        Column {
          fill: width
          gap: 1
          Row {
            fill: width
            gap: 8
            align: center
            Text { text: r.t; font: lcdFont; fontSize: 19; color: faint; maxLines: 1 }
            Text { text: r.v; font: lcdFont; fontSize: 21; color: ink; maxLines: 1; weight: 1; align: end }
          }
          if r.p != null {
            Canvas {
              fill: width
              height: 7
              for b in range(25) {
                rect(b * width / 25, 0, width / 25 - 2, height, fill: b < round(clamp(r.p, 0, 100) / 4) ? ink : alpha(ink, 0.15))
              }
            }
          }
        }
      }
    }
  }

  // Switches: the phone's switches and settings panels, and the launcher's own screens.
  component Switches() {
    Column {
      fill: true
      gap: 2
      padding: [6, 0, 6, 0]
      Title { tt: "Switches" }
      for r, i in lShown key r.id {
        Box {
          fill: width
          height: 32
          ripple: false
          onTap: {
            lit = LIT
            if i == lSelI {
              haptic("medium")
              if r.id == "torch" { torch(modes.torch == true ? 0 : 100) } else if r.id == "quiet" { dnd("toggle") } else if r.id == "files" { if linux { open("l:omarchy-files") } else { launcher("linux") } } else if r.id == "agentsL" { launcher("agents") } else if r.id == "style" { launcher("style") } else if r.id == "store" { launcher("store") } else if r.id == "lsettings" { launcher("settings") } else { settings(r.id) }
            } else {
              haptic("light")
              lSel = lFrom + i
            }
          }
          onLongPress: lit = LIT
          Row1 { a: r.t; v: r.v; sel: i == lSelI; dim: false }
        }
      }
    }
  }

  // Typing the old way: press a key once for its first letter, again within a second for the next; # changes case,
  // 0 is a space, hold a key for its digit.
  component Entry() {
    Column {
      fill: true
      gap: 4
      padding: [12, 2, 12, 4]
      Title { tt: txTitle }
        Box {
          fill: width
          weight: 1
          padding: [8, 6]
          radius: 2
          background: alpha(ink, 0.07)
          Text { text: txt + "_"; font: lcdFont; fontSize: 26; color: ink; maxLines: 5 }
        }
        Row {
          fill: width
          align: center
          Text { text: ["abc", "Abc", "ABC", "123"][txCase]; font: lcdFont; fontSize: 18; color: lcdC; background: ink; padding: [5, 0]; radius: 2; maxLines: 1 }
          Spacer { weight: 1 }
          Text { text: "# changes case"; font: lcdFont; fontSize: 17; color: faint; maxLines: 1 }
        }
    }
  }

  component Lcd() {
    Box {
      fill: true
      radius: 12
      clip: true
      background: lcdC
      animate background: tween(450ms, "ease")
      // 1 · the light guide's slow wash: it warms up as the light comes on and is the afterglow as it goes.
      if gpu {
        Shader { fill: true; fallback: alpha(background, 0); opacity: bl; animate opacity: tween(1600ms, "out"); uniforms: { glow: glowC, bg: background }; code: washCode }
      } else {
        Box { fill: true; opacity: bl; animate opacity: tween(1600ms, "out"); background: linear(0, 0, 0, 1, [alpha(glowC, 0), alpha(glowC, 0.04), alpha(glowC, 0.16)]) }
      }
      // 2 · three LEDs under the bottom edge: they snap on and off.
      Box {
        fill: true
        opacity: bl
        animate opacity: tween(140ms, "out")
        Shader { fill: true; fallback: alpha(background, 0); uniforms: { glow: glowC, bg: background }; code: guideCode }
      }
      // 3 · the pixel grid under the ink, and the bezel's recess shadow under its top edge.
      Shader { fill: true; fallback: alpha(background, 0); uniforms: { gap: alpha(background, night ? 0.22 : 0.1), fg: foreground, wdp: lcdW }; code: gridCode }
      if !gpu {
        Box { fill: width; height: 10; background: linear(0, 0, 0, 1, [alpha(background, 0.28), alpha(background, 0)]) }
      }
      // 4 · the ink, which sits back while the light is off on the night screen.
      Column {
        fill: true
        gap: 0
        padding: [0, 9, 0, 6]
        opacity: inkLvl
        animate opacity: tween(220ms, "out")
        Status { }
        if tx != "" { Entry { weight: 1; fill: width } } else if view == "player" { Player { weight: 1; fill: width } } else if view == "snake" { Snake { weight: 1; fill: width } } else if view == "goto" { GoTo { weight: 1; fill: width } } else if view == "menu" { Drawer { weight: 1; fill: width } } else if view == "cal" { Cal { weight: 1; fill: width } } else if view == "agents" { Agents { weight: 1; fill: width } } else if view == "limits" { Limits { weight: 1; fill: width } } else if view == "tasks" { Tasks { weight: 1; fill: width } } else if view == "inbox" { Inbox { weight: 1; fill: width } } else if view == "vitals" { Vitals { weight: 1; fill: width } } else if view == "switches" { Switches { weight: 1; fill: width } } else if typing { Typing { weight: 1; fill: width } } else { Idle { weight: 1; fill: width } }
        Soft { }
      }
    }
  }

  // ---- the body: soft rounded keys raised off it ----
  // A raised key, drawn by the pillow shader with room round it for its shadow; centred where it's placed.
  component Pillow(on, w, h) {
    Box {
      width: w + 2 * PM
      height: h + 2 * PM
      align: center
      if gpu {
        Shader { fill: true; fallback: alpha(bodyC, 0); uniforms: { cap: [w, h], rad: h * 0.3, m: PM, down: on ? 1 : 0, body: bodyC }; code: pillowCode }
      } else {
        Box { width: w; height: h; radius: h * 0.3; background: on ? alpha(#000000, 0.3) : linear(0, 0, 0, 1, [alpha(#ffffff, 0.035), alpha(#ffffff, 0), alpha(#000000, 0.3)]) }
      }
    }
  }

  // A handset, as the old keys had it printed: a curve and its two ends, glowing.
  component Handset(c, ring) {
    Canvas {
      width: 60
      height: 40
      for g in [[11, 0.035], [7.5, 0.05], [4.5, 0.08], [2, 0.12], [0, 1]] {
        arc(30, 30, 18, -66, 132, stroke: alpha(c, g[1]), width: 4.4 + g[0], cap: round)
        line(13.6, 22.7, 11.2, 29.2, stroke: alpha(c, g[1]), width: 6.4 + g[0], cap: round)
        line(46.4, 22.7, 48.8, 29.2, stroke: alpha(c, g[1]), width: 6.4 + g[0], cap: round)
        if ring { circle(30, 27.5, 4.6, stroke: alpha(c, g[1]), width: 2.2 + g[0] * 0.6) }
      }
    }
  }

  // A soft key's dash, glowing: a soft light round it, fading out, and the dash.
  component Dash() {
    Box {
      width: 64
      height: 18
      align: center
      Box { width: 64; height: 18; opacity: haloLvl; background: radial(0.5, 0.5, 0.5, [alpha(haloC, 0.18), alpha(haloC, 0.06), alpha(haloC, 0)]) }
      Box { width: 46; height: 4; radius: 2; background: printC }
    }
  }

  component Nav() {
    Row {
      fill: width
      height: navH
      gap: 0
      align: center
      padding: [kpPad, 0]
      Column {
        width: colP
        fill: height
        gap: 0
        // Left soft key: Go to (Prev in the player; held, ten seconds back).
        Box {
          fill: width
          height: softBH
          align: center
          ripple: false
          onPress: down = "softL"
          onRelease: { if down == "softL" { down = "" } }
          onTap: {
            lit = LIT
            haptic("medium")
            if tx != "" {
              txGo = txGo + 1
            } else if view == "player" {
              media("previous")
            } else if view == "cal" {
              calDay = 0
            } else if view == "agents" {
              terminal("cd ~ && claude", "claude")
            } else if view == "tasks" {
              tx = "task"
              txt = ""
              txKey = ""
              txCase = 1
            } else if view == "inbox" {
              if lCur != null && lCur.clearable == true { notification("dismiss", lCur.key) }
            } else if view == "" && !typing {
              view = "goto"
              gsel = 0
            }
          }
          onLongPress: {
            lit = LIT
            if tx != "" {
              txGo = txGo + 1
            } else if view == "inbox" {
              notification("clear")
              flash = "Cleared"
              flashN = 2
            } else if view == "player" {
              if m.canSeek == true {
                media("seek", max(0, num(m.position, 0) - 10))
              } else {
                flash = "Can't seek"
                flashN = 2
              }
            } else if view == "" && !typing {
              view = "goto"
              gsel = 0
            }
          }
          Pillow { on: down == "softL"; w: keyW; h: softKH }
          Box { width: 64; height: 18; offset: [0, down == "softL" ? 1.5 : 0]; animate offset: spring(0.62, 1600); Dash { } }
        }
        // Call: what's picked, or the phone app; the player's own screen in the player.
        Box {
          fill: width
          weight: 1
          align: center
          ripple: false
          onPress: down = "call"
          onRelease: { if down == "call" { down = "" } }
          onTap: {
            lit = LIT
            if view == "player" {
              haptic("strong")
              media("open")
            } else if view == "snake" {
              haptic("light")
            } else if view == "goto" {
              haptic("strong")
              if voice { sound(sConnect) }
              view = ""
              goN = goN + 1
              go = {n: goN, c: gCur, t: sec}
            } else if info {
              haptic("medium")
              q = ""
              sel = 0
            } else if typing {
              if cur != null {
                haptic("strong")
                if voice { sound(sConnect) }
                goN = goN + 1
                go = {n: goN, c: cur, t: sec}
                q = ""
                sel = 0
              } else {
                haptic("medium")
                if voice { sound(sNope) }
              }
            } else if sec >= num(go.t, 0) && sec - num(go.t, 0) < 2 {
              // A second press right after opening something: the new app is on its way, so nothing more.
              haptic("medium")
            } else {
              haptic("strong")
              if voice { sound(sConnect) }
              if phoneApp != null { androidApp(phoneApp.key) } else { url("tel:") }
            }
          }
          // Held, it does the same (the launcher gives the buzz), so a slow press still calls.
          onLongPress: {
            lit = LIT
            if view == "player" {
              media("open")
            } else if view == "goto" {
              if voice { sound(sConnect) }
              view = ""
              goN = goN + 1
              go = {n: goN, c: gCur, t: sec}
            } else if view == "snake" {
              lit = LIT
            } else if info {
              q = ""
              sel = 0
            } else if typing {
              if cur != null {
                if voice { sound(sConnect) }
                goN = goN + 1
                go = {n: goN, c: cur, t: sec}
                q = ""
                sel = 0
              } else {
                if voice { sound(sNope) }
              }
            } else if sec >= num(go.t, 0) && sec - num(go.t, 0) < 2 {
              lit = LIT
            } else {
              if voice { sound(sConnect) }
              if phoneApp != null { androidApp(phoneApp.key) } else { url("tel:") }
            }
          }
          Pillow { on: down == "call"; w: keyW; h: keyH }
          // It rocks like a ringing phone for two minutes after a missed call.
          Box {
            width: 60
            height: 40
            offset: [0, down == "call" ? 1.5 : 0]
            animate offset: spring(0.62, 1600)
            rotation: wob ? 14 : 0
            animate rotation: spring(0.15, 700)
            opacity: 0.6 + 0.4 * keyLvl
            Handset { c: #74dc23; ring: false }
          }
        }
      }
      // The navigation key: up, select, down, in one rounded square.
      Box {
        width: colP
        height: navH
        align: center
        ripple: false
        onPress: navZ = abs(x - colP / 2) > abs(y - navH / 2) ? (abs(x - colP / 2) < ringS * 0.22 ? "mid" : x < colP / 2 ? "left" : "right") : (abs(y - navH / 2) < ringS * 0.22 ? "mid" : y < navH / 2 ? "up" : "down")
        onRelease: navZ = ""
        onLongPress: lit = LIT
        onTap: {
          lit = LIT
          let zone = abs(x - colP / 2) > abs(y - navH / 2) ? (abs(x - colP / 2) < ringS * 0.22 ? "mid" : x < colP / 2 ? "left" : "right") : (abs(y - navH / 2) < ringS * 0.22 ? "mid" : y < navH / 2 ? "up" : "down")
          if tx != "" {
            if zone == "mid" {
              haptic("medium")
              txGo = txGo + 1
            } else {
              haptic("light")
            }
          } else if view == "menu" {
            if zone == "mid" {
              if mCur != null {
                if mCur.kind == "folder" {
                  haptic("medium")
                  mBack = {p: mPg, s: mSelC}
                  mFolder = mCur.id
                  mPage = 0
                  mSel = 0
                } else if mCur.kind == "t9" {
                  haptic("medium")
                  if mCur.id == "player" && song == null {
                    flash = "Nothing playing"
                    flashN = 2
                  } else {
                    view = mCur.id
                    lSel = 0
                    calDay = 0
                    sPlay = false
                  }
                } else {
                  haptic("strong")
                  if voice { sound(sConnect) }
                  open(mCur.key)
                }
              }
            } else {
              haptic("light")
              if zone == "left" {
                if mSelC > 0 { mSel = mSelC - 1 } else if mPg > 0 { mPage = mPg - 1; mSel = 999 }
              } else if zone == "right" {
                if mSelC < len(mShown) - 1 { mSel = mSelC + 1 } else if mPg < mPages - 1 { mPage = mPg + 1; mSel = 0 }
              } else if zone == "up" {
                if mSelC >= mN && mN > 0 {
                  let lr = floor((mN - 1) / 4) * 4
                  mSel = lr + (mSelC - mN) <= mN - 1 ? lr + (mSelC - mN) : max(0, lr + (mSelC - mN) - 4)
                } else if mSelC >= 4 {
                  mSel = mSelC - 4
                }
              } else {
                if mSelC + 4 < mN {
                  mSel = mSelC + 4
                } else if mSelC < mN && len(mDock) > 0 {
                  mSel = mN + min(mSelC % 4, len(mDock) - 1)
                }
              }
            }
          } else if view == "cal" {
            if zone == "mid" {
              haptic("strong")
              if calNeedsOk { calendar("request") } else if len(dayEvents) > 0 { calendar("open", dayEvents[0]) } else { calendar("open") }
            } else {
              haptic("light")
              calDay = selNoon + (zone == "left" ? -86400 : zone == "right" ? 86400 : zone == "up" ? -604800 : 604800)
            }
          } else if view == "limits" {
            if zone == "mid" {
              haptic("strong")
              url(lSel == 1 ? "https://chatgpt.com/codex/settings/usage" : "https://claude.ai/settings/usage")
            } else {
              haptic("light")
              lSel = zone == "up" || zone == "left" ? 0 : 1
            }
          } else if contains(listViews, view) {
            if zone == "mid" {
              if lCur != null {
                if view == "agents" {
                  haptic("strong")
                  if lCur.k == "new" {
                    if lCur.id == "claude" { terminal("cd ~ && claude", "claude") } else if lCur.id == "codex" { terminal("cd ~ && codex", "codex") } else { terminal("cd ~ && exec bash -l", "shell") }
                  } else if lCur.k == "codex" {
                    terminal("cd ${sh(lCur.dir)} && codex resume ${sh(lCur.id)}", "codex")
                  } else if lCur.k == "run" {
                    terminal("cd ${sh(lCur.dir)} && exec bash -l", "shell")
                  } else {
                    terminal("cd ${sh(lCur.dir)} && claude --resume ${sh(lCur.id)}", "claude")
                  }
                } else if view == "tasks" {
                  haptic("medium")
                  tAct = {n: tAct.n + 1, op: lCur.clear == true ? "clear" : "toggle", id: "${lCur.id}"}
                } else if view == "inbox" {
                  haptic("strong")
                  notification("open", lCur.key)
                } else if view == "switches" {
                  haptic("medium")
                  if lCur.id == "torch" { torch(modes.torch == true ? 0 : 100) } else if lCur.id == "quiet" { dnd("toggle") } else if lCur.id == "files" { if linux { open("l:omarchy-files") } else { launcher("linux") } } else if lCur.id == "agentsL" { launcher("agents") } else if lCur.id == "style" { launcher("style") } else if lCur.id == "store" { launcher("store") } else if lCur.id == "lsettings" { launcher("settings") } else { settings(lCur.id) }
                }
              }
            } else if zone == "up" {
              haptic(lSelC <= 0 ? "medium" : "light")
              lSel = max(0, lSelC - 1)
            } else if zone == "down" {
              haptic(lSelC >= lN - 1 ? "medium" : "light")
              lSel = min(max(0, lN - 1), lSelC + 1)
            } else {
              haptic("medium")
            }
          } else if view == "snake" {
            if zone == "mid" {
              haptic("medium")
              if sState == "play" { sPlay = false } else if sState == "pause" { sPlay = true } else { sNew = sNew + 1 }
            } else if sState == "play" {
              haptic("light")
              sNext = zone == "up" ? [0, -1] : zone == "down" ? [0, 1] : zone == "left" ? [-1, 0] : [1, 0]
            }
          } else if view == "goto" {
            if zone == "mid" {
              haptic("strong")
              if voice { sound(sConnect) }
              view = ""
              goN = goN + 1
              go = {n: goN, c: gCur, t: sec}
            } else if zone == "up" {
              haptic(gAt <= 0 ? "medium" : "light")
              gsel = max(0, gAt - 1)
            } else {
              haptic(gAt >= len(gotoItems) - 1 ? "medium" : "light")
              gsel = min(len(gotoItems) - 1, gAt + 1)
            }
          } else if zone == "mid" {
            if view == "player" {
              haptic("medium")
              media("toggle")
            } else if info {
              haptic("medium")
              q = ""
              sel = 0
            } else if typing {
              if cur != null {
                haptic("strong")
                if voice { sound(sConnect) }
                goN = goN + 1
                go = {n: goN, c: cur, t: sec}
                q = ""
                sel = 0
              } else {
                haptic("medium")
                if voice { sound(sNope) }
              }
            } else if sec >= num(go.t, 0) && sec - num(go.t, 0) < 2 {
              // A second press right after opening something doesn't open the menu over it.
              haptic("medium")
            } else {
              haptic("medium")
              view = "menu"
              mPage = homePg
              mSel = 0
              mFolder = ""
            }
          } else if info {
            haptic("medium")
          } else if typing {
            if zone == "up" {
              haptic(at <= 0 ? "medium" : "light")
              sel = max(0, at - 1)
            } else {
              haptic(at >= len(cands) - 1 ? "medium" : "light")
              sel = min(max(0, len(cands) - 1), at + 1)
            }
          } else {
            let lv = num(vol.level, 50)
            haptic((zone == "up" && lv >= 100) || (zone == "down" && lv <= 0) ? "medium" : "light")
            if zone == "up" { volume("up") } else if zone == "down" { volume("down") }
            volN = 2
          }
        }
        // A rounded square ringed in white on the body, as the video's: not a raised key, but its ring glows.
        Canvas {
          width: ringS + 16
          height: ringS + 16
          scale: navZ != "" ? 0.97 : 1
          animate scale: spring(0.6, 1400)
          let r = ringS * 0.25
          if navZ != "" { rect(10, 10, ringS - 4, ringS - 4, radius: r - 2, fill: alpha(#ffffff, 0.06)) }
          rect(8, 8, ringS, ringS, radius: r, stroke: alpha(haloC, 0.05 * haloLvl), width: 12)
          rect(8, 8, ringS, ringS, radius: r, stroke: alpha(haloC, 0.12 * haloLvl), width: 7.5)
          rect(8, 8, ringS, ringS, radius: r, stroke: printC, width: 4)
        }
      }
      Column {
        width: colP
        fill: height
        gap: 0
        // Right soft key: Setting when idle (held, the torch), Delete while typing (held, clear), Exit, Next.
        Box {
          fill: width
          height: softBH
          align: center
          ripple: false
          onPress: down = "softR"
          onRelease: { if down == "softR" { down = "" } }
          onTap: {
            lit = LIT
            if tx != "" {
              haptic("light")
              if txt == "" { tx = "" } else { txt = sub(txt, 0, len(txt) - 1); txKey = "" }
            } else if view == "menu" {
              haptic("medium")
              if mFolder != "" {
                mFolder = ""
                mPage = mBack.p
                mSel = mBack.s
              } else {
                view = ""
              }
            } else if inHub {
              haptic("medium")
              view = "menu"
            } else if view == "player" {
              haptic("medium")
              media("next")
            } else if view == "snake" || view == "goto" {
              haptic("medium")
              view = ""
              sPlay = false
            } else if typing {
              haptic("light")
              q = sub(q, 0, len(q) - 1)
              sel = 0
            } else {
              haptic("medium")
              if setApp != null { androidApp(setApp.key) } else { launcher("settings") }
            }
          }
          onLongPress: {
            lit = LIT
            if tx != "" {
              txt = ""
              txKey = ""
            } else if inHub {
              view = ""
              mFolder = ""
            } else if view == "player" {
              if m.canSeek == true {
                media("seek", num(m.position, 0) + 10)
              } else {
                flash = "Can't seek"
                flashN = 2
              }
            } else if view == "snake" || view == "goto" {
              view = ""
              sPlay = false
            } else if typing {
              q = ""
              sel = 0
            } else {
              // At full, by name: a toggle would keep the last level.
              torch(modes.torch == true ? 0 : 100)
              flash = modes.torch == true ? "Light off" : "Light on"
              flashN = 2
            }
          }
          Pillow { on: down == "softR"; w: keyW; h: softKH }
          Box { width: 64; height: 18; offset: [0, down == "softR" ? 1.5 : 0]; animate offset: spring(0.62, 1600); Dash { } }
        }
        // End: hang up, which clears, goes back to the idle screen and puts the light out.
        Box {
          fill: width
          weight: 1
          align: center
          ripple: false
          onPress: down = "end"
          onRelease: { if down == "end" { down = "" } }
          onTap: {
            if q != "" {
              haptic("strong")
              if voice { sound(sBusy) }
            } else {
              haptic("medium")
            }
            q = ""
            sel = 0
            view = ""
            tx = ""
            mFolder = ""
            sPlay = false
            lit = 0
            flashN = 0
            volN = 0
            revealN = 0
            revealK = ""
            seenAt = sec
          }
          // Held, it hangs up all the same.
          onLongPress: {
            q = ""
            sel = 0
            view = ""
            tx = ""
            mFolder = ""
            sPlay = false
            lit = 0
            flashN = 0
            volN = 0
            revealN = 0
            revealK = ""
            seenAt = sec
          }
          Pillow { on: down == "end"; w: keyW; h: keyH }
          Box { width: 60; height: 40; offset: [0, down == "end" ? 1.5 : 0]; animate offset: spring(0.62, 1600); opacity: 0.6 + 0.4 * keyLvl; Handset { c: #d4274d; ring: true } }
        }
      }
    }
  }

  component Keypad() {
    Grid {
      columns: 3
      gap: 0
      fill: width
      padding: [kpPad, 0]
      for k, i in pad key k.d {
        Box {
          fill: width
          height: kh
          align: center
          ripple: false
          onPress: down = k.d
          // Only state here: the launcher runs onRelease without its node's names (k would fail and the key would
          // stay down).
          onRelease: down = ""
          onTap: {
            haptic("light")
            lit = LIT
            if tx != "" {
              if voice { sound(k.t) }
              if k.d == "#" {
                txCase = (txCase + 1) % 4
                txKey = ""
              } else {
                let mts = txCase == 3 ? (k.d == "*" ? get(mtMap, "*", "") : k.d) : get(mtMap, k.d, "")
                let again = k.d == txKey && sec - txAt <= 1 && txCase != 3 && len(txt) > 0
                let lastC = lower(sub(txt, len(txt) - 1, len(txt)))
                let at0 = again ? ((range(len(mts)).find(j => sub(mts, j, j + 1) == lastC) ?? -1) + 1) % len(mts) : 0
                let ch1 = sub(mts, at0, at0 + 1)
                let base = again ? sub(txt, 0, len(txt) - 1) : txt
                let capNow = txCase == 2 || (txCase == 1 && (trim(base) == "" || endsWith(trim(base), ".") || endsWith(trim(base), "?") || endsWith(trim(base), "!")))
                if len(base) < 60 { txt = base + (capNow ? upper(ch1) : ch1) }
                txKey = k.d
                txAt = sec
              }
            } else if view == "snake" {
              // The old way to play: 2 up, 8 down, 4 left, 6 right, 5 to pause and go on.
              if k.d == "5" {
                if sState == "play" { sPlay = false } else if sState == "pause" { sPlay = true } else { sNew = sNew + 1 }
              } else if contains(["2", "4", "6", "8"], k.d) {
                if sState == "play" {
                  sNext = k.d == "2" ? [0, -1] : k.d == "8" ? [0, 1] : k.d == "4" ? [-1, 0] : [1, 0]
                } else if sState != "pause" {
                  sNew = sNew + 1
                }
              }
            } else {
              if voice { sound((q + k.d) == "*#06#" ? sSit : k.t) }
              view = ""
              if len(q) < 24 { q = q + k.d }
              sel = 0
            }
          }
          onLongPress: {
            lit = LIT
            if tx != "" {
              if len(txt) < 60 && contains("0123456789", k.d) {
                txt = txt + k.d
                txKey = ""
              }
            } else if view == "snake" {
              lit = LIT
            } else if k.d == "0" {
              view = ""
              q = q + "+"
              sel = 0
            } else if k.d == "#" {
              let turnOn = !tones
              tones = turnOn
              flash = !turnOn ? "Key tones off" : soundOk ? "Key tones on" : "Key tones on, silent now"
              flashN = 3
              if turnOn && soundOk { sound(kHash) }
            } else if k.d == "*" {
              view = ""
              q = q + "*"
              sel = 0
            } else if len(q) == 1 && q == k.d && get(speed, k.d, null) != null {
              // A tap came first (a hold let go too soon): this hold still opens the speed dial.
              q = ""
              sel = 0
              armK = ""
              if voice { sound(sConnect) }
              goN = goN + 1
              go = {n: goN, c: get(speed, k.d, null), t: sec}
            } else if typing && cur != null {
              let had = get(speed, k.d, null)
              if had != null && had.name != cur.name && !(armK == k.d && flashN > 0 && startsWith(flash, "Replace ")) {
                // Something else is on this key: ask before replacing it.
                armK = k.d
                flash = "Replace ${had.name}? Hold ${k.d} again"
                flashN = 3
              } else {
                armK = ""
                speed = set(speed, k.d, {kind: cur.kind, key: cur.key, id: cur.id, num: cur.num, name: cur.name})
                flash = "${cur.name} on ${k.d}"
                flashN = 3
                if voice { sound(sSaved) }
                q = ""
                sel = 0
              }
            } else if get(speed, k.d, null) != null {
              if voice { sound(sConnect) }
              goN = goN + 1
              go = {n: goN, c: get(speed, k.d, null), t: sec}
            } else {
              flash = "Spell a name, hold ${k.d}"
              flashN = 3
            }
          }
          Pillow { on: down == k.d; w: keyW; h: keyH }
          // The legend, the digit and its letters small on one baseline (letters first on the right column): a ring
          // of faint copies for its glow, which brightens with the backlight row by row from the top, then the print.
          Canvas {
            width: keyW
            height: keyH
            offset: [0, down == k.d ? 1.5 : 0]
            animate offset: spring(0.62, 1600)
            opacity: haloLvl
            animate opacity: tween(0.15 + floor(i / 3) * 0.15, "in")
            let lt = {text: k.l, fontSize: digitFs * 0.42, fontWeight: 700, letterSpacing: 0.2}
            let sp = k.l == "" ? [k.d] : i % 3 == 2 ? [lt, k.d] : [k.d, lt]
            let ic = k.ic ?? ""
            let dw = ic == "" ? 0 : digitFs * (k.d == "*" ? 0.5 : 0.62)
            let gw = ic == "" ? 0 : dw + digitFs * (k.d == "*" ? 0.5 : 0.2) + digitFs * 0.56
            let tx = ic == "" ? width / 2 : width / 2 - gw / 2 + dw / 2
            let cy = height / 2 + (k.d == "*" ? digitFs * 0.16 : 0)
            for o in ring2 { text(sp, tx + o[0], cy + o[1], size: digitFs, font: inter, fontWeight: 700, color: alpha(haloC, 0.035), align: "center") }
            for o in ring1 { text(sp, tx + o[0], cy + o[1], size: digitFs, font: inter, fontWeight: 700, color: alpha(haloC, 0.08), align: "center") }
          }
          Canvas {
            width: keyW
            height: keyH
            offset: [0, down == k.d ? 1.5 : 0]
            animate offset: spring(0.62, 1600)
            let lt = {text: k.l, fontSize: digitFs * 0.42, fontWeight: 700, letterSpacing: 0.2}
            let sp = k.l == "" ? [k.d] : i % 3 == 2 ? [lt, k.d] : [k.d, lt]
            let ic = k.ic ?? ""
            let dw = ic == "" ? 0 : digitFs * (k.d == "*" ? 0.5 : 0.62)
            let gw = ic == "" ? 0 : dw + digitFs * (k.d == "*" ? 0.5 : 0.2) + digitFs * 0.56
            let tx = ic == "" ? width / 2 : width / 2 - gw / 2 + dw / 2
            let s = digitFs / 15
            // The lock and the microphone, drawn small after the star and the zero.
            let ix = width / 2 + gw / 2 - digitFs * 0.28
            let iy = height / 2
            text(sp, tx, height / 2 + (k.d == "*" ? digitFs * 0.16 : 0), size: digitFs, font: inter, fontWeight: 700, color: printC, align: "center")
            if ic == "lock" {
              arc(ix, iy - 1.6 * s, 2.7 * s, -90, 180, stroke: printC, width: 1.6 * s)
              line(ix - 2.7 * s, iy - 1.6 * s, ix - 2.7 * s, iy, stroke: printC, width: 1.6 * s)
              line(ix + 2.7 * s, iy - 1.6 * s, ix + 2.7 * s, iy, stroke: printC, width: 1.6 * s)
              rect(ix - 4 * s, iy - 0.4 * s, 8 * s, 7 * s, radius: 1.4 * s, fill: printC)
            } else if ic == "mic" {
              rect(ix - 2.2 * s, iy - 6 * s, 4.4 * s, 8 * s, radius: 2.2 * s, fill: printC)
              arc(ix, iy - 0.5 * s, 3.8 * s, 90, 180, stroke: printC, width: 1.4 * s)
              line(ix, iy + 3.3 * s, ix, iy + 5.6 * s, stroke: printC, width: 1.4 * s)
              line(ix - 2.4 * s, iy + 5.8 * s, ix + 2.4 * s, iy + 5.8 * s, stroke: printC, width: 1.4 * s, cap: round)
            }
          }
          // A light where a speed dial waits.
          if get(speed, k.d, null) != null {
            Canvas {
              width: keyW
              height: keyH
              offset: [0, down == k.d ? 1.5 : 0]
              animate offset: spring(0.62, 1600)
              if bl > 0 { circle(width - 11, height / 2, 4.5, fill: alpha(keyGlow, 0.22)) }
              circle(width - 11, height / 2, 2.2, fill: bl > 0 ? keyGlow : alpha(keyGlow, 0.55))
            }
          }
        }
      }
    }
  }

  // The Omarchy icon, printed on the body above the LCD, glowing.
  component Brand() {
    Box {
      width: 34
      height: 34
      align: center
      Canvas {
        width: 34
        height: 34
        let s = 22
        let o0 = (34 - s) / 2
        for o in ring2 { image(omarchyLogo, o0 + o[0], o0 + o[1], s, s, color: alpha(foreground, 0.05)) }
        for o in ring1 { image(omarchyLogo, o0 + o[0], o0 + o[1], s, s, color: alpha(foreground, 0.12)) }
        image(omarchyLogo, o0, o0, s, s, color: alpha(foreground, 0.95))
      }
    }
  }

  if wide {
    Row {
      fill: true
      gap: 20
      padding: [14 + screenLeft, screenTop + 6, 14 + screenRight, 10 + screenInset]
      Column {
        weight: 1
        fill: height
        gap: 0
        Box { fill: width; height: 40; align: center; Brand { } }
        Lcd { weight: 1; fill: width }
      }
      Column {
        width: min(W * 0.42, 380)
        fill: height
        gap: 12
        Spacer { weight: 1 }
        Nav { }
        Keypad { }
      }
    }
  } else {
    Box {
      fill: true
      if gpu { Shader { fill: true; fallback: bodyC; uniforms: { body: bodyC }; code: grainCode } }
      Column {
        fill: true
        gap: 0
        padding: [screenLeft, max(num(screenTop, 0) - 6, 0), screenRight, 0]
        // The logo just under the camera's cutout, with clear room between it and the LCD.
        Box { fill: width; height: 28; align: center; Brand { } }
        Spacer { height: 6 }
        Box { fill: width; weight: 1; padding: [lcdM, 0]; Lcd { fill: true } }
        Spacer { height: gapA }
        Nav { }
        Spacer { height: gapB }
        Keypad { }
        Spacer { height: max(num(screenInset, 0) + 10, PW * 0.05) }
      }
    }
  }
}
