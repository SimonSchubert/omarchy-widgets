face "night city" {
  page: 0
  meta { owl: 10; description: "A neon Night City home page with a futuristic display clock, live phone status, app activity, media and notifications"; version: "1.1"; license: "MIT"; category: "productivity" }
  requires { pacman: [] }
  statusBar: false

  source now = clock every 1s
  source bat = android.battery
  source sys = android.system every 30s
  source apps = android.apps
  source n = android.notifications
  source m = android.media
  source alarm = android.alarm

  let display = "https://raw.githubusercontent.com/google/fonts/main/ofl/rajdhani/Rajdhani-Medium.ttf"
  let mono = "https://raw.githubusercontent.com/google/fonts/main/ofl/sharetechmono/ShareTechMono-Regular.ttf"
  let hottest = (apps ?? []).filter(a => !a.system || a.score > 0).sortBy(a => -a.score).take(5)
  let health = (apps ?? []).find(a => contains(["com.google.android.apps.fitness", "com.samsung.android.app.shealth", "com.fitbit.FitbitMobile"], a.package))
  let glass = alpha(#080a10, 0.82)

  background: linear(0, 0, 0, 1, [#080a10, #17101a, #090a10])
  padding: 0

  component Eyebrow(text) {
    Text { text: upper(text); font: mono; fontSize: 11; color: #fcee0a; letterSpacing: 1.4 }
  }

  component Readout(text, color = foreground) {
    Text { text: text; font: mono; fontSize: 11; color: color; letterSpacing: 0.4; maxLines: 1 }
  }

  component Divider() {
    Box {
      height: 1
      fill: width
      background: alpha(#ff2bd6, 0.5)
    }
  }

  Column {
    scroll: true
    fill: true
    gap: 16
    padding: [28, 18]

    Row {
      align: center
      gap: 10
      Text { text: "NC"; font: display; fontSize: 22; bold: true; color: #080a10; padding: [8, 10]; background: #fcee0a; radius: 2 }
      Column {
        gap: 1
        Text { text: "NIGHT CITY"; font: display; fontSize: 19; fontWeight: 700; color: #fcee0a; letterSpacing: 2 }
        Text { text: "PERSONAL OPERATING SYSTEM"; font: mono; fontSize: 9; color: muted; letterSpacing: 1 }
      }
      Spacer { weight: 1 }
      Text { text: "2077 // LIVE"; font: mono; fontSize: 10; color: #ff2bd6; width: 86; align: end; maxLines: 1 }
    }

    Column {
      gap: 0
      Box {
        fill: width
        height: 98
        align: start
        Text { spans: [fmtTime(now, "HH"), {text: ":", color: #ff2bd6}, fmtTime(now, "mm")]; font: display; fontSize: 88; fontWeight: 700; letterSpacing: 1; color: alpha(#ff2bd6, 0.5); offset: [3, 2]; maxLines: 1 }
        Text { spans: [fmtTime(now, "HH"), {text: ":", color: #00f0ff}, fmtTime(now, "mm")]; font: display; fontSize: 88; fontWeight: 700; letterSpacing: 1; color: foreground; maxLines: 1 }
      }
      Row {
        align: center
        gap: 8
        Text { text: upper(fmtTime(now, "EEEE · d MMMM")); font: mono; fontSize: 11; color: #00f0ff; letterSpacing: 1; weight: 1 }
        if alarm.set {
          Text { text: "ALARM ${fmtTime(alarm.time, "HH:mm")}"; font: mono; fontSize: 10; color: #fcee0a; onTap: androidApp(alarm.app) }
        }
      }
    }

    Divider { }

    Row {
      gap: 10
      Column {
        weight: 1
        gap: 5
        padding: 12
        background: glass
        radius: 10
        Eyebrow { text: "BATTERY" }
        Text { text: bat == null ? "--" : "${bat.level}%"; font: display; fontSize: 30; fontWeight: 600; color: #00f0ff }
        Progress { value: bat == null ? 0 : bat.level; color: bat != null && bat.level < 20 && !bat.charging ? #ff2bd6 : #00f0ff; track: alpha(foreground, 0.14); height: 3 }
        Readout { text: bat == null ? "LINK OFFLINE" : bat.charging ? "CHARGING" : "ON INTERNAL POWER"; color: muted }
      }
      Column {
        weight: 1
        gap: 5
        padding: 12
        background: glass
        radius: 10
        Eyebrow { text: "UPTIME" }
        Text { text: sys == null ? "--" : fmtDuration(sys.uptime); font: display; fontSize: 28; fontWeight: 600; color: #00f0ff }
        Readout { text: sys == null ? "WAITING FOR DEVICE" : "${sys.memory == null ? "--" : fmtBytes(sys.memory.used)} RAM IN USE"; color: muted }
      }
    }

    Column {
      gap: 10
      padding: 16
      frost: 18
      background: glass
      radius: 12
      Eyebrow { text: "DAILY STEPS // BIOMETRIC LINK" }
      Row {
        align: center
        gap: 12
        Text { text: "—"; font: display; fontSize: 52; fontWeight: 600; color: #fcee0a; width: 74 }
        Column {
          gap: 4
          weight: 1
          Text { text: "NO PEDOMETER FEED"; font: mono; fontSize: 12; color: #ff2bd6 }
          Readout { text: "Step totals aren't exposed to OWL yet."; color: muted }
        }
      }
      Text {
        text: health != null ? "OPEN ${upper(health.name)} TO CHECK TODAY'S TOTAL  ↗" : "CONNECT A FITNESS APP TO VIEW YOUR TOTAL"
        font: mono
        fontSize: 10
        color: #fcee0a
        onTap: {
          if health != null {
            androidApp(health.key)
          } else {
            launcher("drawer")
          }
        }
      }
    }

    Column {
      gap: 10
      padding: 16
      frost: 18
      background: glass
      radius: 12
      Row {
        align: center
        Eyebrow { text: "MOST-OPENED APPS" }
        Spacer { weight: 1 }
        Text { text: "LAST ACTIVITY"; font: mono; fontSize: 9; color: muted }
      }
      Divider { }
      if len(hottest) == 0 {
        Readout { text: "NO APP ACTIVITY RECORDED"; color: muted }
      } else {
        for a in hottest key a.key {
          Row {
            gap: 10
            align: center
            padding: [4, 0]
            onTap: androidApp(a.key)
            Image { src: a.icon; size: 30 }
            Text { text: upper(a.name); font: display; fontSize: 16; fontWeight: 600; weight: 1; maxLines: 1 }
            Text { text: a.last == null ? "NO LOG" : "${fmtTime(a.last, "HH:mm")} · ${fmtAgo(a.last, now)}"; font: mono; fontSize: 9; color: #fcee0a; align: end }
          }
        }
      }
      Readout { text: "Last-opened times only; screen-time totals aren't exposed here."; color: muted }
    }

    if m != null && m.title != null {
      Row {
        gap: 12
        align: center
        padding: 14
        frost: 18
        background: glass
        radius: 12
        onTap: media("open")
        if m.art != null {
          Image { src: m.art; size: 42; fit: cover; radius: 6 }
        } else {
          Box { size: 42; radius: 6; background: alpha(#ff2bd6, 0.25); Text { text: "♫"; font: display; fontSize: 22; color: #fcee0a; align: center } }
        }
        Column {
          gap: 2
          weight: 1
          Eyebrow { text: "TRANSMISSION" }
          Text { text: upper(m.title); font: display; fontSize: 16; fontWeight: 600; maxLines: 1 }
          Text { text: upper(m.artist ?? m.app ?? "UNKNOWN SOURCE"); font: mono; fontSize: 10; color: muted; maxLines: 1 }
        }
        Text { text: m.playing == true ? "PLAYING" : "PAUSED"; font: mono; fontSize: 9; color: #fcee0a }
      }
    }

    Column {
      gap: 8
      padding: 16
      frost: 18
      background: glass
      radius: 12
      Row {
        align: center
        Eyebrow { text: "INCOMING SIGNALS" }
        Spacer { weight: 1 }
        Text { text: n.available ? "${n.count} TOTAL" : "ACCESS NEEDED"; font: mono; fontSize: 9; color: muted }
      }
      Divider { }
      if !n.available {
        Readout { text: "Enable notification access to scan incoming signals."; color: muted }
      } else if n.count == 0 {
        Readout { text: "NO NEW SIGNALS"; color: muted }
      } else {
        for item in n.items.take(3) key item.key {
          Row {
            gap: 10
            align: center
            onTap: notification("open", item.key)
            Image { src: item.icon; size: 26 }
            Column {
              gap: 2
              weight: 1
              Text { text: upper(item.title); font: display; fontSize: 15; fontWeight: 600; maxLines: 1 }
              Text { text: upper(item.text); font: mono; fontSize: 9; color: muted; maxLines: 1 }
            }
            Text { text: fmtAgo(item.time, now); font: mono; fontSize: 9; color: #fcee0a }
          }
        }
      }
    }

    Text { text: "STAY HUMAN // STAY DANGEROUS"; font: mono; fontSize: 9; letterSpacing: 1; color: alpha(#ff2bd6, 0.8); align: center; fill: width; padding: [8, 0] }
    Spacer { height: screenInset }
  }
}
